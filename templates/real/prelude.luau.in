-- Types and small helpers shared by the parts. They are copied into each part rather than
-- imported, so calls to them are inlined (a call into another module costs several times
-- more); the generator drops the ones a part does not use.

--@optional
type Matrix = types.Matrix
--@optional
type LU = types.LU
--@optional
type QR = types.QR
--@optional
type QRP = types.QRP
--@optional
type Cholesky = types.Cholesky
--@optional
type Hessenberg = types.Hessenberg
--@optional
type Eigh = types.Eigh
--@optional
type Schur = types.Schur
--@optional
type Eig = types.Eig
--@optional
type Svd = types.Svd
--@optional
type Polar = types.Polar
--@optional
type LDL = types.LDL
--@optional
type GenEig = types.GenEig
--@optional
type QRFull = types.QRFull
--@optional
type RPCholesky = types.RPCholesky
--@optional
type RPQR = types.RPQR
--@optional
type FFTPlan = types.FFTPlan
--@optional
type DctNorm = types.DctNorm
--@optional
type Uplo = types.Uplo
--@optional
type Tridiagonal = types.Tridiagonal
--@optional
type TridiagonalLU = types.TridiagonalLU
--@optional
type TridiagonalLDL = types.TridiagonalLDL
--@optional
type Banded = types.Banded
--@optional
type BandedLU = types.BandedLU
--@optional
type BandedCholesky = types.BandedCholesky
--@optional
type Circulant = types.Circulant
--@optional
type Toeplitz = types.Toeplitz
--@optional
type Sparse = types.Sparse
--@optional
type BlockSparse = types.BlockSparse
--@optional
type BlockAMG = types.BlockAMG
--@optional
type AMGOptions = types.AMGOptions
--@optional
type SparseILU = types.SparseILU
--@optional
type SparseIC = types.SparseIC
--@optional
type Form = types.Form

--@inline
-- Element access. Values are stored at byte offsets: elem(i) is the offset of element i
-- (0-based) of an array, and a routine on a matrix defines at(i, j) for entry (i, j). These
-- helpers are pasted in place by the generator (--@inline), so they cost nothing even
-- where Luau is interpreted.
--
-- The byte offset of element i.
local function elem(i: number): number
	return @W@ * i
end

--@inline
-- The byte offset of element i of a real array: the same as elem(i) here; shared code
-- uses it for arrays that are real in the complex modules too.
local function relem(i: number): number
	return @W@ * i
end

--@inline
-- Complex arrays (@CMOD@ layout, as rfft returns and eig's values): celem(i) is the byte
-- offset of element i, whose real part is at that offset and imaginary part at imag(o).
local function celem(i: number): number
	return 2 * @W@ * i
end

--@inline
-- The byte offset of the imaginary part of the complex number at byte offset o.
local function imag(o: number): number
	return o + @W@
end

--@inline
-- The complex number at byte offset o of x, as (re, im). (The cast: assigned to two
-- existing locals, the second read was typed number? by the type checker.)
local function cload(x: buffer, o: number): (number, number)
	return @READ@(x, o), @READ@(x, o + @W@) :: number
end

--@inline
-- Sets the complex number at byte offset o of x to re + i im.
local function cstore(x: buffer, o: number, re: number, im: number)
	local here = o
	@WRITE@(x, here, re)
	@WRITE@(x, here + @W@, im)
end

--@inline
-- The value at byte offset o of x.
local function load(x: buffer, o: number): number
	return @READ@(x, o)
end

--@inline
-- Sets the value at byte offset o of x to v.
local function store(x: buffer, o: number, v: number)
	@WRITE@(x, o, v)
end

--@inline
-- x[o] += v, for the value at byte offset o of x.
local function add_at(x: buffer, o: number, v: number)
	local here = o
	@WRITE@(x, here, @READ@(x, here) + v)
end

--@inline
-- x[o] -= v
local function sub_at(x: buffer, o: number, v: number)
	local here = o
	@WRITE@(x, here, @READ@(x, here) - v)
end

--@inline
-- x[o] *= v
local function mul_at(x: buffer, o: number, v: number)
	local here = o
	@WRITE@(x, here, @READ@(x, here) * v)
end

--@inline
-- x[o] /= v
local function div_at(x: buffer, o: number, v: number)
	local here = o
	@WRITE@(x, here, @READ@(x, here) / v)
end

--@inline
-- Exchanges the values at byte offsets o1 and o2 of x.
local function swap_at(x: buffer, o1: number, o2: number)
	local s = o1
	local t = o2
	local tmp = @READ@(x, s)
	@WRITE@(x, s, @READ@(x, t))
	@WRITE@(x, t, tmp)
end

--@optional
-- An array of n zeros.
local function create(n: number): buffer
	return buffer.create(@W@ * n)
end

--@optional
-- The number of elements of x.
local function length(x: buffer): number
	return buffer.len(x) // @W@
end

--@optional
-- A new array of zeros as long as x.
local function similar(x: buffer): buffer
	return buffer.create(buffer.len(x))
end

--@optional
local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

--@optional
local function check_same(x: buffer, y: buffer)
	assert(buffer.len(x) == buffer.len(y), "arrays have different lengths")
end

--@include shared/norms_prelude.luau.in

--@optional
-- A rows by cols matrix of zeros.
local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(@W@ * rows * cols) }
end

--@optional
local function matoutput(out: Matrix?, rows: number, cols: number): Matrix
	if out == nil then
		return matrix(rows, cols)
	end
	assert(out.rows == rows and out.cols == cols, "output has the wrong shape")
	return out
end

--@optional
-- Element i (0-based) as (re, im), and its setter (the imaginary part is dropped), for
-- code shared with the complex modules.
local function eget(x: buffer, i: number): (number, number)
	return @READ@(x, @W@ * i), 0
end

--@optional
local function eset(x: buffer, i: number, re: number, _im: number)
	@WRITE@(x, @W@ * i, re)
end

--@include shared/solve_prelude.luau.in
