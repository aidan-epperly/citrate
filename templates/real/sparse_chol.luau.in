-- Sparse Cholesky factorization

-- The numeric factorization into L's values (laid out by the symbolic factorization sym):
-- supernode by supernode, left-looking. Each supernode first receives its columns of A,
-- then the updates of the earlier supernodes whose rows meet its columns (found through
-- linked lists: a supernode waits in the list of the supernode holding its next row), each
-- update a set of dot products of rows of a dense block; then its diagonal block is
-- factored and the rows below it solved, all within the block. Returns false if a pivot
-- was not positive (the matrix is not positive definite).
local function chol_numeric(sym: any, A: Sparse, L: buffer, work: any): boolean
	local ns = sym.nsuper
	local super, rowptr, rows, valptr, col2super, amap = sym.super, sym.rowptr, sym.rows, sym.valptr, sym.col2super, sym.amap
	buffer.fill(L, 0, 0)
	local Av = A.values
	for p = 0, u32(A.colptr, A.cols) - 1 do
		local dst = u32(amap, p)
		if dst ~= 0 then
			local o = elem(dst - 1)
			store(L, o, load(L, o) + load(Av, elem(p)))
		end
	end
	local rel, head, link, dpos = work.rel, work.head, work.link, work.dpos
	buffer.fill(head, 0, 255) -- -1: empty lists
	for s = 0, ns - 1 do
		local c0: number = u32(super, s)
		local K: number = u32(super, s + 1) - c0
		local c1 = c0 + K
		local r0: number = u32(rowptr, s)
		local R: number = u32(rowptr, s + 1) - r0
		local base: number = u32(valptr, s)
		for r = 0, R - 1 do
			buffer.writeu32(rel, 4 * u32(rows, r0 + r), r)
		end
		-- the updates of earlier supernodes
		local d = buffer.readi32(head, 4 * s)
		buffer.writei32(head, 4 * s, -1)
		while d >= 0 do
			local dnext = buffer.readi32(link, 4 * d)
			local Kd: number = u32(super, d + 1) - u32(super, d)
			local dr0: number = u32(rowptr, d)
			local dr1: number = u32(rowptr, d + 1)
			local dbase: number = u32(valptr, d)
			local q: number = u32(dpos, d)
			local q2 = q
			while q2 < dr1 and u32(rows, q2) < c1 do
				q2 += 1
			end
			-- C = L_d[rows from jj] L_d[rows jj .. q2 - 1]^T, lower part, subtracted into the
			-- block: two columns of C at a time against four rows, so each value read
			-- feeds two or four multiply-adds
			local stride = @W@ * Kd
			local last = stride - @W@
			local jj = q
			while jj < q2 do
				local colA = u32(rows, jj) - c0
				local ojA = elem(dbase + (jj - dr0) * Kd)
				local pair = jj + 1 < q2
				local colB = if pair then u32(rows, jj + 1) - c0 else 0
				local ojB = ojA + stride
				-- row jj: column A only (above the diagonal in column B)
				local sum = 0
				for t = 0, last, @W@ do
					local x = load(L, ojA + t)
					sum += x * x
				end
				local target = elem(base + u32(rel, u32(rows, jj)) * K + colA)
				store(L, target, load(L, target) - sum)
				local ii = jj + 1
				if pair then
					local oi = ojB
					while ii + 3 < dr1 do
						local a1, a2, a3, a4, b1, b2, b3, b4 = 0, 0, 0, 0, 0, 0, 0, 0
						for t = 0, last, @W@ do
							local xa, xb = load(L, ojA + t), load(L, ojB + t)
							local y1 = load(L, oi + t)
							local y2 = load(L, oi + stride + t)
							local y3 = load(L, oi + 2 * stride + t)
							local y4 = load(L, oi + 3 * stride + t)
							a1 += y1 * xa
							a2 += y2 * xa
							a3 += y3 * xa
							a4 += y4 * xa
							b1 += y1 * xb
							b2 += y2 * xb
							b3 += y3 * xb
							b4 += y4 * xb
						end
						local rb = base + u32(rel, u32(rows, ii)) * K
						store(L, elem(rb + colA), load(L, elem(rb + colA)) - a1)
						store(L, elem(rb + colB), load(L, elem(rb + colB)) - b1)
						rb = base + u32(rel, u32(rows, ii + 1)) * K
						store(L, elem(rb + colA), load(L, elem(rb + colA)) - a2)
						store(L, elem(rb + colB), load(L, elem(rb + colB)) - b2)
						rb = base + u32(rel, u32(rows, ii + 2)) * K
						store(L, elem(rb + colA), load(L, elem(rb + colA)) - a3)
						store(L, elem(rb + colB), load(L, elem(rb + colB)) - b3)
						rb = base + u32(rel, u32(rows, ii + 3)) * K
						store(L, elem(rb + colA), load(L, elem(rb + colA)) - a4)
						store(L, elem(rb + colB), load(L, elem(rb + colB)) - b4)
						ii += 4
						oi += 4 * stride
					end
					while ii < dr1 do
						local a, b = 0, 0
						for t = 0, last, @W@ do
							local y = load(L, oi + t)
							a += y * load(L, ojA + t)
							b += y * load(L, ojB + t)
						end
						local rb = base + u32(rel, u32(rows, ii)) * K
						store(L, elem(rb + colA), load(L, elem(rb + colA)) - a)
						store(L, elem(rb + colB), load(L, elem(rb + colB)) - b)
						ii += 1
						oi += stride
					end
					jj += 2
				else
					local oi = ojA + stride
					while ii < dr1 do
						local a = 0
						for t = 0, last, @W@ do
							a += load(L, oi + t) * load(L, ojA + t)
						end
						local rb = base + u32(rel, u32(rows, ii)) * K
						store(L, elem(rb + colA), load(L, elem(rb + colA)) - a)
						ii += 1
						oi += stride
					end
					jj += 1
				end
			end
			buffer.writeu32(dpos, 4 * d, q2)
			if q2 < dr1 then
				local s2 = u32(col2super, u32(rows, q2))
				buffer.writei32(link, 4 * d, buffer.readi32(head, 4 * s2))
				buffer.writei32(head, 4 * s2, d)
			end
			d = dnext
		end
		-- the dense block: Cholesky of its diagonal block (row by row), then the rows below
		-- solved against it, four at a time (each read of the diagonal block feeding four)
		for r = 0, K - 1 do
			local orow = elem(base + r * K)
			for t = 0, r do
				local ot = elem(base + t * K)
				local sum = load(L, orow + @W@ * t)
				for u = 0, @W@ * (t - 1), @W@ do
					sum -= load(L, orow + u) * load(L, ot + u)
				end
				if t == r then
					if not (sum > 0) then
						return false
					end
					store(L, orow + @W@ * t, math.sqrt(sum))
				else
					store(L, orow + @W@ * t, sum / load(L, ot + @W@ * t))
				end
			end
		end
		local stride = @W@ * K
		local r = K
		while r + 3 < R do
			local o1 = elem(base + r * K)
			local o2, o3, o4 = o1 + stride, o1 + 2 * stride, o1 + 3 * stride
			for t = 0, K - 1 do
				local ot = elem(base + t * K)
				local at = @W@ * t
				local a1, a2, a3, a4 = load(L, o1 + at), load(L, o2 + at), load(L, o3 + at), load(L, o4 + at)
				for u = 0, at - @W@, @W@ do
					local x = load(L, ot + u)
					a1 -= load(L, o1 + u) * x
					a2 -= load(L, o2 + u) * x
					a3 -= load(L, o3 + u) * x
					a4 -= load(L, o4 + u) * x
				end
				local dt = load(L, ot + at)
				store(L, o1 + at, a1 / dt)
				store(L, o2 + at, a2 / dt)
				store(L, o3 + at, a3 / dt)
				store(L, o4 + at, a4 / dt)
			end
			r += 4
		end
		while r < R do
			local orow = elem(base + r * K)
			for t = 0, K - 1 do
				local ot = elem(base + t * K)
				local sum = load(L, orow + @W@ * t)
				for u = 0, @W@ * (t - 1), @W@ do
					sum -= load(L, orow + u) * load(L, ot + u)
				end
				store(L, orow + @W@ * t, sum / load(L, ot + @W@ * t))
			end
			r += 1
		end
		if R > K then
			buffer.writeu32(dpos, 4 * s, r0 + K)
			local s2 = u32(col2super, u32(rows, r0 + K))
			buffer.writei32(link, 4 * s, buffer.readi32(head, 4 * s2))
			buffer.writei32(head, 4 * s2, s)
		end
	end
	return true
end

--@include shared/sparse_chol_common.luau.in

-- Sparse Cholesky factorization P S P^T = L L^T of a symmetric positive definite sparse
-- matrix (both triangles stored, as Sparse matrices are; the lower one is read after
-- ordering). options.order chooses P: "amd" (approximate minimum degree: the least fill,
-- the default), "rcm", "natural" or a permutation (as graph.rcm returns). L is stored by
-- supernodes, dense blocks of columns with the same rows (graph.chol_analysis;
-- options.relax = false keeps only exact ones). options.reuse, an earlier factorization of
-- a matrix with the same pattern (the same colptr and rowind buffers), keeps its ordering,
-- analysis and storage: only the values are recomputed, with nothing allocated. F.definite
-- is false if a pivot was not positive (the factorization stops there); F.nnz is the
-- number of entries stored and F.madds the multiply-adds of a factorization.
local function sparse_chol(S: Sparse, options: types.SparseCholOptions?): types.SparseCholesky
	return chol_factor(S, options or {}, @W@, 8)
end

-- The solution of S x = b from sparse_chol's factorization (out may be b).
local function sparse_chol_solve(out: buffer?, F: types.SparseCholesky, b: buffer): buffer
	local Fa = F :: any
	local sym = Fa.symbolic
	local n = Fa.n
	local o = output(out, elem(n))
	local x = Fa.work.x
	local perm, super, rowptr, rows, valptr = sym.perm, sym.super, sym.rowptr, sym.rows, sym.valptr
	local L = Fa.values
	for k = 0, n - 1 do
		buffer.writef64(x, 8 * k, load(b, elem(buffer.readi32(perm, 4 * k) - 1)))
	end
	local ns = sym.nsuper
	-- L y = P b: each block's diagonal block solved, then its rows below updated four at a
	-- time (each read of the block's solution feeding four of them)
	for s = 0, ns - 1 do
		local c0: number = u32(super, s)
		local K: number = u32(super, s + 1) - c0
		local r0: number = u32(rowptr, s)
		local R: number = u32(rowptr, s + 1) - r0
		local base: number = u32(valptr, s)
		local xc = 8 * c0
		for t = 0, K - 1 do
			local ot = elem(base + t * K)
			local sum = buffer.readf64(x, xc + 8 * t)
			for u = 0, t - 1 do
				sum -= load(L, ot + @W@ * u) * buffer.readf64(x, xc + 8 * u)
			end
			buffer.writef64(x, xc + 8 * t, sum / load(L, ot + @W@ * t))
		end
		local stride = @W@ * K
		local r = K
		while r + 3 < R do
			local o1 = elem(base + r * K)
			local o2, o3, o4 = o1 + stride, o1 + 2 * stride, o1 + 3 * stride
			local a1, a2, a3, a4 = 0, 0, 0, 0
			for t = 0, K - 1 do
				local xt = buffer.readf64(x, xc + 8 * t)
				local ot = @W@ * t
				a1 += load(L, o1 + ot) * xt
				a2 += load(L, o2 + ot) * xt
				a3 += load(L, o3 + ot) * xt
				a4 += load(L, o4 + ot) * xt
			end
			local q = r0 + r
			local w1, w2, w3, w4 = 8 * u32(rows, q), 8 * u32(rows, q + 1), 8 * u32(rows, q + 2), 8 * u32(rows, q + 3)
			buffer.writef64(x, w1, buffer.readf64(x, w1) - a1)
			buffer.writef64(x, w2, buffer.readf64(x, w2) - a2)
			buffer.writef64(x, w3, buffer.readf64(x, w3) - a3)
			buffer.writef64(x, w4, buffer.readf64(x, w4) - a4)
			r += 4
		end
		while r < R do
			local orow = elem(base + r * K)
			local sum = 0
			for t = 0, K - 1 do
				sum += load(L, orow + @W@ * t) * buffer.readf64(x, xc + 8 * t)
			end
			local w = 8 * u32(rows, r0 + r)
			buffer.writef64(x, w, buffer.readf64(x, w) - sum)
			r += 1
		end
	end
	-- L^T z = y: each block's columns take the rows below, four columns at a time summed in
	-- locals (each read of x feeding four), then its diagonal block solved
	for s = ns - 1, 0, -1 do
		local c0: number = u32(super, s)
		local K: number = u32(super, s + 1) - c0
		local r0: number = u32(rowptr, s)
		local R: number = u32(rowptr, s + 1) - r0
		local base: number = u32(valptr, s)
		local xc = 8 * c0
		if R > K then
			local stride = @W@ * K
			local t = 0
			while t + 3 < K do
				local a1, a2, a3, a4 = 0, 0, 0, 0
				local ol = elem(base + K * K + t)
				for q = r0 + K, r0 + R - 1 do
					local xr = buffer.readf64(x, 8 * u32(rows, q))
					a1 += load(L, ol) * xr
					a2 += load(L, ol + @W@) * xr
					a3 += load(L, ol + 2 * @W@) * xr
					a4 += load(L, ol + 3 * @W@) * xr
					ol += stride
				end
				local at = xc + 8 * t
				buffer.writef64(x, at, buffer.readf64(x, at) - a1)
				buffer.writef64(x, at + 8, buffer.readf64(x, at + 8) - a2)
				buffer.writef64(x, at + 16, buffer.readf64(x, at + 16) - a3)
				buffer.writef64(x, at + 24, buffer.readf64(x, at + 24) - a4)
				t += 4
			end
			while t < K do
				local a = 0
				local ol = elem(base + K * K + t)
				for q = r0 + K, r0 + R - 1 do
					a += load(L, ol) * buffer.readf64(x, 8 * u32(rows, q))
					ol += stride
				end
				local at = xc + 8 * t
				buffer.writef64(x, at, buffer.readf64(x, at) - a)
				t += 1
			end
		end
		for t = K - 1, 0, -1 do
			local sum = buffer.readf64(x, xc + 8 * t)
			for u = t + 1, K - 1 do
				sum -= load(L, elem(base + u * K + t)) * buffer.readf64(x, xc + 8 * u)
			end
			buffer.writef64(x, xc + 8 * t, sum / load(L, elem(base + t * K + t)))
		end
	end
	for k = 0, n - 1 do
		store(o, elem(buffer.readi32(perm, 4 * k) - 1), buffer.readf64(x, 8 * k))
	end
	return o
end
