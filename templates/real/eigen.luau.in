return {
	cond = cond,
	eig = eig,
	eig_copy = eig_copy,
	eig_gen = eig_gen,
	eig_gen_copy = eig_gen_copy,
	eigh = eigh,
	eigh_copy = eigh_copy,
	eigh_gen = eigh_gen,
	eigh_gen_copy = eigh_gen_copy,
	hess = hess,
	hess_copy = hess_copy,
	hess_h = hess_h,
	hess_q = hess_q,
	matnorm = matnorm,
	null_space = null_space,
	orth = orth,
	pinv = pinv,
	polar = polar,
	polar_copy = polar_copy,
	rank = rank,
	rcond = rcond,
	rpcholesky = rpcholesky,
	rpcholesky_columns = rpcholesky_columns,
	rpqr = rpqr,
	rsvd = rsvd,
	schur = schur,
	schur_copy = schur_copy,
	svd = svd,
	svd_copy = svd_copy,
	tridiag_eigh = tridiag_eigh,
	complexified = complexified,
	schur_impl = schur_impl,
	to_complex_schur = to_complex_schur,
}
