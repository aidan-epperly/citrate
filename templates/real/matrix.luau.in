--!optimize 2
-- Generated by tools/generate.py from templates/real/matrix.luau.in. Edit the template, not this file.

-- @NAME@ matrices (column-major): creation and access, transposes, matrix-vector
-- products, submatrices and other utilities.
-- Indices are 1-based; arithmetic is done in double precision and rounded once per stored
-- value; every `out` argument may be nil, in which case a new result is allocated.

local types = require("./types")

--@include real/prelude.luau.in

-- Builds a matrix from a table of rows.
local function matfrom(t: { { number } }): Matrix
	local rows = #t
	local cols = if rows > 0 then #t[1] else 0
	local A = matrix(rows, cols)
	for i = 1, rows do
		local row = t[i]
		assert(#row == cols, "rows have different lengths")
		for j = 1, cols do
			store(A.data, elem((j - 1) * rows + i - 1), row[j])
		end
	end
	return A
end

-- Returns a table of rows.
local function mattotable(A: Matrix): { { number } }
	local t = table.create(A.rows) :: { { number } }
	for i = 1, A.rows do
		local row = table.create(A.cols, 0)
		for j = 1, A.cols do
			row[j] = load(A.data, elem((j - 1) * A.rows + i - 1))
		end
		t[i] = row
	end
	return t
end

-- The n by n identity matrix.
local function identity(n: number): Matrix
	local A = matrix(n, n)
	for i = 0, n - 1 do
		store(A.data, elem(i * n + i), 1)
	end
	return A
end

-- Entry (i, j).
local function matget(A: Matrix, i: number, j: number): number
	return load(A.data, elem((j - 1) * A.rows + i - 1))
end

-- Sets entry (i, j) to v.
local function matset(A: Matrix, i: number, j: number, v: number)
	store(A.data, elem((j - 1) * A.rows + i - 1), v)
end

-- out := A (a new matrix if out is nil).
local function matcopy(out: Matrix?, A: Matrix): Matrix
	local o = matoutput(out, A.rows, A.cols)
	if o.data ~= A.data then
		buffer.copy(o.data, 0, A.data)
	end
	return o
end

-- out := A^T (a new matrix if out is nil).
local function transpose(out: Matrix?, A: Matrix): Matrix
	local m, n = A.rows, A.cols
	local o = matoutput(out, n, m)
	assert(o.data ~= A.data, "transpose cannot be done in place")
	local a, d = A.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			store(d, elem(i * n + j), load(a, elem(j * m + i)))
		end
	end
	return o
end

-- A x
local function matvec(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(buffer.len(x) == @W@ * n, "matrix and vector sizes do not match")
	local o = output(out, @W@ * m)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @W@ * (j * m + i)
	end
	for i = 0, m - 1 do
		local s = 0
		for j = 0, n - 1 do
			s += load(a, at(i, j)) * load(x, elem(j))
		end
		store(o, elem(i), s)
	end
	return o
end
-- Matrix utilities, matrix norms, slogdet and transposed LU solves.

-- The sum of the diagonal.
local function trace(A: Matrix): number
	local s = 0
	for i = 0, math.min(A.rows, A.cols) - 1 do
		s += load(A.data, elem(i * A.rows + i))
	end
	return s
end

-- The diagonal (min(rows, cols) entries), as an array.
local function diag(out: buffer?, A: Matrix): buffer
	local n = math.min(A.rows, A.cols)
	local o = output(out, @W@ * n)
	for i = 0, n - 1 do
		store(o, elem(i), load(A.data, elem(i * A.rows + i)))
	end
	return o
end

-- The square matrix with the array x on its diagonal.
local function diagm(x: buffer): Matrix
	local n = length(x)
	local D = matrix(n, n)
	for i = 0, n - 1 do
		store(D.data, elem(i * n + i), load(x, elem(i)))
	end
	return D
end

-- The Kronecker product: the block matrix [a_ij B].
local function kron(A: Matrix, B: Matrix): Matrix
	local m, n, p, q = A.rows, A.cols, B.rows, B.cols
	local K = matrix(m * p, n * q)
	local k, a, b = K.data, A.data, B.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local aij = load(a, elem(j * m + i))
			if aij ~= 0 then
				for l = 0, q - 1 do
					local col = (j * q + l) * m * p + i * p
					for r = 0, p - 1 do
						store(k, elem(col + r), aij * load(b, elem(l * p + r)))
					end
				end
			end
		end
	end
	return K
end

-- The outer product x y^T.
local function outer(out: Matrix?, x: buffer, y: buffer): Matrix
	local m, n = length(x), length(y)
	local o = matoutput(out, m, n)
	for j = 0, n - 1 do
		local yj = load(y, elem(j))
		for i = 0, m - 1 do
			store(o.data, elem(j * m + i), load(x, elem(i)) * yj)
		end
	end
	return o
end

-- The rank-one update A := A + a x y^T, in place (BLAS ger); returns A.
local function ger(A: Matrix, a: number, x: buffer, y: buffer): Matrix
	local m, n = A.rows, A.cols
	assert(length(x) == m and length(y) == n, "ger: sizes do not match")
	--@inline
	local function at(i: number, j: number): number
		return @W@ * (j * m + i)
	end
	for j = 0, n - 1 do
		local f = a * load(y, elem(j))
		if f ~= 0 then
			for i = 0, m - 1 do
				add_at(A.data, at(i, j), f * load(x, elem(i)))
			end
		end
	end
	return A
end

-- A^T x, without forming the transpose.
local function matvec_adjoint(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(length(x) == m, "matvec_adjoint: sizes do not match")
	local o = output(out, @W@ * n)
	assert(o ~= x, "output cannot be the input vector")
	--@inline
	local function at(i: number, j: number): number
		return @W@ * (j * m + i)
	end
	for j = 0, n - 1 do
		local s = 0
		for i = 0, m - 1 do
			s += load(A.data, at(i, j)) * load(x, elem(i))
		end
		store(o, elem(j), s)
	end
	return o
end

-- The conjugate transpose, for the shared polar code.
local conj_transpose = transpose

