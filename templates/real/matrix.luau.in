	diag = diag,
	diagm = diagm,
	ger = ger,
	hstack = hstack,
	identity = identity,
	kron = kron,
	matcopy = matcopy,
	matfrom = matfrom,
	matget = matget,
	matset = matset,
	mattotable = mattotable,
	matvec = matvec,
	matvec_adjoint = matvec_adjoint,
	outer = outer,
	setsubmatrix = setsubmatrix,
	submatrix = submatrix,
	trace = trace,
	transpose = transpose,
	vstack = vstack,
	conj_transpose = conj_transpose,
}
