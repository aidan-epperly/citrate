-- Generated by tools/generate.py from templates/real/array.luau.in. Edit the template, not this file.

-- @NAME@ arrays: creation and access, elementwise arithmetic, reductions and norms,
-- and the Space that the iterative and ODE solvers use.
-- Indices are 1-based; arithmetic is done in double precision and rounded once per stored
-- value; every `out` argument may be nil, in which case a new result is allocated.

local types = require("./types")

--@include real/prelude.luau.in

-- An array holding the numbers of t.
local function from(t: { number }): buffer
	local x = buffer.create(@W@ * #t)
	for i = 1, #t do
		store(x, elem(i - 1), t[i])
	end
	return x
end

-- The elements of x as a table of numbers.
local function totable(x: buffer): { number }
	local n = length(x)
	local t = table.create(n, 0)
	for i = 1, n do
		t[i] = load(x, elem(i - 1))
	end
	return t
end

-- Element i.
local function get(x: buffer, i: number): number
	return load(x, elem(i - 1))
end

-- Sets element i to v.
local function set(x: buffer, i: number, v: number)
	store(x, elem(i - 1), v)
end

-- Sets every element of out to v and returns out.
local function fill(out: buffer, v: number): buffer
	--@unroll
	for k = 0, buffer.len(out) - @W@, @W@ do
		store(out, k, v)
	end
	return out
end

-- out := x (a new array if out is nil).
local function copy(out: buffer?, x: buffer): buffer
	local o = output(out, buffer.len(x))
	if o ~= x then
		buffer.copy(o, 0, x)
	end
	return o
end

-- out := x + y, elementwise.
local function add(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		store(o, k, load(x, k) + load(y, k))
	end
	return o
end

-- out := x - y, elementwise.
local function sub(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		store(o, k, load(x, k) - load(y, k))
	end
	return o
end

-- Elementwise (Hadamard) product.
local function mul(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		store(o, k, load(x, k) * load(y, k))
	end
	return o
end

-- out := a x.
local function scale(out: buffer?, a: number, x: buffer): buffer
	local o = output(out, buffer.len(x))
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		store(o, k, a * load(x, k))
	end
	return o
end

-- a * x + y
local function axpy(out: buffer?, a: number, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		store(o, k, a * load(x, k) + load(y, k))
	end
	return o
end

-- The dot product, the sum of x_i y_i.
local function dot(x: buffer, y: buffer): number
	check_same(x, y)
	local s = 0
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		s += load(x, k) * load(y, k)
	end
	return s
end

-- The conjugate gradient update in one pass: x := x + a p and r := r - a q, returning the
-- real inner product of the new r with itself (as stored). Separate axpys and a dot make
-- three passes, each paying the loop and read costs again.
local function cg_update(x: buffer, r: buffer, p: buffer, q: buffer, a: number): number
	check_same(x, r)
	check_same(x, p)
	check_same(x, q)
	local s = 0
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		add_at(x, k, a * load(p, k))
		sub_at(r, k, a * load(q, k))
		local v = load(r, k)
		s += v * v
	end
	return s
end

-- The sum of the elements.
local function sum(x: buffer): number
	local s = 0
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		s += load(x, k)
	end
	return s
end

-- Largest absolute value (NaN if any element is NaN, 0 for an empty array).
local function amax(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - @W@, @W@ do
		local a = math.abs(load(x, k))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	return m
end

--@include shared/norms_array.luau.in

-- Euclidean norm, without overflow or underflow.
local function norm(x: buffer): number
	return segment_norm(x, 0, length(x))
end

local rdot = dot

-- The inner product x^H y as (re, im) and y + (ar + i ai) x, for code shared with the
-- complex modules (the imaginary parts are 0 here).
local function dotc_pair(x: buffer, y: buffer): (number, number)
	return dot(x, y), 0
end

local function caxpy_pair(out: buffer?, ar: number, _ai: number, x: buffer, y: buffer): buffer
	return axpy(out, ar, x, y)
end

-- The weighted RMS norm of an error estimate e, as ODE solvers use it:
-- sqrt(mean((e_i / (atol + rtol max(|y_i|, |ynew_i|)))^2)).
local function errnorm(e: buffer, y: buffer, ynew: buffer, atol: number, rtol: number): number
	local n = length(e)
	if n == 0 then
		return 0
	end
	local s = 0
	for i = 0, n - 1 do
		local sc = atol + rtol * math.max(math.abs(load(y, elem(i))), math.abs(load(ynew, elem(i))))
		local v = load(e, elem(i)) / sc
		s += v * v
	end
	return math.sqrt(s / n)
end

-- The complex extension of the space, for GMRES and BiCGSTAB: real data never produces a
-- nonzero imaginary coefficient, so one is rejected.
local function space_cdot(x: buffer, y: buffer): (number, number)
	return dot(x, y), 0
end

local function space_cscale(out: buffer, ar: number, ai: number, x: buffer): buffer
	assert(ai == 0, "complex coefficient on a real space")
	return scale(out, ar, x)
end

local function space_caxpy(out: buffer, ar: number, ai: number, x: buffer, y: buffer): buffer
	assert(ai == 0, "complex coefficient on a real space")
	return axpy(out, ar, x, y)
end

-- The module's arrays as a ComplexSpace (see types.ComplexSpace), for the iterative and
-- ODE solvers.
local space: types.ComplexSpace<buffer> = {
	eps = @EPS@,
	real = true,
	errnorm = errnorm,
	cdot = space_cdot,
