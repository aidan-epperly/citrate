	inv = inv,
	inv_copy = inv_copy,
	ldl = ldl,
	ldl_copy = ldl_copy,
	ldl_inertia = ldl_inertia,
	ldl_solve = ldl_solve,
	lu = lu,
	lu_copy = lu_copy,
	lu_solve = lu_solve,
	lu_solve_adjoint = lu_solve_adjoint,
	qr = qr,
	qr_apply_q = qr_apply_q,
	qr_apply_qh = qr_apply_qh,
	qr_copy = qr_copy,
	qr_delete_col = qr_delete_col,
	qr_full = qr_full,
