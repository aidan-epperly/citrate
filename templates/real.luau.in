	add = add,
	sub = sub,
	scale = scale,
	axpy = axpy,
	norm = norm,
}

return {
	space = space,

	create = create,
	length = length,
	similar = similar,
	from = from,
	totable = totable,
	get = get,
	set = set,
	fill = fill,
