--!strict
--!native
--!optimize 2
-- Generated by tools/generate.py from templates/real.luau.in. Edit the template, not this file.

-- @NAME@ arrays (buffers of @W@-byte floats) and column-major matrices.
-- Indices are 1-based. Arithmetic is done in double precision and rounded once per
-- stored value. Every `out` argument may be nil, in which case a new result is allocated.

local types = require("./types")
-- Complex results (eigenvalues and eigenvectors) use the complex module of the same precision.
local complexmod = require("./@CMOD@")
local complex64 = require("./complex64")

export type Matrix = types.Matrix
export type LU = types.LU
export type QR = types.QR
export type QRP = types.QRP
export type Cholesky = types.Cholesky
export type Hessenberg = types.Hessenberg
export type Eigh = types.Eigh
export type Schur = types.Schur
export type Eig = types.Eig
export type Svd = types.Svd
export type Polar = types.Polar
export type LDL = types.LDL
export type GenEig = types.GenEig
export type QRFull = types.QRFull
export type RPCholesky = types.RPCholesky
export type RPQR = types.RPQR
export type FFTPlan = types.FFTPlan
export type DctNorm = types.DctNorm
export type Uplo = types.Uplo
export type Tridiagonal = types.Tridiagonal
export type TridiagonalLU = types.TridiagonalLU
export type TridiagonalLDL = types.TridiagonalLDL
export type Banded = types.Banded
export type BandedLU = types.BandedLU
export type BandedCholesky = types.BandedCholesky
export type Circulant = types.Circulant
export type Toeplitz = types.Toeplitz
export type Sparse = types.Sparse
export type BlockSparse = types.BlockSparse
export type BlockAMG = types.BlockAMG
export type AMGOptions = types.AMGOptions
export type SparseILU = types.SparseILU
export type SparseIC = types.SparseIC
export type Form = types.Form

-- Arrays

local function create(n: number): buffer
	return buffer.create(@W@ * n)
end

local function length(x: buffer): number
	return buffer.len(x) // @W@
end

local function similar(x: buffer): buffer
	return buffer.create(buffer.len(x))
end

local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

local function check_same(x: buffer, y: buffer)
	assert(buffer.len(x) == buffer.len(y), "arrays have different lengths")
end

local function from(t: { number }): buffer
	local x = buffer.create(@W@ * #t)
	for i = 1, #t do
		@WRITE@(x, @W@ * (i - 1), t[i])
	end
	return x
end

local function totable(x: buffer): { number }
	local n = length(x)
	local t = table.create(n, 0)
	for i = 1, n do
		t[i] = @READ@(x, @W@ * (i - 1))
	end
	return t
end

local function get(x: buffer, i: number): number
	return @READ@(x, @W@ * (i - 1))
end

local function set(x: buffer, i: number, v: number)
	@WRITE@(x, @W@ * (i - 1), v)
end

local function fill(out: buffer, v: number): buffer
	--@unroll
	for k = 0, buffer.len(out) - @W@, @W@ do
		@WRITE@(out, k, v)
	end
	return out
end

local function copy(out: buffer?, x: buffer): buffer
	local o = output(out, buffer.len(x))
	if o ~= x then
		buffer.copy(o, 0, x)
	end
	return o
end

local function add(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		@WRITE@(o, k, @READ@(x, k) + @READ@(y, k))
	end
	return o
end

local function sub(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		@WRITE@(o, k, @READ@(x, k) - @READ@(y, k))
	end
	return o
end

-- Elementwise (Hadamard) product.
local function mul(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		@WRITE@(o, k, @READ@(x, k) * @READ@(y, k))
	end
	return o
end

local function scale(out: buffer?, a: number, x: buffer): buffer
	local o = output(out, buffer.len(x))
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		@WRITE@(o, k, a * @READ@(x, k))
	end
	return o
end

-- a * x + y
local function axpy(out: buffer?, a: number, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		@WRITE@(o, k, a * @READ@(x, k) + @READ@(y, k))
	end
	return o
end

local function dot(x: buffer, y: buffer): number
	check_same(x, y)
	local s = 0
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		s += @READ@(x, k) * @READ@(y, k)
	end
	return s
end

-- The conjugate gradient update in one pass: x := x + a p and r := r - a q, returning the
-- real inner product of the new r with itself (as stored). Separate axpys and a dot make
-- three passes, each paying the loop and read costs again.
local function cg_update(x: buffer, r: buffer, p: buffer, q: buffer, a: number): number
	check_same(x, r)
	check_same(x, p)
	check_same(x, q)
	local s = 0
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		@WRITE@(x, k, @READ@(x, k) + a * @READ@(p, k))
		@WRITE@(r, k, @READ@(r, k) - a * @READ@(q, k))
		local v = @READ@(r, k)
		s += v * v
	end
	return s
end

local function sum(x: buffer): number
	local s = 0
	--@unroll
	for k = 0, buffer.len(x) - @W@, @W@ do
		s += @READ@(x, k)
	end
	return s
end

-- Largest absolute value (NaN if any element is NaN, 0 for an empty array).
local function amax(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - @W@, @W@ do
		local a = math.abs(@READ@(x, k))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	return m
end

--@include norms.luau.in

-- Euclidean norm, without overflow or underflow.
local function norm(x: buffer): number
	return segment_norm(x, 0, length(x))
end

-- Matrices

local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(@W@ * rows * cols) }
end

local function matoutput(out: Matrix?, rows: number, cols: number): Matrix
	if out == nil then
		return matrix(rows, cols)
	end
	assert(out.rows == rows and out.cols == cols, "output has the wrong shape")
	return out
end

-- Builds a matrix from a table of rows.
local function matfrom(t: { { number } }): Matrix
	local rows = #t
	local cols = if rows > 0 then #t[1] else 0
	local A = matrix(rows, cols)
	for i = 1, rows do
		local row = t[i]
		assert(#row == cols, "rows have different lengths")
		for j = 1, cols do
			@WRITE@(A.data, @W@ * ((j - 1) * rows + i - 1), row[j])
		end
	end
	return A
end

-- Returns a table of rows.
local function mattotable(A: Matrix): { { number } }
	local t = table.create(A.rows) :: { { number } }
	for i = 1, A.rows do
		local row = table.create(A.cols, 0)
		for j = 1, A.cols do
			row[j] = @READ@(A.data, @W@ * ((j - 1) * A.rows + i - 1))
		end
		t[i] = row
	end
	return t
end

local function identity(n: number): Matrix
	local A = matrix(n, n)
	for i = 0, n - 1 do
		@WRITE@(A.data, @W@ * (i * n + i), 1)
	end
	return A
end

local function matget(A: Matrix, i: number, j: number): number
	return @READ@(A.data, @W@ * ((j - 1) * A.rows + i - 1))
end

local function matset(A: Matrix, i: number, j: number, v: number)
	@WRITE@(A.data, @W@ * ((j - 1) * A.rows + i - 1), v)
end

local function matcopy(out: Matrix?, A: Matrix): Matrix
	local o = matoutput(out, A.rows, A.cols)
	if o.data ~= A.data then
		buffer.copy(o.data, 0, A.data)
	end
	return o
end

local function transpose(out: Matrix?, A: Matrix): Matrix
	local m, n = A.rows, A.cols
	local o = matoutput(out, n, m)
	assert(o.data ~= A.data, "transpose cannot be done in place")
	local a, d = A.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			@WRITE@(d, @W@ * (i * n + j), @READ@(a, @W@ * (j * m + i)))
		end
	end
	return o
end

-- A x
local function matvec(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(buffer.len(x) == @W@ * n, "matrix and vector sizes do not match")
	local o = output(out, @W@ * m)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, m - 1 do
		local s = 0
		for j = 0, n - 1 do
			s += @READ@(a, @W@ * (j * m + i)) * @READ@(x, @W@ * j)
		end
		@WRITE@(o, @W@ * i, s)
	end
	return o
end

-- A B
--@include gemm_real.luau.in

-- The rows of A (m by p, column-major) laid out contiguously: element i * p + k is A[i, k].
local function pack_rows(A: Matrix): buffer
	local m, p = A.rows, A.cols
	local a = A.data
	local R = buffer.create(@W@ * m * p)
	for k = 0, p - 1 do
		for i = 0, m - 1 do
			@WRITE@(R, @W@ * (i * p + k), @READ@(a, @W@ * (k * m + i)))
		end
	end
	return R
end

local function matmul(out: Matrix?, A: Matrix, B: Matrix): Matrix
	local m, p, n = A.rows, A.cols, B.cols
	assert(B.rows == p, "matrix sizes do not match")
	local o = matoutput(out, m, n)
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	-- B's columns are already contiguous; A's rows are packed.
	gemm_kernel(pack_rows(A), B.data, o.data, m, p, n, 1, 0)
	return o
end

-- LU factorization with partial pivoting, in place: A is overwritten with L and U (see
-- types.LU) and returned as F.lu. lu_copy leaves A unchanged.
local function lu(A: Matrix): LU
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local piv = table.create(n, 0)
	local sign = 1
	local singular = false
	for k = 0, n - 1 do
		local p, best = k, -1
		for i = k, n - 1 do
			local v = math.abs(@READ@(a, @W@ * (k * n + i)))
			if v > best then
				p, best = i, v
			end
		end
		piv[k + 1] = p + 1
		if p ~= k then
			sign = -sign
			for j = 0, n - 1 do
				local s, t = @W@ * (j * n + k), @W@ * (j * n + p)
				local tmp = @READ@(a, s)
				@WRITE@(a, s, @READ@(a, t))
				@WRITE@(a, t, tmp)
			end
		end
		local pivot = @READ@(a, @W@ * (k * n + k))
		if pivot == 0 then
			singular = true
		else
			for i = k + 1, n - 1 do
				local off = @W@ * (k * n + i)
				@WRITE@(a, off, @READ@(a, off) / pivot)
			end
			for j = k + 1, n - 1 do
				local akj = @READ@(a, @W@ * (j * n + k))
				for i = k + 1, n - 1 do
					local off = @W@ * (j * n + i)
					@WRITE@(a, off, @READ@(a, off) - @READ@(a, @W@ * (k * n + i)) * akj)
				end
			end
		end
	end
	return { lu = A, piv = piv, sign = sign, singular = singular }
end

-- LU factorization of a copy of A; A is not modified.
local function lu_copy(A: Matrix): LU
	return lu(matcopy(nil, A))
end

-- Solves A x = b given F = lu(A).
local function lu_solve(out: buffer?, F: LU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.lu.rows
	assert(buffer.len(b) == @W@ * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a, piv = F.lu.data, F.piv
	for k = 0, n - 1 do
		local p = piv[k + 1] - 1
		if p ~= k then
			local tmp = @READ@(o, @W@ * k)
			@WRITE@(o, @W@ * k, @READ@(o, @W@ * p))
			@WRITE@(o, @W@ * p, tmp)
		end
	end
	for j = 0, n - 1 do
		local xj = @READ@(o, @W@ * j)
		for i = j + 1, n - 1 do
			local off = @W@ * i
			@WRITE@(o, off, @READ@(o, off) - @READ@(a, @W@ * (j * n + i)) * xj)
		end
	end
	for j = n - 1, 0, -1 do
		local xj = @READ@(o, @W@ * j) / @READ@(a, @W@ * (j * n + j))
		@WRITE@(o, @W@ * j, xj)
		for i = 0, j - 1 do
			local off = @W@ * i
			@WRITE@(o, off, @READ@(o, off) - @READ@(a, @W@ * (j * n + i)) * xj)
		end
	end
	return o
end

-- The inverse of a square matrix, in place (LAPACK's getrf + getri): A is overwritten
-- with A^-1 and returned. An error if A is exactly singular. Solving with solve (or a
-- factorization) is faster and more accurate than forming A^-1 and multiplying; use this
-- when the inverse itself is needed. inv_copy leaves A unchanged.
local function inv(A: Matrix): Matrix
	local F = lu(A)
	assert(not F.singular, "inv: matrix is singular")
	local n = A.rows
	local a = A.data
	local function at(i: number, j: number): number
		return @W@ * (j * n + i)
	end
	-- U := U^-1 (trti2): column j of the inverse is -u_jj^-1 times the inverted leading
	-- block times the old column.
	for j = 0, n - 1 do
		local ujj = 1 / @READ@(a, at(j, j))
		@WRITE@(a, at(j, j), ujj)
		for k = 0, j - 1 do
			local tk = @READ@(a, at(k, j))
			if tk ~= 0 then
				for i = 0, k - 1 do
					@WRITE@(a, at(i, j), @READ@(a, at(i, j)) + tk * @READ@(a, at(i, k)))
				end
				@WRITE@(a, at(k, j), tk * @READ@(a, at(k, k)))
			end
		end
		for i = 0, j - 1 do
			@WRITE@(a, at(i, j), -ujj * @READ@(a, at(i, j)))
		end
	end
	-- Solve X L = U^-1 for X = (P A)^-1, a column at a time from the right (getri).
	local work = table.create(n, 0)
	for j = n - 1, 0, -1 do
		for i = j + 1, n - 1 do
			work[i + 1] = @READ@(a, at(i, j))
			@WRITE@(a, at(i, j), 0)
		end
		for k = j + 1, n - 1 do
			local w = work[k + 1]
			if w ~= 0 then
				for i = 0, n - 1 do
					@WRITE@(a, at(i, j), @READ@(a, at(i, j)) - w * @READ@(a, at(i, k)))
				end
			end
		end
	end
	-- A^-1 = X P: undo the row interchanges as column interchanges, last first.
	for j = n - 2, 0, -1 do
		local p = F.piv[j + 1] - 1
		if p ~= j then
			for i = 0, n - 1 do
				local s, t = at(i, j), at(i, p)
				local tmp = @READ@(a, s)
				@WRITE@(a, s, @READ@(a, t))
				@WRITE@(a, t, tmp)
			end
		end
	end
	return A
end

-- The inverse of a copy of A; A is not modified.
local function inv_copy(A: Matrix): Matrix
	return inv(matcopy(nil, A))
end

local function det(A: Matrix): number
	local F = lu_copy(A)
	local d = F.sign
	local n = A.rows
	for k = 0, n - 1 do
		d *= @READ@(F.lu.data, @W@ * (k * n + k))
	end
	return d
end

-- Cholesky

-- Cholesky factorization A = L L^T of a symmetric positive definite matrix, in place:
-- the lower triangle of A is overwritten with L and returned as F.chol. Only the lower
-- triangle of A is read and the strictly upper triangle is left as it was. If A is not
-- positive definite, F.definite is false and A is partly overwritten. chol_copy leaves A
-- unchanged.
local function chol(A: Matrix): Cholesky
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	for j = 0, n - 1 do
		local d = @READ@(a, @W@ * (j * n + j))
		if not (d > 0) then
			return { chol = A, definite = false }
		end
		local ljj = math.sqrt(d)
		@WRITE@(a, @W@ * (j * n + j), ljj)
		for i = j + 1, n - 1 do
			local off = @W@ * (j * n + i)
			@WRITE@(a, off, @READ@(a, off) / ljj)
		end
		-- Subtract the new column's outer product from the trailing lower triangle.
		for c = j + 1, n - 1 do
			local lc = @READ@(a, @W@ * (j * n + c))
			for i = c, n - 1 do
				local off = @W@ * (c * n + i)
				@WRITE@(a, off, @READ@(a, off) - @READ@(a, @W@ * (j * n + i)) * lc)
			end
		end
	end
	return { chol = A, definite = true }
end

-- Cholesky factorization of a copy of A; A is not modified.
local function chol_copy(A: Matrix): Cholesky
	return chol(matcopy(nil, A))
end

-- The lower triangular factor L, with zeros above the diagonal.
local function chol_l(out: Matrix?, F: Cholesky): Matrix
	local n = F.chol.rows
	local o = matoutput(out, n, n)
	local a, l = F.chol.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = @W@ * (j * n + i)
			@WRITE@(l, off, if i >= j then @READ@(a, off) else 0)
		end
	end
	return o
end

-- Solves A x = b given F = chol(A). b is not modified unless it is passed as out.
local function chol_solve(out: buffer?, F: Cholesky, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local n = F.chol.rows
	assert(buffer.len(b) == @W@ * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = F.chol.data
	-- L y = b
	for j = 0, n - 1 do
		local yj = @READ@(o, @W@ * j) / @READ@(a, @W@ * (j * n + j))
		@WRITE@(o, @W@ * j, yj)
		for i = j + 1, n - 1 do
			local off = @W@ * i
			@WRITE@(o, off, @READ@(o, off) - @READ@(a, @W@ * (j * n + i)) * yj)
		end
	end
	-- L^T x = y, a dot product down each column of L.
	for j = n - 1, 0, -1 do
		local s = @READ@(o, @W@ * j)
		for i = j + 1, n - 1 do
			s -= @READ@(a, @W@ * (j * n + i)) * @READ@(o, @W@ * i)
		end
		@WRITE@(o, @W@ * j, s / @READ@(a, @W@ * (j * n + j)))
	end
	return o
end

-- Householder QR

-- Unit roundoff of the storage precision.
local EPS = @EPS@

-- Applies I - t v v^T to the `len` values of x starting at byte offset `xs`. v starts at
-- byte offset `vs` of `a`; its first entry is an implicit 1.
local function reflect(a: buffer, vs: number, len: number, t: number, x: buffer, xs: number)
	local w = @READ@(x, xs)
	for i = 1, len - 1 do
		w += @READ@(a, vs + @W@ * i) * @READ@(x, xs + @W@ * i)
	end
	if w == 0 then
		return
	end
	w *= t
	@WRITE@(x, xs, @READ@(x, xs) - w)
	for i = 1, len - 1 do
		local off = xs + @W@ * i
		@WRITE@(x, off, @READ@(x, off) - w * @READ@(a, vs + @W@ * i))
	end
end

-- Turns the `len` values of `a` starting at byte offset `diag` into a Householder
-- reflector, in place: beta at `diag` and v below it (its leading 1 is implicit). Stores
-- tau as element k of `tau` and returns it; tau = 0 (H = I) when there is nothing to zero.
local function householder(a: buffer, diag: number, len: number, tau: buffer, k: number): number
	local alpha = @READ@(a, diag)
	local xnorm = segment_norm(a, diag + @W@, len - 1)
	if xnorm == 0 then
		@WRITE@(tau, @W@ * k, 0)
		return 0
	end
	local beta = hypot3(alpha, 0, xnorm)
	if alpha >= 0 then
		beta = -beta
	end
	@WRITE@(tau, @W@ * k, (beta - alpha) / beta)
	-- alpha and beta have opposite signs, so this cannot cancel.
	local d = alpha - beta
	for off = diag + @W@, diag + @W@ * (len - 1), @W@ do
		@WRITE@(a, off, @READ@(a, off) / d)
	end
	@WRITE@(a, diag, beta)
	return @READ@(tau, @W@ * k)
end

-- Solves R z = y in place on the first r entries of y, where R is the leading r by r
-- block of the upper triangle stored in `a` (a matrix with m rows).
local function back_substitute(a: buffer, m: number, r: number, y: buffer)
	for j = r - 1, 0, -1 do
		local rjj = @READ@(a, @W@ * (j * m + j))
		assert(rjj ~= 0, "matrix is rank deficient")
		local yj = @READ@(y, @W@ * j) / rjj
		@WRITE@(y, @W@ * j, yj)
		for i = 0, j - 1 do
			local off = @W@ * i
			@WRITE@(y, off, @READ@(y, off) - @READ@(a, @W@ * (j * m + i)) * yj)
		end
	end
end

-- Householder QR factorization, in place: A is overwritten (see types.QR for the layout)
-- and returned as F.qr. qr_copy leaves A unchanged.
local function qr(A: Matrix): QR
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(@W@ * kmax)
	for k = 0, kmax - 1 do
		local diag = @W@ * (k * m + k)
		local t = householder(a, diag, m - k, tau, k)
		if t ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, t, a, @W@ * (j * m + k))
			end
		end
	end
	return { qr = A, tau = tau }
end

-- Householder QR factorization of a copy of A; A is not modified.
local function qr_copy(A: Matrix): QR
	return qr(matcopy(nil, A))
end

-- x := Q^T x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_qh(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == @W@ * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = 0, buffer.len(tau) // @W@ - 1 do
		reflect(a, @W@ * (k * m + k), m - k, @READ@(tau, @W@ * k), x, @W@ * k)
	end
	return x
end

-- x := Q x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_q(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == @W@ * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = buffer.len(tau) // @W@ - 1, 0, -1 do
		reflect(a, @W@ * (k * m + k), m - k, @READ@(tau, @W@ * k), x, @W@ * k)
	end
	return x
end

-- The min(rows, cols) by cols upper triangular factor R. Also accepts a QRP factorization.
local function qr_r(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, kmax, n)
	local a, r = F.qr.data, o.data
	for j = 0, n - 1 do
		for i = 0, kmax - 1 do
			@WRITE@(r, @W@ * (j * kmax + i), if i <= j then @READ@(a, @W@ * (j * m + i)) else 0)
		end
	end
	return o
end

-- The rows by min(rows, cols) factor Q with orthonormal columns (the thin Q). Also
-- accepts a QRP factorization.
local function qr_q(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, m, kmax)
	local a, tau, q = F.qr.data, F.tau, o.data
	buffer.fill(q, 0, 0)
	for c = 0, kmax - 1 do
		@WRITE@(q, @W@ * (c * m + c), 1)
		-- Reflectors after column c leave the unit vector e_c unchanged.
		for k = c, 0, -1 do
			reflect(a, @W@ * (k * m + k), m - k, @READ@(tau, @W@ * k), q, @W@ * (c * m + k))
		end
	end
	return o
end

-- Least squares: the x minimizing |A x - b| for A with rows >= cols and full column
-- rank, given F = qr(A). b is not modified. Also returns the residual norm |A x - b|.
local function qr_solve(out: buffer?, F: QR, b: buffer): (buffer, number)
	local m, n = F.qr.rows, F.qr.cols
	assert(m >= n, "least squares needs at least as many rows as columns")
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, n, y)
	local o = output(out, @W@ * n)
	buffer.copy(o, 0, y, 0, @W@ * n)
	return o, segment_norm(y, @W@ * n, m - n)
end

-- Column-pivoted QR

-- Householder QR with column pivoting, A P = Q R, in place: A is overwritten as in qr and
-- returned as F.qr; column j of A P is column perm[j] of A. Each step moves the remaining
-- column of largest norm to the front, so |R_11| >= |R_22| >= ... and small trailing
-- diagonal entries reveal the numerical rank. qrp_copy leaves A unchanged.
local function qrp(A: Matrix): QRP
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(@W@ * kmax)
	local perm = table.create(n, 0)
	-- Norms of the unfactored part of each column (partial), and the norm at the last
	-- recomputation (reference), for LAPACK's safeguarded downdating.
	local partial, reference = table.create(n, 0), table.create(n, 0)
	for j = 1, n do
		perm[j] = j
		local v = segment_norm(a, @W@ * (j - 1) * m, m)
		partial[j], reference[j] = v, v
	end
	local recompute = math.sqrt(EPS)
	for k = 0, kmax - 1 do
		local p, best = k, -1
		for j = k, n - 1 do
			if partial[j + 1] > best then
				p, best = j, partial[j + 1]
			end
		end
		if p ~= k then
			for i = 0, m - 1 do
				local s, t = @W@ * (k * m + i), @W@ * (p * m + i)
				local tmp = @READ@(a, s)
				@WRITE@(a, s, @READ@(a, t))
				@WRITE@(a, t, tmp)
			end
			perm[k + 1], perm[p + 1] = perm[p + 1], perm[k + 1]
			partial[p + 1], reference[p + 1] = partial[k + 1], reference[k + 1]
		end

		local diag = @W@ * (k * m + k)
		local t = householder(a, diag, m - k, tau, k)
		if t ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, t, a, @W@ * (j * m + k))
			end
		end

		-- Remove row k from the remaining partial norms. When cancellation would leave too
		-- few correct digits, recompute the norm instead.
		for j = k + 1, n - 1 do
			local v = partial[j + 1]
			if v ~= 0 then
				local ratio = math.abs(@READ@(a, @W@ * (j * m + k))) / v
				local left = math.max(0, 1 - ratio * ratio)
				local drift = v / reference[j + 1]
				if left * drift * drift <= recompute then
					local fresh = segment_norm(a, @W@ * (j * m + k + 1), m - k - 1)
					partial[j + 1], reference[j + 1] = fresh, fresh
				else
					partial[j + 1] = v * math.sqrt(left)
				end
			end
		end
	end
	return { qr = A, tau = tau, perm = perm }
end

-- Column-pivoted QR of a copy of A; A is not modified.
local function qrp_copy(A: Matrix): QRP
	return qrp(matcopy(nil, A))
end

-- Numerical rank: the number of leading diagonal entries of R with |R_kk| > tol |R_11|.
-- The default tol is max(rows, cols) times the unit roundoff of the storage precision.
local function qrp_rank(F: QRP, tol: number?): number
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	if kmax == 0 then
		return 0
	end
	local a = F.qr.data
	local limit = (tol or math.max(m, n) * EPS) * math.abs(@READ@(a, 0))
	for k = 0, kmax - 1 do
		if not (math.abs(@READ@(a, @W@ * (k * m + k))) > limit) then
			return k
		end
	end
	return kmax
end

-- Least squares for any shape and rank, given F = qrp(A): the basic solution, which
-- uses only the first r = qrp_rank(F, tol) pivot columns and sets the other variables
-- to zero. b is not modified. Also returns the residual norm |A x - b| and r.
local function qrp_solve(out: buffer?, F: QRP, b: buffer, tol: number?): (buffer, number, number)
	local m, n = F.qr.rows, F.qr.cols
	local r = qrp_rank(F, tol)
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, r, y)
	local o = output(out, @W@ * n)
	buffer.fill(o, 0, 0)
	for j = 1, r do
		@WRITE@(o, @W@ * (F.perm[j] - 1), @READ@(y, @W@ * (j - 1)))
	end
	return o, segment_norm(y, @W@ * r, m - r), r
end

-- Hessenberg reduction and symmetric eigenvalues

-- Reals per matrix entry, for the shared tridiagonal eigensolver.
local PARTS = 1

--@include tridiagonal_eigen.luau.in

-- In place, LAPACK's org2r: the `count` reflectors stored below the diagonal of the first
-- columns of the `rows` by `cols` block at (r0, r0) of the matrix in `a` (leading
-- dimension ld, with their tau values in `tau`) are replaced by the first `cols` columns
-- of the block's Q = H_1 ... H_count.
local function form_q(a: buffer, ld: number, r0: number, rows: number, cols: number, count: number, tau: buffer)
	local function at(i: number, j: number): number
		return @W@ * ((r0 + j) * ld + r0 + i)
	end
	for j = count, cols - 1 do
		for i = 0, rows - 1 do
			@WRITE@(a, at(i, j), if i == j then 1 else 0)
		end
	end
	for i = count - 1, 0, -1 do
		local t = @READ@(tau, @W@ * i)
		for j = i + 1, cols - 1 do
			reflect(a, at(i, i), rows - i, t, a, at(i, j))
		end
		for r = i + 1, rows - 1 do
			@WRITE@(a, at(r, i), -t * @READ@(a, at(r, i)))
		end
		@WRITE@(a, at(i, i), 1 - t)
		for r = 0, i - 1 do
			@WRITE@(a, at(r, i), 0)
		end
	end
end

-- Forms in place the n by n Q = H_0 ... H_count-1 of a Hessenberg or tridiagonal
-- reduction, whose reflector k acts on rows k+1.. and is stored below row k+1 of column k.
local function form_reduction_q(a: buffer, n: number, count: number, tau: buffer)
	if n == 0 then
		return
	end
	-- Move each reflector one column right, so that it sits below the diagonal of the
	-- trailing n-1 by n-1 block, where form_q expects it.
	for k = count - 1, 0, -1 do
		for i = k + 2, n - 1 do
			@WRITE@(a, @W@ * ((k + 1) * n + i), @READ@(a, @W@ * (k * n + i)))
		end
	end
	for i = 0, n - 1 do
		@WRITE@(a, @W@ * i, if i == 0 then 1 else 0)
		@WRITE@(a, @W@ * (i * n), if i == 0 then 1 else 0)
	end
	form_q(a, n, 1, n - 1, n - 1, count, tau)
end

-- Hessenberg reduction restricted to rows and columns ilo..ihi (0-based), for a matrix
-- that is already upper triangular outside that block (as balancing leaves it): only
-- reflectors inside the block are made (tau = 0 elsewhere), but they are applied to the
-- whole matrix.
local function hess_range(A: Matrix, ilo: number, ihi: number): Hessenberg
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local count = math.max(n - 2, 0)
	local tau = buffer.create(@W@ * count)
	local w = table.create(n, 0)
	for k = ilo, ihi - 2 do
		local vs = @W@ * (k * n + k + 1)
		local len = ihi - k
		local t = householder(a, vs, len, tau, k)
		if t ~= 0 then
			-- From the left: rows k+1.. of columns k+1..
			for j = k + 1, n - 1 do
				reflect(a, vs, len, t, a, @W@ * (j * n + k + 1))
			end
			-- From the right: A := A - t (A v) v^T on columns k+1..
			for i = 0, ihi do
				w[i + 1] = @READ@(a, @W@ * ((k + 1) * n + i))
			end
			for c = 1, len - 1 do
				local vc = @READ@(a, vs + @W@ * c)
				local col = @W@ * ((k + 1 + c) * n)
				for i = 0, ihi do
					w[i + 1] += @READ@(a, col + @W@ * i) * vc
				end
			end
			for c = 0, len - 1 do
				local tv = t * (if c == 0 then 1 else @READ@(a, vs + @W@ * c))
				local col = @W@ * ((k + 1 + c) * n)
				for i = 0, ihi do
					@WRITE@(a, col + @W@ * i, @READ@(a, col + @W@ * i) - w[i + 1] * tv)
				end
			end
		end
	end
	return { hess = A, tau = tau }
end


-- Upper Hessenberg reduction A = Q H Q^H (^T for real A), in place: A is overwritten with H
-- on and above the subdiagonal and, below it, the reflectors H_k = I - tau_k v_k v_k^H (v_k
-- has a 1 in row k+1, not stored, and is stored below that in column k).
-- Q = H_0 ... H_n-3. hess_copy leaves A unchanged.
local function hess(A: Matrix): Hessenberg
	return hess_range(A, 0, A.rows - 1)
end

-- Hessenberg reduction of a copy of A; A is not modified.
local function hess_copy(A: Matrix): Hessenberg
	return hess(matcopy(nil, A))
end

-- The upper Hessenberg factor H, with zeros below the subdiagonal.
local function hess_h(out: Matrix?, F: Hessenberg): Matrix
	local n = F.hess.rows
	local o = matoutput(out, n, n)
	local a, h = F.hess.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = @W@ * (j * n + i)
			@WRITE@(h, off, if i <= j + 1 then @READ@(a, off) else 0)
		end
	end
	return o
end

-- The orthogonal factor Q.
local function hess_q(out: Matrix?, F: Hessenberg): Matrix
	local n = F.hess.rows
	local o = matcopy(out, F.hess)
	form_reduction_q(o.data, n, buffer.len(F.tau) // @W@, F.tau)
	return o
end

-- Reduces the symmetric matrix whose lower triangle is in A to tridiagonal form,
-- A = Q T Q^T, in place (LAPACK's sytd2): returns T's diagonal d and off-diagonal e as
-- tables and leaves the reflectors (stored as in hess) and their tau in A and `tau`.
local function tridiagonalize(A: Matrix): ({ number }, { number }, buffer)
	local n = A.rows
	local a = A.data
	local count = math.max(n - 1, 0)
	local tau = buffer.create(@W@ * count)
	local d, e = table.create(n, 0), table.create(count, 0)
	local v, x = table.create(n, 0), table.create(n, 0)
	for k = 0, count - 1 do
		local vs = @W@ * (k * n + k + 1)
		local len = n - k - 1
		local t = householder(a, vs, len, tau, k)
		e[k + 1] = @READ@(a, vs)
		if t ~= 0 then
			v[1] = 1
			for r = 1, len - 1 do
				v[r + 1] = @READ@(a, vs + @W@ * r)
			end
			-- x = t A22 v, with A22 = A[k+1.., k+1..] read from its lower triangle.
			for r = 1, len do
				x[r] = 0
			end
			for c = 0, len - 1 do
				local col = @W@ * ((k + 1 + c) * n + k + 1)
				local vc = v[c + 1]
				local acc = @READ@(a, col + @W@ * c) * vc
				for r = c + 1, len - 1 do
					local arc = @READ@(a, col + @W@ * r)
					x[r + 1] += arc * vc
					acc += arc * v[r + 1]
				end
				x[c + 1] += acc
			end
			local xv = 0
			for r = 1, len do
				x[r] *= t
				xv += x[r] * v[r]
			end
			-- w = x - (t / 2) (x . v) v, then A22 := A22 - v w^T - w v^T (lower triangle).
			local alpha = -0.5 * t * xv
			for r = 1, len do
				x[r] += alpha * v[r]
			end
			for c = 0, len - 1 do
				local col = @W@ * ((k + 1 + c) * n + k + 1)
				local vc, wc = v[c + 1], x[c + 1]
				for r = c, len - 1 do
					local off = col + @W@ * r
					@WRITE@(a, off, @READ@(a, off) - v[r + 1] * wc - x[r + 1] * vc)
				end
			end
		end
		d[k + 1] = @READ@(a, @W@ * (k * n + k))
	end
	if n > 0 then
		d[n] = @READ@(a, @W@ * ((n - 1) * n + n - 1))
	end
	return d, e, tau
end

-- Eigenvalues (ascending) and, unless vectors is false, orthonormal eigenvectors of a
-- symmetric matrix, in place: only the lower triangle of A is read, and A is overwritten
-- with the eigenvectors (column j belongs to values[j]), or with workspace if vectors is
-- false. Tridiagonalization, then implicit QR with Wilkinson shifts in double precision.
-- If the lower triangle holds a NaN or an infinity, the values and A are all NaN.
-- eigh_copy leaves A unchanged.
local function eigh(A: Matrix, vectors: boolean?): Eigh
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local want = vectors ~= false
	for j = 0, n - 1 do
		if any_nonfinite(A.data, @W@ * (j * n + j), n - j) then
			local values = buffer.create(@W@ * n)
			fill_nan(values, 0, n)
			fill_nan(A.data, 0, n * n)
			return { values = values, vectors = if want then A else nil }
		end
	end
	-- Scaled into a safe range (see range_factor), by the lower triangle; the values are
	-- scaled back and the vectors do not change.
	local big = 0
	for j = 0, n - 1 do
		for i = j, n - 1 do
			big = math.max(big, math.abs(@READ@(A.data, @W@ * (j * n + i))))
		end
	end
	local sc = range_factor(big)
	if sc ~= 1 then
		scale(A.data, sc, A.data)
	end
	local d, e, tau = tridiagonalize(A)
	if want then
		form_reduction_q(A.data, n, buffer.len(tau) // @W@, tau)
	end
	tridiagonal_eigen(d, e, if want then A.data else nil, n)
	local values = buffer.create(@W@ * n)
	for i = 1, n do
		@WRITE@(values, @W@ * (i - 1), d[i] / sc)
	end
	return { values = values, vectors = if want then A else nil }
end

-- Symmetric eigendecomposition of a copy of A; A is not modified.
local function eigh_copy(A: Matrix, vectors: boolean?): Eigh
	return eigh(matcopy(nil, A), vectors)
end

-- Nonsymmetric eigenvalues

-- Schur factorization of a real 2 by 2 block (LAPACK's lanv2): returns the standardized
-- block a, b, c, d (upper triangular if the eigenvalues are real; otherwise a = d and
-- b c < 0), the eigenvalues rt1 = (rt1r, rt1i) and rt2, and the rotation (cs, sn) with
-- [a b; c d]_in = [cs -sn; sn cs] [a b; c d]_out [cs sn; -sn cs].
local function lanv2(
	a: number,
	b: number,
	c: number,
	d: number
): (number, number, number, number, number, number, number, number, number, number)
	local function sgn(x: number): number
		return if x >= 0 then 1 else -1
	end
	local cs, sn = 1, 0
	if c == 0 then
		cs, sn = 1, 0
	elseif b == 0 then
		cs, sn = 0, 1
		a, d = d, a
		b, c = -c, 0
	elseif a - d == 0 and sgn(b) ~= sgn(c) then
		cs, sn = 1, 0
	else
		local temp = a - d
		local p = 0.5 * temp
		local bcmax = math.max(math.abs(b), math.abs(c))
		local bcmis = math.min(math.abs(b), math.abs(c)) * sgn(b) * sgn(c)
		local scale = math.max(math.abs(p), bcmax)
		local z = (p / scale) * p + (bcmax / scale) * bcmis
		if z >= 4 * 2 * EPS then
			-- Real eigenvalues: make the block upper triangular.
			z = p + sgn(p) * (math.sqrt(scale) * math.sqrt(z))
			a = d + z
			d = d - (bcmax / z) * bcmis
			local tau = hypot3(c, z, 0)
			cs, sn = z / tau, c / tau
			b, c = b - c, 0
		else
			-- Complex or nearly equal real eigenvalues: make the diagonal equal.
			local sigma = b + c
			local tau = hypot3(sigma, temp, 0)
			cs = math.sqrt(0.5 * (1 + math.abs(sigma) / tau))
			sn = -(p / (tau * cs)) * sgn(sigma)
			local aa, bb = a * cs + b * sn, -a * sn + b * cs
			local cc, dd = c * cs + d * sn, -c * sn + d * cs
			a, b = aa * cs + cc * sn, bb * cs + dd * sn
			c, d = -aa * sn + cc * cs, -bb * sn + dd * cs
			temp = 0.5 * (a + d)
			a, d = temp, temp
			if c ~= 0 then
				if b ~= 0 then
					if sgn(b) == sgn(c) then
						-- Real eigenvalues after all: make the block upper triangular.
						local sab, sac = math.sqrt(math.abs(b)), math.sqrt(math.abs(c))
						p = sgn(c) * (sab * sac)
						tau = 1 / math.sqrt(math.abs(b + c))
						a, d = temp + p, temp - p
						b, c = b - c, 0
						local cs1, sn1 = sab * tau, sac * tau
						cs, sn = cs * cs1 - sn * sn1, cs * sn1 + sn * cs1
					end
				else
					b, c = -c, 0
					cs, sn = -sn, cs
				end
			end
		end
	end
	local rt1i = 0
	if c ~= 0 then
		rt1i = math.sqrt(math.abs(b)) * math.sqrt(math.abs(c))
	end
	return a, b, c, d, a, rt1i, d, -rt1i, cs, sn
end

-- A reflector I - tau v v^T, v = (1, v2, v3), taking (alpha, x2, x3) to (beta, 0, 0).
local function small_reflector(alpha: number, x2: number, x3: number): (number, number, number, number)
	local xnorm = hypot3(x2, x3, 0)
	if xnorm == 0 then
		return alpha, 0, 0, 0
	end
	local beta = hypot3(alpha, xnorm, 0)
	if alpha >= 0 then
		beta = -beta
	end
	local d = alpha - beta
	return beta, (beta - alpha) / beta, x2 / d, x3 / d
end

-- Double-shift Francis QR (LAPACK's lahqr) on the upper Hessenberg matrix in h (n by n,
-- zero below the subdiagonal), in place. With wantt, h becomes the real Schur form T:
-- quasi-triangular, with standardized 2 by 2 blocks for complex conjugate pairs. With z,
-- the orthogonal transformations are accumulated into its columns. Returns the real and
-- imaginary parts of the eigenvalues, in the order of T's diagonal.
local function real_schur(h: buffer, n: number, wantt: boolean, z: buffer?, ilo: number, ihi: number): ({ number }, { number })
	local function H(i: number, j: number): number
		return @READ@(h, @W@ * (j * n + i))
	end
	local function set(i: number, j: number, v: number)
		@WRITE@(h, @W@ * (j * n + i), v)
	end
	local wr, wi = table.create(n, 0), table.create(n, 0)
	local ulp = 2 * EPS
	local smlnum = 2 ^ -1000 * (n / ulp)
	local itmax = 30 * math.max(10, n)
	local kdefl = 0
	-- Eigenvalues outside ilo..ihi were isolated by balancing: they are on the diagonal.
	for k = 0, n - 1 do
		if k < ilo or k > ihi then
			wr[k + 1], wi[k + 1] = H(k, k), 0
		end
	end
	local i = ihi
	while i >= ilo do
		local l = ilo
		local converged = false
		for _ = 0, itmax do
			-- Look for a negligible subdiagonal entry (Ahues and Tisseur's test).
			local k = i
			while k > l do
				local sub = math.abs(H(k, k - 1))
				if sub <= smlnum then
					break
				end
				local tst = math.abs(H(k - 1, k - 1)) + math.abs(H(k, k))
				if tst == 0 then
					if k - 2 >= ilo then
						tst += math.abs(H(k - 1, k - 2))
					end
					if k + 1 <= ihi then
						tst += math.abs(H(k + 1, k))
					end
				end
				if sub <= ulp * tst then
					local sup = math.abs(H(k - 1, k))
					local ab, ba = math.max(sub, sup), math.min(sub, sup)
					local hkk, gap = math.abs(H(k, k)), math.abs(H(k - 1, k - 1) - H(k, k))
					local aa, bb = math.max(hkk, gap), math.min(hkk, gap)
					local s = aa + ab
					if ba * (ab / s) <= math.max(smlnum, ulp * (bb * (aa / s))) then
						break
					end
				end
				k -= 1
			end
			l = k
			if l > ilo then
				set(l, l - 1, 0)
			end
			if l >= i - 1 then
				converged = true
				break
			end
			kdefl += 1
			local i1, i2 = if wantt then 0 else l, if wantt then n - 1 else i

			-- Shifts: the eigenvalues of the trailing 2 by 2 block, or an exceptional
			-- shift after 10 (top) or 20 (bottom) iterations without a deflation.
			local h11: number, h12: number, h21: number, h22: number
			if kdefl % 20 == 0 or kdefl % 10 == 0 then
				local s = if kdefl % 20 == 0
					then math.abs(H(i, i - 1)) + math.abs(H(i - 1, i - 2))
					else math.abs(H(l + 1, l)) + math.abs(H(l + 2, l + 1))
				h11 = 0.75 * s + (if kdefl % 20 == 0 then H(i, i) else H(l, l))
				h12 = -0.4375 * s
				h21 = s
				h22 = h11
			else
				h11 = H(i - 1, i - 1)
				h21 = H(i, i - 1)
				h12 = H(i - 1, i)
				h22 = H(i, i)
			end
			local rt1r, rt1i, rt2r, rt2i = 0, 0, 0, 0
			local s = math.abs(h11) + math.abs(h12) + math.abs(h21) + math.abs(h22)
			if s ~= 0 then
				h11, h21, h12, h22 = h11 / s, h21 / s, h12 / s, h22 / s
				local tr = (h11 + h22) / 2
				local det = (h11 - tr) * (h22 - tr) - h12 * h21
				local rtdisc = math.sqrt(math.abs(det))
				if det >= 0 then
					-- A complex conjugate pair.
					rt1r, rt1i = tr * s, rtdisc * s
					rt2r, rt2i = rt1r, -rt1i
				else
					-- Two real shifts: use the one closer to h22 twice.
					rt1r, rt2r = tr + rtdisc, tr - rtdisc
					if math.abs(rt1r - h22) <= math.abs(rt2r - h22) then
						rt1r *= s
						rt2r = rt1r
					else
						rt2r *= s
						rt1r = rt2r
					end
				end
			end

			-- Look for two consecutive small subdiagonal entries, to start the bulge lower.
			local m = i - 2
			local v1, v2, v3 = 0, 0, 0
			while true do
				local hmm = H(m, m)
				local sc = math.abs(hmm - rt2r) + math.abs(rt2i) + math.abs(H(m + 1, m))
				local h21s = H(m + 1, m) / sc
				v1 = h21s * H(m, m + 1) + (hmm - rt1r) * ((hmm - rt2r) / sc) - rt1i * (rt2i / sc)
				v2 = h21s * (hmm + H(m + 1, m + 1) - rt1r - rt2r)
				v3 = h21s * H(m + 2, m + 1)
				sc = math.abs(v1) + math.abs(v2) + math.abs(v3)
				v1, v2, v3 = v1 / sc, v2 / sc, v3 / sc
				if m == l then
					break
				end
				local h00 = math.abs(H(m, m - 1)) * (math.abs(v2) + math.abs(v3))
				local h01 = math.abs(v1) * (math.abs(H(m - 1, m - 1)) + math.abs(hmm) + math.abs(H(m + 1, m + 1)))
				if h00 <= ulp * h01 then
					break
				end
				m -= 1
			end

			-- The double-shift step: chase the bulge from row m to the bottom.
			for k2 = m, i - 1 do
				local nr = math.min(3, i - k2 + 1)
				if k2 > m then
					v1 = H(k2, k2 - 1)
					v2 = H(k2 + 1, k2 - 1)
					v3 = if nr == 3 then H(k2 + 2, k2 - 1) else 0
				end
				local beta, t1, w2, w3 = small_reflector(v1, v2, if nr == 3 then v3 else 0)
				if k2 > m then
					set(k2, k2 - 1, beta)
					set(k2 + 1, k2 - 1, 0)
					if k2 < i - 1 then
						set(k2 + 2, k2 - 1, 0)
					end
				elseif m > l then
					set(k2, k2 - 1, H(k2, k2 - 1) * (1 - t1))
				end
				if t1 ~= 0 then
					local t2, t3 = t1 * w2, t1 * w3
					-- Rows k2.. (columns k2..i2) := H rows, with direct offsets: these loops
					-- are where the time goes.
					if nr == 3 then
						for j = k2, i2 do
							local o = @W@ * (j * n + k2)
							local a0, a1, a2 = @READ@(h, o), @READ@(h, o + @W@), @READ@(h, o + 2 * @W@)
							local sum = a0 + w2 * a1 + w3 * a2
							@WRITE@(h, o, a0 - sum * t1)
							@WRITE@(h, o + @W@, a1 - sum * t2)
							@WRITE@(h, o + 2 * @W@, a2 - sum * t3)
						end
					else
						for j = k2, i2 do
							local o = @W@ * (j * n + k2)
							local a0, a1 = @READ@(h, o), @READ@(h, o + @W@)
							local sum = a0 + w2 * a1
							@WRITE@(h, o, a0 - sum * t1)
							@WRITE@(h, o + @W@, a1 - sum * t2)
						end
					end
					-- Columns k2.. (rows first..last) of buf := columns H.
					local function columns(buf: buffer, first: number, last: number)
						local c0, c1, c2 = @W@ * (k2 * n), @W@ * ((k2 + 1) * n), @W@ * ((k2 + 2) * n)
						if nr == 3 then
							for j = first, last do
								local o = @W@ * j
								local a0, a1, a2 = @READ@(buf, c0 + o), @READ@(buf, c1 + o), @READ@(buf, c2 + o)
								local sum = a0 + w2 * a1 + w3 * a2
								@WRITE@(buf, c0 + o, a0 - sum * t1)
								@WRITE@(buf, c1 + o, a1 - sum * t2)
								@WRITE@(buf, c2 + o, a2 - sum * t3)
							end
						else
							for j = first, last do
								local o = @W@ * j
								local a0, a1 = @READ@(buf, c0 + o), @READ@(buf, c1 + o)
								local sum = a0 + w2 * a1
								@WRITE@(buf, c0 + o, a0 - sum * t1)
								@WRITE@(buf, c1 + o, a1 - sum * t2)
							end
						end
					end
					columns(h, i1, if nr == 3 then math.min(k2 + 3, i) else i)
					if z then
						columns(z, 0, n - 1)
					end
				end
			end
		end
		if not converged then
			error("eig: the QR iteration did not converge")
		end

		if l == i then
			-- A 1 by 1 block: a real eigenvalue.
			wr[i + 1], wi[i + 1] = H(i, i), 0
		else
			-- A 2 by 2 block: standardize it and apply the rotation to the rest.
			local a, b, c, d, r1r, r1i, r2r, r2i, cs, sn = lanv2(H(i - 1, i - 1), H(i - 1, i), H(i, i - 1), H(i, i))
			set(i - 1, i - 1, a)
			set(i - 1, i, b)
			set(i, i - 1, c)
			set(i, i, d)
			wr[i], wi[i], wr[i + 1], wi[i + 1] = r1r, r1i, r2r, r2i
			if wantt then
				for j = i + 1, n - 1 do
					local x, y = H(i - 1, j), H(i, j)
					set(i - 1, j, cs * x + sn * y)
					set(i, j, cs * y - sn * x)
				end
				for j = 0, i - 2 do
					local x, y = H(j, i - 1), H(j, i)
					set(j, i - 1, cs * x + sn * y)
					set(j, i, cs * y - sn * x)
				end
			end
			if z then
				local c0, c1 = @W@ * ((i - 1) * n), @W@ * (i * n)
				for j = 0, n - 1 do
					local o = @W@ * j
					local x, y = @READ@(z, c0 + o), @READ@(z, c1 + o)
					@WRITE@(z, c0 + o, cs * x + sn * y)
					@WRITE@(z, c1 + o, cs * y - sn * x)
				end
			end
		end
		kdefl = 0
		i = l - 1
	end
	return wr, wi
end

-- Reduces A to Hessenberg form and runs real_schur on it; returns the Schur vectors (if
-- wantz) and the eigenvalues. With ilo and ihi (from balance), only that block is iterated on.
local function schur_impl(A: Matrix, wantt: boolean, wantz: boolean, ilo: number?, ihi: number?): (Matrix?, { number }, { number })
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	if any_nonfinite(A.data, 0, n * n) then
		-- NaN or infinity in, NaN out: T, Z and the eigenvalues.
		fill_nan(A.data, 0, n * n)
		local Z = if wantz then matrix(n, n) else nil
		if Z then
			fill_nan(Z.data, 0, n * n)
		end
		return Z, table.create(n, 0 / 0) :: { number }, table.create(n, 0 / 0) :: { number }
	end
	local lo, hi = ilo or 0, ihi or n - 1
	local F = hess_range(A, lo, hi)
	local Z = if wantz then hess_q(nil, F) else nil
	local a = A.data
	for j = 0, n - 3 do
		for i = j + 2, n - 1 do
			@WRITE@(a, @W@ * (j * n + i), 0)
		end
	end
	local wr, wi = real_schur(a, n, wantt, if Z then Z.data else nil, lo, hi)
	return Z, wr, wi
end

-- The eigenvalues as a complex array of the same precision.
local function complex_values(wr: { number }, wi: { number }): buffer
	local values = buffer.create(2 * @W@ * #wr)
	for k = 1, #wr do
		@WRITE@(values, 2 * @W@ * (k - 1), wr[k])
		@WRITE@(values, 2 * @W@ * (k - 1) + @W@, wi[k])
	end
	return values
end

-- Real Schur factorization A = Z T Z^T, in place: A is overwritten with the
-- quasi-triangular T, whose 2 by 2 diagonal blocks (standardized, with equal diagonal
-- entries) hold the complex conjugate eigenvalue pairs. Z is computed unless vectors is
-- false. values is a complex array (@CMOD@) of the eigenvalues in the order of T's
-- diagonal. If A holds a NaN or an infinity, T, Z and the values are all NaN.
-- schur_copy leaves A unchanged.
local function schur(A: Matrix, vectors: boolean?): Schur
	-- Scaled into a safe range and back (Z does not change).
	local sc = range_scale(A.data)
	local Z, wr, wi = schur_impl(A, true, vectors ~= false)
	if sc ~= 1 then
		scale(A.data, 1 / sc, A.data)
		for k = 1, #wr do
			wr[k] /= sc
			wi[k] /= sc
		end
	end
	return { schur = A, z = Z, values = complex_values(wr, wi) }
end

-- Real Schur factorization of a copy of A; A is not modified.
local function schur_copy(A: Matrix, vectors: boolean?): Schur
	return schur(matcopy(nil, A), vectors)
end

-- What balance did: rows and columns ilo..ihi (0-based) form the block left to the
-- eigensolver, scale holds the diagonal of D, and swaps lists the row/column exchanges in
-- order (as pairs).
type Balance = { ilo: number, ihi: number, scale: { number }, swaps: { number } }

-- Balances the square matrix A in place, as LAPACK's gebal does:
-- 1. Permutation: a row that is zero off the diagonal isolates an eigenvalue (its diagonal
--    entry) and is moved to the bottom; a column that is zero off the diagonal likewise, to
--    the top. Repeating this leaves A block upper triangular, with triangular blocks
--    outside rows and columns ilo..ihi, so only that block needs the QR algorithm.
-- 2. Scaling: A := D^-1 A D on that block, with D a diagonal of powers of 2 (exact),
--    chosen so each row and the matching column have similar 2-norms. The eigenvalues are
--    unchanged but computed more accurately when A is badly scaled, because the
--    eigensolver's error is proportional to |A|.
-- Eigenvectors of the original A are P D times those of the balanced matrix (unbalance).
local function balance(A: Matrix): Balance
	local n = A.rows
	local a = A.data
	local function at(i: number, j: number): number
		return @W@ * (j * n + i)
	end
	local swaps = {}
	-- Exchanges rows i and j and columns i and j (a permutation similarity).
	local function exchange(i: number, j: number)
		if i == j then
			return
		end
		table.insert(swaps, i)
		table.insert(swaps, j)
		for k = 0, n - 1 do
			local s, t = at(k, i), at(k, j)
			local tmp = @READ@(a, s)
			@WRITE@(a, s, @READ@(a, t))
			@WRITE@(a, t, tmp)
		end
		for k = 0, n - 1 do
			local s, t = at(i, k), at(j, k)
			local tmp = @READ@(a, s)
			@WRITE@(a, s, @READ@(a, t))
			@WRITE@(a, t, tmp)
		end
	end
	local lo, hi = 0, n - 1
	-- Rows zero off the diagonal (in columns 0..hi): move to the bottom.
	local found = true
	while found and hi > 0 do
		found = false
		for j = hi, 0, -1 do
			local zero = true
			for c = 0, hi do
				if c ~= j and @READ@(a, at(j, c)) ~= 0 then
					zero = false
					break
				end
			end
			if zero then
				exchange(j, hi)
				hi -= 1
				found = true
				break
			end
		end
	end
	-- Columns zero off the diagonal (in rows lo..hi): move to the top.
	found = true
	while found and lo < hi do
		found = false
		for j = lo, hi do
			local zero = true
			for r = lo, hi do
				if r ~= j and @READ@(a, at(r, j)) ~= 0 then
					zero = false
					break
				end
			end
			if zero then
				exchange(j, lo)
				lo += 1
				found = true
				break
			end
		end
	end
	-- Scaling of the block lo..hi.
	local d = table.create(n, 1)
	local function rownorm(i: number): number
		local big = 0
		for j = lo, hi do
			big = math.max(big, math.abs(@READ@(a, at(i, j))))
		end
		if big == 0 then
			return 0
		end
		local s = 0
		for j = lo, hi do
			local v = @READ@(a, at(i, j)) / big
			s += v * v
		end
		return big * math.sqrt(s)
	end
	local converged = false
	while not converged do
		converged = true
		for i = lo, hi do
			local c, r = segment_norm(a, at(lo, i), hi - lo + 1), rownorm(i)
			if c > 0 and r > 0 then
				-- Column i times f and row i divided by f have norms about c f and r / f; take
				-- the power of 2 that brings those within a factor of 2 of each other.
				local f, cf, rf = 1, c, r
				while cf < rf / 2 and f < 2 ^ 500 do
					f, cf, rf = f * 2, cf * 2, rf / 2
				end
				while cf >= rf * 2 and f > 2 ^ -500 do
					f, cf, rf = f / 2, cf / 2, rf * 2
				end
				if cf + rf < 0.95 * (c + r) then
					converged = false
					d[i + 1] *= f
					for j = 0, n - 1 do
						@WRITE@(a, at(i, j), @READ@(a, at(i, j)) / f)
						@WRITE@(a, at(j, i), @READ@(a, at(j, i)) * f)
					end
				end
			end
		end
	end
	return { ilo = lo, ihi = hi, scale = d, swaps = swaps }
end

-- Maps eigenvectors of a balanced matrix back (x = P D x') and rescales each to unit
-- length. v holds n columns of n complex entries (@CMOD@ layout).
local function unbalance(v: buffer, n: number, B: Balance)
	local E = 2 * @W@
	local d, swaps = B.scale, B.swaps
	for j = 0, n - 1 do
		local col = E * j * n
		for i = 0, n - 1 do
			local o = col + E * i
			@WRITE@(v, o, @READ@(v, o) * d[i + 1])
			@WRITE@(v, o + @W@, @READ@(v, o + @W@) * d[i + 1])
		end
		-- Undo the exchanges, last first.
		for s = #swaps - 1, 1, -2 do
			local p, q = col + E * swaps[s], col + E * swaps[s + 1]
			for part = 0, @W@, @W@ do
				local tmp = @READ@(v, p + part)
				@WRITE@(v, p + part, @READ@(v, q + part))
				@WRITE@(v, q + part, tmp)
			end
		end
		local nrm = segment_norm(v, col, 2 * n)
		if nrm > 0 then
			for k = col, col + E * n - @W@, @W@ do
				@WRITE@(v, k, @READ@(v, k) / nrm)
			end
		end
	end
end

-- The complex Schur form of a real matrix from its real Schur form (A holds T, with Z
-- and the eigenvalues wr + i wi from real_schur): each 2 by 2 block with a complex pair
-- is triangularized by a unitary G whose first column is an eigenvector. Returns the
-- complex T and Z.
local function to_complex_schur(A: Matrix, Z: Matrix, wr: { number }, wi: { number }): (Matrix, Matrix)
	local n = A.rows
	local T = complexmod.matrix(n, n)
	T.data = complexmod.complexify(A.data)
	local Zc = complexmod.matrix(n, n)
	Zc.data = complexmod.complexify(Z.data)
	local t, zc = T.data, Zc.data
	local E = 2 * @W@
	local k = 0
	while k < n - 1 do
		if wi[k + 1] == 0 then
			k += 1
			continue
		end
		local lr, li = wr[k + 1], wi[k + 1]
		local p, q = @READ@(A.data, @W@ * (k * n + k)), @READ@(A.data, @W@ * ((k + 1) * n + k))
		-- Eigenvector (q, lambda - p) of the block, normalized: G = [g1, (-conj g21, conj g11)].
		local nrm = hypot3(q, lr - p, li)
		local g1r, g1i, g2r, g2i = q / nrm, 0, (lr - p) / nrm, li / nrm
		-- Rows k, k+1 of T (columns k..) := G^H rows.
		for j = k, n - 1 do
			local o1, o2 = E * (j * n + k), E * (j * n + k + 1)
			local ar, ai = @READ@(t, o1), @READ@(t, o1 + @W@)
			local br, bi = @READ@(t, o2), @READ@(t, o2 + @W@)
			-- conj(g1) a + conj(g2) b, then -g2 a + g1 b
			@WRITE@(t, o1, g1r * ar + g1i * ai + g2r * br + g2i * bi)
			@WRITE@(t, o1 + @W@, g1r * ai - g1i * ar + g2r * bi - g2i * br)
			@WRITE@(t, o2, -(g2r * ar - g2i * ai) + g1r * br - g1i * bi)
			@WRITE@(t, o2 + @W@, -(g2r * ai + g2i * ar) + g1r * bi + g1i * br)
		end
		-- Columns k, k+1 of T (rows ..k+1) and of Zc := columns G.
		local function columns(buf: buffer, rows: number)
			for j = 0, rows - 1 do
				local o1, o2 = E * (k * n + j), E * ((k + 1) * n + j)
				local ar, ai = @READ@(buf, o1), @READ@(buf, o1 + @W@)
				local br, bi = @READ@(buf, o2), @READ@(buf, o2 + @W@)
				-- a g1 + b g2, then -a conj(g2) + b conj(g1)
				@WRITE@(buf, o1, ar * g1r - ai * g1i + br * g2r - bi * g2i)
				@WRITE@(buf, o1 + @W@, ar * g1i + ai * g1r + br * g2i + bi * g2r)
				@WRITE@(buf, o2, -(ar * g2r + ai * g2i) + br * g1r + bi * g1i)
				@WRITE@(buf, o2 + @W@, -(ai * g2r - ar * g2i) + bi * g1r - br * g1i)
			end
		end
		columns(t, k + 2)
		columns(zc, n)
		-- The block is now exactly [lambda, *; 0, conj(lambda)].
		@WRITE@(t, E * (k * n + k), lr)
		@WRITE@(t, E * (k * n + k) + @W@, li)
		@WRITE@(t, E * (k * n + k + 1), 0)
		@WRITE@(t, E * (k * n + k + 1) + @W@, 0)
		@WRITE@(t, E * ((k + 1) * n + k + 1), wr[k + 2])
		@WRITE@(t, E * ((k + 1) * n + k + 1) + @W@, wi[k + 2])
		k += 2
	end
	return T, Zc
end

-- Eigenvalues and, unless vectors is false, unit eigenvectors of a general real matrix.
-- Both are complex (@CMOD@): values is a complex array and column k of vectors (a complex
-- matrix) belongs to values[k]. Unless balanced is false, A is balanced first (permuted
-- and scaled; see balance), as LAPACK's geev does by default. A is overwritten with the
-- (balanced) real Schur form, or with workspace if vectors is false; the eigenvectors are a new matrix.
-- If A holds a NaN or an infinity, the values, the vectors and A are all NaN. eig_copy
-- leaves A unchanged.
local function eig(A: Matrix, vectors: boolean?, balanced: boolean?): Eig
	local want = vectors ~= false
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	if any_nonfinite(A.data, 0, n * n) then
		fill_nan(A.data, 0, n * n)
		local values = buffer.create(2 * @W@ * n)
		fill_nan(values, 0, 2 * n)
		local V = if want then complexmod.matrix(n, n) else nil
		if V then
			fill_nan(V.data, 0, 2 * n * n)
		end
		return { values = values, vectors = V }
	end
	-- Scaled into a safe range (see range_scale); the values and A are scaled back at the
	-- end, and the vectors do not change.
	local sc = range_scale(A.data)
	local bal = if balanced ~= false then balance(A) else nil
	local Z, wr, wi = schur_impl(A, want, want, if bal then bal.ilo else nil, if bal then bal.ihi else nil)
	local values = complex_values(wr, wi)
	if sc ~= 1 then
		complexmod.scale(values, 1 / sc, values)
	end
	if not Z then
		if sc ~= 1 then
			scale(A.data, 1 / sc, A.data)
		end
		return { values = values, vectors = nil }
	end
	local T, Zc = to_complex_schur(A, Z, wr, wi)
	complexmod.eigvecs_from_schur(T, Zc)
	if bal then
		unbalance(Zc.data, n, bal)
	end
	if sc ~= 1 then
		scale(A.data, 1 / sc, A.data)
	end
	return { values = values, vectors = Zc }
end

-- Eigendecomposition of a copy of A; A is not modified.
local function eig_copy(A: Matrix, vectors: boolean?, balanced: boolean?): Eig
	return eig(matcopy(nil, A), vectors, balanced)
end

-- Singular value decomposition

--@include bidiagonal_svd.luau.in

-- Reduces A (rows >= cols) to upper bidiagonal form A = Q B P^T in place (LAPACK's
-- gebd2), returning B's diagonal d and superdiagonal e as tables. The left reflectors stay
-- below the diagonal of A (as in qr), with their tau in tauq; right reflector k acts on
-- columns k+1.. and stays in row k from column k+2 on, with its tau in taup.
local function bidiagonalize(A: Matrix): ({ number }, { number }, buffer, buffer)
	local m, n = A.rows, A.cols
	local a = A.data
	local tauq = buffer.create(@W@ * n)
	local taup = buffer.create(@W@ * math.max(n - 1, 0))
	local d, e = table.create(n, 0), table.create(math.max(n - 1, 0), 0)
	local row = buffer.create(@W@ * n)
	local w = table.create(m, 0)
	for k = 0, n - 1 do
		local diag = @W@ * (k * m + k)
		local t = householder(a, diag, m - k, tauq, k)
		d[k + 1] = @READ@(a, diag)
		if t ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, t, a, @W@ * (j * m + k))
			end
		end
		if k < n - 1 then
			-- Row k from column k+1 on is gathered, reflected and put back.
			local len = n - k - 1
			for c = 0, len - 1 do
				@WRITE@(row, @W@ * c, @READ@(a, @W@ * ((k + 1 + c) * m + k)))
			end
			local tp = householder(row, 0, len, taup, k)
			e[k + 1] = @READ@(row, 0)
			for c = 0, len - 1 do
				@WRITE@(a, @W@ * ((k + 1 + c) * m + k), @READ@(row, @W@ * c))
			end
			if tp ~= 0 then
				-- Rows k+1.. of columns k+1..: A := A (I - tp v v^T), v = (1, row[1..]).
				for r = k + 1, m - 1 do
					w[r + 1] = @READ@(a, @W@ * ((k + 1) * m + r))
				end
				for c = 1, len - 1 do
					local vc = @READ@(row, @W@ * c)
					local col = @W@ * ((k + 1 + c) * m)
					for r = k + 1, m - 1 do
						w[r + 1] += @READ@(a, col + @W@ * r) * vc
					end
				end
				for c = 0, len - 1 do
					local tv = tp * (if c == 0 then 1 else @READ@(row, @W@ * c))
					local col = @W@ * ((k + 1 + c) * m)
					for r = k + 1, m - 1 do
						@WRITE@(a, col + @W@ * r, @READ@(a, col + @W@ * r) - w[r + 1] * tv)
					end
				end
			end
		end
	end
	return d, e, tauq, taup
end

-- svd for rows >= cols, in place.
local function svd_tall(A: Matrix, want: boolean): Svd
	local m, n = A.rows, A.cols
	if any_nonfinite(A.data, 0, m * n) then
		local values = buffer.create(@W@ * n)
		fill_nan(values, 0, n)
		fill_nan(A.data, 0, m * n)
		local V = if want then matrix(n, n) else nil
		if V then
			fill_nan(V.data, 0, n * n)
		end
		return { values = values, u = if want then A else nil, v = V }
	end
	-- Scaled into a safe range (see range_scale); the values are scaled back, and U and V
	-- do not change.
	local sc = range_scale(A.data)
	local d, e, tauq, taup = bidiagonalize(A)
	local V: Matrix? = nil
	if want then
		-- V = P from the right reflectors, then U = the first n columns of Q, in A.
		local P = matrix(n, n)
		for k = 0, n - 3 do
			for c = k + 2, n - 1 do
				@WRITE@(P.data, @W@ * (k * n + c), @READ@(A.data, @W@ * (c * m + k)))
			end
		end
		form_reduction_q(P.data, n, math.max(n - 1, 0), taup)
		form_q(A.data, m, 0, m, n, n, tauq)
		V = P
	end
	bidiagonal_svd(d, e, n, if want then A.data else nil, m, if V then V.data else nil, n)
	local values = buffer.create(@W@ * n)
	for i = 1, n do
		@WRITE@(values, @W@ * (i - 1), d[i])
	end
	if sc ~= 1 then
		scale(values, 1 / sc, values)
	end
	return { values = values, u = if want then A else nil, v = V }
end

-- Singular value decomposition A = U diag(values) V^T: values (descending, nonnegative)
-- and, unless vectors is false, U (rows by k) and V (cols by k) with orthonormal columns,
-- k = min(rows, cols). Golub-Kahan bidiagonalization, then implicit QR on the bidiagonal
-- in double precision, keeping the small singular values relatively accurate. In place
-- when rows >= cols: A is overwritten with U (or with workspace if vectors is false). A
-- wide A is not modified (its transpose is decomposed instead). If A holds a NaN or an
-- infinity, every output is NaN. svd_copy never modifies A.
local function svd(A: Matrix, vectors: boolean?): Svd
	if A.rows < A.cols then
		local F = svd_tall(transpose(nil, A), vectors ~= false)
		return { values = F.values, u = F.v, v = F.u }
	end
	return svd_tall(A, vectors ~= false)
end

-- Singular value decomposition of a copy of A; A is not modified.
local function svd_copy(A: Matrix, vectors: boolean?): Svd
	if A.rows < A.cols then
		return svd(A, vectors)
	end
	return svd(matcopy(nil, A), vectors)
end

-- The minimum-norm least-squares solution x = A^+ b for any shape and rank, given
-- F = svd(A) with its vectors: x = sum over i <= r of v_i (u_i^H b) / s_i, where r counts
-- the singular values above tol * s_1 (default tol = max(rows, cols) * eps, as for
-- qrp_rank); smaller ones are treated as zero. Unlike qrp_solve's basic solution, x is the
-- shortest of all least-squares solutions. b is not modified. Also returns the residual
-- norm |A x - b| and r. NaN singular values (from non-finite input) give a NaN x.
local function svd_solve(out: buffer?, F: Svd, b: buffer, tol: number?): (buffer, number, number)
	local U, V = F.u, F.v
	assert(U ~= nil and V ~= nil, "svd_solve needs the singular vectors")
	local m, n, k = U.rows, V.rows, U.cols
	assert(length(b) == m, "b has the wrong length")
	local s, u, v = F.values, U.data, V.data
	local o = output(out, @W@ * n)
	if k > 0 and @READ@(s, 0) ~= @READ@(s, 0) then
		fill_nan(o, 0, n)
		return o, 0 / 0, 0
	end
	local limit = (tol or math.max(m, n) * EPS) * (if k > 0 then @READ@(s, 0) else 0)
	local r = 0
	while r < k and @READ@(s, @W@ * r) > limit do
		r += 1
	end
	-- The residual b - U_r U_r^T b, projected one column at a time, and x.
	local res = table.create(m, 0)
	for i = 1, m do
		res[i] = @READ@(b, @W@ * (i - 1))
	end
	local x = table.create(n, 0)
	for j = 0, r - 1 do
		local col = @W@ * j * m
		local c = 0
		for i = 0, m - 1 do
			c += @READ@(u, col + @W@ * i) * res[i + 1]
		end
		for i = 0, m - 1 do
			res[i + 1] -= c * @READ@(u, col + @W@ * i)
		end
		local w = c / @READ@(s, @W@ * j)
		local vcol = @W@ * j * n
		for i = 0, n - 1 do
			x[i + 1] += w * @READ@(v, vcol + @W@ * i)
		end
	end
	for i = 1, n do
		@WRITE@(o, @W@ * (i - 1), x[i])
	end
	local big = 0
	for i = 1, m do
		big = math.max(big, math.abs(res[i]))
	end
	local ss = 0
	if big > 0 then
		for i = 1, m do
			ss += (res[i] / big) ^ 2
		end
	end
	return o, big * math.sqrt(ss), r
end

-- The pseudoinverse A^+ = V S^+ U^H (cols by rows), by the SVD of a copy of A; singular
-- values at or below tol * s_1 (default max(rows, cols) * eps, as for svd_solve) count as
-- zero. A is not modified. NaN or infinite input gives an all-NaN result. To apply A^+ to
-- vectors, solving with form "svd" is cheaper than forming it.
local function pinv(A: Matrix, tol: number?): Matrix
	local m, n = A.rows, A.cols
	local F = svd_copy(A)
	local U, V = F.u :: Matrix, F.v :: Matrix
	local k, s = U.cols, F.values
	local X = matrix(n, m)
	if k > 0 and @READ@(s, 0) ~= @READ@(s, 0) then
		fill_nan(X.data, 0, n * m)
		return X
	end
	local limit = (tol or math.max(m, n) * EPS) * (if k > 0 then @READ@(s, 0) else 0)
	local u, v, x = U.data, V.data, X.data
	local row = table.create(n, 0)
	-- Column q of X is sum over i of v_i (u_qi / s_i).
	for i = 0, k - 1 do
		local si = @READ@(s, @W@ * i)
		if not (si > limit) then
			break
		end
		for p = 0, n - 1 do
			row[p + 1] = @READ@(v, @W@ * (i * n + p)) / si
		end
		for q = 0, m - 1 do
			local c = @READ@(u, @W@ * (i * m + q))
			if c ~= 0 then
				local col = @W@ * q * n
				for p = 0, n - 1 do
					@WRITE@(x, col + @W@ * p, @READ@(x, col + @W@ * p) + c * row[p + 1])
				end
			end
		end
	end
	return X
end

-- Real FFT and discrete cosine transforms

--@include roots.luau.in

-- Bytes per element of a complex array of the same precision.
local CE = 2 * @W@

-- The n // 2 + 1 coefficients X_0 .. X_(n/2) of the DFT of the real array x (the rest
-- follow from X_(n-k) = conj(X_k)), as a complex array (@CMOD@). Even lengths use one
-- complex FFT of half the length.
local function rfft(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, CE * (n // 2 + 1))
	if n % 2 == 1 or n < 2 then
		local z = complexmod.complexify(x)
		complexmod.fft(z)
		buffer.copy(o, 0, z, 0, CE * (n // 2 + 1))
		return o
	end
	-- The pairs (x_2j, x_2j+1) already are the complex numbers z_j = x_2j + i x_2j+1.
	local h = n // 2
	local z = buffer.create(CE * h)
	buffer.copy(z, 0, x, 0, @W@ * n)
	complexmod.fft(z)
	for k = 0, h do
		local a, b = CE * (k % h), CE * ((h - k) % h)
		local zr, zi = @READ@(z, a), @READ@(z, a + @W@)
		local cr, ci = @READ@(z, b), -@READ@(z, b + @W@)
		-- X_k = (Z_k + conj Z_(h-k)) / 2 + w^k (Z_k - conj Z_(h-k)) / (2 i)
		local er, ei = (zr + cr) / 2, (zi + ci) / 2
		local dr, di = (zi - ci) / 2, -(zr - cr) / 2
		local wr, wi = root(k, n)
		@WRITE@(o, CE * k, er + wr * dr - wi * di)
		@WRITE@(o, CE * k + @W@, ei + wr * di + wi * dr)
	end
	return o
end

-- The real array of length n whose rfft is X (n // 2 + 1 complex coefficients, @CMOD@).
-- The imaginary parts of X_0 and, for even n, X_(n/2) are ignored.
local function irfft(out: buffer?, X: buffer, n: number): buffer
	assert(buffer.len(X) == CE * (n // 2 + 1), "need n // 2 + 1 coefficients")
	local o = output(out, @W@ * n)
	if n % 2 == 1 or n < 2 then
		local full = buffer.create(CE * n)
		for k = 0, n - 1 do
			local s = if k <= n // 2 then k else n - k
			local xr, xi = @READ@(X, CE * s), @READ@(X, CE * s + @W@)
			if k > n // 2 then
				xi = -xi
			end
			if k == 0 then
				xi = 0
			end
			@WRITE@(full, CE * k, xr)
			@WRITE@(full, CE * k + @W@, xi)
		end
		complexmod.ifft(full)
		for k = 0, n - 1 do
			@WRITE@(o, @W@ * k, @READ@(full, CE * k))
		end
		return o
	end
	local h = n // 2
	local z = buffer.create(CE * h)
	for k = 0, h - 1 do
		local xr, xi = @READ@(X, CE * k), @READ@(X, CE * k + @W@)
		local cr, ci = @READ@(X, CE * (h - k)), -@READ@(X, CE * (h - k) + @W@)
		if k == 0 then
			xi, ci = 0, 0
		end
		-- Z_k = (X_k + conj X_(h-k)) / 2 + i w^-k (X_k - conj X_(h-k)) / 2
		local er, ei = (xr + cr) / 2, (xi + ci) / 2
		local dr, di = (xr - cr) / 2, (xi - ci) / 2
		local wr, wi = root(-k, n)
		local orr, oi = dr * wr - di * wi, dr * wi + di * wr
		@WRITE@(z, CE * k, er - oi)
		@WRITE@(z, CE * k + @W@, ei + orr)
	end
	complexmod.ifft(z)
	buffer.copy(o, 0, z, 0, @W@ * n)
	return o
end

-- The DCT of the given type (SciPy's definitions) of the values xs[1..N], as a table.
local function dct_values(xs: { number }, kind: number, ortho: boolean): { number }
	local N = #xs
	local y = table.create(N, 0)
	if kind == 1 then
		-- The real FFT of the even extension x_0 .. x_N-1, x_N-2 .. x_1.
		assert(N >= 2, "the type 1 DCT needs at least 2 points")
		local ext = buffer.create(@W@ * 2 * (N - 1))
		for k = 0, 2 * N - 3 do
			local v = if k < N then xs[k + 1] else xs[2 * N - 1 - k]
			if ortho and (k == 0 or k == N - 1) then
				v *= math.sqrt(2)
			end
			@WRITE@(ext, @W@ * k, v)
		end
		local Y = rfft(nil, ext)
		for k = 0, N - 1 do
			y[k + 1] = @READ@(Y, CE * k)
		end
		if ortho then
			local f = math.sqrt(1 / (2 * (N - 1)))
			for k = 1, N do
				y[k] *= f
			end
			y[1] /= math.sqrt(2)
			y[N] /= math.sqrt(2)
		end
	elseif kind == 2 then
		-- Makhoul: reorder to (x_0, x_2, ..., x_3, x_1), one real FFT of length N, rotate.
		local v = buffer.create(@W@ * N)
		for i = 0, (N + 1) // 2 - 1 do
			@WRITE@(v, @W@ * i, xs[2 * i + 1])
		end
		for i = 0, N // 2 - 1 do
			@WRITE@(v, @W@ * (N - 1 - i), xs[2 * i + 2])
		end
		local V = rfft(nil, v)
		for k = 0, N - 1 do
			local s = if k <= N // 2 then k else N - k
			local vr, vi = @READ@(V, CE * s), @READ@(V, CE * s + @W@)
			if k > N // 2 then
				vi = -vi
			end
			local wr, wi = root(k, 4 * N)
			y[k + 1] = 2 * (wr * vr - wi * vi)
		end
		if ortho then
			y[1] *= math.sqrt(1 / (4 * N))
			for k = 2, N do
				y[k] *= math.sqrt(1 / (2 * N))
			end
		end
	elseif kind == 3 then
		-- The inverse of Makhoul's reduction: V_k = (x_k - i x_N-k) exp(i pi k / 2N),
		-- v = N ifft(V), then undo the reordering.
		local a = table.clone(xs)
		if ortho then
			a[1] /= math.sqrt(N)
			for k = 2, N do
				a[k] /= math.sqrt(2 * N)
			end
		end
		local V = buffer.create(CE * N)
		for k = 0, N - 1 do
			local xr, xi = a[k + 1], if k > 0 then -a[N - k + 1] else 0
			local wr, wi = root(-k, 4 * N)
			@WRITE@(V, CE * k, xr * wr - xi * wi)
			@WRITE@(V, CE * k + @W@, xr * wi + xi * wr)
		end
		complexmod.ifft(V)
		for i = 0, (N + 1) // 2 - 1 do
			y[2 * i + 1] = N * @READ@(V, CE * i)
		end
		for i = 0, N // 2 - 1 do
			y[2 * i + 2] = N * @READ@(V, CE * (N - 1 - i))
		end
	elseif kind == 4 then
		-- A complex FFT of length 2N of x_n exp(-i pi n / 2N), zero padded, then a rotation.
		local A = buffer.create(CE * 2 * N)
		for k = 0, N - 1 do
			local wr, wi = root(k, 4 * N)
			@WRITE@(A, CE * k, xs[k + 1] * wr)
			@WRITE@(A, CE * k + @W@, xs[k + 1] * wi)
		end
		complexmod.fft(A)
		for k = 0, N - 1 do
			local ar, ai = @READ@(A, CE * k), @READ@(A, CE * k + @W@)
			local wr, wi = root(2 * k + 1, 8 * N)
			y[k + 1] = 2 * (wr * ar - wi * ai)
		end
		if ortho then
			for k = 1, N do
				y[k] *= math.sqrt(1 / (2 * N))
			end
		end
	else
		error("dct type must be 1, 2, 3 or 4")
	end
	return y
end

-- The discrete cosine transform of the given type (1 to 4, default 2), with SciPy's
-- definitions: unnormalized, or orthonormal with norm = "ortho". In place; returns x.
local function dct(x: buffer, kind: number?, norm: DctNorm?): buffer
	local t = totable(x)
	if #t == 0 then
		return x
	end
	local y = dct_values(t, kind or 2, norm == "ortho")
	for k = 1, #y do
		@WRITE@(x, @W@ * (k - 1), y[k])
	end
	return x
end

-- The inverse of dct with the same type and norm. In place; returns x.
local function idct(x: buffer, kind: number?, norm: DctNorm?): buffer
	local t = totable(x)
	local N = #t
	if N == 0 then
		return x
	end
	local k = kind or 2
	local ortho = norm == "ortho"
	-- The inverse of type 2 is type 3 and vice versa; types 1 and 4 invert themselves.
	local inverse = if k == 2 then 3 elseif k == 3 then 2 else k
	local y = dct_values(t, inverse, ortho)
	local scale = if ortho then 1 elseif k == 1 then 1 / (2 * (N - 1)) else 1 / (2 * N)
	for i = 1, N do
		@WRITE@(x, @W@ * (i - 1), y[i] * scale)
	end
	return x
end

-- dct of a copy of x; x is not modified.
local function dct_copy(x: buffer, kind: number?, norm: DctNorm?): buffer
	return dct(copy(nil, x), kind, norm)
end

-- idct of a copy of x; x is not modified.
local function idct_copy(x: buffer, kind: number?, norm: DctNorm?): buffer
	return idct(copy(nil, x), kind, norm)
end

-- Functions defined inside do blocks, exported through this table: a Luau function (here,
-- the module) may hold at most 200 locals.
local ext = {}

-- Structured and sparse matrices: in a do block (exported through ext) so their locals
-- do not count toward the module's limit of 200.
do
	-- Triangular matrices

	-- Solves T x = b, where T is the upper or lower triangle of A (the other triangle is not
	-- read); with unit, the diagonal is taken to be 1 and not read either. In place if out is b.
	local function triangular_solve(out: buffer?, A: Matrix, b: buffer, uplo: Uplo, unit: boolean?): buffer
		local n = A.rows
		assert(A.cols == n, "matrix must be square")
		assert(uplo == "upper" or uplo == "lower", "uplo must be \"upper\" or \"lower\"")
		assert(buffer.len(b) == @W@ * n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = A.data
		if uplo == "upper" then
			for j = n - 1, 0, -1 do
				local xj = @READ@(o, @W@ * j)
				if not unit then
					xj /= @READ@(a, @W@ * (j * n + j))
					@WRITE@(o, @W@ * j, xj)
				end
				for i = 0, j - 1 do
					@WRITE@(o, @W@ * i, @READ@(o, @W@ * i) - @READ@(a, @W@ * (j * n + i)) * xj)
				end
			end
		else
			for j = 0, n - 1 do
				local xj = @READ@(o, @W@ * j)
				if not unit then
					xj /= @READ@(a, @W@ * (j * n + j))
					@WRITE@(o, @W@ * j, xj)
				end
				for i = j + 1, n - 1 do
					@WRITE@(o, @W@ * i, @READ@(o, @W@ * i) - @READ@(a, @W@ * (j * n + i)) * xj)
				end
			end
		end
		return o
	end

	-- T x for the upper or lower triangle T of A (as in triangular_solve).
	local function triangular_matvec(out: buffer?, A: Matrix, x: buffer, uplo: Uplo, unit: boolean?): buffer
		local n = A.rows
		assert(A.cols == n, "matrix must be square")
		assert(uplo == "upper" or uplo == "lower", "uplo must be \"upper\" or \"lower\"")
		assert(buffer.len(x) == @W@ * n, "matrix and vector sizes do not match")
		local o = output(out, @W@ * n)
		assert(o ~= x, "output cannot be the input vector")
		local a = A.data
		for i = 0, n - 1 do
			local s = if unit then @READ@(x, @W@ * i) else 0
			local first, last = if uplo == "upper" then i else 0, if uplo == "upper" then n - 1 else i
			if unit then
				if uplo == "upper" then
					first += 1
				else
					last -= 1
				end
			end
			for j = first, last do
				s += @READ@(a, @W@ * (j * n + i)) * @READ@(x, @W@ * j)
			end
			@WRITE@(o, @W@ * i, s)
		end
		return o
	end

	-- Tridiagonal matrices

	-- A tridiagonal matrix from its subdiagonal (n-1), diagonal (n) and superdiagonal (n-1).
	-- The arrays are used as they are (not copied).
	local function tridiagonal(lower: buffer, diag: buffer, upper: buffer): Tridiagonal
		local n = length(diag)
		assert(length(lower) == math.max(n - 1, 0) and length(upper) == math.max(n - 1, 0), "need n-1 off-diagonal entries")
		return { lower = lower, diag = diag, upper = upper }
	end

	local function tridiag_copy(T: Tridiagonal): Tridiagonal
		return { lower = copy(nil, T.lower), diag = copy(nil, T.diag), upper = copy(nil, T.upper) }
	end

	-- The dense matrix.
	local function tridiag_matrix(T: Tridiagonal): Matrix
		local n = length(T.diag)
		local A = matrix(n, n)
		for i = 0, n - 1 do
			@WRITE@(A.data, @W@ * (i * n + i), @READ@(T.diag, @W@ * i))
			if i < n - 1 then
				@WRITE@(A.data, @W@ * (i * n + i + 1), @READ@(T.lower, @W@ * i))
				@WRITE@(A.data, @W@ * ((i + 1) * n + i), @READ@(T.upper, @W@ * i))
			end
		end
		return A
	end

	-- T x
	local function tridiag_matvec(out: buffer?, T: Tridiagonal, x: buffer): buffer
		local n = length(T.diag)
		assert(length(x) == n, "matrix and vector sizes do not match")
		local o = output(out, @W@ * n)
		assert(o ~= x, "output cannot be the input vector")
		local dl, d, du = T.lower, T.diag, T.upper
		for i = 0, n - 1 do
			local s = @READ@(d, @W@ * i) * @READ@(x, @W@ * i)
			if i > 0 then
				s += @READ@(dl, @W@ * (i - 1)) * @READ@(x, @W@ * (i - 1))
			end
			if i < n - 1 then
				s += @READ@(du, @W@ * i) * @READ@(x, @W@ * (i + 1))
			end
			@WRITE@(o, @W@ * i, s)
		end
		return o
	end

	-- LU factorization with partial pivoting (LAPACK's gttrf), in place: T's arrays are
	-- overwritten with the factors. tridiag_lu_copy leaves T unchanged.
	local function tridiag_lu(T: Tridiagonal): TridiagonalLU
		local n = length(T.diag)
		local dl, d, du = T.lower, T.diag, T.upper
		local du2 = buffer.create(@W@ * math.max(n - 2, 0))
		local piv = table.create(n, 0)
		local function get(arr: buffer, i: number): number
			return @READ@(arr, @W@ * i)
		end
		local function set(arr: buffer, i: number, v: number)
			@WRITE@(arr, @W@ * i, v)
		end
		for i = 0, n - 2 do
			local di, li = get(d, i), get(dl, i)
			if math.abs(di) >= math.abs(li) then
				-- No row interchange.
				piv[i + 1] = i + 1
				if di ~= 0 then
					local fact = li / di
					set(dl, i, fact)
					set(d, i + 1, get(d, i + 1) - fact * get(du, i))
				end
			else
				-- Interchange rows i and i+1.
				local fact = di / li
				set(d, i, li)
				set(dl, i, fact)
				local temp = get(du, i)
				set(du, i, get(d, i + 1))
				set(d, i + 1, temp - fact * get(d, i + 1))
				if i < n - 2 then
					set(du2, i, get(du, i + 1))
					set(du, i + 1, -fact * get(du, i + 1))
				end
				piv[i + 1] = i + 2
			end
		end
		if n > 0 then
			piv[n] = n
		end
		local singular = false
		for i = 0, n - 1 do
			if get(d, i) == 0 then
				singular = true
			end
		end
		return { lu = T, du2 = du2, piv = piv, singular = singular }
	end

	-- tridiag_lu of a copy of T; T is not modified.
	local function tridiag_lu_copy(T: Tridiagonal): TridiagonalLU
		return tridiag_lu(tridiag_copy(T))
	end

	-- Solves T x = b given F = tridiag_lu(T). In place if out is b.
	local function tridiag_lu_solve(out: buffer?, F: TridiagonalLU, b: buffer): buffer
		assert(not F.singular, "matrix is singular")
		local dl, d, du, du2 = F.lu.lower, F.lu.diag, F.lu.upper, F.du2
		local n = length(d)
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local function get(arr: buffer, i: number): number
			return @READ@(arr, @W@ * i)
		end
		-- L y = P b
		for i = 0, n - 2 do
			local bi, bn = get(o, i), get(o, i + 1)
			if F.piv[i + 1] == i + 1 then
				@WRITE@(o, @W@ * (i + 1), bn - get(dl, i) * bi)
			else
				@WRITE@(o, @W@ * i, bn)
				@WRITE@(o, @W@ * (i + 1), bi - get(dl, i) * bn)
			end
		end
		-- U x = y
		for i = n - 1, 0, -1 do
			local s = get(o, i)
			if i < n - 1 then
				s -= get(du, i) * get(o, i + 1)
			end
			if i < n - 2 then
				s -= get(du2, i) * get(o, i + 2)
			end
			@WRITE@(o, @W@ * i, s / get(d, i))
		end
		return o
	end

	-- LDL^T factorization of a symmetric positive definite tridiagonal matrix (LAPACK's
	-- pttrf), in place: only T.diag and T.lower are read; they are overwritten with D and the
	-- subdiagonal of L. definite is false if T is not positive definite (T is then partly
	-- overwritten). tridiag_ldl_copy leaves T unchanged.
	local function tridiag_ldl(T: Tridiagonal): TridiagonalLDL
		local d, e = T.diag, T.lower
		local n = length(d)
		for i = 0, n - 1 do
			local di = @READ@(d, @W@ * i)
			if not (di > 0) then
				return { ldl = T, definite = false }
			end
			if i < n - 1 then
				local ei = @READ@(e, @W@ * i)
				local l = ei / di
				@WRITE@(e, @W@ * i, l)
				@WRITE@(d, @W@ * (i + 1), @READ@(d, @W@ * (i + 1)) - l * ei)
			end
		end
		return { ldl = T, definite = true }
	end

	-- tridiag_ldl of a copy of T; T is not modified.
	local function tridiag_ldl_copy(T: Tridiagonal): TridiagonalLDL
		return tridiag_ldl(tridiag_copy(T))
	end

	-- Solves T x = b given F = tridiag_ldl(T). In place if out is b.
	local function tridiag_ldl_solve(out: buffer?, F: TridiagonalLDL, b: buffer): buffer
		assert(F.definite, "matrix is not positive definite")
		local d, e = F.ldl.diag, F.ldl.lower
		local n = length(d)
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		for i = 1, n - 1 do
			@WRITE@(o, @W@ * i, @READ@(o, @W@ * i) - @READ@(o, @W@ * (i - 1)) * @READ@(e, @W@ * (i - 1)))
		end
		for i = 0, n - 1 do
			@WRITE@(o, @W@ * i, @READ@(o, @W@ * i) / @READ@(d, @W@ * i))
		end
		for i = n - 2, 0, -1 do
			@WRITE@(o, @W@ * i, @READ@(o, @W@ * i) - @READ@(o, @W@ * (i + 1)) * @READ@(e, @W@ * i))
		end
		return o
	end

	-- Banded matrices

	-- A zero n by n banded matrix with kl subdiagonals and ku superdiagonals.
	local function banded(n: number, kl: number, ku: number): Banded
		assert(kl >= 0 and ku >= 0, "bandwidths must be nonnegative")
		local ld = 2 * kl + ku + 1
		return { n = n, kl = kl, ku = ku, ld = ld, data = buffer.create(@W@ * ld * n) }
	end

	local function band_copy(B: Banded): Banded
		local C = banded(B.n, B.kl, B.ku)
		buffer.copy(C.data, 0, B.data)
		return C
	end

	-- Byte offset of entry (i, j), 0-based.
	local function band_at(B: Banded, i: number, j: number): number
		return @W@ * (j * B.ld + B.kl + B.ku + i - j)
	end

	local function in_band(B: Banded, i: number, j: number): boolean
		return i - j <= B.kl and j - i <= B.ku and i >= 1 and j >= 1 and i <= B.n and j <= B.n
	end

	-- Entry (i, j), 1-based; 0 outside the band.
	local function band_get(B: Banded, i: number, j: number): number
		if not in_band(B, i, j) then
			return 0
		end
		return @READ@(B.data, band_at(B, i - 1, j - 1))
	end

	-- Sets entry (i, j), 1-based, which must lie in the band.
	local function band_set(B: Banded, i: number, j: number, v: number)
		assert(in_band(B, i, j), "entry is outside the band")
		@WRITE@(B.data, band_at(B, i - 1, j - 1), v)
	end

	-- The band of the square matrix A (entries outside it are dropped).
	local function band_from_matrix(A: Matrix, kl: number, ku: number): Banded
		local n = A.rows
		assert(A.cols == n, "matrix must be square")
		local B = banded(n, kl, ku)
		for j = 0, n - 1 do
			for i = math.max(0, j - ku), math.min(n - 1, j + kl) do
				@WRITE@(B.data, band_at(B, i, j), @READ@(A.data, @W@ * (j * n + i)))
			end
		end
		return B
	end

	-- The dense matrix.
	local function band_matrix(B: Banded): Matrix
		local n = B.n
		local A = matrix(n, n)
		for j = 0, n - 1 do
			for i = math.max(0, j - B.ku), math.min(n - 1, j + B.kl) do
				@WRITE@(A.data, @W@ * (j * n + i), @READ@(B.data, band_at(B, i, j)))
			end
		end
		return A
	end

	-- B x
	local function band_matvec(out: buffer?, B: Banded, x: buffer): buffer
		local n = B.n
		assert(length(x) == n, "matrix and vector sizes do not match")
		local o = output(out, @W@ * n)
		assert(o ~= x, "output cannot be the input vector")
		buffer.fill(o, 0, 0)
		for j = 0, n - 1 do
			local xj = @READ@(x, @W@ * j)
			for i = math.max(0, j - B.ku), math.min(n - 1, j + B.kl) do
				@WRITE@(o, @W@ * i, @READ@(o, @W@ * i) + @READ@(B.data, band_at(B, i, j)) * xj)
			end
		end
		return o
	end

	-- Banded LU with partial pivoting (LAPACK's gbtf2), in place: B is overwritten with the
	-- factors, U getting up to kl + ku superdiagonals in B's extra rows. band_lu_copy leaves
	-- B unchanged.
	local function band_lu(B: Banded): BandedLU
		local n, kl, ku = B.n, B.kl, B.ku
		local kv = kl + ku
		local a = B.data
		local function at(i: number, j: number): number
			return @W@ * (j * B.ld + kv + i - j)
		end
		-- Clear the fill-in rows above the original band.
		for j = 0, n - 1 do
			for i = math.max(0, j - kv), j - ku - 1 do
				@WRITE@(a, at(i, j), 0)
			end
		end
		local piv = table.create(n, 0)
		local singular = false
		local ju = 0
		for j = 0, n - 1 do
			local km = math.min(kl, n - 1 - j)
			local p, best = j, -1
			for i = j, j + km do
				local v = math.abs(@READ@(a, at(i, j)))
				if v > best then
					p, best = i, v
				end
			end
			piv[j + 1] = p + 1
			local pivot = @READ@(a, at(p, j))
			if pivot ~= 0 then
				ju = math.max(ju, math.min(j + ku + (p - j), n - 1))
				if p ~= j then
					for c = j, ju do
						local s, t = at(j, c), at(p, c)
						local tmp = @READ@(a, s)
						@WRITE@(a, s, @READ@(a, t))
						@WRITE@(a, t, tmp)
					end
				end
				if km > 0 then
					local djj = @READ@(a, at(j, j))
					for i = j + 1, j + km do
						@WRITE@(a, at(i, j), @READ@(a, at(i, j)) / djj)
					end
					for c = j + 1, ju do
						local y = @READ@(a, at(j, c))
						if y ~= 0 then
							for i = j + 1, j + km do
								@WRITE@(a, at(i, c), @READ@(a, at(i, c)) - @READ@(a, at(i, j)) * y)
							end
						end
					end
				end
			else
				singular = true
			end
		end
		return { lu = B, piv = piv, singular = singular }
	end

	-- band_lu of a copy of B; B is not modified.
	local function band_lu_copy(B: Banded): BandedLU
		return band_lu(band_copy(B))
	end

	-- Solves B x = b given F = band_lu(B). In place if out is b.
	local function band_lu_solve(out: buffer?, F: BandedLU, b: buffer): buffer
		assert(not F.singular, "matrix is singular")
		local B = F.lu
		local n, kl, ku = B.n, B.kl, B.ku
		local kv = kl + ku
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = B.data
		local function at(i: number, j: number): number
			return @W@ * (j * B.ld + kv + i - j)
		end
		-- L y = P b, applying the interchanges as they happened.
		for j = 0, n - 2 do
			local p = F.piv[j + 1] - 1
			if p ~= j then
				local tmp = @READ@(o, @W@ * j)
				@WRITE@(o, @W@ * j, @READ@(o, @W@ * p))
				@WRITE@(o, @W@ * p, tmp)
			end
			local yj = @READ@(o, @W@ * j)
			for i = j + 1, math.min(n - 1, j + kl) do
				@WRITE@(o, @W@ * i, @READ@(o, @W@ * i) - @READ@(a, at(i, j)) * yj)
			end
		end
		-- U x = y, U with kl + ku superdiagonals.
		for j = n - 1, 0, -1 do
			local xj = @READ@(o, @W@ * j) / @READ@(a, at(j, j))
			@WRITE@(o, @W@ * j, xj)
			for i = math.max(0, j - kv), j - 1 do
				@WRITE@(o, @W@ * i, @READ@(o, @W@ * i) - @READ@(a, at(i, j)) * xj)
			end
		end
		return o
	end

	-- Banded Cholesky A = L L^T of a symmetric positive definite matrix (LAPACK's pbtf2,
	-- lower), in place: only the diagonal and the kl subdiagonals are read and overwritten
	-- with L. definite is false if B is not positive definite (B is then partly overwritten).
	-- band_chol_copy leaves B unchanged.
	local function band_chol(B: Banded): BandedCholesky
		local n, kd = B.n, B.kl
		local a = B.data
		for j = 0, n - 1 do
			local ajj = @READ@(a, band_at(B, j, j))
			if not (ajj > 0) then
				return { chol = B, definite = false }
			end
			ajj = math.sqrt(ajj)
			@WRITE@(a, band_at(B, j, j), ajj)
			local kn = math.min(kd, n - 1 - j)
			for i = j + 1, j + kn do
				@WRITE@(a, band_at(B, i, j), @READ@(a, band_at(B, i, j)) / ajj)
			end
			-- Trailing lower band -= x x^T, x = column j below the diagonal.
			for c = j + 1, j + kn do
				local xc = @READ@(a, band_at(B, c, j))
				for i = c, j + kn do
					local off = band_at(B, i, c)
					@WRITE@(a, off, @READ@(a, off) - @READ@(a, band_at(B, i, j)) * xc)
				end
			end
		end
		return { chol = B, definite = true }
	end

	-- band_chol of a copy of B; B is not modified.
	local function band_chol_copy(B: Banded): BandedCholesky
		return band_chol(band_copy(B))
	end

	-- Solves B x = b given F = band_chol(B). In place if out is b.
	local function band_chol_solve(out: buffer?, F: BandedCholesky, b: buffer): buffer
		assert(F.definite, "matrix is not positive definite")
		local B = F.chol
		local n, kd = B.n, B.kl
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = B.data
		-- L y = b
		for j = 0, n - 1 do
			local yj = @READ@(o, @W@ * j) / @READ@(a, band_at(B, j, j))
			@WRITE@(o, @W@ * j, yj)
			for i = j + 1, math.min(n - 1, j + kd) do
				@WRITE@(o, @W@ * i, @READ@(o, @W@ * i) - @READ@(a, band_at(B, i, j)) * yj)
			end
		end
		-- L^T x = y
		for j = n - 1, 0, -1 do
			local s = @READ@(o, @W@ * j)
			for i = j + 1, math.min(n - 1, j + kd) do
				s -= @READ@(a, band_at(B, i, j)) * @READ@(o, @W@ * i)
			end
			@WRITE@(o, @W@ * j, s / @READ@(a, band_at(B, j, j)))
		end
		return o
	end

	-- Circulant and Toeplitz matrices

	-- The circulant matrix with first column c (its eigenvalues are computed now).
	local function circulant(c: buffer): Circulant
		return { n = length(c), eig = rfft(nil, c) }
	end

	-- C x, by FFT.
	local function circulant_matvec(out: buffer?, C: Circulant, x: buffer): buffer
		assert(length(x) == C.n, "matrix and vector sizes do not match")
		local X = rfft(nil, x)
		complexmod.mul(X, X, C.eig)
		return irfft(out, X, C.n)
	end

	-- Solves C x = b, by FFT. In place if out is b.
	local function circulant_solve(out: buffer?, C: Circulant, b: buffer): buffer
		assert(length(b) == C.n, "matrix and vector sizes do not match")
		local X = rfft(nil, b)
		local eig = C.eig
		for k = 0, buffer.len(X) - CE, CE do
			local er, ei = @READ@(eig, k), @READ@(eig, k + @W@)
			assert(er ~= 0 or ei ~= 0, "circulant matrix is singular")
			local qr, qi = complex64.div(@READ@(X, k), @READ@(X, k + @W@), er, ei)
			@WRITE@(X, k, qr)
			@WRITE@(X, k + @W@, qi)
		end
		return irfft(out, X, C.n)
	end

	-- The dense matrix.
	local function circulant_matrix(c: buffer): Matrix
		local n = length(c)
		local A = matrix(n, n)
		for j = 0, n - 1 do
			for i = 0, n - 1 do
				@WRITE@(A.data, @W@ * (j * n + i), @READ@(c, @W@ * ((i - j) % n)))
			end
		end
		return A
	end

	-- The Toeplitz matrix with first column col and first row row (default: col, which makes
	-- it symmetric). row[1] is ignored, as in SciPy. Both arrays are copied.
	local function toeplitz(col: buffer, row: buffer?): Toeplitz
		local n = length(col)
		local r = row or col
		assert(length(r) == n, "first row and first column have different lengths")
		local M = 1
		while M < 2 * n - 1 do
			M *= 2
		end
		-- A circulant of size M whose leading n by n block is T.
		local e = create(M)
		for k = 0, n - 1 do
			@WRITE@(e, @W@ * k, @READ@(col, @W@ * k))
			if k > 0 then
				@WRITE@(e, @W@ * (M - k), @READ@(r, @W@ * k))
			end
		end
		return { n = n, col = copy(nil, col), row = copy(nil, r), embed = circulant(e) }
	end

	-- The dense matrix.
	local function toeplitz_matrix(T: Toeplitz): Matrix
		local n = T.n
		local A = matrix(n, n)
		for j = 0, n - 1 do
			for i = 0, n - 1 do
				local v = if i >= j then @READ@(T.col, @W@ * (i - j)) else @READ@(T.row, @W@ * (j - i))
				@WRITE@(A.data, @W@ * (j * n + i), v)
			end
		end
		return A
	end

	-- T x, by FFT through the circulant embedding.
	local function toeplitz_matvec(out: buffer?, T: Toeplitz, x: buffer): buffer
		local n = T.n
		assert(length(x) == n, "matrix and vector sizes do not match")
		local o = output(out, @W@ * n)
		if n == 0 then
			return o
		end
		local padded = create(T.embed.n)
		buffer.copy(padded, 0, x, 0, @W@ * n)
		local y = circulant_matvec(nil, T.embed, padded)
		buffer.copy(o, 0, y, 0, @W@ * n)
		return o
	end

	-- Solves T x = b by Levinson's recursion, O(n^2) in double precision. It needs every
	-- leading principal submatrix of T to be nonsingular (it raises an error otherwise) and is
	-- reliable for well-conditioned, especially symmetric positive definite, matrices; for
	-- other Toeplitz systems use solve on toeplitz_matrix(T). In place if out is b.
	local function toeplitz_solve(out: buffer?, T: Toeplitz, b: buffer): buffer
		local n = T.n
		assert(length(b) == n, "matrix and vector sizes do not match")
		local bt = totable(b)
		local o = output(out, @W@ * n)
		if n == 0 then
			return o
		end
		local col, row = totable(T.col), totable(T.row)
		local function t(k: number): number
			return if k >= 0 then col[k + 1] else row[1 - k]
		end
		local t0 = col[1]
		assert(t0 ~= 0, "toeplitz_solve: a leading principal submatrix is singular")
		-- f and g solve T_m f = e_1 and T_m g = e_m; x solves T_m x = b[1..m].
		local f, g, x = { 1 / t0 }, { 1 / t0 }, { bt[1] / t0 }
		for m = 1, n - 1 do
			local ef, eg, ex = 0, 0, 0
			for j = 1, m do
				local tj = t(m + 1 - j)
				ef += tj * f[j]
				ex += tj * x[j]
				eg += t(-j) * g[j]
			end
			local den = 1 - ef * eg
			assert(den ~= 0, "toeplitz_solve: a leading principal submatrix is singular")
			local fn, gn = table.create(m + 1, 0), table.create(m + 1, 0)
			for j = 1, m + 1 do
				local fj = if j <= m then f[j] else 0
				local gj = if j >= 2 then g[j - 1] else 0
				fn[j] = (fj - ef * gj) / den
				gn[j] = (gj - eg * fj) / den
			end
			f, g = fn, gn
			x[m + 1] = 0
			local c = bt[m + 1] - ex
			for j = 1, m + 1 do
				x[j] += c * g[j]
			end
		end
		for j = 1, n do
			@WRITE@(o, @W@ * (j - 1), x[j])
		end
		return o
	end

	-- Sparse matrices

	local function u32(b: buffer, i: number): number
		return buffer.readu32(b, 4 * i)
	end

	-- Assembles a compressed sparse column matrix from per-column lists of (row, value), rows
	-- already sorted and distinct.
	local function assemble(rows: number, cols: number, colrows: { { number } }, colvals: { { number } }): Sparse
		local nnz = 0
		for j = 1, cols do
			nnz += #colrows[j]
		end
		local colptr = buffer.create(4 * (cols + 1))
		local rowind = buffer.create(4 * nnz)
		local values = buffer.create(@W@ * nnz)
		local p = 0
		for j = 1, cols do
			buffer.writeu32(colptr, 4 * (j - 1), p)
			local rs, vs = colrows[j], colvals[j]
			for k = 1, #rs do
				buffer.writeu32(rowind, 4 * p, rs[k])
				@WRITE@(values, @W@ * p, vs[k])
				p += 1
			end
		end
		buffer.writeu32(colptr, 4 * cols, p)
		return { rows = rows, cols = cols, colptr = colptr, rowind = rowind, values = values }
	end

	local function empty_columns(cols: number): ({ { number } }, { { number } })
		local r, v = table.create(cols) :: { { number } }, table.create(cols) :: { { number } }
		for j = 1, cols do
			r[j], v[j] = {}, {}
		end
		return r, v
	end

	-- A rows by cols sparse matrix from triplets: entry (ii[k], jj[k]) (1-based) gets
	-- values[k]; repeated positions are summed, as in SciPy. Explicit zeros are kept.
	local function sparse(rows: number, cols: number, ii: { number }, jj: { number }, values: buffer): Sparse
		local count = #ii
		assert(#jj == count and length(values) == count, "need as many values as positions")
		local order = table.create(count, 0)
		for k = 1, count do
			local i, j = ii[k], jj[k]
			assert(i % 1 == 0 and j % 1 == 0 and i >= 1 and i <= rows and j >= 1 and j <= cols, "position outside the matrix")
			order[k] = k
		end
		table.sort(order, function(a: number, b: number): boolean
			if jj[a] ~= jj[b] then
				return jj[a] < jj[b]
			end
			return ii[a] < ii[b]
		end)
		local colrows, colvals = empty_columns(cols)
		for _, k in order do
			local rs, vs = colrows[jj[k]], colvals[jj[k]]
			local v = @READ@(values, @W@ * (k - 1))
			if #rs > 0 and rs[#rs] == ii[k] - 1 then
				vs[#vs] += v
			else
				table.insert(rs, ii[k] - 1)
				table.insert(vs, v)
			end
		end
		return assemble(rows, cols, colrows, colvals)
	end

	-- Number of stored entries.
	local function sparse_nnz(S: Sparse): number
		return buffer.len(S.rowind) // 4
	end

	-- The nonzero entries of the dense matrix A.
	local function sparse_from_matrix(A: Matrix): Sparse
		local m, n = A.rows, A.cols
		local colrows, colvals = empty_columns(n)
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				local v = @READ@(A.data, @W@ * (j * m + i))
				if v ~= 0 then
					table.insert(colrows[j + 1], i)
					table.insert(colvals[j + 1], v)
				end
			end
		end
		return assemble(m, n, colrows, colvals)
	end

	-- The dense matrix.
	local function sparse_matrix(S: Sparse): Matrix
		local A = matrix(S.rows, S.cols)
		for j = 0, S.cols - 1 do
			for p = u32(S.colptr, j), u32(S.colptr, j + 1) - 1 do
				@WRITE@(A.data, @W@ * (j * S.rows + u32(S.rowind, p)), @READ@(S.values, @W@ * p))
			end
		end
		return A
	end

	-- Position of entry (i, j) (0-based) in the stored arrays, or nil.
	local function find(S: Sparse, i: number, j: number): number?
		local lo, hi = u32(S.colptr, j), u32(S.colptr, j + 1) - 1
		while lo <= hi do
			local mid = (lo + hi) // 2
			local r = u32(S.rowind, mid)
			if r == i then
				return mid
			elseif r < i then
				lo = mid + 1
			else
				hi = mid - 1
			end
		end
		return nil
	end

	-- Entry (i, j), 1-based (0 if not stored).
	local function sparse_get(S: Sparse, i: number, j: number): number
		local p = find(S, i - 1, j - 1)
		return if p then @READ@(S.values, @W@ * p) else 0
	end

	-- The diagonal, as an array of min(rows, cols) entries.
	local function sparse_diag(S: Sparse): buffer
		local k = math.min(S.rows, S.cols)
		local d = create(k)
		for i = 0, k - 1 do
			local p = find(S, i, i)
			if p then
				@WRITE@(d, @W@ * i, @READ@(S.values, @W@ * p))
			end
		end
		return d
	end

--@include sparse_real.luau.in

	-- S x, accumulated in double precision. A general S is applied column by column (a
	-- scatter into a double accumulator); one marked symmetric as S^T x, a gather down its
	-- columns, about 10% faster still since each sum stays in a local.
	local function sparse_matvec(out: buffer?, S: Sparse, x: buffer): buffer
		assert(length(x) == S.cols, "matrix and vector sizes do not match")
		local o = output(out, @W@ * S.rows)
		assert(o ~= x, "output cannot be the input vector")
		if S.symmetric or S.hermitian then
			spk.gather(o, S, x)
			return o
		end
		local acc = if @W@ == 8 then o else buffer.create(8 * S.rows)
		buffer.fill(acc, 0, 0)
		spk.scatter(acc, S, x)
		if acc ~= o then
			for i = 0, S.rows - 1 do
				@WRITE@(o, @W@ * i, buffer.readf64(acc, 8 * i))
			end
		end
		return o
	end

	-- S^T x.
	local function sparse_matvec_adjoint(out: buffer?, S: Sparse, x: buffer): buffer
		assert(length(x) == S.rows, "matrix and vector sizes do not match")
		local o = output(out, @W@ * S.cols)
		assert(o ~= x, "output cannot be the input vector")
		spk.gather(o, S, x)
		return o
	end

	-- S B for a dense matrix B, as a dense matrix.
	local function sparse_matmul(out: Matrix?, S: Sparse, B: Matrix): Matrix
		assert(B.rows == S.cols, "matrix sizes do not match")
		local o = matoutput(out, S.rows, B.cols)
		assert(o.data ~= B.data, "output cannot be an input")
		local col, res = create(S.cols), create(S.rows)
		for j = 0, B.cols - 1 do
			buffer.copy(col, 0, B.data, @W@ * j * S.cols, @W@ * S.cols)
			sparse_matvec(res, S, col)
			buffer.copy(o.data, @W@ * j * S.rows, res, 0, @W@ * S.rows)
		end
		return o
	end

	-- S^T.
	local function sparse_transpose(S: Sparse): Sparse
		local colrows, colvals = empty_columns(S.rows)
		for j = 0, S.cols - 1 do
			for p = u32(S.colptr, j), u32(S.colptr, j + 1) - 1 do
				local r = u32(S.rowind, p) + 1
				table.insert(colrows[r], j)
				table.insert(colvals[r], @READ@(S.values, @W@ * p))
			end
		end
		local T = assemble(S.cols, S.rows, colrows, colvals)
		T.symmetric, T.hermitian = S.symmetric, S.hermitian
		return T
	end

	-- A + B.
	local function sparse_add(A: Sparse, B: Sparse): Sparse
		assert(A.rows == B.rows and A.cols == B.cols, "matrix sizes do not match")
		local colrows, colvals = empty_columns(A.cols)
		for j = 0, A.cols - 1 do
			local p, pe = u32(A.colptr, j), u32(A.colptr, j + 1)
			local q, qe = u32(B.colptr, j), u32(B.colptr, j + 1)
			local rs, vs = colrows[j + 1], colvals[j + 1]
			while p < pe or q < qe do
				local ra = if p < pe then u32(A.rowind, p) else math.huge
				local rb = if q < qe then u32(B.rowind, q) else math.huge
				if ra == rb then
					table.insert(rs, ra)
					table.insert(vs, @READ@(A.values, @W@ * p) + @READ@(B.values, @W@ * q))
					p += 1
					q += 1
				elseif ra < rb then
					table.insert(rs, ra)
					table.insert(vs, @READ@(A.values, @W@ * p))
					p += 1
				else
					table.insert(rs, rb)
					table.insert(vs, @READ@(B.values, @W@ * q))
					q += 1
				end
			end
		end
		local C = assemble(A.rows, A.cols, colrows, colvals)
		C.symmetric, C.hermitian = A.symmetric and B.symmetric, A.hermitian and B.hermitian
		return C
	end

	-- The Jacobi (diagonal) preconditioner of a square S, for the iterative solvers:
	-- out := r ./ diag(S). Every diagonal entry must be nonzero.
	local function sparse_jacobi(S: Sparse): (out: buffer, r: buffer) -> buffer
		assert(S.rows == S.cols, "matrix must be square")
		local d = sparse_diag(S)
		-- The inverses in double precision, in a buffer (table reads cost several buffer
		-- reads in the loop below).
		local inv = buffer.create(8 * S.rows)
		for i = 0, S.rows - 1 do
			local v = @READ@(d, @W@ * i)
			assert(v ~= 0, "a diagonal entry is zero")
			buffer.writef64(inv, 8 * i, 1 / v)
		end
		local stop = @W@ * (S.rows - 1)
		return function(out: buffer, r: buffer): buffer
			--@unroll
			for k = 0, stop, @W@ do
				@WRITE@(out, k, @READ@(r, k) * buffer.readf64(inv, (8 // @W@) * k))
			end
			return out
		end
	end

	-- For real matrices the adjoint is the transpose.
	local sparse_adjoint = sparse_transpose

	-- Preconditioners for the iterative solvers

	-- The SSOR preconditioner of a square S with relaxation omega (0 < omega < 2; the default
	-- 1 is symmetric Gauss-Seidel): M = (D + w L) D^-1 (D + w U) / (w (2 - w)), with D, L, U
	-- the diagonal and strictly lower and upper parts. Returns out := M^-1 r. If S is
	-- symmetric positive definite, so is M (usable with CG). Every diagonal entry must be
	-- nonzero.
	local function sparse_ssor(S: Sparse, omega: number?): (out: buffer, r: buffer) -> buffer
		local w = omega or 1
		assert(w > 0 and w < 2, "omega must be between 0 and 2")
		assert(S.rows == S.cols, "matrix must be square")
		local n = S.rows
		local d = totable(sparse_diag(S))
		for i = 1, n do
			assert(d[i] ~= 0, "a diagonal entry is zero")
		end
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local y = table.create(n, 0)
		local factor = w * (2 - w)
		return function(out: buffer, r: buffer): buffer
			for i = 1, n do
				y[i] = @READ@(r, @W@ * (i - 1))
			end
			-- (D + w L) y = r, column by column.
			for j = 0, n - 1 do
				local yj = y[j + 1] / d[j + 1]
				y[j + 1] = yj
				for p = u32(colptr, j), u32(colptr, j + 1) - 1 do
					local i = u32(rowind, p)
					if i > j then
						y[i + 1] -= w * @READ@(vals, @W@ * p) * yj
					end
				end
			end
			for i = 1, n do
				y[i] *= d[i]
			end
			-- (D + w U) z = D y, backwards.
			for j = n - 1, 0, -1 do
				local zj = y[j + 1] / d[j + 1]
				y[j + 1] = zj
				for p = u32(colptr, j), u32(colptr, j + 1) - 1 do
					local i = u32(rowind, p)
					if i < j then
						y[i + 1] -= w * @READ@(vals, @W@ * p) * zj
					end
				end
			end
			for i = 1, n do
				@WRITE@(out, @W@ * (i - 1), y[i] * factor)
			end
			return out
		end
	end

	-- Incomplete LU factorization ILU(0) of a square S, in place: S's values are overwritten
	-- with L and U in S's own sparsity pattern (no fill-in). Every diagonal entry must be
	-- stored; singular is true if one is missing or a pivot is zero. sparse_ilu0_copy leaves
	-- S unchanged.
	local function sparse_ilu0(S: Sparse): SparseILU
		assert(S.rows == S.cols, "matrix must be square")
		local n = S.rows
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local pos: { [number]: number } = {}
		local diag = table.create(n, 0)
		local singular = false
		for j = 0, n - 1 do
			local p0, p1 = u32(colptr, j), u32(colptr, j + 1) - 1
			for p = p0, p1 do
				pos[u32(rowind, p)] = p
			end
			-- Eliminate with each earlier column k that column j has an entry in, in order:
			-- u_kj is final by the time it is reached.
			for p = p0, p1 do
				local k = u32(rowind, p)
				if k >= j then
					break
				end
				local ukj = @READ@(vals, @W@ * p)
				if ukj ~= 0 then
					for q = diag[k + 1] + 1, u32(colptr, k + 1) - 1 do
						local t = pos[u32(rowind, q)]
						if t then
							@WRITE@(vals, @W@ * t, @READ@(vals, @W@ * t) - @READ@(vals, @W@ * q) * ukj)
						end
					end
				end
			end
			local dp = pos[j]
			if dp == nil or @READ@(vals, @W@ * dp) == 0 then
				singular = true
				diag[j + 1] = if dp then dp else p0
			else
				diag[j + 1] = dp
				local ujj = @READ@(vals, @W@ * dp)
				for p = dp + 1, p1 do
					@WRITE@(vals, @W@ * p, @READ@(vals, @W@ * p) / ujj)
				end
			end
			for p = p0, p1 do
				pos[u32(rowind, p)] = nil
			end
		end
		return { lu = S, diag = diag, singular = singular }
	end

	local function sparse_copy(S: Sparse): Sparse
		return { rows = S.rows, cols = S.cols, colptr = S.colptr, rowind = S.rowind, values = copy(nil, S.values), symmetric = S.symmetric, hermitian = S.hermitian }
	end

	-- sparse_ilu0 of a copy of S (the index arrays are shared, the values copied).
	local function sparse_ilu0_copy(S: Sparse): SparseILU
		return sparse_ilu0(sparse_copy(S))
	end

	-- out := (L U)^-1 r given F = sparse_ilu0(S); use it as a preconditioner with
	-- function(out, r) return sparse_ilu0_solve(out, F, r) end.
	local function sparse_ilu0_solve(out: buffer?, F: SparseILU, r: buffer): buffer
		assert(not F.singular, "the incomplete factorization is singular")
		local S = F.lu
		local n = S.rows
		assert(length(r) == n, "matrix and vector sizes do not match")
		local colptr, rowind, vals, diag = S.colptr, S.rowind, S.values, F.diag
		local y = totable(r)
		for j = 0, n - 1 do
			local yj = y[j + 1]
			for p = diag[j + 1] + 1, u32(colptr, j + 1) - 1 do
				local i = u32(rowind, p) + 1
				y[i] -= @READ@(vals, @W@ * p) * yj
			end
		end
		for j = n - 1, 0, -1 do
			local yj = y[j + 1] / @READ@(vals, @W@ * diag[j + 1])
			y[j + 1] = yj
			for p = u32(colptr, j), diag[j + 1] - 1 do
				local i = u32(rowind, p) + 1
				y[i] -= @READ@(vals, @W@ * p) * yj
			end
		end
		local o = output(out, @W@ * n)
		for i = 1, n do
			@WRITE@(o, @W@ * (i - 1), y[i])
		end
		return o
	end

	-- Incomplete Cholesky factorization IC(0) of a symmetric positive definite S, in place:
	-- only the lower triangle is read, and it is overwritten with L in its own sparsity
	-- pattern (no fill-in). It can break down even for positive definite S (definite is then
	-- false); it cannot for M-matrices such as discrete Laplacians. sparse_ic0_copy leaves S
	-- unchanged.
	local function sparse_ic0(S: Sparse): SparseIC
		assert(S.rows == S.cols, "matrix must be square")
		local n = S.rows
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local diag = table.create(n, 0)
		for j = 0, n - 1 do
			local dp = find(S, j, j)
			if dp == nil then
				return { ic = S, diag = diag, definite = false }
			end
			diag[j + 1] = dp
			local djj = @READ@(vals, @W@ * dp)
			if not (djj > 0) then
				return { ic = S, diag = diag, definite = false }
			end
			djj = math.sqrt(djj)
			@WRITE@(vals, @W@ * dp, djj)
			local p1 = u32(colptr, j + 1) - 1
			for p = dp + 1, p1 do
				@WRITE@(vals, @W@ * p, @READ@(vals, @W@ * p) / djj)
			end
			-- Right-looking update of later columns, only where the pattern has an entry:
			-- A(i, k) -= L(i, j) L(k, j) for j < k <= i.
			for q = dp + 1, p1 do
				local k = u32(rowind, q)
				local lkj = @READ@(vals, @W@ * q)
				for p = q, p1 do
					local t = find(S, u32(rowind, p), k)
					if t then
						@WRITE@(vals, @W@ * t, @READ@(vals, @W@ * t) - @READ@(vals, @W@ * p) * lkj)
					end
				end
			end
		end
		return { ic = S, diag = diag, definite = true }
	end

	-- sparse_ic0 of a copy of S (the index arrays are shared, the values copied).
	local function sparse_ic0_copy(S: Sparse): SparseIC
		return sparse_ic0(sparse_copy(S))
	end

	-- out := (L L^T)^-1 r given F = sparse_ic0(S); use it as a preconditioner with
	-- function(out, r) return sparse_ic0_solve(out, F, r) end.
	local function sparse_ic0_solve(out: buffer?, F: SparseIC, r: buffer): buffer
		assert(F.definite, "the incomplete Cholesky factorization broke down")
		local S = F.ic
		local n = S.rows
		assert(length(r) == n, "matrix and vector sizes do not match")
		local colptr, rowind, vals, diag = S.colptr, S.rowind, S.values, F.diag
		local y = totable(r)
		-- L y = r
		for j = 0, n - 1 do
			local yj = y[j + 1] / @READ@(vals, @W@ * diag[j + 1])
			y[j + 1] = yj
			for p = diag[j + 1] + 1, u32(colptr, j + 1) - 1 do
				local i = u32(rowind, p) + 1
				y[i] -= @READ@(vals, @W@ * p) * yj
			end
		end
		-- L^T z = y
		for j = n - 1, 0, -1 do
			local s = y[j + 1]
			for p = diag[j + 1] + 1, u32(colptr, j + 1) - 1 do
				s -= @READ@(vals, @W@ * p) * y[u32(rowind, p) + 1]
			end
			y[j + 1] = s / @READ@(vals, @W@ * diag[j + 1])
		end
		local o = output(out, @W@ * n)
		for i = 1, n do
			@WRITE@(o, @W@ * (i - 1), y[i])
		end
		return o
	end

	-- Block sparse matrices

	-- Position (0-based) of block (I, J) (0-based) in B's arrays, or nil.
	local function find_block(B: BlockSparse, I: number, J: number): number?
		local lo, hi = u32(B.rowptr, I), u32(B.rowptr, I + 1) - 1
		while lo <= hi do
			local mid = (lo + hi) // 2
			local c = u32(B.colind, mid)
			if c == J then
				return mid
			elseif c < J then
				lo = mid + 1
			else
				hi = mid - 1
			end
		end
		return nil
	end

	-- The block sparse matrix with block row I's blocks at the (sorted, distinct) block
	-- columns cols[I + 1], values zero.
	local function block_pattern(rows: number, cols: number, block: number, colsets: { { number } }): BlockSparse
		local br = rows // block
		local nb = 0
		for I = 1, br do
			nb += #colsets[I]
		end
		local rowptr, colind = buffer.create(4 * (br + 1)), buffer.create(4 * nb)
		local p = 0
		for I = 1, br do
			buffer.writeu32(rowptr, 4 * (I - 1), p)
			for _, J in colsets[I] do
				buffer.writeu32(colind, 4 * p, J)
				p += 1
			end
		end
		buffer.writeu32(rowptr, 4 * br, p)
		return { rows = rows, cols = cols, block = block, rowptr = rowptr, colind = colind, values = create(block * block * nb) }
	end

	-- A rows by cols block sparse matrix with block by block blocks from block triplets:
	-- block (ii[k], jj[k]) (1-based block indices) gets the block^2 entries of values from
	-- element block^2 (k - 1) + 1 on, column-major; repeated positions are summed.
	local function bsparse(rows: number, cols: number, block: number, ii: { number }, jj: { number }, values: buffer): BlockSparse
		assert(block >= 1 and block % 1 == 0 and rows % block == 0 and cols % block == 0, "rows and cols must be multiples of the block size")
		local bb = block * block
		local count = #ii
		assert(#jj == count and length(values) == bb * count, "need block^2 values per block position")
		local br, bc = rows // block, cols // block
		local colsets = table.create(br) :: { { number } }
		for I = 1, br do
			colsets[I] = {}
		end
		local seen = {} :: { [number]: boolean }
		for k = 1, count do
			local I, J = ii[k], jj[k]
			assert(I % 1 == 0 and J % 1 == 0 and I >= 1 and I <= br and J >= 1 and J <= bc, "block position outside the matrix")
			local key = (I - 1) * bc + (J - 1)
			if not seen[key] then
				seen[key] = true
				table.insert(colsets[I], J - 1)
			end
		end
		for I = 1, br do
			table.sort(colsets[I])
		end
		local B = block_pattern(rows, cols, block, colsets)
		-- Sum in double precision, then round once.
		local acc = buffer.create(8 * bb * buffer.len(B.colind) // 4)
		for k = 1, count do
			local p = find_block(B, ii[k] - 1, jj[k] - 1) :: number
			for e = 0, bb - 1 do
				local a = 8 * (bb * p + e)
				buffer.writef64(acc, a, buffer.readf64(acc, a) + @READ@(values, @W@ * (bb * (k - 1) + e)))
			end
		end
		for e = 0, buffer.len(acc) // 8 - 1 do
			@WRITE@(B.values, @W@ * e, buffer.readf64(acc, 8 * e))
		end
		return B
	end

	-- S in blocks of block by block (every block holding a stored entry of S is stored
	-- whole); S's symmetric and hermitian marks carry over.
	local function bsparse_from_sparse(S: Sparse, block: number): BlockSparse
		assert(block >= 1 and block % 1 == 0 and S.rows % block == 0 and S.cols % block == 0, "rows and cols must be multiples of the block size")
		local br, bb = S.rows // block, block * block
		local colsets = table.create(br) :: { { number } }
		local seen = table.create(br) :: { { [number]: boolean } }
		for I = 1, br do
			colsets[I], seen[I] = {}, {}
		end
		for j = 0, S.cols - 1 do
			local J = j // block
			for p = u32(S.colptr, j), u32(S.colptr, j + 1) - 1 do
				local I = u32(S.rowind, p) // block + 1
				if not seen[I][J] then
					seen[I][J] = true
					table.insert(colsets[I], J)
				end
			end
		end
		for I = 1, br do
			table.sort(colsets[I])
		end
		local B = block_pattern(S.rows, S.cols, block, colsets)
		for j = 0, S.cols - 1 do
			for p = u32(S.colptr, j), u32(S.colptr, j + 1) - 1 do
				local r = u32(S.rowind, p)
				local q = find_block(B, r // block, j // block) :: number
				@WRITE@(B.values, @W@ * (bb * q + (j % block) * block + r % block), @READ@(S.values, @W@ * p))
			end
		end
		B.symmetric, B.hermitian = S.symmetric, S.hermitian
		return B
	end

	-- B as a Sparse matrix, every entry of its stored blocks stored (zeros included).
	local function bsparse_sparse(B: BlockSparse): Sparse
		local b, bb = B.block, B.block * B.block
		local colrows, colvals = empty_columns(B.cols)
		for I = 0, B.rows // b - 1 do
			for p = u32(B.rowptr, I), u32(B.rowptr, I + 1) - 1 do
				local J = u32(B.colind, p)
				for k = 0, b - 1 do
					local rs, vs = colrows[J * b + k + 1], colvals[J * b + k + 1]
					for r = 0, b - 1 do
						table.insert(rs, I * b + r)
						table.insert(vs, @READ@(B.values, @W@ * (bb * p + k * b + r)))
					end
				end
			end
		end
		local S = assemble(B.rows, B.cols, colrows, colvals)
		S.symmetric, S.hermitian = B.symmetric, B.hermitian
		return S
	end

	-- Number of stored entries (block^2 per stored block).
	local function bsparse_nnz(B: BlockSparse): number
		return B.block * B.block * (buffer.len(B.colind) // 4)
	end

	-- The number p (1-based) of block (I, J) (1-based block indices), or nil if it is not
	-- stored: its entries are values[block^2 (p - 1) + 1 .. block^2 p], column-major. For
	-- updating values in place (a Jacobian refilled each step on a fixed pattern).
	local function bsparse_block(B: BlockSparse, I: number, J: number): number?
		local p = find_block(B, I - 1, J - 1)
		return if p then p + 1 else nil
	end

	-- Entry (i, j), 1-based (0 if not stored).
	local function bsparse_get(B: BlockSparse, i: number, j: number): number
		local b = B.block
		local p = find_block(B, (i - 1) // b, (j - 1) // b)
		return if p then @READ@(B.values, @W@ * (b * b * p + ((j - 1) % b) * b + (i - 1) % b)) else 0
	end

	-- The diagonal, as an array of min(rows, cols) entries.
	local function bsparse_diag(B: BlockSparse): buffer
		local b = B.block
		local k = math.min(B.rows, B.cols)
		local d = create(k)
		for I = 0, k // b - 1 do
			local p = find_block(B, I, I)
			if p then
				for r = 0, b - 1 do
					@WRITE@(d, @W@ * (I * b + r), @READ@(B.values, @W@ * (b * b * p + r * b + r)))
				end
			end
		end
		return d
	end

	-- B x, accumulated in double precision (generated kernels for blocks of 2, 3 and 4).
	local function bsparse_matvec(out: buffer?, B: BlockSparse, x: buffer): buffer
		assert(length(x) == B.cols, "matrix and vector sizes do not match")
		local o = output(out, @W@ * B.rows)
		assert(o ~= x, "output cannot be the input vector")
		local kernel = spk.block[B.block]
		if kernel then
			kernel.mv(o, B, x)
			return o
		end
		local b = B.block
		local bb = b * b
		local s = table.create(b, 0)
		for I = 0, B.rows // b - 1 do
			for r = 1, b do
				s[r] = 0
			end
			for p = u32(B.rowptr, I), u32(B.rowptr, I + 1) - 1 do
				local J = u32(B.colind, p)
				for k = 0, b - 1 do
					local xk = @READ@(x, @W@ * (J * b + k))
					local v = bb * p + k * b
					for r = 0, b - 1 do
						s[r + 1] += @READ@(B.values, @W@ * (v + r)) * xk
					end
				end
			end
			for r = 0, b - 1 do
				@WRITE@(o, @W@ * (I * b + r), s[r + 1])
			end
		end
		return o
	end

	-- B^T x (B x when B is marked symmetric).
	local function bsparse_matvec_adjoint(out: buffer?, B: BlockSparse, x: buffer): buffer
		if B.symmetric or B.hermitian then
			return bsparse_matvec(out, B, x)
		end
		assert(length(x) == B.rows, "matrix and vector sizes do not match")
		local o = output(out, @W@ * B.cols)
		assert(o ~= x, "output cannot be the input vector")
		local acc = if @W@ == 8 then o else buffer.create(8 * B.cols)
		buffer.fill(acc, 0, 0)
		local kernel = spk.block[B.block]
		if kernel then
			kernel.mvt(acc, B, x)
		else
			local b = B.block
			local bb = b * b
			for I = 0, B.rows // b - 1 do
				for p = u32(B.rowptr, I), u32(B.rowptr, I + 1) - 1 do
					local J = u32(B.colind, p)
					for k = 0, b - 1 do
						local t = 0
						for r = 0, b - 1 do
							t += @READ@(B.values, @W@ * (bb * p + k * b + r)) * @READ@(x, @W@ * (I * b + r))
						end
						local a = 8 * (J * b + k)
						buffer.writef64(acc, a, buffer.readf64(acc, a) + t)
					end
				end
			end
		end
		if acc ~= o then
			for i = 0, B.cols - 1 do
				@WRITE@(o, @W@ * i, buffer.readf64(acc, 8 * i))
			end
		end
		return o
	end

	-- The inverses of B's diagonal blocks, in double precision (bb f64 per block row,
	-- column-major), into inv (allocated if nil).
	local function block_inverses(B: BlockSparse, inv: buffer?): buffer
		assert(B.rows == B.cols, "matrix must be square")
		local b = B.block
		local bb, nb = b * b, B.rows // b
		local out = inv or buffer.create(8 * bb * nb)
		local a = table.create(bb, 0)
		local z = table.create(bb, 0)
		for I = 0, nb - 1 do
			local p = find_block(B, I, I)
			assert(p, "a diagonal block is not stored")
			for e = 1, bb do
				a[e] = @READ@(B.values, @W@ * (bb * (p :: number) + e - 1))
				z[e] = if (e - 1) // b == (e - 1) % b then 1 else 0
			end
			-- Gauss-Jordan on [a | z], column-major (entry (r, c) at c * b + r + 1).
			for c = 0, b - 1 do
				local piv, best = c, math.abs(a[c * b + c + 1])
				for r = c + 1, b - 1 do
					local v = math.abs(a[c * b + r + 1])
					if v > best then
						piv, best = r, v
					end
				end
				assert(best > 0, "a diagonal block is singular")
				if piv ~= c then
					for k = 0, b - 1 do
						a[k * b + c + 1], a[k * b + piv + 1] = a[k * b + piv + 1], a[k * b + c + 1]
						z[k * b + c + 1], z[k * b + piv + 1] = z[k * b + piv + 1], z[k * b + c + 1]
					end
				end
				local d = 1 / a[c * b + c + 1]
				for k = 0, b - 1 do
					a[k * b + c + 1] *= d
					z[k * b + c + 1] *= d
				end
				for r = 0, b - 1 do
					local f = a[c * b + r + 1]
					if r ~= c and f ~= 0 then
						for k = 0, b - 1 do
							a[k * b + r + 1] -= f * a[k * b + c + 1]
							z[k * b + r + 1] -= f * z[k * b + c + 1]
						end
					end
				end
			end
			for e = 1, bb do
				buffer.writef64(out, 8 * (bb * I + e - 1), z[e])
			end
		end
		return out
	end

	-- o := blockdiag(inv) r for nb inverse blocks of size b (from block_inverses).
	local function apply_block_inverses(o: buffer, inv: buffer, r: buffer, b: number, nb: number)
		local kernel = spk.block[b]
		if kernel then
			kernel.jacobi(o, inv, r, nb)
			return
		end
		local bb = b * b
		local t = table.create(b, 0)
		for I = 0, nb - 1 do
			for k = 0, b - 1 do
				t[k + 1] = @READ@(r, @W@ * (I * b + k))
			end
			for i = 0, b - 1 do
				local s = 0
				for k = 0, b - 1 do
					s += buffer.readf64(inv, 8 * (bb * I + k * b + i)) * t[k + 1]
				end
				@WRITE@(o, @W@ * (I * b + i), s)
			end
		end
	end

	-- The block Jacobi preconditioner of a square B, for the iterative solvers: out :=
	-- blockdiag(B)^-1 r, the diagonal blocks inverted once (in double precision, by
	-- Gauss-Jordan elimination with partial pivoting). It keeps each node's coupling between
	-- its own unknowns, which scalar Jacobi drops, and is unchanged by rotating a node's
	-- coordinates. Every diagonal block must be stored and nonsingular; for a symmetric
	-- positive definite B it is symmetric positive definite (usable with CG).
	local function bsparse_jacobi(B: BlockSparse): (out: buffer, r: buffer) -> buffer
		local inv = block_inverses(B)
		local b = B.block
		local nb = B.rows // b
		return function(out: buffer, r: buffer): buffer
			local o = output(out, @W@ * B.rows)
			apply_block_inverses(o, inv, r, b, nb)
			return o
		end
	end

--@include amg_real.luau.in

