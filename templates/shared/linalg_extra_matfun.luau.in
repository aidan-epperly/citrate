-- Padé coefficients b_0 .. b_m of exp, and the 1-norm thresholds theta_m below which
-- the [m/m] approximant is accurate to unit roundoff (Higham 2005; single precision
-- uses its own thresholds and stops at m = 7).
local PADE: { [number]: { number } } = {
	[3] = { 120, 60, 12, 1 },
	[5] = { 30240, 15120, 3360, 420, 30, 1 },
	[7] = { 17297280, 8648640, 1995840, 277200, 25200, 1512, 56, 1 },
	[9] = { 17643225600, 8821612800, 2075673600, 302702400, 30270240, 2162160, 110880, 3960, 90, 1 },
	[13] = {
		64764752532480000,
		32382376266240000,
		7771770303897600,
		1187353796428800,
		129060195264000,
		10559470521600,
		670442572800,
		33522128640,
		1323241920,
		40840800,
		960960,
		16380,
		182,
		1,
	},
}
local THETA: { { number } } = if EPS > 1e-10
	then { { 3, 4.258730016922831e-1 }, { 5, 1.880152677804762 }, { 7, 3.925724783138660 } }
	else {
		{ 3, 1.495585217958292e-2 },
		{ 5, 2.539398330063230e-1 },
		{ 7, 9.504178996162932e-1 },
		{ 9, 2.097847961257068 },
		{ 13, 5.371920351148152 },
	}

-- M := M + c I.
local function add_identity(M: Matrix, c: number)
	local n = M.rows
	for i = 0, n - 1 do
		local re, im = eget(M.data, i * n + i)
		eset(M.data, i * n + i, re + c, im)
	end
end

-- The [m/m] Padé approximant r_m(A) = (V - U)^-1 (V + U), U odd and V even in A. Works in
-- a fixed set of n by n matrices (6 for m < 13, 5 for m = 13), each product written into
-- one no longer needed, and returns one of them.
local function pade(A: Matrix, m: number): Matrix
	local n = A.rows
	local b = PADE[m]
	local A2 = matmul(nil, A, A)
	local U: Matrix, P: Matrix, Q: Matrix
	if m < 13 then
		-- W = b_2 I + b_4 A^2 + ..., V = b_1 I + b_3 A^2 + ...; powers of A^2 alternate
		-- between X1 and X2
		local W, V = matrix(n, n), matrix(n, n)
		add_identity(W, b[2])
		add_identity(V, b[1])
		local X1: Matrix?, X2: Matrix? = nil, nil
		local Pk = A2
		for k = 1, (m - 1) // 2 do
			axpy(W.data, b[2 * k + 2], Pk.data, W.data)
			axpy(V.data, b[2 * k + 1], Pk.data, V.data)
			if k < (m - 1) // 2 then
				local into = if Pk == X1 then X2 else X1
				Pk = matmul(into, Pk, A2)
				if into == nil then
					if X1 == nil then
						X1 = Pk
					else
						X2 = Pk
					end
				end
			end
		end
		U = matmul(nil, A, W)
		-- Q = V - U into W, P = V + U into V
		Q = W
		sub(Q.data, V.data, U.data)
		P = V
		add(P.data, V.data, U.data)
	else
		local A4 = matmul(nil, A2, A2)
		local A6 = matmul(nil, A4, A2)
		-- T = b_14 A^6 + b_12 A^4 + b_10 A^2; W = A^6 T + b_8 A^6 + b_6 A^4 + b_4 A^2 + b_2 I
		local T = matrix(n, n)
		scale(T.data, b[14], A6.data)
		axpy(T.data, b[12], A4.data, T.data)
		axpy(T.data, b[10], A2.data, T.data)
		local W = matmul(nil, A6, T)
		axpy(W.data, b[8], A6.data, W.data)
		axpy(W.data, b[6], A4.data, W.data)
		axpy(W.data, b[4], A2.data, W.data)
		add_identity(W, b[2])
		U = matmul(T, A, W) -- (T is free now)
		-- V = A^6 (b_13 A^6 + b_11 A^4 + b_9 A^2) + b_7 A^6 + b_5 A^4 + b_3 A^2 + b_1 I: the
		-- product's factor into W, the rest into A4, the product into A2
		scale(W.data, b[13], A6.data)
		axpy(W.data, b[11], A4.data, W.data)
		axpy(W.data, b[9], A2.data, W.data)
		scale(A4.data, b[5], A4.data)
		axpy(A4.data, b[7], A6.data, A4.data)
		axpy(A4.data, b[3], A2.data, A4.data)
		add_identity(A4, b[1])
		local V = matmul(A2, A6, W)
		axpy(V.data, 1, A4.data, V.data)
		-- P = V + U into A4, Q = V - U into A6
		P = A4
		add(P.data, V.data, U.data)
		Q = A6
		sub(Q.data, V.data, U.data)
	end
	-- X = Q^-1 P, factoring Q in place, into U (free now)
	return solve(U, lu(Q), P, "lu")
end

-- Diagonal scaling D (powers of 2, so exact) making each row and column of D^-1 A D about
-- equally large off the diagonal (the scaling step of LAPACK's gebal). Returns D^-1 A D
-- and D's diagonal.
local function scaling_balance(A: Matrix): (Matrix, { number })
	local n = A.rows
	local B = matcopy(nil, A)
	local b = B.data
	local d = table.create(n, 1)
	local function mag(i: number, j: number): number
		local re, im = eget(b, j * n + i)
		return math.abs(re) + math.abs(im)
	end
	local converged = false
	while not converged do
		converged = true
		for i = 0, n - 1 do
			local c, r = 0, 0
			for j = 0, n - 1 do
				if j ~= i then
					c += mag(j, i)
					r += mag(i, j)
				end
			end
			if c > 0 and r > 0 then
				local f, cf, rf = 1, c, r
				while cf < rf / 2 and f < 2 ^ 500 do
					f, cf, rf = f * 2, cf * 2, rf / 2
				end
				while cf >= rf * 2 and f > 2 ^ -500 do
					f, cf, rf = f / 2, cf / 2, rf * 2
				end
				if cf + rf < 0.95 * (c + r) then
					converged = false
					d[i + 1] *= f
					for j = 0, n - 1 do
						local re, im = eget(b, i * n + j) -- column i times f
						eset(b, i * n + j, re * f, im * f)
						re, im = eget(b, j * n + i) -- row i divided by f
						eset(b, j * n + i, re / f, im / f)
					end
				end
			end
		end
	end
	return B, d
end

-- The matrix exponential, by scaling and squaring with Padé approximants (Higham
-- 2005): the smallest degree m in {3, 5, 7, 9, 13} whose threshold covers |A|_1, or
-- else degree 13 on A / 2^s, squared s times. A is first balanced, exp(A) = D exp(B) D^-1
-- with B = D^-1 A D, when that makes |B|_1 smaller (as Al-Mohy and Higham 2009 advise):
-- badly scaled matrices, such as a stiff spring's [0 1; -w^2 -2 z w], otherwise lose
-- digits in the squaring (1e-6 against 1e-12 at w = 6283 over a unit step). A is not
-- modified; NaN or infinite entries give a NaN result.
local function expm_unbalanced(A: Matrix): Matrix
	local n = A.rows
	local a = matnorm(A, 1)
	for _, mt in THETA do
		if a <= mt[2] then
			return pade(A, mt[1])
		end
	end
	local top = THETA[#THETA]
	local s = math.max(0, math.ceil(math.log(a / top[2], 2)))
	local As = matrix(n, n)
	scale(As.data, 2 ^ -s, A.data)
	local X = pade(As, top[1])
	-- squaring, alternating between X and As (free now)
	local Y = As
	for _ = 1, s do
		X, Y = matmul(Y, X, X), X
	end
	return X
end

local function expm(A: Matrix): Matrix
	local n = A.rows
	assert(A.cols == n, "expm needs a square matrix")
	local reals = buffer.len(A.data) // @W@
	if any_nonfinite(A.data, 0, reals) then
		local X = matrix(n, n)
		fill_nan(X.data, 0, reals)
		return X
	end
	if n == 0 then
		return matrix(0, 0)
	end
	local B, d = scaling_balance(A)
	if not (matnorm(B, 1) < matnorm(A, 1)) then
		return expm_unbalanced(A)
	end
	local X = expm_unbalanced(B)
	local x = X.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local re, im = eget(x, j * n + i)
			local f = d[i + 1] / d[j + 1]
			eset(x, j * n + i, re * f, im * f)
		end
	end
	return X
end
