--!strict
--!native
--!optimize 2
-- Generated by tools/generate.py from templates/complex.luau.in. Edit the template, not this file.

-- @NAME@ arrays (buffers of interleaved @W@-byte real and imaginary parts) and
-- column-major matrices. Indices are 1-based. Arithmetic is done in double precision
-- and rounded once per stored value. Every `out` argument may be nil, in which case a
-- new result is allocated. Complex scalars are @SCALAR@.

local types = require("./types")
local complex64 = require("./complex64")

export type Matrix = types.Matrix
export type LU = types.LU
export type QR = types.QR
export type QRP = types.QRP
export type Cholesky = types.Cholesky
export type Form = types.Form

-- Arrays

local function create(n: number): buffer
	return buffer.create(@E@ * n)
end

local function length(x: buffer): number
	return buffer.len(x) // @E@
end

local function similar(x: buffer): buffer
	return buffer.create(buffer.len(x))
end

local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

local function check_same(x: buffer, y: buffer)
	assert(buffer.len(x) == buffer.len(y), "arrays have different lengths")
end

local function from(re: { number }, im: { number }?): buffer
	local n = #re
	assert(im == nil or #im == n, "real and imaginary parts have different lengths")
	local x = buffer.create(@E@ * n)
	for i = 1, n do
		local k = @E@ * (i - 1)
		@WRITE@(x, k, re[i])
		if im then
			@WRITE@(x, k + @W@, im[i])
		end
	end
	return x
end

-- Returns the real and imaginary parts as two tables.
local function totable(x: buffer): ({ number }, { number })
	local n = length(x)
	local re, im = table.create(n, 0), table.create(n, 0)
	for i = 1, n do
		local k = @E@ * (i - 1)
		re[i] = @READ@(x, k)
		im[i] = @READ@(x, k + @W@)
	end
	return re, im
end

local function copy(out: buffer?, x: buffer): buffer
	local o = output(out, buffer.len(x))
	if o ~= x then
		buffer.copy(o, 0, x)
	end
	return o
end

local function fill_pair(out: buffer, re: number, im: number): buffer
	for k = 0, buffer.len(out) - @E@, @E@ do
		@WRITE@(out, k, re)
		@WRITE@(out, k + @W@, im)
	end
	return out
end

-- Builds a complex array from real arrays of the same precision.
local function complexify(re: buffer, im: buffer?): buffer
	assert(im == nil or buffer.len(im) == buffer.len(re), "parts have different lengths")
	local n = buffer.len(re) // @W@
	local x = buffer.create(@E@ * n)
	for i = 0, n - 1 do
		@WRITE@(x, @E@ * i, @READ@(re, @W@ * i))
		if im then
			@WRITE@(x, @E@ * i + @W@, @READ@(im, @W@ * i))
		end
	end
	return x
end

local function real(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, @W@ * n)
	for i = 0, n - 1 do
		@WRITE@(o, @W@ * i, @READ@(x, @E@ * i))
	end
	return o
end

local function imag(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, @W@ * n)
	for i = 0, n - 1 do
		@WRITE@(o, @W@ * i, @READ@(x, @E@ * i + @W@))
	end
	return o
end

-- Elementwise modulus, as a real array.
local function abs(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, @W@ * n)
	for i = 0, n - 1 do
		@WRITE@(o, @W@ * i, complex64.abs(@READ@(x, @E@ * i), @READ@(x, @E@ * i + @W@)))
	end
	return o
end

local function conj(out: buffer?, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - @E@, @E@ do
		@WRITE@(o, k, @READ@(x, k))
		@WRITE@(o, k + @W@, -@READ@(x, k + @W@))
	end
	return o
end

-- Addition, subtraction and real scaling act on the real and imaginary parts alike.
local function add(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - @W@, @W@ do
		@WRITE@(o, k, @READ@(x, k) + @READ@(y, k))
	end
	return o
end

local function sub(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - @W@, @W@ do
		@WRITE@(o, k, @READ@(x, k) - @READ@(y, k))
	end
	return o
end

local function scale(out: buffer?, a: number, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - @W@, @W@ do
		@WRITE@(o, k, a * @READ@(x, k))
	end
	return o
end

-- a * x + y with a real
local function axpy(out: buffer?, a: number, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - @W@, @W@ do
		@WRITE@(o, k, a * @READ@(x, k) + @READ@(y, k))
	end
	return o
end

-- Elementwise (Hadamard) product.
local function mul(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - @E@, @E@ do
		local xr, xi = @READ@(x, k), @READ@(x, k + @W@)
		local yr, yi = @READ@(y, k), @READ@(y, k + @W@)
		@WRITE@(o, k, xr * yr - xi * yi)
		@WRITE@(o, k + @W@, xr * yi + xi * yr)
	end
	return o
end

local function cscale_pair(out: buffer?, ar: number, ai: number, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - @E@, @E@ do
		local xr, xi = @READ@(x, k), @READ@(x, k + @W@)
		@WRITE@(o, k, ar * xr - ai * xi)
		@WRITE@(o, k + @W@, ar * xi + ai * xr)
	end
	return o
end

local function caxpy_pair(out: buffer?, ar: number, ai: number, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - @E@, @E@ do
		local xr, xi = @READ@(x, k), @READ@(x, k + @W@)
		@WRITE@(o, k, ar * xr - ai * xi + @READ@(y, k))
		@WRITE@(o, k + @W@, ar * xi + ai * xr + @READ@(y, k + @W@))
	end
	return o
end

-- sum x_i y_i (no conjugation)
local function dotu_pair(x: buffer, y: buffer): (number, number)
	check_same(x, y)
	local sr, si = 0, 0
	for k = 0, buffer.len(x) - @E@, @E@ do
		local xr, xi = @READ@(x, k), @READ@(x, k + @W@)
		local yr, yi = @READ@(y, k), @READ@(y, k + @W@)
		sr += xr * yr - xi * yi
		si += xr * yi + xi * yr
	end
	return sr, si
end

-- sum conj(x_i) y_i
local function dotc_pair(x: buffer, y: buffer): (number, number)
	check_same(x, y)
	local sr, si = 0, 0
	for k = 0, buffer.len(x) - @E@, @E@ do
		local xr, xi = @READ@(x, k), @READ@(x, k + @W@)
		local yr, yi = @READ@(y, k), @READ@(y, k + @W@)
		sr += xr * yr + xi * yi
		si += xr * yi - xi * yr
	end
	return sr, si
end

local function sum_pair(x: buffer): (number, number)
	local sr, si = 0, 0
	for k = 0, buffer.len(x) - @E@, @E@ do
		sr += @READ@(x, k)
		si += @READ@(x, k + @W@)
	end
	return sr, si
end

-- Largest modulus (NaN if any element is NaN, 0 for an empty array).
local function amax(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - @E@, @E@ do
		local a = complex64.abs(@READ@(x, k), @READ@(x, k + @W@))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	return m
end

--@include norms.luau.in

-- Euclidean norm (of the 2n real components), without overflow or underflow.
local function norm(x: buffer): number
	return segment_norm(x, 0, 2 * length(x))
end

-- Matrices

local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(@E@ * rows * cols) }
end

local function matoutput(out: Matrix?, rows: number, cols: number): Matrix
	if out == nil then
		return matrix(rows, cols)
	end
	assert(out.rows == rows and out.cols == cols, "output has the wrong shape")
	return out
end

-- Builds a matrix from tables of rows of the real and (optional) imaginary parts.
local function matfrom(re: { { number } }, im: { { number } }?): Matrix
	local rows = #re
	local cols = if rows > 0 then #re[1] else 0
	assert(im == nil or #im == rows, "real and imaginary parts have different shapes")
	local A = matrix(rows, cols)
	for i = 1, rows do
		local row = re[i]
		assert(#row == cols, "rows have different lengths")
		local irow = if im then im[i] else nil
		assert(irow == nil or #irow == cols, "real and imaginary parts have different shapes")
		for j = 1, cols do
			local k = @E@ * ((j - 1) * rows + i - 1)
			@WRITE@(A.data, k, row[j])
			if irow then
				@WRITE@(A.data, k + @W@, irow[j])
			end
		end
	end
	return A
end

-- Returns tables of rows of the real and imaginary parts.
local function mattotable(A: Matrix): ({ { number } }, { { number } })
	local re, im = table.create(A.rows) :: { { number } }, table.create(A.rows) :: { { number } }
	for i = 1, A.rows do
		local rrow, irow = table.create(A.cols, 0), table.create(A.cols, 0)
		for j = 1, A.cols do
			local k = @E@ * ((j - 1) * A.rows + i - 1)
			rrow[j] = @READ@(A.data, k)
			irow[j] = @READ@(A.data, k + @W@)
		end
		re[i], im[i] = rrow, irow
	end
	return re, im
end

local function identity(n: number): Matrix
	local A = matrix(n, n)
	for i = 0, n - 1 do
		@WRITE@(A.data, @E@ * (i * n + i), 1)
	end
	return A
end

local function matcopy(out: Matrix?, A: Matrix): Matrix
	local o = matoutput(out, A.rows, A.cols)
	if o.data ~= A.data then
		buffer.copy(o.data, 0, A.data)
	end
	return o
end

local function transpose_impl(out: Matrix?, A: Matrix, sign: number): Matrix
	local m, n = A.rows, A.cols
	local o = matoutput(out, n, m)
	assert(o.data ~= A.data, "transpose cannot be done in place")
	local a, d = A.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local s, t = @E@ * (j * m + i), @E@ * (i * n + j)
			@WRITE@(d, t, @READ@(a, s))
			@WRITE@(d, t + @W@, sign * @READ@(a, s + @W@))
		end
	end
	return o
end

local function transpose(out: Matrix?, A: Matrix): Matrix
	return transpose_impl(out, A, 1)
end

-- Conjugate transpose.
local function adjoint(out: Matrix?, A: Matrix): Matrix
	return transpose_impl(out, A, -1)
end

-- A x
local function matvec(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(buffer.len(x) == @E@ * n, "matrix and vector sizes do not match")
	local o = output(out, @E@ * m)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, m - 1 do
		local sr, si = 0, 0
		for j = 0, n - 1 do
			local k = @E@ * (j * m + i)
			local ar, ai = @READ@(a, k), @READ@(a, k + @W@)
			local xr, xi = @READ@(x, @E@ * j), @READ@(x, @E@ * j + @W@)
			sr += ar * xr - ai * xi
			si += ar * xi + ai * xr
		end
		@WRITE@(o, @E@ * i, sr)
		@WRITE@(o, @E@ * i + @W@, si)
	end
	return o
end

-- A B
local function matmul(out: Matrix?, A: Matrix, B: Matrix): Matrix
	local m, p, n = A.rows, A.cols, B.cols
	assert(B.rows == p, "matrix sizes do not match")
	local o = matoutput(out, m, n)
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	local a, b, c = A.data, B.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local sr, si = 0, 0
			for k = 0, p - 1 do
				local s, t = @E@ * (k * m + i), @E@ * (j * p + k)
				local ar, ai = @READ@(a, s), @READ@(a, s + @W@)
				local br, bi = @READ@(b, t), @READ@(b, t + @W@)
				sr += ar * br - ai * bi
				si += ar * bi + ai * br
			end
			@WRITE@(c, @E@ * (j * m + i), sr)
			@WRITE@(c, @E@ * (j * m + i) + @W@, si)
		end
	end
	return o
end

-- LU factorization with partial pivoting (pivots chosen by |re| + |im|), in place: A is
-- overwritten with L and U (see types.LU) and returned as F.lu. lu_copy leaves A unchanged.
local function lu(A: Matrix): LU
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local piv = table.create(n, 0)
	local sign = 1
	local singular = false
	for k = 0, n - 1 do
		local p, best = k, -1
		for i = k, n - 1 do
			local off = @E@ * (k * n + i)
			local v = math.abs(@READ@(a, off)) + math.abs(@READ@(a, off + @W@))
			if v > best then
				p, best = i, v
			end
		end
		piv[k + 1] = p + 1
		if p ~= k then
			sign = -sign
			for j = 0, n - 1 do
				local s, t = @E@ * (j * n + k), @E@ * (j * n + p)
				local tr, ti = @READ@(a, s), @READ@(a, s + @W@)
				@WRITE@(a, s, @READ@(a, t))
				@WRITE@(a, s + @W@, @READ@(a, t + @W@))
				@WRITE@(a, t, tr)
				@WRITE@(a, t + @W@, ti)
			end
		end
		local pr, pi = @READ@(a, @E@ * (k * n + k)), @READ@(a, @E@ * (k * n + k) + @W@)
		if pr == 0 and pi == 0 then
			singular = true
		else
			for i = k + 1, n - 1 do
				local off = @E@ * (k * n + i)
				local qr, qi = complex64.div(@READ@(a, off), @READ@(a, off + @W@), pr, pi)
				@WRITE@(a, off, qr)
				@WRITE@(a, off + @W@, qi)
			end
			for j = k + 1, n - 1 do
				local s = @E@ * (j * n + k)
				local br, bi = @READ@(a, s), @READ@(a, s + @W@)
				for i = k + 1, n - 1 do
					local off, l = @E@ * (j * n + i), @E@ * (k * n + i)
					local lr, li = @READ@(a, l), @READ@(a, l + @W@)
					@WRITE@(a, off, @READ@(a, off) - (lr * br - li * bi))
					@WRITE@(a, off + @W@, @READ@(a, off + @W@) - (lr * bi + li * br))
				end
			end
		end
	end
	return { lu = A, piv = piv, sign = sign, singular = singular }
end

-- LU factorization of a copy of A; A is not modified.
local function lu_copy(A: Matrix): LU
	return lu(matcopy(nil, A))
end

-- Solves A x = b given F = lu(A).
local function lu_solve(out: buffer?, F: LU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.lu.rows
	assert(buffer.len(b) == @E@ * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a, piv = F.lu.data, F.piv
	for k = 0, n - 1 do
		local p = piv[k + 1] - 1
		if p ~= k then
			local s, t = @E@ * k, @E@ * p
			local tr, ti = @READ@(o, s), @READ@(o, s + @W@)
			@WRITE@(o, s, @READ@(o, t))
			@WRITE@(o, s + @W@, @READ@(o, t + @W@))
			@WRITE@(o, t, tr)
			@WRITE@(o, t + @W@, ti)
		end
	end
	for j = 0, n - 1 do
		local xr, xi = @READ@(o, @E@ * j), @READ@(o, @E@ * j + @W@)
		for i = j + 1, n - 1 do
			local off, l = @E@ * i, @E@ * (j * n + i)
			local lr, li = @READ@(a, l), @READ@(a, l + @W@)
			@WRITE@(o, off, @READ@(o, off) - (lr * xr - li * xi))
			@WRITE@(o, off + @W@, @READ@(o, off + @W@) - (lr * xi + li * xr))
		end
	end
	for j = n - 1, 0, -1 do
		local d = @E@ * (j * n + j)
		local xr, xi = complex64.div(@READ@(o, @E@ * j), @READ@(o, @E@ * j + @W@), @READ@(a, d), @READ@(a, d + @W@))
		@WRITE@(o, @E@ * j, xr)
		@WRITE@(o, @E@ * j + @W@, xi)
		for i = 0, j - 1 do
			local off, u = @E@ * i, @E@ * (j * n + i)
			local ur, ui = @READ@(a, u), @READ@(a, u + @W@)
			@WRITE@(o, off, @READ@(o, off) - (ur * xr - ui * xi))
			@WRITE@(o, off + @W@, @READ@(o, off + @W@) - (ur * xi + ui * xr))
		end
	end
	return o
end

local function det_pair(A: Matrix): (number, number)
	local F = lu_copy(A)
	local dr, di = F.sign, 0
	local n = A.rows
	for k = 0, n - 1 do
		local off = @E@ * (k * n + k)
		dr, di = complex64.mul(dr, di, @READ@(F.lu.data, off), @READ@(F.lu.data, off + @W@))
	end
	return dr, di
end

-- Cholesky

-- Cholesky factorization A = L L^H of a Hermitian positive definite matrix, in place:
-- the lower triangle of A is overwritten with L (whose diagonal is real) and returned as
-- F.chol. Only the lower triangle of A is read, and only the real parts of its diagonal;
-- the strictly upper triangle is left as it was. If A is not positive definite,
-- F.definite is false and A is partly overwritten. chol_copy leaves A unchanged.
local function chol(A: Matrix): Cholesky
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	for j = 0, n - 1 do
		local diag = @E@ * (j * n + j)
		local d = @READ@(a, diag)
		if not (d > 0) then
			return { chol = A, definite = false }
		end
		local ljj = math.sqrt(d)
		@WRITE@(a, diag, ljj)
		@WRITE@(a, diag + @W@, 0)
		for i = j + 1, n - 1 do
			local off = @E@ * (j * n + i)
			@WRITE@(a, off, @READ@(a, off) / ljj)
			@WRITE@(a, off + @W@, @READ@(a, off + @W@) / ljj)
		end
		-- Subtract the new column's outer product, l l^H, from the trailing lower triangle.
		for c = j + 1, n - 1 do
			local s = @E@ * (j * n + c)
			-- conj(L[c, j])
			local cr, ci = @READ@(a, s), -@READ@(a, s + @W@)
			for i = c, n - 1 do
				local off, l = @E@ * (c * n + i), @E@ * (j * n + i)
				local lr, li = @READ@(a, l), @READ@(a, l + @W@)
				@WRITE@(a, off, @READ@(a, off) - (lr * cr - li * ci))
				@WRITE@(a, off + @W@, @READ@(a, off + @W@) - (lr * ci + li * cr))
			end
		end
	end
	return { chol = A, definite = true }
end

-- Cholesky factorization of a copy of A; A is not modified.
local function chol_copy(A: Matrix): Cholesky
	return chol(matcopy(nil, A))
end

-- The lower triangular factor L, with zeros above the diagonal.
local function chol_l(out: Matrix?, F: Cholesky): Matrix
	local n = F.chol.rows
	local o = matoutput(out, n, n)
	local a, l = F.chol.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = @E@ * (j * n + i)
			if i >= j then
				@WRITE@(l, off, @READ@(a, off))
				@WRITE@(l, off + @W@, @READ@(a, off + @W@))
			else
				@WRITE@(l, off, 0)
				@WRITE@(l, off + @W@, 0)
			end
		end
	end
	return o
end

-- Solves A x = b given F = chol(A). b is not modified unless it is passed as out.
local function chol_solve(out: buffer?, F: Cholesky, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local n = F.chol.rows
	assert(buffer.len(b) == @E@ * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = F.chol.data
	-- L y = b (the diagonal of L is real)
	for j = 0, n - 1 do
		local d = @READ@(a, @E@ * (j * n + j))
		local yr, yi = @READ@(o, @E@ * j) / d, @READ@(o, @E@ * j + @W@) / d
		@WRITE@(o, @E@ * j, yr)
		@WRITE@(o, @E@ * j + @W@, yi)
		for i = j + 1, n - 1 do
			local off, l = @E@ * i, @E@ * (j * n + i)
			local lr, li = @READ@(a, l), @READ@(a, l + @W@)
			@WRITE@(o, off, @READ@(o, off) - (lr * yr - li * yi))
			@WRITE@(o, off + @W@, @READ@(o, off + @W@) - (lr * yi + li * yr))
		end
	end
	-- L^H x = y, a conjugated dot product down each column of L.
	for j = n - 1, 0, -1 do
		local sr, si = @READ@(o, @E@ * j), @READ@(o, @E@ * j + @W@)
		for i = j + 1, n - 1 do
			local l = @E@ * (j * n + i)
			local lr, li = @READ@(a, l), @READ@(a, l + @W@)
			local xr, xi = @READ@(o, @E@ * i), @READ@(o, @E@ * i + @W@)
			sr -= lr * xr + li * xi
			si -= lr * xi - li * xr
		end
		local d = @READ@(a, @E@ * (j * n + j))
		@WRITE@(o, @E@ * j, sr / d)
		@WRITE@(o, @E@ * j + @W@, si / d)
	end
	return o
end

-- Householder QR

-- Unit roundoff of the storage precision.
local EPS = @EPS@

-- Applies I - t v v^H, t = tr + i ti, to the `len` values of x starting at byte offset
-- `xs`. v starts at byte offset `vs` of `a`; its first entry is an implicit 1.
local function reflect(a: buffer, vs: number, len: number, tr: number, ti: number, x: buffer, xs: number)
	local wr, wi = @READ@(x, xs), @READ@(x, xs + @W@)
	for i = 1, len - 1 do
		local v, y = vs + @E@ * i, xs + @E@ * i
		local vr, vi = @READ@(a, v), @READ@(a, v + @W@)
		local yr, yi = @READ@(x, y), @READ@(x, y + @W@)
		wr += vr * yr + vi * yi
		wi += vr * yi - vi * yr
	end
	if wr == 0 and wi == 0 then
		return
	end
	wr, wi = tr * wr - ti * wi, tr * wi + ti * wr
	@WRITE@(x, xs, @READ@(x, xs) - wr)
	@WRITE@(x, xs + @W@, @READ@(x, xs + @W@) - wi)
	for i = 1, len - 1 do
		local v, y = vs + @E@ * i, xs + @E@ * i
		local vr, vi = @READ@(a, v), @READ@(a, v + @W@)
		@WRITE@(x, y, @READ@(x, y) - (wr * vr - wi * vi))
		@WRITE@(x, y + @W@, @READ@(x, y + @W@) - (wr * vi + wi * vr))
	end
end

-- Turns the `len` values of `a` starting at byte offset `diag` into a Householder
-- reflector, in place: the real beta at `diag` and v below it (its leading 1 is
-- implicit). Stores tau as element k of `tau` and returns it; tau = 0 (H = I) when the
-- value at `diag` is already real and there is nothing below it to zero.
local function householder(a: buffer, diag: number, len: number, tau: buffer, k: number): (number, number)
	local ar, ai = @READ@(a, diag), @READ@(a, diag + @W@)
	local xnorm = segment_norm(a, diag + @E@, 2 * (len - 1))
	if xnorm == 0 and ai == 0 then
		@WRITE@(tau, @E@ * k, 0)
		@WRITE@(tau, @E@ * k + @W@, 0)
		return 0, 0
	end
	local beta = hypot3(ar, ai, xnorm)
	if ar >= 0 then
		beta = -beta
	end
	@WRITE@(tau, @E@ * k, (beta - ar) / beta)
	@WRITE@(tau, @E@ * k + @W@, -ai / beta)
	-- Re(alpha) and beta have opposite signs, so alpha - beta cannot cancel.
	local dr = ar - beta
	for off = diag + @E@, diag + @E@ * (len - 1), @E@ do
		local vr, vi = complex64.div(@READ@(a, off), @READ@(a, off + @W@), dr, ai)
		@WRITE@(a, off, vr)
		@WRITE@(a, off + @W@, vi)
	end
	@WRITE@(a, diag, beta)
	@WRITE@(a, diag + @W@, 0)
	return @READ@(tau, @E@ * k), @READ@(tau, @E@ * k + @W@)
end

-- Solves R z = y in place on the first r entries of y, where R is the leading r by r
-- block of the upper triangle stored in `a` (a matrix with m rows).
local function back_substitute(a: buffer, m: number, r: number, y: buffer)
	for j = r - 1, 0, -1 do
		local d = @E@ * (j * m + j)
		local rr, ri = @READ@(a, d), @READ@(a, d + @W@)
		assert(rr ~= 0 or ri ~= 0, "matrix is rank deficient")
		local yr, yi = complex64.div(@READ@(y, @E@ * j), @READ@(y, @E@ * j + @W@), rr, ri)
		@WRITE@(y, @E@ * j, yr)
		@WRITE@(y, @E@ * j + @W@, yi)
		for i = 0, j - 1 do
			local off, u = @E@ * i, @E@ * (j * m + i)
			local ur, ui = @READ@(a, u), @READ@(a, u + @W@)
			@WRITE@(y, off, @READ@(y, off) - (ur * yr - ui * yi))
			@WRITE@(y, off + @W@, @READ@(y, off + @W@) - (ur * yi + ui * yr))
		end
	end
end

-- Householder QR factorization, in place: A is overwritten (see types.QR for the layout)
-- and returned as F.qr. The diagonal of R is real. qr_copy leaves A unchanged.
local function qr(A: Matrix): QR
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(@E@ * kmax)
	for k = 0, kmax - 1 do
		local diag = @E@ * (k * m + k)
		local tr, ti = householder(a, diag, m - k, tau, k)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, @E@ * (j * m + k))
			end
		end
	end
	return { qr = A, tau = tau }
end

-- Householder QR factorization of a copy of A; A is not modified.
local function qr_copy(A: Matrix): QR
	return qr(matcopy(nil, A))
end

-- x := Q^H x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_qh(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == @E@ * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = 0, buffer.len(tau) // @E@ - 1 do
		local tr, ti = @READ@(tau, @E@ * k), @READ@(tau, @E@ * k + @W@)
		reflect(a, @E@ * (k * m + k), m - k, tr, -ti, x, @E@ * k)
	end
	return x
end

-- x := Q x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_q(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == @E@ * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = buffer.len(tau) // @E@ - 1, 0, -1 do
		local tr, ti = @READ@(tau, @E@ * k), @READ@(tau, @E@ * k + @W@)
		reflect(a, @E@ * (k * m + k), m - k, tr, ti, x, @E@ * k)
	end
	return x
end

-- The min(rows, cols) by cols upper triangular factor R. Also accepts a QRP factorization.
local function qr_r(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, kmax, n)
	local a, r = F.qr.data, o.data
	for j = 0, n - 1 do
		for i = 0, kmax - 1 do
			local s, t = @E@ * (j * m + i), @E@ * (j * kmax + i)
			if i <= j then
				@WRITE@(r, t, @READ@(a, s))
				@WRITE@(r, t + @W@, @READ@(a, s + @W@))
			else
				@WRITE@(r, t, 0)
				@WRITE@(r, t + @W@, 0)
			end
		end
	end
	return o
end

-- The rows by min(rows, cols) factor Q with orthonormal columns (the thin Q). Also
-- accepts a QRP factorization.
local function qr_q(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, m, kmax)
	local a, tau, q = F.qr.data, F.tau, o.data
	buffer.fill(q, 0, 0)
	for c = 0, kmax - 1 do
		@WRITE@(q, @E@ * (c * m + c), 1)
		-- Reflectors after column c leave the unit vector e_c unchanged.
		for k = c, 0, -1 do
			local tr, ti = @READ@(tau, @E@ * k), @READ@(tau, @E@ * k + @W@)
			reflect(a, @E@ * (k * m + k), m - k, tr, ti, q, @E@ * (c * m + k))
		end
	end
	return o
end

-- Least squares: the x minimizing |A x - b| for A with rows >= cols and full column
-- rank, given F = qr(A). b is not modified. Also returns the residual norm |A x - b|.
local function qr_solve(out: buffer?, F: QR, b: buffer): (buffer, number)
	local m, n = F.qr.rows, F.qr.cols
	assert(m >= n, "least squares needs at least as many rows as columns")
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, n, y)
	local o = output(out, @E@ * n)
	buffer.copy(o, 0, y, 0, @E@ * n)
	return o, segment_norm(y, @E@ * n, 2 * (m - n))
end

-- Column-pivoted QR

-- Householder QR with column pivoting, A P = Q R, in place: A is overwritten as in qr and
-- returned as F.qr; column j of A P is column perm[j] of A. Each step moves the remaining
-- column of largest norm to the front, so |R_11| >= |R_22| >= ... and small trailing
-- diagonal entries reveal the numerical rank. qrp_copy leaves A unchanged.
local function qrp(A: Matrix): QRP
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(@E@ * kmax)
	local perm = table.create(n, 0)
	-- Norms of the unfactored part of each column (partial), and the norm at the last
	-- recomputation (reference), for LAPACK's safeguarded downdating.
	local partial, reference = table.create(n, 0), table.create(n, 0)
	for j = 1, n do
		perm[j] = j
		local v = segment_norm(a, @E@ * (j - 1) * m, 2 * m)
		partial[j], reference[j] = v, v
	end
	local recompute = math.sqrt(EPS)
	for k = 0, kmax - 1 do
		local p, best = k, -1
		for j = k, n - 1 do
			if partial[j + 1] > best then
				p, best = j, partial[j + 1]
			end
		end
		if p ~= k then
			for i = 0, m - 1 do
				local s, t = @E@ * (k * m + i), @E@ * (p * m + i)
				local sr, si = @READ@(a, s), @READ@(a, s + @W@)
				@WRITE@(a, s, @READ@(a, t))
				@WRITE@(a, s + @W@, @READ@(a, t + @W@))
				@WRITE@(a, t, sr)
				@WRITE@(a, t + @W@, si)
			end
			perm[k + 1], perm[p + 1] = perm[p + 1], perm[k + 1]
			partial[p + 1], reference[p + 1] = partial[k + 1], reference[k + 1]
		end

		local diag = @E@ * (k * m + k)
		local tr, ti = householder(a, diag, m - k, tau, k)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, @E@ * (j * m + k))
			end
		end

		-- Remove row k from the remaining partial norms. When cancellation would leave too
		-- few correct digits, recompute the norm instead.
		for j = k + 1, n - 1 do
			local v = partial[j + 1]
			if v ~= 0 then
				local off = @E@ * (j * m + k)
				local ratio = complex64.abs(@READ@(a, off), @READ@(a, off + @W@)) / v
				local left = math.max(0, 1 - ratio * ratio)
				local drift = v / reference[j + 1]
				if left * drift * drift <= recompute then
					local fresh = segment_norm(a, off + @E@, 2 * (m - k - 1))
					partial[j + 1], reference[j + 1] = fresh, fresh
				else
					partial[j + 1] = v * math.sqrt(left)
				end
			end
		end
	end
	return { qr = A, tau = tau, perm = perm }
end

-- Column-pivoted QR of a copy of A; A is not modified.
local function qrp_copy(A: Matrix): QRP
	return qrp(matcopy(nil, A))
end

-- Numerical rank: the number of leading diagonal entries of R with |R_kk| > tol |R_11|.
-- The default tol is max(rows, cols) times the unit roundoff of the storage precision.
local function qrp_rank(F: QRP, tol: number?): number
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	if kmax == 0 then
		return 0
	end
	local a = F.qr.data
	local limit = (tol or math.max(m, n) * EPS) * complex64.abs(@READ@(a, 0), @READ@(a, @W@))
	for k = 0, kmax - 1 do
		local d = @E@ * (k * m + k)
		if not (complex64.abs(@READ@(a, d), @READ@(a, d + @W@)) > limit) then
			return k
		end
	end
	return kmax
end

-- Least squares for any shape and rank, given F = qrp(A): the basic solution, which
-- uses only the first r = qrp_rank(F, tol) pivot columns and sets the other variables
-- to zero. b is not modified. Also returns the residual norm |A x - b| and r.
local function qrp_solve(out: buffer?, F: QRP, b: buffer, tol: number?): (buffer, number, number)
	local m, n = F.qr.rows, F.qr.cols
	local r = qrp_rank(F, tol)
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, r, y)
	local o = output(out, @E@ * n)
	buffer.fill(o, 0, 0)
	for j = 1, r do
		local s, t = @E@ * (j - 1), @E@ * (F.perm[j] - 1)
		@WRITE@(o, t, @READ@(y, s))
		@WRITE@(o, t + @W@, @READ@(y, s + @W@))
	end
	return o, segment_norm(y, @E@ * r, 2 * (m - r)), r
end

-- Functions taking or returning complex scalars. The *_pair functions above pass them
-- as (re, im) number pairs; each type exports them in its own scalar format.

--@c64 local function get(x: buffer, i: number): (number, number)
--@c64 	local k = @E@ * (i - 1)
--@c64 	return @READ@(x, k), @READ@(x, k + @W@)
--@c64 end
--@c64
--@c64 local function set(x: buffer, i: number, re: number, im: number)
--@c64 	local k = @E@ * (i - 1)
--@c64 	@WRITE@(x, k, re)
--@c64 	@WRITE@(x, k + @W@, im)
--@c64 end
--@c64
--@c64 local function matget(A: Matrix, i: number, j: number): (number, number)
--@c64 	local k = @E@ * ((j - 1) * A.rows + i - 1)
--@c64 	return @READ@(A.data, k), @READ@(A.data, k + @W@)
--@c64 end
--@c64
--@c64 local function matset(A: Matrix, i: number, j: number, re: number, im: number)
--@c64 	local k = @E@ * ((j - 1) * A.rows + i - 1)
--@c64 	@WRITE@(A.data, k, re)
--@c64 	@WRITE@(A.data, k + @W@, im)
--@c64 end
--@c64
--@c64 local fill = fill_pair
--@c64 local cscale = cscale_pair
--@c64 local caxpy = caxpy_pair
--@c64 local dot = dotu_pair
--@c64 local dotc = dotc_pair
--@c64 local sum = sum_pair
--@c64 local det = det_pair
--@c32 local function get(x: buffer, i: number): vector
--@c32 	local k = @E@ * (i - 1)
--@c32 	return vector.create(@READ@(x, k), @READ@(x, k + @W@), 0)
--@c32 end
--@c32
--@c32 local function set(x: buffer, i: number, z: vector)
--@c32 	local k = @E@ * (i - 1)
--@c32 	@WRITE@(x, k, z.x)
--@c32 	@WRITE@(x, k + @W@, z.y)
--@c32 end
--@c32
--@c32 local function matget(A: Matrix, i: number, j: number): vector
--@c32 	local k = @E@ * ((j - 1) * A.rows + i - 1)
--@c32 	return vector.create(@READ@(A.data, k), @READ@(A.data, k + @W@), 0)
--@c32 end
--@c32
--@c32 local function matset(A: Matrix, i: number, j: number, z: vector)
--@c32 	local k = @E@ * ((j - 1) * A.rows + i - 1)
--@c32 	@WRITE@(A.data, k, z.x)
--@c32 	@WRITE@(A.data, k + @W@, z.y)
--@c32 end
--@c32
--@c32 local function fill(out: buffer, z: vector): buffer
--@c32 	return fill_pair(out, z.x, z.y)
--@c32 end
--@c32
--@c32 local function cscale(out: buffer?, a: vector, x: buffer): buffer
--@c32 	return cscale_pair(out, a.x, a.y, x)
--@c32 end
--@c32
--@c32 local function caxpy(out: buffer?, a: vector, x: buffer, y: buffer): buffer
--@c32 	return caxpy_pair(out, a.x, a.y, x, y)
--@c32 end
--@c32
--@c32 local function dot(x: buffer, y: buffer): vector
--@c32 	return vector.create(dotu_pair(x, y))
--@c32 end
--@c32
--@c32 local function dotc(x: buffer, y: buffer): vector
--@c32 	return vector.create(dotc_pair(x, y))
--@c32 end
--@c32
--@c32 local function sum(x: buffer): vector
--@c32 	return vector.create(sum_pair(x))
--@c32 end
--@c32
--@c32 local function det(A: Matrix): vector
--@c32 	return vector.create(det_pair(A))
--@c32 end

--@include solve.luau.in

local space: types.Space<buffer> = {
	similar = similar,
	copy = copy,
	add = add,
	sub = sub,
	scale = scale,
	axpy = axpy,
	norm = norm,
}

return {
	space = space,

	create = create,
	length = length,
	similar = similar,
	from = from,
	totable = totable,
	get = get,
	set = set,
	fill = fill,
	copy = copy,

	complexify = complexify,
	real = real,
	imag = imag,
	abs = abs,
	conj = conj,

	add = add,
	sub = sub,
	mul = mul,
	scale = scale,
	axpy = axpy,
	cscale = cscale,
	caxpy = caxpy,

	dot = dot,
	dotc = dotc,
	sum = sum,
	amax = amax,
	norm = norm,

	matrix = matrix,
	matfrom = matfrom,
	mattotable = mattotable,
	identity = identity,
	matget = matget,
	matset = matset,
	matcopy = matcopy,

	transpose = transpose,
	adjoint = adjoint,
	matvec = matvec,
	matmul = matmul,

	lu = lu,
	lu_copy = lu_copy,
	lu_solve = lu_solve,
	solve = solve,
	det = det,

	chol = chol,
	chol_copy = chol_copy,
	chol_l = chol_l,
	chol_solve = chol_solve,

	qr = qr,
	qr_copy = qr_copy,
	qr_apply_q = qr_apply_q,
	qr_apply_qh = qr_apply_qh,
	qr_q = qr_q,
	qr_r = qr_r,
	qr_solve = qr_solve,

	qrp = qrp,
	qrp_copy = qrp_copy,
	qrp_rank = qrp_rank,
	qrp_solve = qrp_solve,
}
