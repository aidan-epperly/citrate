--!strict
--!native
--!optimize 2
-- Generated by tools/generate.py from templates/complex/gemm.luau.in. Edit the template, not this file.

-- @NAME@ matrix products (matmul, gemm), by register-blocked kernels.
-- Indices are 1-based; arithmetic is done in double precision and rounded once per stored
-- value; every `out` argument may be nil, in which case a new result is allocated.

local types = require("./types")

--@include complex/prelude.luau.in

--@include kernels/gemm_complex.luau.in

-- Packing scratch, two slots (op(A) and op(B)), reused across calls and grown as needed:
-- a product then allocates only its result. Weak, so an idle scratch is collected.
local packs: { [number]: buffer } = setmetatable({}, { __mode = "v" }) :: any
local function scratch(slot: number, bytes: number): buffer
	local b = packs[slot]
	if b == nil or buffer.len(b) < bytes then
		b = buffer.create(bytes)
		packs[slot] = b
	end
	return b
end

-- The rows of A (m by p, column-major) laid out contiguously, in scratch slot: element
-- i * p + k is A[i, k] (conjugated when conj is set).
local function pack_rows(A: Matrix, slot: number, conj: boolean?): buffer
	local m, p = A.rows, A.cols
	local a = A.data
	local R = scratch(slot, @E@ * m * p)
	local sign = if conj then -1 else 1
	for k = 0, p - 1 do
		for i = 0, m - 1 do
			local s, t = elem(i * p + k), elem(k * m + i)
			store(R, s, load(a, t))
			store(R, imag(s), sign * load(a, imag(t)))
		end
	end
	return R
end

-- out := A B (a new matrix if out is nil); see gemm for scaled and transposed products.
local function matmul(out: Matrix?, A: Matrix, B: Matrix): Matrix
	local m, p, n = A.rows, A.cols, B.cols
	assert(B.rows == p, "matrix sizes do not match")
	local o = matoutput(out, m, n)
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	-- B's columns are already contiguous; A's rows are packed.
	gemm_kernel(pack_rows(A, 1), B.data, o.data, m, p, n, 1, 0)
	return o
end

-- C := alpha op(A) op(B) + beta C (BLAS gemm) with real alpha and beta, where op is
-- "n" (as is), "t" (transposed) or "c" (conjugate transposed). C is new (or out) when
-- beta is 0 or nil. Sums run in double precision and each entry is rounded once.
local function gemm(C: Matrix?, alpha: number, A: Matrix, B: Matrix, beta: number?, opa: string?, opb: string?): Matrix
	local ta, tb = opa ~= nil and opa ~= "n", opb ~= nil and opb ~= "n"
	local m, kk = if ta then A.cols else A.rows, if ta then A.rows else A.cols
	local kb, n = if tb then B.cols else B.rows, if tb then B.rows else B.cols
	assert(kk == kb, "gemm: inner dimensions do not match")
	local b0 = beta or 0
	local o: Matrix
	if b0 == 0 then
		o = matoutput(C, m, n)
	else
		assert(C ~= nil and C.rows == m and C.cols == n, "gemm: beta needs a C of the right shape")
		o = C
	end
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	-- The kernel wants op(A)'s rows and op(B)'s columns contiguous: A^T's rows are A's
	-- columns and B's columns are as stored; the others are packed, and A^H's rows are
	-- A's columns conjugated.
	local R: buffer
	if not ta then
		R = pack_rows(A, 1)
	elseif opa == "c" then
		-- A's columns are A^H's rows: conjugated, in the scratch
		local a = A.data
		R = scratch(1, buffer.len(a))
		for q = 0, buffer.len(a) - elem(1), elem(1) do
			store(R, q, load(a, q))
			store(R, imag(q), -load(a, imag(q)))
		end
	else
		R = A.data
	end
	local Q: buffer
	if not tb then
		Q = B.data
	elseif opb == "c" then
		Q = pack_rows(B, 2, true)
	else
		Q = pack_rows(B, 2)
	end
	gemm_kernel(R, Q, o.data, m, kk, n, alpha, b0)
	return o
end

return {
	gemm = gemm,
	matmul = matmul,
}
