-- The sum of the diagonal, as (re, im).
local function trace_pair(A: Matrix): (number, number)
	local sr, si = 0, 0
	for i = 0, math.min(A.rows, A.cols) - 1 do
		local r, m = cread(A.data, i * A.rows + i)
		sr += r
		si += m
	end
	return sr, si
end

-- The diagonal (min(rows, cols) entries), as an array.
local function diag(out: buffer?, A: Matrix): buffer
	local n = math.min(A.rows, A.cols)
	local o = output(out, @E@ * n)
	for i = 0, n - 1 do
		cwrite(o, i, cread(A.data, i * A.rows + i))
	end
	return o
end

-- The square matrix with the array x on its diagonal.
local function diagm(x: buffer): Matrix
	local n = length(x)
	local D = matrix(n, n)
	for i = 0, n - 1 do
		cwrite(D.data, i * n + i, cread(x, i))
	end
	return D
end

-- The Kronecker product: the block matrix [a_ij B].
local function kron(A: Matrix, B: Matrix): Matrix
	local m, n, p, q = A.rows, A.cols, B.rows, B.cols
	local K = matrix(m * p, n * q)
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local ar, ai = cread(A.data, j * m + i)
			if ar ~= 0 or ai ~= 0 then
				for l = 0, q - 1 do
					local col = (j * q + l) * m * p + i * p
					for r = 0, p - 1 do
						local br, bi = cread(B.data, l * p + r)
						cwrite(K.data, col + r, ar * br - ai * bi, ar * bi + ai * br)
					end
				end
			end
		end
	end
	return K
end

-- The outer product x y^H.
local function outer(out: Matrix?, x: buffer, y: buffer): Matrix
	local m, n = length(x), length(y)
	local o = matoutput(out, m, n)
	for j = 0, n - 1 do
		local yr, yi = cread(y, j)
		yi = -yi
		for i = 0, m - 1 do
			local xr, xi = cread(x, i)
			cwrite(o.data, j * m + i, xr * yr - xi * yi, xr * yi + xi * yr)
		end
	end
	return o
end

-- The rank-one update A := A + a x y^H with real a, in place (BLAS gerc); returns A.
local function ger(A: Matrix, a: number, x: buffer, y: buffer): Matrix
	local m, n = A.rows, A.cols
	assert(length(x) == m and length(y) == n, "ger: sizes do not match")
	for j = 0, n - 1 do
		local yr, yi = cread(y, j)
		local fr, fi = a * yr, -a * yi
		if fr ~= 0 or fi ~= 0 then
			for i = 0, m - 1 do
				local xr, xi = cread(x, i)
				local cr, ci = cread(A.data, j * m + i)
				cwrite(A.data, j * m + i, cr + xr * fr - xi * fi, ci + xr * fi + xi * fr)
			end
		end
	end
	return A
end

-- A^H x, without forming the adjoint.
local function matvec_adjoint(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(length(x) == m, "matvec_adjoint: sizes do not match")
	local o = output(out, @E@ * n)
	assert(o ~= x, "output cannot be the input vector")
	for j = 0, n - 1 do
		local sr, si = 0, 0
		for i = 0, m - 1 do
			local ar, ai = cread(A.data, j * m + i)
			local xr, xi = cread(x, i)
			sr += ar * xr + ai * xi
			si += ar * xi - ai * xr
		end
		cwrite(o, j, sr, si)
	end
	return o
end

