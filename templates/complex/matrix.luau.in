-- Generated by tools/generate.py from templates/complex/matrix.luau.in. Edit the template, not this file.

-- @NAME@ matrices (column-major): creation and access, transposes, matrix-vector
-- products, submatrices and other utilities.
-- Indices are 1-based; arithmetic is done in double precision and rounded once per stored
-- value; every `out` argument may be nil, in which case a new result is allocated.

local types = require("./types")

--@include complex/prelude.luau.in

-- Builds a matrix from tables of rows of the real and (optional) imaginary parts.
local function matfrom(re: { { number } }, im: { { number } }?): Matrix
	local rows = #re
	local cols = if rows > 0 then #re[1] else 0
	assert(im == nil or #im == rows, "real and imaginary parts have different shapes")
	local A = matrix(rows, cols)
	for i = 1, rows do
		local row = re[i]
		assert(#row == cols, "rows have different lengths")
		local irow = if im then im[i] else nil
		assert(irow == nil or #irow == cols, "real and imaginary parts have different shapes")
		for j = 1, cols do
			local k = @E@ * ((j - 1) * rows + i - 1)
			@WRITE@(A.data, k, row[j])
			if irow then
				@WRITE@(A.data, k + @W@, irow[j])
			end
		end
	end
	return A
end

-- Returns tables of rows of the real and imaginary parts.
local function mattotable(A: Matrix): ({ { number } }, { { number } })
	local re, im = table.create(A.rows) :: { { number } }, table.create(A.rows) :: { { number } }
	for i = 1, A.rows do
		local rrow, irow = table.create(A.cols, 0), table.create(A.cols, 0)
		for j = 1, A.cols do
			local k = @E@ * ((j - 1) * A.rows + i - 1)
			rrow[j] = @READ@(A.data, k)
			irow[j] = @READ@(A.data, k + @W@)
		end
		re[i], im[i] = rrow, irow
	end
	return re, im
end

-- The n by n identity matrix.
local function identity(n: number): Matrix
	local A = matrix(n, n)
	for i = 0, n - 1 do
		@WRITE@(A.data, @E@ * (i * n + i), 1)
	end
	return A
end

-- out := A (a new matrix if out is nil).
local function matcopy(out: Matrix?, A: Matrix): Matrix
	local o = matoutput(out, A.rows, A.cols)
	if o.data ~= A.data then
		buffer.copy(o.data, 0, A.data)
	end
	return o
end

local function transpose_impl(out: Matrix?, A: Matrix, sign: number): Matrix
	local m, n = A.rows, A.cols
	local o = matoutput(out, n, m)
	assert(o.data ~= A.data, "transpose cannot be done in place")
	local a, d = A.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local s, t = @E@ * (j * m + i), @E@ * (i * n + j)
			@WRITE@(d, t, @READ@(a, s))
			@WRITE@(d, t + @W@, sign * @READ@(a, s + @W@))
		end
	end
	return o
end

-- out := A^T (a new matrix if out is nil); see adjoint for A^H.
local function transpose(out: Matrix?, A: Matrix): Matrix
	return transpose_impl(out, A, 1)
end

-- Conjugate transpose.
local function adjoint(out: Matrix?, A: Matrix): Matrix
	return transpose_impl(out, A, -1)
end

-- A x
local function matvec(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(buffer.len(x) == @E@ * n, "matrix and vector sizes do not match")
	local o = output(out, @E@ * m)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, m - 1 do
		local sr, si = 0, 0
		for j = 0, n - 1 do
			local k = @E@ * (j * m + i)
			local ar, ai = @READ@(a, k), @READ@(a, k + @W@)
			local xr, xi = @READ@(x, @E@ * j), @READ@(x, @E@ * j + @W@)
			sr += ar * xr - ai * xi
			si += ar * xi + ai * xr
		end
		@WRITE@(o, @E@ * i, sr)
		@WRITE@(o, @E@ * i + @W@, si)
	end
	return o
end
