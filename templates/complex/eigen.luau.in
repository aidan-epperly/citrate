-- Hessenberg reduction and Hermitian eigenvalues

-- Reals per matrix entry, for the shared tridiagonal eigensolver.
local PARTS = 2

--@include shared/tridiagonal_eigen.luau.in

-- In place, LAPACK's ung2r: the `count` reflectors stored below the diagonal of the first
-- columns of the `rows` by `cols` block at (r0, r0) of the matrix in `a` (leading
-- dimension ld, with their tau values in `tau`) are replaced by the first `cols` columns
-- of the block's Q = H_1 ... H_count.
local function form_q(a: buffer, ld: number, r0: number, rows: number, cols: number, count: number, tau: buffer)
	--@inline
	local function at(i: number, j: number): number
		return @E@ * ((r0 + j) * ld + r0 + i)
	end
	for j = count, cols - 1 do
		for i = 0, rows - 1 do
			cstore(a, at(i, j), if i == j then 1 else 0, 0)
		end
	end
	for i = count - 1, 0, -1 do
		local tr, ti = cload(tau, elem(i))
		for j = i + 1, cols - 1 do
			reflect(a, at(i, i), rows - i, tr, ti, a, at(i, j))
		end
		for r = i + 1, rows - 1 do
			local off = at(r, i)
			local vr, vi = cload(a, off)
			cstore(a, off, -(tr * vr - ti * vi), -(tr * vi + ti * vr))
		end
		cstore(a, at(i, i), 1 - tr, -ti)
		for r = 0, i - 1 do
			cstore(a, at(r, i), 0, 0)
		end
	end
end

-- Forms in place the n by n Q = H_0 ... H_count-1 of a Hessenberg or tridiagonal
-- reduction, whose reflector k acts on rows k+1.. and is stored below row k+1 of column k.
local function form_reduction_q(a: buffer, n: number, count: number, tau: buffer)
	if n == 0 then
		return
	end
	-- Move each reflector one column right, so that it sits below the diagonal of the
	-- trailing n-1 by n-1 block, where form_q expects it.
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	for k = count - 1, 0, -1 do
		for i = k + 2, n - 1 do
			local s = at(i, k)
			cstore(a, at(i, k + 1), load(a, s), load(a, imag(s)))
		end
	end
	for i = 0, n - 1 do
		local one = if i == 0 then 1 else 0
		cstore(a, at(i, 0), one, 0)
		cstore(a, at(0, i), one, 0)
	end
	form_q(a, n, 1, n - 1, n - 1, count, tau)
end

-- Hessenberg reduction restricted to rows and columns ilo..ihi (0-based), for a matrix
-- that is already upper triangular outside that block (as balancing leaves it): only
-- reflectors inside the block are made (tau = 0 elsewhere), but they are applied to the
-- whole matrix.
local function hess_range(A: Matrix, ilo: number, ihi: number): Hessenberg
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	local count = math.max(n - 2, 0)
	local tau = create(count)
	local wr, wi = table.create(n, 0), table.create(n, 0)
	for k = ilo, ihi - 2 do
		local vs = at(k + 1, k)
		local len = ihi - k
		local tr, ti = householder(a, vs, len, tau, k)
		if tr ~= 0 or ti ~= 0 then
			-- From the left, H^H: rows k+1.. of columns k+1..
			for j = k + 1, n - 1 do
				reflect(a, vs, len, tr, -ti, a, at(k + 1, j))
			end
			-- From the right: A := A - tau (A v) v^H on columns k+1..
			for i = 0, ihi do
				wr[i + 1], wi[i + 1] = cload(a, at(i, k + 1))
			end
			for c = 1, len - 1 do
				local vr, vi = cload(a, vs + elem(c))
				local col = at(0, k + 1 + c)
				for i = 0, ihi do
					local ar, ai = cload(a, col + elem(i))
					wr[i + 1] += ar * vr - ai * vi
					wi[i + 1] += ar * vi + ai * vr
				end
			end
			for c = 0, len - 1 do
				local vr, vi = 1, 0
				if c > 0 then
					vr, vi = cload(a, vs + elem(c))
				end
				-- tau conj(v_c)
				local fr, fi = tr * vr + ti * vi, ti * vr - tr * vi
				local col = at(0, k + 1 + c)
				for i = 0, ihi do
					local xr, xi = wr[i + 1], wi[i + 1]
					csub_at(a, col + elem(i), xr * fr - xi * fi, xr * fi + xi * fr)
				end
			end
		end
	end
	return { hess = A, tau = tau }
end

-- Upper Hessenberg reduction A = Q H Q^H (^T for real A), in place: A is overwritten with H
-- on and above the subdiagonal and, below it, the reflectors H_k = I - tau_k v_k v_k^H (v_k
-- has a 1 in row k+1, not stored, and is stored below that in column k).
-- Q = H_0 ... H_n-3. hess_copy leaves A unchanged.
local function hess(A: Matrix): Hessenberg
	return hess_range(A, 0, A.rows - 1)
end

-- Hessenberg reduction of a copy of A; A is not modified.
local function hess_copy(A: Matrix): Hessenberg
	return hess(matcopy(nil, A))
end

-- The upper Hessenberg factor H, with zeros below the subdiagonal.
local function hess_h(out: Matrix?, F: Hessenberg): Matrix
	local n = F.hess.rows
	local o = matoutput(out, n, n)
	local a, h = F.hess.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = elem(j * n + i)
			if i <= j + 1 then
				cstore(h, off, load(a, off), load(a, imag(off)))
			else
				cstore(h, off, 0, 0)
			end
		end
	end
	return o
end

-- The unitary factor Q.
local function hess_q(out: Matrix?, F: Hessenberg): Matrix
	local n = F.hess.rows
	local o = matcopy(out, F.hess)
	form_reduction_q(o.data, n, length(F.tau), F.tau)
	return o
end

-- Reduces the Hermitian matrix whose lower triangle is in A to real symmetric tridiagonal
-- form, A = Q T Q^H, in place (LAPACK's hetd2): returns T's diagonal d and off-diagonal e
-- as tables and leaves the reflectors (stored as in hess) and their tau in A and `tau`.
-- Only the real parts of the diagonal of A are read.
local function tridiagonalize(A: Matrix): ({ number }, { number }, buffer)
	local n = A.rows
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	local count = math.max(n - 1, 0)
	local tau = create(count)
	local d, e = table.create(n, 0), table.create(count, 0)
	local vr, vi = table.create(n, 0), table.create(n, 0)
	local xr, xi = table.create(n, 0), table.create(n, 0)
	for k = 0, count - 1 do
		local vs = at(k + 1, k)
		local len = n - k - 1
		local tr, ti = householder(a, vs, len, tau, k)
		e[k + 1] = load(a, vs)
		if tr ~= 0 or ti ~= 0 then
			vr[1], vi[1] = 1, 0
			for r = 1, len - 1 do
				vr[r + 1], vi[r + 1] = cload(a, vs + elem(r))
			end
			-- y = A22 v from the lower triangle of A22 = A[k+1.., k+1..] (real diagonal).
			for r = 1, len do
				xr[r], xi[r] = 0, 0
			end
			for c = 0, len - 1 do
				local col = at(k + 1, k + 1 + c)
				local cr, ci = vr[c + 1], vi[c + 1]
				local diag = load(a, col + elem(c))
				local accr, acci = diag * cr, diag * ci
				for r = c + 1, len - 1 do
					local ar, ai = cload(a, col + elem(r))
					-- A[r, c] v_c
					xr[r + 1] += ar * cr - ai * ci
					xi[r + 1] += ar * ci + ai * cr
					-- conj(A[r, c]) v_r
					local pr, pi = vr[r + 1], vi[r + 1]
					accr += ar * pr + ai * pi
					acci += ar * pi - ai * pr
				end
				xr[c + 1] += accr
				xi[c + 1] += acci
			end
			-- x = tau y, and x^H v
			local sr, si = 0, 0
			for r = 1, len do
				local yr, yi = xr[r], xi[r]
				xr[r], xi[r] = tr * yr - ti * yi, tr * yi + ti * yr
				sr += xr[r] * vr[r] + xi[r] * vi[r]
				si += xr[r] * vi[r] - xi[r] * vr[r]
			end
			-- w = x + alpha v with alpha = -(tau / 2) (x^H v)
			local alr, ali = -0.5 * (tr * sr - ti * si), -0.5 * (tr * si + ti * sr)
			for r = 1, len do
				local pr, pi = vr[r], vi[r]
				xr[r] += alr * pr - ali * pi
				xi[r] += alr * pi + ali * pr
			end
			-- A22 := A22 - v w^H - w v^H on the lower triangle; the diagonal stays real.
			for c = 0, len - 1 do
				local col = at(k + 1, k + 1 + c)
				local cvr, cvi, cwr, cwi = vr[c + 1], vi[c + 1], xr[c + 1], xi[c + 1]
				for r = c, len - 1 do
					local off = col + elem(r)
					local pr, pi, qr, qi = vr[r + 1], vi[r + 1], xr[r + 1], xi[r + 1]
					-- v_r conj(w_c) + w_r conj(v_c)
					local ur = pr * cwr + pi * cwi + qr * cvr + qi * cvi
					local ui = pi * cwr - pr * cwi + qi * cvr - qr * cvi
					store(a, off, load(a, off) - ur)
					store(a, imag(off), if r == c then 0 else load(a, imag(off)) - ui)
				end
			end
		end
		d[k + 1] = load(a, at(k, k))
	end
	if n > 0 then
		d[n] = load(a, at(n - 1, n - 1))
	end
	return d, e, tau
end

-- Eigenvalues (ascending, as a real array of the same precision) and, unless vectors is
-- false, orthonormal eigenvectors of a Hermitian matrix, in place: only the lower
-- triangle of A (and the real parts of its diagonal) is read, and A is overwritten with
-- the eigenvectors (column j belongs to values[j]), or with workspace if vectors is false.
-- Tridiagonalization, then implicit QR with Wilkinson shifts in double precision. If the
-- part read holds a NaN or an infinity, the values and A are all NaN. eigh_copy leaves A
-- unchanged.
local function eigh(A: Matrix, vectors: boolean?): Eigh
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local want = vectors ~= false
	-- Non-finite input (in the part that is read: the lower triangle without the imaginary
	-- parts of the diagonal) gives NaN values and a NaN A.
	for j = 0, n - 1 do
		local o = elem(j * n + j)
		if any_nonfinite(A.data, o, 1) or any_nonfinite(A.data, o + elem(1), 2 * (n - j - 1)) then
			local values = buffer.create(relem(n))
			fill_nan(values, 0, n)
			fill_nan(A.data, 0, 2 * n * n)
			return { values = values, vectors = if want then A else nil }
		end
	end
	-- Scaled into a safe range (see range_factor), by the part that is read; the values are
	-- scaled back and the vectors do not change.
	local big = 0
	for j = 0, n - 1 do
		big = math.max(big, math.abs(load(A.data, elem(j * n + j))))
		for i = j + 1, n - 1 do
			local o = elem(j * n + i)
			big = math.max(big, math.abs(load(A.data, o)), math.abs(load(A.data, imag(o))))
		end
	end
	local sc = range_factor(big)
	if sc ~= 1 then
		scale(A.data, sc, A.data)
	end
	local d, e, tau = tridiagonalize(A)
	if want then
		form_reduction_q(A.data, n, length(tau), tau)
	end
	tridiagonal_eigen(d, e, if want then A.data else nil, n)
	local values = buffer.create(relem(n))
	for i = 1, n do
		store(values, relem(i - 1), d[i] / sc)
	end
	return { values = values, vectors = if want then A else nil }
end

-- Hermitian eigendecomposition of a copy of A; A is not modified.
local function eigh_copy(A: Matrix, vectors: boolean?): Eigh
	return eigh(matcopy(nil, A), vectors)
end

-- Nonsymmetric eigenvalues

local function cabs1(re: number, im: number): number
	return math.abs(re) + math.abs(im)
end

-- A reflector I - tau v v^H, v = (1, v2), taking (alpha, x) to (beta, 0) with beta real.
-- Returns beta, tau and v2 (complex numbers as pairs).
local function small_reflector(ar: number, ai: number, xr: number, xi: number): (number, number, number, number, number)
	local xnorm = hypot3(xr, xi, 0)
	if xnorm == 0 and ai == 0 then
		return ar, 0, 0, 0, 0
	end
	local beta = hypot3(ar, ai, xnorm)
	if ar >= 0 then
		beta = -beta
	end
	local v2r, v2i = complex64.div(xr, xi, ar - beta, ai)
	return beta, (beta - ar) / beta, -ai / beta, v2r, v2i
end

-- Single-shift Francis QR (LAPACK's lahqr for complex matrices) on the upper Hessenberg
-- matrix in h (n by n, zero below the subdiagonal), in place. With wantt, h becomes the
-- upper triangular Schur form T. With z, the unitary transformations are accumulated
-- into its columns. Returns the eigenvalues (real and imaginary parts) in the order of
-- T's diagonal.
local function complex_schur(h: buffer, n: number, wantt: boolean, z: buffer?, ilo: number, ihi: number): ({ number }, { number })
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	--@inline
	-- Entry (i, j) of H as (re, im), its setter, and |re| + |im|.
	local function H(i: number, j: number): (number, number)
		return cload(h, at(i, j))
	end
	--@inline
	local function set(i: number, j: number, re: number, im: number)
		cstore(h, at(i, j), re, im)
	end
	--@inline
	local function habs(i: number, j: number): number
		return math.abs(load(h, at(i, j))) + math.abs(load(h, imag(at(i, j))))
	end
	local wr, wi = table.create(n, 0), table.create(n, 0)
	local ulp = 2 * EPS
	local smlnum = 2 ^ -1000 * (n / ulp)
	local itmax = 30 * math.max(10, n)
	local kdefl = 0
	-- Eigenvalues outside ilo..ihi were isolated by balancing: they are on the diagonal.
	for k = 0, n - 1 do
		if k < ilo or k > ihi then
			wr[k + 1], wi[k + 1] = H(k, k)
		end
	end
	local i = ihi
	while i >= ilo do
		local l = ilo
		local converged = false
		for _ = 0, itmax do
			-- Look for a negligible subdiagonal entry (Ahues and Tisseur's test).
			local k = i
			while k > l do
				local sub = habs(k, k - 1)
				if sub <= smlnum then
					break
				end
				local tst = habs(k - 1, k - 1) + habs(k, k)
				if tst == 0 then
					if k - 2 >= ilo then
						tst += habs(k - 1, k - 2)
					end
					if k + 1 <= ihi then
						tst += habs(k + 1, k)
					end
				end
				if sub <= ulp * tst then
					local sup = habs(k - 1, k)
					local ab, ba = math.max(sub, sup), math.min(sub, sup)
					local pr, pi = H(k - 1, k - 1)
					local qr, qi = H(k, k)
					local hkk, gap = cabs1(qr, qi), cabs1(pr - qr, pi - qi)
					local aa, bb = math.max(hkk, gap), math.min(hkk, gap)
					local s = aa + ab
					if ba * (ab / s) <= math.max(smlnum, ulp * (bb * (aa / s))) then
						break
					end
				end
				k -= 1
			end
			l = k
			if l > ilo then
				set(l, l - 1, 0, 0)
			end
			if l >= i then
				converged = true
				break
			end
			kdefl += 1
			local i1, i2 = if wantt then 0 else l, if wantt then n - 1 else i

			-- Shift: Wilkinson's (the eigenvalue of the trailing 2 by 2 block closer to the
			-- bottom corner), or an exceptional shift after 10 (top) or 20 (bottom)
			-- iterations without a deflation.
			local tr, ti
			if kdefl % 20 == 0 then
				local hr, hi = H(i, i)
				tr, ti = hr + 0.75 * habs(i, i - 1), hi
			elseif kdefl % 10 == 0 then
				local hr, hi = H(l, l)
				tr, ti = hr + 0.75 * habs(l + 1, l), hi
			else
				tr, ti = H(i, i)
				local br, bi = H(i - 1, i)
				local cr, ci = H(i, i - 1)
				-- (Separate locals: only the last argument of a call expands to all its values.)
				local sbr, sbi = complex64.sqrt(br, bi)
				local scr, sci = complex64.sqrt(cr, ci)
				local ur, ui = complex64.mul(sbr, sbi, scr, sci)
				local s = cabs1(ur, ui)
				if s ~= 0 then
					local ar, ai = H(i - 1, i - 1)
					local xr, xi = 0.5 * (ar - tr), 0.5 * (ai - ti)
					local sx = cabs1(xr, xi)
					s = math.max(s, sx)
					local qr, qi = complex64.mul(xr / s, xi / s, xr / s, xi / s)
					local pr, pi = complex64.mul(ur / s, ui / s, ur / s, ui / s)
					local yr, yi = complex64.sqrt(qr + pr, qi + pi)
					yr, yi = s * yr, s * yi
					if sx > 0 and (xr / sx) * yr + (xi / sx) * yi < 0 then
						yr, yi = -yr, -yi
					end
					local dr, di = complex64.div(ur, ui, xr + yr, xi + yi)
					local er, ei = complex64.mul(ur, ui, dr, di)
					tr, ti = tr - er, ti - ei
				end
			end

			-- Look for two consecutive small subdiagonal entries, to start lower.
			local m = i - 1
			local v1r, v1i, v2r, v2i = 0, 0, 0, 0
			while true do
				local h11r, h11i = H(m, m)
				local h22r, h22i = H(m + 1, m + 1)
				local sr, si = h11r - tr, h11i - ti
				local h21r, h21i = H(m + 1, m)
				local s = cabs1(sr, si) + cabs1(h21r, h21i)
				v1r, v1i, v2r, v2i = sr / s, si / s, h21r / s, h21i / s
				if m == l then
					break
				end
				local h10 = habs(m, m - 1)
				if h10 * cabs1(v2r, v2i) <= ulp * (cabs1(v1r, v1i) * (cabs1(h11r, h11i) + cabs1(h22r, h22i))) then
					break
				end
				m -= 1
			end

			-- The single-shift step: chase the bulge from row m to the bottom.
			for k2 = m, i - 1 do
				if k2 > m then
					v1r, v1i = H(k2, k2 - 1)
					v2r, v2i = H(k2 + 1, k2 - 1)
				end
				local beta, t1r, t1i, w2r, w2i = small_reflector(v1r, v1i, v2r, v2i)
				if k2 > m then
					set(k2, k2 - 1, beta, 0)
					set(k2 + 1, k2 - 1, 0, 0)
				elseif m > l then
					-- H^H applied to (h, 0): h (1 - conj tau)
					local hr, hi = H(k2, k2 - 1)
					local nr, ni = complex64.mul(hr, hi, 1 - t1r, t1i)
					set(k2, k2 - 1, nr, ni)
				end
				if t1r ~= 0 or t1i ~= 0 then
					-- From the left, H^H = I - conj(tau) v v^H, on rows k2, k2+1.
					for j = k2, i2 do
						local o = at(k2, j)
						local ar, ai = cload(h, o)
						local br, bi = cload(h, o + elem(1))
						-- conj(tau) (a + conj(w2) b)
						local sr, si = ar + w2r * br + w2i * bi, ai + w2r * bi - w2i * br
						sr, si = t1r * sr + t1i * si, t1r * si - t1i * sr
						cstore(h, o, ar - sr, ai - si)
						cstore(h, o + elem(1), br - (sr * w2r - si * w2i), bi - (sr * w2i + si * w2r))
					end
					-- From the right, H = I - tau v v^H, on columns k2, k2+1.
					local function right(buf: buffer, first: number, last: number)
						local c0, c1 = elem(k2 * n), elem((k2 + 1) * n)
						for j = first, last do
							local o = elem(j)
							local ar, ai = cload(buf, c0 + o)
							local br, bi = cload(buf, c1 + o)
							-- tau (a + w2 b)
							local sr, si = ar + w2r * br - w2i * bi, ai + w2r * bi + w2i * br
							sr, si = t1r * sr - t1i * si, t1r * si + t1i * sr
							cstore(buf, c0 + o, ar - sr, ai - si)
							-- b - s conj(w2)
							cstore(buf, c1 + o, br - (sr * w2r + si * w2i), bi - (si * w2r - sr * w2i))
						end
					end
					right(h, i1, math.min(k2 + 2, i))
					if z then
						right(z, 0, n - 1)
					end
				end
			end
		end
		if not converged then
			error("eig: the QR iteration did not converge")
		end
		wr[i + 1], wi[i + 1] = H(i, i)
		kdefl = 0
		i = l - 1
	end
	return wr, wi
end

-- Overwrites the columns of Z with unit eigenvectors of A = Z T Z^H, given the upper
-- triangular T of a complex Schur factorization: column k belongs to T's k-th diagonal
-- entry. (LAPACK's trevc followed by the back-transformation, normalized to unit length.)
local function eigvecs_from_schur(T: Matrix, Z: Matrix)
	local n = T.rows
	assert(T.cols == n and Z.rows == n and Z.cols == n, "matrix sizes do not match")
	local t, zb = T.data, Z.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	local xr, xi = table.create(n, 0), table.create(n, 0)
	local cr, ci = table.create(n, 0), table.create(n, 0)
	local ulp = 2 * EPS
	local smlnum = 2 ^ -1000 * (n / ulp)
	-- Descending, so the columns of Z still needed are not yet overwritten.
	for k = n - 1, 0, -1 do
		local lr, li = cload(t, at(k, k))
		local smin = math.max(ulp * cabs1(lr, li), smlnum)
		-- Solve (T[0..k-1, 0..k-1] - lambda) x = -T[0..k-1, k], with x_k = 1.
		xr[k + 1], xi[k + 1] = 1, 0
		for r = 0, k - 1 do
			local o = at(r, k)
			xr[r + 1], xi[r + 1] = -load(t, o), -load(t, imag(o))
		end
		for j = k - 1, 0, -1 do
			local dr, di = cload(t, at(j, j))
			dr, di = dr - lr, di - li
			-- Perturb a (nearly) repeated eigenvalue, as trevc does.
			if cabs1(dr, di) < smin then
				dr, di = smin, 0
			end
			local yr, yi = complex64.div(xr[j + 1], xi[j + 1], dr, di)
			-- Rescale everything if the solution is about to overflow.
			local size = cabs1(yr, yi)
			if size > 2 ^ 500 then
				local f = 1 / size
				for r = 1, k + 1 do
					xr[r], xi[r] = xr[r] * f, xi[r] * f
				end
				yr, yi = yr * f, yi * f
			end
			xr[j + 1], xi[j + 1] = yr, yi
			for r = 0, j - 1 do
				local tr, ti = cload(t, at(r, j))
				xr[r + 1] -= tr * yr - ti * yi
				xi[r + 1] -= tr * yi + ti * yr
			end
		end
		-- Back-transform: column k := Z[:, 0..k] x, then normalize.
		for r = 1, n do
			cr[r], ci[r] = 0, 0
		end
		for j = 0, k do
			local pr, pi = xr[j + 1], xi[j + 1]
			local col = elem(j * n)
			for r = 0, n - 1 do
				local zr, zi = cload(zb, col + elem(r))
				cr[r + 1] += zr * pr - zi * pi
				ci[r + 1] += zr * pi + zi * pr
			end
		end
		local big = 0
		for r = 1, n do
			big = math.max(big, math.abs(cr[r]), math.abs(ci[r]))
		end
		local s = 0
		if big > 0 then
			for r = 1, n do
				local a, b = cr[r] / big, ci[r] / big
				s += a * a + b * b
			end
		end
		local scale = if big > 0 then 1 / (big * math.sqrt(s)) else 0
		local col = elem(k * n)
		for r = 0, n - 1 do
			cstore(zb, col + elem(r), cr[r + 1] * scale, ci[r + 1] * scale)
		end
	end
end

-- Reduces A to Hessenberg form and runs complex_schur on it; returns the Schur vectors
-- (if wantz) and the eigenvalues. With ilo and ihi (from balance), only that block is iterated on.
local function schur_impl(A: Matrix, wantt: boolean, wantz: boolean, ilo: number?, ihi: number?): (Matrix?, { number }, { number })
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	if any_nonfinite(A.data, 0, 2 * n * n) then
		-- NaN or infinity in, NaN out: T, Z and the eigenvalues.
		fill_nan(A.data, 0, 2 * n * n)
		local Z = if wantz then matrix(n, n) else nil
		if Z then
			fill_nan(Z.data, 0, 2 * n * n)
		end
		return Z, table.create(n, 0 / 0) :: { number }, table.create(n, 0 / 0) :: { number }
	end
	local lo, hi = ilo or 0, ihi or n - 1
	local F = hess_range(A, lo, hi)
	local Z = if wantz then hess_q(nil, F) else nil
	local a = A.data
	for j = 0, n - 3 do
		for i = j + 2, n - 1 do
			cstore(a, elem(j * n + i), 0, 0)
		end
	end
	local wr, wi = complex_schur(a, n, wantt, if Z then Z.data else nil, lo, hi)
	return Z, wr, wi
end

local function complex_values(wr: { number }, wi: { number }): buffer
	local values = create(#wr)
	for k = 1, #wr do
		cstore(values, elem(k - 1), wr[k], wi[k])
	end
	return values
end

-- Complex Schur factorization A = Z T Z^H, in place: A is overwritten with the upper
-- triangular T. Z is computed unless vectors is false. values holds T's diagonal (the
-- eigenvalues). If A holds a NaN or an infinity, T, Z and the values are all NaN.
-- schur_copy leaves A unchanged.
local function schur(A: Matrix, vectors: boolean?): Schur
	-- Scaled into a safe range and back (Z does not change).
	local sc = range_scale(A.data)
	local Z, wr, wi = schur_impl(A, true, vectors ~= false)
	if sc ~= 1 then
		scale(A.data, 1 / sc, A.data)
		for k = 1, #wr do
			wr[k] /= sc
			wi[k] /= sc
		end
	end
	return { schur = A, z = Z, values = complex_values(wr, wi) }
end

-- Complex Schur factorization of a copy of A; A is not modified.
local function schur_copy(A: Matrix, vectors: boolean?): Schur
	return schur(matcopy(nil, A), vectors)
end

-- What balance did: rows and columns ilo..ihi (0-based) form the block left to the
-- eigensolver, scale holds the diagonal of D, and swaps lists the row/column exchanges in
-- order (as pairs).
type Balance = { ilo: number, ihi: number, scale: { number }, swaps: { number } }

-- Balances the square matrix A in place, as LAPACK's gebal does:
-- 1. Permutation: a row that is zero off the diagonal isolates an eigenvalue (its diagonal
--    entry) and is moved to the bottom; a column that is zero off the diagonal likewise, to
--    the top. Repeating this leaves A block upper triangular, with triangular blocks
--    outside rows and columns ilo..ihi, so only that block needs the QR algorithm.
-- 2. Scaling: A := D^-1 A D on that block, with D a diagonal of powers of 2 (exact),
--    chosen so each row and the matching column have similar 2-norms. The eigenvalues are
--    unchanged but computed more accurately when A is badly scaled, because the
--    eigensolver's error is proportional to |A|.
-- Eigenvectors of the original A are P D times those of the balanced matrix (unbalance).
local function balance(A: Matrix): Balance
	local n = A.rows
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	--@inline
	local function nonzero(o: number): boolean
		return load(a, o) ~= 0 or load(a, imag(o)) ~= 0
	end
	local swaps = {}
	-- Exchanges rows i and j and columns i and j (a permutation similarity).
	local function exchange(i: number, j: number)
		if i == j then
			return
		end
		table.insert(swaps, i)
		table.insert(swaps, j)
		for k = 0, n - 1 do
			cswap_at(a, at(k, i), at(k, j))
		end
		for k = 0, n - 1 do
			cswap_at(a, at(i, k), at(j, k))
		end
	end
	local lo, hi = 0, n - 1
	-- Rows zero off the diagonal (in columns 0..hi): move to the bottom.
	local found = true
	while found and hi > 0 do
		found = false
		for j = hi, 0, -1 do
			local zero = true
			for c = 0, hi do
				if c ~= j and nonzero(at(j, c)) then
					zero = false
					break
				end
			end
			if zero then
				exchange(j, hi)
				hi -= 1
				found = true
				break
			end
		end
	end
	-- Columns zero off the diagonal (in rows lo..hi): move to the top.
	found = true
	while found and lo < hi do
		found = false
		for j = lo, hi do
			local zero = true
			for r = lo, hi do
				if r ~= j and nonzero(at(r, j)) then
					zero = false
					break
				end
			end
			if zero then
				exchange(j, lo)
				lo += 1
				found = true
				break
			end
		end
	end
	-- Scaling of the block lo..hi.
	local d = table.create(n, 1)
	local function rownorm(i: number): number
		local big = 0
		for j = lo, hi do
			local o = at(i, j)
			big = math.max(big, math.abs(load(a, o)), math.abs(load(a, imag(o))))
		end
		if big == 0 then
			return 0
		end
		local s = 0
		for j = lo, hi do
			local vr, vi = cload(a, at(i, j))
			vr, vi = vr / big, vi / big
			s += vr * vr + vi * vi
		end
		return big * math.sqrt(s)
	end
	local converged = false
	while not converged do
		converged = true
		for i = lo, hi do
			local c, r = segment_norm(a, at(lo, i), 2 * (hi - lo + 1)), rownorm(i)
			if c > 0 and r > 0 then
				-- Column i times f and row i divided by f have norms about c f and r / f; take
				-- the power of 2 that brings those within a factor of 2 of each other.
				local f, cf, rf = 1, c, r
				while cf < rf / 2 and f < 2 ^ 500 do
					f, cf, rf = f * 2, cf * 2, rf / 2
				end
				while cf >= rf * 2 and f > 2 ^ -500 do
					f, cf, rf = f / 2, cf / 2, rf * 2
				end
				if cf + rf < 0.95 * (c + r) then
					converged = false
					d[i + 1] *= f
					for j = 0, n - 1 do
						cdiv_at(a, at(i, j), f)
						cmul_at(a, at(j, i), f)
					end
				end
			end
		end
	end
	return { ilo = lo, ihi = hi, scale = d, swaps = swaps }
end

-- Maps eigenvectors of a balanced matrix back (x = P D x') and rescales each to unit length.
local function unbalance(v: buffer, n: number, B: Balance)
	local d, swaps = B.scale, B.swaps
	for j = 0, n - 1 do
		local col = elem(j * n)
		for i = 0, n - 1 do
			cmul_at(v, col + elem(i), d[i + 1])
		end
		-- Undo the exchanges, last first.
		for s = #swaps - 1, 1, -2 do
			cswap_at(v, col + elem(swaps[s]), col + elem(swaps[s + 1]))
		end
		local nrm = segment_norm(v, col, 2 * n)
		if nrm > 0 then
			for i = 0, n - 1 do
				cdiv_at(v, col + elem(i), nrm)
			end
		end
	end
end

-- Eigenvalues and, unless vectors is false, unit eigenvectors of a general complex
-- matrix: column k of vectors belongs to values[k]. Unless balanced is false, A is
-- balanced first (permuted and scaled; see balance), as LAPACK's geev does by default. A
-- is overwritten with the (balanced) Schur form, or with workspace if vectors is false;
-- the eigenvectors are a new matrix. If A holds a NaN or an infinity, the values, the
-- vectors and A are all NaN. eig_copy leaves A unchanged.
local function eig(A: Matrix, vectors: boolean?, balanced: boolean?): Eig
	local want = vectors ~= false
	assert(A.cols == A.rows, "matrix must be square")
	if any_nonfinite(A.data, 0, 2 * A.rows * A.rows) then
		-- schur_impl returns NaN for everything.
		local Z, wr, wi = schur_impl(A, want, want)
		return { values = complex_values(wr, wi), vectors = Z }
	end
	-- Scaled into a safe range (see range_scale); the values and A are scaled back at the
	-- end, and the vectors do not change.
	local sc = range_scale(A.data)
	local bal = if balanced ~= false then balance(A) else nil
	local Z, wr, wi = schur_impl(A, want, want, if bal then bal.ilo else nil, if bal then bal.ihi else nil)
	if Z then
		eigvecs_from_schur(A, Z)
		if bal then
			unbalance(Z.data, A.rows, bal)
		end
	end
	if sc ~= 1 then
		scale(A.data, 1 / sc, A.data)
		for k = 1, #wr do
			wr[k] /= sc
			wi[k] /= sc
		end
	end
	return { values = complex_values(wr, wi), vectors = Z }
end

-- Eigendecomposition of a copy of A; A is not modified.
local function eig_copy(A: Matrix, vectors: boolean?, balanced: boolean?): Eig
	return eig(matcopy(nil, A), vectors, balanced)
end

--@include shared/bidiagonal_svd.luau.in

-- Reduces A (rows >= cols) to real upper bidiagonal form A = Q B P^H in place (LAPACK's
-- gebd2 for complex matrices), returning B's diagonal d and superdiagonal e as tables.
-- The left reflectors stay below the diagonal of A (as in qr), with their tau in tauq;
-- right reflector k acts on columns k+1.. and stays in row k from column k+2 on, with its
-- tau in taup.
local function bidiagonalize(A: Matrix): ({ number }, { number }, buffer, buffer)
	local m, n = A.rows, A.cols
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * m + i)
	end
	local tauq = create(n)
	local taup = create(math.max(n - 1, 0))
	local d, e = table.create(n, 0), table.create(math.max(n - 1, 0), 0)
	local row = create(n)
	local wr, wi = table.create(m, 0), table.create(m, 0)
	for k = 0, n - 1 do
		local diag = at(k, k)
		local tr, ti = householder(a, diag, m - k, tauq, k)
		d[k + 1] = load(a, diag)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, at(k, j))
			end
		end
		if k < n - 1 then
			-- The conjugate of row k from column k+1 on is gathered and reflected; v is
			-- put back in the row.
			local len = n - k - 1
			for c = 0, len - 1 do
				local o = at(k, k + 1 + c)
				cstore(row, elem(c), load(a, o), -load(a, imag(o)))
			end
			local pr, pi = householder(row, 0, len, taup, k)
			e[k + 1] = load(row, 0)
			for c = 0, len - 1 do
				local o = elem(c)
				cstore(a, at(k, k + 1 + c), load(row, o), load(row, imag(o)))
			end
			if pr ~= 0 or pi ~= 0 then
				-- Rows k+1.. of columns k+1..: A := A (I - tau v v^H), v = (1, row[1..]).
				for r = k + 1, m - 1 do
					wr[r + 1], wi[r + 1] = cload(a, at(r, k + 1))
				end
				for c = 1, len - 1 do
					local vr, vi = cload(row, elem(c))
					local col = elem((k + 1 + c) * m)
					for r = k + 1, m - 1 do
						local ar, ai = cload(a, col + elem(r))
						wr[r + 1] += ar * vr - ai * vi
						wi[r + 1] += ar * vi + ai * vr
					end
				end
				for c = 0, len - 1 do
					local vr, vi = 1, 0
					if c > 0 then
						vr, vi = cload(row, elem(c))
					end
					-- tau conj(v_c)
					local fr, fi = pr * vr + pi * vi, pi * vr - pr * vi
					local col = elem((k + 1 + c) * m)
					for r = k + 1, m - 1 do
						local xr, xi = wr[r + 1], wi[r + 1]
						csub_at(a, col + elem(r), xr * fr - xi * fi, xr * fi + xi * fr)
					end
				end
			end
		end
	end
	return d, e, tauq, taup
end

-- svd for rows >= cols, in place.
local function svd_tall(A: Matrix, want: boolean): Svd
	local m, n = A.rows, A.cols
	if any_nonfinite(A.data, 0, 2 * m * n) then
		local values = buffer.create(relem(n))
		fill_nan(values, 0, n)
		fill_nan(A.data, 0, 2 * m * n)
		local V = if want then matrix(n, n) else nil
		if V then
			fill_nan(V.data, 0, 2 * n * n)
		end
		return { values = values, u = if want then A else nil, v = V }
	end
	-- Scaled into a safe range (see range_scale); the values are scaled back, and U and V
	-- do not change.
	local sc = range_scale(A.data)
	local d, e, tauq, taup = bidiagonalize(A)
	local V: Matrix? = nil
	if want then
		-- V = P from the right reflectors, then U = the first n columns of Q, in A.
		local P = matrix(n, n)
		for k = 0, n - 3 do
			for c = k + 2, n - 1 do
				local s = elem(c * m + k)
				cstore(P.data, elem(k * n + c), load(A.data, s), load(A.data, imag(s)))
			end
		end
		form_reduction_q(P.data, n, math.max(n - 1, 0), taup)
		form_q(A.data, m, 0, m, n, n, tauq)
		V = P
	end
	bidiagonal_svd(d, e, n, if want then A.data else nil, m, if V then V.data else nil, n)
	local values = buffer.create(relem(n))
	for i = 1, n do
		store(values, relem(i - 1), d[i])
	end
	if sc ~= 1 then
		scale(values, 1 / sc, values)
	end
	return { values = values, u = if want then A else nil, v = V }
end

-- Singular value decomposition A = U diag(values) V^H: values (descending, nonnegative,
-- a real array of the same precision) and, unless vectors is false, U (rows by k) and V
-- (cols by k) with orthonormal columns, k = min(rows, cols). Golub-Kahan
-- bidiagonalization, then implicit QR on the real bidiagonal in double precision, keeping
-- the small singular values relatively accurate. In place when rows >= cols: A is
-- overwritten with U (or with workspace if vectors is false). A wide A is not modified
-- (its adjoint is decomposed instead). If A holds a NaN or an infinity, every output is
-- NaN. svd_copy never modifies A.
local function svd(A: Matrix, vectors: boolean?): Svd
	if A.rows < A.cols then
		local F = svd_tall(adjoint(nil, A), vectors ~= false)
		return { values = F.values, u = F.v, v = F.u }
	end
	return svd_tall(A, vectors ~= false)
end

-- Singular value decomposition of a copy of A; A is not modified.
local function svd_copy(A: Matrix, vectors: boolean?): Svd
	if A.rows < A.cols then
		return svd(A, vectors)
	end
	return svd(matcopy(nil, A), vectors)
end

-- The pseudoinverse A^+ = V S^+ U^H (cols by rows), by the SVD of a copy of A; singular
-- values at or below tol * s_1 (default max(rows, cols) * eps, as for svd_solve) count as
-- zero. A is not modified. NaN or infinite input gives an all-NaN result. To apply A^+ to
-- vectors, solving with form "svd" is cheaper than forming it.
local function pinv(A: Matrix, tol: number?): Matrix
	local m, n = A.rows, A.cols
	local F = svd_copy(A)
	local U, V = F.u :: Matrix, F.v :: Matrix
	local k, s = U.cols, F.values
	local X = matrix(n, m)
	if k > 0 and load(s, 0) ~= load(s, 0) then
		fill_nan(X.data, 0, 2 * n * m)
		return X
	end
	local limit = (tol or math.max(m, n) * EPS) * (if k > 0 then load(s, 0) else 0)
	local u, v, x = U.data, V.data, X.data
	local rr, ri = table.create(n, 0), table.create(n, 0)
	-- Column q of X is sum over i of v_i (conj(u_qi) / s_i).
	for i = 0, k - 1 do
		local si = load(s, relem(i))
		if not (si > limit) then
			break
		end
		for p = 0, n - 1 do
			local o = elem(i * n + p)
			rr[p + 1], ri[p + 1] = load(v, o) / si, load(v, imag(o)) / si
		end
		for q = 0, m - 1 do
			local o = elem(i * m + q)
			local cr, ci = load(u, o), -load(u, imag(o))
			if cr ~= 0 or ci ~= 0 then
				local col = elem(q * n)
				for p = 0, n - 1 do
					local t = col + elem(p)
					store(x, t, load(x, t) + cr * rr[p + 1] - ci * ri[p + 1])
					store(x, imag(t), load(x, imag(t)) + cr * ri[p + 1] + ci * rr[p + 1])
				end
			end
		end
	end
	return X
end

-- Matrix norms: kind 1 (largest column sum of |a_ij|), "inf" (largest row sum), 2
-- (largest singular value) or "fro" (Frobenius; the default).
local function matnorm(A: Matrix, kind: (number | string)?): number
	local m, n = A.rows, A.cols
	local a = A.data
	if kind == nil or kind == "fro" then
		return norm(a)
	elseif kind == 2 then
		if m == 0 or n == 0 then
			return 0
		end
		return load(svd_copy(A, false).values, 0)
	elseif kind == 1 then
		local best = 0
		for j = 0, n - 1 do
			local s = 0
			for i = 0, m - 1 do
				s += complex64.abs(cread(a, j * m + i))
			end
			if not (s <= best) then
				best = s
			end
		end
		return best
	elseif kind == "inf" then
		local rows = table.create(m, 0) :: { number }
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				rows[i + 1] += complex64.abs(cread(a, j * m + i))
			end
		end
		local best = 0
		for _, s in rows do
			if not (s <= best) then
				best = s
			end
		end
		return best
	end
	error(`matnorm: unknown kind {kind}`)
end
-- The Hermitian tridiagonal eigenproblem.

-- Eigenvalues (ascending, a real array) and, unless vectors is false, orthonormal
-- eigenvectors of the Hermitian tridiagonal matrix T: the real parts of its diagonal
-- and T.lower are read (T.upper should be conj(T.lower) and is ignored). A diagonal
-- unitary D makes the off-diagonal real and nonnegative (T = D T2 D^H), then implicit QR
-- with Wilkinson shifts runs on T2 in double precision, as inside eigh; the vectors are
-- D times those of T2. T is not modified; the vectors are a new matrix.
local function tridiag_eigh(T: Tridiagonal, vectors: boolean?): Eigh
	local n = length(T.diag)
	local d = table.create(n, 0) :: { number }
	local e = table.create(math.max(n - 1, 0), 0) :: { number }
	local pr, pi = table.create(n, 1) :: { number }, table.create(n, 0) :: { number }
	for i = 1, n do
		d[i] = load(T.diag, elem(i - 1))
	end
	for i = 1, n - 1 do
		local lr, li = cload(T.lower, elem(i - 1))
		local a = complex64.abs(lr, li)
		e[i] = a
		-- phi_(i+1) = phi_i l_i / |l_i|
		if a > 0 then
			local r, m = complex64.mul(pr[i], pi[i], lr / a, li / a)
			pr[i + 1] = r
			pi[i + 1] = m
		else
			pr[i + 1] = pr[i]
			pi[i + 1] = pi[i]
		end
	end
	local Z = if vectors ~= false then identity(n) else nil
	tridiagonal_eigen(d, e, if Z then Z.data else nil, n)
	if Z then
		for j = 0, n - 1 do
			for k = 0, n - 1 do
				local o = elem(j * n + k)
				local zr, zi = cload(Z.data, o)
				cstore(Z.data, o, zr * pr[k + 1] - zi * pi[k + 1], zr * pi[k + 1] + zi * pr[k + 1])
			end
		end
	end
	local values = buffer.create(relem(n))
	for i = 1, n do
		store(values, relem(i - 1), d[i])
	end
	return { values = values, vectors = Z }
end

--@include shared/polar.luau.in

--@include shared/linalg_extra_eigen.luau.in

local function abs1(re: number, im: number): number
	return math.abs(re) + math.abs(im)
end

-- A rotation (c real, s complex) with [c s; -conj(s) c] [a; b] = [r; 0].
local function rotation(ar: number, ai: number, br: number, bi: number): (number, number, number)
	if br == 0 and bi == 0 then
		return 1, 0, 0
	end
	local na = complex64.abs(ar, ai)
	if na == 0 then
		return 0, 1, 0
	end
	local r = hypot3(na, complex64.abs(br, bi), 0)
	local c = na / r
	-- s = (a / |a|) conj(b) / r
	local ur, ui = ar / na, ai / na
	return c, (ur * br + ui * bi) / r, (ui * br - ur * bi) / r
end

-- Rows i, j of the n by n matrix in buf, columns c0..n-1:
-- (x, y) := (c x + s y, -conj(s) x + c y).
local function rows(buf: buffer, n: number, i: number, j: number, c0: number, c: number, sr: number, si: number)
	for col = math.max(c0, 0), n - 1 do
		local xr, xi = cread(buf, col * n + i)
		local yr, yi = cread(buf, col * n + j)
		cwrite(buf, col * n + i, c * xr + sr * yr - si * yi, c * xi + sr * yi + si * yr)
		cwrite(buf, col * n + j, -(sr * xr + si * xi) + c * yr, -(sr * xi - si * xr) + c * yi)
	end
end

-- Columns keep and other of rows 0..r1 of the n by n matrix in buf:
-- (keep, other) := (c keep + s other, -conj(s) keep + c other). Chosen with
-- rotation(keep_value, other_value), it zeros the other column's entry in that row.
local function cols(buf: buffer, n: number, keep: number, other: number, r1: number, c: number, sr: number, si: number)
	for row = 0, math.min(r1, n - 1) do
		local xr, xi = cread(buf, keep * n + row)
		local yr, yi = cread(buf, other * n + row)
		cwrite(buf, keep * n + row, c * xr + sr * yr - si * yi, c * xi + sr * yi + si * yr)
		cwrite(buf, other * n + row, -(sr * xr + si * xi) + c * yr, -(sr * xi - si * xr) + c * yi)
	end
end

-- Q := Q G^H for a row rotation G on rows i, j: columns i, j of Q become
-- (c q_i + conj(s) q_j, -s q_i + c q_j).
local function qcols(Q: buffer, n: number, i: number, j: number, c: number, sr: number, si: number)
	for row = 0, n - 1 do
		local xr, xi = cread(Q, i * n + row)
		local yr, yi = cread(Q, j * n + row)
		-- c x + conj(s) y, then -s x + c y
		cwrite(Q, i * n + row, c * xr + sr * yr + si * yi, c * xi + sr * yi - si * yr)
		cwrite(Q, j * n + row, -(sr * xr - si * xi) + c * yr, -(sr * xi + si * xr) + c * yi)
	end
end

-- The generalized Schur form A = Q S Z^H, B = Q P Z^H with S and P upper triangular,
-- in place (A becomes S and B becomes P), by Moler and Stewart's QZ algorithm with
-- single Wilkinson-type shifts: B is made triangular by a QR factorization, A
-- Hessenberg by rotations that keep B triangular, then QZ steps deflate eigenvalues
-- from the bottom. A (numerically) zero diagonal entry of P in the active block is
-- chased to the top of the block with rotations that keep the Hessenberg-triangular
-- form, where it splits off an infinite eigenvalue. Returns Q and Z (if wanted).
local function qz(A: Matrix, B: Matrix, want: boolean): (Matrix?, Matrix?)
	local n = A.rows
	assert(A.cols == n and B.rows == n and B.cols == n, "qz needs square matrices of one size")
	local F = qr(matcopy(nil, B))
	local Q = if want then qr_q(nil, F) else nil
	local R = qr_r(nil, F)
	buffer.copy(B.data, 0, R.data)
	-- A := Q0^H A, column by column.
	for j = 0, n - 1 do
		local col = create(n)
		buffer.copy(col, 0, A.data, elem(j * n), elem(n))
		qr_apply_qh(F, col)
		buffer.copy(A.data, elem(j * n), col)
	end
	local Z = if want then identity(n) else nil
	local h, t = A.data, B.data
	-- Hessenberg-triangular reduction.
	for j = 0, n - 3 do
		for i = n - 1, j + 2, -1 do
			local ar, ai = cread(h, j * n + i - 1)
			local br, bi = cread(h, j * n + i)
			local c, sr, si = rotation(ar, ai, br, bi)
			rows(h, n, i - 1, i, j, c, sr, si)
			rows(t, n, i - 1, i, i - 1, c, sr, si)
			if Q then
				qcols(Q.data, n, i - 1, i, c, sr, si)
			end
			-- B now has fill at (i, i-1): zero it with columns (i, i-1).
			local kr, ki = cread(t, i * n + i)
			local orr, oi = cread(t, (i - 1) * n + i)
			c, sr, si = rotation(kr, ki, orr, oi)
			cols(t, n, i, i - 1, i, c, sr, si)
			cols(h, n, i, i - 1, n - 1, c, sr, si)
			if Z then
				cols(Z.data, n, i, i - 1, n - 1, c, sr, si)
			end
		end
	end
	-- Zero below the subdiagonal of A and below the diagonal of B exactly.
	for j = 0, n - 1 do
		for i = j + 2, n - 1 do
			cwrite(h, j * n + i, 0, 0)
		end
		for i = j + 1, n - 1 do
			cwrite(t, j * n + i, 0, 0)
		end
	end
	local tnorm = norm(t)
	local hnorm = norm(h)
	local ihi = n - 1
	local its, total = 0, 0
	local limit = 30 * math.max(n, 1)
	while ihi >= 0 do
		-- Active block l..ihi: H(l, l-1) negligible.
		local l = ihi
		while l > 0 do
			local sr0, si0 = cread(h, (l - 1) * n + l)
			local ar, ai = cread(h, l * n + l)
			local pr, pi = cread(h, (l - 1) * n + l - 1)
			local scale = abs1(ar, ai) + abs1(pr, pi)
			if scale == 0 then
				scale = hnorm
			end
			if abs1(sr0, si0) <= EPS * scale then
				cwrite(h, (l - 1) * n + l, 0, 0)
				break
			end
			l -= 1
		end
		if l == ihi then
			ihi -= 1
			its = 0
			continue
		end
		-- A negligible diagonal entry of P in the block: chase it to the top (row l),
		-- where a rotation of rows l, l+1 splits off an infinite eigenvalue.
		local zero = -1
		for j = l, ihi do
			if abs1(cread(t, j * n + j)) <= EPS * tnorm then
				cwrite(t, j * n + j, 0, 0)
				zero = j
				break
			end
		end
		if zero >= 0 then
			for j = zero, l + 1, -1 do
				-- Columns (j, j-1) of P: zero P(j-1, j-1), keeping column j.
				local kr, ki = cread(t, j * n + j - 1)
				local orr, oi = cread(t, (j - 1) * n + j - 1)
				local c, sr, si = rotation(kr, ki, orr, oi)
				cols(t, n, j, j - 1, j, c, sr, si)
				cols(h, n, j, j - 1, math.min(j + 1, n - 1), c, sr, si)
				if Z then
					cols(Z.data, n, j, j - 1, n - 1, c, sr, si)
				end
				cwrite(t, (j - 1) * n + j - 1, 0, 0)
				-- That filled H(j+1, j-1) (unless j is the block's last row): zero it
				-- with rows (j, j+1).
				if j + 1 <= ihi then
					local ar, ai = cread(h, (j - 1) * n + j)
					local br, bi = cread(h, (j - 1) * n + j + 1)
					c, sr, si = rotation(ar, ai, br, bi)
					rows(h, n, j, j + 1, j - 1, c, sr, si)
					rows(t, n, j, j + 1, j, c, sr, si)
					if Q then
						qcols(Q.data, n, j, j + 1, c, sr, si)
					end
					cwrite(h, (j - 1) * n + j + 1, 0, 0)
				end
			end
			-- P(l, l) = 0: rows (l, l+1) zero H(l+1, l) and keep P triangular.
			local ar, ai = cread(h, l * n + l)
			local br, bi = cread(h, l * n + l + 1)
			local c, sr, si = rotation(ar, ai, br, bi)
			rows(h, n, l, l + 1, l, c, sr, si)
			rows(t, n, l, l + 1, l, c, sr, si)
			if Q then
				qcols(Q.data, n, l, l + 1, c, sr, si)
			end
			cwrite(h, l * n + l + 1, 0, 0)
			cwrite(t, l * n + l + 1, 0, 0)
			continue
		end
		its += 1
		total += 1
		if total > limit then
			error("qz: the iteration did not converge")
		end
		-- Shift: the eigenvalue of the trailing 2 by 2 pencil closest to
		-- H(ihi, ihi) / P(ihi, ihi); an exceptional shift every 10 iterations.
		local a11r, a11i = cread(h, (ihi - 1) * n + ihi - 1)
		local a21r, a21i = cread(h, (ihi - 1) * n + ihi)
		local a12r, a12i = cread(h, ihi * n + ihi - 1)
		local a22r, a22i = cread(h, ihi * n + ihi)
		local b11r, b11i = cread(t, (ihi - 1) * n + ihi - 1)
		local b12r, b12i = cread(t, ihi * n + ihi - 1)
		local b22r, b22i = cread(t, ihi * n + ihi)
		local sigr, sigi
		if its % 10 == 0 then
			local er, ei = complex64.div(a22r, a22i, b22r, b22i)
			local bump = abs1(a21r, a21i) / math.max(abs1(b11r, b11i), EPS * tnorm)
			sigr, sigi = er + bump, ei
		else
			-- det(H2 - lambda P2) = qa lambda^2 - qb lambda + qc.
			local qar, qai = complex64.mul(b11r, b11i, b22r, b22i)
			local m1r, m1i = complex64.mul(a11r, a11i, b22r, b22i)
			local m2r, m2i = complex64.mul(a22r, a22i, b11r, b11i)
			local m3r, m3i = complex64.mul(a21r, a21i, b12r, b12i)
			local qbr, qbi = m1r + m2r - m3r, m1i + m2i - m3i
			local d1r, d1i = complex64.mul(a11r, a11i, a22r, a22i)
			local d2r, d2i = complex64.mul(a12r, a12i, a21r, a21i)
			local qcr, qci = d1r - d2r, d1i - d2i
			-- Roots (qb +- sqrt(qb^2 - 4 qa qc)) / (2 qa).
			local s1r, s1i = complex64.mul(qbr, qbi, qbr, qbi)
			local s2r, s2i = complex64.mul(qar, qai, qcr, qci)
			local dr, di = complex64.sqrt(s1r - 4 * s2r, s1i - 4 * s2i)
			local tr, ti = complex64.div(a22r, a22i, b22r, b22i)
			local r1r, r1i = complex64.div(qbr + dr, qbi + di, 2 * qar, 2 * qai)
			local r2r, r2i = complex64.div(qbr - dr, qbi - di, 2 * qar, 2 * qai)
			if r1r ~= r1r or r2r ~= r2r then
				sigr, sigi = tr, ti
			elseif abs1(r1r - tr, r1i - ti) <= abs1(r2r - tr, r2i - ti) then
				sigr, sigi = r1r, r1i
			else
				sigr, sigi = r2r, r2i
			end
		end
		-- The first rotation comes from the first column of H - sigma P.
		local h0r, h0i = cread(h, l * n + l)
		local p0r, p0i = cread(t, l * n + l)
		local spr, spi = complex64.mul(sigr, sigi, p0r, p0i)
		local h1r, h1i = cread(h, l * n + l + 1)
		local c, sr, si = rotation(h0r - spr, h0i - spi, h1r, h1i)
		rows(h, n, l, l + 1, l, c, sr, si)
		rows(t, n, l, l + 1, l, c, sr, si)
		if Q then
			qcols(Q.data, n, l, l + 1, c, sr, si)
		end
		-- Chase the bulge down.
		for k = l, ihi - 1 do
			-- P fill at (k+1, k): columns (k+1, k).
			local kr, ki = cread(t, (k + 1) * n + k + 1)
			local orr, oi = cread(t, k * n + k + 1)
			c, sr, si = rotation(kr, ki, orr, oi)
			cols(t, n, k + 1, k, k + 1, c, sr, si)
			cols(h, n, k + 1, k, math.min(k + 2, ihi), c, sr, si)
			if Z then
				cols(Z.data, n, k + 1, k, n - 1, c, sr, si)
			end
			cwrite(t, k * n + k + 1, 0, 0)
			-- H fill at (k+2, k): rows (k+1, k+2).
			if k + 2 <= ihi then
				local ar, ai = cread(h, k * n + k + 1)
				local br, bi = cread(h, k * n + k + 2)
				c, sr, si = rotation(ar, ai, br, bi)
				rows(h, n, k + 1, k + 2, k, c, sr, si)
				rows(t, n, k + 1, k + 2, k + 1, c, sr, si)
				if Q then
					qcols(Q.data, n, k + 1, k + 2, c, sr, si)
				end
				cwrite(h, k * n + k + 2, 0, 0)
			end
		end
	end
	return Q, Z
end

--@include shared/geneig_shared.luau.in

-- Generalized eigenvalues lambda = alpha / beta of A x = lambda B x and, unless vectors
-- is false, unit eigenvectors, by the QZ algorithm (see qz). values holds alpha / beta,
-- with an infinite eigenvalue (beta = 0, possible when B is singular) as (inf, 0) and
-- an undefined one (alpha = beta = 0: a singular pencil) as NaN; alpha and beta are
-- returned too. Column k of vectors belongs to values[k]. In place: A and B are
-- overwritten with the generalized Schur form. eig_gen_copy leaves them unchanged.
local function eig_gen(A: Matrix, B: Matrix, vectors: boolean?): GenEig
	local n = A.rows
	assert(A.cols == n and B.rows == n and B.cols == n, "eig_gen needs square matrices of one size")
	local want = vectors ~= false
	local reals = 2 * n * n
	if any_nonfinite(A.data, 0, reals) or any_nonfinite(B.data, 0, reals) then
		local function nans(count: number): buffer
			local b = buffer.create(relem(count))
			fill_nan(b, 0, count)
			return b
		end
		local V = if want then matrix(n, n) else nil
		if V then
			fill_nan(V.data, 0, reals)
		end
		fill_nan(A.data, 0, reals)
		fill_nan(B.data, 0, reals)
		return { values = nans(2 * n), alpha = nans(2 * n), beta = nans(2 * n), vectors = V }
	end
	local _, Z = qz(A, B, want)
	local s, p = A.data, B.data
	local alpha, beta, values = create(n), create(n), create(n)
	for k = 0, n - 1 do
		local ar, ai = cread(s, k * n + k)
		local br, bi = cread(p, k * n + k)
		cwrite(alpha, k, ar, ai)
		cwrite(beta, k, br, bi)
		if br == 0 and bi == 0 then
			if ar == 0 and ai == 0 then
				cwrite(values, k, 0 / 0, 0 / 0)
			else
				cwrite(values, k, math.huge, 0)
			end
		else
			cwrite(values, k, complex64.div(ar, ai, br, bi))
		end
	end
	local V: Matrix? = nil
	if Z then
		-- Right eigenvectors of the triangular pencil: (beta S - alpha P) x = 0 with
		-- x_k = 1, by back substitution (tiny denominators perturbed, as in tgevc),
		-- then Z x, normalized.
		local snorm, pnorm = norm(s), norm(p)
		local X = matrix(n, n)
		local xr, xi = table.create(n, 0) :: { number }, table.create(n, 0) :: { number }
		for k = 0, n - 1 do
			local ar, ai = cread(alpha, k)
			local br, bi = cread(beta, k)
			local smin = math.max(EPS * (complex64.abs(br, bi) * snorm + complex64.abs(ar, ai) * pnorm), 1e-300)
			for i = 0, n - 1 do
				xr[i + 1], xi[i + 1] = 0, 0
			end
			xr[k + 1] = 1
			for j = k - 1, 0, -1 do
				local sr, si = 0, 0
				for i = j + 1, k do
					local s1r, s1i = complex64.mul(br, bi, cread(s, i * n + j))
					local p1r, p1i = complex64.mul(ar, ai, cread(p, i * n + j))
					local cr, ci = s1r - p1r, s1i - p1i
					sr -= cr * xr[i + 1] - ci * xi[i + 1]
					si -= cr * xi[i + 1] + ci * xr[i + 1]
				end
				local d1r, d1i = complex64.mul(br, bi, cread(s, j * n + j))
				local d2r, d2i = complex64.mul(ar, ai, cread(p, j * n + j))
				local dr, di = d1r - d2r, d1i - d2i
				if complex64.abs(dr, di) < smin then
					dr, di = smin, 0
				end
				xr[j + 1], xi[j + 1] = complex64.div(sr, si, dr, di)
			end
			-- Column k of X := Z x.
			local col = create(n)
			for i = 0, k do
				local wr0, wi0 = xr[i + 1], xi[i + 1]
				if wr0 ~= 0 or wi0 ~= 0 then
					for r = 0, n - 1 do
						local zr, zi = cread(Z.data, i * n + r)
						local cr, ci = cread(col, r)
						cwrite(col, r, cr + zr * wr0 - zi * wi0, ci + zr * wi0 + zi * wr0)
					end
				end
			end
			local nrm = norm(col)
			if nrm > 0 then
				col = scale(col, 1 / nrm, col)
			end
			buffer.copy(X.data, elem(k * n), col)
		end
		V = X
	end
	return { values = values, alpha = alpha, beta = beta, vectors = V }
end

-- The generalized eigenproblem on copies; A and B are not modified.
local function eig_gen_copy(A: Matrix, B: Matrix, vectors: boolean?): GenEig
	return eig_gen(matcopy(nil, A), matcopy(nil, B), vectors)
end

--@include shared/updates_eigen.luau.in

--@include shared/randpiv_eigen.luau.in

return {
	cond = cond,
	eig = eig,
	eig_copy = eig_copy,
	eig_gen = eig_gen,
	eig_gen_copy = eig_gen_copy,
	eigh = eigh,
	eigh_copy = eigh_copy,
	eigh_gen = eigh_gen,
	eigh_gen_copy = eigh_gen_copy,
	eigvecs_from_schur = eigvecs_from_schur,
	hess = hess,
	hess_copy = hess_copy,
	hess_h = hess_h,
	hess_q = hess_q,
	matnorm = matnorm,
	null_space = null_space,
	orth = orth,
	pinv = pinv,
	polar = polar,
	polar_copy = polar_copy,
	qz = qz,
	rank = rank,
	rcond = rcond,
	rpcholesky = rpcholesky,
	rpcholesky_columns = rpcholesky_columns,
	rpqr = rpqr,
	rsvd = rsvd,
	schur = schur,
	schur_copy = schur_copy,
	svd = svd,
	svd_copy = svd_copy,
	tridiag_eigh = tridiag_eigh,
}
