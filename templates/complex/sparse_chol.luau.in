-- Sparse Cholesky factorization

-- The ordering of a sparse Cholesky factorization: "amd" (approximate minimum degree, the
-- default), "rcm" (reverse Cuthill-McKee), "natural", or a permutation.
local function chol_order(S: Sparse, order: (string | buffer)?): buffer
	if type(order) == "buffer" then
		assert(buffer.len(order) == 4 * S.cols, "sparse_chol: the order must have one entry per column")
		return order
	end
	local G = graph.of(S)
	if order == nil or order == "amd" then
		return graph.amd(G)
	elseif order == "rcm" then
		return graph.rcm(G)
	end
	assert(order == "natural", "sparse_chol: order must be \"amd\", \"rcm\", \"natural\" or a permutation")
	local p = buffer.create(4 * S.cols)
	for k = 0, S.cols - 1 do
		buffer.writei32(p, 4 * k, k + 1)
	end
	return p
end

-- The numeric factorization into L's values (see the real modules' chol_numeric), with
-- S = L L^H: each update is a set of products of rows of a block with conjugated rows.
-- Returns false if a pivot was not positive.
local function chol_numeric(sym: any, A: Sparse, L: buffer, work: any): boolean
	local ns = sym.nsuper
	local super, rowptr, rows, valptr, col2super, amap = sym.super, sym.rowptr, sym.rows, sym.valptr, sym.col2super, sym.amap
	buffer.fill(L, 0, 0)
	local Av = A.values
	for p = 0, u32(A.colptr, A.cols) - 1 do
		local dst = u32(amap, p)
		if dst ~= 0 then
			local o = elem(dst - 1)
			local ar, ai = cload(L, o)
			local br, bi = cload(Av, elem(p))
			cstore(L, o, ar + br, ai + bi)
		end
	end
	local rel, head, link, dpos = work.rel, work.head, work.link, work.dpos
	buffer.fill(head, 0, 255)
	for s = 0, ns - 1 do
		local c0: number = u32(super, s)
		local K: number = u32(super, s + 1) - c0
		local c1 = c0 + K
		local r0: number = u32(rowptr, s)
		local R: number = u32(rowptr, s + 1) - r0
		local base: number = u32(valptr, s)
		for r = 0, R - 1 do
			buffer.writeu32(rel, 4 * u32(rows, r0 + r), r)
		end
		local d = buffer.readi32(head, 4 * s)
		buffer.writei32(head, 4 * s, -1)
		while d >= 0 do
			local dnext = buffer.readi32(link, 4 * d)
			local Kd: number = u32(super, d + 1) - u32(super, d)
			local dr0: number = u32(rowptr, d)
			local dr1: number = u32(rowptr, d + 1)
			local dbase: number = u32(valptr, d)
			local q: number = u32(dpos, d)
			local q2 = q
			while q2 < dr1 and u32(rows, q2) < c1 do
				q2 += 1
			end
			-- C = L_d[rows from jj] L_d[rows jj .. q2 - 1]^H, lower part, subtracted into the
			-- block: two columns of C at a time against two rows
			local stride = @E@ * Kd
			local last = stride - @E@
			local jj = q
			while jj < q2 do
				local colA = u32(rows, jj) - c0
				local ojA = elem(dbase + (jj - dr0) * Kd)
				local pair = jj + 1 < q2
				local colB = if pair then u32(rows, jj + 1) - c0 else 0
				local ojB = ojA + stride
				-- row jj, column A: a squared norm
				local sq = 0
				for t = 0, last, @E@ do
					local ar, ai = cload(L, ojA + t)
					sq += ar * ar + ai * ai
				end
				local target = elem(base + u32(rel, u32(rows, jj)) * K + colA)
				local xr, xi = cload(L, target)
				cstore(L, target, xr - sq, xi)
				local ii = jj + 1
				local oi = ojA + stride
				while ii < dr1 do
					local two = pair and ii + 1 < dr1
					-- rows ii (and ii + 1) against columns A (and B)
					local p1r, p1i, q1r, q1i, p2r, p2i, q2r, q2i = 0, 0, 0, 0, 0, 0, 0, 0
					if two then
						for t = 0, last, @E@ do
							local ar, ai = cload(L, ojA + t)
							local br, bi = cload(L, ojB + t)
							local yr, yi = cload(L, oi + t)
							local zr, zi = cload(L, oi + stride + t)
							p1r += yr * ar + yi * ai
							p1i += yi * ar - yr * ai
							q1r += yr * br + yi * bi
							q1i += yi * br - yr * bi
							p2r += zr * ar + zi * ai
							p2i += zi * ar - zr * ai
							q2r += zr * br + zi * bi
							q2i += zi * br - zr * bi
						end
					else
						for t = 0, last, @E@ do
							local ar, ai = cload(L, ojA + t)
							local yr, yi = cload(L, oi + t)
							p1r += yr * ar + yi * ai
							p1i += yi * ar - yr * ai
							if pair then
								local br, bi = cload(L, ojB + t)
								q1r += yr * br + yi * bi
								q1i += yi * br - yr * bi
							end
						end
					end
					local rb = base + u32(rel, u32(rows, ii)) * K
					local o = elem(rb + colA)
					xr, xi = cload(L, o)
					cstore(L, o, xr - p1r, xi - p1i)
					if pair then
						o = elem(rb + colB)
						xr, xi = cload(L, o)
						cstore(L, o, xr - q1r, xi - q1i)
					end
					if two then
						rb = base + u32(rel, u32(rows, ii + 1)) * K
						o = elem(rb + colA)
						xr, xi = cload(L, o)
						cstore(L, o, xr - p2r, xi - p2i)
						o = elem(rb + colB)
						xr, xi = cload(L, o)
						cstore(L, o, xr - q2r, xi - q2i)
						ii += 2
						oi += 2 * stride
					else
						ii += 1
						oi += stride
					end
				end
				jj += if pair then 2 else 1
			end
			buffer.writeu32(dpos, 4 * d, q2)
			if q2 < dr1 then
				local s2 = u32(col2super, u32(rows, q2))
				buffer.writei32(link, 4 * d, buffer.readi32(head, 4 * s2))
				buffer.writei32(head, 4 * s2, d)
			end
			d = dnext
		end
		-- the dense block: Cholesky of its diagonal block, then the rows below solved
		-- against it, two at a time
		for r = 0, K - 1 do
			local orow = elem(base + r * K)
			for t = 0, r do
				local ot = elem(base + t * K)
				local sr, si = cload(L, orow + @E@ * t)
				for u = 0, @E@ * (t - 1), @E@ do
					local ar, ai = cload(L, orow + u)
					local br, bi = cload(L, ot + u)
					sr -= ar * br + ai * bi
					si -= ai * br - ar * bi
				end
				if t == r then
					if not (sr > 0) then
						return false
					end
					cstore(L, orow + @E@ * t, math.sqrt(sr), 0)
				else
					local dt = load(L, ot + @E@ * t)
					cstore(L, orow + @E@ * t, sr / dt, si / dt)
				end
			end
		end
		local stride = @E@ * K
		local r = K
		while r < R do
			local two = r + 1 < R
			local o1 = elem(base + r * K)
			local o2 = o1 + stride
			for t = 0, K - 1 do
				local ot = elem(base + t * K)
				local at = @E@ * t
				local sr, si = cload(L, o1 + at)
				local zr, zi = 0, 0
				if two then
					zr, zi = cload(L, o2 + at)
				end
				for u = 0, at - @E@, @E@ do
					-- subtract row(u) conj(L[t, u])
					local br, bi = cload(L, ot + u)
					local ar, ai = cload(L, o1 + u)
					sr -= ar * br + ai * bi
					si -= ai * br - ar * bi
					if two then
						local cr, ci = cload(L, o2 + u)
						zr -= cr * br + ci * bi
						zi -= ci * br - cr * bi
					end
				end
				local dt = load(L, ot + at)
				cstore(L, o1 + at, sr / dt, si / dt)
				if two then
					cstore(L, o2 + at, zr / dt, zi / dt)
				end
			end
			r += if two then 2 else 1
		end
		if R > K then
			buffer.writeu32(dpos, 4 * s, r0 + K)
			local s2 = u32(col2super, u32(rows, r0 + K))
			buffer.writei32(link, 4 * s, buffer.readi32(head, 4 * s2))
			buffer.writei32(head, 4 * s2, s)
		end
	end
	return true
end

-- Sparse Cholesky factorization P S P^T = L L^H of a Hermitian positive definite sparse
-- matrix (both triangles stored; the lower one is read after ordering). Options as the
-- real modules' sparse_chol: order ("amd", "rcm", "natural" or a permutation), relax and
-- reuse. F.definite is false if a pivot was not positive.
local function sparse_chol(S: Sparse, options: types.SparseCholOptions?): types.SparseCholesky
	local o: types.SparseCholOptions = options or {}
	assert(S.rows == S.cols, "sparse_chol: matrix must be square")
	local F = o.reuse :: any
	if F == nil or F.symbolic.ptr ~= S.colptr or F.symbolic.ind ~= S.rowind then
		local sym = graph.chol_analysis(graph.of(S), chol_order(S, o.order), { relax = o.relax })
		local n = S.rows
		F = {
			n = n,
			symbolic = sym,
			perm = sym.perm,
			values = buffer.create(@E@ * sym.nnz),
			definite = false,
			nnz = sym.nnz,
			madds = sym.madds,
			work = {
				rel = buffer.create(4 * n),
				head = buffer.create(4 * sym.nsuper),
				link = buffer.create(4 * sym.nsuper),
				dpos = buffer.create(4 * sym.nsuper),
				x = buffer.create(16 * n),
			},
		}
	end
	F.definite = chol_numeric(F.symbolic, S, F.values, F.work)
	return F
end

-- The solution of S x = b from sparse_chol's factorization (out may be b).
local function sparse_chol_solve(out: buffer?, F: types.SparseCholesky, b: buffer): buffer
	local Fa = F :: any
	local sym = Fa.symbolic
	local n = Fa.n
	local o = output(out, elem(n))
	local x = Fa.work.x -- (re, im) pairs of f64
	local perm, super, rowptr, rows, valptr = sym.perm, sym.super, sym.rowptr, sym.rows, sym.valptr
	local L = Fa.values
	for k = 0, n - 1 do
		local re, im = cload(b, elem(buffer.readi32(perm, 4 * k) - 1))
		buffer.writef64(x, 16 * k, re)
		buffer.writef64(x, 16 * k + 8, im)
	end
	local ns = sym.nsuper
	-- L y = P b
	for s = 0, ns - 1 do
		local c0: number = u32(super, s)
		local K: number = u32(super, s + 1) - c0
		local r0: number = u32(rowptr, s)
		local R: number = u32(rowptr, s + 1) - r0
		local base: number = u32(valptr, s)
		for t = 0, K - 1 do
			local ot = elem(base + t * K)
			local at = 16 * (c0 + t)
			local sr, si = buffer.readf64(x, at), buffer.readf64(x, at + 8)
			for u = 0, t - 1 do
				local ar, ai = cload(L, ot + @E@ * u)
				local xr, xi = buffer.readf64(x, 16 * (c0 + u)), buffer.readf64(x, 16 * (c0 + u) + 8)
				sr -= ar * xr - ai * xi
				si -= ar * xi + ai * xr
			end
			local dt = load(L, ot + @E@ * t)
			buffer.writef64(x, at, sr / dt)
			buffer.writef64(x, at + 8, si / dt)
		end
		-- the rows below, two at a time (each read of the block's solution feeding both)
		local stride = @E@ * K
		local r = K
		while r < R do
			local two = r + 1 < R
			local o1 = elem(base + r * K)
			local o2 = o1 + stride
			local sr, si, zr, zi = 0, 0, 0, 0
			for t = 0, K - 1 do
				local at = 16 * (c0 + t)
				local xr, xi = buffer.readf64(x, at), buffer.readf64(x, at + 8)
				local ar, ai = cload(L, o1 + @E@ * t)
				sr += ar * xr - ai * xi
				si += ar * xi + ai * xr
				if two then
					local br, bi = cload(L, o2 + @E@ * t)
					zr += br * xr - bi * xi
					zi += br * xi + bi * xr
				end
			end
			local row = 16 * u32(rows, r0 + r)
			buffer.writef64(x, row, buffer.readf64(x, row) - sr)
			buffer.writef64(x, row + 8, buffer.readf64(x, row + 8) - si)
			if two then
				row = 16 * u32(rows, r0 + r + 1)
				buffer.writef64(x, row, buffer.readf64(x, row) - zr)
				buffer.writef64(x, row + 8, buffer.readf64(x, row + 8) - zi)
				r += 2
			else
				r += 1
			end
		end
	end
	-- L^H z = y
	for s = ns - 1, 0, -1 do
		local c0: number = u32(super, s)
		local K: number = u32(super, s + 1) - c0
		local r0: number = u32(rowptr, s)
		local R: number = u32(rowptr, s + 1) - r0
		local base: number = u32(valptr, s)
		-- the block's columns take the rows below (x[t] -= sum of conj(L[r, t]) x[row r]),
		-- two columns at a time summed in locals
		if R > K then
			local stride = @E@ * K
			local t = 0
			while t < K do
				local two = t + 1 < K
				local sr, si, zr, zi = 0, 0, 0, 0
				local ol = elem(base + K * K + t)
				for q = r0 + K, r0 + R - 1 do
					local row = 16 * u32(rows, q)
					local yr, yi = buffer.readf64(x, row), buffer.readf64(x, row + 8)
					local ar, ai = cload(L, ol)
					sr += ar * yr + ai * yi
					si += ar * yi - ai * yr
					if two then
						local br, bi = cload(L, ol + @E@)
						zr += br * yr + bi * yi
						zi += br * yi - bi * yr
					end
					ol += stride
				end
				local at = 16 * (c0 + t)
				buffer.writef64(x, at, buffer.readf64(x, at) - sr)
				buffer.writef64(x, at + 8, buffer.readf64(x, at + 8) - si)
				if two then
					buffer.writef64(x, at + 16, buffer.readf64(x, at + 16) - zr)
					buffer.writef64(x, at + 24, buffer.readf64(x, at + 24) - zi)
					t += 2
				else
					t += 1
				end
			end
		end
		for t = K - 1, 0, -1 do
			local at = 16 * (c0 + t)
			local sr, si = buffer.readf64(x, at), buffer.readf64(x, at + 8)
			for u = t + 1, K - 1 do
				local ar, ai = cload(L, elem(base + u * K + t))
				local xr, xi = buffer.readf64(x, 16 * (c0 + u)), buffer.readf64(x, 16 * (c0 + u) + 8)
				sr -= ar * xr + ai * xi
				si -= ar * xi - ai * xr
			end
			local dt = load(L, elem(base + t * K + t))
			buffer.writef64(x, at, sr / dt)
			buffer.writef64(x, at + 8, si / dt)
		end
	end
	for k = 0, n - 1 do
		cstore(o, elem(buffer.readi32(perm, 4 * k) - 1), buffer.readf64(x, 16 * k), buffer.readf64(x, 16 * k + 8))
	end
	return o
end
