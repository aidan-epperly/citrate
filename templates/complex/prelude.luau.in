-- Types and small helpers shared by the parts. They are copied into each part rather than
-- imported, so calls to them are inlined (a call into another module costs several times
-- more); the generator drops the ones a part does not use.

--@optional
type Matrix = types.Matrix
--@optional
type LU = types.LU
--@optional
type QR = types.QR
--@optional
type QRP = types.QRP
--@optional
type Cholesky = types.Cholesky
--@optional
type Hessenberg = types.Hessenberg
--@optional
type Eigh = types.Eigh
--@optional
type Schur = types.Schur
--@optional
type Eig = types.Eig
--@optional
type Svd = types.Svd
--@optional
type Polar = types.Polar
--@optional
type LDL = types.LDL
--@optional
type GenEig = types.GenEig
--@optional
type QRFull = types.QRFull
--@optional
type RPCholesky = types.RPCholesky
--@optional
type RPQR = types.RPQR
--@optional
type FFTPlan = types.FFTPlan
--@optional
type Uplo = types.Uplo
--@optional
type Tridiagonal = types.Tridiagonal
--@optional
type TridiagonalLU = types.TridiagonalLU
--@optional
type TridiagonalLDL = types.TridiagonalLDL
--@optional
type Banded = types.Banded
--@optional
type BandedLU = types.BandedLU
--@optional
type BandedCholesky = types.BandedCholesky
--@optional
type Circulant = types.Circulant
--@optional
type Toeplitz = types.Toeplitz
--@optional
type Sparse = types.Sparse
--@optional
type BlockSparse = types.BlockSparse
--@optional
type SparseILU = types.SparseILU
--@optional
type SparseIC = types.SparseIC
--@optional
type Form = types.Form

--@inline
-- Element access. Values are stored at byte offsets: elem(i) is the offset of element i
-- (0-based) of an array, whose real part is at that offset and imaginary part at
-- imag(offset), and a routine on a matrix defines at(i, j) for entry (i, j). These helpers
-- are pasted in place by the generator (--@inline), so they cost nothing even where Luau
-- is interpreted.
--
-- The byte offset of element i.
local function elem(i: number): number
	return @E@ * i
end

--@inline
-- The byte offset of the imaginary part of the element at byte offset o.
local function imag(o: number): number
	return o + @W@
end

--@inline
-- The byte offset of element i of a real array (such as the singular values).
local function relem(i: number): number
	return @W@ * i
end

--@inline
-- The real number at byte offset o of x (a real or an imaginary part).
local function load(x: buffer, o: number): number
	return @READ@(x, o)
end

--@inline
-- Sets the real number at byte offset o of x to v.
local function store(x: buffer, o: number, v: number)
	@WRITE@(x, o, v)
end

--@inline
-- The element at byte offset o of x, as (re, im). (The cast: assigned to two existing
-- locals, the second read was typed number? by the type checker.)
local function cload(x: buffer, o: number): (number, number)
	return @READ@(x, o), @READ@(x, o + @W@) :: number
end

--@inline
-- Sets the element at byte offset o of x to re + i im.
local function cstore(x: buffer, o: number, re: number, im: number)
	local here = o
	@WRITE@(x, here, re)
	@WRITE@(x, here + @W@, im)
end

--@inline
-- x[o] += re + i im, for the element at byte offset o of x.
local function cadd_at(x: buffer, o: number, re: number, im: number)
	local here = o
	@WRITE@(x, here, @READ@(x, here) + re)
	@WRITE@(x, here + @W@, @READ@(x, here + @W@) + im)
end

--@inline
-- x[o] -= re + i im
local function csub_at(x: buffer, o: number, re: number, im: number)
	local here = o
	@WRITE@(x, here, @READ@(x, here) - re)
	@WRITE@(x, here + @W@, @READ@(x, here + @W@) - im)
end

--@inline
-- x[o] *= s, for a real s.
local function cmul_at(x: buffer, o: number, s: number)
	local here = o
	@WRITE@(x, here, @READ@(x, here) * s)
	@WRITE@(x, here + @W@, @READ@(x, here + @W@) * s)
end

--@inline
-- x[o] /= s, for a real s.
local function cdiv_at(x: buffer, o: number, s: number)
	local here = o
	@WRITE@(x, here, @READ@(x, here) / s)
	@WRITE@(x, here + @W@, @READ@(x, here + @W@) / s)
end

--@inline
-- Exchanges the elements at byte offsets o1 and o2 of x.
local function cswap_at(x: buffer, o1: number, o2: number)
	local s = o1
	local t = o2
	local re, im = @READ@(x, s), @READ@(x, s + @W@)
	@WRITE@(x, s, @READ@(x, t))
	@WRITE@(x, s + @W@, @READ@(x, t + @W@))
	@WRITE@(x, t, re)
	@WRITE@(x, t + @W@, im)
end

--@optional
-- An array of n zeros.
local function create(n: number): buffer
	return buffer.create(@E@ * n)
end

--@optional
-- The number of (complex) elements of x.
local function length(x: buffer): number
	return buffer.len(x) // @E@
end

--@optional
-- A new array of zeros as long as x.
local function similar(x: buffer): buffer
	return buffer.create(buffer.len(x))
end

--@optional
local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

--@optional
local function check_same(x: buffer, y: buffer)
	assert(buffer.len(x) == buffer.len(y), "arrays have different lengths")
end

--@include shared/norms_prelude.luau.in

--@optional
-- A rows by cols matrix of zeros.
local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(@E@ * rows * cols) }
end

--@optional
local function matoutput(out: Matrix?, rows: number, cols: number): Matrix
	if out == nil then
		return matrix(rows, cols)
	end
	assert(out.rows == rows and out.cols == cols, "output has the wrong shape")
	return out
end
--@optional
local function cread(x: buffer, i: number): (number, number)
	return @READ@(x, @E@ * i), @READ@(x, @E@ * i + @W@)
end

--@optional
local function cwrite(x: buffer, i: number, re: number, im: number)
	@WRITE@(x, @E@ * i, re)
	@WRITE@(x, @E@ * i + @W@, im)
end

--@optional
-- Element i (0-based) as (re, im), and its setter, for code shared with the real modules.
local eget = cread
--@optional
local eset = cwrite

--@include shared/solve_prelude.luau.in
