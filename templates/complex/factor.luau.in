--!strict
--!native
--!optimize 2
-- Generated by tools/generate.py from templates/complex/factor.luau.in. Edit the template, not this file.

-- @NAME@ factorizations and solves: LU, Cholesky, Householder QR, column-pivoted QR,
-- LDL^T, solve (with any factorization), determinants, factorization updates and
-- iterative refinement.
-- Indices are 1-based; arithmetic is done in double precision and rounded once per stored
-- value; every `out` argument may be nil, in which case a new result is allocated.
-- Functions marked (LAPACK's ...) are translations of LAPACK's reference routines
-- (modified BSD license; see licenses/LAPACK-LICENSE.txt).

local types = require("./types")
local complex64 = require("./complex64")
local array_part = require("./array_@TAG@")
local matrix_part = require("./matrix_@TAG@")
local axpy = array_part.axpy
local caxpy_pair = array_part.caxpy_pair
local dotc_pair = array_part.dotc_pair
local copy = array_part.copy
local fill_nan = array_part.fill_nan
local norm = array_part.norm
local scale = array_part.scale
local segment_norm = array_part.segment_norm
local sub = array_part.sub
local matcopy = matrix_part.matcopy
local matvec = matrix_part.matvec
local matvec_adjoint = matrix_part.matvec_adjoint

--@include complex/prelude.luau.in

-- LU factorization with partial pivoting (pivots chosen by |re| + |im|), in place: A is
-- overwritten with L and U (see types.LU) and returned as F.lu. lu_copy leaves A unchanged.
local function lu(A: Matrix, reuse: LU?): LU
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	local piv = int_array(n, if reuse then reuse.piv else nil)
	local sign = 1
	local singular = false
	for k = 0, n - 1 do
		local p, best = k, -1
		for i = k, n - 1 do
			local off = at(i, k)
			local v = math.abs(load(a, off)) + math.abs(load(a, imag(off)))
			if v > best then
				p, best = i, v
			end
		end
		pset(piv, k + 1, p + 1)
		if p ~= k then
			sign = -sign
			for j = 0, n - 1 do
				cswap_at(a, at(k, j), at(p, j))
			end
		end
		local pr, pi = cload(a, at(k, k))
		if pr == 0 and pi == 0 then
			singular = true
		else
			for i = k + 1, n - 1 do
				local off = at(i, k)
				local qr, qi = complex64.div(load(a, off), load(a, imag(off)), pr, pi)
				cstore(a, off, qr, qi)
			end
			for j = k + 1, n - 1 do
				local s = at(k, j)
				local br, bi = cload(a, s)
				for i = k + 1, n - 1 do
					local off, l = at(i, j), at(i, k)
					local lr, li = cload(a, l)
					csub_at(a, off, lr * br - li * bi, lr * bi + li * br)
				end
			end
		end
	end
	local F: LU = reuse or ({} :: any)
	F.lu, F.piv, F.sign, F.singular = A, piv, sign, singular
	return F
end

-- LU factorization of a copy of A; A is not modified. With reuse (an LU from an earlier
-- call, of a matrix of A's size), its arrays are refilled and it is returned: repeated
-- factorizations then allocate nothing.
local function lu_copy(A: Matrix, reuse: LU?): LU
	return lu(matcopy(reuse_matrix(if reuse then reuse.lu else nil, A), A), reuse)
end

-- Solves A x = b given F = lu(A).
local function lu_solve(out: buffer?, F: LU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.lu.rows
	assert(buffer.len(b) == elem(n), "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a, piv = F.lu.data, F.piv
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	for k = 0, n - 1 do
		local p = pget(piv, k + 1) - 1
		if p ~= k then
			cswap_at(o, elem(k), elem(p))
		end
	end
	for j = 0, n - 1 do
		local xr, xi = cload(o, elem(j))
		for i = j + 1, n - 1 do
			local off, l = elem(i), at(i, j)
			local lr, li = cload(a, l)
			csub_at(o, off, lr * xr - li * xi, lr * xi + li * xr)
		end
	end
	for j = n - 1, 0, -1 do
		local d = at(j, j)
		local xr, xi = complex64.div(load(o, elem(j)), load(o, imag(elem(j))), cload(a, d))
		cstore(o, elem(j), xr, xi)
		for i = 0, j - 1 do
			local off, u = elem(i), at(i, j)
			local ur, ui = cload(a, u)
			csub_at(o, off, ur * xr - ui * xi, ur * xi + ui * xr)
		end
	end
	return o
end

-- The inverse of a square matrix, in place (LAPACK's getrf + getri): A is overwritten
-- with A^-1 and returned. An error if A is exactly singular. Solving with solve (or a
-- factorization) is faster and more accurate than forming A^-1 and multiplying; use this
-- when the inverse itself is needed. inv_copy leaves A unchanged.
local function inv(A: Matrix): Matrix
	local F = lu(A)
	assert(not F.singular, "inv: matrix is singular")
	local n = A.rows
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	-- U := U^-1 (trti2): column j of the inverse is -u_jj^-1 times the inverted leading
	-- block times the old column.
	for j = 0, n - 1 do
		local ur, ui = complex64.inv(cload(a, at(j, j)))
		cstore(a, at(j, j), ur, ui)
		for k = 0, j - 1 do
			local tr, ti = cload(a, at(k, j))
			if tr ~= 0 or ti ~= 0 then
				for i = 0, k - 1 do
					local o, q = at(i, j), at(i, k)
					local qr, qi = cload(a, q)
					store(a, o, load(a, o) + tr * qr - ti * qi)
					store(a, imag(o), load(a, imag(o)) + tr * qi + ti * qr)
				end
				local dr, di = cload(a, at(k, k))
				cstore(a, at(k, j), tr * dr - ti * di, tr * di + ti * dr)
			end
		end
		for i = 0, j - 1 do
			local o = at(i, j)
			local xr, xi = cload(a, o)
			cstore(a, o, -(ur * xr - ui * xi), -(ur * xi + ui * xr))
		end
	end
	-- Solve X L = U^-1 for X = (P A)^-1, a column at a time from the right (getri).
	local wr, wi = table.create(n, 0), table.create(n, 0)
	for j = n - 1, 0, -1 do
		for i = j + 1, n - 1 do
			local o = at(i, j)
			wr[i + 1], wi[i + 1] = cload(a, o)
			cstore(a, o, 0, 0)
		end
		for k = j + 1, n - 1 do
			local cr, ci = wr[k + 1], wi[k + 1]
			if cr ~= 0 or ci ~= 0 then
				for i = 0, n - 1 do
					local o, q = at(i, j), at(i, k)
					local qr, qi = cload(a, q)
					csub_at(a, o, qr * cr - qi * ci, qr * ci + qi * cr)
				end
			end
		end
	end
	-- A^-1 = X P: undo the row interchanges as column interchanges, last first.
	for j = n - 2, 0, -1 do
		local p = pget(F.piv, j + 1) - 1
		if p ~= j then
			for i = 0, n - 1 do
				cswap_at(a, at(i, j), at(i, p))
			end
		end
	end
	return A
end

-- The inverse of a copy of A; A is not modified.
local function inv_copy(A: Matrix): Matrix
	return inv(matcopy(nil, A))
end

-- The determinant, from an LU factorization of a copy (A is not modified); see slogdet for large or small determinants.
local function det_pair(A: Matrix): (number, number)
	local F = lu_copy(A)
	local dr, di = F.sign, 0
	local n = A.rows
	for k = 0, n - 1 do
		local off = elem(k * n + k)
		dr, di = complex64.mul(dr, di, cload(F.lu.data, off))
	end
	return dr, di
end

-- Cholesky

-- Cholesky factorization A = L L^H of a Hermitian positive definite matrix, in place:
-- the lower triangle of A is overwritten with L (whose diagonal is real) and returned as
-- F.chol. Only the lower triangle of A is read, and only the real parts of its diagonal;
-- the strictly upper triangle is left as it was. If A is not positive definite,
-- F.definite is false and A is partly overwritten. chol_copy leaves A unchanged.
local function chol(A: Matrix, reuse: Cholesky?): Cholesky
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	for j = 0, n - 1 do
		local diag = at(j, j)
		local d = load(a, diag)
		if not (d > 0) then
			local F: Cholesky = reuse or ({} :: any)
			F.chol, F.definite = A, false
			return F
		end
		local ljj = math.sqrt(d)
		cstore(a, diag, ljj, 0)
		for i = j + 1, n - 1 do
			cdiv_at(a, at(i, j), ljj)
		end
		-- Subtract the new column's outer product, l l^H, from the trailing lower triangle.
		for c = j + 1, n - 1 do
			local s = at(c, j)
			-- conj(L[c, j])
			local cr, ci = load(a, s), -load(a, imag(s))
			for i = c, n - 1 do
				local off, l = at(i, c), at(i, j)
				local lr, li = cload(a, l)
				csub_at(a, off, lr * cr - li * ci, lr * ci + li * cr)
			end
		end
	end
	local F: Cholesky = reuse or ({} :: any)
	F.chol, F.definite = A, true
	return F
end

-- Cholesky factorization of a copy of A; A is not modified.
local function chol_copy(A: Matrix, reuse: Cholesky?): Cholesky
	return chol(matcopy(reuse_matrix(if reuse then reuse.chol else nil, A), A), reuse)
end

-- The lower triangular factor L, with zeros above the diagonal.
local function chol_l(out: Matrix?, F: Cholesky): Matrix
	local n = F.chol.rows
	local o = matoutput(out, n, n)
	local a, l = F.chol.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = elem(j * n + i)
			if i >= j then
				cstore(l, off, load(a, off), load(a, imag(off)))
			else
				cstore(l, off, 0, 0)
			end
		end
	end
	return o
end

-- Solves A x = b given F = chol(A). b is not modified unless it is passed as out.
local function chol_solve(out: buffer?, F: Cholesky, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local n = F.chol.rows
	assert(buffer.len(b) == elem(n), "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = F.chol.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	-- L y = b (the diagonal of L is real)
	for j = 0, n - 1 do
		local d = load(a, at(j, j))
		local yr, yi = load(o, elem(j)) / d, load(o, imag(elem(j))) / d
		cstore(o, elem(j), yr, yi)
		for i = j + 1, n - 1 do
			local off, l = elem(i), at(i, j)
			local lr, li = cload(a, l)
			csub_at(o, off, lr * yr - li * yi, lr * yi + li * yr)
		end
	end
	-- L^H x = y, a conjugated dot product down each column of L.
	for j = n - 1, 0, -1 do
		local sr, si = cload(o, elem(j))
		for i = j + 1, n - 1 do
			local l = at(i, j)
			local lr, li = cload(a, l)
			local xr, xi = cload(o, elem(i))
			sr -= lr * xr + li * xi
			si -= lr * xi - li * xr
		end
		local d = load(a, at(j, j))
		cstore(o, elem(j), sr / d, si / d)
	end
	return o
end

-- Householder QR

-- Unit roundoff of the storage precision.
local EPS = @EPS@

-- Applies I - t v v^H, t = tr + i ti, to the `len` values of x starting at byte offset
-- `xs`. v starts at byte offset `vs` of `a`; its first entry is an implicit 1.
local function reflect(a: buffer, vs: number, len: number, tr: number, ti: number, x: buffer, xs: number)
	local wr, wi = cload(x, xs)
	for i = 1, len - 1 do
		local v, y = vs + elem(i), xs + elem(i)
		local vr, vi = cload(a, v)
		local yr, yi = cload(x, y)
		wr += vr * yr + vi * yi
		wi += vr * yi - vi * yr
	end
	if wr == 0 and wi == 0 then
		return
	end
	wr, wi = tr * wr - ti * wi, tr * wi + ti * wr
	csub_at(x, xs, wr, wi)
	for i = 1, len - 1 do
		local v, y = vs + elem(i), xs + elem(i)
		local vr, vi = cload(a, v)
		csub_at(x, y, wr * vr - wi * vi, wr * vi + wi * vr)
	end
end

-- Turns the `len` values of `a` starting at byte offset `diag` into a Householder
-- reflector, in place: the real beta at `diag` and v below it (its leading 1 is
-- implicit). Stores tau as element k of `tau` and returns it; tau = 0 (H = I) when the
-- value at `diag` is already real and there is nothing below it to zero.
local function householder(a: buffer, diag: number, len: number, tau: buffer, k: number): (number, number)
	local ar, ai = cload(a, diag)
	local xnorm = segment_norm(a, diag + elem(1), 2 * (len - 1))
	if xnorm == 0 and ai == 0 then
		cstore(tau, elem(k), 0, 0)
		return 0, 0
	end
	local beta = hypot3(ar, ai, xnorm)
	if ar >= 0 then
		beta = -beta
	end
	cstore(tau, elem(k), (beta - ar) / beta, -ai / beta)
	-- Re(alpha) and beta have opposite signs, so alpha - beta cannot cancel.
	local dr = ar - beta
	for off = diag + elem(1), diag + elem(len - 1), elem(1) do
		local vr, vi = complex64.div(load(a, off), load(a, imag(off)), dr, ai)
		cstore(a, off, vr, vi)
	end
	cstore(a, diag, beta, 0)
	return cload(tau, elem(k))
end

-- Solves R z = y in place on the first r entries of y, where R is the leading r by r
-- block of the upper triangle stored in `a` (a matrix with m rows).
local function back_substitute(a: buffer, m: number, r: number, y: buffer)
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * m + i)
	end
	for j = r - 1, 0, -1 do
		local d = at(j, j)
		local rr, ri = cload(a, d)
		assert(rr ~= 0 or ri ~= 0, "matrix is rank deficient")
		local yr, yi = complex64.div(load(y, elem(j)), load(y, imag(elem(j))), rr, ri)
		cstore(y, elem(j), yr, yi)
		for i = 0, j - 1 do
			local off, u = elem(i), at(i, j)
			local ur, ui = cload(a, u)
			csub_at(y, off, ur * yr - ui * yi, ur * yi + ui * yr)
		end
	end
end

-- Householder QR factorization, in place: A is overwritten (see types.QR for the layout)
-- and returned as F.qr. The diagonal of R is real. qr_copy leaves A unchanged.
local function qr(A: Matrix, reuse: QR?): QR
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * m + i)
	end
	local tau = if reuse and length(reuse.tau) == kmax then reuse.tau else create(kmax)
	for k = 0, kmax - 1 do
		local diag = at(k, k)
		local tr, ti = householder(a, diag, m - k, tau, k)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, at(k, j))
			end
		end
	end
	local F: QR = reuse or ({} :: any)
	F.qr, F.tau = A, tau
	return F
end

-- Householder QR factorization of a copy of A; A is not modified.
local function qr_copy(A: Matrix, reuse: QR?): QR
	return qr(matcopy(reuse_matrix(if reuse then reuse.qr else nil, A), A), reuse)
end

-- x := Q^H x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_qh(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == elem(m), "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = 0, length(tau) - 1 do
		local tr, ti = cload(tau, elem(k))
		reflect(a, elem(k * m + k), m - k, tr, -ti, x, elem(k))
	end
	return x
end

-- x := Q x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_q(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == elem(m), "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = length(tau) - 1, 0, -1 do
		local tr, ti = cload(tau, elem(k))
		reflect(a, elem(k * m + k), m - k, tr, ti, x, elem(k))
	end
	return x
end

-- The min(rows, cols) by cols upper triangular factor R. Also accepts a QRP factorization.
local function qr_r(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, kmax, n)
	local a, r = F.qr.data, o.data
	for j = 0, n - 1 do
		for i = 0, kmax - 1 do
			local s, t = elem(j * m + i), elem(j * kmax + i)
			if i <= j then
				cstore(r, t, load(a, s), load(a, imag(s)))
			else
				cstore(r, t, 0, 0)
			end
		end
	end
	return o
end

-- The rows by min(rows, cols) factor Q with orthonormal columns (the thin Q). Also
-- accepts a QRP factorization.
local function qr_q(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, m, kmax)
	local a, tau, q = F.qr.data, F.tau, o.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * m + i)
	end
	buffer.fill(q, 0, 0)
	for c = 0, kmax - 1 do
		store(q, at(c, c), 1)
		-- Reflectors after column c leave the unit vector e_c unchanged.
		for k = c, 0, -1 do
			local tr, ti = cload(tau, elem(k))
			reflect(a, at(k, k), m - k, tr, ti, q, at(k, c))
		end
	end
	return o
end

-- Least squares: the x minimizing |A x - b| for A with rows >= cols and full column
-- rank, given F = qr(A). b is not modified. Also returns the residual norm |A x - b|.
local function qr_solve(out: buffer?, F: QR, b: buffer): (buffer, number)
	local m, n = F.qr.rows, F.qr.cols
	assert(m >= n, "least squares needs at least as many rows as columns")
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, n, y)
	local o = output(out, elem(n))
	buffer.copy(o, 0, y, 0, elem(n))
	return o, segment_norm(y, elem(n), 2 * (m - n))
end

-- Column-pivoted QR

-- Householder QR with column pivoting, A P = Q R, in place: A is overwritten as in qr and
-- returned as F.qr; column j of A P is column perm[j] of A. Each step moves the remaining
-- column of largest norm to the front, so |R_11| >= |R_22| >= ... and small trailing
-- diagonal entries reveal the numerical rank. qrp_copy leaves A unchanged. With tol, it
-- stops once every remaining column's norm is at most tol |R_11| (a truncated factorization,
-- as for an interpolative decomposition): F.rank is the number of steps taken, and only
-- the first F.rank rows of R are final.
local function qrp(A: Matrix, reuse: QRP?, tol: number?): QRP
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * m + i)
	end
	local tau = if reuse and length(reuse.tau) == kmax then reuse.tau else create(kmax)
	local perm = int_array(n, if reuse then reuse.perm else nil)
	-- Norms of the unfactored part of each column (partial), and the norm at the last
	-- recomputation (reference), for LAPACK's safeguarded downdating.
	local partial, reference = table.create(n, 0), table.create(n, 0)
	for j = 1, n do
		pset(perm, j, j)
		local v = segment_norm(a, elem((j - 1) * m), 2 * m)
		partial[j], reference[j] = v, v
	end
	local recompute = math.sqrt(EPS)
	local rank, first = kmax, 0
	for k = 0, kmax - 1 do
		local p, best = k, -1
		for j = k, n - 1 do
			if partial[j + 1] > best then
				p, best = j, partial[j + 1]
			end
		end
		if k == 0 then
			first = best
		elseif tol and best <= tol * first then
			-- the rest is negligible: stop, leaving its reflectors as the identity
			rank = k
			buffer.fill(tau, elem(k), 0)
			break
		end
		if p ~= k then
			for i = 0, m - 1 do
				cswap_at(a, at(i, k), at(i, p))
			end
			local pk, pp = pget(perm, k + 1), pget(perm, p + 1)
			pset(perm, k + 1, pp)
			pset(perm, p + 1, pk)
			partial[p + 1], reference[p + 1] = partial[k + 1], reference[k + 1]
		end

		local diag = at(k, k)
		local tr, ti = householder(a, diag, m - k, tau, k)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, at(k, j))
			end
		end

		-- Remove row k from the remaining partial norms. When cancellation would leave too
		-- few correct digits, recompute the norm instead.
		for j = k + 1, n - 1 do
			local v = partial[j + 1]
			if v ~= 0 then
				local off = at(k, j)
				local ratio = complex64.abs(cload(a, off)) / v
				local left = math.max(0, 1 - ratio * ratio)
				local drift = v / reference[j + 1]
				if left * drift * drift <= recompute then
					local fresh = segment_norm(a, off + elem(1), 2 * (m - k - 1))
					partial[j + 1], reference[j + 1] = fresh, fresh
				else
					partial[j + 1] = v * math.sqrt(left)
				end
			end
		end
	end
	local F: QRP = reuse or ({} :: any)
	F.qr, F.tau, F.perm, F.rank = A, tau, perm, rank
	return F
end

-- Column-pivoted QR of a copy of A; A is not modified.
local function qrp_copy(A: Matrix, reuse: QRP?, tol: number?): QRP
	return qrp(matcopy(reuse_matrix(if reuse then reuse.qr else nil, A), A), reuse, tol)
end

-- Numerical rank: the number of leading diagonal entries of R with |R_kk| > tol |R_11|.
-- The default tol is max(rows, cols) times the unit roundoff of the storage precision.
local function qrp_rank(F: QRP, tol: number?): number
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n, F.rank or math.huge)
	if kmax == 0 then
		return 0
	end
	local a = F.qr.data
	local limit = (tol or math.max(m, n) * EPS) * complex64.abs(cload(a, 0))
	for k = 0, kmax - 1 do
		local d = elem(k * m + k)
		if not (complex64.abs(cload(a, d)) > limit) then
			return k
		end
	end
	return kmax
end

-- Least squares for any shape and rank, given F = qrp(A): the basic solution, which
-- uses only the first r = qrp_rank(F, tol) pivot columns and sets the other variables
-- to zero. b is not modified. Also returns the residual norm |A x - b| and r.
local function qrp_solve(out: buffer?, F: QRP, b: buffer, tol: number?): (buffer, number, number)
	local m, n = F.qr.rows, F.qr.cols
	local r = qrp_rank(F, tol)
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, r, y)
	local o = output(out, elem(n))
	buffer.fill(o, 0, 0)
	for j = 1, r do
		local s, t = elem(j - 1), elem(pget(F.perm, j) - 1)
		cstore(o, t, load(y, s), load(y, imag(s)))
	end
	return o, segment_norm(y, elem(r), 2 * (m - r)), r
end

-- The minimum-norm least-squares solution x = A^+ b for any shape and rank, given
-- F = svd(A) with its vectors: x = sum over i <= r of v_i (u_i^H b) / s_i, where r counts
-- the singular values above tol * s_1 (default tol = max(rows, cols) * eps, as for
-- qrp_rank); smaller ones are treated as zero. Unlike qrp_solve's basic solution, x is the
-- shortest of all least-squares solutions. b is not modified. Also returns the residual
-- norm |A x - b| and r. NaN singular values (from non-finite input) give a NaN x.
local function svd_solve(out: buffer?, F: Svd, b: buffer, tol: number?): (buffer, number, number)
	local U, V = F.u, F.v
	assert(U ~= nil and V ~= nil, "svd_solve needs the singular vectors")
	local m, n, k = U.rows, V.rows, U.cols
	assert(length(b) == m, "b has the wrong length")
	local s, u, v = F.values, U.data, V.data
	local o = output(out, elem(n))
	if k > 0 and load(s, 0) ~= load(s, 0) then
		fill_nan(o, 0, 2 * n)
		return o, 0 / 0, 0
	end
	local limit = (tol or math.max(m, n) * EPS) * (if k > 0 then load(s, 0) else 0)
	local r = 0
	while r < k and load(s, relem(r)) > limit do
		r += 1
	end
	-- The residual b - U_r U_r^H b, projected one column at a time, and x.
	local rr, ri = table.create(m, 0), table.create(m, 0)
	for i = 1, m do
		rr[i], ri[i] = cload(b, elem(i - 1))
	end
	local xr, xi = table.create(n, 0), table.create(n, 0)
	for j = 0, r - 1 do
		local col = elem(j * m)
		-- c = u_j^H res
		local cr, ci = 0, 0
		for i = 0, m - 1 do
			local ur, ui = cload(u, col + elem(i))
			cr += ur * rr[i + 1] + ui * ri[i + 1]
			ci += ur * ri[i + 1] - ui * rr[i + 1]
		end
		for i = 0, m - 1 do
			local ur, ui = cload(u, col + elem(i))
			rr[i + 1] -= cr * ur - ci * ui
			ri[i + 1] -= cr * ui + ci * ur
		end
		local sj = load(s, relem(j))
		local wr, wi = cr / sj, ci / sj
		local vcol = elem(j * n)
		for i = 0, n - 1 do
			local vr, vi = cload(v, vcol + elem(i))
			xr[i + 1] += wr * vr - wi * vi
			xi[i + 1] += wr * vi + wi * vr
		end
	end
	for i = 1, n do
		cstore(o, elem(i - 1), xr[i], xi[i])
	end
	local big = 0
	for i = 1, m do
		big = math.max(big, math.abs(rr[i]), math.abs(ri[i]))
	end
	local ss = 0
	if big > 0 then
		for i = 1, m do
			ss += (rr[i] / big) ^ 2 + (ri[i] / big) ^ 2
		end
	end
	return o, big * math.sqrt(ss), r
end
--@c64 local det = det_pair
--@c32
--@c32 local function det(A: Matrix): vector
--@c32 	return vector.create(det_pair(A))
--@c32 end

-- The phase (a unit complex number) and the log of the absolute value of det(A),
-- without overflow: returns (phase re, phase im, log |det|), with phase 0 and log -inf
-- for a singular matrix.
local function slogdet_pair(A: Matrix): (number, number, number)
	local F = lu_copy(A)
	local n = A.rows
	local pr, pi, logabs = F.sign, 0, 0
	for k = 0, n - 1 do
		local ur, ui = cread(F.lu.data, k * n + k)
		local a = complex64.abs(ur, ui)
		if a == 0 then
			return 0, 0, -math.huge
		end
		pr, pi = complex64.mul(pr, pi, ur / a, ui / a)
		logabs += math.log(a)
	end
	-- Renormalize the phase against rounding drift.
	local a = complex64.abs(pr, pi)
	return pr / a, pi / a, logabs
end

-- Solves A^H x = b given F = lu(A) (P A = L U, so A^H = U^H L^H P).
local function lu_solve_adjoint(out: buffer?, F: LU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.lu.rows
	assert(buffer.len(b) == elem(n), "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = F.lu.data
	-- U^H y = b, forward.
	for j = 0, n - 1 do
		local sr, si = cread(o, j)
		for i = 0, j - 1 do
			local ur, ui = cread(a, j * n + i)
			local yr, yi = cread(o, i)
			-- s -= conj(u_ij) y_i
			sr -= ur * yr + ui * yi
			si -= ur * yi - ui * yr
		end
		local dr, di = cread(a, j * n + j)
		cwrite(o, j, complex64.div(sr, si, dr, -di))
	end
	-- L^H z = y, backward (unit diagonal).
	for j = n - 1, 0, -1 do
		local sr, si = cread(o, j)
		for i = j + 1, n - 1 do
			local lr, li = cread(a, j * n + i)
			local zr, zi = cread(o, i)
			sr -= lr * zr + li * zi
			si -= lr * zi - li * zr
		end
		cwrite(o, j, sr, si)
	end
	-- x = P^T z: the interchanges in reverse.
	for k = n - 1, 0, -1 do
		local p = pget(F.piv, k + 1) - 1
		if p ~= k then
			local xr, xi = cread(o, k)
			cwrite(o, k, cread(o, p))
			cwrite(o, p, xr, xi)
		end
	end
	return o
end

-- Helpers for the condition estimator: the 1-norm of a vector (sum of moduli), the
-- unit-modulus signs x / |x| of its entries (1 for zero), the index (1-based) and
-- modulus of its largest entry, the real part of the inner product, and e_j.
local function asum(x: buffer): number
	local s = 0
	for i = 0, length(x) - 1 do
		s += complex64.abs(cread(x, i))
	end
	return s
end

local function signs(x: buffer): buffer
	local o = buffer.create(buffer.len(x))
	for i = 0, length(x) - 1 do
		local r, m = cread(x, i)
		local a = complex64.abs(r, m)
		if a == 0 then
			cwrite(o, i, 1, 0)
		else
			cwrite(o, i, r / a, m / a)
		end
	end
	return o
end

local function argmax(x: buffer): (number, number)
	local best, at = -1, 1
	for i = 0, length(x) - 1 do
		local v = complex64.abs(cread(x, i))
		if v > best then
			best, at = v, i + 1
		end
	end
	return best, at
end

local function unit(n: number, j: number): buffer
	local e = create(n)
	store(e, elem(j - 1), 1)
	return e
end
--@c64 local slogdet = slogdet_pair
--@c32
--@c32 -- (phase as a vector, log |det|)
--@c32 local function slogdet(A: Matrix): (vector, number)
--@c32 	local pr, pi, logabs = slogdet_pair(A)
--@c32 	return vector.create(pr, pi, 0), logabs
--@c32 end

-- Hermitian indefinite factorization (Bunch-Kaufman).

-- The Bunch-Kaufman factorization P A P^T = L D L^H of a Hermitian (possibly
-- indefinite) matrix, in place (LAPACK's hetf2, lower): only the lower triangle of A
-- (and the real parts of its diagonal) is read; it is overwritten with L (unit lower
-- triangular, below the diagonal) and the block diagonal D (real 1 by 1 blocks and
-- Hermitian 2 by 2 blocks). piv is as in LAPACK's ipiv, 1-based: pget(piv, k) > 0 for a 1 by
-- 1 block (row k was swapped with pget(piv, k)), pset(piv, k, pget(piv, k+1) < 0 for a 2 by 2 block (row)
-- k+1 was swapped with -pget(piv, k)). ldl_copy leaves A unchanged.
local function ldl(A: Matrix, reuse: LDL?): LDL
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	--@inline
	-- Entry (i, j) as (re, im), its setter, and its modulus.
	local function get(i: number, j: number): (number, number)
		return cload(a, at(i, j))
	end
	--@inline
	local function set(i: number, j: number, re: number, im: number)
		cstore(a, at(i, j), re, im)
	end
	--@inline
	local function mag(i: number, j: number): number
		return complex64.abs(get(i, j))
	end
	local piv = int_array(n, if reuse then reuse.piv else nil)
	local singular = false
	local alpha = (1 + math.sqrt(17)) / 8
	local k = 0
	while k < n do
		local kstep = 1
		local kp = k
		local absakk = math.abs(load(a, at(k, k)))
		local imax, colmax = k, 0
		for i = k + 1, n - 1 do
			local v = mag(i, k)
			if v > colmax then
				imax, colmax = i, v
			end
		end
		if math.max(absakk, colmax) == 0 then
			singular = true
			store(a, imag(at(k, k)), 0)
		else
			if absakk < alpha * colmax then
				local rowmax = 0
				for j = k, imax - 1 do
					rowmax = math.max(rowmax, mag(imax, j))
				end
				for j = imax + 1, n - 1 do
					rowmax = math.max(rowmax, mag(j, imax))
				end
				if absakk >= alpha * colmax * (colmax / rowmax) then
					kp = k
				elseif math.abs(load(a, at(imax, imax))) >= alpha * rowmax then
					kp = imax
				else
					kp = imax
					kstep = 2
				end
			end
			local kk = k + kstep - 1
			if kp ~= kk then
				-- Interchange rows and columns kk and kp of the trailing matrix (with
				-- the conjugations a Hermitian matrix in lower storage needs).
				for i = kp + 1, n - 1 do
					cswap_at(a, at(i, kk), at(i, kp))
				end
				for j = kk + 1, kp - 1 do
					local xr, xi = get(j, kk)
					local yr, yi = get(kp, j)
					set(j, kk, yr, -yi)
					set(kp, j, xr, -xi)
				end
				local mr, mi = get(kp, kk)
				set(kp, kk, mr, -mi)
				local d1 = load(a, at(kk, kk))
				local d2 = load(a, at(kp, kp))
				set(kk, kk, d2, 0)
				set(kp, kp, d1, 0)
				if kstep == 2 then
					store(a, imag(at(k, k)), 0)
					cswap_at(a, at(k + 1, k), at(kp, k))
				end
			else
				store(a, imag(at(k, k)), 0)
				if kstep == 2 then
					store(a, imag(at(k + 1, k + 1)), 0)
				end
			end
			if kstep == 1 then
				-- A(k+1:, k+1:) -= x x^H / d (d real), then x /= d.
				local r1 = 1 / load(a, at(k, k))
				for j = k + 1, n - 1 do
					local xjr, xji = get(j, k)
					local fr, fi = r1 * xjr, -r1 * xji
					if fr ~= 0 or fi ~= 0 then
						for i = j, n - 1 do
							local xr, xi = get(i, k)
							csub_at(a, at(i, j), xr * fr - xi * fi, xr * fi + xi * fr)
						end
						store(a, imag(at(j, j)), 0)
					end
				end
				for i = k + 1, n - 1 do
					cmul_at(a, at(i, k), r1)
				end
			elseif k < n - 2 then
				local er, ei = get(k + 1, k)
				local d = complex64.abs(er, ei)
				local d11 = load(a, at(k + 1, k + 1)) / d
				local d22 = load(a, at(k, k)) / d
				local tt = 1 / (d11 * d22 - 1)
				local d21r, d21i = er / d, ei / d
				d = tt / d
				for j = k + 2, n - 1 do
					local ajr, aji = get(j, k)
					local bjr, bji = get(j, k + 1)
					-- wk = d (d11 a_j - d21 b_j); wkp1 = d (d22 b_j - conj(d21) a_j)
					local wkr = d * (d11 * ajr - (d21r * bjr - d21i * bji))
					local wki = d * (d11 * aji - (d21r * bji + d21i * bjr))
					local wpr = d * (d22 * bjr - (d21r * ajr + d21i * aji))
					local wpi = d * (d22 * bji - (d21r * aji - d21i * ajr))
					for i = j, n - 1 do
						local xo, yo = at(i, k), at(i, k + 1)
						local xr, xi = cload(a, xo)
						local yr, yi = cload(a, yo)
						-- c -= x conj(wk) + y conj(wkp1)
						csub_at(a, at(i, j), xr * wkr + xi * wki + yr * wpr + yi * wpi, xi * wkr - xr * wki + yi * wpr - yr * wpi)
					end
					set(j, k, wkr, wki)
					set(j, k + 1, wpr, wpi)
					store(a, imag(at(j, j)), 0)
				end
			end
		end
		if kstep == 1 then
			pset(piv, k + 1, kp + 1)
		else
			pset(piv, k + 1, -(kp + 1))
			pset(piv, k + 2, -(kp + 1))
		end
		k += kstep
	end
	local F: LDL = reuse or ({} :: any)
	F.ldl, F.piv, F.singular = A, piv, singular
	return F
end

-- The factorization of a copy of A; A is not modified.
local function ldl_copy(A: Matrix, reuse: LDL?): LDL
	return ldl(matcopy(reuse_matrix(if reuse then reuse.ldl else nil, A), A), reuse)
end

-- Solves A x = b given F = ldl(A) (LAPACK's hetrs).
local function ldl_solve(out: buffer?, F: LDL, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.ldl.rows
	assert(buffer.len(b) == elem(n), "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a, piv = F.ldl.data, F.piv
	--@inline
	local function at(i: number, j: number): number
		return @E@ * (j * n + i)
	end
	--@inline
	-- Entry (i, j) of the factorization as (re, im); entry i of x, its setter, and the
	-- exchange of entries i and j.
	local function get(i: number, j: number): (number, number)
		return cload(a, at(i, j))
	end
	--@inline
	local function x(i: number): (number, number)
		return cload(o, elem(i))
	end
	--@inline
	local function setx(i: number, re: number, im: number)
		cstore(o, elem(i), re, im)
	end
	--@inline
	local function swapx(i: number, j: number)
		cswap_at(o, elem(i), elem(j))
	end
	-- L D y = P b.
	local k = 0
	while k < n do
		if pget(piv, k + 1) > 0 then
			swapx(k, pget(piv, k + 1) - 1)
			local xr, xi = x(k)
			for i = k + 1, n - 1 do
				local l = at(i, k)
				local lr, li = cload(a, l)
				csub_at(o, elem(i), lr * xr - li * xi, lr * xi + li * xr)
			end
			local d = load(a, at(k, k))
			setx(k, xr / d, xi / d)
			k += 1
		else
			swapx(k + 1, -pget(piv, k + 1) - 1)
			local xr, xi = x(k)
			local yr, yi = x(k + 1)
			for i = k + 2, n - 1 do
				local l, m = at(i, k), at(i, k + 1)
				local lr, li = cload(a, l)
				local mr, mi = cload(a, m)
				csub_at(o, elem(i), lr * xr - li * xi + mr * yr - mi * yi, lr * xi + li * xr + mr * yi + mi * yr)
			end
			local er, ei = get(k + 1, k)
			local dkk = load(a, at(k, k)) -- diagonal entries of D are real
			local dk1 = load(a, at(k + 1, k + 1))
			local akm1r, akm1i = complex64.div(dkk, 0, er, -ei)
			local akr, aki = complex64.div(dk1, 0, er, ei)
			local dr, di = complex64.mul(akm1r, akm1i, akr, aki)
			dr -= 1
			local bkm1r, bkm1i = complex64.div(xr, xi, er, -ei)
			local bkr, bki = complex64.div(yr, yi, er, ei)
			local t1r, t1i = complex64.mul(akr, aki, bkm1r, bkm1i)
			local t2r, t2i = complex64.mul(akm1r, akm1i, bkr, bki)
			local zr, zi = complex64.div(t1r - bkr, t1i - bki, dr, di)
			setx(k, zr, zi)
			zr, zi = complex64.div(t2r - bkm1r, t2i - bkm1i, dr, di)
			setx(k + 1, zr, zi)
			k += 2
		end
	end
	-- L^H x = y, then undo the interchanges.
	local function back(k0: number)
		local sr, si = x(k0)
		for i = k + 1, n - 1 do
			local l = at(i, k0)
			local lr, li = cload(a, l)
			local cr, ci = x(i)
			-- s -= conj(l) c
			sr -= lr * cr + li * ci
			si -= lr * ci - li * cr
		end
		setx(k0, sr, si)
	end
	k = n - 1
	while k >= 0 do
		back(k)
		if pget(piv, k + 1) > 0 then
			swapx(k, pget(piv, k + 1) - 1)
			k -= 1
		else
			back(k - 1)
			swapx(k, -pget(piv, k + 1) - 1)
			k -= 2
		end
	end
	return o
end

-- The inertia of A from F = ldl(A): the numbers of positive, negative and zero
-- eigenvalues. Each 2 by 2 block has one of each sign.
local function ldl_inertia(F: LDL): (number, number, number)
	local n = F.ldl.rows
	local pos, neg, zero = 0, 0, 0
	local k = 0
	while k < n do
		if pget(F.piv, k + 1) > 0 then
			local d = load(F.ldl.data, elem(k * n + k))
			if d > 0 then
				pos += 1
			elseif d < 0 then
				neg += 1
			else
				zero += 1
			end
			k += 1
		else
			pos += 1
			neg += 1
			k += 2
		end
	end
	return pos, neg, zero
end

