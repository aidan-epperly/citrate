-- Sparse product kernels (generated by tools/gen_sparse_kernels.py; do not edit).
--   spk.gather(o, S, x, sg)  o := S^H (sg = -1) or S^T (sg = 1) x (a gather down the columns of S)
--   spk.scatter(acc, S, x)  acc[row] += S[row, j] x[j] (acc: f64, re, im per row, zeroed)
--   spk.block[b].mv(o, B, x)   o := B x for a block sparse B with b by b blocks
--   spk.block[b].mvt(acc, B, x)  acc += B^H x (acc as for scatter)
--   spk.block[b].jacobi(o, inv, r, nb)  o := blockdiag(inv) r for nb f64 inverse blocks
--   spk.block[b].product(cv, xv, yv, plan, count)  block products for multigrid (real)
-- Unrolled by 4; blocks are handled one per iteration (see the cost model in the
-- generator).
local spk: any = { block = {} }
do
	function spk.gather(o: buffer, S: Sparse, x: buffer, sg: number)
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local p0 = buffer.readu32(colptr, 0)
		for j = 0, S.cols - 1 do
			local p1 = buffer.readu32(colptr, 4 * j + 4)
			local pu = p1 - (p1 - p0) % 4
			local sr, si = 0, 0
			for p = p0, pu - 1, 4 do
				local v, c = @E@ * p, 4 * p
				do
					local r = @E@ * buffer.readu32(rowind, c + 0)
					local ar, ai = @READ@(vals, v + @E@ * 0), sg * @READ@(vals, v + @E@ * 0 + @W@)
					local xr, xi = @READ@(x, r), @READ@(x, r + @W@)
					sr += ar * xr - ai * xi
					si += ar * xi + ai * xr
				end
				do
					local r = @E@ * buffer.readu32(rowind, c + 4)
					local ar, ai = @READ@(vals, v + @E@ * 1), sg * @READ@(vals, v + @E@ * 1 + @W@)
					local xr, xi = @READ@(x, r), @READ@(x, r + @W@)
					sr += ar * xr - ai * xi
					si += ar * xi + ai * xr
				end
				do
					local r = @E@ * buffer.readu32(rowind, c + 8)
					local ar, ai = @READ@(vals, v + @E@ * 2), sg * @READ@(vals, v + @E@ * 2 + @W@)
					local xr, xi = @READ@(x, r), @READ@(x, r + @W@)
					sr += ar * xr - ai * xi
					si += ar * xi + ai * xr
				end
				do
					local r = @E@ * buffer.readu32(rowind, c + 12)
					local ar, ai = @READ@(vals, v + @E@ * 3), sg * @READ@(vals, v + @E@ * 3 + @W@)
					local xr, xi = @READ@(x, r), @READ@(x, r + @W@)
					sr += ar * xr - ai * xi
					si += ar * xi + ai * xr
				end
			end
			for p = pu, p1 - 1 do
				local r = @E@ * buffer.readu32(rowind, 4 * p)
				local ar, ai = @READ@(vals, @E@ * p), sg * @READ@(vals, @E@ * p + @W@)
				local xr, xi = @READ@(x, r), @READ@(x, r + @W@)
				sr += ar * xr - ai * xi
				si += ar * xi + ai * xr
			end
			@WRITE@(o, @E@ * j, sr)
			@WRITE@(o, @E@ * j + @W@, si)
			p0 = p1
		end
	end

	function spk.scatter(acc: buffer, S: Sparse, x: buffer)
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local p0 = buffer.readu32(colptr, 0)
		for j = 0, S.cols - 1 do
			local p1 = buffer.readu32(colptr, 4 * j + 4)
			local xr, xi = @READ@(x, @E@ * j), @READ@(x, @E@ * j + @W@)
			if xr ~= 0 or xi ~= 0 then
				local pu = p1 - (p1 - p0) % 4
				for p = p0, pu - 1, 4 do
					local v, c = @E@ * p, 4 * p
					do
						local r = 16 * buffer.readu32(rowind, c + 0)
						local ar, ai = @READ@(vals, v + @E@ * 0), @READ@(vals, v + @E@ * 0 + @W@)
						buffer.writef64(acc, r, buffer.readf64(acc, r) + (ar * xr - ai * xi))
						buffer.writef64(acc, r + 8, buffer.readf64(acc, r + 8) + (ar * xi + ai * xr))
					end
					do
						local r = 16 * buffer.readu32(rowind, c + 4)
						local ar, ai = @READ@(vals, v + @E@ * 1), @READ@(vals, v + @E@ * 1 + @W@)
						buffer.writef64(acc, r, buffer.readf64(acc, r) + (ar * xr - ai * xi))
						buffer.writef64(acc, r + 8, buffer.readf64(acc, r + 8) + (ar * xi + ai * xr))
					end
					do
						local r = 16 * buffer.readu32(rowind, c + 8)
						local ar, ai = @READ@(vals, v + @E@ * 2), @READ@(vals, v + @E@ * 2 + @W@)
						buffer.writef64(acc, r, buffer.readf64(acc, r) + (ar * xr - ai * xi))
						buffer.writef64(acc, r + 8, buffer.readf64(acc, r + 8) + (ar * xi + ai * xr))
					end
					do
						local r = 16 * buffer.readu32(rowind, c + 12)
						local ar, ai = @READ@(vals, v + @E@ * 3), @READ@(vals, v + @E@ * 3 + @W@)
						buffer.writef64(acc, r, buffer.readf64(acc, r) + (ar * xr - ai * xi))
						buffer.writef64(acc, r + 8, buffer.readf64(acc, r + 8) + (ar * xi + ai * xr))
					end
				end
				for p = pu, p1 - 1 do
					local r = 16 * buffer.readu32(rowind, 4 * p)
					local ar, ai = @READ@(vals, @E@ * p), @READ@(vals, @E@ * p + @W@)
					buffer.writef64(acc, r, buffer.readf64(acc, r) + (ar * xr - ai * xi))
					buffer.writef64(acc, r + 8, buffer.readf64(acc, r + 8) + (ar * xi + ai * xr))
				end
			end
			p0 = p1
		end
	end

	local function mv1(o: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 1 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local sr0, si0 = 0, 0
			for p = p0, p1 - 1 do
				local c = @E@ * 1 * buffer.readu32(colind, 4 * p)
				local xr0, xi0 = @READ@(x, c + @E@ * 0), @READ@(x, c + @E@ * 0 + @W@)
				local v = @E@ * 1 * p
				do local ar, ai = @READ@(vals, v + @E@ * 0), @READ@(vals, v + @E@ * 0 + @W@); sr0 += ar * xr0 - ai * xi0; si0 += ar * xi0 + ai * xr0 end
			end
			local w = @E@ * 1 * I
			@WRITE@(o, w + @E@ * 0, sr0)
			@WRITE@(o, w + @E@ * 0 + @W@, si0)
			p0 = p1
		end
	end

	local function mvt1(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 1 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = @E@ * 1 * I
			local xr0, xi0 = @READ@(x, xb + @E@ * 0), @READ@(x, xb + @E@ * 0 + @W@)
			for p = p0, p1 - 1 do
				local c = 16 * buffer.readu32(colind, 4 * p)
				local v = @E@ * 1 * p
				do
					local ur, ui = 0, 0
					do local ar, ai = @READ@(vals, v + @E@ * 0), @READ@(vals, v + @E@ * 0 + @W@); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					buffer.writef64(acc, c, buffer.readf64(acc, c) + ur)
					buffer.writef64(acc, c + 8, buffer.readf64(acc, c + 8) + ui)
				end
			end
			p0 = p1
		end
	end

	local function pj1(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = @E@ * 1 * I, 16 * I
			local tr0, ti0 = @READ@(r, base + @E@ * 0), @READ@(r, base + @E@ * 0 + @W@)
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 0), buffer.readf64(inv, v + 8); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				@WRITE@(o, base + @E@ * 0, ur)
				@WRITE@(o, base + @E@ * 0 + @W@, ui)
			end
		end
	end

	spk.block[1] = { mv = mv1, mvt = mvt1, jacobi = pj1 }

	local function mv2(o: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 2 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local sr0, si0, sr1, si1 = 0, 0, 0, 0
			for p = p0, p1 - 1 do
				local c = @E@ * 2 * buffer.readu32(colind, 4 * p)
				local xr0, xi0, xr1, xi1 = @READ@(x, c + @E@ * 0), @READ@(x, c + @E@ * 0 + @W@), @READ@(x, c + @E@ * 1), @READ@(x, c + @E@ * 1 + @W@)
				local v = @E@ * 4 * p
				do local ar, ai = @READ@(vals, v + @E@ * 0), @READ@(vals, v + @E@ * 0 + @W@); sr0 += ar * xr0 - ai * xi0; si0 += ar * xi0 + ai * xr0 end
				do local ar, ai = @READ@(vals, v + @E@ * 2), @READ@(vals, v + @E@ * 2 + @W@); sr0 += ar * xr1 - ai * xi1; si0 += ar * xi1 + ai * xr1 end
				do local ar, ai = @READ@(vals, v + @E@ * 1), @READ@(vals, v + @E@ * 1 + @W@); sr1 += ar * xr0 - ai * xi0; si1 += ar * xi0 + ai * xr0 end
				do local ar, ai = @READ@(vals, v + @E@ * 3), @READ@(vals, v + @E@ * 3 + @W@); sr1 += ar * xr1 - ai * xi1; si1 += ar * xi1 + ai * xr1 end
			end
			local w = @E@ * 2 * I
			@WRITE@(o, w + @E@ * 0, sr0)
			@WRITE@(o, w + @E@ * 0 + @W@, si0)
			@WRITE@(o, w + @E@ * 1, sr1)
			@WRITE@(o, w + @E@ * 1 + @W@, si1)
			p0 = p1
		end
	end

	local function mvt2(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 2 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = @E@ * 2 * I
			local xr0, xi0, xr1, xi1 = @READ@(x, xb + @E@ * 0), @READ@(x, xb + @E@ * 0 + @W@), @READ@(x, xb + @E@ * 1), @READ@(x, xb + @E@ * 1 + @W@)
			for p = p0, p1 - 1 do
				local c = 32 * buffer.readu32(colind, 4 * p)
				local v = @E@ * 4 * p
				do
					local ur, ui = 0, 0
					do local ar, ai = @READ@(vals, v + @E@ * 0), @READ@(vals, v + @E@ * 0 + @W@); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = @READ@(vals, v + @E@ * 1), @READ@(vals, v + @E@ * 1 + @W@); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					buffer.writef64(acc, c, buffer.readf64(acc, c) + ur)
					buffer.writef64(acc, c + 8, buffer.readf64(acc, c + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = @READ@(vals, v + @E@ * 2), @READ@(vals, v + @E@ * 2 + @W@); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = @READ@(vals, v + @E@ * 3), @READ@(vals, v + @E@ * 3 + @W@); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					buffer.writef64(acc, c + 16, buffer.readf64(acc, c + 16) + ur)
					buffer.writef64(acc, c + 16 + 8, buffer.readf64(acc, c + 16 + 8) + ui)
				end
			end
			p0 = p1
		end
	end

	local function pj2(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = @E@ * 2 * I, 64 * I
			local tr0, ti0, tr1, ti1 = @READ@(r, base + @E@ * 0), @READ@(r, base + @E@ * 0 + @W@), @READ@(r, base + @E@ * 1), @READ@(r, base + @E@ * 1 + @W@)
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 0), buffer.readf64(inv, v + 8); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 32), buffer.readf64(inv, v + 40); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				@WRITE@(o, base + @E@ * 0, ur)
				@WRITE@(o, base + @E@ * 0 + @W@, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 16), buffer.readf64(inv, v + 24); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 48), buffer.readf64(inv, v + 56); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				@WRITE@(o, base + @E@ * 1, ur)
				@WRITE@(o, base + @E@ * 1 + @W@, ui)
			end
		end
	end

	spk.block[2] = { mv = mv2, mvt = mvt2, jacobi = pj2 }

	local function mv3(o: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 3 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local sr0, si0, sr1, si1, sr2, si2 = 0, 0, 0, 0, 0, 0
			for p = p0, p1 - 1 do
				local c = @E@ * 3 * buffer.readu32(colind, 4 * p)
				local xr0, xi0, xr1, xi1, xr2, xi2 = @READ@(x, c + @E@ * 0), @READ@(x, c + @E@ * 0 + @W@), @READ@(x, c + @E@ * 1), @READ@(x, c + @E@ * 1 + @W@), @READ@(x, c + @E@ * 2), @READ@(x, c + @E@ * 2 + @W@)
				local v = @E@ * 9 * p
				do local ar, ai = @READ@(vals, v + @E@ * 0), @READ@(vals, v + @E@ * 0 + @W@); sr0 += ar * xr0 - ai * xi0; si0 += ar * xi0 + ai * xr0 end
				do local ar, ai = @READ@(vals, v + @E@ * 3), @READ@(vals, v + @E@ * 3 + @W@); sr0 += ar * xr1 - ai * xi1; si0 += ar * xi1 + ai * xr1 end
				do local ar, ai = @READ@(vals, v + @E@ * 6), @READ@(vals, v + @E@ * 6 + @W@); sr0 += ar * xr2 - ai * xi2; si0 += ar * xi2 + ai * xr2 end
				do local ar, ai = @READ@(vals, v + @E@ * 1), @READ@(vals, v + @E@ * 1 + @W@); sr1 += ar * xr0 - ai * xi0; si1 += ar * xi0 + ai * xr0 end
				do local ar, ai = @READ@(vals, v + @E@ * 4), @READ@(vals, v + @E@ * 4 + @W@); sr1 += ar * xr1 - ai * xi1; si1 += ar * xi1 + ai * xr1 end
				do local ar, ai = @READ@(vals, v + @E@ * 7), @READ@(vals, v + @E@ * 7 + @W@); sr1 += ar * xr2 - ai * xi2; si1 += ar * xi2 + ai * xr2 end
				do local ar, ai = @READ@(vals, v + @E@ * 2), @READ@(vals, v + @E@ * 2 + @W@); sr2 += ar * xr0 - ai * xi0; si2 += ar * xi0 + ai * xr0 end
				do local ar, ai = @READ@(vals, v + @E@ * 5), @READ@(vals, v + @E@ * 5 + @W@); sr2 += ar * xr1 - ai * xi1; si2 += ar * xi1 + ai * xr1 end
				do local ar, ai = @READ@(vals, v + @E@ * 8), @READ@(vals, v + @E@ * 8 + @W@); sr2 += ar * xr2 - ai * xi2; si2 += ar * xi2 + ai * xr2 end
			end
			local w = @E@ * 3 * I
			@WRITE@(o, w + @E@ * 0, sr0)
			@WRITE@(o, w + @E@ * 0 + @W@, si0)
			@WRITE@(o, w + @E@ * 1, sr1)
			@WRITE@(o, w + @E@ * 1 + @W@, si1)
			@WRITE@(o, w + @E@ * 2, sr2)
			@WRITE@(o, w + @E@ * 2 + @W@, si2)
			p0 = p1
		end
	end

	local function mvt3(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 3 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = @E@ * 3 * I
			local xr0, xi0, xr1, xi1, xr2, xi2 = @READ@(x, xb + @E@ * 0), @READ@(x, xb + @E@ * 0 + @W@), @READ@(x, xb + @E@ * 1), @READ@(x, xb + @E@ * 1 + @W@), @READ@(x, xb + @E@ * 2), @READ@(x, xb + @E@ * 2 + @W@)
			for p = p0, p1 - 1 do
				local c = 48 * buffer.readu32(colind, 4 * p)
				local v = @E@ * 9 * p
				do
					local ur, ui = 0, 0
					do local ar, ai = @READ@(vals, v + @E@ * 0), @READ@(vals, v + @E@ * 0 + @W@); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = @READ@(vals, v + @E@ * 1), @READ@(vals, v + @E@ * 1 + @W@); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = @READ@(vals, v + @E@ * 2), @READ@(vals, v + @E@ * 2 + @W@); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					buffer.writef64(acc, c, buffer.readf64(acc, c) + ur)
					buffer.writef64(acc, c + 8, buffer.readf64(acc, c + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = @READ@(vals, v + @E@ * 3), @READ@(vals, v + @E@ * 3 + @W@); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = @READ@(vals, v + @E@ * 4), @READ@(vals, v + @E@ * 4 + @W@); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = @READ@(vals, v + @E@ * 5), @READ@(vals, v + @E@ * 5 + @W@); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					buffer.writef64(acc, c + 16, buffer.readf64(acc, c + 16) + ur)
					buffer.writef64(acc, c + 16 + 8, buffer.readf64(acc, c + 16 + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = @READ@(vals, v + @E@ * 6), @READ@(vals, v + @E@ * 6 + @W@); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = @READ@(vals, v + @E@ * 7), @READ@(vals, v + @E@ * 7 + @W@); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = @READ@(vals, v + @E@ * 8), @READ@(vals, v + @E@ * 8 + @W@); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					buffer.writef64(acc, c + 32, buffer.readf64(acc, c + 32) + ur)
					buffer.writef64(acc, c + 32 + 8, buffer.readf64(acc, c + 32 + 8) + ui)
				end
			end
			p0 = p1
		end
	end

	local function pj3(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = @E@ * 3 * I, 144 * I
			local tr0, ti0, tr1, ti1, tr2, ti2 = @READ@(r, base + @E@ * 0), @READ@(r, base + @E@ * 0 + @W@), @READ@(r, base + @E@ * 1), @READ@(r, base + @E@ * 1 + @W@), @READ@(r, base + @E@ * 2), @READ@(r, base + @E@ * 2 + @W@)
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 0), buffer.readf64(inv, v + 8); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 48), buffer.readf64(inv, v + 56); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 96), buffer.readf64(inv, v + 104); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				@WRITE@(o, base + @E@ * 0, ur)
				@WRITE@(o, base + @E@ * 0 + @W@, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 16), buffer.readf64(inv, v + 24); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 64), buffer.readf64(inv, v + 72); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 112), buffer.readf64(inv, v + 120); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				@WRITE@(o, base + @E@ * 1, ur)
				@WRITE@(o, base + @E@ * 1 + @W@, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 32), buffer.readf64(inv, v + 40); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 80), buffer.readf64(inv, v + 88); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 128), buffer.readf64(inv, v + 136); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				@WRITE@(o, base + @E@ * 2, ur)
				@WRITE@(o, base + @E@ * 2 + @W@, ui)
			end
		end
	end

	spk.block[3] = { mv = mv3, mvt = mvt3, jacobi = pj3 }

	local function mv4(o: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 4 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local sr0, si0, sr1, si1, sr2, si2, sr3, si3 = 0, 0, 0, 0, 0, 0, 0, 0
			for p = p0, p1 - 1 do
				local c = @E@ * 4 * buffer.readu32(colind, 4 * p)
				local xr0, xi0, xr1, xi1, xr2, xi2, xr3, xi3 = @READ@(x, c + @E@ * 0), @READ@(x, c + @E@ * 0 + @W@), @READ@(x, c + @E@ * 1), @READ@(x, c + @E@ * 1 + @W@), @READ@(x, c + @E@ * 2), @READ@(x, c + @E@ * 2 + @W@), @READ@(x, c + @E@ * 3), @READ@(x, c + @E@ * 3 + @W@)
				local v = @E@ * 16 * p
				do local ar, ai = @READ@(vals, v + @E@ * 0), @READ@(vals, v + @E@ * 0 + @W@); sr0 += ar * xr0 - ai * xi0; si0 += ar * xi0 + ai * xr0 end
				do local ar, ai = @READ@(vals, v + @E@ * 4), @READ@(vals, v + @E@ * 4 + @W@); sr0 += ar * xr1 - ai * xi1; si0 += ar * xi1 + ai * xr1 end
				do local ar, ai = @READ@(vals, v + @E@ * 8), @READ@(vals, v + @E@ * 8 + @W@); sr0 += ar * xr2 - ai * xi2; si0 += ar * xi2 + ai * xr2 end
				do local ar, ai = @READ@(vals, v + @E@ * 12), @READ@(vals, v + @E@ * 12 + @W@); sr0 += ar * xr3 - ai * xi3; si0 += ar * xi3 + ai * xr3 end
				do local ar, ai = @READ@(vals, v + @E@ * 1), @READ@(vals, v + @E@ * 1 + @W@); sr1 += ar * xr0 - ai * xi0; si1 += ar * xi0 + ai * xr0 end
				do local ar, ai = @READ@(vals, v + @E@ * 5), @READ@(vals, v + @E@ * 5 + @W@); sr1 += ar * xr1 - ai * xi1; si1 += ar * xi1 + ai * xr1 end
				do local ar, ai = @READ@(vals, v + @E@ * 9), @READ@(vals, v + @E@ * 9 + @W@); sr1 += ar * xr2 - ai * xi2; si1 += ar * xi2 + ai * xr2 end
				do local ar, ai = @READ@(vals, v + @E@ * 13), @READ@(vals, v + @E@ * 13 + @W@); sr1 += ar * xr3 - ai * xi3; si1 += ar * xi3 + ai * xr3 end
				do local ar, ai = @READ@(vals, v + @E@ * 2), @READ@(vals, v + @E@ * 2 + @W@); sr2 += ar * xr0 - ai * xi0; si2 += ar * xi0 + ai * xr0 end
				do local ar, ai = @READ@(vals, v + @E@ * 6), @READ@(vals, v + @E@ * 6 + @W@); sr2 += ar * xr1 - ai * xi1; si2 += ar * xi1 + ai * xr1 end
				do local ar, ai = @READ@(vals, v + @E@ * 10), @READ@(vals, v + @E@ * 10 + @W@); sr2 += ar * xr2 - ai * xi2; si2 += ar * xi2 + ai * xr2 end
				do local ar, ai = @READ@(vals, v + @E@ * 14), @READ@(vals, v + @E@ * 14 + @W@); sr2 += ar * xr3 - ai * xi3; si2 += ar * xi3 + ai * xr3 end
				do local ar, ai = @READ@(vals, v + @E@ * 3), @READ@(vals, v + @E@ * 3 + @W@); sr3 += ar * xr0 - ai * xi0; si3 += ar * xi0 + ai * xr0 end
				do local ar, ai = @READ@(vals, v + @E@ * 7), @READ@(vals, v + @E@ * 7 + @W@); sr3 += ar * xr1 - ai * xi1; si3 += ar * xi1 + ai * xr1 end
				do local ar, ai = @READ@(vals, v + @E@ * 11), @READ@(vals, v + @E@ * 11 + @W@); sr3 += ar * xr2 - ai * xi2; si3 += ar * xi2 + ai * xr2 end
				do local ar, ai = @READ@(vals, v + @E@ * 15), @READ@(vals, v + @E@ * 15 + @W@); sr3 += ar * xr3 - ai * xi3; si3 += ar * xi3 + ai * xr3 end
			end
			local w = @E@ * 4 * I
			@WRITE@(o, w + @E@ * 0, sr0)
			@WRITE@(o, w + @E@ * 0 + @W@, si0)
			@WRITE@(o, w + @E@ * 1, sr1)
			@WRITE@(o, w + @E@ * 1 + @W@, si1)
			@WRITE@(o, w + @E@ * 2, sr2)
			@WRITE@(o, w + @E@ * 2 + @W@, si2)
			@WRITE@(o, w + @E@ * 3, sr3)
			@WRITE@(o, w + @E@ * 3 + @W@, si3)
			p0 = p1
		end
	end

	local function mvt4(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 4 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = @E@ * 4 * I
			local xr0, xi0, xr1, xi1, xr2, xi2, xr3, xi3 = @READ@(x, xb + @E@ * 0), @READ@(x, xb + @E@ * 0 + @W@), @READ@(x, xb + @E@ * 1), @READ@(x, xb + @E@ * 1 + @W@), @READ@(x, xb + @E@ * 2), @READ@(x, xb + @E@ * 2 + @W@), @READ@(x, xb + @E@ * 3), @READ@(x, xb + @E@ * 3 + @W@)
			for p = p0, p1 - 1 do
				local c = 64 * buffer.readu32(colind, 4 * p)
				local v = @E@ * 16 * p
				do
					local ur, ui = 0, 0
					do local ar, ai = @READ@(vals, v + @E@ * 0), @READ@(vals, v + @E@ * 0 + @W@); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = @READ@(vals, v + @E@ * 1), @READ@(vals, v + @E@ * 1 + @W@); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = @READ@(vals, v + @E@ * 2), @READ@(vals, v + @E@ * 2 + @W@); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					do local ar, ai = @READ@(vals, v + @E@ * 3), @READ@(vals, v + @E@ * 3 + @W@); ur += ar * xr3 + ai * xi3; ui += ar * xi3 - ai * xr3 end
					buffer.writef64(acc, c, buffer.readf64(acc, c) + ur)
					buffer.writef64(acc, c + 8, buffer.readf64(acc, c + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = @READ@(vals, v + @E@ * 4), @READ@(vals, v + @E@ * 4 + @W@); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = @READ@(vals, v + @E@ * 5), @READ@(vals, v + @E@ * 5 + @W@); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = @READ@(vals, v + @E@ * 6), @READ@(vals, v + @E@ * 6 + @W@); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					do local ar, ai = @READ@(vals, v + @E@ * 7), @READ@(vals, v + @E@ * 7 + @W@); ur += ar * xr3 + ai * xi3; ui += ar * xi3 - ai * xr3 end
					buffer.writef64(acc, c + 16, buffer.readf64(acc, c + 16) + ur)
					buffer.writef64(acc, c + 16 + 8, buffer.readf64(acc, c + 16 + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = @READ@(vals, v + @E@ * 8), @READ@(vals, v + @E@ * 8 + @W@); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = @READ@(vals, v + @E@ * 9), @READ@(vals, v + @E@ * 9 + @W@); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = @READ@(vals, v + @E@ * 10), @READ@(vals, v + @E@ * 10 + @W@); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					do local ar, ai = @READ@(vals, v + @E@ * 11), @READ@(vals, v + @E@ * 11 + @W@); ur += ar * xr3 + ai * xi3; ui += ar * xi3 - ai * xr3 end
					buffer.writef64(acc, c + 32, buffer.readf64(acc, c + 32) + ur)
					buffer.writef64(acc, c + 32 + 8, buffer.readf64(acc, c + 32 + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = @READ@(vals, v + @E@ * 12), @READ@(vals, v + @E@ * 12 + @W@); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = @READ@(vals, v + @E@ * 13), @READ@(vals, v + @E@ * 13 + @W@); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = @READ@(vals, v + @E@ * 14), @READ@(vals, v + @E@ * 14 + @W@); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					do local ar, ai = @READ@(vals, v + @E@ * 15), @READ@(vals, v + @E@ * 15 + @W@); ur += ar * xr3 + ai * xi3; ui += ar * xi3 - ai * xr3 end
					buffer.writef64(acc, c + 48, buffer.readf64(acc, c + 48) + ur)
					buffer.writef64(acc, c + 48 + 8, buffer.readf64(acc, c + 48 + 8) + ui)
				end
			end
			p0 = p1
		end
	end

	local function pj4(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = @E@ * 4 * I, 256 * I
			local tr0, ti0, tr1, ti1, tr2, ti2, tr3, ti3 = @READ@(r, base + @E@ * 0), @READ@(r, base + @E@ * 0 + @W@), @READ@(r, base + @E@ * 1), @READ@(r, base + @E@ * 1 + @W@), @READ@(r, base + @E@ * 2), @READ@(r, base + @E@ * 2 + @W@), @READ@(r, base + @E@ * 3), @READ@(r, base + @E@ * 3 + @W@)
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 0), buffer.readf64(inv, v + 8); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 64), buffer.readf64(inv, v + 72); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 128), buffer.readf64(inv, v + 136); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				do local ar, ai = buffer.readf64(inv, v + 192), buffer.readf64(inv, v + 200); ur += ar * tr3 - ai * ti3; ui += ar * ti3 + ai * tr3 end
				@WRITE@(o, base + @E@ * 0, ur)
				@WRITE@(o, base + @E@ * 0 + @W@, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 16), buffer.readf64(inv, v + 24); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 80), buffer.readf64(inv, v + 88); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 144), buffer.readf64(inv, v + 152); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				do local ar, ai = buffer.readf64(inv, v + 208), buffer.readf64(inv, v + 216); ur += ar * tr3 - ai * ti3; ui += ar * ti3 + ai * tr3 end
				@WRITE@(o, base + @E@ * 1, ur)
				@WRITE@(o, base + @E@ * 1 + @W@, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 32), buffer.readf64(inv, v + 40); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 96), buffer.readf64(inv, v + 104); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 160), buffer.readf64(inv, v + 168); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				do local ar, ai = buffer.readf64(inv, v + 224), buffer.readf64(inv, v + 232); ur += ar * tr3 - ai * ti3; ui += ar * ti3 + ai * tr3 end
				@WRITE@(o, base + @E@ * 2, ur)
				@WRITE@(o, base + @E@ * 2 + @W@, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 48), buffer.readf64(inv, v + 56); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 112), buffer.readf64(inv, v + 120); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 176), buffer.readf64(inv, v + 184); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				do local ar, ai = buffer.readf64(inv, v + 240), buffer.readf64(inv, v + 248); ur += ar * tr3 - ai * ti3; ui += ar * ti3 + ai * tr3 end
				@WRITE@(o, base + @E@ * 3, ur)
				@WRITE@(o, base + @E@ * 3 + @W@, ui)
			end
		end
	end

	spk.block[4] = { mv = mv4, mvt = mvt4, jacobi = pj4 }
end
