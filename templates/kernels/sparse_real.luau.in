-- Sparse product kernels (generated by tools/gen_sparse_kernels.py; do not edit).
--   spk.gather(o, S, x)  o := S^T x (a gather down the columns of S)
--   spk.scatter(acc, S, x)  acc[row] += S[row, j] x[j] (acc: f64, one per row, zeroed)
--   spk.block[b].mv(o, B, x)   o := B x for a block sparse B with b by b blocks
--   spk.block[b].mvt(acc, B, x)  acc += B^T x (acc as for scatter)
--   spk.block[b].jacobi(o, inv, r, nb)  o := blockdiag(inv) r for nb f64 inverse blocks
--   spk.block[b].product(cv, xv, yv, plan, count)  block products for multigrid (real)
-- Unrolled by 4; blocks are handled one per iteration (see the cost model in the
-- generator).
local spk: any = { block = {} }
do
	function spk.gather(o: buffer, S: Sparse, x: buffer)
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local p0 = buffer.readu32(colptr, 0)
		for j = 0, S.cols - 1 do
			local p1 = buffer.readu32(colptr, 4 * j + 4)
			local pu = p1 - (p1 - p0) % 4
			local s0, s1 = 0, 0
			for p = p0, pu - 1, 4 do
				local v, c = @W@ * p, 4 * p
				s0 += @READ@(vals, v + @W@ * 0) * @READ@(x, @W@ * buffer.readu32(rowind, c + 0)) + @READ@(vals, v + @W@ * 1) * @READ@(x, @W@ * buffer.readu32(rowind, c + 4))
				s1 += @READ@(vals, v + @W@ * 2) * @READ@(x, @W@ * buffer.readu32(rowind, c + 8)) + @READ@(vals, v + @W@ * 3) * @READ@(x, @W@ * buffer.readu32(rowind, c + 12))
			end
			for p = pu, p1 - 1 do
				s0 += @READ@(vals, @W@ * p) * @READ@(x, @W@ * buffer.readu32(rowind, 4 * p))
			end
			@WRITE@(o, @W@ * j, s0 + s1)
			p0 = p1
		end
	end

	function spk.scatter(acc: buffer, S: Sparse, x: buffer)
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local p0 = buffer.readu32(colptr, 0)
		for j = 0, S.cols - 1 do
			local p1 = buffer.readu32(colptr, 4 * j + 4)
			local xj = @READ@(x, @W@ * j)
			if xj ~= 0 then
				local pu = p1 - (p1 - p0) % 4
				for p = p0, pu - 1, 4 do
					local v, c = @W@ * p, 4 * p
					local r0, r1, r2, r3 = 8 * buffer.readu32(rowind, c + 0), 8 * buffer.readu32(rowind, c + 4), 8 * buffer.readu32(rowind, c + 8), 8 * buffer.readu32(rowind, c + 12)
					buffer.writef64(acc, r0, buffer.readf64(acc, r0) + @READ@(vals, v + @W@ * 0) * xj)
					buffer.writef64(acc, r1, buffer.readf64(acc, r1) + @READ@(vals, v + @W@ * 1) * xj)
					buffer.writef64(acc, r2, buffer.readf64(acc, r2) + @READ@(vals, v + @W@ * 2) * xj)
					buffer.writef64(acc, r3, buffer.readf64(acc, r3) + @READ@(vals, v + @W@ * 3) * xj)
				end
				for p = pu, p1 - 1 do
					local r = 8 * buffer.readu32(rowind, 4 * p)
					buffer.writef64(acc, r, buffer.readf64(acc, r) + @READ@(vals, @W@ * p) * xj)
				end
			end
			p0 = p1
		end
	end

	local function mv1(o: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 1 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local s0 = 0
			for p = p0, p1 - 1 do
				local c = @W@ * 1 * buffer.readu32(colind, 4 * p)
				local x0 = @READ@(x, c + @W@ * 0)
				local v = @W@ * 1 * p
				s0 += @READ@(vals, v + @W@ * 0) * x0
			end
			local w = @W@ * 1 * I
			@WRITE@(o, w + @W@ * 0, s0)
			p0 = p1
		end
	end

	local function mvt1(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 1 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = @W@ * 1 * I
			local x0 = @READ@(x, xb + @W@ * 0)
			for p = p0, p1 - 1 do
				local c = 8 * buffer.readu32(colind, 4 * p)
				local v = @W@ * 1 * p
				buffer.writef64(acc, c, buffer.readf64(acc, c) + (@READ@(vals, v + @W@ * 0) * x0))
			end
			p0 = p1
		end
	end

	local function pj1(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = @W@ * 1 * I, 8 * I
			local t0 = @READ@(r, base + @W@ * 0)
			@WRITE@(o, base + @W@ * 0, buffer.readf64(inv, v + 0) * t0)
		end
	end

	local function bmm1(cv: buffer, xv: buffer, yv: buffer, plan: buffer, count: number)
		for t = 0, count - 1 do
			local c = @W@ * 1 * buffer.readu32(plan, 12 * t)
			local x = @W@ * 1 * buffer.readu32(plan, 12 * t + 4)
			local y = @W@ * 1 * buffer.readu32(plan, 12 * t + 8)
			local x0_0 = @READ@(xv, x + @W@ * 0)
			local y0_0 = @READ@(yv, y + @W@ * 0)
			@WRITE@(cv, c + @W@ * 0, @READ@(cv, c + @W@ * 0) + (x0_0 * y0_0))
		end
	end

	spk.block[1] = { mv = mv1, mvt = mvt1, jacobi = pj1, product = bmm1 }

	local function mv2(o: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 2 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local s0, s1 = 0, 0
			for p = p0, p1 - 1 do
				local c = @W@ * 2 * buffer.readu32(colind, 4 * p)
				local x0, x1 = @READ@(x, c + @W@ * 0), @READ@(x, c + @W@ * 1)
				local v = @W@ * 4 * p
				s0 += @READ@(vals, v + @W@ * 0) * x0 + @READ@(vals, v + @W@ * 2) * x1
				s1 += @READ@(vals, v + @W@ * 1) * x0 + @READ@(vals, v + @W@ * 3) * x1
			end
			local w = @W@ * 2 * I
			@WRITE@(o, w + @W@ * 0, s0)
			@WRITE@(o, w + @W@ * 1, s1)
			p0 = p1
		end
	end

	local function mvt2(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 2 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = @W@ * 2 * I
			local x0, x1 = @READ@(x, xb + @W@ * 0), @READ@(x, xb + @W@ * 1)
			for p = p0, p1 - 1 do
				local c = 16 * buffer.readu32(colind, 4 * p)
				local v = @W@ * 4 * p
				buffer.writef64(acc, c, buffer.readf64(acc, c) + (@READ@(vals, v + @W@ * 0) * x0 + @READ@(vals, v + @W@ * 1) * x1))
				buffer.writef64(acc, c + 8, buffer.readf64(acc, c + 8) + (@READ@(vals, v + @W@ * 2) * x0 + @READ@(vals, v + @W@ * 3) * x1))
			end
			p0 = p1
		end
	end

	local function pj2(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = @W@ * 2 * I, 32 * I
			local t0, t1 = @READ@(r, base + @W@ * 0), @READ@(r, base + @W@ * 1)
			@WRITE@(o, base + @W@ * 0, buffer.readf64(inv, v + 0) * t0 + buffer.readf64(inv, v + 16) * t1)
			@WRITE@(o, base + @W@ * 1, buffer.readf64(inv, v + 8) * t0 + buffer.readf64(inv, v + 24) * t1)
		end
	end

	local function bmm2(cv: buffer, xv: buffer, yv: buffer, plan: buffer, count: number)
		for t = 0, count - 1 do
			local c = @W@ * 4 * buffer.readu32(plan, 12 * t)
			local x = @W@ * 4 * buffer.readu32(plan, 12 * t + 4)
			local y = @W@ * 4 * buffer.readu32(plan, 12 * t + 8)
			local x0_0, x1_0, x0_1, x1_1 = @READ@(xv, x + @W@ * 0), @READ@(xv, x + @W@ * 1), @READ@(xv, x + @W@ * 2), @READ@(xv, x + @W@ * 3)
			local y0_0, y1_0, y0_1, y1_1 = @READ@(yv, y + @W@ * 0), @READ@(yv, y + @W@ * 1), @READ@(yv, y + @W@ * 2), @READ@(yv, y + @W@ * 3)
			@WRITE@(cv, c + @W@ * 0, @READ@(cv, c + @W@ * 0) + (x0_0 * y0_0 + x0_1 * y1_0))
			@WRITE@(cv, c + @W@ * 1, @READ@(cv, c + @W@ * 1) + (x1_0 * y0_0 + x1_1 * y1_0))
			@WRITE@(cv, c + @W@ * 2, @READ@(cv, c + @W@ * 2) + (x0_0 * y0_1 + x0_1 * y1_1))
			@WRITE@(cv, c + @W@ * 3, @READ@(cv, c + @W@ * 3) + (x1_0 * y0_1 + x1_1 * y1_1))
		end
	end

	spk.block[2] = { mv = mv2, mvt = mvt2, jacobi = pj2, product = bmm2 }

	local function mv3(o: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 3 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local s0, s1, s2 = 0, 0, 0
			for p = p0, p1 - 1 do
				local c = @W@ * 3 * buffer.readu32(colind, 4 * p)
				local x0, x1, x2 = @READ@(x, c + @W@ * 0), @READ@(x, c + @W@ * 1), @READ@(x, c + @W@ * 2)
				local v = @W@ * 9 * p
				s0 += @READ@(vals, v + @W@ * 0) * x0 + @READ@(vals, v + @W@ * 3) * x1 + @READ@(vals, v + @W@ * 6) * x2
				s1 += @READ@(vals, v + @W@ * 1) * x0 + @READ@(vals, v + @W@ * 4) * x1 + @READ@(vals, v + @W@ * 7) * x2
				s2 += @READ@(vals, v + @W@ * 2) * x0 + @READ@(vals, v + @W@ * 5) * x1 + @READ@(vals, v + @W@ * 8) * x2
			end
			local w = @W@ * 3 * I
			@WRITE@(o, w + @W@ * 0, s0)
			@WRITE@(o, w + @W@ * 1, s1)
			@WRITE@(o, w + @W@ * 2, s2)
			p0 = p1
		end
	end

	local function mvt3(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 3 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = @W@ * 3 * I
			local x0, x1, x2 = @READ@(x, xb + @W@ * 0), @READ@(x, xb + @W@ * 1), @READ@(x, xb + @W@ * 2)
			for p = p0, p1 - 1 do
				local c = 24 * buffer.readu32(colind, 4 * p)
				local v = @W@ * 9 * p
				buffer.writef64(acc, c, buffer.readf64(acc, c) + (@READ@(vals, v + @W@ * 0) * x0 + @READ@(vals, v + @W@ * 1) * x1 + @READ@(vals, v + @W@ * 2) * x2))
				buffer.writef64(acc, c + 8, buffer.readf64(acc, c + 8) + (@READ@(vals, v + @W@ * 3) * x0 + @READ@(vals, v + @W@ * 4) * x1 + @READ@(vals, v + @W@ * 5) * x2))
				buffer.writef64(acc, c + 16, buffer.readf64(acc, c + 16) + (@READ@(vals, v + @W@ * 6) * x0 + @READ@(vals, v + @W@ * 7) * x1 + @READ@(vals, v + @W@ * 8) * x2))
			end
			p0 = p1
		end
	end

	local function pj3(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = @W@ * 3 * I, 72 * I
			local t0, t1, t2 = @READ@(r, base + @W@ * 0), @READ@(r, base + @W@ * 1), @READ@(r, base + @W@ * 2)
			@WRITE@(o, base + @W@ * 0, buffer.readf64(inv, v + 0) * t0 + buffer.readf64(inv, v + 24) * t1 + buffer.readf64(inv, v + 48) * t2)
			@WRITE@(o, base + @W@ * 1, buffer.readf64(inv, v + 8) * t0 + buffer.readf64(inv, v + 32) * t1 + buffer.readf64(inv, v + 56) * t2)
			@WRITE@(o, base + @W@ * 2, buffer.readf64(inv, v + 16) * t0 + buffer.readf64(inv, v + 40) * t1 + buffer.readf64(inv, v + 64) * t2)
		end
	end

	local function bmm3(cv: buffer, xv: buffer, yv: buffer, plan: buffer, count: number)
		for t = 0, count - 1 do
			local c = @W@ * 9 * buffer.readu32(plan, 12 * t)
			local x = @W@ * 9 * buffer.readu32(plan, 12 * t + 4)
			local y = @W@ * 9 * buffer.readu32(plan, 12 * t + 8)
			local x0_0, x1_0, x2_0, x0_1, x1_1, x2_1, x0_2, x1_2, x2_2 = @READ@(xv, x + @W@ * 0), @READ@(xv, x + @W@ * 1), @READ@(xv, x + @W@ * 2), @READ@(xv, x + @W@ * 3), @READ@(xv, x + @W@ * 4), @READ@(xv, x + @W@ * 5), @READ@(xv, x + @W@ * 6), @READ@(xv, x + @W@ * 7), @READ@(xv, x + @W@ * 8)
			local y0_0, y1_0, y2_0, y0_1, y1_1, y2_1, y0_2, y1_2, y2_2 = @READ@(yv, y + @W@ * 0), @READ@(yv, y + @W@ * 1), @READ@(yv, y + @W@ * 2), @READ@(yv, y + @W@ * 3), @READ@(yv, y + @W@ * 4), @READ@(yv, y + @W@ * 5), @READ@(yv, y + @W@ * 6), @READ@(yv, y + @W@ * 7), @READ@(yv, y + @W@ * 8)
			@WRITE@(cv, c + @W@ * 0, @READ@(cv, c + @W@ * 0) + (x0_0 * y0_0 + x0_1 * y1_0 + x0_2 * y2_0))
			@WRITE@(cv, c + @W@ * 1, @READ@(cv, c + @W@ * 1) + (x1_0 * y0_0 + x1_1 * y1_0 + x1_2 * y2_0))
			@WRITE@(cv, c + @W@ * 2, @READ@(cv, c + @W@ * 2) + (x2_0 * y0_0 + x2_1 * y1_0 + x2_2 * y2_0))
			@WRITE@(cv, c + @W@ * 3, @READ@(cv, c + @W@ * 3) + (x0_0 * y0_1 + x0_1 * y1_1 + x0_2 * y2_1))
			@WRITE@(cv, c + @W@ * 4, @READ@(cv, c + @W@ * 4) + (x1_0 * y0_1 + x1_1 * y1_1 + x1_2 * y2_1))
			@WRITE@(cv, c + @W@ * 5, @READ@(cv, c + @W@ * 5) + (x2_0 * y0_1 + x2_1 * y1_1 + x2_2 * y2_1))
			@WRITE@(cv, c + @W@ * 6, @READ@(cv, c + @W@ * 6) + (x0_0 * y0_2 + x0_1 * y1_2 + x0_2 * y2_2))
			@WRITE@(cv, c + @W@ * 7, @READ@(cv, c + @W@ * 7) + (x1_0 * y0_2 + x1_1 * y1_2 + x1_2 * y2_2))
			@WRITE@(cv, c + @W@ * 8, @READ@(cv, c + @W@ * 8) + (x2_0 * y0_2 + x2_1 * y1_2 + x2_2 * y2_2))
		end
	end

	spk.block[3] = { mv = mv3, mvt = mvt3, jacobi = pj3, product = bmm3 }

	local function mv4(o: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 4 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local s0, s1, s2, s3 = 0, 0, 0, 0
			for p = p0, p1 - 1 do
				local c = @W@ * 4 * buffer.readu32(colind, 4 * p)
				local x0, x1, x2, x3 = @READ@(x, c + @W@ * 0), @READ@(x, c + @W@ * 1), @READ@(x, c + @W@ * 2), @READ@(x, c + @W@ * 3)
				local v = @W@ * 16 * p
				s0 += @READ@(vals, v + @W@ * 0) * x0 + @READ@(vals, v + @W@ * 4) * x1 + @READ@(vals, v + @W@ * 8) * x2 + @READ@(vals, v + @W@ * 12) * x3
				s1 += @READ@(vals, v + @W@ * 1) * x0 + @READ@(vals, v + @W@ * 5) * x1 + @READ@(vals, v + @W@ * 9) * x2 + @READ@(vals, v + @W@ * 13) * x3
				s2 += @READ@(vals, v + @W@ * 2) * x0 + @READ@(vals, v + @W@ * 6) * x1 + @READ@(vals, v + @W@ * 10) * x2 + @READ@(vals, v + @W@ * 14) * x3
				s3 += @READ@(vals, v + @W@ * 3) * x0 + @READ@(vals, v + @W@ * 7) * x1 + @READ@(vals, v + @W@ * 11) * x2 + @READ@(vals, v + @W@ * 15) * x3
			end
			local w = @W@ * 4 * I
			@WRITE@(o, w + @W@ * 0, s0)
			@WRITE@(o, w + @W@ * 1, s1)
			@WRITE@(o, w + @W@ * 2, s2)
			@WRITE@(o, w + @W@ * 3, s3)
			p0 = p1
		end
	end

	local function mvt4(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 4 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = @W@ * 4 * I
			local x0, x1, x2, x3 = @READ@(x, xb + @W@ * 0), @READ@(x, xb + @W@ * 1), @READ@(x, xb + @W@ * 2), @READ@(x, xb + @W@ * 3)
			for p = p0, p1 - 1 do
				local c = 32 * buffer.readu32(colind, 4 * p)
				local v = @W@ * 16 * p
				buffer.writef64(acc, c, buffer.readf64(acc, c) + (@READ@(vals, v + @W@ * 0) * x0 + @READ@(vals, v + @W@ * 1) * x1 + @READ@(vals, v + @W@ * 2) * x2 + @READ@(vals, v + @W@ * 3) * x3))
				buffer.writef64(acc, c + 8, buffer.readf64(acc, c + 8) + (@READ@(vals, v + @W@ * 4) * x0 + @READ@(vals, v + @W@ * 5) * x1 + @READ@(vals, v + @W@ * 6) * x2 + @READ@(vals, v + @W@ * 7) * x3))
				buffer.writef64(acc, c + 16, buffer.readf64(acc, c + 16) + (@READ@(vals, v + @W@ * 8) * x0 + @READ@(vals, v + @W@ * 9) * x1 + @READ@(vals, v + @W@ * 10) * x2 + @READ@(vals, v + @W@ * 11) * x3))
				buffer.writef64(acc, c + 24, buffer.readf64(acc, c + 24) + (@READ@(vals, v + @W@ * 12) * x0 + @READ@(vals, v + @W@ * 13) * x1 + @READ@(vals, v + @W@ * 14) * x2 + @READ@(vals, v + @W@ * 15) * x3))
			end
			p0 = p1
		end
	end

	local function pj4(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = @W@ * 4 * I, 128 * I
			local t0, t1, t2, t3 = @READ@(r, base + @W@ * 0), @READ@(r, base + @W@ * 1), @READ@(r, base + @W@ * 2), @READ@(r, base + @W@ * 3)
			@WRITE@(o, base + @W@ * 0, buffer.readf64(inv, v + 0) * t0 + buffer.readf64(inv, v + 32) * t1 + buffer.readf64(inv, v + 64) * t2 + buffer.readf64(inv, v + 96) * t3)
			@WRITE@(o, base + @W@ * 1, buffer.readf64(inv, v + 8) * t0 + buffer.readf64(inv, v + 40) * t1 + buffer.readf64(inv, v + 72) * t2 + buffer.readf64(inv, v + 104) * t3)
			@WRITE@(o, base + @W@ * 2, buffer.readf64(inv, v + 16) * t0 + buffer.readf64(inv, v + 48) * t1 + buffer.readf64(inv, v + 80) * t2 + buffer.readf64(inv, v + 112) * t3)
			@WRITE@(o, base + @W@ * 3, buffer.readf64(inv, v + 24) * t0 + buffer.readf64(inv, v + 56) * t1 + buffer.readf64(inv, v + 88) * t2 + buffer.readf64(inv, v + 120) * t3)
		end
	end

	local function bmm4(cv: buffer, xv: buffer, yv: buffer, plan: buffer, count: number)
		for t = 0, count - 1 do
			local c = @W@ * 16 * buffer.readu32(plan, 12 * t)
			local x = @W@ * 16 * buffer.readu32(plan, 12 * t + 4)
			local y = @W@ * 16 * buffer.readu32(plan, 12 * t + 8)
			local x0_0, x1_0, x2_0, x3_0, x0_1, x1_1, x2_1, x3_1, x0_2, x1_2, x2_2, x3_2, x0_3, x1_3, x2_3, x3_3 = @READ@(xv, x + @W@ * 0), @READ@(xv, x + @W@ * 1), @READ@(xv, x + @W@ * 2), @READ@(xv, x + @W@ * 3), @READ@(xv, x + @W@ * 4), @READ@(xv, x + @W@ * 5), @READ@(xv, x + @W@ * 6), @READ@(xv, x + @W@ * 7), @READ@(xv, x + @W@ * 8), @READ@(xv, x + @W@ * 9), @READ@(xv, x + @W@ * 10), @READ@(xv, x + @W@ * 11), @READ@(xv, x + @W@ * 12), @READ@(xv, x + @W@ * 13), @READ@(xv, x + @W@ * 14), @READ@(xv, x + @W@ * 15)
			local y0_0, y1_0, y2_0, y3_0, y0_1, y1_1, y2_1, y3_1, y0_2, y1_2, y2_2, y3_2, y0_3, y1_3, y2_3, y3_3 = @READ@(yv, y + @W@ * 0), @READ@(yv, y + @W@ * 1), @READ@(yv, y + @W@ * 2), @READ@(yv, y + @W@ * 3), @READ@(yv, y + @W@ * 4), @READ@(yv, y + @W@ * 5), @READ@(yv, y + @W@ * 6), @READ@(yv, y + @W@ * 7), @READ@(yv, y + @W@ * 8), @READ@(yv, y + @W@ * 9), @READ@(yv, y + @W@ * 10), @READ@(yv, y + @W@ * 11), @READ@(yv, y + @W@ * 12), @READ@(yv, y + @W@ * 13), @READ@(yv, y + @W@ * 14), @READ@(yv, y + @W@ * 15)
			@WRITE@(cv, c + @W@ * 0, @READ@(cv, c + @W@ * 0) + (x0_0 * y0_0 + x0_1 * y1_0 + x0_2 * y2_0 + x0_3 * y3_0))
			@WRITE@(cv, c + @W@ * 1, @READ@(cv, c + @W@ * 1) + (x1_0 * y0_0 + x1_1 * y1_0 + x1_2 * y2_0 + x1_3 * y3_0))
			@WRITE@(cv, c + @W@ * 2, @READ@(cv, c + @W@ * 2) + (x2_0 * y0_0 + x2_1 * y1_0 + x2_2 * y2_0 + x2_3 * y3_0))
			@WRITE@(cv, c + @W@ * 3, @READ@(cv, c + @W@ * 3) + (x3_0 * y0_0 + x3_1 * y1_0 + x3_2 * y2_0 + x3_3 * y3_0))
			@WRITE@(cv, c + @W@ * 4, @READ@(cv, c + @W@ * 4) + (x0_0 * y0_1 + x0_1 * y1_1 + x0_2 * y2_1 + x0_3 * y3_1))
			@WRITE@(cv, c + @W@ * 5, @READ@(cv, c + @W@ * 5) + (x1_0 * y0_1 + x1_1 * y1_1 + x1_2 * y2_1 + x1_3 * y3_1))
			@WRITE@(cv, c + @W@ * 6, @READ@(cv, c + @W@ * 6) + (x2_0 * y0_1 + x2_1 * y1_1 + x2_2 * y2_1 + x2_3 * y3_1))
			@WRITE@(cv, c + @W@ * 7, @READ@(cv, c + @W@ * 7) + (x3_0 * y0_1 + x3_1 * y1_1 + x3_2 * y2_1 + x3_3 * y3_1))
			@WRITE@(cv, c + @W@ * 8, @READ@(cv, c + @W@ * 8) + (x0_0 * y0_2 + x0_1 * y1_2 + x0_2 * y2_2 + x0_3 * y3_2))
			@WRITE@(cv, c + @W@ * 9, @READ@(cv, c + @W@ * 9) + (x1_0 * y0_2 + x1_1 * y1_2 + x1_2 * y2_2 + x1_3 * y3_2))
			@WRITE@(cv, c + @W@ * 10, @READ@(cv, c + @W@ * 10) + (x2_0 * y0_2 + x2_1 * y1_2 + x2_2 * y2_2 + x2_3 * y3_2))
			@WRITE@(cv, c + @W@ * 11, @READ@(cv, c + @W@ * 11) + (x3_0 * y0_2 + x3_1 * y1_2 + x3_2 * y2_2 + x3_3 * y3_2))
			@WRITE@(cv, c + @W@ * 12, @READ@(cv, c + @W@ * 12) + (x0_0 * y0_3 + x0_1 * y1_3 + x0_2 * y2_3 + x0_3 * y3_3))
			@WRITE@(cv, c + @W@ * 13, @READ@(cv, c + @W@ * 13) + (x1_0 * y0_3 + x1_1 * y1_3 + x1_2 * y2_3 + x1_3 * y3_3))
			@WRITE@(cv, c + @W@ * 14, @READ@(cv, c + @W@ * 14) + (x2_0 * y0_3 + x2_1 * y1_3 + x2_2 * y2_3 + x2_3 * y3_3))
			@WRITE@(cv, c + @W@ * 15, @READ@(cv, c + @W@ * 15) + (x3_0 * y0_3 + x3_1 * y1_3 + x3_2 * y2_3 + x3_3 * y3_3))
		end
	end

	spk.block[4] = { mv = mv4, mvt = mvt4, jacobi = pj4, product = bmm4 }
end
