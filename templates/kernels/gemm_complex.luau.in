	local function small(R: buffer, Q: buffer, c: buffer, m: number, p: number, i0: number, i1: number, j0: number, j1: number, alpha: number, beta: number)
		for j = j0, j1 - 4, 4 do
			local q0 = @E@ * (j + 0) * p; local q1 = @E@ * (j + 1) * p; local q2 = @E@ * (j + 2) * p; local q3 = @E@ * (j + 3) * p
			for i = i0, i1 - 4, 4 do
				local r0 = @E@ * (i + 0) * p; local r1 = @E@ * (i + 1) * p; local r2 = @E@ * (i + 2) * p; local r3 = @E@ * (i + 3) * p
				local u0_0, v0_0, u0_1, v0_1, u0_2, v0_2, u0_3, v0_3 = 0, 0, 0, 0, 0, 0, 0, 0
				local u1_0, v1_0, u1_1, v1_1, u1_2, v1_2, u1_3, v1_3 = 0, 0, 0, 0, 0, 0, 0, 0
				local u2_0, v2_0, u2_1, v2_1, u2_2, v2_2, u2_3, v2_3 = 0, 0, 0, 0, 0, 0, 0, 0
				local u3_0, v3_0, u3_1, v3_1, u3_2, v3_2, u3_3, v3_3 = 0, 0, 0, 0, 0, 0, 0, 0
				for k = 0, @E@ * (p - 1), @E@ do
					local a0, b0 = @READ@(R, r0 + k), @READ@(R, r0 + k + @W@); local a1, b1 = @READ@(R, r1 + k), @READ@(R, r1 + k + @W@); local a2, b2 = @READ@(R, r2 + k), @READ@(R, r2 + k + @W@); local a3, b3 = @READ@(R, r3 + k), @READ@(R, r3 + k + @W@)
					local c0, d0 = @READ@(Q, q0 + k), @READ@(Q, q0 + k + @W@); local c1, d1 = @READ@(Q, q1 + k), @READ@(Q, q1 + k + @W@); local c2, d2 = @READ@(Q, q2 + k), @READ@(Q, q2 + k + @W@); local c3, d3 = @READ@(Q, q3 + k), @READ@(Q, q3 + k + @W@)
					u0_0 += a0 * c0 - b0 * d0; v0_0 += a0 * d0 + b0 * c0; u0_1 += a0 * c1 - b0 * d1; v0_1 += a0 * d1 + b0 * c1; u0_2 += a0 * c2 - b0 * d2; v0_2 += a0 * d2 + b0 * c2; u0_3 += a0 * c3 - b0 * d3; v0_3 += a0 * d3 + b0 * c3
					u1_0 += a1 * c0 - b1 * d0; v1_0 += a1 * d0 + b1 * c0; u1_1 += a1 * c1 - b1 * d1; v1_1 += a1 * d1 + b1 * c1; u1_2 += a1 * c2 - b1 * d2; v1_2 += a1 * d2 + b1 * c2; u1_3 += a1 * c3 - b1 * d3; v1_3 += a1 * d3 + b1 * c3
					u2_0 += a2 * c0 - b2 * d0; v2_0 += a2 * d0 + b2 * c0; u2_1 += a2 * c1 - b2 * d1; v2_1 += a2 * d1 + b2 * c1; u2_2 += a2 * c2 - b2 * d2; v2_2 += a2 * d2 + b2 * c2; u2_3 += a2 * c3 - b2 * d3; v2_3 += a2 * d3 + b2 * c3
					u3_0 += a3 * c0 - b3 * d0; v3_0 += a3 * d0 + b3 * c0; u3_1 += a3 * c1 - b3 * d1; v3_1 += a3 * d1 + b3 * c1; u3_2 += a3 * c2 - b3 * d2; v3_2 += a3 * d2 + b3 * c2; u3_3 += a3 * c3 - b3 * d3; v3_3 += a3 * d3 + b3 * c3
				end
				do
					local o = @E@ * ((j + 0) * m + i + 0)
					if beta == 0 then
						@WRITE@(c, o, alpha * u0_0)
						@WRITE@(c, o + @W@, alpha * v0_0)
					else
						@WRITE@(c, o, alpha * u0_0 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v0_0 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 0) * m + i + 1)
					if beta == 0 then
						@WRITE@(c, o, alpha * u1_0)
						@WRITE@(c, o + @W@, alpha * v1_0)
					else
						@WRITE@(c, o, alpha * u1_0 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v1_0 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 0) * m + i + 2)
