					end
				end
				do
					local o = @E@ * ((j + 0) * m + i + 3)
					if beta == 0 then
						@WRITE@(c, o, alpha * u3_0)
						@WRITE@(c, o + @W@, alpha * v3_0)
					else
						@WRITE@(c, o, alpha * u3_0 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v3_0 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 1) * m + i + 0)
					if beta == 0 then
						@WRITE@(c, o, alpha * u0_1)
						@WRITE@(c, o + @W@, alpha * v0_1)
					else
						@WRITE@(c, o, alpha * u0_1 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v0_1 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 1) * m + i + 1)
					if beta == 0 then
						@WRITE@(c, o, alpha * u1_1)
						@WRITE@(c, o + @W@, alpha * v1_1)
					else
						@WRITE@(c, o, alpha * u1_1 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v1_1 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 1) * m + i + 2)
					if beta == 0 then
						@WRITE@(c, o, alpha * u2_1)
						@WRITE@(c, o + @W@, alpha * v2_1)
					else
						@WRITE@(c, o, alpha * u2_1 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v2_1 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 1) * m + i + 3)
					if beta == 0 then
						@WRITE@(c, o, alpha * u3_1)
						@WRITE@(c, o + @W@, alpha * v3_1)
					else
						@WRITE@(c, o, alpha * u3_1 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v3_1 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 2) * m + i + 0)
					if beta == 0 then
						@WRITE@(c, o, alpha * u0_2)
						@WRITE@(c, o + @W@, alpha * v0_2)
					else
						@WRITE@(c, o, alpha * u0_2 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v0_2 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 2) * m + i + 1)
					if beta == 0 then
						@WRITE@(c, o, alpha * u1_2)
						@WRITE@(c, o + @W@, alpha * v1_2)
					else
						@WRITE@(c, o, alpha * u1_2 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v1_2 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 2) * m + i + 2)
					if beta == 0 then
						@WRITE@(c, o, alpha * u2_2)
						@WRITE@(c, o + @W@, alpha * v2_2)
					else
						@WRITE@(c, o, alpha * u2_2 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v2_2 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 2) * m + i + 3)
					if beta == 0 then
						@WRITE@(c, o, alpha * u3_2)
						@WRITE@(c, o + @W@, alpha * v3_2)
					else
						@WRITE@(c, o, alpha * u3_2 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v3_2 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 3) * m + i + 0)
					if beta == 0 then
						@WRITE@(c, o, alpha * u0_3)
						@WRITE@(c, o + @W@, alpha * v0_3)
					else
						@WRITE@(c, o, alpha * u0_3 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v0_3 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 3) * m + i + 1)
					if beta == 0 then
						@WRITE@(c, o, alpha * u1_3)
						@WRITE@(c, o + @W@, alpha * v1_3)
					else
						@WRITE@(c, o, alpha * u1_3 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v1_3 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 3) * m + i + 2)
					if beta == 0 then
						@WRITE@(c, o, alpha * u2_3)
						@WRITE@(c, o + @W@, alpha * v2_3)
					else
						@WRITE@(c, o, alpha * u2_3 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v2_3 + beta * @READ@(c, o + @W@))
					end
				end
				do
					local o = @E@ * ((j + 3) * m + i + 3)
					if beta == 0 then
						@WRITE@(c, o, alpha * u3_3)
						@WRITE@(c, o + @W@, alpha * v3_3)
					else
						@WRITE@(c, o, alpha * u3_3 + beta * @READ@(c, o))
						@WRITE@(c, o + @W@, alpha * v3_3 + beta * @READ@(c, o + @W@))
					end
				end
			end
		end
	end

	local function single(R: buffer, Q: buffer, c: buffer, m: number, p: number, i0: number, i1: number, j0: number, j1: number, alpha: number, beta: number)
		for j = j0, j1 - 1 do
			for i = i0, i1 - 1 do
				local u, v = 0, 0
				local r, q = @E@ * i * p, @E@ * j * p
				for k = 0, @E@ * (p - 1), @E@ do
					local a, b = @READ@(R, r + k), @READ@(R, r + k + @W@)
					local x, y = @READ@(Q, q + k), @READ@(Q, q + k + @W@)
					u += a * x - b * y
					v += a * y + b * x
				end
				local o = @E@ * (j * m + i)
				if beta == 0 then
					@WRITE@(c, o, alpha * u)
					@WRITE@(c, o + @W@, alpha * v)
				else
					@WRITE@(c, o, alpha * u + beta * @READ@(c, o))
					@WRITE@(c, o + @W@, alpha * v + beta * @READ@(c, o + @W@))
				end
			end
		end
	end

	-- Cover rows i0 .. i1 - 1 and columns j0 .. j1 - 1: 8 by 8 blocks, then 4 by 4
	-- blocks over what is left, then single entries.
	function gemm_kernel(R: buffer, Q: buffer, c: buffer, m: number, p: number, n: number, alpha: number, beta: number)
		local mb, nb = m - m % 8, n - n % 8
		big(R, Q, c, m, p, 0, mb, 0, nb, alpha, beta)
		-- The right strip (all rows) and the bottom strip (the big blocks' columns).
		local function rest(i0: number, i1: number, j0: number, j1: number)
			if i1 <= i0 or j1 <= j0 then
				return
			end
			local i4 = i0 + (i1 - i0) - (i1 - i0) % 4
			local j4 = j0 + (j1 - j0) - (j1 - j0) % 4
			small(R, Q, c, m, p, i0, i4, j0, j4, alpha, beta)
			single(R, Q, c, m, p, i4, i1, j0, j4, alpha, beta)
			single(R, Q, c, m, p, i0, i1, j4, j1, alpha, beta)
		end
		rest(0, m, nb, n)
		rest(mb, m, 0, nb)
	end
end
