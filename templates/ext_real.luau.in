-- Matrix utilities, matrix norms, slogdet and transposed LU solves.

do
	-- The sum of the diagonal.
	function ext.trace(A: Matrix): number
		local s = 0
		for i = 0, math.min(A.rows, A.cols) - 1 do
			s += @READ@(A.data, @W@ * (i * A.rows + i))
		end
		return s
	end

	-- The diagonal (min(rows, cols) entries), as an array.
	function ext.diag(out: buffer?, A: Matrix): buffer
		local n = math.min(A.rows, A.cols)
		local o = output(out, @W@ * n)
		for i = 0, n - 1 do
			@WRITE@(o, @W@ * i, @READ@(A.data, @W@ * (i * A.rows + i)))
		end
		return o
	end

	-- The square matrix with the array x on its diagonal.
	function ext.diagm(x: buffer): Matrix
		local n = length(x)
		local D = matrix(n, n)
		for i = 0, n - 1 do
			@WRITE@(D.data, @W@ * (i * n + i), @READ@(x, @W@ * i))
		end
		return D
	end

	-- The Kronecker product: the block matrix [a_ij B].
	function ext.kron(A: Matrix, B: Matrix): Matrix
		local m, n, p, q = A.rows, A.cols, B.rows, B.cols
		local K = matrix(m * p, n * q)
		local k, a, b = K.data, A.data, B.data
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				local aij = @READ@(a, @W@ * (j * m + i))
				if aij ~= 0 then
					for l = 0, q - 1 do
						local col = (j * q + l) * m * p + i * p
						for r = 0, p - 1 do
							@WRITE@(k, @W@ * (col + r), aij * @READ@(b, @W@ * (l * p + r)))
						end
					end
				end
			end
		end
		return K
	end

	-- The outer product x y^T.
	function ext.outer(out: Matrix?, x: buffer, y: buffer): Matrix
		local m, n = length(x), length(y)
		local o = matoutput(out, m, n)
		for j = 0, n - 1 do
			local yj = @READ@(y, @W@ * j)
			for i = 0, m - 1 do
				@WRITE@(o.data, @W@ * (j * m + i), @READ@(x, @W@ * i) * yj)
			end
		end
		return o
	end

	-- The rank-one update A := A + a x y^T, in place (BLAS ger); returns A.
	function ext.ger(A: Matrix, a: number, x: buffer, y: buffer): Matrix
		local m, n = A.rows, A.cols
		assert(length(x) == m and length(y) == n, "ger: sizes do not match")
		for j = 0, n - 1 do
			local f = a * @READ@(y, @W@ * j)
			if f ~= 0 then
				for i = 0, m - 1 do
					local o = @W@ * (j * m + i)
					@WRITE@(A.data, o, @READ@(A.data, o) + f * @READ@(x, @W@ * i))
				end
			end
		end
		return A
	end

	-- A^T x, without forming the transpose.
	function ext.matvec_adjoint(out: buffer?, A: Matrix, x: buffer): buffer
		local m, n = A.rows, A.cols
		assert(length(x) == m, "matvec_adjoint: sizes do not match")
		local o = output(out, @W@ * n)
		assert(o ~= x, "output cannot be the input vector")
		for j = 0, n - 1 do
			local s = 0
			for i = 0, m - 1 do
				s += @READ@(A.data, @W@ * (j * m + i)) * @READ@(x, @W@ * i)
			end
			@WRITE@(o, @W@ * j, s)
		end
		return o
	end

	-- C := alpha op(A) op(B) + beta C (BLAS gemm), where op is "n" (as is), "t" or "c"
	-- (transposed; the same for real matrices). C is new (or out) when beta is 0 or nil.
	-- Sums run in double precision and each entry is rounded once.
	function ext.gemm(C: Matrix?, alpha: number, A: Matrix, B: Matrix, beta: number?, opa: string?, opb: string?): Matrix
		local ta, tb = opa ~= nil and opa ~= "n", opb ~= nil and opb ~= "n"
		local m, kk = if ta then A.cols else A.rows, if ta then A.rows else A.cols
		local kb, n = if tb then B.cols else B.rows, if tb then B.rows else B.cols
		assert(kk == kb, "gemm: inner dimensions do not match")
		local b0 = beta or 0
		local o: Matrix
		if b0 == 0 then
			o = matoutput(C, m, n)
		else
			assert(C ~= nil and C.rows == m and C.cols == n, "gemm: beta needs a C of the right shape")
			o = C
		end
		assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
		local a, b, c = A.data, B.data, o.data
		local am, bm = A.rows, B.rows
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				local s = 0
				for k = 0, kk - 1 do
					local x = if ta then @READ@(a, @W@ * (i * am + k)) else @READ@(a, @W@ * (k * am + i))
					local y = if tb then @READ@(b, @W@ * (k * bm + j)) else @READ@(b, @W@ * (j * bm + k))
					s += x * y
				end
				local off = @W@ * (j * m + i)
				@WRITE@(c, off, alpha * s + (if b0 ~= 0 then b0 * @READ@(c, off) else 0))
			end
		end
		return o
	end

	-- The sign and the log of the absolute value of det(A), without overflow: returns
	-- (sign, log |det|), with sign 0 and log -inf for a singular matrix.
	function ext.slogdet(A: Matrix): (number, number)
		local F = lu_copy(A)
		local n = A.rows
		local sign, logabs = F.sign, 0
		for k = 0, n - 1 do
			local u = @READ@(F.lu.data, @W@ * (k * n + k))
			if u == 0 then
				return 0, -math.huge
			end
			if u < 0 then
				sign = -sign
			end
			logabs += math.log(math.abs(u))
		end
		return sign, logabs
	end

	-- Matrix norms: kind 1 (largest column sum of |a_ij|), "inf" (largest row sum), 2
	-- (largest singular value) or "fro" (Frobenius; the default).
	function ext.matnorm(A: Matrix, kind: (number | string)?): number
		local m, n = A.rows, A.cols
		local a = A.data
		if kind == nil or kind == "fro" then
			return norm(a)
		elseif kind == 2 then
			if m == 0 or n == 0 then
				return 0
			end
			return @READ@(svd_copy(A, false).values, 0)
		elseif kind == 1 then
			local best = 0
			for j = 0, n - 1 do
				local s = 0
				for i = 0, m - 1 do
					s += math.abs(@READ@(a, @W@ * (j * m + i)))
				end
				if not (s <= best) then
					best = s
				end
			end
			return best
		elseif kind == "inf" then
			local rows = table.create(m, 0) :: { number }
			for j = 0, n - 1 do
				for i = 0, m - 1 do
					rows[i + 1] += math.abs(@READ@(a, @W@ * (j * m + i)))
				end
			end
			local best = 0
			for _, s in rows do
				if not (s <= best) then
					best = s
				end
			end
			return best
		end
		error(`matnorm: unknown kind {kind}`)
	end

	-- Solves A^T x = b given F = lu(A) (P A = L U, so A^T = U^T L^T P).
	function ext.lu_solve_adjoint(out: buffer?, F: LU, b: buffer): buffer
		assert(not F.singular, "matrix is singular")
		local n = F.lu.rows
		assert(buffer.len(b) == @W@ * n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = F.lu.data
		-- U^T y = b, forward.
		for j = 0, n - 1 do
			local s = @READ@(o, @W@ * j)
			for i = 0, j - 1 do
				s -= @READ@(a, @W@ * (j * n + i)) * @READ@(o, @W@ * i)
			end
			@WRITE@(o, @W@ * j, s / @READ@(a, @W@ * (j * n + j)))
		end
		-- L^T z = y, backward (unit diagonal).
		for j = n - 1, 0, -1 do
			local s = @READ@(o, @W@ * j)
			for i = j + 1, n - 1 do
				s -= @READ@(a, @W@ * (j * n + i)) * @READ@(o, @W@ * i)
			end
			@WRITE@(o, @W@ * j, s)
		end
		-- x = P^T z: the interchanges in reverse.
		for k = n - 1, 0, -1 do
			local p = F.piv[k + 1] - 1
			if p ~= k then
				local tmp = @READ@(o, @W@ * k)
				@WRITE@(o, @W@ * k, @READ@(o, @W@ * p))
				@WRITE@(o, @W@ * p, tmp)
			end
		end
		return o
	end

	-- Helpers for the condition estimator: the 1-norm of a vector, the signs of its
	-- entries (1 for zero), the index (1-based) and size of its largest entry, a real dot
	-- product, and the unit vector e_j.
	function ext.asum(x: buffer): number
		local s = 0
		for k = 0, buffer.len(x) - @W@, @W@ do
			s += math.abs(@READ@(x, k))
		end
		return s
	end

	function ext.signs(x: buffer): buffer
		local o = buffer.create(buffer.len(x))
		for k = 0, buffer.len(x) - @W@, @W@ do
			@WRITE@(o, k, if @READ@(x, k) < 0 then -1 else 1)
		end
		return o
	end

	function ext.argmax(x: buffer): (number, number)
		local best, at = -1, 1
		for i = 0, length(x) - 1 do
			local v = math.abs(@READ@(x, @W@ * i))
			if v > best then
				best, at = v, i + 1
			end
		end
		return best, at
	end

	ext.rdot = dot

	-- Element i (0-based) as (re, im), and its setter (the imaginary part is dropped), for
	-- code shared with the complex modules.
	function ext.eget(x: buffer, i: number): (number, number)
		return @READ@(x, @W@ * i), 0
	end

	function ext.eset(x: buffer, i: number, re: number, _im: number)
		@WRITE@(x, @W@ * i, re)
	end

	function ext.unit(n: number, j: number): buffer
		local e = create(n)
		@WRITE@(e, @W@ * (j - 1), 1)
		return e
	end
end
