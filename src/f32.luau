-- Arrays

local function create(n: number): buffer
	return buffer.create(4 * n)
end

local function length(x: buffer): number
	return buffer.len(x) // 4
end

local function similar(x: buffer): buffer
	return buffer.create(buffer.len(x))
end

local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

local function check_same(x: buffer, y: buffer)
	assert(buffer.len(x) == buffer.len(y), "arrays have different lengths")
end

local function from(t: { number }): buffer
	local x = buffer.create(4 * #t)
	for i = 1, #t do
		buffer.writef32(x, 4 * (i - 1), t[i])
	end
	return x
end

local function totable(x: buffer): { number }
	local n = length(x)
	local t = table.create(n, 0)
	for i = 1, n do
		t[i] = buffer.readf32(x, 4 * (i - 1))
	end
	return t
end

local function get(x: buffer, i: number): number
	return buffer.readf32(x, 4 * (i - 1))
end

local function set(x: buffer, i: number, v: number)
	buffer.writef32(x, 4 * (i - 1), v)
end

local function fill(out: buffer, v: number): buffer
	for k = 0, buffer.len(out) - 4, 4 do
		buffer.writef32(out, k, v)
	end
	return out
end

local function copy(out: buffer?, x: buffer): buffer
	local o = output(out, buffer.len(x))
	if o ~= x then
		buffer.copy(o, 0, x)
	end
	return o
end

local function add(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(o, k, buffer.readf32(x, k) + buffer.readf32(y, k))
	end
	return o
end

local function sub(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(o, k, buffer.readf32(x, k) - buffer.readf32(y, k))
	end
	return o
end

-- Elementwise (Hadamard) product.
local function mul(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(o, k, buffer.readf32(x, k) * buffer.readf32(y, k))
	end
	return o
end

local function scale(out: buffer?, a: number, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(o, k, a * buffer.readf32(x, k))
	end
	return o
end

-- a * x + y
local function axpy(out: buffer?, a: number, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(o, k, a * buffer.readf32(x, k) + buffer.readf32(y, k))
	end
	return o
end

local function dot(x: buffer, y: buffer): number
	check_same(x, y)
	local s = 0
	for k = 0, buffer.len(x) - 4, 4 do
		s += buffer.readf32(x, k) * buffer.readf32(y, k)
	end
	return s
end

local function sum(x: buffer): number
	local s = 0
	for k = 0, buffer.len(x) - 4, 4 do
		s += buffer.readf32(x, k)
	end
	return s
end

-- Largest absolute value (NaN if any element is NaN, 0 for an empty array).
local function amax(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - 4, 4 do
		local a = math.abs(buffer.readf32(x, k))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	return m
end

-- Euclidean norm of `count` consecutive reals starting at byte offset `start`. The plain
-- sum of squares is used unless it overflowed or may have lost digits to underflow; then
-- the values are rescaled by the largest magnitude. NaN if any value is NaN.
local function segment_norm(x: buffer, start: number, count: number): number
	local stop = start + 4 * (count - 1)
	local s = 0
	for k = start, stop, 4 do
		local v = buffer.readf32(x, k)
		s += v * v
	end
	if s > 2 ^ -500 and s < math.huge then
		return math.sqrt(s)
	end
	local m = 0
	for k = start, stop, 4 do
		local a = math.abs(buffer.readf32(x, k))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	if m == 0 or m == math.huge then
		return m
	end
	s = 0
	for k = start, stop, 4 do
		local v = buffer.readf32(x, k) / m
		s += v * v
	end
	return m * math.sqrt(s)
end

-- True if any of `count` consecutive reals starting at byte offset `start` is NaN or
-- infinite (v - v is NaN exactly for those).
local function any_nonfinite(x: buffer, start: number, count: number): boolean
	for k = start, start + 4 * (count - 1), 4 do
		local v = buffer.readf32(x, k)
		if v - v ~= 0 then
			return true
		end
	end
	return false
end

-- Sets `count` consecutive reals starting at byte offset `start` to NaN.
local function fill_nan(x: buffer, start: number, count: number)
	for k = start, start + 4 * (count - 1), 4 do
		buffer.writef32(x, k, 0 / 0)
	end
end

-- range_factor(m) is 1 if m is in [2^-459, 2^459] (LAPACK's smlnum and bignum for
-- doubles), and otherwise the power of 2 that brings m near 1. range_scale(x) scales x in
-- place by range_factor of its largest |value| and returns that factor. The eigen and SVD
-- drivers scale this way, as LAPACK's do, so their iterations neither underflow nor
-- overflow and their absolute thresholds (such as trevc's smlnum) stay negligible. Scaling
-- by a power of 2 is exact unless an entry lands in the subnormal range. Stored f32 values
-- are never outside the range.
local function range_factor(m: number): number
	if m == 0 or m == math.huge or m ~= m or (m >= 2 ^ -459 and m <= 2 ^ 459) then
		return 1
	end
	local _, e = math.frexp(m)
	return 2 ^ -e
end

local function range_scale(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - 4, 4 do
		local a = math.abs(buffer.readf32(x, k))
		if a > m then
			m = a
		end
	end
	local f = range_factor(m)
	if f == 1 then
		return 1
	end
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(x, k, buffer.readf32(x, k) * f)
	end
	return f
end

-- sqrt(a^2 + b^2 + c^2) without overflow or underflow.
local function hypot3(a: number, b: number, c: number): number
	a, b, c = math.abs(a), math.abs(b), math.abs(c)
	local m = math.max(a, b, c)
	if m == 0 or m == math.huge or m ~= m then
		return m
	end
	a, b, c = a / m, b / m, c / m
	return m * math.sqrt(a * a + b * b + c * c)
end

-- Euclidean norm, without overflow or underflow.
local function norm(x: buffer): number
	return segment_norm(x, 0, length(x))
end

-- Matrices

local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(4 * rows * cols) }
end

local function matoutput(out: Matrix?, rows: number, cols: number): Matrix
	if out == nil then
		return matrix(rows, cols)
	end
	assert(out.rows == rows and out.cols == cols, "output has the wrong shape")
	return out
end

-- Builds a matrix from a table of rows.
local function matfrom(t: { { number } }): Matrix
	local rows = #t
	local cols = if rows > 0 then #t[1] else 0
	local A = matrix(rows, cols)
	for i = 1, rows do
		local row = t[i]
		assert(#row == cols, "rows have different lengths")
		for j = 1, cols do
			buffer.writef32(A.data, 4 * ((j - 1) * rows + i - 1), row[j])
		end
	end
	return A
end

-- Returns a table of rows.
local function mattotable(A: Matrix): { { number } }
	local t = table.create(A.rows) :: { { number } }
	for i = 1, A.rows do
		local row = table.create(A.cols, 0)
		for j = 1, A.cols do
			row[j] = buffer.readf32(A.data, 4 * ((j - 1) * A.rows + i - 1))
		end
		t[i] = row
	end
	return t
end

local function identity(n: number): Matrix
	local A = matrix(n, n)
	for i = 0, n - 1 do
		buffer.writef32(A.data, 4 * (i * n + i), 1)
	end
	return A
end

local function matget(A: Matrix, i: number, j: number): number
	return buffer.readf32(A.data, 4 * ((j - 1) * A.rows + i - 1))
end

local function matset(A: Matrix, i: number, j: number, v: number)
	buffer.writef32(A.data, 4 * ((j - 1) * A.rows + i - 1), v)
end

local function matcopy(out: Matrix?, A: Matrix): Matrix
	local o = matoutput(out, A.rows, A.cols)
	if o.data ~= A.data then
		buffer.copy(o.data, 0, A.data)
	end
	return o
end

local function transpose(out: Matrix?, A: Matrix): Matrix
	local m, n = A.rows, A.cols
	local o = matoutput(out, n, m)
	assert(o.data ~= A.data, "transpose cannot be done in place")
	local a, d = A.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			buffer.writef32(d, 4 * (i * n + j), buffer.readf32(a, 4 * (j * m + i)))
		end
	end
	return o
end

-- A x
local function matvec(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(buffer.len(x) == 4 * n, "matrix and vector sizes do not match")
	local o = output(out, 4 * m)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, m - 1 do
		local s = 0
		for j = 0, n - 1 do
			s += buffer.readf32(a, 4 * (j * m + i)) * buffer.readf32(x, 4 * j)
		end
		buffer.writef32(o, 4 * i, s)
	end
	return o
end

-- A B
local function matmul(out: Matrix?, A: Matrix, B: Matrix): Matrix
	local m, p, n = A.rows, A.cols, B.cols
	assert(B.rows == p, "matrix sizes do not match")
	local o = matoutput(out, m, n)
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	local a, b, c = A.data, B.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local s = 0
			for k = 0, p - 1 do
				s += buffer.readf32(a, 4 * (k * m + i)) * buffer.readf32(b, 4 * (j * p + k))
			end
			buffer.writef32(c, 4 * (j * m + i), s)
		end
	end
	return o
end

-- LU factorization with partial pivoting, in place: A is overwritten with L and U (see
-- types.LU) and returned as F.lu. lu_copy leaves A unchanged.
local function lu(A: Matrix): LU
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local piv = table.create(n, 0)
	local sign = 1
	local singular = false
	for k = 0, n - 1 do
		local p, best = k, -1
		for i = k, n - 1 do
			local v = math.abs(buffer.readf32(a, 4 * (k * n + i)))
			if v > best then
				p, best = i, v
			end
		end
		piv[k + 1] = p + 1
		if p ~= k then
			sign = -sign
			for j = 0, n - 1 do
				local s, t = 4 * (j * n + k), 4 * (j * n + p)
				local tmp = buffer.readf32(a, s)
				buffer.writef32(a, s, buffer.readf32(a, t))
				buffer.writef32(a, t, tmp)
			end
		end
		local pivot = buffer.readf32(a, 4 * (k * n + k))
		if pivot == 0 then
			singular = true
		else
			for i = k + 1, n - 1 do
				local off = 4 * (k * n + i)
				buffer.writef32(a, off, buffer.readf32(a, off) / pivot)
			end
			for j = k + 1, n - 1 do
				local akj = buffer.readf32(a, 4 * (j * n + k))
				for i = k + 1, n - 1 do
					local off = 4 * (j * n + i)
					buffer.writef32(a, off, buffer.readf32(a, off) - buffer.readf32(a, 4 * (k * n + i)) * akj)
				end
			end
		end
	end
	return { lu = A, piv = piv, sign = sign, singular = singular }
end

-- LU factorization of a copy of A; A is not modified.
local function lu_copy(A: Matrix): LU
	return lu(matcopy(nil, A))
end

-- Solves A x = b given F = lu(A).
local function lu_solve(out: buffer?, F: LU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.lu.rows
	assert(buffer.len(b) == 4 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a, piv = F.lu.data, F.piv
	for k = 0, n - 1 do
		local p = piv[k + 1] - 1
		if p ~= k then
			local tmp = buffer.readf32(o, 4 * k)
			buffer.writef32(o, 4 * k, buffer.readf32(o, 4 * p))
			buffer.writef32(o, 4 * p, tmp)
		end
	end
	for j = 0, n - 1 do
		local xj = buffer.readf32(o, 4 * j)
		for i = j + 1, n - 1 do
			local off = 4 * i
			buffer.writef32(o, off, buffer.readf32(o, off) - buffer.readf32(a, 4 * (j * n + i)) * xj)
		end
	end
	for j = n - 1, 0, -1 do
		local xj = buffer.readf32(o, 4 * j) / buffer.readf32(a, 4 * (j * n + j))
		buffer.writef32(o, 4 * j, xj)
		for i = 0, j - 1 do
			local off = 4 * i
			buffer.writef32(o, off, buffer.readf32(o, off) - buffer.readf32(a, 4 * (j * n + i)) * xj)
		end
	end
	return o
end

-- The inverse of a square matrix, in place (LAPACK's getrf + getri): A is overwritten
-- with A^-1 and returned. An error if A is exactly singular. Solving with solve (or a
-- factorization) is faster and more accurate than forming A^-1 and multiplying; use this
-- when the inverse itself is needed. inv_copy leaves A unchanged.
local function inv(A: Matrix): Matrix
	local F = lu(A)
	assert(not F.singular, "inv: matrix is singular")
	local n = A.rows
	local a = A.data
	local function at(i: number, j: number): number
		return 4 * (j * n + i)
	end
	-- U := U^-1 (trti2): column j of the inverse is -u_jj^-1 times the inverted leading
	-- block times the old column.
	for j = 0, n - 1 do
		local ujj = 1 / buffer.readf32(a, at(j, j))
		buffer.writef32(a, at(j, j), ujj)
		for k = 0, j - 1 do
			local tk = buffer.readf32(a, at(k, j))
			if tk ~= 0 then
				for i = 0, k - 1 do
					buffer.writef32(a, at(i, j), buffer.readf32(a, at(i, j)) + tk * buffer.readf32(a, at(i, k)))
				end
				buffer.writef32(a, at(k, j), tk * buffer.readf32(a, at(k, k)))
			end
		end
		for i = 0, j - 1 do
			buffer.writef32(a, at(i, j), -ujj * buffer.readf32(a, at(i, j)))
		end
	end
	-- Solve X L = U^-1 for X = (P A)^-1, a column at a time from the right (getri).
	local work = table.create(n, 0)
	for j = n - 1, 0, -1 do
		for i = j + 1, n - 1 do
			work[i + 1] = buffer.readf32(a, at(i, j))
			buffer.writef32(a, at(i, j), 0)
		end
		for k = j + 1, n - 1 do
			local w = work[k + 1]
			if w ~= 0 then
				for i = 0, n - 1 do
					buffer.writef32(a, at(i, j), buffer.readf32(a, at(i, j)) - w * buffer.readf32(a, at(i, k)))
				end
			end
		end
	end
	-- A^-1 = X P: undo the row interchanges as column interchanges, last first.
	for j = n - 2, 0, -1 do
		local p = F.piv[j + 1] - 1
		if p ~= j then
			for i = 0, n - 1 do
				local s, t = at(i, j), at(i, p)
				local tmp = buffer.readf32(a, s)
				buffer.writef32(a, s, buffer.readf32(a, t))
				buffer.writef32(a, t, tmp)
			end
		end
	end
	return A
end

-- The inverse of a copy of A; A is not modified.
local function inv_copy(A: Matrix): Matrix
	return inv(matcopy(nil, A))
end

local function det(A: Matrix): number
	local F = lu_copy(A)
	local d = F.sign
	local n = A.rows
	for k = 0, n - 1 do
		d *= buffer.readf32(F.lu.data, 4 * (k * n + k))
	end
	return d
end

-- Cholesky

-- Cholesky factorization A = L L^T of a symmetric positive definite matrix, in place:
-- the lower triangle of A is overwritten with L and returned as F.chol. Only the lower
-- triangle of A is read and the strictly upper triangle is left as it was. If A is not
-- positive definite, F.definite is false and A is partly overwritten. chol_copy leaves A
-- unchanged.
local function chol(A: Matrix): Cholesky
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	for j = 0, n - 1 do
		local d = buffer.readf32(a, 4 * (j * n + j))
		if not (d > 0) then
			return { chol = A, definite = false }
		end
		local ljj = math.sqrt(d)
		buffer.writef32(a, 4 * (j * n + j), ljj)
		for i = j + 1, n - 1 do
			local off = 4 * (j * n + i)
			buffer.writef32(a, off, buffer.readf32(a, off) / ljj)
		end
		-- Subtract the new column's outer product from the trailing lower triangle.
		for c = j + 1, n - 1 do
			local lc = buffer.readf32(a, 4 * (j * n + c))
			for i = c, n - 1 do
				local off = 4 * (c * n + i)
				buffer.writef32(a, off, buffer.readf32(a, off) - buffer.readf32(a, 4 * (j * n + i)) * lc)
			end
		end
	end
	return { chol = A, definite = true }
end

-- Cholesky factorization of a copy of A; A is not modified.
local function chol_copy(A: Matrix): Cholesky
	return chol(matcopy(nil, A))
end

-- The lower triangular factor L, with zeros above the diagonal.
local function chol_l(out: Matrix?, F: Cholesky): Matrix
	local n = F.chol.rows
	local o = matoutput(out, n, n)
	local a, l = F.chol.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = 4 * (j * n + i)
			buffer.writef32(l, off, if i >= j then buffer.readf32(a, off) else 0)
		end
	end
	return o
end

-- Solves A x = b given F = chol(A). b is not modified unless it is passed as out.
local function chol_solve(out: buffer?, F: Cholesky, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local n = F.chol.rows
	assert(buffer.len(b) == 4 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = F.chol.data
	-- L y = b
	for j = 0, n - 1 do
		local yj = buffer.readf32(o, 4 * j) / buffer.readf32(a, 4 * (j * n + j))
		buffer.writef32(o, 4 * j, yj)
		for i = j + 1, n - 1 do
			local off = 4 * i
			buffer.writef32(o, off, buffer.readf32(o, off) - buffer.readf32(a, 4 * (j * n + i)) * yj)
		end
	end
	-- L^T x = y, a dot product down each column of L.
	for j = n - 1, 0, -1 do
		local s = buffer.readf32(o, 4 * j)
		for i = j + 1, n - 1 do
			s -= buffer.readf32(a, 4 * (j * n + i)) * buffer.readf32(o, 4 * i)
		end
		buffer.writef32(o, 4 * j, s / buffer.readf32(a, 4 * (j * n + j)))
	end
	return o
end

-- Householder QR

-- Unit roundoff of the storage precision.
local EPS = 2 ^ -24

-- Applies I - t v v^T to the `len` values of x starting at byte offset `xs`. v starts at
-- byte offset `vs` of `a`; its first entry is an implicit 1.
local function reflect(a: buffer, vs: number, len: number, t: number, x: buffer, xs: number)
	local w = buffer.readf32(x, xs)
	for i = 1, len - 1 do
		w += buffer.readf32(a, vs + 4 * i) * buffer.readf32(x, xs + 4 * i)
	end
	if w == 0 then
		return
	end
	w *= t
	buffer.writef32(x, xs, buffer.readf32(x, xs) - w)
	for i = 1, len - 1 do
		local off = xs + 4 * i
		buffer.writef32(x, off, buffer.readf32(x, off) - w * buffer.readf32(a, vs + 4 * i))
	end
end

-- Turns the `len` values of `a` starting at byte offset `diag` into a Householder
-- reflector, in place: beta at `diag` and v below it (its leading 1 is implicit). Stores
-- tau as element k of `tau` and returns it; tau = 0 (H = I) when there is nothing to zero.
local function householder(a: buffer, diag: number, len: number, tau: buffer, k: number): number
	local alpha = buffer.readf32(a, diag)
	local xnorm = segment_norm(a, diag + 4, len - 1)
	if xnorm == 0 then
		buffer.writef32(tau, 4 * k, 0)
		return 0
	end
	local beta = hypot3(alpha, 0, xnorm)
	if alpha >= 0 then
		beta = -beta
	end
	buffer.writef32(tau, 4 * k, (beta - alpha) / beta)
	-- alpha and beta have opposite signs, so this cannot cancel.
	local d = alpha - beta
	for off = diag + 4, diag + 4 * (len - 1), 4 do
		buffer.writef32(a, off, buffer.readf32(a, off) / d)
	end
	buffer.writef32(a, diag, beta)
	return buffer.readf32(tau, 4 * k)
end

-- Solves R z = y in place on the first r entries of y, where R is the leading r by r
-- block of the upper triangle stored in `a` (a matrix with m rows).
local function back_substitute(a: buffer, m: number, r: number, y: buffer)
	for j = r - 1, 0, -1 do
		local rjj = buffer.readf32(a, 4 * (j * m + j))
		assert(rjj ~= 0, "matrix is rank deficient")
		local yj = buffer.readf32(y, 4 * j) / rjj
		buffer.writef32(y, 4 * j, yj)
		for i = 0, j - 1 do
			local off = 4 * i
			buffer.writef32(y, off, buffer.readf32(y, off) - buffer.readf32(a, 4 * (j * m + i)) * yj)
		end
	end
end

-- Householder QR factorization, in place: A is overwritten (see types.QR for the layout)
-- and returned as F.qr. qr_copy leaves A unchanged.
local function qr(A: Matrix): QR
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(4 * kmax)
	for k = 0, kmax - 1 do
		local diag = 4 * (k * m + k)
		local t = householder(a, diag, m - k, tau, k)
		if t ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, t, a, 4 * (j * m + k))
			end
		end
	end
	return { qr = A, tau = tau }
end

-- Householder QR factorization of a copy of A; A is not modified.
local function qr_copy(A: Matrix): QR
	return qr(matcopy(nil, A))
end

-- x := Q^T x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_qh(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == 4 * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = 0, buffer.len(tau) // 4 - 1 do
		reflect(a, 4 * (k * m + k), m - k, buffer.readf32(tau, 4 * k), x, 4 * k)
	end
	return x
end

-- x := Q x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_q(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == 4 * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = buffer.len(tau) // 4 - 1, 0, -1 do
		reflect(a, 4 * (k * m + k), m - k, buffer.readf32(tau, 4 * k), x, 4 * k)
	end
	return x
end

-- The min(rows, cols) by cols upper triangular factor R. Also accepts a QRP factorization.
local function qr_r(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, kmax, n)
	local a, r = F.qr.data, o.data
	for j = 0, n - 1 do
		for i = 0, kmax - 1 do
			buffer.writef32(r, 4 * (j * kmax + i), if i <= j then buffer.readf32(a, 4 * (j * m + i)) else 0)
		end
	end
	return o
end

-- The rows by min(rows, cols) factor Q with orthonormal columns (the thin Q). Also
-- accepts a QRP factorization.
local function qr_q(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, m, kmax)
	local a, tau, q = F.qr.data, F.tau, o.data
	buffer.fill(q, 0, 0)
	for c = 0, kmax - 1 do
		buffer.writef32(q, 4 * (c * m + c), 1)
		-- Reflectors after column c leave the unit vector e_c unchanged.
		for k = c, 0, -1 do
			reflect(a, 4 * (k * m + k), m - k, buffer.readf32(tau, 4 * k), q, 4 * (c * m + k))
		end
	end
	return o
end

-- Least squares: the x minimizing |A x - b| for A with rows >= cols and full column
-- rank, given F = qr(A). b is not modified. Also returns the residual norm |A x - b|.
local function qr_solve(out: buffer?, F: QR, b: buffer): (buffer, number)
	local m, n = F.qr.rows, F.qr.cols
	assert(m >= n, "least squares needs at least as many rows as columns")
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, n, y)
	local o = output(out, 4 * n)
	buffer.copy(o, 0, y, 0, 4 * n)
	return o, segment_norm(y, 4 * n, m - n)
end

-- Column-pivoted QR

-- Householder QR with column pivoting, A P = Q R, in place: A is overwritten as in qr and
-- returned as F.qr; column j of A P is column perm[j] of A. Each step moves the remaining
-- column of largest norm to the front, so |R_11| >= |R_22| >= ... and small trailing
-- diagonal entries reveal the numerical rank. qrp_copy leaves A unchanged.
local function qrp(A: Matrix): QRP
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(4 * kmax)
	local perm = table.create(n, 0)
	-- Norms of the unfactored part of each column (partial), and the norm at the last
	-- recomputation (reference), for LAPACK's safeguarded downdating.
	local partial, reference = table.create(n, 0), table.create(n, 0)
	for j = 1, n do
		perm[j] = j
		local v = segment_norm(a, 4 * (j - 1) * m, m)
		partial[j], reference[j] = v, v
	end
	local recompute = math.sqrt(EPS)
	for k = 0, kmax - 1 do
		local p, best = k, -1
		for j = k, n - 1 do
			if partial[j + 1] > best then
				p, best = j, partial[j + 1]
			end
		end
		if p ~= k then
			for i = 0, m - 1 do
				local s, t = 4 * (k * m + i), 4 * (p * m + i)
				local tmp = buffer.readf32(a, s)
				buffer.writef32(a, s, buffer.readf32(a, t))
				buffer.writef32(a, t, tmp)
			end
			perm[k + 1], perm[p + 1] = perm[p + 1], perm[k + 1]
			partial[p + 1], reference[p + 1] = partial[k + 1], reference[k + 1]
		end

		local diag = 4 * (k * m + k)
		local t = householder(a, diag, m - k, tau, k)
		if t ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, t, a, 4 * (j * m + k))
			end
		end

		-- Remove row k from the remaining partial norms. When cancellation would leave too
		-- few correct digits, recompute the norm instead.
		for j = k + 1, n - 1 do
			local v = partial[j + 1]
			if v ~= 0 then
				local ratio = math.abs(buffer.readf32(a, 4 * (j * m + k))) / v
				local left = math.max(0, 1 - ratio * ratio)
				local drift = v / reference[j + 1]
				if left * drift * drift <= recompute then
					local fresh = segment_norm(a, 4 * (j * m + k + 1), m - k - 1)
					partial[j + 1], reference[j + 1] = fresh, fresh
				else
					partial[j + 1] = v * math.sqrt(left)
				end
			end
		end
	end
	return { qr = A, tau = tau, perm = perm }
end

-- Column-pivoted QR of a copy of A; A is not modified.
local function qrp_copy(A: Matrix): QRP
	return qrp(matcopy(nil, A))
end

-- Numerical rank: the number of leading diagonal entries of R with |R_kk| > tol |R_11|.
-- The default tol is max(rows, cols) times the unit roundoff of the storage precision.
local function qrp_rank(F: QRP, tol: number?): number
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	if kmax == 0 then
		return 0
	end
	local a = F.qr.data
	local limit = (tol or math.max(m, n) * EPS) * math.abs(buffer.readf32(a, 0))
	for k = 0, kmax - 1 do
		if not (math.abs(buffer.readf32(a, 4 * (k * m + k))) > limit) then
			return k
		end
	end
	return kmax
end

-- Least squares for any shape and rank, given F = qrp(A): the basic solution, which
-- uses only the first r = qrp_rank(F, tol) pivot columns and sets the other variables
-- to zero. b is not modified. Also returns the residual norm |A x - b| and r.
local function qrp_solve(out: buffer?, F: QRP, b: buffer, tol: number?): (buffer, number, number)
	local m, n = F.qr.rows, F.qr.cols
	local r = qrp_rank(F, tol)
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, r, y)
	local o = output(out, 4 * n)
	buffer.fill(o, 0, 0)
	for j = 1, r do
		buffer.writef32(o, 4 * (F.perm[j] - 1), buffer.readf32(y, 4 * (j - 1)))
	end
	return o, segment_norm(y, 4 * r, m - r), r
end

-- Hessenberg reduction and symmetric eigenvalues

-- Reals per matrix entry, for the shared tridiagonal eigensolver.
local PARTS = 1

-- Implicit symmetric QR with Wilkinson shifts on the real symmetric tridiagonal matrix
-- with diagonal d[1..n] and off-diagonal e[1..n-1]. d and e are Luau tables, so the
-- iteration runs in double precision whatever the storage precision. On return d holds
-- the eigenvalues in ascending order and e is destroyed. If z is given (an n by n matrix
-- whose entries are PARTS reals each), every rotation is applied to its columns and the
-- columns are sorted with the eigenvalues.
local function tridiagonal_eigen(d: { number }, e: { number }, z: buffer?, n: number)
	local column = 4 * PARTS * n
	local reals = PARTS * n

	-- Columns k and k+1 (1-based) of z := [c z_k + s z_k+1, -s z_k + c z_k+1].
	local function rotate(zb: buffer, k: number, c: number, s: number)
		local p, q = column * (k - 1), column * k
		for i = 0, reals - 1 do
			local zp, zq = buffer.readf32(zb, p + 4 * i), buffer.readf32(zb, q + 4 * i)
			buffer.writef32(zb, p + 4 * i, c * zp + s * zq)
			buffer.writef32(zb, q + 4 * i, c * zq - s * zp)
		end
	end

	-- e[i] is negligible next to its diagonal neighbours (LAPACK's steqr test).
	local function negligible(i: number): boolean
		local v = math.abs(e[i])
		return v <= 2 ^ -53 * math.sqrt(math.abs(d[i])) * math.sqrt(math.abs(d[i + 1])) or v < 2 ^ -1000
	end

	local iterations, limit = 0, 30 * math.max(n, 1)
	local h = n
	while h > 1 do
		if negligible(h - 1) then
			e[h - 1] = 0
			h -= 1
			continue
		end
		-- The unreduced block is l..h.
		local l = h - 1
		while l > 1 and not negligible(l - 1) do
			l -= 1
		end
		if l > 1 then
			e[l - 1] = 0
		end
		iterations += 1
		if iterations > limit then
			error("eigh: the QR iteration did not converge")
		end

		-- Wilkinson shift: the eigenvalue of the trailing 2 by 2 block closer to d[h].
		local half = (d[h - 1] - d[h]) / 2
		local eh = e[h - 1]
		local r = hypot3(half, eh, 0)
		local mu = d[h] - eh * (eh / (half + (if half >= 0 then r else -r)))

		-- Chase the bulge from the top of the block to the bottom.
		local x, bulge = d[l] - mu, e[l]
		for k = l, h - 1 do
			local c, s, len = 1, 0, x
			if bulge ~= 0 then
				len = hypot3(x, bulge, 0)
				c, s = x / len, bulge / len
			end
			if k > l then
				e[k - 1] = len
			end
			local a, b, cc = d[k], e[k], d[k + 1]
			d[k] = c * c * a + 2 * c * s * b + s * s * cc
			d[k + 1] = s * s * a - 2 * c * s * b + c * c * cc
			e[k] = c * s * (cc - a) + (c * c - s * s) * b
			if k < h - 1 then
				x = e[k]
				bulge = s * e[k + 1]
				e[k + 1] = c * e[k + 1]
			end
			if z then
				rotate(z, k, c, s)
			end
		end
	end

	-- Selection sort into ascending order, moving the columns of z along.
	for i = 1, n - 1 do
		local best = i
		for j = i + 1, n do
			if d[j] < d[best] then
				best = j
			end
		end
		if best ~= i then
			d[i], d[best] = d[best], d[i]
			if z then
				local p, q = column * (i - 1), column * (best - 1)
				for k = 0, reals - 1 do
					local tmp = buffer.readf32(z, p + 4 * k)
					buffer.writef32(z, p + 4 * k, buffer.readf32(z, q + 4 * k))
					buffer.writef32(z, q + 4 * k, tmp)
				end
			end
		end
	end
end

-- In place, LAPACK's org2r: the `count` reflectors stored below the diagonal of the first
-- columns of the `rows` by `cols` block at (r0, r0) of the matrix in `a` (leading
-- dimension ld, with their tau values in `tau`) are replaced by the first `cols` columns
-- of the block's Q = H_1 ... H_count.
local function form_q(a: buffer, ld: number, r0: number, rows: number, cols: number, count: number, tau: buffer)
	local function at(i: number, j: number): number
		return 4 * ((r0 + j) * ld + r0 + i)
	end
	for j = count, cols - 1 do
		for i = 0, rows - 1 do
			buffer.writef32(a, at(i, j), if i == j then 1 else 0)
		end
	end
	for i = count - 1, 0, -1 do
		local t = buffer.readf32(tau, 4 * i)
		for j = i + 1, cols - 1 do
			reflect(a, at(i, i), rows - i, t, a, at(i, j))
		end
		for r = i + 1, rows - 1 do
			buffer.writef32(a, at(r, i), -t * buffer.readf32(a, at(r, i)))
		end
		buffer.writef32(a, at(i, i), 1 - t)
		for r = 0, i - 1 do
			buffer.writef32(a, at(r, i), 0)
		end
	end
end

-- Forms in place the n by n Q = H_0 ... H_count-1 of a Hessenberg or tridiagonal
-- reduction, whose reflector k acts on rows k+1.. and is stored below row k+1 of column k.
local function form_reduction_q(a: buffer, n: number, count: number, tau: buffer)
	if n == 0 then
		return
	end
	-- Move each reflector one column right, so that it sits below the diagonal of the
	-- trailing n-1 by n-1 block, where form_q expects it.
	for k = count - 1, 0, -1 do
		for i = k + 2, n - 1 do
			buffer.writef32(a, 4 * ((k + 1) * n + i), buffer.readf32(a, 4 * (k * n + i)))
		end
	end
	for i = 0, n - 1 do
		buffer.writef32(a, 4 * i, if i == 0 then 1 else 0)
		buffer.writef32(a, 4 * (i * n), if i == 0 then 1 else 0)
	end
	form_q(a, n, 1, n - 1, n - 1, count, tau)
end

-- Hessenberg reduction restricted to rows and columns ilo..ihi (0-based), for a matrix
-- that is already upper triangular outside that block (as balancing leaves it): only
-- reflectors inside the block are made (tau = 0 elsewhere), but they are applied to the
-- whole matrix.
local function hess_range(A: Matrix, ilo: number, ihi: number): Hessenberg
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local count = math.max(n - 2, 0)
	local tau = buffer.create(4 * count)
	local w = table.create(n, 0)
	for k = ilo, ihi - 2 do
		local vs = 4 * (k * n + k + 1)
		local len = ihi - k
		local t = householder(a, vs, len, tau, k)
		if t ~= 0 then
			-- From the left: rows k+1.. of columns k+1..
			for j = k + 1, n - 1 do
				reflect(a, vs, len, t, a, 4 * (j * n + k + 1))
			end
			-- From the right: A := A - t (A v) v^T on columns k+1..
			for i = 0, ihi do
				w[i + 1] = buffer.readf32(a, 4 * ((k + 1) * n + i))
			end
			for c = 1, len - 1 do
				local vc = buffer.readf32(a, vs + 4 * c)
				local col = 4 * ((k + 1 + c) * n)
				for i = 0, ihi do
					w[i + 1] += buffer.readf32(a, col + 4 * i) * vc
				end
			end
			for c = 0, len - 1 do
				local tv = t * (if c == 0 then 1 else buffer.readf32(a, vs + 4 * c))
				local col = 4 * ((k + 1 + c) * n)
				for i = 0, ihi do
					buffer.writef32(a, col + 4 * i, buffer.readf32(a, col + 4 * i) - w[i + 1] * tv)
				end
			end
		end
	end
	return { hess = A, tau = tau }
end


-- Upper Hessenberg reduction A = Q H Q^H (^T for real A), in place: A is overwritten with H
-- on and above the subdiagonal and, below it, the reflectors H_k = I - tau_k v_k v_k^H (v_k
-- has a 1 in row k+1, not stored, and is stored below that in column k).
-- Q = H_0 ... H_n-3. hess_copy leaves A unchanged.
local function hess(A: Matrix): Hessenberg
	return hess_range(A, 0, A.rows - 1)
end

-- Hessenberg reduction of a copy of A; A is not modified.
local function hess_copy(A: Matrix): Hessenberg
	return hess(matcopy(nil, A))
end

-- The upper Hessenberg factor H, with zeros below the subdiagonal.
local function hess_h(out: Matrix?, F: Hessenberg): Matrix
	local n = F.hess.rows
	local o = matoutput(out, n, n)
	local a, h = F.hess.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = 4 * (j * n + i)
			buffer.writef32(h, off, if i <= j + 1 then buffer.readf32(a, off) else 0)
		end
	end
	return o
end

-- The orthogonal factor Q.
local function hess_q(out: Matrix?, F: Hessenberg): Matrix
	local n = F.hess.rows
	local o = matcopy(out, F.hess)
	form_reduction_q(o.data, n, buffer.len(F.tau) // 4, F.tau)
	return o
end

-- Reduces the symmetric matrix whose lower triangle is in A to tridiagonal form,
-- A = Q T Q^T, in place (LAPACK's sytd2): returns T's diagonal d and off-diagonal e as
-- tables and leaves the reflectors (stored as in hess) and their tau in A and `tau`.
local function tridiagonalize(A: Matrix): ({ number }, { number }, buffer)
	local n = A.rows
	local a = A.data
	local count = math.max(n - 1, 0)
	local tau = buffer.create(4 * count)
	local d, e = table.create(n, 0), table.create(count, 0)
	local v, x = table.create(n, 0), table.create(n, 0)
	for k = 0, count - 1 do
		local vs = 4 * (k * n + k + 1)
		local len = n - k - 1
		local t = householder(a, vs, len, tau, k)
		e[k + 1] = buffer.readf32(a, vs)
		if t ~= 0 then
			v[1] = 1
			for r = 1, len - 1 do
				v[r + 1] = buffer.readf32(a, vs + 4 * r)
			end
			-- x = t A22 v, with A22 = A[k+1.., k+1..] read from its lower triangle.
			for r = 1, len do
				x[r] = 0
			end
			for c = 0, len - 1 do
				local col = 4 * ((k + 1 + c) * n + k + 1)
				local vc = v[c + 1]
				local acc = buffer.readf32(a, col + 4 * c) * vc
				for r = c + 1, len - 1 do
					local arc = buffer.readf32(a, col + 4 * r)
					x[r + 1] += arc * vc
					acc += arc * v[r + 1]
				end
				x[c + 1] += acc
			end
			local xv = 0
			for r = 1, len do
				x[r] *= t
				xv += x[r] * v[r]
			end
			-- w = x - (t / 2) (x . v) v, then A22 := A22 - v w^T - w v^T (lower triangle).
			local alpha = -0.5 * t * xv
			for r = 1, len do
				x[r] += alpha * v[r]
			end
			for c = 0, len - 1 do
				local col = 4 * ((k + 1 + c) * n + k + 1)
				local vc, wc = v[c + 1], x[c + 1]
				for r = c, len - 1 do
					local off = col + 4 * r
					buffer.writef32(a, off, buffer.readf32(a, off) - v[r + 1] * wc - x[r + 1] * vc)
				end
			end
		end
		d[k + 1] = buffer.readf32(a, 4 * (k * n + k))
	end
	if n > 0 then
		d[n] = buffer.readf32(a, 4 * ((n - 1) * n + n - 1))
	end
	return d, e, tau
end

-- Eigenvalues (ascending) and, unless vectors is false, orthonormal eigenvectors of a
-- symmetric matrix, in place: only the lower triangle of A is read, and A is overwritten
-- with the eigenvectors (column j belongs to values[j]), or with workspace if vectors is
-- false. Tridiagonalization, then implicit QR with Wilkinson shifts in double precision.
-- If the lower triangle holds a NaN or an infinity, the values and A are all NaN.
-- eigh_copy leaves A unchanged.
local function eigh(A: Matrix, vectors: boolean?): Eigh
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local want = vectors ~= false
	for j = 0, n - 1 do
		if any_nonfinite(A.data, 4 * (j * n + j), n - j) then
			local values = buffer.create(4 * n)
			fill_nan(values, 0, n)
			fill_nan(A.data, 0, n * n)
			return { values = values, vectors = if want then A else nil }
		end
	end
	-- Scaled into a safe range (see range_factor), by the lower triangle; the values are
	-- scaled back and the vectors do not change.
	local big = 0
	for j = 0, n - 1 do
		for i = j, n - 1 do
			big = math.max(big, math.abs(buffer.readf32(A.data, 4 * (j * n + i))))
		end
	end
	local sc = range_factor(big)
	if sc ~= 1 then
		scale(A.data, sc, A.data)
	end
	local d, e, tau = tridiagonalize(A)
	if want then
		form_reduction_q(A.data, n, buffer.len(tau) // 4, tau)
	end
	tridiagonal_eigen(d, e, if want then A.data else nil, n)
	local values = buffer.create(4 * n)
	for i = 1, n do
		buffer.writef32(values, 4 * (i - 1), d[i] / sc)
	end
	return { values = values, vectors = if want then A else nil }
end

-- Symmetric eigendecomposition of a copy of A; A is not modified.
local function eigh_copy(A: Matrix, vectors: boolean?): Eigh
	return eigh(matcopy(nil, A), vectors)
end

-- Nonsymmetric eigenvalues

-- Schur factorization of a real 2 by 2 block (LAPACK's lanv2): returns the standardized
-- block a, b, c, d (upper triangular if the eigenvalues are real; otherwise a = d and
-- b c < 0), the eigenvalues rt1 = (rt1r, rt1i) and rt2, and the rotation (cs, sn) with
-- [a b; c d]_in = [cs -sn; sn cs] [a b; c d]_out [cs sn; -sn cs].
local function lanv2(
	a: number,
	b: number,
	c: number,
	d: number
): (number, number, number, number, number, number, number, number, number, number)
	local function sgn(x: number): number
		return if x >= 0 then 1 else -1
	end
	local cs, sn = 1, 0
	if c == 0 then
		cs, sn = 1, 0
	elseif b == 0 then
		cs, sn = 0, 1
		a, d = d, a
		b, c = -c, 0
	elseif a - d == 0 and sgn(b) ~= sgn(c) then
		cs, sn = 1, 0
	else
		local temp = a - d
		local p = 0.5 * temp
		local bcmax = math.max(math.abs(b), math.abs(c))
		local bcmis = math.min(math.abs(b), math.abs(c)) * sgn(b) * sgn(c)
		local scale = math.max(math.abs(p), bcmax)
		local z = (p / scale) * p + (bcmax / scale) * bcmis
		if z >= 4 * 2 * EPS then
			-- Real eigenvalues: make the block upper triangular.
			z = p + sgn(p) * (math.sqrt(scale) * math.sqrt(z))
			a = d + z
			d = d - (bcmax / z) * bcmis
			local tau = hypot3(c, z, 0)
			cs, sn = z / tau, c / tau
			b, c = b - c, 0
		else
			-- Complex or nearly equal real eigenvalues: make the diagonal equal.
			local sigma = b + c
			local tau = hypot3(sigma, temp, 0)
			cs = math.sqrt(0.5 * (1 + math.abs(sigma) / tau))
			sn = -(p / (tau * cs)) * sgn(sigma)
			local aa, bb = a * cs + b * sn, -a * sn + b * cs
			local cc, dd = c * cs + d * sn, -c * sn + d * cs
			a, b = aa * cs + cc * sn, bb * cs + dd * sn
			c, d = -aa * sn + cc * cs, -bb * sn + dd * cs
			temp = 0.5 * (a + d)
			a, d = temp, temp
			if c ~= 0 then
				if b ~= 0 then
					if sgn(b) == sgn(c) then
						-- Real eigenvalues after all: make the block upper triangular.
						local sab, sac = math.sqrt(math.abs(b)), math.sqrt(math.abs(c))
						p = sgn(c) * (sab * sac)
						tau = 1 / math.sqrt(math.abs(b + c))
						a, d = temp + p, temp - p
						b, c = b - c, 0
						local cs1, sn1 = sab * tau, sac * tau
						cs, sn = cs * cs1 - sn * sn1, cs * sn1 + sn * cs1
					end
				else
					b, c = -c, 0
					cs, sn = -sn, cs
				end
			end
		end
	end
	local rt1i = 0
	if c ~= 0 then
		rt1i = math.sqrt(math.abs(b)) * math.sqrt(math.abs(c))
	end
	return a, b, c, d, a, rt1i, d, -rt1i, cs, sn
end

-- A reflector I - tau v v^T, v = (1, v2, v3), taking (alpha, x2, x3) to (beta, 0, 0).
local function small_reflector(alpha: number, x2: number, x3: number): (number, number, number, number)
	local xnorm = hypot3(x2, x3, 0)
	if xnorm == 0 then
		return alpha, 0, 0, 0
	end
	local beta = hypot3(alpha, xnorm, 0)
	if alpha >= 0 then
		beta = -beta
	end
	local d = alpha - beta
	return beta, (beta - alpha) / beta, x2 / d, x3 / d
end

-- Double-shift Francis QR (LAPACK's lahqr) on the upper Hessenberg matrix in h (n by n,
-- zero below the subdiagonal), in place. With wantt, h becomes the real Schur form T:
-- quasi-triangular, with standardized 2 by 2 blocks for complex conjugate pairs. With z,
-- the orthogonal transformations are accumulated into its columns. Returns the real and
-- imaginary parts of the eigenvalues, in the order of T's diagonal.
local function real_schur(h: buffer, n: number, wantt: boolean, z: buffer?, ilo: number, ihi: number): ({ number }, { number })
	local function H(i: number, j: number): number
		return buffer.readf32(h, 4 * (j * n + i))
	end
	local function set(i: number, j: number, v: number)
		buffer.writef32(h, 4 * (j * n + i), v)
	end
	local wr, wi = table.create(n, 0), table.create(n, 0)
	local ulp = 2 * EPS
	local smlnum = 2 ^ -1000 * (n / ulp)
	local itmax = 30 * math.max(10, n)
	local kdefl = 0
	-- Eigenvalues outside ilo..ihi were isolated by balancing: they are on the diagonal.
	for k = 0, n - 1 do
		if k < ilo or k > ihi then
			wr[k + 1], wi[k + 1] = H(k, k), 0
		end
	end
	local i = ihi
	while i >= ilo do
		local l = ilo
		local converged = false
		for _ = 0, itmax do
			-- Look for a negligible subdiagonal entry (Ahues and Tisseur's test).
			local k = i
			while k > l do
				local sub = math.abs(H(k, k - 1))
				if sub <= smlnum then
					break
				end
				local tst = math.abs(H(k - 1, k - 1)) + math.abs(H(k, k))
				if tst == 0 then
					if k - 2 >= ilo then
						tst += math.abs(H(k - 1, k - 2))
					end
					if k + 1 <= ihi then
						tst += math.abs(H(k + 1, k))
					end
				end
				if sub <= ulp * tst then
					local sup = math.abs(H(k - 1, k))
					local ab, ba = math.max(sub, sup), math.min(sub, sup)
					local hkk, gap = math.abs(H(k, k)), math.abs(H(k - 1, k - 1) - H(k, k))
					local aa, bb = math.max(hkk, gap), math.min(hkk, gap)
					local s = aa + ab
					if ba * (ab / s) <= math.max(smlnum, ulp * (bb * (aa / s))) then
						break
					end
				end
				k -= 1
			end
			l = k
			if l > ilo then
				set(l, l - 1, 0)
			end
			if l >= i - 1 then
				converged = true
				break
			end
			kdefl += 1
			local i1, i2 = if wantt then 0 else l, if wantt then n - 1 else i

			-- Shifts: the eigenvalues of the trailing 2 by 2 block, or an exceptional
			-- shift after 10 (top) or 20 (bottom) iterations without a deflation.
			local h11: number, h12: number, h21: number, h22: number
			if kdefl % 20 == 0 or kdefl % 10 == 0 then
				local s = if kdefl % 20 == 0
					then math.abs(H(i, i - 1)) + math.abs(H(i - 1, i - 2))
					else math.abs(H(l + 1, l)) + math.abs(H(l + 2, l + 1))
				h11 = 0.75 * s + (if kdefl % 20 == 0 then H(i, i) else H(l, l))
				h12 = -0.4375 * s
				h21 = s
				h22 = h11
			else
				h11 = H(i - 1, i - 1)
				h21 = H(i, i - 1)
				h12 = H(i - 1, i)
				h22 = H(i, i)
			end
			local rt1r, rt1i, rt2r, rt2i = 0, 0, 0, 0
			local s = math.abs(h11) + math.abs(h12) + math.abs(h21) + math.abs(h22)
			if s ~= 0 then
				h11, h21, h12, h22 = h11 / s, h21 / s, h12 / s, h22 / s
				local tr = (h11 + h22) / 2
				local det = (h11 - tr) * (h22 - tr) - h12 * h21
				local rtdisc = math.sqrt(math.abs(det))
				if det >= 0 then
					-- A complex conjugate pair.
					rt1r, rt1i = tr * s, rtdisc * s
					rt2r, rt2i = rt1r, -rt1i
				else
					-- Two real shifts: use the one closer to h22 twice.
					rt1r, rt2r = tr + rtdisc, tr - rtdisc
					if math.abs(rt1r - h22) <= math.abs(rt2r - h22) then
						rt1r *= s
						rt2r = rt1r
					else
						rt2r *= s
						rt1r = rt2r
					end
				end
			end

			-- Look for two consecutive small subdiagonal entries, to start the bulge lower.
			local m = i - 2
			local v1, v2, v3 = 0, 0, 0
			while true do
				local hmm = H(m, m)
				local sc = math.abs(hmm - rt2r) + math.abs(rt2i) + math.abs(H(m + 1, m))
				local h21s = H(m + 1, m) / sc
				v1 = h21s * H(m, m + 1) + (hmm - rt1r) * ((hmm - rt2r) / sc) - rt1i * (rt2i / sc)
				v2 = h21s * (hmm + H(m + 1, m + 1) - rt1r - rt2r)
				v3 = h21s * H(m + 2, m + 1)
				sc = math.abs(v1) + math.abs(v2) + math.abs(v3)
				v1, v2, v3 = v1 / sc, v2 / sc, v3 / sc
				if m == l then
					break
				end
				local h00 = math.abs(H(m, m - 1)) * (math.abs(v2) + math.abs(v3))
				local h01 = math.abs(v1) * (math.abs(H(m - 1, m - 1)) + math.abs(hmm) + math.abs(H(m + 1, m + 1)))
				if h00 <= ulp * h01 then
					break
				end
				m -= 1
			end

			-- The double-shift step: chase the bulge from row m to the bottom.
			for k2 = m, i - 1 do
				local nr = math.min(3, i - k2 + 1)
				if k2 > m then
					v1 = H(k2, k2 - 1)
					v2 = H(k2 + 1, k2 - 1)
					v3 = if nr == 3 then H(k2 + 2, k2 - 1) else 0
				end
				local beta, t1, w2, w3 = small_reflector(v1, v2, if nr == 3 then v3 else 0)
				if k2 > m then
					set(k2, k2 - 1, beta)
					set(k2 + 1, k2 - 1, 0)
					if k2 < i - 1 then
						set(k2 + 2, k2 - 1, 0)
					end
				elseif m > l then
					set(k2, k2 - 1, H(k2, k2 - 1) * (1 - t1))
				end
				if t1 ~= 0 then
					local t2, t3 = t1 * w2, t1 * w3
					-- Rows k2.. (columns k2..i2) := H rows, with direct offsets: these loops
					-- are where the time goes.
					if nr == 3 then
						for j = k2, i2 do
							local o = 4 * (j * n + k2)
							local a0, a1, a2 = buffer.readf32(h, o), buffer.readf32(h, o + 4), buffer.readf32(h, o + 2 * 4)
							local sum = a0 + w2 * a1 + w3 * a2
							buffer.writef32(h, o, a0 - sum * t1)
							buffer.writef32(h, o + 4, a1 - sum * t2)
							buffer.writef32(h, o + 2 * 4, a2 - sum * t3)
						end
					else
						for j = k2, i2 do
							local o = 4 * (j * n + k2)
							local a0, a1 = buffer.readf32(h, o), buffer.readf32(h, o + 4)
							local sum = a0 + w2 * a1
							buffer.writef32(h, o, a0 - sum * t1)
							buffer.writef32(h, o + 4, a1 - sum * t2)
						end
					end
					-- Columns k2.. (rows first..last) of buf := columns H.
					local function columns(buf: buffer, first: number, last: number)
						local c0, c1, c2 = 4 * (k2 * n), 4 * ((k2 + 1) * n), 4 * ((k2 + 2) * n)
						if nr == 3 then
							for j = first, last do
								local o = 4 * j
								local a0, a1, a2 = buffer.readf32(buf, c0 + o), buffer.readf32(buf, c1 + o), buffer.readf32(buf, c2 + o)
								local sum = a0 + w2 * a1 + w3 * a2
								buffer.writef32(buf, c0 + o, a0 - sum * t1)
								buffer.writef32(buf, c1 + o, a1 - sum * t2)
								buffer.writef32(buf, c2 + o, a2 - sum * t3)
							end
						else
							for j = first, last do
								local o = 4 * j
								local a0, a1 = buffer.readf32(buf, c0 + o), buffer.readf32(buf, c1 + o)
								local sum = a0 + w2 * a1
								buffer.writef32(buf, c0 + o, a0 - sum * t1)
								buffer.writef32(buf, c1 + o, a1 - sum * t2)
							end
						end
					end
					columns(h, i1, if nr == 3 then math.min(k2 + 3, i) else i)
					if z then
						columns(z, 0, n - 1)
					end
				end
			end
		end
		if not converged then
			error("eig: the QR iteration did not converge")
		end

		if l == i then
			-- A 1 by 1 block: a real eigenvalue.
			wr[i + 1], wi[i + 1] = H(i, i), 0
		else
			-- A 2 by 2 block: standardize it and apply the rotation to the rest.
			local a, b, c, d, r1r, r1i, r2r, r2i, cs, sn = lanv2(H(i - 1, i - 1), H(i - 1, i), H(i, i - 1), H(i, i))
			set(i - 1, i - 1, a)
			set(i - 1, i, b)
			set(i, i - 1, c)
			set(i, i, d)
			wr[i], wi[i], wr[i + 1], wi[i + 1] = r1r, r1i, r2r, r2i
			if wantt then
				for j = i + 1, n - 1 do
					local x, y = H(i - 1, j), H(i, j)
					set(i - 1, j, cs * x + sn * y)
					set(i, j, cs * y - sn * x)
				end
				for j = 0, i - 2 do
					local x, y = H(j, i - 1), H(j, i)
					set(j, i - 1, cs * x + sn * y)
					set(j, i, cs * y - sn * x)
				end
			end
			if z then
				local c0, c1 = 4 * ((i - 1) * n), 4 * (i * n)
				for j = 0, n - 1 do
					local o = 4 * j
					local x, y = buffer.readf32(z, c0 + o), buffer.readf32(z, c1 + o)
					buffer.writef32(z, c0 + o, cs * x + sn * y)
					buffer.writef32(z, c1 + o, cs * y - sn * x)
				end
			end
		end
		kdefl = 0
		i = l - 1
	end
	return wr, wi
end

-- Reduces A to Hessenberg form and runs real_schur on it; returns the Schur vectors (if
-- wantz) and the eigenvalues. With ilo and ihi (from balance), only that block is iterated on.
local function schur_impl(A: Matrix, wantt: boolean, wantz: boolean, ilo: number?, ihi: number?): (Matrix?, { number }, { number })
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	if any_nonfinite(A.data, 0, n * n) then
		-- NaN or infinity in, NaN out: T, Z and the eigenvalues.
		fill_nan(A.data, 0, n * n)
		local Z = if wantz then matrix(n, n) else nil
		if Z then
			fill_nan(Z.data, 0, n * n)
		end
		return Z, table.create(n, 0 / 0) :: { number }, table.create(n, 0 / 0) :: { number }
	end
	local lo, hi = ilo or 0, ihi or n - 1
	local F = hess_range(A, lo, hi)
	local Z = if wantz then hess_q(nil, F) else nil
	local a = A.data
	for j = 0, n - 3 do
		for i = j + 2, n - 1 do
			buffer.writef32(a, 4 * (j * n + i), 0)
		end
	end
	local wr, wi = real_schur(a, n, wantt, if Z then Z.data else nil, lo, hi)
	return Z, wr, wi
end

-- The eigenvalues as a complex array of the same precision.
local function complex_values(wr: { number }, wi: { number }): buffer
	local values = buffer.create(2 * 4 * #wr)
	for k = 1, #wr do
		buffer.writef32(values, 2 * 4 * (k - 1), wr[k])
		buffer.writef32(values, 2 * 4 * (k - 1) + 4, wi[k])
	end
	return values
end

-- Real Schur factorization A = Z T Z^T, in place: A is overwritten with the
-- quasi-triangular T, whose 2 by 2 diagonal blocks (standardized, with equal diagonal
-- entries) hold the complex conjugate eigenvalue pairs. Z is computed unless vectors is
-- false. values is a complex array (c32) of the eigenvalues in the order of T's
-- diagonal. If A holds a NaN or an infinity, T, Z and the values are all NaN.
-- schur_copy leaves A unchanged.
local function schur(A: Matrix, vectors: boolean?): Schur
	-- Scaled into a safe range and back (Z does not change).
	local sc = range_scale(A.data)
	local Z, wr, wi = schur_impl(A, true, vectors ~= false)
	if sc ~= 1 then
		scale(A.data, 1 / sc, A.data)
		for k = 1, #wr do
			wr[k] /= sc
			wi[k] /= sc
		end
	end
	return { schur = A, z = Z, values = complex_values(wr, wi) }
end

-- Real Schur factorization of a copy of A; A is not modified.
local function schur_copy(A: Matrix, vectors: boolean?): Schur
	return schur(matcopy(nil, A), vectors)
end

-- What balance did: rows and columns ilo..ihi (0-based) form the block left to the
-- eigensolver, scale holds the diagonal of D, and swaps lists the row/column exchanges in
-- order (as pairs).
type Balance = { ilo: number, ihi: number, scale: { number }, swaps: { number } }

-- Balances the square matrix A in place, as LAPACK's gebal does:
-- 1. Permutation: a row that is zero off the diagonal isolates an eigenvalue (its diagonal
--    entry) and is moved to the bottom; a column that is zero off the diagonal likewise, to
--    the top. Repeating this leaves A block upper triangular, with triangular blocks
--    outside rows and columns ilo..ihi, so only that block needs the QR algorithm.
-- 2. Scaling: A := D^-1 A D on that block, with D a diagonal of powers of 2 (exact),
--    chosen so each row and the matching column have similar 2-norms. The eigenvalues are
--    unchanged but computed more accurately when A is badly scaled, because the
--    eigensolver's error is proportional to |A|.
-- Eigenvectors of the original A are P D times those of the balanced matrix (unbalance).
local function balance(A: Matrix): Balance
	local n = A.rows
	local a = A.data
	local function at(i: number, j: number): number
		return 4 * (j * n + i)
	end
	local swaps = {}
	-- Exchanges rows i and j and columns i and j (a permutation similarity).
	local function exchange(i: number, j: number)
		if i == j then
			return
		end
		table.insert(swaps, i)
		table.insert(swaps, j)
		for k = 0, n - 1 do
			local s, t = at(k, i), at(k, j)
			local tmp = buffer.readf32(a, s)
			buffer.writef32(a, s, buffer.readf32(a, t))
			buffer.writef32(a, t, tmp)
		end
		for k = 0, n - 1 do
			local s, t = at(i, k), at(j, k)
			local tmp = buffer.readf32(a, s)
			buffer.writef32(a, s, buffer.readf32(a, t))
			buffer.writef32(a, t, tmp)
		end
	end
	local lo, hi = 0, n - 1
	-- Rows zero off the diagonal (in columns 0..hi): move to the bottom.
	local found = true
	while found and hi > 0 do
		found = false
		for j = hi, 0, -1 do
			local zero = true
			for c = 0, hi do
				if c ~= j and buffer.readf32(a, at(j, c)) ~= 0 then
					zero = false
					break
				end
			end
			if zero then
				exchange(j, hi)
				hi -= 1
				found = true
				break
			end
		end
	end
	-- Columns zero off the diagonal (in rows lo..hi): move to the top.
	found = true
	while found and lo < hi do
		found = false
		for j = lo, hi do
			local zero = true
			for r = lo, hi do
				if r ~= j and buffer.readf32(a, at(r, j)) ~= 0 then
					zero = false
					break
				end
			end
			if zero then
				exchange(j, lo)
				lo += 1
				found = true
				break
			end
		end
	end
	-- Scaling of the block lo..hi.
	local d = table.create(n, 1)
	local function rownorm(i: number): number
		local big = 0
		for j = lo, hi do
			big = math.max(big, math.abs(buffer.readf32(a, at(i, j))))
		end
		if big == 0 then
			return 0
		end
		local s = 0
		for j = lo, hi do
			local v = buffer.readf32(a, at(i, j)) / big
			s += v * v
		end
		return big * math.sqrt(s)
	end
	local converged = false
	while not converged do
		converged = true
		for i = lo, hi do
			local c, r = segment_norm(a, at(lo, i), hi - lo + 1), rownorm(i)
			if c > 0 and r > 0 then
				-- Column i times f and row i divided by f have norms about c f and r / f; take
				-- the power of 2 that brings those within a factor of 2 of each other.
				local f, cf, rf = 1, c, r
				while cf < rf / 2 and f < 2 ^ 500 do
					f, cf, rf = f * 2, cf * 2, rf / 2
				end
				while cf >= rf * 2 and f > 2 ^ -500 do
					f, cf, rf = f / 2, cf / 2, rf * 2
				end
				if cf + rf < 0.95 * (c + r) then
					converged = false
					d[i + 1] *= f
					for j = 0, n - 1 do
						buffer.writef32(a, at(i, j), buffer.readf32(a, at(i, j)) / f)
						buffer.writef32(a, at(j, i), buffer.readf32(a, at(j, i)) * f)
					end
				end
			end
		end
	end
	return { ilo = lo, ihi = hi, scale = d, swaps = swaps }
end

-- Maps eigenvectors of a balanced matrix back (x = P D x') and rescales each to unit
-- length. v holds n columns of n complex entries (c32 layout).
local function unbalance(v: buffer, n: number, B: Balance)
	local E = 2 * 4
	local d, swaps = B.scale, B.swaps
	for j = 0, n - 1 do
		local col = E * j * n
		for i = 0, n - 1 do
			local o = col + E * i
			buffer.writef32(v, o, buffer.readf32(v, o) * d[i + 1])
			buffer.writef32(v, o + 4, buffer.readf32(v, o + 4) * d[i + 1])
		end
		-- Undo the exchanges, last first.
		for s = #swaps - 1, 1, -2 do
			local p, q = col + E * swaps[s], col + E * swaps[s + 1]
			for part = 0, 4, 4 do
				local tmp = buffer.readf32(v, p + part)
				buffer.writef32(v, p + part, buffer.readf32(v, q + part))
				buffer.writef32(v, q + part, tmp)
			end
		end
		local nrm = segment_norm(v, col, 2 * n)
		if nrm > 0 then
			for k = col, col + E * n - 4, 4 do
				buffer.writef32(v, k, buffer.readf32(v, k) / nrm)
			end
		end
	end
end

-- The complex Schur form of a real matrix from its real Schur form (A holds T, with Z
-- and the eigenvalues wr + i wi from real_schur): each 2 by 2 block with a complex pair
-- is triangularized by a unitary G whose first column is an eigenvector. Returns the
-- complex T and Z.
local function to_complex_schur(A: Matrix, Z: Matrix, wr: { number }, wi: { number }): (Matrix, Matrix)
	local n = A.rows
	local T = complexmod.matrix(n, n)
	T.data = complexmod.complexify(A.data)
	local Zc = complexmod.matrix(n, n)
	Zc.data = complexmod.complexify(Z.data)
	local t, zc = T.data, Zc.data
	local E = 2 * 4
	local k = 0
	while k < n - 1 do
		if wi[k + 1] == 0 then
			k += 1
			continue
		end
		local lr, li = wr[k + 1], wi[k + 1]
		local p, q = buffer.readf32(A.data, 4 * (k * n + k)), buffer.readf32(A.data, 4 * ((k + 1) * n + k))
		-- Eigenvector (q, lambda - p) of the block, normalized: G = [g1, (-conj g21, conj g11)].
		local nrm = hypot3(q, lr - p, li)
		local g1r, g1i, g2r, g2i = q / nrm, 0, (lr - p) / nrm, li / nrm
		-- Rows k, k+1 of T (columns k..) := G^H rows.
		for j = k, n - 1 do
			local o1, o2 = E * (j * n + k), E * (j * n + k + 1)
			local ar, ai = buffer.readf32(t, o1), buffer.readf32(t, o1 + 4)
			local br, bi = buffer.readf32(t, o2), buffer.readf32(t, o2 + 4)
			-- conj(g1) a + conj(g2) b, then -g2 a + g1 b
			buffer.writef32(t, o1, g1r * ar + g1i * ai + g2r * br + g2i * bi)
			buffer.writef32(t, o1 + 4, g1r * ai - g1i * ar + g2r * bi - g2i * br)
			buffer.writef32(t, o2, -(g2r * ar - g2i * ai) + g1r * br - g1i * bi)
			buffer.writef32(t, o2 + 4, -(g2r * ai + g2i * ar) + g1r * bi + g1i * br)
		end
		-- Columns k, k+1 of T (rows ..k+1) and of Zc := columns G.
		local function columns(buf: buffer, rows: number)
			for j = 0, rows - 1 do
				local o1, o2 = E * (k * n + j), E * ((k + 1) * n + j)
				local ar, ai = buffer.readf32(buf, o1), buffer.readf32(buf, o1 + 4)
				local br, bi = buffer.readf32(buf, o2), buffer.readf32(buf, o2 + 4)
				-- a g1 + b g2, then -a conj(g2) + b conj(g1)
				buffer.writef32(buf, o1, ar * g1r - ai * g1i + br * g2r - bi * g2i)
				buffer.writef32(buf, o1 + 4, ar * g1i + ai * g1r + br * g2i + bi * g2r)
				buffer.writef32(buf, o2, -(ar * g2r + ai * g2i) + br * g1r + bi * g1i)
				buffer.writef32(buf, o2 + 4, -(ai * g2r - ar * g2i) + bi * g1r - br * g1i)
			end
		end
		columns(t, k + 2)
		columns(zc, n)
		-- The block is now exactly [lambda, *; 0, conj(lambda)].
		buffer.writef32(t, E * (k * n + k), lr)
		buffer.writef32(t, E * (k * n + k) + 4, li)
		buffer.writef32(t, E * (k * n + k + 1), 0)
		buffer.writef32(t, E * (k * n + k + 1) + 4, 0)
		buffer.writef32(t, E * ((k + 1) * n + k + 1), wr[k + 2])
		buffer.writef32(t, E * ((k + 1) * n + k + 1) + 4, wi[k + 2])
		k += 2
	end
	return T, Zc
end

-- Eigenvalues and, unless vectors is false, unit eigenvectors of a general real matrix.
-- Both are complex (c32): values is a complex array and column k of vectors (a complex
-- matrix) belongs to values[k]. Unless balanced is false, A is balanced first (permuted
-- and scaled; see balance), as LAPACK's geev does by default. A is overwritten with the
-- (balanced) real Schur form, or with workspace if vectors is false; the eigenvectors are a new matrix.
-- If A holds a NaN or an infinity, the values, the vectors and A are all NaN. eig_copy
-- leaves A unchanged.
local function eig(A: Matrix, vectors: boolean?, balanced: boolean?): Eig
	local want = vectors ~= false
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	if any_nonfinite(A.data, 0, n * n) then
		fill_nan(A.data, 0, n * n)
		local values = buffer.create(2 * 4 * n)
		fill_nan(values, 0, 2 * n)
		local V = if want then complexmod.matrix(n, n) else nil
		if V then
			fill_nan(V.data, 0, 2 * n * n)
		end
		return { values = values, vectors = V }
	end
	-- Scaled into a safe range (see range_scale); the values and A are scaled back at the
	-- end, and the vectors do not change.
	local sc = range_scale(A.data)
	local bal = if balanced ~= false then balance(A) else nil
	local Z, wr, wi = schur_impl(A, want, want, if bal then bal.ilo else nil, if bal then bal.ihi else nil)
	local values = complex_values(wr, wi)
	if sc ~= 1 then
		complexmod.scale(values, 1 / sc, values)
	end
	if not Z then
		if sc ~= 1 then
			scale(A.data, 1 / sc, A.data)
		end
		return { values = values, vectors = nil }
	end
	local T, Zc = to_complex_schur(A, Z, wr, wi)
	complexmod.eigvecs_from_schur(T, Zc)
	if bal then
		unbalance(Zc.data, n, bal)
	end
	if sc ~= 1 then
		scale(A.data, 1 / sc, A.data)
	end
	return { values = values, vectors = Zc }
end

-- Eigendecomposition of a copy of A; A is not modified.
local function eig_copy(A: Matrix, vectors: boolean?, balanced: boolean?): Eig
	return eig(matcopy(nil, A), vectors, balanced)
end

-- Singular value decomposition

-- Rotation (c, s, r) with c f + s g = r and -s f + c g = 0 (LAPACK's lartg).
local function lartg(f: number, g: number): (number, number, number)
	if g == 0 then
		return 1, 0, f
	elseif f == 0 then
		return 0, 1, g
	end
	local r = hypot3(f, g, 0)
	if f < 0 then
		r = -r
	end
	return f / r, g / r, r
end

-- Singular values (smaller, larger) of [f g; 0 h] (LAPACK's las2).
local function las2(f: number, g: number, h: number): (number, number)
	local fa, ga, ha = math.abs(f), math.abs(g), math.abs(h)
	local fhmn, fhmx = math.min(fa, ha), math.max(fa, ha)
	if fhmn == 0 then
		if fhmx == 0 then
			return 0, ga
		end
		local big, small = math.max(fhmx, ga), math.min(fhmx, ga)
		return 0, big * math.sqrt(1 + (small / big) ^ 2)
	elseif ga < fhmx then
		local as = 1 + fhmn / fhmx
		local at = (fhmx - fhmn) / fhmx
		local au = (ga / fhmx) ^ 2
		local c = 2 / (math.sqrt(as * as + au) + math.sqrt(at * at + au))
		return fhmn * c, fhmx / c
	end
	local au = fhmx / ga
	if au == 0 then
		return (fhmn * fhmx) / ga, ga
	end
	local as = 1 + fhmn / fhmx
	local at = (fhmx - fhmn) / fhmx
	local c = 1 / (math.sqrt(1 + (as * au) ^ 2) + math.sqrt(1 + (at * au) ^ 2))
	return 2 * (fhmn * c) * au, ga / (c + c)
end

-- SVD of [f g; 0 h] (LAPACK's lasv2): returns ssmin, ssmax (signed) and the rotations
-- (snr, csr) and (snl, csl) with
-- [csl snl; -snl csl] [f g; 0 h] [csr -snr; snr csr] = [ssmax 0; 0 ssmin].
local function lasv2(f: number, g: number, h: number): (number, number, number, number, number, number)
	local function sign(a: number, b: number): number
		return if b >= 0 then math.abs(a) else -math.abs(a)
	end
	local ft, fa, ht, ha = f, math.abs(f), h, math.abs(h)
	-- pmax: which entry has the largest magnitude (1 = f, 2 = g, 3 = h).
	local pmax = 1
	local swap = ha > fa
	if swap then
		pmax = 3
		ft, ht = ht, ft
		fa, ha = ha, fa
	end
	local gt, ga = g, math.abs(g)
	local clt, crt, slt, srt = 1, 1, 0, 0
	local ssmin: number, ssmax: number = 0, 0
	if ga == 0 then
		ssmin, ssmax = ha, fa
	else
		local gasmal = true
		if ga > fa then
			pmax = 2
			if fa / ga < 2 ^ -53 then
				-- g is far larger than the diagonal.
				gasmal = false
				ssmax = ga
				ssmin = if ha > 1 then fa / (ga / ha) else (fa / ga) * ha
				clt, slt, srt, crt = 1, ht / gt, 1, ft / gt
			end
		end
		if gasmal then
			local dd = fa - ha
			local l = if dd == fa then 1 else dd / fa
			local m = gt / ft
			local t = 2 - l
			local mm, tt = m * m, t * t
			local s = math.sqrt(tt + mm)
			local r = if l == 0 then math.abs(m) else math.sqrt(l * l + mm)
			local a = 0.5 * (s + r)
			ssmin, ssmax = ha / a, fa * a
			if mm == 0 then
				t = if l == 0 then sign(2, ft) * sign(1, gt) else gt / sign(dd, ft) + m / t
			else
				t = (m / (s + t) + m / (r + l)) * (1 + a)
			end
			l = math.sqrt(t * t + 4)
			crt, srt = 2 / l, t / l
			clt = (crt + srt * m) / a
			slt = (ht / ft) * srt / a
		end
	end
	local csl, snl, csr, snr
	if swap then
		csl, snl, csr, snr = srt, crt, slt, clt
	else
		csl, snl, csr, snr = clt, slt, crt, srt
	end
	local tsign
	if pmax == 1 then
		tsign = sign(1, csr) * sign(1, csl) * sign(1, f)
	elseif pmax == 2 then
		tsign = sign(1, snr) * sign(1, csl) * sign(1, g)
	else
		tsign = sign(1, snr) * sign(1, snl) * sign(1, h)
	end
	ssmax = sign(ssmax, tsign)
	ssmin = sign(ssmin, tsign * sign(1, f) * sign(1, h))
	return ssmin, ssmax, snr, csr, snl, csl
end

-- Singular values of the real upper bidiagonal matrix with diagonal d[1..n] and
-- superdiagonal e[1..n-1] (LAPACK's bdsqr): implicit QR with shifts from the trailing
-- (or leading) 2 by 2 block, and Demmel and Kahan's zero-shift sweeps whenever a shift
-- would spoil the relative accuracy of the small singular values. d and e are Luau
-- tables, so the iteration runs in double precision. On return d holds the singular
-- values in descending order and e is destroyed. If u (urows by n) and v (vrows by n)
-- are given, with PARTS reals per entry, the left rotations are applied to the columns
-- of u and the right ones to the columns of v, and both are sorted with the values.
local function bidiagonal_svd(d: { number }, e: { number }, n: number, u: buffer?, urows: number, v: buffer?, vrows: number)
	if n == 0 then
		return
	end
	-- Columns p and q (1-based) of buf := [c p + s q, c q - s p].
	local function rotate(buf: buffer, rows: number, p: number, q: number, c: number, s: number)
		local column = 4 * PARTS * rows
		local op, oq = column * (p - 1), column * (q - 1)
		for i = 0, PARTS * rows - 1 do
			local x, y = buffer.readf32(buf, op + 4 * i), buffer.readf32(buf, oq + 4 * i)
			buffer.writef32(buf, op + 4 * i, c * x + s * y)
			buffer.writef32(buf, oq + 4 * i, c * y - s * x)
		end
	end
	local function rotv(p: number, q: number, c: number, s: number)
		if v then
			rotate(v, vrows, p, q, c, s)
		end
	end
	local function rotu(p: number, q: number, c: number, s: number)
		if u then
			rotate(u, urows, p, q, c, s)
		end
	end

	local eps = 2 ^ -53
	local tol = math.max(10, math.min(100, eps ^ (-1 / 8))) * eps
	local maxitr = 6

	-- Threshold for negligible entries, from an estimate of the smallest singular value.
	local sminoa = math.abs(d[1])
	local mu = sminoa
	for i = 2, n do
		if sminoa == 0 then
			break
		end
		mu = math.abs(d[i]) * (mu / (mu + math.abs(e[i - 1])))
		sminoa = math.min(sminoa, mu)
	end
	sminoa /= math.sqrt(n)
	local thresh = math.max(tol * sminoa, maxitr * n * n * 2 ^ -1022)
	local maxit = maxitr * n * n
	local iter = 0
	local oldll, oldm = -1, -1
	local idir = 0

	local m = n
	while m > 1 do
		if iter > maxit then
			error("svd: the QR iteration did not converge")
		end
		-- Find the unreduced block ll..m.
		local smax = math.abs(d[m])
		local ll = 0
		for idx = m - 1, 1, -1 do
			local abss, abse = math.abs(d[idx]), math.abs(e[idx])
			if abse <= thresh then
				ll = idx
				break
			end
			smax = math.max(smax, abss, abse)
		end
		if ll > 0 then
			e[ll] = 0
			if ll == m - 1 then
				-- The bottom value has converged.
				m -= 1
				continue
			end
		end
		ll += 1

		if ll == m - 1 then
			-- A 2 by 2 block: solve it directly.
			local sigmn, sigmx, sinr, cosr, sinl, cosl = lasv2(d[m - 1], e[m - 1], d[m])
			d[m - 1], e[m - 1], d[m] = sigmx, 0, sigmn
			rotv(m - 1, m, cosr, sinr)
			rotu(m - 1, m, cosl, sinl)
			m -= 2
			continue
		end

		-- For a new block, chase toward the smaller end: down if graded downward.
		if ll > oldm or m < oldll then
			idir = if math.abs(d[ll]) >= math.abs(d[m]) then 1 else 2
		end

		-- Convergence tests that preserve relative accuracy; sminl estimates the smallest
		-- singular value of the block.
		local sminl = 0
		local split = false
		if idir == 1 then
			if math.abs(e[m - 1]) <= tol * math.abs(d[m]) then
				e[m - 1] = 0
				continue
			end
			mu = math.abs(d[ll])
			sminl = mu
			for i = ll, m - 1 do
				if math.abs(e[i]) <= tol * mu then
					e[i] = 0
					split = true
					break
				end
				mu = math.abs(d[i + 1]) * (mu / (mu + math.abs(e[i])))
				sminl = math.min(sminl, mu)
			end
		else
			if math.abs(e[ll]) <= tol * math.abs(d[ll]) then
				e[ll] = 0
				continue
			end
			mu = math.abs(d[m])
			sminl = mu
			for i = m - 1, ll, -1 do
				if math.abs(e[i]) <= tol * mu then
					e[i] = 0
					split = true
					break
				end
				mu = math.abs(d[i]) * (mu / (mu + math.abs(e[i])))
				sminl = math.min(sminl, mu)
			end
		end
		if split then
			continue
		end
		oldll, oldm = ll, m

		-- Shift: the smaller singular value of the 2 by 2 block at the far end, unless it
		-- would destroy the relative accuracy of the small values; then use zero.
		local shift = 0
		if n * tol * (sminl / smax) > math.max(eps, 0.01 * tol) then
			local sll
			if idir == 1 then
				sll = math.abs(d[ll])
				shift = las2(d[m - 1], e[m - 1], d[m])
			else
				sll = math.abs(d[m])
				shift = las2(d[ll], e[ll], d[ll + 1])
			end
			if sll > 0 and (shift / sll) ^ 2 < eps then
				shift = 0
			end
		end
		iter += m - ll

		if shift == 0 then
			-- Demmel and Kahan's zero-shift QR sweep.
			local cs, sn, oldcs, oldsn, r = 1, 0, 1, 0, 0
			if idir == 1 then
				for i = ll, m - 1 do
					cs, sn, r = lartg(d[i] * cs, e[i])
					if i > ll then
						e[i - 1] = oldsn * r
					end
					oldcs, oldsn, d[i] = lartg(oldcs * r, d[i + 1] * sn)
					rotv(i, i + 1, cs, sn)
					rotu(i, i + 1, oldcs, oldsn)
				end
				local hh = d[m] * cs
				d[m], e[m - 1] = hh * oldcs, hh * oldsn
				if math.abs(e[m - 1]) <= thresh then
					e[m - 1] = 0
				end
			else
				for i = m, ll + 1, -1 do
					cs, sn, r = lartg(d[i] * cs, e[i - 1])
					if i < m then
						e[i] = oldsn * r
					end
					oldcs, oldsn, d[i] = lartg(oldcs * r, d[i - 1] * sn)
					rotv(i - 1, i, oldcs, -oldsn)
					rotu(i - 1, i, cs, -sn)
				end
				local hh = d[ll] * cs
				d[ll], e[ll] = hh * oldcs, hh * oldsn
				if math.abs(e[ll]) <= thresh then
					e[ll] = 0
				end
			end
		else
			-- Shifted QR sweep (chase the bulge).
			if idir == 1 then
				local f = (math.abs(d[ll]) - shift) * ((if d[ll] >= 0 then 1 else -1) + shift / d[ll])
				local g = e[ll]
				for i = ll, m - 1 do
					local cosr, sinr, r = lartg(f, g)
					if i > ll then
						e[i - 1] = r
					end
					f = cosr * d[i] + sinr * e[i]
					e[i] = cosr * e[i] - sinr * d[i]
					g = sinr * d[i + 1]
					d[i + 1] = cosr * d[i + 1]
					local cosl, sinl, r2 = lartg(f, g)
					d[i] = r2
					f = cosl * e[i] + sinl * d[i + 1]
					d[i + 1] = cosl * d[i + 1] - sinl * e[i]
					if i < m - 1 then
						g = sinl * e[i + 1]
						e[i + 1] = cosl * e[i + 1]
					end
					rotv(i, i + 1, cosr, sinr)
					rotu(i, i + 1, cosl, sinl)
				end
				e[m - 1] = f
				if math.abs(e[m - 1]) <= thresh then
					e[m - 1] = 0
				end
			else
				local f = (math.abs(d[m]) - shift) * ((if d[m] >= 0 then 1 else -1) + shift / d[m])
				local g = e[m - 1]
				for i = m, ll + 1, -1 do
					local cosr, sinr, r = lartg(f, g)
					if i < m then
						e[i] = r
					end
					f = cosr * d[i] + sinr * e[i - 1]
					e[i - 1] = cosr * e[i - 1] - sinr * d[i]
					g = sinr * d[i - 1]
					d[i - 1] = cosr * d[i - 1]
					local cosl, sinl, r2 = lartg(f, g)
					d[i] = r2
					f = cosl * e[i - 1] + sinl * d[i - 1]
					d[i - 1] = cosl * d[i - 1] - sinl * e[i - 1]
					if i > ll + 1 then
						g = sinl * e[i - 2]
						e[i - 2] = cosl * e[i - 2]
					end
					rotv(i - 1, i, cosl, -sinl)
					rotu(i - 1, i, cosr, -sinr)
				end
				e[ll] = f
				if math.abs(e[ll]) <= thresh then
					e[ll] = 0
				end
			end
		end
	end

	-- Make the values nonnegative (flipping the matching right vector), then sort them in
	-- descending order with their vectors.
	for i = 1, n do
		if d[i] < 0 then
			d[i] = -d[i]
			if v then
				local column = 4 * PARTS * vrows
				for k = 0, PARTS * vrows - 1 do
					local off = column * (i - 1) + 4 * k
					buffer.writef32(v, off, -buffer.readf32(v, off))
				end
			end
		end
	end
	local function swap(buf: buffer, rows: number, p: number, q: number)
		local column = 4 * PARTS * rows
		local op, oq = column * (p - 1), column * (q - 1)
		for i = 0, PARTS * rows - 1 do
			local tmp = buffer.readf32(buf, op + 4 * i)
			buffer.writef32(buf, op + 4 * i, buffer.readf32(buf, oq + 4 * i))
			buffer.writef32(buf, oq + 4 * i, tmp)
		end
	end
	for i = 1, n - 1 do
		local best = i
		for j = i + 1, n do
			if d[j] > d[best] then
				best = j
			end
		end
		if best ~= i then
			d[i], d[best] = d[best], d[i]
			if u then
				swap(u, urows, i, best)
			end
			if v then
				swap(v, vrows, i, best)
			end
		end
	end
end

-- Reduces A (rows >= cols) to upper bidiagonal form A = Q B P^T in place (LAPACK's
-- gebd2), returning B's diagonal d and superdiagonal e as tables. The left reflectors stay
-- below the diagonal of A (as in qr), with their tau in tauq; right reflector k acts on
-- columns k+1.. and stays in row k from column k+2 on, with its tau in taup.
local function bidiagonalize(A: Matrix): ({ number }, { number }, buffer, buffer)
	local m, n = A.rows, A.cols
	local a = A.data
	local tauq = buffer.create(4 * n)
	local taup = buffer.create(4 * math.max(n - 1, 0))
	local d, e = table.create(n, 0), table.create(math.max(n - 1, 0), 0)
	local row = buffer.create(4 * n)
	local w = table.create(m, 0)
	for k = 0, n - 1 do
		local diag = 4 * (k * m + k)
		local t = householder(a, diag, m - k, tauq, k)
		d[k + 1] = buffer.readf32(a, diag)
		if t ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, t, a, 4 * (j * m + k))
			end
		end
		if k < n - 1 then
			-- Row k from column k+1 on is gathered, reflected and put back.
			local len = n - k - 1
			for c = 0, len - 1 do
				buffer.writef32(row, 4 * c, buffer.readf32(a, 4 * ((k + 1 + c) * m + k)))
			end
			local tp = householder(row, 0, len, taup, k)
			e[k + 1] = buffer.readf32(row, 0)
			for c = 0, len - 1 do
				buffer.writef32(a, 4 * ((k + 1 + c) * m + k), buffer.readf32(row, 4 * c))
			end
			if tp ~= 0 then
				-- Rows k+1.. of columns k+1..: A := A (I - tp v v^T), v = (1, row[1..]).
				for r = k + 1, m - 1 do
					w[r + 1] = buffer.readf32(a, 4 * ((k + 1) * m + r))
				end
				for c = 1, len - 1 do
					local vc = buffer.readf32(row, 4 * c)
					local col = 4 * ((k + 1 + c) * m)
					for r = k + 1, m - 1 do
						w[r + 1] += buffer.readf32(a, col + 4 * r) * vc
					end
				end
				for c = 0, len - 1 do
					local tv = tp * (if c == 0 then 1 else buffer.readf32(row, 4 * c))
					local col = 4 * ((k + 1 + c) * m)
					for r = k + 1, m - 1 do
						buffer.writef32(a, col + 4 * r, buffer.readf32(a, col + 4 * r) - w[r + 1] * tv)
					end
				end
			end
		end
	end
	return d, e, tauq, taup
end

-- svd for rows >= cols, in place.
local function svd_tall(A: Matrix, want: boolean): Svd
	local m, n = A.rows, A.cols
	if any_nonfinite(A.data, 0, m * n) then
		local values = buffer.create(4 * n)
		fill_nan(values, 0, n)
		fill_nan(A.data, 0, m * n)
		local V = if want then matrix(n, n) else nil
		if V then
			fill_nan(V.data, 0, n * n)
		end
		return { values = values, u = if want then A else nil, v = V }
	end
	-- Scaled into a safe range (see range_scale); the values are scaled back, and U and V
	-- do not change.
	local sc = range_scale(A.data)
	local d, e, tauq, taup = bidiagonalize(A)
	local V: Matrix? = nil
	if want then
		-- V = P from the right reflectors, then U = the first n columns of Q, in A.
		local P = matrix(n, n)
		for k = 0, n - 3 do
			for c = k + 2, n - 1 do
				buffer.writef32(P.data, 4 * (k * n + c), buffer.readf32(A.data, 4 * (c * m + k)))
			end
		end
		form_reduction_q(P.data, n, math.max(n - 1, 0), taup)
		form_q(A.data, m, 0, m, n, n, tauq)
		V = P
	end
	bidiagonal_svd(d, e, n, if want then A.data else nil, m, if V then V.data else nil, n)
	local values = buffer.create(4 * n)
	for i = 1, n do
		buffer.writef32(values, 4 * (i - 1), d[i])
	end
	if sc ~= 1 then
		scale(values, 1 / sc, values)
	end
	return { values = values, u = if want then A else nil, v = V }
end

-- Singular value decomposition A = U diag(values) V^T: values (descending, nonnegative)
-- and, unless vectors is false, U (rows by k) and V (cols by k) with orthonormal columns,
-- k = min(rows, cols). Golub-Kahan bidiagonalization, then implicit QR on the bidiagonal
-- in double precision, keeping the small singular values relatively accurate. In place
-- when rows >= cols: A is overwritten with U (or with workspace if vectors is false). A
-- wide A is not modified (its transpose is decomposed instead). If A holds a NaN or an
-- infinity, every output is NaN. svd_copy never modifies A.
local function svd(A: Matrix, vectors: boolean?): Svd
	if A.rows < A.cols then
		local F = svd_tall(transpose(nil, A), vectors ~= false)
		return { values = F.values, u = F.v, v = F.u }
	end
	return svd_tall(A, vectors ~= false)
end

-- Singular value decomposition of a copy of A; A is not modified.
local function svd_copy(A: Matrix, vectors: boolean?): Svd
	if A.rows < A.cols then
		return svd(A, vectors)
	end
	return svd(matcopy(nil, A), vectors)
end

-- The minimum-norm least-squares solution x = A^+ b for any shape and rank, given
-- F = svd(A) with its vectors: x = sum over i <= r of v_i (u_i^H b) / s_i, where r counts
-- the singular values above tol * s_1 (default tol = max(rows, cols) * eps, as for
-- qrp_rank); smaller ones are treated as zero. Unlike qrp_solve's basic solution, x is the
-- shortest of all least-squares solutions. b is not modified. Also returns the residual
-- norm |A x - b| and r. NaN singular values (from non-finite input) give a NaN x.
local function svd_solve(out: buffer?, F: Svd, b: buffer, tol: number?): (buffer, number, number)
	local U, V = F.u, F.v
	assert(U ~= nil and V ~= nil, "svd_solve needs the singular vectors")
	local m, n, k = U.rows, V.rows, U.cols
	assert(length(b) == m, "b has the wrong length")
	local s, u, v = F.values, U.data, V.data
	local o = output(out, 4 * n)
	if k > 0 and buffer.readf32(s, 0) ~= buffer.readf32(s, 0) then
		fill_nan(o, 0, n)
		return o, 0 / 0, 0
	end
	local limit = (tol or math.max(m, n) * EPS) * (if k > 0 then buffer.readf32(s, 0) else 0)
	local r = 0
	while r < k and buffer.readf32(s, 4 * r) > limit do
		r += 1
	end
	-- The residual b - U_r U_r^T b, projected one column at a time, and x.
	local res = table.create(m, 0)
	for i = 1, m do
		res[i] = buffer.readf32(b, 4 * (i - 1))
	end
	local x = table.create(n, 0)
	for j = 0, r - 1 do
		local col = 4 * j * m
		local c = 0
		for i = 0, m - 1 do
			c += buffer.readf32(u, col + 4 * i) * res[i + 1]
		end
		for i = 0, m - 1 do
			res[i + 1] -= c * buffer.readf32(u, col + 4 * i)
		end
		local w = c / buffer.readf32(s, 4 * j)
		local vcol = 4 * j * n
		for i = 0, n - 1 do
			x[i + 1] += w * buffer.readf32(v, vcol + 4 * i)
		end
	end
	for i = 1, n do
		buffer.writef32(o, 4 * (i - 1), x[i])
	end
	local big = 0
	for i = 1, m do
		big = math.max(big, math.abs(res[i]))
	end
	local ss = 0
	if big > 0 then
		for i = 1, m do
			ss += (res[i] / big) ^ 2
		end
	end
	return o, big * math.sqrt(ss), r
end

-- The pseudoinverse A^+ = V S^+ U^H (cols by rows), by the SVD of a copy of A; singular
-- values at or below tol * s_1 (default max(rows, cols) * eps, as for svd_solve) count as
-- zero. A is not modified. NaN or infinite input gives an all-NaN result. To apply A^+ to
-- vectors, solving with form "svd" is cheaper than forming it.
local function pinv(A: Matrix, tol: number?): Matrix
	local m, n = A.rows, A.cols
	local F = svd_copy(A)
	local U, V = F.u :: Matrix, F.v :: Matrix
	local k, s = U.cols, F.values
	local X = matrix(n, m)
	if k > 0 and buffer.readf32(s, 0) ~= buffer.readf32(s, 0) then
		fill_nan(X.data, 0, n * m)
		return X
	end
	local limit = (tol or math.max(m, n) * EPS) * (if k > 0 then buffer.readf32(s, 0) else 0)
	local u, v, x = U.data, V.data, X.data
	local row = table.create(n, 0)
	-- Column q of X is sum over i of v_i (u_qi / s_i).
	for i = 0, k - 1 do
		local si = buffer.readf32(s, 4 * i)
		if not (si > limit) then
			break
		end
		for p = 0, n - 1 do
			row[p + 1] = buffer.readf32(v, 4 * (i * n + p)) / si
		end
		for q = 0, m - 1 do
			local c = buffer.readf32(u, 4 * (i * m + q))
			if c ~= 0 then
				local col = 4 * q * n
				for p = 0, n - 1 do
					buffer.writef32(x, col + 4 * p, buffer.readf32(x, col + 4 * p) + c * row[p + 1])
				end
			end
		end
	end
	return X
end

-- Real FFT and discrete cosine transforms

-- exp(-2 pi i k / n) as (re, im). k is reduced mod n first, so the angle stays accurate
-- for large k.
local function root(k: number, n: number): (number, number)
	local a = -2 * math.pi * (k % n) / n
	return math.cos(a), math.sin(a)
end

-- Bytes per element of a complex array of the same precision.
local CE = 2 * 4

-- The n // 2 + 1 coefficients X_0 .. X_(n/2) of the DFT of the real array x (the rest
-- follow from X_(n-k) = conj(X_k)), as a complex array (c32). Even lengths use one
-- complex FFT of half the length.
local function rfft(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, CE * (n // 2 + 1))
	if n % 2 == 1 or n < 2 then
		local z = complexmod.complexify(x)
		complexmod.fft(z)
		buffer.copy(o, 0, z, 0, CE * (n // 2 + 1))
		return o
	end
	-- The pairs (x_2j, x_2j+1) already are the complex numbers z_j = x_2j + i x_2j+1.
	local h = n // 2
	local z = buffer.create(CE * h)
	buffer.copy(z, 0, x, 0, 4 * n)
	complexmod.fft(z)
	for k = 0, h do
		local a, b = CE * (k % h), CE * ((h - k) % h)
		local zr, zi = buffer.readf32(z, a), buffer.readf32(z, a + 4)
		local cr, ci = buffer.readf32(z, b), -buffer.readf32(z, b + 4)
		-- X_k = (Z_k + conj Z_(h-k)) / 2 + w^k (Z_k - conj Z_(h-k)) / (2 i)
		local er, ei = (zr + cr) / 2, (zi + ci) / 2
		local dr, di = (zi - ci) / 2, -(zr - cr) / 2
		local wr, wi = root(k, n)
		buffer.writef32(o, CE * k, er + wr * dr - wi * di)
		buffer.writef32(o, CE * k + 4, ei + wr * di + wi * dr)
	end
	return o
end

-- The real array of length n whose rfft is X (n // 2 + 1 complex coefficients, c32).
-- The imaginary parts of X_0 and, for even n, X_(n/2) are ignored.
local function irfft(out: buffer?, X: buffer, n: number): buffer
	assert(buffer.len(X) == CE * (n // 2 + 1), "need n // 2 + 1 coefficients")
	local o = output(out, 4 * n)
	if n % 2 == 1 or n < 2 then
		local full = buffer.create(CE * n)
		for k = 0, n - 1 do
			local s = if k <= n // 2 then k else n - k
			local xr, xi = buffer.readf32(X, CE * s), buffer.readf32(X, CE * s + 4)
			if k > n // 2 then
				xi = -xi
			end
			if k == 0 then
				xi = 0
			end
			buffer.writef32(full, CE * k, xr)
			buffer.writef32(full, CE * k + 4, xi)
		end
		complexmod.ifft(full)
		for k = 0, n - 1 do
			buffer.writef32(o, 4 * k, buffer.readf32(full, CE * k))
		end
		return o
	end
	local h = n // 2
	local z = buffer.create(CE * h)
	for k = 0, h - 1 do
		local xr, xi = buffer.readf32(X, CE * k), buffer.readf32(X, CE * k + 4)
		local cr, ci = buffer.readf32(X, CE * (h - k)), -buffer.readf32(X, CE * (h - k) + 4)
		if k == 0 then
			xi, ci = 0, 0
		end
		-- Z_k = (X_k + conj X_(h-k)) / 2 + i w^-k (X_k - conj X_(h-k)) / 2
		local er, ei = (xr + cr) / 2, (xi + ci) / 2
		local dr, di = (xr - cr) / 2, (xi - ci) / 2
		local wr, wi = root(-k, n)
		local orr, oi = dr * wr - di * wi, dr * wi + di * wr
		buffer.writef32(z, CE * k, er - oi)
		buffer.writef32(z, CE * k + 4, ei + orr)
	end
	complexmod.ifft(z)
	buffer.copy(o, 0, z, 0, 4 * n)
	return o
end

-- The DCT of the given type (SciPy's definitions) of the values xs[1..N], as a table.
local function dct_values(xs: { number }, kind: number, ortho: boolean): { number }
	local N = #xs
	local y = table.create(N, 0)
	if kind == 1 then
		-- The real FFT of the even extension x_0 .. x_N-1, x_N-2 .. x_1.
		assert(N >= 2, "the type 1 DCT needs at least 2 points")
		local ext = buffer.create(4 * 2 * (N - 1))
		for k = 0, 2 * N - 3 do
			local v = if k < N then xs[k + 1] else xs[2 * N - 1 - k]
			if ortho and (k == 0 or k == N - 1) then
				v *= math.sqrt(2)
			end
			buffer.writef32(ext, 4 * k, v)
		end
		local Y = rfft(nil, ext)
		for k = 0, N - 1 do
			y[k + 1] = buffer.readf32(Y, CE * k)
		end
		if ortho then
			local f = math.sqrt(1 / (2 * (N - 1)))
			for k = 1, N do
				y[k] *= f
			end
			y[1] /= math.sqrt(2)
			y[N] /= math.sqrt(2)
		end
	elseif kind == 2 then
		-- Makhoul: reorder to (x_0, x_2, ..., x_3, x_1), one real FFT of length N, rotate.
		local v = buffer.create(4 * N)
		for i = 0, (N + 1) // 2 - 1 do
			buffer.writef32(v, 4 * i, xs[2 * i + 1])
		end
		for i = 0, N // 2 - 1 do
			buffer.writef32(v, 4 * (N - 1 - i), xs[2 * i + 2])
		end
		local V = rfft(nil, v)
		for k = 0, N - 1 do
			local s = if k <= N // 2 then k else N - k
			local vr, vi = buffer.readf32(V, CE * s), buffer.readf32(V, CE * s + 4)
			if k > N // 2 then
				vi = -vi
			end
			local wr, wi = root(k, 4 * N)
			y[k + 1] = 2 * (wr * vr - wi * vi)
		end
		if ortho then
			y[1] *= math.sqrt(1 / (4 * N))
			for k = 2, N do
				y[k] *= math.sqrt(1 / (2 * N))
			end
		end
	elseif kind == 3 then
		-- The inverse of Makhoul's reduction: V_k = (x_k - i x_N-k) exp(i pi k / 2N),
		-- v = N ifft(V), then undo the reordering.
		local a = table.clone(xs)
		if ortho then
			a[1] /= math.sqrt(N)
			for k = 2, N do
				a[k] /= math.sqrt(2 * N)
			end
		end
		local V = buffer.create(CE * N)
		for k = 0, N - 1 do
			local xr, xi = a[k + 1], if k > 0 then -a[N - k + 1] else 0
			local wr, wi = root(-k, 4 * N)
			buffer.writef32(V, CE * k, xr * wr - xi * wi)
			buffer.writef32(V, CE * k + 4, xr * wi + xi * wr)
		end
		complexmod.ifft(V)
		for i = 0, (N + 1) // 2 - 1 do
			y[2 * i + 1] = N * buffer.readf32(V, CE * i)
		end
		for i = 0, N // 2 - 1 do
			y[2 * i + 2] = N * buffer.readf32(V, CE * (N - 1 - i))
		end
	elseif kind == 4 then
		-- A complex FFT of length 2N of x_n exp(-i pi n / 2N), zero padded, then a rotation.
		local A = buffer.create(CE * 2 * N)
		for k = 0, N - 1 do
			local wr, wi = root(k, 4 * N)
			buffer.writef32(A, CE * k, xs[k + 1] * wr)
			buffer.writef32(A, CE * k + 4, xs[k + 1] * wi)
		end
		complexmod.fft(A)
		for k = 0, N - 1 do
			local ar, ai = buffer.readf32(A, CE * k), buffer.readf32(A, CE * k + 4)
			local wr, wi = root(2 * k + 1, 8 * N)
			y[k + 1] = 2 * (wr * ar - wi * ai)
		end
		if ortho then
			for k = 1, N do
				y[k] *= math.sqrt(1 / (2 * N))
			end
		end
	else
		error("dct type must be 1, 2, 3 or 4")
	end
	return y
end

-- The discrete cosine transform of the given type (1 to 4, default 2), with SciPy's
-- definitions: unnormalized, or orthonormal with norm = "ortho". In place; returns x.
local function dct(x: buffer, kind: number?, norm: DctNorm?): buffer
	local t = totable(x)
	if #t == 0 then
		return x
	end
	local y = dct_values(t, kind or 2, norm == "ortho")
	for k = 1, #y do
		buffer.writef32(x, 4 * (k - 1), y[k])
	end
	return x
end

-- The inverse of dct with the same type and norm. In place; returns x.
local function idct(x: buffer, kind: number?, norm: DctNorm?): buffer
	local t = totable(x)
	local N = #t
	if N == 0 then
		return x
	end
	local k = kind or 2
	local ortho = norm == "ortho"
	-- The inverse of type 2 is type 3 and vice versa; types 1 and 4 invert themselves.
	local inverse = if k == 2 then 3 elseif k == 3 then 2 else k
	local y = dct_values(t, inverse, ortho)
	local scale = if ortho then 1 elseif k == 1 then 1 / (2 * (N - 1)) else 1 / (2 * N)
	for i = 1, N do
		buffer.writef32(x, 4 * (i - 1), y[i] * scale)
	end
	return x
end

-- dct of a copy of x; x is not modified.
local function dct_copy(x: buffer, kind: number?, norm: DctNorm?): buffer
	return dct(copy(nil, x), kind, norm)
end

-- idct of a copy of x; x is not modified.
local function idct_copy(x: buffer, kind: number?, norm: DctNorm?): buffer
	return idct(copy(nil, x), kind, norm)
end

-- Functions defined inside do blocks, exported through this table: a Luau function (here,
-- the module) may hold at most 200 locals.
local ext = {}

-- Structured and sparse matrices: in a do block (exported through ext) so their locals
-- do not count toward the module's limit of 200.
do
	-- Triangular matrices

	-- Solves T x = b, where T is the upper or lower triangle of A (the other triangle is not
	-- read); with unit, the diagonal is taken to be 1 and not read either. In place if out is b.
	local function triangular_solve(out: buffer?, A: Matrix, b: buffer, uplo: Uplo, unit: boolean?): buffer
		local n = A.rows
		assert(A.cols == n, "matrix must be square")
		assert(uplo == "upper" or uplo == "lower", "uplo must be \"upper\" or \"lower\"")
		assert(buffer.len(b) == 4 * n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = A.data
		if uplo == "upper" then
			for j = n - 1, 0, -1 do
				local xj = buffer.readf32(o, 4 * j)
				if not unit then
					xj /= buffer.readf32(a, 4 * (j * n + j))
					buffer.writef32(o, 4 * j, xj)
				end
				for i = 0, j - 1 do
					buffer.writef32(o, 4 * i, buffer.readf32(o, 4 * i) - buffer.readf32(a, 4 * (j * n + i)) * xj)
				end
			end
		else
			for j = 0, n - 1 do
				local xj = buffer.readf32(o, 4 * j)
				if not unit then
					xj /= buffer.readf32(a, 4 * (j * n + j))
					buffer.writef32(o, 4 * j, xj)
				end
				for i = j + 1, n - 1 do
					buffer.writef32(o, 4 * i, buffer.readf32(o, 4 * i) - buffer.readf32(a, 4 * (j * n + i)) * xj)
				end
			end
		end
		return o
	end

	-- T x for the upper or lower triangle T of A (as in triangular_solve).
	local function triangular_matvec(out: buffer?, A: Matrix, x: buffer, uplo: Uplo, unit: boolean?): buffer
		local n = A.rows
		assert(A.cols == n, "matrix must be square")
		assert(uplo == "upper" or uplo == "lower", "uplo must be \"upper\" or \"lower\"")
		assert(buffer.len(x) == 4 * n, "matrix and vector sizes do not match")
		local o = output(out, 4 * n)
		assert(o ~= x, "output cannot be the input vector")
		local a = A.data
		for i = 0, n - 1 do
			local s = if unit then buffer.readf32(x, 4 * i) else 0
			local first, last = if uplo == "upper" then i else 0, if uplo == "upper" then n - 1 else i
			if unit then
				if uplo == "upper" then
					first += 1
				else
					last -= 1
				end
			end
			for j = first, last do
				s += buffer.readf32(a, 4 * (j * n + i)) * buffer.readf32(x, 4 * j)
			end
			buffer.writef32(o, 4 * i, s)
		end
		return o
	end

	-- Tridiagonal matrices

	-- A tridiagonal matrix from its subdiagonal (n-1), diagonal (n) and superdiagonal (n-1).
	-- The arrays are used as they are (not copied).
	local function tridiagonal(lower: buffer, diag: buffer, upper: buffer): Tridiagonal
		local n = length(diag)
		assert(length(lower) == math.max(n - 1, 0) and length(upper) == math.max(n - 1, 0), "need n-1 off-diagonal entries")
		return { lower = lower, diag = diag, upper = upper }
	end

	local function tridiag_copy(T: Tridiagonal): Tridiagonal
		return { lower = copy(nil, T.lower), diag = copy(nil, T.diag), upper = copy(nil, T.upper) }
	end

	-- The dense matrix.
	local function tridiag_matrix(T: Tridiagonal): Matrix
		local n = length(T.diag)
		local A = matrix(n, n)
		for i = 0, n - 1 do
			buffer.writef32(A.data, 4 * (i * n + i), buffer.readf32(T.diag, 4 * i))
			if i < n - 1 then
				buffer.writef32(A.data, 4 * (i * n + i + 1), buffer.readf32(T.lower, 4 * i))
				buffer.writef32(A.data, 4 * ((i + 1) * n + i), buffer.readf32(T.upper, 4 * i))
			end
		end
		return A
	end

	-- T x
	local function tridiag_matvec(out: buffer?, T: Tridiagonal, x: buffer): buffer
		local n = length(T.diag)
		assert(length(x) == n, "matrix and vector sizes do not match")
		local o = output(out, 4 * n)
		assert(o ~= x, "output cannot be the input vector")
		local dl, d, du = T.lower, T.diag, T.upper
		for i = 0, n - 1 do
			local s = buffer.readf32(d, 4 * i) * buffer.readf32(x, 4 * i)
			if i > 0 then
				s += buffer.readf32(dl, 4 * (i - 1)) * buffer.readf32(x, 4 * (i - 1))
			end
			if i < n - 1 then
				s += buffer.readf32(du, 4 * i) * buffer.readf32(x, 4 * (i + 1))
			end
			buffer.writef32(o, 4 * i, s)
		end
		return o
	end

	-- LU factorization with partial pivoting (LAPACK's gttrf), in place: T's arrays are
	-- overwritten with the factors. tridiag_lu_copy leaves T unchanged.
	local function tridiag_lu(T: Tridiagonal): TridiagonalLU
		local n = length(T.diag)
		local dl, d, du = T.lower, T.diag, T.upper
		local du2 = buffer.create(4 * math.max(n - 2, 0))
		local piv = table.create(n, 0)
		local function get(arr: buffer, i: number): number
			return buffer.readf32(arr, 4 * i)
		end
		local function set(arr: buffer, i: number, v: number)
			buffer.writef32(arr, 4 * i, v)
		end
		for i = 0, n - 2 do
			local di, li = get(d, i), get(dl, i)
			if math.abs(di) >= math.abs(li) then
				-- No row interchange.
				piv[i + 1] = i + 1
				if di ~= 0 then
					local fact = li / di
					set(dl, i, fact)
					set(d, i + 1, get(d, i + 1) - fact * get(du, i))
				end
			else
				-- Interchange rows i and i+1.
				local fact = di / li
				set(d, i, li)
				set(dl, i, fact)
				local temp = get(du, i)
				set(du, i, get(d, i + 1))
				set(d, i + 1, temp - fact * get(d, i + 1))
				if i < n - 2 then
					set(du2, i, get(du, i + 1))
					set(du, i + 1, -fact * get(du, i + 1))
				end
				piv[i + 1] = i + 2
			end
		end
		if n > 0 then
			piv[n] = n
		end
		local singular = false
		for i = 0, n - 1 do
			if get(d, i) == 0 then
				singular = true
			end
		end
		return { lu = T, du2 = du2, piv = piv, singular = singular }
	end

	-- tridiag_lu of a copy of T; T is not modified.
	local function tridiag_lu_copy(T: Tridiagonal): TridiagonalLU
		return tridiag_lu(tridiag_copy(T))
	end

	-- Solves T x = b given F = tridiag_lu(T). In place if out is b.
	local function tridiag_lu_solve(out: buffer?, F: TridiagonalLU, b: buffer): buffer
		assert(not F.singular, "matrix is singular")
		local dl, d, du, du2 = F.lu.lower, F.lu.diag, F.lu.upper, F.du2
		local n = length(d)
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local function get(arr: buffer, i: number): number
			return buffer.readf32(arr, 4 * i)
		end
		-- L y = P b
		for i = 0, n - 2 do
			local bi, bn = get(o, i), get(o, i + 1)
			if F.piv[i + 1] == i + 1 then
				buffer.writef32(o, 4 * (i + 1), bn - get(dl, i) * bi)
			else
				buffer.writef32(o, 4 * i, bn)
				buffer.writef32(o, 4 * (i + 1), bi - get(dl, i) * bn)
			end
		end
		-- U x = y
		for i = n - 1, 0, -1 do
			local s = get(o, i)
			if i < n - 1 then
				s -= get(du, i) * get(o, i + 1)
			end
			if i < n - 2 then
				s -= get(du2, i) * get(o, i + 2)
			end
			buffer.writef32(o, 4 * i, s / get(d, i))
		end
		return o
	end

	-- LDL^T factorization of a symmetric positive definite tridiagonal matrix (LAPACK's
	-- pttrf), in place: only T.diag and T.lower are read; they are overwritten with D and the
	-- subdiagonal of L. definite is false if T is not positive definite (T is then partly
	-- overwritten). tridiag_ldl_copy leaves T unchanged.
	local function tridiag_ldl(T: Tridiagonal): TridiagonalLDL
		local d, e = T.diag, T.lower
		local n = length(d)
		for i = 0, n - 1 do
			local di = buffer.readf32(d, 4 * i)
			if not (di > 0) then
				return { ldl = T, definite = false }
			end
			if i < n - 1 then
				local ei = buffer.readf32(e, 4 * i)
				local l = ei / di
				buffer.writef32(e, 4 * i, l)
				buffer.writef32(d, 4 * (i + 1), buffer.readf32(d, 4 * (i + 1)) - l * ei)
			end
		end
		return { ldl = T, definite = true }
	end

	-- tridiag_ldl of a copy of T; T is not modified.
	local function tridiag_ldl_copy(T: Tridiagonal): TridiagonalLDL
		return tridiag_ldl(tridiag_copy(T))
	end

	-- Solves T x = b given F = tridiag_ldl(T). In place if out is b.
	local function tridiag_ldl_solve(out: buffer?, F: TridiagonalLDL, b: buffer): buffer
		assert(F.definite, "matrix is not positive definite")
		local d, e = F.ldl.diag, F.ldl.lower
		local n = length(d)
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		for i = 1, n - 1 do
			buffer.writef32(o, 4 * i, buffer.readf32(o, 4 * i) - buffer.readf32(o, 4 * (i - 1)) * buffer.readf32(e, 4 * (i - 1)))
		end
		for i = 0, n - 1 do
			buffer.writef32(o, 4 * i, buffer.readf32(o, 4 * i) / buffer.readf32(d, 4 * i))
		end
		for i = n - 2, 0, -1 do
			buffer.writef32(o, 4 * i, buffer.readf32(o, 4 * i) - buffer.readf32(o, 4 * (i + 1)) * buffer.readf32(e, 4 * i))
		end
		return o
	end

	-- Banded matrices

	-- A zero n by n banded matrix with kl subdiagonals and ku superdiagonals.
	local function banded(n: number, kl: number, ku: number): Banded
		assert(kl >= 0 and ku >= 0, "bandwidths must be nonnegative")
		local ld = 2 * kl + ku + 1
		return { n = n, kl = kl, ku = ku, ld = ld, data = buffer.create(4 * ld * n) }
	end

	local function band_copy(B: Banded): Banded
		local C = banded(B.n, B.kl, B.ku)
		buffer.copy(C.data, 0, B.data)
		return C
	end

	-- Byte offset of entry (i, j), 0-based.
	local function band_at(B: Banded, i: number, j: number): number
		return 4 * (j * B.ld + B.kl + B.ku + i - j)
	end

	local function in_band(B: Banded, i: number, j: number): boolean
		return i - j <= B.kl and j - i <= B.ku and i >= 1 and j >= 1 and i <= B.n and j <= B.n
	end

	-- Entry (i, j), 1-based; 0 outside the band.
	local function band_get(B: Banded, i: number, j: number): number
		if not in_band(B, i, j) then
			return 0
		end
		return buffer.readf32(B.data, band_at(B, i - 1, j - 1))
	end

	-- Sets entry (i, j), 1-based, which must lie in the band.
	local function band_set(B: Banded, i: number, j: number, v: number)
		assert(in_band(B, i, j), "entry is outside the band")
		buffer.writef32(B.data, band_at(B, i - 1, j - 1), v)
	end

	-- The band of the square matrix A (entries outside it are dropped).
	local function band_from_matrix(A: Matrix, kl: number, ku: number): Banded
		local n = A.rows
		assert(A.cols == n, "matrix must be square")
		local B = banded(n, kl, ku)
		for j = 0, n - 1 do
			for i = math.max(0, j - ku), math.min(n - 1, j + kl) do
				buffer.writef32(B.data, band_at(B, i, j), buffer.readf32(A.data, 4 * (j * n + i)))
			end
		end
		return B
	end

	-- The dense matrix.
	local function band_matrix(B: Banded): Matrix
		local n = B.n
		local A = matrix(n, n)
		for j = 0, n - 1 do
			for i = math.max(0, j - B.ku), math.min(n - 1, j + B.kl) do
				buffer.writef32(A.data, 4 * (j * n + i), buffer.readf32(B.data, band_at(B, i, j)))
			end
		end
		return A
	end

	-- B x
	local function band_matvec(out: buffer?, B: Banded, x: buffer): buffer
		local n = B.n
		assert(length(x) == n, "matrix and vector sizes do not match")
		local o = output(out, 4 * n)
		assert(o ~= x, "output cannot be the input vector")
		buffer.fill(o, 0, 0)
		for j = 0, n - 1 do
			local xj = buffer.readf32(x, 4 * j)
			for i = math.max(0, j - B.ku), math.min(n - 1, j + B.kl) do
				buffer.writef32(o, 4 * i, buffer.readf32(o, 4 * i) + buffer.readf32(B.data, band_at(B, i, j)) * xj)
			end
		end
		return o
	end

	-- Banded LU with partial pivoting (LAPACK's gbtf2), in place: B is overwritten with the
	-- factors, U getting up to kl + ku superdiagonals in B's extra rows. band_lu_copy leaves
	-- B unchanged.
	local function band_lu(B: Banded): BandedLU
		local n, kl, ku = B.n, B.kl, B.ku
		local kv = kl + ku
		local a = B.data
		local function at(i: number, j: number): number
			return 4 * (j * B.ld + kv + i - j)
		end
		-- Clear the fill-in rows above the original band.
		for j = 0, n - 1 do
			for i = math.max(0, j - kv), j - ku - 1 do
				buffer.writef32(a, at(i, j), 0)
			end
		end
		local piv = table.create(n, 0)
		local singular = false
		local ju = 0
		for j = 0, n - 1 do
			local km = math.min(kl, n - 1 - j)
			local p, best = j, -1
			for i = j, j + km do
				local v = math.abs(buffer.readf32(a, at(i, j)))
				if v > best then
					p, best = i, v
				end
			end
			piv[j + 1] = p + 1
			local pivot = buffer.readf32(a, at(p, j))
			if pivot ~= 0 then
				ju = math.max(ju, math.min(j + ku + (p - j), n - 1))
				if p ~= j then
					for c = j, ju do
						local s, t = at(j, c), at(p, c)
						local tmp = buffer.readf32(a, s)
						buffer.writef32(a, s, buffer.readf32(a, t))
						buffer.writef32(a, t, tmp)
					end
				end
				if km > 0 then
					local djj = buffer.readf32(a, at(j, j))
					for i = j + 1, j + km do
						buffer.writef32(a, at(i, j), buffer.readf32(a, at(i, j)) / djj)
					end
					for c = j + 1, ju do
						local y = buffer.readf32(a, at(j, c))
						if y ~= 0 then
							for i = j + 1, j + km do
								buffer.writef32(a, at(i, c), buffer.readf32(a, at(i, c)) - buffer.readf32(a, at(i, j)) * y)
							end
						end
					end
				end
			else
				singular = true
			end
		end
		return { lu = B, piv = piv, singular = singular }
	end

	-- band_lu of a copy of B; B is not modified.
	local function band_lu_copy(B: Banded): BandedLU
		return band_lu(band_copy(B))
	end

	-- Solves B x = b given F = band_lu(B). In place if out is b.
	local function band_lu_solve(out: buffer?, F: BandedLU, b: buffer): buffer
		assert(not F.singular, "matrix is singular")
		local B = F.lu
		local n, kl, ku = B.n, B.kl, B.ku
		local kv = kl + ku
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = B.data
		local function at(i: number, j: number): number
			return 4 * (j * B.ld + kv + i - j)
		end
		-- L y = P b, applying the interchanges as they happened.
		for j = 0, n - 2 do
			local p = F.piv[j + 1] - 1
			if p ~= j then
				local tmp = buffer.readf32(o, 4 * j)
				buffer.writef32(o, 4 * j, buffer.readf32(o, 4 * p))
				buffer.writef32(o, 4 * p, tmp)
			end
			local yj = buffer.readf32(o, 4 * j)
			for i = j + 1, math.min(n - 1, j + kl) do
				buffer.writef32(o, 4 * i, buffer.readf32(o, 4 * i) - buffer.readf32(a, at(i, j)) * yj)
			end
		end
		-- U x = y, U with kl + ku superdiagonals.
		for j = n - 1, 0, -1 do
			local xj = buffer.readf32(o, 4 * j) / buffer.readf32(a, at(j, j))
			buffer.writef32(o, 4 * j, xj)
			for i = math.max(0, j - kv), j - 1 do
				buffer.writef32(o, 4 * i, buffer.readf32(o, 4 * i) - buffer.readf32(a, at(i, j)) * xj)
			end
		end
		return o
	end

	-- Banded Cholesky A = L L^T of a symmetric positive definite matrix (LAPACK's pbtf2,
	-- lower), in place: only the diagonal and the kl subdiagonals are read and overwritten
	-- with L. definite is false if B is not positive definite (B is then partly overwritten).
	-- band_chol_copy leaves B unchanged.
	local function band_chol(B: Banded): BandedCholesky
		local n, kd = B.n, B.kl
		local a = B.data
		for j = 0, n - 1 do
			local ajj = buffer.readf32(a, band_at(B, j, j))
			if not (ajj > 0) then
				return { chol = B, definite = false }
			end
			ajj = math.sqrt(ajj)
			buffer.writef32(a, band_at(B, j, j), ajj)
			local kn = math.min(kd, n - 1 - j)
			for i = j + 1, j + kn do
				buffer.writef32(a, band_at(B, i, j), buffer.readf32(a, band_at(B, i, j)) / ajj)
			end
			-- Trailing lower band -= x x^T, x = column j below the diagonal.
			for c = j + 1, j + kn do
				local xc = buffer.readf32(a, band_at(B, c, j))
				for i = c, j + kn do
					local off = band_at(B, i, c)
					buffer.writef32(a, off, buffer.readf32(a, off) - buffer.readf32(a, band_at(B, i, j)) * xc)
				end
			end
		end
		return { chol = B, definite = true }
	end

	-- band_chol of a copy of B; B is not modified.
	local function band_chol_copy(B: Banded): BandedCholesky
		return band_chol(band_copy(B))
	end

	-- Solves B x = b given F = band_chol(B). In place if out is b.
	local function band_chol_solve(out: buffer?, F: BandedCholesky, b: buffer): buffer
		assert(F.definite, "matrix is not positive definite")
		local B = F.chol
		local n, kd = B.n, B.kl
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = B.data
		-- L y = b
		for j = 0, n - 1 do
			local yj = buffer.readf32(o, 4 * j) / buffer.readf32(a, band_at(B, j, j))
			buffer.writef32(o, 4 * j, yj)
			for i = j + 1, math.min(n - 1, j + kd) do
				buffer.writef32(o, 4 * i, buffer.readf32(o, 4 * i) - buffer.readf32(a, band_at(B, i, j)) * yj)
			end
		end
		-- L^T x = y
		for j = n - 1, 0, -1 do
			local s = buffer.readf32(o, 4 * j)
			for i = j + 1, math.min(n - 1, j + kd) do
				s -= buffer.readf32(a, band_at(B, i, j)) * buffer.readf32(o, 4 * i)
			end
			buffer.writef32(o, 4 * j, s / buffer.readf32(a, band_at(B, j, j)))
		end
		return o
	end

	-- Circulant and Toeplitz matrices

	-- The circulant matrix with first column c (its eigenvalues are computed now).
	local function circulant(c: buffer): Circulant
		return { n = length(c), eig = rfft(nil, c) }
	end

	-- C x, by FFT.
	local function circulant_matvec(out: buffer?, C: Circulant, x: buffer): buffer
		assert(length(x) == C.n, "matrix and vector sizes do not match")
		local X = rfft(nil, x)
		complexmod.mul(X, X, C.eig)
		return irfft(out, X, C.n)
	end

	-- Solves C x = b, by FFT. In place if out is b.
	local function circulant_solve(out: buffer?, C: Circulant, b: buffer): buffer
		assert(length(b) == C.n, "matrix and vector sizes do not match")
		local X = rfft(nil, b)
		local eig = C.eig
		for k = 0, buffer.len(X) - CE, CE do
			local er, ei = buffer.readf32(eig, k), buffer.readf32(eig, k + 4)
			assert(er ~= 0 or ei ~= 0, "circulant matrix is singular")
			local qr, qi = complex64.div(buffer.readf32(X, k), buffer.readf32(X, k + 4), er, ei)
			buffer.writef32(X, k, qr)
			buffer.writef32(X, k + 4, qi)
		end
		return irfft(out, X, C.n)
	end

	-- The dense matrix.
	local function circulant_matrix(c: buffer): Matrix
		local n = length(c)
		local A = matrix(n, n)
		for j = 0, n - 1 do
			for i = 0, n - 1 do
				buffer.writef32(A.data, 4 * (j * n + i), buffer.readf32(c, 4 * ((i - j) % n)))
			end
		end
		return A
	end

	-- The Toeplitz matrix with first column col and first row row (default: col, which makes
	-- it symmetric). row[1] is ignored, as in SciPy. Both arrays are copied.
	local function toeplitz(col: buffer, row: buffer?): Toeplitz
		local n = length(col)
		local r = row or col
		assert(length(r) == n, "first row and first column have different lengths")
		local M = 1
		while M < 2 * n - 1 do
			M *= 2
		end
		-- A circulant of size M whose leading n by n block is T.
		local e = create(M)
		for k = 0, n - 1 do
			buffer.writef32(e, 4 * k, buffer.readf32(col, 4 * k))
			if k > 0 then
				buffer.writef32(e, 4 * (M - k), buffer.readf32(r, 4 * k))
			end
		end
		return { n = n, col = copy(nil, col), row = copy(nil, r), embed = circulant(e) }
	end

	-- The dense matrix.
	local function toeplitz_matrix(T: Toeplitz): Matrix
		local n = T.n
		local A = matrix(n, n)
		for j = 0, n - 1 do
			for i = 0, n - 1 do
				local v = if i >= j then buffer.readf32(T.col, 4 * (i - j)) else buffer.readf32(T.row, 4 * (j - i))
				buffer.writef32(A.data, 4 * (j * n + i), v)
			end
		end
		return A
	end

	-- T x, by FFT through the circulant embedding.
	local function toeplitz_matvec(out: buffer?, T: Toeplitz, x: buffer): buffer
		local n = T.n
		assert(length(x) == n, "matrix and vector sizes do not match")
		local o = output(out, 4 * n)
		if n == 0 then
			return o
		end
		local padded = create(T.embed.n)
		buffer.copy(padded, 0, x, 0, 4 * n)
		local y = circulant_matvec(nil, T.embed, padded)
		buffer.copy(o, 0, y, 0, 4 * n)
		return o
	end

	-- Solves T x = b by Levinson's recursion, O(n^2) in double precision. It needs every
	-- leading principal submatrix of T to be nonsingular (it raises an error otherwise) and is
	-- reliable for well-conditioned, especially symmetric positive definite, matrices; for
	-- other Toeplitz systems use solve on toeplitz_matrix(T). In place if out is b.
	local function toeplitz_solve(out: buffer?, T: Toeplitz, b: buffer): buffer
		local n = T.n
		assert(length(b) == n, "matrix and vector sizes do not match")
		local bt = totable(b)
		local o = output(out, 4 * n)
		if n == 0 then
			return o
		end
		local col, row = totable(T.col), totable(T.row)
		local function t(k: number): number
			return if k >= 0 then col[k + 1] else row[1 - k]
		end
		local t0 = col[1]
		assert(t0 ~= 0, "toeplitz_solve: a leading principal submatrix is singular")
		-- f and g solve T_m f = e_1 and T_m g = e_m; x solves T_m x = b[1..m].
		local f, g, x = { 1 / t0 }, { 1 / t0 }, { bt[1] / t0 }
		for m = 1, n - 1 do
			local ef, eg, ex = 0, 0, 0
			for j = 1, m do
				local tj = t(m + 1 - j)
				ef += tj * f[j]
				ex += tj * x[j]
				eg += t(-j) * g[j]
			end
			local den = 1 - ef * eg
			assert(den ~= 0, "toeplitz_solve: a leading principal submatrix is singular")
			local fn, gn = table.create(m + 1, 0), table.create(m + 1, 0)
			for j = 1, m + 1 do
				local fj = if j <= m then f[j] else 0
				local gj = if j >= 2 then g[j - 1] else 0
				fn[j] = (fj - ef * gj) / den
				gn[j] = (gj - eg * fj) / den
			end
			f, g = fn, gn
			x[m + 1] = 0
			local c = bt[m + 1] - ex
			for j = 1, m + 1 do
				x[j] += c * g[j]
			end
		end
		for j = 1, n do
			buffer.writef32(o, 4 * (j - 1), x[j])
		end
		return o
	end

	-- Sparse matrices

	local function u32(b: buffer, i: number): number
		return buffer.readu32(b, 4 * i)
	end

	-- Assembles a compressed sparse column matrix from per-column lists of (row, value), rows
	-- already sorted and distinct.
	local function assemble(rows: number, cols: number, colrows: { { number } }, colvals: { { number } }): Sparse
		local nnz = 0
		for j = 1, cols do
			nnz += #colrows[j]
		end
		local colptr = buffer.create(4 * (cols + 1))
		local rowind = buffer.create(4 * nnz)
		local values = buffer.create(4 * nnz)
		local p = 0
		for j = 1, cols do
			buffer.writeu32(colptr, 4 * (j - 1), p)
			local rs, vs = colrows[j], colvals[j]
			for k = 1, #rs do
				buffer.writeu32(rowind, 4 * p, rs[k])
				buffer.writef32(values, 4 * p, vs[k])
				p += 1
			end
		end
		buffer.writeu32(colptr, 4 * cols, p)
		return { rows = rows, cols = cols, colptr = colptr, rowind = rowind, values = values }
	end

	local function empty_columns(cols: number): ({ { number } }, { { number } })
		local r, v = table.create(cols) :: { { number } }, table.create(cols) :: { { number } }
		for j = 1, cols do
			r[j], v[j] = {}, {}
		end
		return r, v
	end

	-- A rows by cols sparse matrix from triplets: entry (ii[k], jj[k]) (1-based) gets
	-- values[k]; repeated positions are summed, as in SciPy. Explicit zeros are kept.
	local function sparse(rows: number, cols: number, ii: { number }, jj: { number }, values: buffer): Sparse
		local count = #ii
		assert(#jj == count and length(values) == count, "need as many values as positions")
		local order = table.create(count, 0)
		for k = 1, count do
			local i, j = ii[k], jj[k]
			assert(i % 1 == 0 and j % 1 == 0 and i >= 1 and i <= rows and j >= 1 and j <= cols, "position outside the matrix")
			order[k] = k
		end
		table.sort(order, function(a: number, b: number): boolean
			if jj[a] ~= jj[b] then
				return jj[a] < jj[b]
			end
			return ii[a] < ii[b]
		end)
		local colrows, colvals = empty_columns(cols)
		for _, k in order do
			local rs, vs = colrows[jj[k]], colvals[jj[k]]
			local v = buffer.readf32(values, 4 * (k - 1))
			if #rs > 0 and rs[#rs] == ii[k] - 1 then
				vs[#vs] += v
			else
				table.insert(rs, ii[k] - 1)
				table.insert(vs, v)
			end
		end
		return assemble(rows, cols, colrows, colvals)
	end

	-- Number of stored entries.
	local function sparse_nnz(S: Sparse): number
		return buffer.len(S.rowind) // 4
	end

	-- The nonzero entries of the dense matrix A.
	local function sparse_from_matrix(A: Matrix): Sparse
		local m, n = A.rows, A.cols
		local colrows, colvals = empty_columns(n)
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				local v = buffer.readf32(A.data, 4 * (j * m + i))
				if v ~= 0 then
					table.insert(colrows[j + 1], i)
					table.insert(colvals[j + 1], v)
				end
			end
		end
		return assemble(m, n, colrows, colvals)
	end

	-- The dense matrix.
	local function sparse_matrix(S: Sparse): Matrix
		local A = matrix(S.rows, S.cols)
		for j = 0, S.cols - 1 do
			for p = u32(S.colptr, j), u32(S.colptr, j + 1) - 1 do
				buffer.writef32(A.data, 4 * (j * S.rows + u32(S.rowind, p)), buffer.readf32(S.values, 4 * p))
			end
		end
		return A
	end

	-- Position of entry (i, j) (0-based) in the stored arrays, or nil.
	local function find(S: Sparse, i: number, j: number): number?
		local lo, hi = u32(S.colptr, j), u32(S.colptr, j + 1) - 1
		while lo <= hi do
			local mid = (lo + hi) // 2
			local r = u32(S.rowind, mid)
			if r == i then
				return mid
			elseif r < i then
				lo = mid + 1
			else
				hi = mid - 1
			end
		end
		return nil
	end

	-- Entry (i, j), 1-based (0 if not stored).
	local function sparse_get(S: Sparse, i: number, j: number): number
		local p = find(S, i - 1, j - 1)
		return if p then buffer.readf32(S.values, 4 * p) else 0
	end

	-- The diagonal, as an array of min(rows, cols) entries.
	local function sparse_diag(S: Sparse): buffer
		local k = math.min(S.rows, S.cols)
		local d = create(k)
		for i = 0, k - 1 do
			local p = find(S, i, i)
			if p then
				buffer.writef32(d, 4 * i, buffer.readf32(S.values, 4 * p))
			end
		end
		return d
	end

	-- S x, accumulated in double precision.
	local function sparse_matvec(out: buffer?, S: Sparse, x: buffer): buffer
		assert(length(x) == S.cols, "matrix and vector sizes do not match")
		local o = output(out, 4 * S.rows)
		assert(o ~= x, "output cannot be the input vector")
		local acc = table.create(S.rows, 0)
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		for j = 0, S.cols - 1 do
			local xj = buffer.readf32(x, 4 * j)
			if xj ~= 0 then
				for p = buffer.readu32(colptr, 4 * j), buffer.readu32(colptr, 4 * j + 4) - 1 do
					local r = buffer.readu32(rowind, 4 * p) + 1
					acc[r] += buffer.readf32(vals, 4 * p) * xj
				end
			end
		end
		for i = 1, S.rows do
			buffer.writef32(o, 4 * (i - 1), acc[i])
		end
		return o
	end

	-- S^T x.
	local function sparse_matvec_adjoint(out: buffer?, S: Sparse, x: buffer): buffer
		assert(length(x) == S.rows, "matrix and vector sizes do not match")
		local o = output(out, 4 * S.cols)
		assert(o ~= x, "output cannot be the input vector")
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		for j = 0, S.cols - 1 do
			local s = 0
			for p = buffer.readu32(colptr, 4 * j), buffer.readu32(colptr, 4 * j + 4) - 1 do
				s += buffer.readf32(vals, 4 * p) * buffer.readf32(x, 4 * buffer.readu32(rowind, 4 * p))
			end
			buffer.writef32(o, 4 * j, s)
		end
		return o
	end

	-- S B for a dense matrix B, as a dense matrix.
	local function sparse_matmul(out: Matrix?, S: Sparse, B: Matrix): Matrix
		assert(B.rows == S.cols, "matrix sizes do not match")
		local o = matoutput(out, S.rows, B.cols)
		assert(o.data ~= B.data, "output cannot be an input")
		local col, res = create(S.cols), create(S.rows)
		for j = 0, B.cols - 1 do
			buffer.copy(col, 0, B.data, 4 * j * S.cols, 4 * S.cols)
			sparse_matvec(res, S, col)
			buffer.copy(o.data, 4 * j * S.rows, res, 0, 4 * S.rows)
		end
		return o
	end

	-- S^T.
	local function sparse_transpose(S: Sparse): Sparse
		local colrows, colvals = empty_columns(S.rows)
		for j = 0, S.cols - 1 do
			for p = u32(S.colptr, j), u32(S.colptr, j + 1) - 1 do
				local r = u32(S.rowind, p) + 1
				table.insert(colrows[r], j)
				table.insert(colvals[r], buffer.readf32(S.values, 4 * p))
			end
		end
		return assemble(S.cols, S.rows, colrows, colvals)
	end

	-- A + B.
	local function sparse_add(A: Sparse, B: Sparse): Sparse
		assert(A.rows == B.rows and A.cols == B.cols, "matrix sizes do not match")
		local colrows, colvals = empty_columns(A.cols)
		for j = 0, A.cols - 1 do
			local p, pe = u32(A.colptr, j), u32(A.colptr, j + 1)
			local q, qe = u32(B.colptr, j), u32(B.colptr, j + 1)
			local rs, vs = colrows[j + 1], colvals[j + 1]
			while p < pe or q < qe do
				local ra = if p < pe then u32(A.rowind, p) else math.huge
				local rb = if q < qe then u32(B.rowind, q) else math.huge
				if ra == rb then
					table.insert(rs, ra)
					table.insert(vs, buffer.readf32(A.values, 4 * p) + buffer.readf32(B.values, 4 * q))
					p += 1
					q += 1
				elseif ra < rb then
					table.insert(rs, ra)
					table.insert(vs, buffer.readf32(A.values, 4 * p))
					p += 1
				else
					table.insert(rs, rb)
					table.insert(vs, buffer.readf32(B.values, 4 * q))
					q += 1
				end
			end
		end
		return assemble(A.rows, A.cols, colrows, colvals)
	end

	-- The Jacobi (diagonal) preconditioner of a square S, for the iterative solvers:
	-- out := r ./ diag(S). Every diagonal entry must be nonzero.
	local function sparse_jacobi(S: Sparse): (out: buffer, r: buffer) -> buffer
		assert(S.rows == S.cols, "matrix must be square")
		local d = sparse_diag(S)
		local inv = table.create(S.rows, 0)
		for i = 0, S.rows - 1 do
			local v = buffer.readf32(d, 4 * i)
			assert(v ~= 0, "a diagonal entry is zero")
			inv[i + 1] = 1 / v
		end
		return function(out: buffer, r: buffer): buffer
			for i = 0, S.rows - 1 do
				buffer.writef32(out, 4 * i, buffer.readf32(r, 4 * i) * inv[i + 1])
			end
			return out
		end
	end

	-- For real matrices the adjoint is the transpose.
	local sparse_adjoint = sparse_transpose

	-- Preconditioners for the iterative solvers

	-- The SSOR preconditioner of a square S with relaxation omega (0 < omega < 2; the default
	-- 1 is symmetric Gauss-Seidel): M = (D + w L) D^-1 (D + w U) / (w (2 - w)), with D, L, U
	-- the diagonal and strictly lower and upper parts. Returns out := M^-1 r. If S is
	-- symmetric positive definite, so is M (usable with CG). Every diagonal entry must be
	-- nonzero.
	local function sparse_ssor(S: Sparse, omega: number?): (out: buffer, r: buffer) -> buffer
		local w = omega or 1
		assert(w > 0 and w < 2, "omega must be between 0 and 2")
		assert(S.rows == S.cols, "matrix must be square")
		local n = S.rows
		local d = totable(sparse_diag(S))
		for i = 1, n do
			assert(d[i] ~= 0, "a diagonal entry is zero")
		end
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local y = table.create(n, 0)
		local factor = w * (2 - w)
		return function(out: buffer, r: buffer): buffer
			for i = 1, n do
				y[i] = buffer.readf32(r, 4 * (i - 1))
			end
			-- (D + w L) y = r, column by column.
			for j = 0, n - 1 do
				local yj = y[j + 1] / d[j + 1]
				y[j + 1] = yj
				for p = u32(colptr, j), u32(colptr, j + 1) - 1 do
					local i = u32(rowind, p)
					if i > j then
						y[i + 1] -= w * buffer.readf32(vals, 4 * p) * yj
					end
				end
			end
			for i = 1, n do
				y[i] *= d[i]
			end
			-- (D + w U) z = D y, backwards.
			for j = n - 1, 0, -1 do
				local zj = y[j + 1] / d[j + 1]
				y[j + 1] = zj
				for p = u32(colptr, j), u32(colptr, j + 1) - 1 do
					local i = u32(rowind, p)
					if i < j then
						y[i + 1] -= w * buffer.readf32(vals, 4 * p) * zj
					end
				end
			end
			for i = 1, n do
				buffer.writef32(out, 4 * (i - 1), y[i] * factor)
			end
			return out
		end
	end

	-- Incomplete LU factorization ILU(0) of a square S, in place: S's values are overwritten
	-- with L and U in S's own sparsity pattern (no fill-in). Every diagonal entry must be
	-- stored; singular is true if one is missing or a pivot is zero. sparse_ilu0_copy leaves
	-- S unchanged.
	local function sparse_ilu0(S: Sparse): SparseILU
		assert(S.rows == S.cols, "matrix must be square")
		local n = S.rows
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local pos: { [number]: number } = {}
		local diag = table.create(n, 0)
		local singular = false
		for j = 0, n - 1 do
			local p0, p1 = u32(colptr, j), u32(colptr, j + 1) - 1
			for p = p0, p1 do
				pos[u32(rowind, p)] = p
			end
			-- Eliminate with each earlier column k that column j has an entry in, in order:
			-- u_kj is final by the time it is reached.
			for p = p0, p1 do
				local k = u32(rowind, p)
				if k >= j then
					break
				end
				local ukj = buffer.readf32(vals, 4 * p)
				if ukj ~= 0 then
					for q = diag[k + 1] + 1, u32(colptr, k + 1) - 1 do
						local t = pos[u32(rowind, q)]
						if t then
							buffer.writef32(vals, 4 * t, buffer.readf32(vals, 4 * t) - buffer.readf32(vals, 4 * q) * ukj)
						end
					end
				end
			end
			local dp = pos[j]
			if dp == nil or buffer.readf32(vals, 4 * dp) == 0 then
				singular = true
				diag[j + 1] = if dp then dp else p0
			else
				diag[j + 1] = dp
				local ujj = buffer.readf32(vals, 4 * dp)
				for p = dp + 1, p1 do
					buffer.writef32(vals, 4 * p, buffer.readf32(vals, 4 * p) / ujj)
				end
			end
			for p = p0, p1 do
				pos[u32(rowind, p)] = nil
			end
		end
		return { lu = S, diag = diag, singular = singular }
	end

	local function sparse_copy(S: Sparse): Sparse
		return { rows = S.rows, cols = S.cols, colptr = S.colptr, rowind = S.rowind, values = copy(nil, S.values) }
	end

	-- sparse_ilu0 of a copy of S (the index arrays are shared, the values copied).
	local function sparse_ilu0_copy(S: Sparse): SparseILU
		return sparse_ilu0(sparse_copy(S))
	end

	-- out := (L U)^-1 r given F = sparse_ilu0(S); use it as a preconditioner with
	-- function(out, r) return sparse_ilu0_solve(out, F, r) end.
	local function sparse_ilu0_solve(out: buffer?, F: SparseILU, r: buffer): buffer
		assert(not F.singular, "the incomplete factorization is singular")
		local S = F.lu
		local n = S.rows
		assert(length(r) == n, "matrix and vector sizes do not match")
		local colptr, rowind, vals, diag = S.colptr, S.rowind, S.values, F.diag
		local y = totable(r)
		for j = 0, n - 1 do
			local yj = y[j + 1]
			for p = diag[j + 1] + 1, u32(colptr, j + 1) - 1 do
				local i = u32(rowind, p) + 1
				y[i] -= buffer.readf32(vals, 4 * p) * yj
			end
		end
		for j = n - 1, 0, -1 do
			local yj = y[j + 1] / buffer.readf32(vals, 4 * diag[j + 1])
			y[j + 1] = yj
			for p = u32(colptr, j), diag[j + 1] - 1 do
				local i = u32(rowind, p) + 1
				y[i] -= buffer.readf32(vals, 4 * p) * yj
			end
		end
		local o = output(out, 4 * n)
		for i = 1, n do
			buffer.writef32(o, 4 * (i - 1), y[i])
		end
		return o
	end

	-- Incomplete Cholesky factorization IC(0) of a symmetric positive definite S, in place:
	-- only the lower triangle is read, and it is overwritten with L in its own sparsity
	-- pattern (no fill-in). It can break down even for positive definite S (definite is then
	-- false); it cannot for M-matrices such as discrete Laplacians. sparse_ic0_copy leaves S
	-- unchanged.
	local function sparse_ic0(S: Sparse): SparseIC
		assert(S.rows == S.cols, "matrix must be square")
		local n = S.rows
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local diag = table.create(n, 0)
		for j = 0, n - 1 do
			local dp = find(S, j, j)
			if dp == nil then
				return { ic = S, diag = diag, definite = false }
			end
			diag[j + 1] = dp
			local djj = buffer.readf32(vals, 4 * dp)
			if not (djj > 0) then
				return { ic = S, diag = diag, definite = false }
			end
			djj = math.sqrt(djj)
			buffer.writef32(vals, 4 * dp, djj)
			local p1 = u32(colptr, j + 1) - 1
			for p = dp + 1, p1 do
				buffer.writef32(vals, 4 * p, buffer.readf32(vals, 4 * p) / djj)
			end
			-- Right-looking update of later columns, only where the pattern has an entry:
			-- A(i, k) -= L(i, j) L(k, j) for j < k <= i.
			for q = dp + 1, p1 do
				local k = u32(rowind, q)
				local lkj = buffer.readf32(vals, 4 * q)
				for p = q, p1 do
					local t = find(S, u32(rowind, p), k)
					if t then
						buffer.writef32(vals, 4 * t, buffer.readf32(vals, 4 * t) - buffer.readf32(vals, 4 * p) * lkj)
					end
				end
			end
		end
		return { ic = S, diag = diag, definite = true }
	end

	-- sparse_ic0 of a copy of S (the index arrays are shared, the values copied).
	local function sparse_ic0_copy(S: Sparse): SparseIC
		return sparse_ic0(sparse_copy(S))
	end

	-- out := (L L^T)^-1 r given F = sparse_ic0(S); use it as a preconditioner with
	-- function(out, r) return sparse_ic0_solve(out, F, r) end.
	local function sparse_ic0_solve(out: buffer?, F: SparseIC, r: buffer): buffer
		assert(F.definite, "the incomplete Cholesky factorization broke down")
		local S = F.ic
		local n = S.rows
		assert(length(r) == n, "matrix and vector sizes do not match")
		local colptr, rowind, vals, diag = S.colptr, S.rowind, S.values, F.diag
		local y = totable(r)
		-- L y = r
		for j = 0, n - 1 do
			local yj = y[j + 1] / buffer.readf32(vals, 4 * diag[j + 1])
			y[j + 1] = yj
			for p = diag[j + 1] + 1, u32(colptr, j + 1) - 1 do
				local i = u32(rowind, p) + 1
				y[i] -= buffer.readf32(vals, 4 * p) * yj
			end
		end
		-- L^T z = y
		for j = n - 1, 0, -1 do
			local s = y[j + 1]
			for p = diag[j + 1] + 1, u32(colptr, j + 1) - 1 do
				s -= buffer.readf32(vals, 4 * p) * y[u32(rowind, p) + 1]
			end
			y[j + 1] = s / buffer.readf32(vals, 4 * diag[j + 1])
		end
		local o = output(out, 4 * n)
		for i = 1, n do
			buffer.writef32(o, 4 * (i - 1), y[i])
		end
		return o
	end

	ext.triangular_solve = triangular_solve
	ext.triangular_matvec = triangular_matvec
	ext.tridiagonal = tridiagonal
	ext.tridiag_copy = tridiag_copy
	ext.tridiag_matrix = tridiag_matrix
	ext.tridiag_matvec = tridiag_matvec
	ext.tridiag_lu = tridiag_lu
	ext.tridiag_lu_copy = tridiag_lu_copy
	ext.tridiag_lu_solve = tridiag_lu_solve
	ext.tridiag_ldl = tridiag_ldl
	ext.tridiag_ldl_copy = tridiag_ldl_copy
	ext.tridiag_ldl_solve = tridiag_ldl_solve
	ext.banded = banded
	ext.band_copy = band_copy
	ext.band_at = band_at
	ext.in_band = in_band
	ext.band_get = band_get
	ext.band_set = band_set
	ext.band_from_matrix = band_from_matrix
	ext.band_matrix = band_matrix
	ext.band_matvec = band_matvec
	ext.band_lu = band_lu
	ext.band_lu_copy = band_lu_copy
	ext.band_lu_solve = band_lu_solve
	ext.band_chol = band_chol
	ext.band_chol_copy = band_chol_copy
	ext.band_chol_solve = band_chol_solve
	ext.circulant = circulant
	ext.circulant_matvec = circulant_matvec
	ext.circulant_solve = circulant_solve
	ext.circulant_matrix = circulant_matrix
	ext.toeplitz = toeplitz
	ext.toeplitz_matrix = toeplitz_matrix
	ext.toeplitz_matvec = toeplitz_matvec
	ext.toeplitz_solve = toeplitz_solve
	ext.u32 = u32
	ext.assemble = assemble
	ext.empty_columns = empty_columns
	ext.sparse = sparse
	ext.sparse_nnz = sparse_nnz
	ext.sparse_from_matrix = sparse_from_matrix
	ext.sparse_matrix = sparse_matrix
	ext.find = find
	ext.sparse_get = sparse_get
	ext.sparse_diag = sparse_diag
	ext.sparse_matvec = sparse_matvec
	ext.sparse_matvec_adjoint = sparse_matvec_adjoint
	ext.sparse_matmul = sparse_matmul
	ext.sparse_transpose = sparse_transpose
	ext.sparse_adjoint = sparse_adjoint
	ext.sparse_add = sparse_add
	ext.sparse_jacobi = sparse_jacobi
	ext.sparse_ssor = sparse_ssor
	ext.sparse_ilu0 = sparse_ilu0
	ext.sparse_copy = sparse_copy
	ext.sparse_ilu0_copy = sparse_ilu0_copy
	ext.sparse_ilu0_solve = sparse_ilu0_solve
	ext.sparse_ic0 = sparse_ic0
	ext.sparse_ic0_copy = sparse_ic0_copy
	ext.sparse_ic0_solve = sparse_ic0_solve
end

-- Matrix utilities, matrix norms, slogdet and transposed LU solves.

do
	-- The sum of the diagonal.
	function ext.trace(A: Matrix): number
		local s = 0
		for i = 0, math.min(A.rows, A.cols) - 1 do
			s += buffer.readf32(A.data, 4 * (i * A.rows + i))
		end
		return s
	end

	-- The diagonal (min(rows, cols) entries), as an array.
	function ext.diag(out: buffer?, A: Matrix): buffer
		local n = math.min(A.rows, A.cols)
		local o = output(out, 4 * n)
		for i = 0, n - 1 do
			buffer.writef32(o, 4 * i, buffer.readf32(A.data, 4 * (i * A.rows + i)))
		end
		return o
	end

	-- The square matrix with the array x on its diagonal.
	function ext.diagm(x: buffer): Matrix
		local n = length(x)
		local D = matrix(n, n)
		for i = 0, n - 1 do
			buffer.writef32(D.data, 4 * (i * n + i), buffer.readf32(x, 4 * i))
		end
		return D
	end

	-- The Kronecker product: the block matrix [a_ij B].
	function ext.kron(A: Matrix, B: Matrix): Matrix
		local m, n, p, q = A.rows, A.cols, B.rows, B.cols
		local K = matrix(m * p, n * q)
		local k, a, b = K.data, A.data, B.data
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				local aij = buffer.readf32(a, 4 * (j * m + i))
				if aij ~= 0 then
					for l = 0, q - 1 do
						local col = (j * q + l) * m * p + i * p
						for r = 0, p - 1 do
							buffer.writef32(k, 4 * (col + r), aij * buffer.readf32(b, 4 * (l * p + r)))
						end
					end
				end
			end
		end
		return K
	end

	-- The outer product x y^T.
	function ext.outer(out: Matrix?, x: buffer, y: buffer): Matrix
		local m, n = length(x), length(y)
		local o = matoutput(out, m, n)
		for j = 0, n - 1 do
			local yj = buffer.readf32(y, 4 * j)
			for i = 0, m - 1 do
				buffer.writef32(o.data, 4 * (j * m + i), buffer.readf32(x, 4 * i) * yj)
			end
		end
		return o
	end

	-- The rank-one update A := A + a x y^T, in place (BLAS ger); returns A.
	function ext.ger(A: Matrix, a: number, x: buffer, y: buffer): Matrix
		local m, n = A.rows, A.cols
		assert(length(x) == m and length(y) == n, "ger: sizes do not match")
		for j = 0, n - 1 do
			local f = a * buffer.readf32(y, 4 * j)
			if f ~= 0 then
				for i = 0, m - 1 do
					local o = 4 * (j * m + i)
					buffer.writef32(A.data, o, buffer.readf32(A.data, o) + f * buffer.readf32(x, 4 * i))
				end
			end
		end
		return A
	end

	-- A^T x, without forming the transpose.
	function ext.matvec_adjoint(out: buffer?, A: Matrix, x: buffer): buffer
		local m, n = A.rows, A.cols
		assert(length(x) == m, "matvec_adjoint: sizes do not match")
		local o = output(out, 4 * n)
		assert(o ~= x, "output cannot be the input vector")
		for j = 0, n - 1 do
			local s = 0
			for i = 0, m - 1 do
				s += buffer.readf32(A.data, 4 * (j * m + i)) * buffer.readf32(x, 4 * i)
			end
			buffer.writef32(o, 4 * j, s)
		end
		return o
	end

	-- C := alpha op(A) op(B) + beta C (BLAS gemm), where op is "n" (as is), "t" or "c"
	-- (transposed; the same for real matrices). C is new (or out) when beta is 0 or nil.
	-- Sums run in double precision and each entry is rounded once.
	function ext.gemm(C: Matrix?, alpha: number, A: Matrix, B: Matrix, beta: number?, opa: string?, opb: string?): Matrix
		local ta, tb = opa ~= nil and opa ~= "n", opb ~= nil and opb ~= "n"
		local m, kk = if ta then A.cols else A.rows, if ta then A.rows else A.cols
		local kb, n = if tb then B.cols else B.rows, if tb then B.rows else B.cols
		assert(kk == kb, "gemm: inner dimensions do not match")
		local b0 = beta or 0
		local o: Matrix
		if b0 == 0 then
			o = matoutput(C, m, n)
		else
			assert(C ~= nil and C.rows == m and C.cols == n, "gemm: beta needs a C of the right shape")
			o = C
		end
		assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
		local a, b, c = A.data, B.data, o.data
		local am, bm = A.rows, B.rows
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				local s = 0
				for k = 0, kk - 1 do
					local x = if ta then buffer.readf32(a, 4 * (i * am + k)) else buffer.readf32(a, 4 * (k * am + i))
					local y = if tb then buffer.readf32(b, 4 * (k * bm + j)) else buffer.readf32(b, 4 * (j * bm + k))
					s += x * y
				end
				local off = 4 * (j * m + i)
				buffer.writef32(c, off, alpha * s + (if b0 ~= 0 then b0 * buffer.readf32(c, off) else 0))
			end
		end
		return o
	end

	-- The sign and the log of the absolute value of det(A), without overflow: returns
	-- (sign, log |det|), with sign 0 and log -inf for a singular matrix.
	function ext.slogdet(A: Matrix): (number, number)
		local F = lu_copy(A)
		local n = A.rows
		local sign, logabs = F.sign, 0
		for k = 0, n - 1 do
			local u = buffer.readf32(F.lu.data, 4 * (k * n + k))
			if u == 0 then
				return 0, -math.huge
			end
			if u < 0 then
				sign = -sign
			end
			logabs += math.log(math.abs(u))
		end
		return sign, logabs
	end

	-- Matrix norms: kind 1 (largest column sum of |a_ij|), "inf" (largest row sum), 2
	-- (largest singular value) or "fro" (Frobenius; the default).
	function ext.matnorm(A: Matrix, kind: (number | string)?): number
		local m, n = A.rows, A.cols
		local a = A.data
		if kind == nil or kind == "fro" then
			return norm(a)
		elseif kind == 2 then
			if m == 0 or n == 0 then
				return 0
			end
			return buffer.readf32(svd_copy(A, false).values, 0)
		elseif kind == 1 then
			local best = 0
			for j = 0, n - 1 do
				local s = 0
				for i = 0, m - 1 do
					s += math.abs(buffer.readf32(a, 4 * (j * m + i)))
				end
				if not (s <= best) then
					best = s
				end
			end
			return best
		elseif kind == "inf" then
			local rows = table.create(m, 0) :: { number }
			for j = 0, n - 1 do
				for i = 0, m - 1 do
					rows[i + 1] += math.abs(buffer.readf32(a, 4 * (j * m + i)))
				end
			end
			local best = 0
			for _, s in rows do
				if not (s <= best) then
					best = s
				end
			end
			return best
		end
		error(`matnorm: unknown kind {kind}`)
	end

	-- Solves A^T x = b given F = lu(A) (P A = L U, so A^T = U^T L^T P).
	function ext.lu_solve_adjoint(out: buffer?, F: LU, b: buffer): buffer
		assert(not F.singular, "matrix is singular")
		local n = F.lu.rows
		assert(buffer.len(b) == 4 * n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = F.lu.data
		-- U^T y = b, forward.
		for j = 0, n - 1 do
			local s = buffer.readf32(o, 4 * j)
			for i = 0, j - 1 do
				s -= buffer.readf32(a, 4 * (j * n + i)) * buffer.readf32(o, 4 * i)
			end
			buffer.writef32(o, 4 * j, s / buffer.readf32(a, 4 * (j * n + j)))
		end
		-- L^T z = y, backward (unit diagonal).
		for j = n - 1, 0, -1 do
			local s = buffer.readf32(o, 4 * j)
			for i = j + 1, n - 1 do
				s -= buffer.readf32(a, 4 * (j * n + i)) * buffer.readf32(o, 4 * i)
			end
			buffer.writef32(o, 4 * j, s)
		end
		-- x = P^T z: the interchanges in reverse.
		for k = n - 1, 0, -1 do
			local p = F.piv[k + 1] - 1
			if p ~= k then
				local tmp = buffer.readf32(o, 4 * k)
				buffer.writef32(o, 4 * k, buffer.readf32(o, 4 * p))
				buffer.writef32(o, 4 * p, tmp)
			end
		end
		return o
	end

	-- Helpers for the condition estimator: the 1-norm of a vector, the signs of its
	-- entries (1 for zero), the index (1-based) and size of its largest entry, a real dot
	-- product, and the unit vector e_j.
	function ext.asum(x: buffer): number
		local s = 0
		for k = 0, buffer.len(x) - 4, 4 do
			s += math.abs(buffer.readf32(x, k))
		end
		return s
	end

	function ext.signs(x: buffer): buffer
		local o = buffer.create(buffer.len(x))
		for k = 0, buffer.len(x) - 4, 4 do
			buffer.writef32(o, k, if buffer.readf32(x, k) < 0 then -1 else 1)
		end
		return o
	end

	function ext.argmax(x: buffer): (number, number)
		local best, at = -1, 1
		for i = 0, length(x) - 1 do
			local v = math.abs(buffer.readf32(x, 4 * i))
			if v > best then
				best, at = v, i + 1
			end
		end
		return best, at
	end

	ext.rdot = dot

	-- Element i (0-based) as (re, im), and its setter (the imaginary part is dropped), for
	-- code shared with the complex modules.
	function ext.eget(x: buffer, i: number): (number, number)
		return buffer.readf32(x, 4 * i), 0
	end

	function ext.eset(x: buffer, i: number, re: number, _im: number)
		buffer.writef32(x, 4 * i, re)
	end

	function ext.unit(n: number, j: number): buffer
		local e = create(n)
		buffer.writef32(e, 4 * (j - 1), 1)
		return e
	end
end

-- Symmetric indefinite factorization (Bunch-Kaufman).

do
	-- The Bunch-Kaufman factorization P A P^T = L D L^T of a symmetric (possibly
	-- indefinite) matrix, in place (LAPACK's sytf2, lower): only the lower triangle of A is
	-- read and it is overwritten with L (unit lower triangular, below the diagonal) and the
	-- block diagonal D (1 by 1 and 2 by 2 blocks). piv records the interchanges as LAPACK's
	-- ipiv does, 1-based: piv[k] > 0 for a 1 by 1 block (row k was swapped with piv[k]),
	-- piv[k] = piv[k+1] < 0 for a 2 by 2 block (row k+1 was swapped with -piv[k]). The
	-- pivoting (alpha = (1 + sqrt 17) / 8) keeps the growth bounded, so this is stable for
	-- any symmetric matrix, unlike Cholesky (definite only) or LU (which ignores symmetry).
	-- ldl_copy leaves A unchanged.
	function ext.ldl(A: Matrix): LDL
		local n = A.rows
		assert(A.cols == n, "matrix must be square")
		local a = A.data
		local function get(i: number, j: number): number
			return buffer.readf32(a, 4 * (j * n + i))
		end
		local function set(i: number, j: number, v: number)
			buffer.writef32(a, 4 * (j * n + i), v)
		end
		local function swap(i1: number, j1: number, i2: number, j2: number)
			local t = get(i1, j1)
			set(i1, j1, get(i2, j2))
			set(i2, j2, t)
		end
		local piv = table.create(n, 0) :: { number }
		local singular = false
		local alpha = (1 + math.sqrt(17)) / 8
		local k = 0
		while k < n do
			local kstep = 1
			local kp = k
			local absakk = math.abs(get(k, k))
			local imax, colmax = k, 0
			for i = k + 1, n - 1 do
				local v = math.abs(get(i, k))
				if v > colmax then
					imax, colmax = i, v
				end
			end
			if math.max(absakk, colmax) == 0 then
				singular = true
			else
				if absakk < alpha * colmax then
					-- The largest off-diagonal entry in row/column imax of the trailing matrix.
					local rowmax = 0
					for j = k, imax - 1 do
						rowmax = math.max(rowmax, math.abs(get(imax, j)))
					end
					for j = imax + 1, n - 1 do
						rowmax = math.max(rowmax, math.abs(get(j, imax)))
					end
					if absakk >= alpha * colmax * (colmax / rowmax) then
						kp = k
					elseif math.abs(get(imax, imax)) >= alpha * rowmax then
						kp = imax
					else
						kp = imax
						kstep = 2
					end
				end
				local kk = k + kstep - 1
				if kp ~= kk then
					-- Interchange rows and columns kk and kp of the trailing matrix.
					for i = kp + 1, n - 1 do
						swap(i, kk, i, kp)
					end
					for j = kk + 1, kp - 1 do
						swap(j, kk, kp, j)
					end
					swap(kk, kk, kp, kp)
					if kstep == 2 then
						swap(k + 1, k, kp, k)
					end
				end
				if kstep == 1 then
					-- A(k+1:, k+1:) -= x x^T / d, then x /= d.
					local r1 = 1 / get(k, k)
					for j = k + 1, n - 1 do
						local f = r1 * get(j, k)
						if f ~= 0 then
							for i = j, n - 1 do
								set(i, j, get(i, j) - get(i, k) * f)
							end
						end
					end
					for i = k + 1, n - 1 do
						set(i, k, get(i, k) * r1)
					end
				elseif k < n - 2 then
					-- With the 2 by 2 block D: A(k+2:, k+2:) -= [x y] D^-1 [x y]^T, and
					-- the columns become [x y] D^-1.
					local d21 = get(k + 1, k)
					local d11 = get(k + 1, k + 1) / d21
					local d22 = get(k, k) / d21
					local t = 1 / (d11 * d22 - 1)
					d21 = t / d21
					for j = k + 2, n - 1 do
						local wk = d21 * (d11 * get(j, k) - get(j, k + 1))
						local wkp1 = d21 * (d22 * get(j, k + 1) - get(j, k))
						for i = j, n - 1 do
							set(i, j, get(i, j) - get(i, k) * wk - get(i, k + 1) * wkp1)
						end
						set(j, k, wk)
						set(j, k + 1, wkp1)
					end
				end
			end
			if kstep == 1 then
				piv[k + 1] = kp + 1
			else
				piv[k + 1] = -(kp + 1)
				piv[k + 2] = -(kp + 1)
			end
			k += kstep
		end
		return { ldl = A, piv = piv, singular = singular }
	end

	-- The factorization of a copy of A; A is not modified.
	function ext.ldl_copy(A: Matrix): LDL
		return ext.ldl(matcopy(nil, A))
	end

	-- Solves A x = b given F = ldl(A) (LAPACK's sytrs).
	function ext.ldl_solve(out: buffer?, F: LDL, b: buffer): buffer
		assert(not F.singular, "matrix is singular")
		local n = F.ldl.rows
		assert(buffer.len(b) == 4 * n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a, piv = F.ldl.data, F.piv
		local function get(i: number, j: number): number
			return buffer.readf32(a, 4 * (j * n + i))
		end
		local function x(i: number): number
			return buffer.readf32(o, 4 * i)
		end
		local function setx(i: number, v: number)
			buffer.writef32(o, 4 * i, v)
		end
		local function swapx(i: number, j: number)
			local t = x(i)
			setx(i, x(j))
			setx(j, t)
		end
		-- L D y = P b.
		local k = 0
		while k < n do
			if piv[k + 1] > 0 then
				swapx(k, piv[k + 1] - 1)
				local xk = x(k)
				for i = k + 1, n - 1 do
					setx(i, x(i) - get(i, k) * xk)
				end
				setx(k, xk / get(k, k))
				k += 1
			else
				swapx(k + 1, -piv[k + 1] - 1)
				local xk, xk1 = x(k), x(k + 1)
				for i = k + 2, n - 1 do
					setx(i, x(i) - get(i, k) * xk - get(i, k + 1) * xk1)
				end
				local akm1k = get(k + 1, k)
				local akm1 = get(k, k) / akm1k
				local ak = get(k + 1, k + 1) / akm1k
				local denom = akm1 * ak - 1
				local bkm1, bk = xk / akm1k, xk1 / akm1k
				setx(k, (ak * bkm1 - bk) / denom)
				setx(k + 1, (akm1 * bk - bkm1) / denom)
				k += 2
			end
		end
		-- L^T x = y, then undo the interchanges.
		k = n - 1
		while k >= 0 do
			local s = x(k)
			for i = k + 1, n - 1 do
				s -= get(i, k) * x(i)
			end
			setx(k, s)
			if piv[k + 1] > 0 then
				swapx(k, piv[k + 1] - 1)
				k -= 1
			else
				local s2 = x(k - 1)
				for i = k + 1, n - 1 do
					s2 -= get(i, k - 1) * x(i)
				end
				setx(k - 1, s2)
				swapx(k, -piv[k + 1] - 1)
				k -= 2
			end
		end
		return o
	end

	-- The inertia of A from F = ldl(A): the numbers of positive, negative and zero
	-- eigenvalues (Sylvester's law of inertia: D has the same). Each 2 by 2 block has one
	-- of each sign.
	function ext.ldl_inertia(F: LDL): (number, number, number)
		local n = F.ldl.rows
		local pos, neg, zero = 0, 0, 0
		local k = 0
		while k < n do
			if F.piv[k + 1] > 0 then
				local d = buffer.readf32(F.ldl.data, 4 * (k * n + k))
				if d > 0 then
					pos += 1
				elseif d < 0 then
					neg += 1
				else
					zero += 1
				end
				k += 1
			else
				pos += 1
				neg += 1
				k += 2
			end
		end
		return pos, neg, zero
	end
end

-- Bytes per matrix entry.
local ENTRY = buffer.len(matrix(1, 1).data)

-- Solves A x = b, or A X = B for a matrix B of right-hand sides (one factorization serves
-- every column; X is a new matrix, or `out`). `form` says what A is:
--   "matrix" (or nil)  a matrix. Square: LU with partial pivoting. More rows than
--                      columns: the least-squares solution, by Householder QR. More
--                      columns than rows: the basic solution, by column-pivoted QR.
--   "lu"               a factorization from lu or lu_copy
--   "qr"               a factorization from qr or qr_copy (least squares if tall)
--   "qrp"              a factorization from qrp or qrp_copy (any shape or rank; see
--                      qrp_solve, whose default rank tolerance is used)
--   "chol"             a factorization from chol or chol_copy
--   "ldl"              a factorization from ldl or ldl_copy (symmetric indefinite)
--   "svd"              a decomposition from svd or svd_copy, with vectors: the
--                      pseudoinverse solution A^+ b (minimum-norm least squares, any
--                      shape or rank; see svd_solve, whose default tolerance is used)
-- Neither A nor b is modified.
local function solve_impl(out: any, A: any, b: any, form: Form?): any
	local t = A :: any
	-- The solver for one right-hand side, and the number of unknowns.
	local one: any
	local n: number
	if form == "lu" then
		assert(type(t) == "table" and t.lu ~= nil, `solve: form "lu" needs a factorization from lu`)
		local F = A :: LU
		n = F.lu.cols
		one = function(o, v)
			return lu_solve(o, F, v)
		end
	elseif form == "qr" then
		assert(type(t) == "table" and t.qr ~= nil, `solve: form "qr" needs a factorization from qr`)
		assert(t.perm == nil, `solve: this is a pivoted factorization; use form "qrp"`)
		local F = A :: QR
		n = F.qr.cols
		one = function(o, v)
			return (qr_solve(o, F, v))
		end
	elseif form == "qrp" then
		assert(type(t) == "table" and t.perm ~= nil, `solve: form "qrp" needs a factorization from qrp`)
		local F = A :: QRP
		n = F.qr.cols
		one = function(o, v)
			return (qrp_solve(o, F, v))
		end
	elseif form == "chol" then
		assert(type(t) == "table" and t.chol ~= nil, `solve: form "chol" needs a factorization from chol`)
		local F = A :: Cholesky
		n = F.chol.cols
		one = function(o, v)
			return chol_solve(o, F, v)
		end
	elseif form == "ldl" then
		assert(type(t) == "table" and t.ldl ~= nil, `solve: form "ldl" needs a factorization from ldl`)
		local F = A :: LDL
		n = F.ldl.cols
		one = function(o, v)
			return ext.ldl_solve(o, F, v)
		end
	elseif form == "svd" then
		assert(
			type(t) == "table" and t.values ~= nil and t.u ~= nil and t.v ~= nil,
			`solve: form "svd" needs a decomposition from svd with vectors`
		)
		local F = A :: Svd
		n = (F.v :: Matrix).rows
		one = function(o, v)
			return (svd_solve(o, F, v))
		end
	else
		assert(form == nil or form == "matrix", `solve: unknown form {form}`)
		assert(type(t) == "table" and t.data ~= nil, "solve: A is not a matrix (pass its form)")
		local M = A :: Matrix
		n = M.cols
		if M.rows == M.cols then
			local F = lu_copy(M)
			one = function(o, v)
				return lu_solve(o, F, v)
			end
		elseif M.rows > M.cols then
			local F = qr_copy(M)
			one = function(o, v)
				return (qr_solve(o, F, v))
			end
		else
			local F = qrp_copy(M)
			one = function(o, v)
				return (qrp_solve(o, F, v))
			end
		end
	end
	local solve1 = one :: (buffer?, buffer) -> buffer
	if type(b) == "buffer" then
		return solve1(out, b)
	end
	assert(type(b) == "table" and b.data ~= nil, "solve: b must be a vector or a matrix")
	local B = b :: Matrix
	local X = matoutput(out, n, B.cols)
	assert(X.data ~= B.data, "output cannot be the right-hand side")
	local col, x = buffer.create(ENTRY * B.rows), buffer.create(ENTRY * n)
	for j = 0, B.cols - 1 do
		buffer.copy(col, 0, B.data, ENTRY * j * B.rows, ENTRY * B.rows)
		solve1(x, col)
		buffer.copy(X.data, ENTRY * j * n, x)
	end
	return X
end

type SolveFunction =
	((out: buffer?, A: Matrix | LU | QR | QRP | Cholesky | LDL | Svd, b: buffer, form: Form?) -> buffer)
	& ((out: Matrix?, A: Matrix | LU | QR | QRP | Cholesky | LDL | Svd, B: Matrix, form: Form?) -> Matrix)

local solve: SolveFunction = solve_impl :: any

-- The conjugate transpose, for the shared polar code.
local conj_transpose = transpose

-- Polar decomposition

-- QDWH (Nakatsukasa, Bai and Gygi 2010; in the form of Nakatsukasa and Higham 2013) for a
-- matrix with rows >= cols: returns U, with orthonormal columns, of A = U H as a new
-- matrix, and the number of iterations. X_0 = A / alpha with alpha = |A|_F >= |A|_2, and
-- l_0 <= sigma_min(X_0) from |R^-1|_F of A's QR factor. Each step applies the best
-- rational function of type (3, 2) for the current bound l, mapping [l, 1] into [l', 1]:
--   X' = (b / c) X + (a - b / c) X (I + c X^H X)^-1,
-- computed through the QR factorization of [sqrt(c) X; I] while c is large (for
-- stability) and through a Cholesky factorization once c <= 100. It converges cubically;
-- at most about 6 steps for condition numbers up to 1 / eps.
local function qdwh(A: Matrix): (Matrix, number)
	local m, n = A.rows, A.cols
	local alpha = norm(A.data)
	if alpha == 0 then
		-- The zero matrix: any U with orthonormal columns will do; take I's first columns.
		local U = matrix(m, n)
		for j = 0, n - 1 do
			buffer.writef32(U.data, ENTRY * (j * m + j), 1)
		end
		return U, 0
	end
	local X = matcopy(nil, A)
	X.data = scale(X.data, 1 / alpha, X.data)
	-- l_0: sigma_min(X) = sigma_min(R) >= 1 / |R^-1|_2 >= 1 / |R^-1|_F. A singular R gives
	-- l = eps, below which singular values are rounding noise.
	local R = qr_r(nil, qr_copy(X))
	local ok, Rinv = pcall(inv_copy, R)
	local l = if ok then 1 / norm((Rinv :: Matrix).data) else 0
	if not (l > EPS) then
		l = EPS
	end
	l = math.min(l, 1)
	local I = identity(n)
	local iterations = 0
	while iterations < 30 do
		local l2 = l * l
		local d = (4 * (1 - l2) / (l2 * l2)) ^ (1 / 3)
		local a = math.sqrt(1 + d) + 0.5 * math.sqrt(8 - 4 * d + 8 * (2 - l2) / (l2 * math.sqrt(1 + d)))
		local b = (a - 1) ^ 2 / 4
		local c = a + b - 1
		local Xnew = matrix(m, n)
		if c > 100 then
			-- [sqrt(c) X; I] = [Q1; Q2] R; then X' = (b / c) X + (a - b / c) / sqrt(c) Q1 Q2^H.
			local rc = math.sqrt(c)
			local stacked = matrix(m + n, n)
			local sx = scale(nil, rc, X.data)
			for j = 0, n - 1 do
				buffer.copy(stacked.data, ENTRY * j * (m + n), sx, ENTRY * j * m, ENTRY * m)
				buffer.writef32(stacked.data, ENTRY * (j * (m + n) + m + j), 1)
			end
			local Q = qr_q(nil, qr(stacked))
			local Q1, Q2 = matrix(m, n), matrix(n, n)
			for j = 0, n - 1 do
				buffer.copy(Q1.data, ENTRY * j * m, Q.data, ENTRY * j * (m + n), ENTRY * m)
				buffer.copy(Q2.data, ENTRY * j * n, Q.data, ENTRY * (j * (m + n) + m), ENTRY * n)
			end
			local P = matmul(nil, Q1, conj_transpose(nil, Q2))
			Xnew.data = axpy(nil, (a - b / c) / rc, P.data, scale(nil, b / c, X.data))
		else
			-- Z = I + c X^H X is positive definite; X Z^-1 = (Z^-1 X^H)^H.
			local Z = matmul(nil, conj_transpose(nil, X), X)
			Z.data = axpy(Z.data, c, Z.data, I.data)
			local F = chol(Z)
			local Y = solve(nil, F, conj_transpose(nil, X), "chol")
			Xnew.data = axpy(nil, a - b / c, conj_transpose(nil, Y).data, scale(nil, b / c, X.data))
		end
		iterations += 1
		local change = norm(sub(nil, Xnew.data, X.data))
		X = Xnew
		l = math.min(l * (a + b * l2) / (1 + c * l2), 1)
		-- Cubic convergence: once a step changes X by at most (5 eps)^(1/3), X is accurate
		-- to about 5 eps.
		if 1 - l <= 10 * EPS and change <= (5 * EPS) ^ (1 / 3) then
			break
		end
	end
	return X, iterations
end

-- Polar decomposition A = U H, in place: U has orthonormal columns (rows, if A is wide)
-- and overwrites A; H = U^H A is Hermitian positive semidefinite (cols by cols), new.
-- F.iterations counts the QDWH steps (see qdwh). For full-rank A both factors are unique;
-- U is then the closest matrix with orthonormal columns (or rows) to A in every unitarily
-- invariant norm. If A is exactly rank deficient, U is the canonical partial isometry
-- (U^H U projects onto the range of H); a numerically rank-deficient A, whose tiny singular
-- values rounding has made nonzero, gets an orthonormal U in a few more steps. A wide A is
-- handled through its adjoint. A NaN or infinite entry gives NaN factors. polar_copy
-- leaves A unchanged.
local function polar(A: Matrix): Polar
	local m, n = A.rows, A.cols
	local reals = buffer.len(A.data) // 4
	if any_nonfinite(A.data, 0, reals) then
		fill_nan(A.data, 0, reals)
		local H = matrix(n, n)
		fill_nan(H.data, 0, buffer.len(H.data) // 4)
		return { u = A, h = H, iterations = 0 }
	end
	local U: Matrix, iterations: number
	if m >= n then
		U, iterations = qdwh(A)
	else
		local V: Matrix
		V, iterations = qdwh(conj_transpose(nil, A))
		U = conj_transpose(nil, V)
	end
	local H = matmul(nil, conj_transpose(nil, U), A)
	-- Rounding leaves H very slightly non-Hermitian; take the Hermitian part.
	H.data = scale(nil, 0.5, add(nil, H.data, conj_transpose(nil, H).data))
	buffer.copy(A.data, 0, U.data)
	return { u = A, h = H, iterations = iterations }
end

-- The polar decomposition of a copy of A; A is not modified.
local function polar_copy(A: Matrix): Polar
	return polar(matcopy(nil, A))
end

-- Submatrices, rank and subspaces, condition numbers and the matrix exponential (shared by
-- the real and complex modules; entries are ENTRY bytes).

do
	-- Rows i0..i1 and columns j0..j1 of A (1-based, inclusive) as a new matrix (or out).
	function ext.submatrix(out: Matrix?, A: Matrix, i0: number, i1: number, j0: number, j1: number): Matrix
		assert(1 <= i0 and i0 <= i1 + 1 and i1 <= A.rows, "submatrix: rows out of range")
		assert(1 <= j0 and j0 <= j1 + 1 and j1 <= A.cols, "submatrix: columns out of range")
		local r, c = i1 - i0 + 1, j1 - j0 + 1
		local o = matoutput(out, r, c)
		assert(o.data ~= A.data, "output cannot be the input")
		for j = 0, c - 1 do
			buffer.copy(o.data, ENTRY * j * r, A.data, ENTRY * ((j0 - 1 + j) * A.rows + i0 - 1), ENTRY * r)
		end
		return o
	end

	-- Copies B into A with B's first entry at (i0, j0) (1-based); returns A.
	function ext.setsubmatrix(A: Matrix, i0: number, j0: number, B: Matrix): Matrix
		assert(i0 >= 1 and j0 >= 1 and i0 + B.rows - 1 <= A.rows and j0 + B.cols - 1 <= A.cols, "setsubmatrix: B does not fit")
		for j = 0, B.cols - 1 do
			buffer.copy(A.data, ENTRY * ((j0 - 1 + j) * A.rows + i0 - 1), B.data, ENTRY * j * B.rows, ENTRY * B.rows)
		end
		return A
	end

	-- [A1 A2 ...]: the matrices side by side (equal row counts).
	function ext.hstack(list: { Matrix }): Matrix
		assert(#list > 0, "hstack needs at least one matrix")
		local m, n = list[1].rows, 0
		for _, B in list do
			assert(B.rows == m, "hstack: row counts differ")
			n += B.cols
		end
		local o = matrix(m, n)
		local at = 0
		for _, B in list do
			buffer.copy(o.data, at, B.data)
			at += buffer.len(B.data)
		end
		return o
	end

	-- [A1; A2; ...]: the matrices stacked vertically (equal column counts).
	function ext.vstack(list: { Matrix }): Matrix
		assert(#list > 0, "vstack needs at least one matrix")
		local m, n = 0, list[1].cols
		for _, B in list do
			assert(B.cols == n, "vstack: column counts differ")
			m += B.rows
		end
		local o = matrix(m, n)
		local row = 1
		for _, B in list do
			ext.setsubmatrix(o, row, 1, B)
			row += B.rows
		end
		return o
	end

	-- The numerical rank of A from the SVD F: singular values above tol * s_1 (default
	-- tol = max(rows, cols) * eps, as for svd_solve).
	local function svd_rank(F: Svd, m: number, n: number, tol: number?): number
		local k = math.min(m, n)
		if k == 0 then
			return 0
		end
		local s = F.values
		local limit = (tol or math.max(m, n) * EPS) * buffer.readf32(s, 0)
		local r = 0
		while r < k and buffer.readf32(s, 4 * r) > limit do
			r += 1
		end
		return r
	end

	-- The numerical rank (see svd_rank for tol).
	function ext.rank(A: Matrix, tol: number?): number
		return svd_rank(svd_copy(A, false), A.rows, A.cols, tol)
	end

	-- An orthonormal basis of the range of A (rows by rank), from the SVD.
	function ext.orth(A: Matrix, tol: number?): Matrix
		local m, n = A.rows, A.cols
		local F = svd_copy(A)
		local r = svd_rank(F, m, n, tol)
		local U = F.u :: Matrix
		local o = matrix(m, r)
		buffer.copy(o.data, 0, U.data, 0, ENTRY * m * r)
		return o
	end

	-- An orthonormal basis of the null space of A (cols by cols - rank): the orthogonal
	-- complement of the first rank right singular vectors, completed through the full Q
	-- of their QR factorization.
	function ext.null_space(A: Matrix, tol: number?): Matrix
		local m, n = A.rows, A.cols
		local F = svd_copy(A)
		local r = svd_rank(F, m, n, tol)
		local N = matrix(n, n - r)
		if r == 0 then
			for j = 0, n - 1 do
				buffer.writef32(N.data, ENTRY * (j * n + j), 1)
			end
			return N
		end
		local Vr = matrix(n, r)
		buffer.copy(Vr.data, 0, (F.v :: Matrix).data, 0, ENTRY * n * r)
		local Q = qr(Vr)
		for j = r + 1, n do
			local e = ext.unit(n, j)
			qr_apply_q(Q, e)
			buffer.copy(N.data, ENTRY * (j - r - 1) * n, e)
		end
		return N
	end

	-- The condition number in the given norm (see matnorm): kind 2 (the default) is
	-- s_max / s_min from the SVD, for any shape (inf if rank deficient); kinds 1, "inf"
	-- and "fro" use the inverse of a square A (inf if singular).
	function ext.cond(A: Matrix, kind: (number | string)?): number
		local k = kind or 2
		if k == 2 then
			local q = math.min(A.rows, A.cols)
			if q == 0 then
				return 0
			end
			local s = svd_copy(A, false).values
			local smin = buffer.readf32(s, 4 * (q - 1))
			return if smin == 0 then math.huge else buffer.readf32(s, 0) / smin
		end
		assert(A.rows == A.cols, "cond: this norm needs a square matrix")
		local F = lu_copy(A)
		if F.singular then
			return math.huge
		end
		return ext.matnorm(A, k) * ext.matnorm(inv_copy(A), k)
	end

	-- An estimate of the reciprocal condition number 1 / (|A|_1 |A^-1|_1) from the LU
	-- factorization, in O(n^2) after it (LAPACK's gecon): |A^-1|_1 by Hager's method
	-- with Higham's refinements, which is almost always within a factor of 3 and never an
	-- overestimate. Returns 0 for a singular matrix. A is not modified.
	function ext.rcond(A: Matrix): number
		local n = A.rows
		assert(A.cols == n, "rcond needs a square matrix")
		if n == 0 then
			return math.huge
		end
		local anorm = ext.matnorm(A, 1)
		local F = lu_copy(A)
		if F.singular or anorm == 0 then
			return 0
		end
		-- Hager: maximize |A^-1 x|_1 over |x|_1 = 1 by a few gradient steps.
		local x = buffer.create(ENTRY * n)
		for i = 0, n - 1 do
			buffer.writef32(x, ENTRY * i, 1 / n)
		end
		local est, last = 0, 0
		for iter = 1, 5 do
			local y = lu_solve(nil, F, x)
			est = math.max(est, ext.asum(y))
			if iter > 1 and est <= last then
				break
			end
			last = est
			local z = ext.lu_solve_adjoint(nil, F, ext.signs(y))
			local zmax, j = ext.argmax(z)
			if iter > 1 and zmax <= ext.rdot(z, x) then
				break
			end
			x = ext.unit(n, j)
		end
		-- Higham's extra vector x_i = (-1)^i (1 + i / (n - 1)) guards against the cases
		-- where the gradient steps stall.
		local alt = buffer.create(buffer.len(x))
		for i = 0, n - 1 do
			buffer.writef32(alt, ENTRY * i, (if i % 2 == 0 then 1 else -1) * (1 + (if n > 1 then i / (n - 1) else 0)))
		end
		est = math.max(est, 2 * ext.asum(lu_solve(nil, F, alt)) / (3 * n))
		return 1 / (anorm * est)
	end

	-- Padé coefficients b_0 .. b_m of exp, and the 1-norm thresholds theta_m below which
	-- the [m/m] approximant is accurate to unit roundoff (Higham 2005; single precision
	-- uses its own thresholds and stops at m = 7).
	local PADE: { [number]: { number } } = {
		[3] = { 120, 60, 12, 1 },
		[5] = { 30240, 15120, 3360, 420, 30, 1 },
		[7] = { 17297280, 8648640, 1995840, 277200, 25200, 1512, 56, 1 },
		[9] = { 17643225600, 8821612800, 2075673600, 302702400, 30270240, 2162160, 110880, 3960, 90, 1 },
		[13] = {
			64764752532480000,
			32382376266240000,
			7771770303897600,
			1187353796428800,
			129060195264000,
			10559470521600,
			670442572800,
			33522128640,
			1323241920,
			40840800,
			960960,
			16380,
			182,
			1,
		},
	}
	local THETA: { { number } } = if EPS > 1e-10
		then { { 3, 4.258730016922831e-1 }, { 5, 1.880152677804762 }, { 7, 3.925724783138660 } }
		else {
			{ 3, 1.495585217958292e-2 },
			{ 5, 2.539398330063230e-1 },
			{ 7, 9.504178996162932e-1 },
			{ 9, 2.097847961257068 },
			{ 13, 5.371920351148152 },
		}

	-- The [m/m] Padé approximant r_m(A) = (V - U)^-1 (V + U), U odd and V even in A.
	local function pade(A: Matrix, m: number): Matrix
		local n = A.rows
		local b = PADE[m]
		local I = identity(n)
		local A2 = matmul(nil, A, A)
		local U: Matrix, V: Matrix
		if m < 13 then
			local us, vs = scale(nil, b[2], I.data), scale(nil, b[1], I.data)
			local P = A2
			for k = 1, (m - 1) // 2 do
				us = axpy(us, b[2 * k + 2], P.data, us)
				vs = axpy(vs, b[2 * k + 1], P.data, vs)
				if k < (m - 1) // 2 then
					P = matmul(nil, P, A2)
				end
			end
			local W = matrix(n, n)
			W.data = us
			U = matmul(nil, A, W)
			V = matrix(n, n)
			V.data = vs
		else
			local A4 = matmul(nil, A2, A2)
			local A6 = matmul(nil, A4, A2)
			local function combo(c6: number, c4: number, c2: number, c0: number): Matrix
				local M = matrix(n, n)
				local d = scale(nil, c6, A6.data)
				d = axpy(d, c4, A4.data, d)
				d = axpy(d, c2, A2.data, d)
				M.data = axpy(d, c0, I.data, d)
				return M
			end
			local inner = combo(b[14], b[12], b[10], 0)
			local W = matmul(nil, A6, inner)
			W.data = axpy(W.data, 1, combo(b[8], b[6], b[4], b[2]).data, W.data)
			U = matmul(nil, A, W)
			V = matmul(nil, A6, combo(b[13], b[11], b[9], 0))
			V.data = axpy(V.data, 1, combo(b[7], b[5], b[3], b[1]).data, V.data)
		end
		local P, Q = matrix(n, n), matrix(n, n)
		P.data = add(nil, V.data, U.data)
		Q.data = sub(nil, V.data, U.data)
		return solve(nil, Q, P)
	end

	-- The matrix exponential, by scaling and squaring with Padé approximants (Higham
	-- 2005): the smallest degree m in {3, 5, 7, 9, 13} whose threshold covers |A|_1, or
	-- else degree 13 on A / 2^s, squared s times. A is not modified; NaN or infinite
	-- entries give a NaN result.
	function ext.expm(A: Matrix): Matrix
		local n = A.rows
		assert(A.cols == n, "expm needs a square matrix")
		local reals = buffer.len(A.data) // 4
		if any_nonfinite(A.data, 0, reals) then
			local X = matrix(n, n)
			fill_nan(X.data, 0, reals)
			return X
		end
		if n == 0 then
			return matrix(0, 0)
		end
		local a = ext.matnorm(A, 1)
		for _, mt in THETA do
			if a <= mt[2] then
				return pade(A, mt[1])
			end
		end
		local top = THETA[#THETA]
		local s = math.max(0, math.ceil(math.log(a / top[2], 2)))
		local As = matrix(n, n)
		As.data = scale(nil, 2 ^ -s, A.data)
		local X = pade(As, top[1])
		for _ = 1, s do
			X = matmul(nil, X, X)
		end
		return X
	end
end

-- Matrix square root and logarithm of a real matrix by the Schur method, computed in the
-- complex module (on the complex Schur form) and returned as real matrices.

do
	-- The complex Schur form of a copy of A, after checking the eigenvalues with bad,
	-- which gets (re, im) and says whether the function has no real principal value there.
	local function schur_for(A: Matrix, bad: (number, number) -> boolean, message: string): (Matrix, Matrix)
		assert(A.rows == A.cols, "needs a square matrix")
		local S = matcopy(nil, A)
		local Z, wr, wi = schur_impl(S, true, true)
		for k = 1, #wr do
			assert(not bad(wr[k], wi[k]), message)
		end
		return to_complex_schur(S, Z :: Matrix, wr, wi)
	end

	local function back(Zc: Matrix, F: Matrix): Matrix
		local n = Zc.rows
		local X = complexmod.matmul(nil, complexmod.matmul(nil, Zc, F), complexmod.adjoint(nil, Zc))
		local out = matrix(n, n)
		out.data = complexmod.real(nil, X.data)
		return out
	end

	-- The principal square root of A (X^2 = A, eigenvalues in the right half plane). It is
	-- real unless A has a negative eigenvalue, which is an error here (use the complex
	-- module). A is not modified.
	function ext.sqrtm(A: Matrix): Matrix
		local T, Zc = schur_for(A, function(re: number, im: number): boolean
			return im == 0 and re < 0
		end, "sqrtm: a negative eigenvalue means no real principal square root; use the complex module")
		return back(Zc, complexmod.sqrtm_triangular(T))
	end

	-- The principal logarithm of A. It is real unless A has an eigenvalue on the closed
	-- negative real axis (a singular A has none at all), which is an error here (use the
	-- complex module for negative eigenvalues). A is not modified.
	function ext.logm(A: Matrix): Matrix
		local T, Zc = schur_for(A, function(re: number, im: number): boolean
			return im == 0 and re <= 0
		end, "logm: an eigenvalue on the closed negative real axis means no real principal logarithm")
		return back(Zc, complexmod.logm_triangular(T))
	end
end

-- The Hermitian-definite generalized eigenproblem (shared by the real and complex
-- modules).

do
	-- The columns of the triangular solve T X = B, one right-hand side at a time.
	local function tri_solve_matrix(T: Matrix, B: Matrix, uplo: Uplo): Matrix
		local n = B.rows
		local X = matrix(n, B.cols)
		local col = buffer.create(ENTRY * n)
		for j = 0, B.cols - 1 do
			buffer.copy(col, 0, B.data, ENTRY * j * n, ENTRY * n)
			buffer.copy(X.data, ENTRY * j * n, ext.triangular_solve(nil, T, col, uplo))
		end
		return X
	end

	-- Eigenvalues (ascending) and, unless vectors is false, eigenvectors of A x = lambda B x
	-- for Hermitian A and Hermitian positive definite B (LAPACK's sygv): with B = L L^H it
	-- solves the standard problem for C = L^-1 A L^-H and maps the vectors back by
	-- x = L^-H y, so they are B-orthonormal (X^H B X = I). A must be Hermitian (both
	-- triangles are read); only B's lower triangle is read. In place: B is overwritten with
	-- its Cholesky factor and A with the eigenvectors (or workspace). An error if B is not
	-- positive definite. eigh_gen_copy leaves both unchanged.
	function ext.eigh_gen(A: Matrix, B: Matrix, vectors: boolean?): Eigh
		local n = A.rows
		assert(A.cols == n and B.rows == n and B.cols == n, "eigh_gen needs square matrices of one size")
		local F = chol(B)
		assert(F.definite, "eigh_gen: B must be positive definite")
		local L = chol_l(nil, F)
		local W = tri_solve_matrix(L, A, "lower")
		local C = tri_solve_matrix(L, conj_transpose(nil, W), "lower")
		C.data = scale(nil, 0.5, add(nil, C.data, conj_transpose(nil, C).data))
		local E = eigh(C, vectors)
		if E.vectors then
			local X = tri_solve_matrix(conj_transpose(nil, L), E.vectors, "upper")
			buffer.copy(A.data, 0, X.data)
			return { values = E.values, vectors = A }
		end
		return { values = E.values, vectors = nil }
	end

	-- The generalized problem on copies; A and B are not modified.
	function ext.eigh_gen_copy(A: Matrix, B: Matrix, vectors: boolean?): Eigh
		return ext.eigh_gen(matcopy(nil, A), matcopy(nil, B), vectors)
	end
end

-- General generalized eigenvalues and Sylvester equations for real matrices, computed in
-- the complex module.

do
	local function complexified(A: Matrix): Matrix
		local Z = complexmod.matrix(A.rows, A.cols)
		Z.data = complexmod.complexify(A.data)
		return Z
	end

	-- Generalized eigenvalues and eigenvectors of A x = lambda B x (see the complex
	-- module's eig_gen, whose QZ algorithm runs on complex copies; values, alpha, beta and
	-- vectors are complex). Complex eigenvalues come in conjugate pairs only up to
	-- rounding. A and B are not modified, so eig_gen_copy is the same function.
	function ext.eig_gen(A: Matrix, B: Matrix, vectors: boolean?): GenEig
		return complexmod.eig_gen(complexified(A), complexified(B), vectors)
	end
	ext.eig_gen_copy = ext.eig_gen

	-- The solution X of A X + X B = C (see the complex module's sylvester; the solution of
	-- a real equation is real). Nothing is modified.
	function ext.sylvester(A: Matrix, B: Matrix, C: Matrix): Matrix
		local X = complexmod.sylvester(complexified(A), complexified(B), complexified(C))
		local out = matrix(X.rows, X.cols)
		out.data = complexmod.real(nil, X.data)
		return out
	end

	-- The solution X of the continuous Lyapunov equation A X + X A^T = Q.
	function ext.lyapunov(A: Matrix, Q: Matrix): Matrix
		return ext.sylvester(A, transpose(nil, A), Q)
	end
end

-- Updating factorizations, and the randomized SVD (shared by the real and complex modules;
-- written in complex arithmetic through ext.eget and ext.eset, which keep only the real
-- part in the real modules, where every rotation below comes out real).

do
	type RsvdOptions = { oversample: number?, power: number?, seed: number? }

	local eget, eset = ext.eget, ext.eset

	-- A rotation (c real, s complex) with [c s; -conj(s) c] [f; g] = [r; 0]; also r.
	local function rotation(fr: number, fi: number, gr: number, gi: number): (number, number, number, number, number)
		if gr == 0 and gi == 0 then
			return 1, 0, 0, fr, fi
		end
		local nf = complex64.abs(fr, fi)
		if nf == 0 then
			return 0, 1, 0, gr, gi
		end
		local r = hypot3(nf, complex64.abs(gr, gi), 0)
		local ur, ui = fr / nf, fi / nf
		return nf / r, (ur * gr + ui * gi) / r, (ui * gr - ur * gi) / r, ur * r, ui * r
	end

	-- Rows i and j (0-based) of M, columns c0..: (x, y) := (c x + s y, -conj(s) x + c y).
	local function rows(M: Matrix, i: number, j: number, c0: number, c: number, sr: number, si: number)
		local m = M.rows
		for col = math.max(c0, 0), M.cols - 1 do
			local xr, xi = eget(M.data, col * m + i)
			local yr, yi = eget(M.data, col * m + j)
			eset(M.data, col * m + i, c * xr + sr * yr - si * yi, c * xi + sr * yi + si * yr)
			eset(M.data, col * m + j, -(sr * xr + si * xi) + c * yr, -(sr * xi - si * xr) + c * yi)
		end
	end

	-- Q := Q G^H for that rotation on rows i, j: columns i, j of Q become
	-- (c q_i + conj(s) q_j, -s q_i + c q_j).
	local function qcols(Q: Matrix, i: number, j: number, c: number, sr: number, si: number)
		local m = Q.rows
		for row = 0, m - 1 do
			local xr, xi = eget(Q.data, i * m + row)
			local yr, yi = eget(Q.data, j * m + row)
			eset(Q.data, i * m + row, c * xr + sr * yr + si * yi, c * xi + sr * yi - si * yr)
			eset(Q.data, j * m + row, -(sr * xr - si * xi) + c * yr, -(sr * xi + si * xr) + c * yi)
		end
	end

	-- Rotations on rows (k, k+1) for k = from..to, zeroing R(k+1, k): back to upper
	-- triangular from upper Hessenberg in those columns.
	local function retriangularize(Q: Matrix, R: Matrix, from: number, to: number)
		local m = R.rows
		for k = from, to do
			local ar, ai = eget(R.data, k * m + k)
			local br, bi = eget(R.data, k * m + k + 1)
			local c, sr, si = rotation(ar, ai, br, bi)
			rows(R, k, k + 1, k, c, sr, si)
			eset(R.data, k * m + k + 1, 0, 0)
			qcols(Q, k, k + 1, c, sr, si)
		end
	end

	-- The full QR factorization A = Q R as explicit matrices: Q (rows by rows) unitary and
	-- R (rows by cols) upper triangular, the form the update functions below work on. A is
	-- not modified.
	function ext.qr_full(A: Matrix): QRFull
		local m, n = A.rows, A.cols
		local F = qr_copy(A)
		local Q = matrix(m, m)
		for j = 1, m do
			local e = ext.unit(m, j)
			qr_apply_q(F, e)
			buffer.copy(Q.data, ENTRY * (j - 1) * m, e)
		end
		local R = matrix(m, n)
		local k = math.min(m, n)
		local Rk = qr_r(nil, F)
		for j = 0, n - 1 do
			buffer.copy(R.data, ENTRY * j * m, Rk.data, ENTRY * j * k, ENTRY * k)
		end
		return { q = Q, r = R }
	end

	-- The rank-one update A + u v^H = Q' R', in place on F = qr_full(A) (Golub and Van Loan
	-- 6.5.1): rotations take Q^H u to a multiple of e_1, making R upper Hessenberg; the
	-- update then changes only R's first row, and rotations restore the triangle. O(m^2 +
	-- m n). Returns F.
	function ext.qr_update(F: QRFull, u: buffer, v: buffer): QRFull
		local Q, R = F.q, F.r
		local m, n = R.rows, R.cols
		assert(length(u) == m and length(v) == n, "qr_update: sizes do not match")
		local w = ext.matvec_adjoint(nil, Q, u)
		for k = m - 1, 1, -1 do
			local ar, ai = eget(w, k - 1)
			local br, bi = eget(w, k)
			local c, sr, si, rr, ri = rotation(ar, ai, br, bi)
			eset(w, k - 1, rr, ri)
			eset(w, k, 0, 0)
			rows(R, k - 1, k, k - 1, c, sr, si)
			qcols(Q, k - 1, k, c, sr, si)
		end
		-- R(0, :) += w_0 conj(v)^T
		local w0r, w0i = eget(w, 0)
		for j = 0, n - 1 do
			local vr, vi = eget(v, j)
			local rr, ri = eget(R.data, j * m)
			eset(R.data, j * m, rr + w0r * vr + w0i * vi, ri + w0i * vr - w0r * vi)
		end
		retriangularize(Q, R, 0, math.min(m - 1, n) - 1)
		return F
	end

	-- Removes column j (1-based) from the factored matrix: R loses that column, which leaves
	-- it upper Hessenberg from column j on, and rotations restore the triangle. Q is updated
	-- in place; F.r is replaced. Returns F.
	function ext.qr_delete_col(F: QRFull, j: number): QRFull
		local Q, R = F.q, F.r
		local m, n = R.rows, R.cols
		assert(j >= 1 and j <= n, "qr_delete_col: column out of range")
		local Rn = matrix(m, n - 1)
		if j > 1 then
			buffer.copy(Rn.data, 0, R.data, 0, ENTRY * m * (j - 1))
		end
		if j < n then
			buffer.copy(Rn.data, ENTRY * m * (j - 1), R.data, ENTRY * m * j, ENTRY * m * (n - j))
		end
		retriangularize(Q, Rn, j - 1, math.min(m - 1, n - 1) - 1)
		F.r = Rn
		return F
	end

	-- Inserts x as column j (1-based; j = cols + 1 appends) of the factored matrix: the new
	-- column of R is Q^H x, whose entries below row j are rotated away from the bottom up.
	-- Q is updated in place; F.r is replaced. Returns F.
	function ext.qr_insert_col(F: QRFull, j: number, x: buffer): QRFull
		local Q, R = F.q, F.r
		local m, n = R.rows, R.cols
		assert(j >= 1 and j <= n + 1, "qr_insert_col: position out of range")
		assert(length(x) == m, "qr_insert_col: the column has the wrong length")
		local Rn = matrix(m, n + 1)
		if j > 1 then
			buffer.copy(Rn.data, 0, R.data, 0, ENTRY * m * (j - 1))
		end
		buffer.copy(Rn.data, ENTRY * m * (j - 1), ext.matvec_adjoint(nil, Q, x))
		if j <= n then
			buffer.copy(Rn.data, ENTRY * m * j, R.data, ENTRY * m * (j - 1), ENTRY * m * (n - j + 1))
		end
		local jj = j - 1
		for k = m - 1, jj + 1, -1 do
			local ar, ai = eget(Rn.data, jj * m + k - 1)
			local br, bi = eget(Rn.data, jj * m + k)
			local c, sr, si = rotation(ar, ai, br, bi)
			rows(Rn, k - 1, k, jj, c, sr, si)
			eset(Rn.data, jj * m + k, 0, 0)
			qcols(Q, k - 1, k, c, sr, si)
		end
		F.r = Rn
		return F
	end

	-- The rank-one update A + x x^H of a Cholesky factorization F = chol(A), in place on
	-- F.chol's lower triangle (LINPACK's chud): one rotation per column, O(n^2). x is not
	-- modified. Returns F.
	function ext.chol_update(F: Cholesky, x: buffer): Cholesky
		local L = F.chol
		local n = L.rows
		assert(F.definite, "chol_update needs a positive definite factorization")
		assert(length(x) == n, "chol_update: sizes do not match")
		local w = copy(nil, x)
		for k = 0, n - 1 do
			local lkk = eget(L.data, k * n + k)
			local xr, xi = eget(w, k)
			local r = hypot3(lkk, xr, xi)
			local c, sr, si = lkk / r, xr / r, xi / r
			eset(L.data, k * n + k, r, 0)
			for i = k + 1, n - 1 do
				local lr, li = eget(L.data, k * n + i)
				local yr, yi = eget(w, i)
				-- l := c l + conj(s) y; y := -s l + c y
				eset(L.data, k * n + i, c * lr + sr * yr + si * yi, c * li + sr * yi - si * yr)
				eset(w, i, -(sr * lr - si * li) + c * yr, -(sr * li + si * lr) + c * yi)
			end
		end
		return F
	end

	-- The rank-one downdate A - x x^H of a Cholesky factorization F = chol(A), in place
	-- (LINPACK's chdd, with hyperbolic rotations). An error, leaving F unchanged, if
	-- A - x x^H is not positive definite. x is not modified. Returns F.
	function ext.chol_downdate(F: Cholesky, x: buffer): Cholesky
		local L = F.chol
		local n = L.rows
		assert(F.definite, "chol_downdate needs a positive definite factorization")
		assert(length(x) == n, "chol_downdate: sizes do not match")
		local work = copy(nil, L.data)
		local w = copy(nil, x)
		for k = 0, n - 1 do
			local lkk = eget(work, k * n + k)
			local xr, xi = eget(w, k)
			local d = lkk * lkk - (xr * xr + xi * xi)
			assert(d > 0, "chol_downdate: the result is not positive definite")
			local r = math.sqrt(d)
			local c, sr, si = r / lkk, xr / lkk, xi / lkk
			eset(work, k * n + k, r, 0)
			for i = k + 1, n - 1 do
				local lr, li = eget(work, k * n + i)
				local yr, yi = eget(w, i)
				-- l := (l - conj(s) y) / c; y := c y - s l
				local nr, ni = (lr - (sr * yr + si * yi)) / c, (li - (sr * yi - si * yr)) / c
				eset(work, k * n + i, nr, ni)
				eset(w, i, c * yr - (sr * nr - si * ni), c * yi - (sr * ni + si * nr))
			end
		end
		buffer.copy(L.data, 0, work)
		return F
	end

	-- A rank-k approximation A ~ U diag(values) V^H by the randomized SVD (Halko, Martinsson
	-- and Tropp 2011): an orthonormal basis Q of the range of A Omega for a Gaussian Omega
	-- with k + options.oversample (default 10) columns, refined by options.power (default
	-- 2) power iterations (each re-orthonormalized), then the SVD of the small Q^H A.
	-- options.seed seeds math.random (the global generator) for reproducible results.
	-- Accurate when the singular values decay; the power iterations help when they decay
	-- slowly. A is not modified.
	function ext.rsvd(A: Matrix, k: number, options: RsvdOptions?): Svd
		local o: RsvdOptions = options or {}
		local m, n = A.rows, A.cols
		local kk = math.min(k, m, n)
		local l = math.min(kk + (o.oversample or 10), m, n)
		if o.seed then
			math.randomseed(o.seed)
		end
		local Omega = matrix(n, l)
		local reals = buffer.len(Omega.data) // 4
		for i = 0, reals - 1 do
			-- Box-Muller: a standard normal from two uniforms.
			local u1 = math.max(math.random(), 1e-300)
			buffer.writef32(Omega.data, 4 * i, math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * math.random()))
		end
		local Ah = conj_transpose(nil, A)
		local Q = qr_q(nil, qr(matmul(nil, A, Omega)))
		for _ = 1, o.power or 2 do
			local Z = qr_q(nil, qr(matmul(nil, Ah, Q)))
			Q = qr_q(nil, qr(matmul(nil, A, Z)))
		end
		local B = matmul(nil, conj_transpose(nil, Q), A)
		local S = svd(B)
		local U = matmul(nil, Q, S.u :: Matrix)
		local values = buffer.create(4 * kk)
		buffer.copy(values, 0, S.values, 0, 4 * kk)
		local Uk, Vk = matrix(m, kk), matrix(n, kk)
		buffer.copy(Uk.data, 0, U.data, 0, ENTRY * m * kk)
		buffer.copy(Vk.data, 0, (S.v :: Matrix).data, 0, ENTRY * n * kk)
		return { values = values, u = Uk, v = Vk }
	end
end

-- The complex extension of the space, for GMRES and BiCGSTAB: real data never produces a
-- nonzero imaginary coefficient, so one is rejected.
local function space_cdot(x: buffer, y: buffer): (number, number)
	return dot(x, y), 0
end

local function space_cscale(out: buffer, ar: number, ai: number, x: buffer): buffer
	assert(ai == 0, "complex coefficient on a real space")
	return scale(out, ar, x)
end

local function space_caxpy(out: buffer, ar: number, ai: number, x: buffer, y: buffer): buffer
	assert(ai == 0, "complex coefficient on a real space")
	return axpy(out, ar, x, y)
end

