					buffer.writef32(c, o8 + 4 * 1, alpha * s1_8 + beta * buffer.readf32(c, o8 + 4 * 1))
					buffer.writef32(c, o8 + 4 * 2, alpha * s2_8 + beta * buffer.readf32(c, o8 + 4 * 2))
