					buffer.writef32(c, o8 + 4 * 7, alpha * s7_8 + beta * buffer.readf32(c, o8 + 4 * 7))
					buffer.writef32(c, o9, alpha * s0_9 + beta * buffer.readf32(c, o9))
					buffer.writef32(c, o9 + 4 * 1, alpha * s1_9 + beta * buffer.readf32(c, o9 + 4 * 1))
					buffer.writef32(c, o9 + 4 * 2, alpha * s2_9 + beta * buffer.readf32(c, o9 + 4 * 2))
					buffer.writef32(c, o9 + 4 * 3, alpha * s3_9 + beta * buffer.readf32(c, o9 + 4 * 3))
					buffer.writef32(c, o9 + 4 * 4, alpha * s4_9 + beta * buffer.readf32(c, o9 + 4 * 4))
					buffer.writef32(c, o9 + 4 * 5, alpha * s5_9 + beta * buffer.readf32(c, o9 + 4 * 5))
					buffer.writef32(c, o9 + 4 * 6, alpha * s6_9 + beta * buffer.readf32(c, o9 + 4 * 6))
					buffer.writef32(c, o9 + 4 * 7, alpha * s7_9 + beta * buffer.readf32(c, o9 + 4 * 7))
					buffer.writef32(c, o10, alpha * s0_10 + beta * buffer.readf32(c, o10))
					buffer.writef32(c, o10 + 4 * 1, alpha * s1_10 + beta * buffer.readf32(c, o10 + 4 * 1))
					buffer.writef32(c, o10 + 4 * 2, alpha * s2_10 + beta * buffer.readf32(c, o10 + 4 * 2))
					buffer.writef32(c, o10 + 4 * 3, alpha * s3_10 + beta * buffer.readf32(c, o10 + 4 * 3))
					buffer.writef32(c, o10 + 4 * 4, alpha * s4_10 + beta * buffer.readf32(c, o10 + 4 * 4))
					buffer.writef32(c, o10 + 4 * 5, alpha * s5_10 + beta * buffer.readf32(c, o10 + 4 * 5))
					buffer.writef32(c, o10 + 4 * 6, alpha * s6_10 + beta * buffer.readf32(c, o10 + 4 * 6))
					buffer.writef32(c, o10 + 4 * 7, alpha * s7_10 + beta * buffer.readf32(c, o10 + 4 * 7))
					buffer.writef32(c, o11, alpha * s0_11 + beta * buffer.readf32(c, o11))
					buffer.writef32(c, o11 + 4 * 1, alpha * s1_11 + beta * buffer.readf32(c, o11 + 4 * 1))
					buffer.writef32(c, o11 + 4 * 2, alpha * s2_11 + beta * buffer.readf32(c, o11 + 4 * 2))
					buffer.writef32(c, o11 + 4 * 3, alpha * s3_11 + beta * buffer.readf32(c, o11 + 4 * 3))
					buffer.writef32(c, o11 + 4 * 4, alpha * s4_11 + beta * buffer.readf32(c, o11 + 4 * 4))
					buffer.writef32(c, o11 + 4 * 5, alpha * s5_11 + beta * buffer.readf32(c, o11 + 4 * 5))
					buffer.writef32(c, o11 + 4 * 6, alpha * s6_11 + beta * buffer.readf32(c, o11 + 4 * 6))
					buffer.writef32(c, o11 + 4 * 7, alpha * s7_11 + beta * buffer.readf32(c, o11 + 4 * 7))
					buffer.writef32(c, o12, alpha * s0_12 + beta * buffer.readf32(c, o12))
					buffer.writef32(c, o12 + 4 * 1, alpha * s1_12 + beta * buffer.readf32(c, o12 + 4 * 1))
					buffer.writef32(c, o12 + 4 * 2, alpha * s2_12 + beta * buffer.readf32(c, o12 + 4 * 2))
					buffer.writef32(c, o12 + 4 * 3, alpha * s3_12 + beta * buffer.readf32(c, o12 + 4 * 3))
					buffer.writef32(c, o12 + 4 * 4, alpha * s4_12 + beta * buffer.readf32(c, o12 + 4 * 4))
					buffer.writef32(c, o12 + 4 * 5, alpha * s5_12 + beta * buffer.readf32(c, o12 + 4 * 5))
					buffer.writef32(c, o12 + 4 * 6, alpha * s6_12 + beta * buffer.readf32(c, o12 + 4 * 6))
					buffer.writef32(c, o12 + 4 * 7, alpha * s7_12 + beta * buffer.readf32(c, o12 + 4 * 7))
					buffer.writef32(c, o13, alpha * s0_13 + beta * buffer.readf32(c, o13))
					buffer.writef32(c, o13 + 4 * 1, alpha * s1_13 + beta * buffer.readf32(c, o13 + 4 * 1))
					buffer.writef32(c, o13 + 4 * 2, alpha * s2_13 + beta * buffer.readf32(c, o13 + 4 * 2))
					buffer.writef32(c, o13 + 4 * 3, alpha * s3_13 + beta * buffer.readf32(c, o13 + 4 * 3))
					buffer.writef32(c, o13 + 4 * 4, alpha * s4_13 + beta * buffer.readf32(c, o13 + 4 * 4))
					buffer.writef32(c, o13 + 4 * 5, alpha * s5_13 + beta * buffer.readf32(c, o13 + 4 * 5))
					buffer.writef32(c, o13 + 4 * 6, alpha * s6_13 + beta * buffer.readf32(c, o13 + 4 * 6))
					buffer.writef32(c, o13 + 4 * 7, alpha * s7_13 + beta * buffer.readf32(c, o13 + 4 * 7))
					buffer.writef32(c, o14, alpha * s0_14 + beta * buffer.readf32(c, o14))
					buffer.writef32(c, o14 + 4 * 1, alpha * s1_14 + beta * buffer.readf32(c, o14 + 4 * 1))
					buffer.writef32(c, o14 + 4 * 2, alpha * s2_14 + beta * buffer.readf32(c, o14 + 4 * 2))
					buffer.writef32(c, o14 + 4 * 3, alpha * s3_14 + beta * buffer.readf32(c, o14 + 4 * 3))
					buffer.writef32(c, o14 + 4 * 4, alpha * s4_14 + beta * buffer.readf32(c, o14 + 4 * 4))
					buffer.writef32(c, o14 + 4 * 5, alpha * s5_14 + beta * buffer.readf32(c, o14 + 4 * 5))
					buffer.writef32(c, o14 + 4 * 6, alpha * s6_14 + beta * buffer.readf32(c, o14 + 4 * 6))
					buffer.writef32(c, o14 + 4 * 7, alpha * s7_14 + beta * buffer.readf32(c, o14 + 4 * 7))
					buffer.writef32(c, o15, alpha * s0_15 + beta * buffer.readf32(c, o15))
					buffer.writef32(c, o15 + 4 * 1, alpha * s1_15 + beta * buffer.readf32(c, o15 + 4 * 1))
					buffer.writef32(c, o15 + 4 * 2, alpha * s2_15 + beta * buffer.readf32(c, o15 + 4 * 2))
					buffer.writef32(c, o15 + 4 * 3, alpha * s3_15 + beta * buffer.readf32(c, o15 + 4 * 3))
					buffer.writef32(c, o15 + 4 * 4, alpha * s4_15 + beta * buffer.readf32(c, o15 + 4 * 4))
					buffer.writef32(c, o15 + 4 * 5, alpha * s5_15 + beta * buffer.readf32(c, o15 + 4 * 5))
					buffer.writef32(c, o15 + 4 * 6, alpha * s6_15 + beta * buffer.readf32(c, o15 + 4 * 6))
					buffer.writef32(c, o15 + 4 * 7, alpha * s7_15 + beta * buffer.readf32(c, o15 + 4 * 7))
				end
			end
		end
	end

	local function small(R: buffer, Q: buffer, c: buffer, m: number, p: number, i0: number, i1: number, j0: number, j1: number, alpha: number, beta: number)
		for j = j0, j1 - 4, 4 do
			local q0 = 4 * (j + 0) * p; local q1 = 4 * (j + 1) * p; local q2 = 4 * (j + 2) * p; local q3 = 4 * (j + 3) * p
			for i = i0, i1 - 4, 4 do
				local r0 = 4 * (i + 0) * p; local r1 = 4 * (i + 1) * p; local r2 = 4 * (i + 2) * p; local r3 = 4 * (i + 3) * p
				local s0_0, s0_1, s0_2, s0_3 = 0, 0, 0, 0
				local s1_0, s1_1, s1_2, s1_3 = 0, 0, 0, 0
				local s2_0, s2_1, s2_2, s2_3 = 0, 0, 0, 0
				local s3_0, s3_1, s3_2, s3_3 = 0, 0, 0, 0
				for k = 0, 4 * (p - 1), 4 do
					local x0 = buffer.readf32(R, r0 + k); local x1 = buffer.readf32(R, r1 + k); local x2 = buffer.readf32(R, r2 + k); local x3 = buffer.readf32(R, r3 + k)
					local y0 = buffer.readf32(Q, q0 + k); local y1 = buffer.readf32(Q, q1 + k); local y2 = buffer.readf32(Q, q2 + k); local y3 = buffer.readf32(Q, q3 + k)
					s0_0 += x0 * y0; s0_1 += x0 * y1; s0_2 += x0 * y2; s0_3 += x0 * y3
					s1_0 += x1 * y0; s1_1 += x1 * y1; s1_2 += x1 * y2; s1_3 += x1 * y3
					s2_0 += x2 * y0; s2_1 += x2 * y1; s2_2 += x2 * y2; s2_3 += x2 * y3
					s3_0 += x3 * y0; s3_1 += x3 * y1; s3_2 += x3 * y2; s3_3 += x3 * y3
				end
				local o0 = 4 * ((j + 0) * m + i)
				local o1 = 4 * ((j + 1) * m + i)
				local o2 = 4 * ((j + 2) * m + i)
				local o3 = 4 * ((j + 3) * m + i)
				if beta == 0 then
					buffer.writef32(c, o0 + 0, alpha * s0_0); buffer.writef32(c, o0 + 4 * 1, alpha * s1_0); buffer.writef32(c, o0 + 4 * 2, alpha * s2_0); buffer.writef32(c, o0 + 4 * 3, alpha * s3_0)
					buffer.writef32(c, o1 + 0, alpha * s0_1); buffer.writef32(c, o1 + 4 * 1, alpha * s1_1); buffer.writef32(c, o1 + 4 * 2, alpha * s2_1); buffer.writef32(c, o1 + 4 * 3, alpha * s3_1)
					buffer.writef32(c, o2 + 0, alpha * s0_2); buffer.writef32(c, o2 + 4 * 1, alpha * s1_2); buffer.writef32(c, o2 + 4 * 2, alpha * s2_2); buffer.writef32(c, o2 + 4 * 3, alpha * s3_2)
					buffer.writef32(c, o3 + 0, alpha * s0_3); buffer.writef32(c, o3 + 4 * 1, alpha * s1_3); buffer.writef32(c, o3 + 4 * 2, alpha * s2_3); buffer.writef32(c, o3 + 4 * 3, alpha * s3_3)
				else
					buffer.writef32(c, o0, alpha * s0_0 + beta * buffer.readf32(c, o0))
					buffer.writef32(c, o0 + 4 * 1, alpha * s1_0 + beta * buffer.readf32(c, o0 + 4 * 1))
					buffer.writef32(c, o0 + 4 * 2, alpha * s2_0 + beta * buffer.readf32(c, o0 + 4 * 2))
					buffer.writef32(c, o0 + 4 * 3, alpha * s3_0 + beta * buffer.readf32(c, o0 + 4 * 3))
					buffer.writef32(c, o1, alpha * s0_1 + beta * buffer.readf32(c, o1))
					buffer.writef32(c, o1 + 4 * 1, alpha * s1_1 + beta * buffer.readf32(c, o1 + 4 * 1))
					buffer.writef32(c, o1 + 4 * 2, alpha * s2_1 + beta * buffer.readf32(c, o1 + 4 * 2))
					buffer.writef32(c, o1 + 4 * 3, alpha * s3_1 + beta * buffer.readf32(c, o1 + 4 * 3))
					buffer.writef32(c, o2, alpha * s0_2 + beta * buffer.readf32(c, o2))
					buffer.writef32(c, o2 + 4 * 1, alpha * s1_2 + beta * buffer.readf32(c, o2 + 4 * 1))
					buffer.writef32(c, o2 + 4 * 2, alpha * s2_2 + beta * buffer.readf32(c, o2 + 4 * 2))
					buffer.writef32(c, o2 + 4 * 3, alpha * s3_2 + beta * buffer.readf32(c, o2 + 4 * 3))
					buffer.writef32(c, o3, alpha * s0_3 + beta * buffer.readf32(c, o3))
					buffer.writef32(c, o3 + 4 * 1, alpha * s1_3 + beta * buffer.readf32(c, o3 + 4 * 1))
					buffer.writef32(c, o3 + 4 * 2, alpha * s2_3 + beta * buffer.readf32(c, o3 + 4 * 2))
					buffer.writef32(c, o3 + 4 * 3, alpha * s3_3 + beta * buffer.readf32(c, o3 + 4 * 3))
				end
			end
		end
	end

	local function single(R: buffer, Q: buffer, c: buffer, m: number, p: number, i0: number, i1: number, j0: number, j1: number, alpha: number, beta: number)
		for j = j0, j1 - 1 do
			for i = i0, i1 - 1 do
				local s = 0
				local r, q = 4 * i * p, 4 * j * p
				for k = 0, 4 * (p - 1), 4 do
					s += buffer.readf32(R, r + k) * buffer.readf32(Q, q + k)
				end
				local o = 4 * (j * m + i)
				buffer.writef32(c, o, if beta == 0 then alpha * s else alpha * s + beta * buffer.readf32(c, o))
			end
		end
	end

	-- Cover rows i0 .. i1 - 1 and columns j0 .. j1 - 1: 8 by 16 blocks, then 4 by 4
	-- blocks over what is left, then single entries.
	function gemm_kernel(R: buffer, Q: buffer, c: buffer, m: number, p: number, n: number, alpha: number, beta: number)
		local mb, nb = m - m % 8, n - n % 16
		big(R, Q, c, m, p, 0, mb, 0, nb, alpha, beta)
		-- The right strip (all rows) and the bottom strip (the big blocks' columns).
		local function rest(i0: number, i1: number, j0: number, j1: number)
			if i1 <= i0 or j1 <= j0 then
				return
			end
			local i4 = i0 + (i1 - i0) - (i1 - i0) % 4
			local j4 = j0 + (j1 - j0) - (j1 - j0) % 4
			small(R, Q, c, m, p, i0, i4, j0, j4, alpha, beta)
			single(R, Q, c, m, p, i4, i1, j0, j4, alpha, beta)
			single(R, Q, c, m, p, i0, i1, j4, j1, alpha, beta)
		end
		rest(0, m, nb, n)
		rest(mb, m, 0, nb)
	end
end

-- The rows of A (m by p, column-major) laid out contiguously: element i * p + k is A[i, k].
local function pack_rows(A: Matrix): buffer
	local m, p = A.rows, A.cols
	local a = A.data
	local R = buffer.create(4 * m * p)
	for k = 0, p - 1 do
		for i = 0, m - 1 do
			buffer.writef32(R, 4 * (i * p + k), buffer.readf32(a, 4 * (k * m + i)))
		end
	end
	return R
end

-- out := A B (a new matrix if out is nil); see gemm for scaled and transposed products.
local function matmul(out: Matrix?, A: Matrix, B: Matrix): Matrix
	local m, p, n = A.rows, A.cols, B.cols
	assert(B.rows == p, "matrix sizes do not match")
	local o = matoutput(out, m, n)
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	-- B's columns are already contiguous; A's rows are packed.
	gemm_kernel(pack_rows(A), B.data, o.data, m, p, n, 1, 0)
	return o
end

-- C := alpha op(A) op(B) + beta C (BLAS gemm), where op is "n" (as is), "t" or "c"
-- (transposed; the same for real matrices). C is new (or out) when beta is 0 or nil.
-- Sums run in double precision and each entry is rounded once.
local function gemm(C: Matrix?, alpha: number, A: Matrix, B: Matrix, beta: number?, opa: string?, opb: string?): Matrix
	local ta, tb = opa ~= nil and opa ~= "n", opb ~= nil and opb ~= "n"
	local m, kk = if ta then A.cols else A.rows, if ta then A.rows else A.cols
	local kb, n = if tb then B.cols else B.rows, if tb then B.rows else B.cols
	assert(kk == kb, "gemm: inner dimensions do not match")
	local b0 = beta or 0
	local o: Matrix
	if b0 == 0 then
		o = matoutput(C, m, n)
	else
		assert(C ~= nil and C.rows == m and C.cols == n, "gemm: beta needs a C of the right shape")
		o = C
	end
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	-- The kernel wants op(A)'s rows and op(B)'s columns contiguous: A^T's rows are A's
	-- columns and B's columns are as stored; the others are packed.
	local R = if ta then A.data else pack_rows(A)
	local Q = if tb then pack_rows(B) else B.data
	gemm_kernel(R, Q, o.data, m, kk, n, alpha, b0)
	return o
end

return {
	gemm = gemm,
	matmul = matmul,
}
