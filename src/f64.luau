--!strict
--!native
--!optimize 2
-- Generated by tools/generate.py from templates/real.luau.in. Edit the template, not this file.

-- Double-precision real arrays (buffers of 8-byte floats) and column-major matrices.
-- Indices are 1-based. Arithmetic is done in double precision and rounded once per
-- stored value. Every `out` argument may be nil, in which case a new result is allocated.

local types = require("./types")

export type Matrix = types.Matrix
export type LU = types.LU
export type QR = types.QR
export type QRP = types.QRP
export type Cholesky = types.Cholesky
export type Form = types.Form

-- Arrays

local function create(n: number): buffer
	return buffer.create(8 * n)
end

local function length(x: buffer): number
	return buffer.len(x) // 8
end

local function similar(x: buffer): buffer
	return buffer.create(buffer.len(x))
end

local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

local function check_same(x: buffer, y: buffer)
	assert(buffer.len(x) == buffer.len(y), "arrays have different lengths")
end

local function from(t: { number }): buffer
	local x = buffer.create(8 * #t)
	for i = 1, #t do
		buffer.writef64(x, 8 * (i - 1), t[i])
	end
	return x
end

local function totable(x: buffer): { number }
	local n = length(x)
	local t = table.create(n, 0)
	for i = 1, n do
		t[i] = buffer.readf64(x, 8 * (i - 1))
	end
	return t
end

local function get(x: buffer, i: number): number
	return buffer.readf64(x, 8 * (i - 1))
end

local function set(x: buffer, i: number, v: number)
	buffer.writef64(x, 8 * (i - 1), v)
end

local function fill(out: buffer, v: number): buffer
	for k = 0, buffer.len(out) - 8, 8 do
		buffer.writef64(out, k, v)
	end
	return out
end

local function copy(out: buffer?, x: buffer): buffer
	local o = output(out, buffer.len(x))
	if o ~= x then
		buffer.copy(o, 0, x)
	end
	return o
end

local function add(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef64(o, k, buffer.readf64(x, k) + buffer.readf64(y, k))
	end
	return o
end

local function sub(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef64(o, k, buffer.readf64(x, k) - buffer.readf64(y, k))
	end
	return o
end

-- Elementwise (Hadamard) product.
local function mul(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef64(o, k, buffer.readf64(x, k) * buffer.readf64(y, k))
	end
	return o
end

local function scale(out: buffer?, a: number, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef64(o, k, a * buffer.readf64(x, k))
	end
	return o
end

-- a * x + y
local function axpy(out: buffer?, a: number, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef64(o, k, a * buffer.readf64(x, k) + buffer.readf64(y, k))
	end
	return o
end

local function dot(x: buffer, y: buffer): number
	check_same(x, y)
	local s = 0
	for k = 0, buffer.len(x) - 8, 8 do
		s += buffer.readf64(x, k) * buffer.readf64(y, k)
	end
	return s
end

local function sum(x: buffer): number
	local s = 0
	for k = 0, buffer.len(x) - 8, 8 do
		s += buffer.readf64(x, k)
	end
	return s
end

-- Largest absolute value (NaN if any element is NaN, 0 for an empty array).
local function amax(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - 8, 8 do
		local a = math.abs(buffer.readf64(x, k))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	return m
end

-- Euclidean norm of `count` consecutive reals starting at byte offset `start`. The plain
-- sum of squares is used unless it overflowed or may have lost digits to underflow; then
-- the values are rescaled by the largest magnitude. NaN if any value is NaN.
local function segment_norm(x: buffer, start: number, count: number): number
	local stop = start + 8 * (count - 1)
	local s = 0
	for k = start, stop, 8 do
		local v = buffer.readf64(x, k)
		s += v * v
	end
	if s > 2 ^ -500 and s < math.huge then
		return math.sqrt(s)
	end
	local m = 0
	for k = start, stop, 8 do
		local a = math.abs(buffer.readf64(x, k))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	if m == 0 or m == math.huge then
		return m
	end
	s = 0
	for k = start, stop, 8 do
		local v = buffer.readf64(x, k) / m
		s += v * v
	end
	return m * math.sqrt(s)
end

-- sqrt(a^2 + b^2 + c^2) without overflow or underflow.
local function hypot3(a: number, b: number, c: number): number
	a, b, c = math.abs(a), math.abs(b), math.abs(c)
	local m = math.max(a, b, c)
	if m == 0 or m == math.huge or m ~= m then
		return m
	end
	a, b, c = a / m, b / m, c / m
	return m * math.sqrt(a * a + b * b + c * c)
end

-- Euclidean norm, without overflow or underflow.
local function norm(x: buffer): number
	return segment_norm(x, 0, length(x))
end

-- Matrices

local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(8 * rows * cols) }
end

local function matoutput(out: Matrix?, rows: number, cols: number): Matrix
	if out == nil then
		return matrix(rows, cols)
	end
	assert(out.rows == rows and out.cols == cols, "output has the wrong shape")
	return out
end

-- Builds a matrix from a table of rows.
local function matfrom(t: { { number } }): Matrix
	local rows = #t
	local cols = if rows > 0 then #t[1] else 0
	local A = matrix(rows, cols)
	for i = 1, rows do
		local row = t[i]
		assert(#row == cols, "rows have different lengths")
		for j = 1, cols do
			buffer.writef64(A.data, 8 * ((j - 1) * rows + i - 1), row[j])
		end
	end
	return A
end

-- Returns a table of rows.
local function mattotable(A: Matrix): { { number } }
	local t = table.create(A.rows) :: { { number } }
	for i = 1, A.rows do
		local row = table.create(A.cols, 0)
		for j = 1, A.cols do
			row[j] = buffer.readf64(A.data, 8 * ((j - 1) * A.rows + i - 1))
		end
		t[i] = row
	end
	return t
end

local function identity(n: number): Matrix
	local A = matrix(n, n)
	for i = 0, n - 1 do
		buffer.writef64(A.data, 8 * (i * n + i), 1)
	end
	return A
end

local function matget(A: Matrix, i: number, j: number): number
	return buffer.readf64(A.data, 8 * ((j - 1) * A.rows + i - 1))
end

local function matset(A: Matrix, i: number, j: number, v: number)
	buffer.writef64(A.data, 8 * ((j - 1) * A.rows + i - 1), v)
end

local function matcopy(out: Matrix?, A: Matrix): Matrix
	local o = matoutput(out, A.rows, A.cols)
	if o.data ~= A.data then
		buffer.copy(o.data, 0, A.data)
	end
	return o
end

local function transpose(out: Matrix?, A: Matrix): Matrix
	local m, n = A.rows, A.cols
	local o = matoutput(out, n, m)
	assert(o.data ~= A.data, "transpose cannot be done in place")
	local a, d = A.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			buffer.writef64(d, 8 * (i * n + j), buffer.readf64(a, 8 * (j * m + i)))
		end
	end
	return o
end

-- A x
local function matvec(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(buffer.len(x) == 8 * n, "matrix and vector sizes do not match")
	local o = output(out, 8 * m)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, m - 1 do
		local s = 0
		for j = 0, n - 1 do
			s += buffer.readf64(a, 8 * (j * m + i)) * buffer.readf64(x, 8 * j)
		end
		buffer.writef64(o, 8 * i, s)
	end
	return o
end

-- A B
local function matmul(out: Matrix?, A: Matrix, B: Matrix): Matrix
	local m, p, n = A.rows, A.cols, B.cols
	assert(B.rows == p, "matrix sizes do not match")
	local o = matoutput(out, m, n)
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	local a, b, c = A.data, B.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local s = 0
			for k = 0, p - 1 do
				s += buffer.readf64(a, 8 * (k * m + i)) * buffer.readf64(b, 8 * (j * p + k))
			end
			buffer.writef64(c, 8 * (j * m + i), s)
		end
	end
	return o
end

-- LU factorization with partial pivoting, in place: A is overwritten with L and U (see
-- types.LU) and returned as F.lu. lu_copy leaves A unchanged.
local function lu(A: Matrix): LU
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local piv = table.create(n, 0)
	local sign = 1
	local singular = false
	for k = 0, n - 1 do
		local p, best = k, -1
		for i = k, n - 1 do
			local v = math.abs(buffer.readf64(a, 8 * (k * n + i)))
			if v > best then
				p, best = i, v
			end
		end
		piv[k + 1] = p + 1
		if p ~= k then
			sign = -sign
			for j = 0, n - 1 do
				local s, t = 8 * (j * n + k), 8 * (j * n + p)
				local tmp = buffer.readf64(a, s)
				buffer.writef64(a, s, buffer.readf64(a, t))
				buffer.writef64(a, t, tmp)
			end
		end
		local pivot = buffer.readf64(a, 8 * (k * n + k))
		if pivot == 0 then
			singular = true
		else
			for i = k + 1, n - 1 do
				local off = 8 * (k * n + i)
				buffer.writef64(a, off, buffer.readf64(a, off) / pivot)
			end
			for j = k + 1, n - 1 do
				local akj = buffer.readf64(a, 8 * (j * n + k))
				for i = k + 1, n - 1 do
					local off = 8 * (j * n + i)
					buffer.writef64(a, off, buffer.readf64(a, off) - buffer.readf64(a, 8 * (k * n + i)) * akj)
				end
			end
		end
	end
	return { lu = A, piv = piv, sign = sign, singular = singular }
end

-- LU factorization of a copy of A; A is not modified.
local function lu_copy(A: Matrix): LU
	return lu(matcopy(nil, A))
end

-- Solves A x = b given F = lu(A).
local function lu_solve(out: buffer?, F: LU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.lu.rows
	assert(buffer.len(b) == 8 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a, piv = F.lu.data, F.piv
	for k = 0, n - 1 do
		local p = piv[k + 1] - 1
		if p ~= k then
			local tmp = buffer.readf64(o, 8 * k)
			buffer.writef64(o, 8 * k, buffer.readf64(o, 8 * p))
			buffer.writef64(o, 8 * p, tmp)
		end
	end
	for j = 0, n - 1 do
		local xj = buffer.readf64(o, 8 * j)
		for i = j + 1, n - 1 do
			local off = 8 * i
			buffer.writef64(o, off, buffer.readf64(o, off) - buffer.readf64(a, 8 * (j * n + i)) * xj)
		end
	end
	for j = n - 1, 0, -1 do
		local xj = buffer.readf64(o, 8 * j) / buffer.readf64(a, 8 * (j * n + j))
		buffer.writef64(o, 8 * j, xj)
		for i = 0, j - 1 do
			local off = 8 * i
			buffer.writef64(o, off, buffer.readf64(o, off) - buffer.readf64(a, 8 * (j * n + i)) * xj)
		end
	end
	return o
end

local function det(A: Matrix): number
	local F = lu_copy(A)
	local d = F.sign
	local n = A.rows
	for k = 0, n - 1 do
		d *= buffer.readf64(F.lu.data, 8 * (k * n + k))
	end
	return d
end

-- Cholesky

-- Cholesky factorization A = L L^T of a symmetric positive definite matrix, in place:
-- the lower triangle of A is overwritten with L and returned as F.chol. Only the lower
-- triangle of A is read and the strictly upper triangle is left as it was. If A is not
-- positive definite, F.definite is false and A is partly overwritten. chol_copy leaves A
-- unchanged.
local function chol(A: Matrix): Cholesky
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	for j = 0, n - 1 do
		local d = buffer.readf64(a, 8 * (j * n + j))
		if not (d > 0) then
			return { chol = A, definite = false }
		end
		local ljj = math.sqrt(d)
		buffer.writef64(a, 8 * (j * n + j), ljj)
		for i = j + 1, n - 1 do
			local off = 8 * (j * n + i)
			buffer.writef64(a, off, buffer.readf64(a, off) / ljj)
		end
		-- Subtract the new column's outer product from the trailing lower triangle.
		for c = j + 1, n - 1 do
			local lc = buffer.readf64(a, 8 * (j * n + c))
			for i = c, n - 1 do
				local off = 8 * (c * n + i)
				buffer.writef64(a, off, buffer.readf64(a, off) - buffer.readf64(a, 8 * (j * n + i)) * lc)
			end
		end
	end
	return { chol = A, definite = true }
end

-- Cholesky factorization of a copy of A; A is not modified.
local function chol_copy(A: Matrix): Cholesky
	return chol(matcopy(nil, A))
end

-- The lower triangular factor L, with zeros above the diagonal.
local function chol_l(out: Matrix?, F: Cholesky): Matrix
	local n = F.chol.rows
	local o = matoutput(out, n, n)
	local a, l = F.chol.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = 8 * (j * n + i)
			buffer.writef64(l, off, if i >= j then buffer.readf64(a, off) else 0)
		end
	end
	return o
end

-- Solves A x = b given F = chol(A). b is not modified unless it is passed as out.
local function chol_solve(out: buffer?, F: Cholesky, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local n = F.chol.rows
	assert(buffer.len(b) == 8 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = F.chol.data
	-- L y = b
	for j = 0, n - 1 do
		local yj = buffer.readf64(o, 8 * j) / buffer.readf64(a, 8 * (j * n + j))
		buffer.writef64(o, 8 * j, yj)
		for i = j + 1, n - 1 do
			local off = 8 * i
			buffer.writef64(o, off, buffer.readf64(o, off) - buffer.readf64(a, 8 * (j * n + i)) * yj)
		end
	end
	-- L^T x = y, a dot product down each column of L.
	for j = n - 1, 0, -1 do
		local s = buffer.readf64(o, 8 * j)
		for i = j + 1, n - 1 do
			s -= buffer.readf64(a, 8 * (j * n + i)) * buffer.readf64(o, 8 * i)
		end
		buffer.writef64(o, 8 * j, s / buffer.readf64(a, 8 * (j * n + j)))
	end
	return o
end

-- Householder QR

-- Unit roundoff of the storage precision.
local EPS = 2 ^ -53

-- Applies I - t v v^T to the `len` values of x starting at byte offset `xs`. v starts at
-- byte offset `vs` of `a`; its first entry is an implicit 1.
local function reflect(a: buffer, vs: number, len: number, t: number, x: buffer, xs: number)
	local w = buffer.readf64(x, xs)
	for i = 1, len - 1 do
		w += buffer.readf64(a, vs + 8 * i) * buffer.readf64(x, xs + 8 * i)
	end
	if w == 0 then
		return
	end
	w *= t
	buffer.writef64(x, xs, buffer.readf64(x, xs) - w)
	for i = 1, len - 1 do
		local off = xs + 8 * i
		buffer.writef64(x, off, buffer.readf64(x, off) - w * buffer.readf64(a, vs + 8 * i))
	end
end

-- Turns the `len` values of `a` starting at byte offset `diag` into a Householder
-- reflector, in place: beta at `diag` and v below it (its leading 1 is implicit). Stores
-- tau as element k of `tau` and returns it; tau = 0 (H = I) when there is nothing to zero.
local function householder(a: buffer, diag: number, len: number, tau: buffer, k: number): number
	local alpha = buffer.readf64(a, diag)
	local xnorm = segment_norm(a, diag + 8, len - 1)
	if xnorm == 0 then
		buffer.writef64(tau, 8 * k, 0)
		return 0
	end
	local beta = hypot3(alpha, 0, xnorm)
	if alpha >= 0 then
		beta = -beta
	end
	buffer.writef64(tau, 8 * k, (beta - alpha) / beta)
	-- alpha and beta have opposite signs, so this cannot cancel.
	local d = alpha - beta
	for off = diag + 8, diag + 8 * (len - 1), 8 do
		buffer.writef64(a, off, buffer.readf64(a, off) / d)
	end
	buffer.writef64(a, diag, beta)
	return buffer.readf64(tau, 8 * k)
end

-- Solves R z = y in place on the first r entries of y, where R is the leading r by r
-- block of the upper triangle stored in `a` (a matrix with m rows).
local function back_substitute(a: buffer, m: number, r: number, y: buffer)
	for j = r - 1, 0, -1 do
		local rjj = buffer.readf64(a, 8 * (j * m + j))
		assert(rjj ~= 0, "matrix is rank deficient")
		local yj = buffer.readf64(y, 8 * j) / rjj
		buffer.writef64(y, 8 * j, yj)
		for i = 0, j - 1 do
			local off = 8 * i
			buffer.writef64(y, off, buffer.readf64(y, off) - buffer.readf64(a, 8 * (j * m + i)) * yj)
		end
	end
end

-- Householder QR factorization, in place: A is overwritten (see types.QR for the layout)
-- and returned as F.qr. qr_copy leaves A unchanged.
local function qr(A: Matrix): QR
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(8 * kmax)
	for k = 0, kmax - 1 do
		local diag = 8 * (k * m + k)
		local t = householder(a, diag, m - k, tau, k)
		if t ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, t, a, 8 * (j * m + k))
			end
		end
	end
	return { qr = A, tau = tau }
end

-- Householder QR factorization of a copy of A; A is not modified.
local function qr_copy(A: Matrix): QR
	return qr(matcopy(nil, A))
end

-- x := Q^T x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_qh(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == 8 * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = 0, buffer.len(tau) // 8 - 1 do
		reflect(a, 8 * (k * m + k), m - k, buffer.readf64(tau, 8 * k), x, 8 * k)
	end
	return x
end

-- x := Q x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_q(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == 8 * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = buffer.len(tau) // 8 - 1, 0, -1 do
		reflect(a, 8 * (k * m + k), m - k, buffer.readf64(tau, 8 * k), x, 8 * k)
	end
	return x
end

-- The min(rows, cols) by cols upper triangular factor R. Also accepts a QRP factorization.
local function qr_r(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, kmax, n)
	local a, r = F.qr.data, o.data
	for j = 0, n - 1 do
		for i = 0, kmax - 1 do
			buffer.writef64(r, 8 * (j * kmax + i), if i <= j then buffer.readf64(a, 8 * (j * m + i)) else 0)
		end
	end
	return o
end

-- The rows by min(rows, cols) factor Q with orthonormal columns (the thin Q). Also
-- accepts a QRP factorization.
local function qr_q(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, m, kmax)
	local a, tau, q = F.qr.data, F.tau, o.data
	buffer.fill(q, 0, 0)
	for c = 0, kmax - 1 do
		buffer.writef64(q, 8 * (c * m + c), 1)
		-- Reflectors after column c leave the unit vector e_c unchanged.
		for k = c, 0, -1 do
			reflect(a, 8 * (k * m + k), m - k, buffer.readf64(tau, 8 * k), q, 8 * (c * m + k))
		end
	end
	return o
end

-- Least squares: the x minimizing |A x - b| for A with rows >= cols and full column
-- rank, given F = qr(A). b is not modified. Also returns the residual norm |A x - b|.
local function qr_solve(out: buffer?, F: QR, b: buffer): (buffer, number)
	local m, n = F.qr.rows, F.qr.cols
	assert(m >= n, "least squares needs at least as many rows as columns")
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, n, y)
	local o = output(out, 8 * n)
	buffer.copy(o, 0, y, 0, 8 * n)
	return o, segment_norm(y, 8 * n, m - n)
end

-- Column-pivoted QR

-- Householder QR with column pivoting, A P = Q R, in place: A is overwritten as in qr and
-- returned as F.qr; column j of A P is column perm[j] of A. Each step moves the remaining
-- column of largest norm to the front, so |R_11| >= |R_22| >= ... and small trailing
-- diagonal entries reveal the numerical rank. qrp_copy leaves A unchanged.
local function qrp(A: Matrix): QRP
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(8 * kmax)
	local perm = table.create(n, 0)
	-- Norms of the unfactored part of each column (partial), and the norm at the last
	-- recomputation (reference), for LAPACK's safeguarded downdating.
	local partial, reference = table.create(n, 0), table.create(n, 0)
	for j = 1, n do
		perm[j] = j
		local v = segment_norm(a, 8 * (j - 1) * m, m)
		partial[j], reference[j] = v, v
	end
	local recompute = math.sqrt(EPS)
	for k = 0, kmax - 1 do
		local p, best = k, -1
		for j = k, n - 1 do
			if partial[j + 1] > best then
				p, best = j, partial[j + 1]
			end
		end
		if p ~= k then
			for i = 0, m - 1 do
				local s, t = 8 * (k * m + i), 8 * (p * m + i)
				local tmp = buffer.readf64(a, s)
				buffer.writef64(a, s, buffer.readf64(a, t))
				buffer.writef64(a, t, tmp)
			end
			perm[k + 1], perm[p + 1] = perm[p + 1], perm[k + 1]
			partial[p + 1], reference[p + 1] = partial[k + 1], reference[k + 1]
		end

		local diag = 8 * (k * m + k)
		local t = householder(a, diag, m - k, tau, k)
		if t ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, t, a, 8 * (j * m + k))
			end
		end

		-- Remove row k from the remaining partial norms. When cancellation would leave too
		-- few correct digits, recompute the norm instead.
		for j = k + 1, n - 1 do
			local v = partial[j + 1]
			if v ~= 0 then
				local ratio = math.abs(buffer.readf64(a, 8 * (j * m + k))) / v
				local left = math.max(0, 1 - ratio * ratio)
				local drift = v / reference[j + 1]
				if left * drift * drift <= recompute then
					local fresh = segment_norm(a, 8 * (j * m + k + 1), m - k - 1)
					partial[j + 1], reference[j + 1] = fresh, fresh
				else
					partial[j + 1] = v * math.sqrt(left)
				end
			end
		end
	end
	return { qr = A, tau = tau, perm = perm }
end

-- Column-pivoted QR of a copy of A; A is not modified.
local function qrp_copy(A: Matrix): QRP
	return qrp(matcopy(nil, A))
end

-- Numerical rank: the number of leading diagonal entries of R with |R_kk| > tol |R_11|.
-- The default tol is max(rows, cols) times the unit roundoff of the storage precision.
local function qrp_rank(F: QRP, tol: number?): number
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	if kmax == 0 then
		return 0
	end
	local a = F.qr.data
	local limit = (tol or math.max(m, n) * EPS) * math.abs(buffer.readf64(a, 0))
	for k = 0, kmax - 1 do
		if not (math.abs(buffer.readf64(a, 8 * (k * m + k))) > limit) then
			return k
		end
	end
	return kmax
end

-- Least squares for any shape and rank, given F = qrp(A): the basic solution, which
-- uses only the first r = qrp_rank(F, tol) pivot columns and sets the other variables
-- to zero. b is not modified. Also returns the residual norm |A x - b| and r.
local function qrp_solve(out: buffer?, F: QRP, b: buffer, tol: number?): (buffer, number, number)
	local m, n = F.qr.rows, F.qr.cols
	local r = qrp_rank(F, tol)
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, r, y)
	local o = output(out, 8 * n)
	buffer.fill(o, 0, 0)
	for j = 1, r do
		buffer.writef64(o, 8 * (F.perm[j] - 1), buffer.readf64(y, 8 * (j - 1)))
	end
	return o, segment_norm(y, 8 * r, m - r), r
end

-- Solves A x = b. `form` says what A is:
--   "matrix" (or nil)  a matrix. Square: LU with partial pivoting. More rows than
--                      columns: the least-squares solution, by Householder QR. More
--                      columns than rows: the basic solution, by column-pivoted QR.
--   "lu"               a factorization from lu or lu_copy
--   "qr"               a factorization from qr or qr_copy (least squares if tall)
--   "qrp"              a factorization from qrp or qrp_copy (any shape or rank; see
--                      qrp_solve, whose default rank tolerance is used)
--   "chol"             a factorization from chol or chol_copy
-- Neither A nor b is modified.
local function solve(out: buffer?, A: Matrix | LU | QR | QRP | Cholesky, b: buffer, form: Form?): buffer
	local t = A :: any
	if form == "lu" then
		assert(type(t) == "table" and t.lu ~= nil, `solve: form "lu" needs a factorization from lu`)
		return lu_solve(out, A :: LU, b)
	elseif form == "qr" then
		assert(type(t) == "table" and t.qr ~= nil, `solve: form "qr" needs a factorization from qr`)
		assert(t.perm == nil, `solve: this is a pivoted factorization; use form "qrp"`)
		return (qr_solve(out, A :: QR, b))
	elseif form == "qrp" then
		assert(type(t) == "table" and t.perm ~= nil, `solve: form "qrp" needs a factorization from qrp`)
		return (qrp_solve(out, A :: QRP, b))
	elseif form == "chol" then
		assert(type(t) == "table" and t.chol ~= nil, `solve: form "chol" needs a factorization from chol`)
		return chol_solve(out, A :: Cholesky, b)
	end
	assert(form == nil or form == "matrix", `solve: unknown form {form}`)
	assert(type(t) == "table" and t.data ~= nil, "solve: A is not a matrix (pass its form)")
	local M = A :: Matrix
	if M.rows == M.cols then
		return lu_solve(out, lu_copy(M), b)
	elseif M.rows > M.cols then
		return (qr_solve(out, qr_copy(M), b))
	end
	return (qrp_solve(out, qrp_copy(M), b))
end

