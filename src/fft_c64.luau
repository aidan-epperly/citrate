--!strict
--!native
--!optimize 2
-- Generated by tools/generate.py from templates/complex/fft.luau.in. Edit the template, not this file.

-- Double-precision complex Fourier transforms and discrete cosine transforms.
-- Indices are 1-based; arithmetic is done in double precision and rounded once per stored
-- value; every `out` argument may be nil, in which case a new result is allocated.

local types = require("./types")
local array_part = require("./array_c64")
local copy = array_part.copy

-- Types and small helpers shared by the parts. They are copied into each part rather than
-- imported, so calls to them are inlined (a call into another module costs several times
-- more); the generator drops the ones a part does not use.

type Matrix = types.Matrix
type FFTPlan = types.FFTPlan

-- The number of (complex) elements of x.
local function length(x: buffer): number
	return buffer.len(x) // 16
end

-- exp(-2 pi i k / n) as (re, im). k is reduced mod n first, so the angle stays accurate
-- for large k.
local function root(k: number, n: number): (number, number)
	local a = -2 * math.pi * (k % n) / n
	return math.cos(a), math.sin(a)
end

local SQRT3_2 = math.sqrt(3) / 2
local C1, C2 = math.cos(2 * math.pi / 5), math.cos(4 * math.pi / 5)
local S1, S2 = math.sin(2 * math.pi / 5), math.sin(4 * math.pi / 5)

-- Plans by length. Weak values: a plan nobody holds may be collected and rebuilt later;
-- but the RECENT most recently used ones are also held here, so a length transformed
-- every frame keeps its plan through collections instead of rebuilding it after each.
local plan_cache: { [number]: FFTPlan } = setmetatable({}, { __mode = "v" }) :: any
local RECENT = 8
local recent: { FFTPlan } = {}
local function hold(plan: FFTPlan)
	if recent[1] == plan then
		return
	end
	local k = table.find(recent, plan) or math.min(#recent + 1, RECENT)
	for i = k, 2, -1 do
		recent[i] = recent[i - 1]
	end
	recent[1] = plan
end

-- Radices for the Stockham passes (4s, then 2s, then odd primes up to 13), or nil when a
-- larger prime factor makes Bluestein's algorithm the better choice.
local function radices_of(n: number): { number }?
	local r = {}
	while n % 4 == 0 do
		table.insert(r, 4)
		n //= 4
	end
	while n % 2 == 0 do
		table.insert(r, 2)
		n //= 2
	end
	local p = 3
	while n > 1 and p <= 13 do
		while n % p == 0 do
			table.insert(r, p)
			n //= p
		end
		p += 2
	end
	return if n == 1 then r else nil
end

-- One pass of the self-sorting (Stockham) decimation-in-frequency FFT. For the stage of
-- length L with radix p, m = L / p, and stride s:
--   dst[q + s (p j + k)] = w_L^(j k) sum_r src[q + s (j + r m)] w_p^(r k).
local function stockham_pass(src: buffer, dst: buffer, stage: any, s: number)
	local p, L, tw, wp = stage.p, stage.L, stage.tw, stage.wp
	local m = L // p
	local sE = 16 * s
	if p == 4 then
		for j = 0, m - 1 do
			local t = 8 * j
			local w1r, w1i, w2r, w2i, w3r, w3i = tw[t + 3], tw[t + 4], tw[t + 5], tw[t + 6], tw[t + 7], tw[t + 8]
			local i0, mE = 16 * (s * j), 16 * (s * m)
			local o0 = 16 * (s * 4 * j)
			for q = 0, s - 1 do
				local a = i0 + (16 * q)
				local a0r, a0i = buffer.readf64(src, a), buffer.readf64(src, a + 8) :: number
				local a1r, a1i = buffer.readf64(src, a + mE), buffer.readf64(src, (a + mE) + 8) :: number
				local a2r, a2i = buffer.readf64(src, a + 2 * mE), buffer.readf64(src, (a + 2 * mE) + 8) :: number
				local a3r, a3i = buffer.readf64(src, a + 3 * mE), buffer.readf64(src, (a + 3 * mE) + 8) :: number
				local t0r, t0i, t1r, t1i = a0r + a2r, a0i + a2i, a0r - a2r, a0i - a2i
				local t2r, t2i, t3r, t3i = a1r + a3r, a1i + a3i, a1r - a3r, a1i - a3i
				-- b1 = t1 - i t3, b3 = t1 + i t3
				local b1r, b1i = t1r + t3i, t1i - t3r
				local b2r, b2i = t0r - t2r, t0i - t2i
				local b3r, b3i = t1r - t3i, t1i + t3r
				local o = o0 + (16 * q)
				buffer.writef64(dst, o, t0r + t2r)
				buffer.writef64(dst, o + 8, t0i + t2i)
				do
					local here_ = o + sE
					buffer.writef64(dst, here_, b1r * w1r - b1i * w1i)
					buffer.writef64(dst, here_ + 8, b1r * w1i + b1i * w1r)
				end
				do
					local here_ = o + 2 * sE
					buffer.writef64(dst, here_, b2r * w2r - b2i * w2i)
					buffer.writef64(dst, here_ + 8, b2r * w2i + b2i * w2r)
				end
				do
					local here_ = o + 3 * sE
					buffer.writef64(dst, here_, b3r * w3r - b3i * w3i)
					buffer.writef64(dst, here_ + 8, b3r * w3i + b3i * w3r)
				end
			end
		end
	elseif p == 2 then
		for j = 0, m - 1 do
			local w1r, w1i = tw[4 * j + 3], tw[4 * j + 4]
			local i0, mE = 16 * (s * j), 16 * (s * m)
			local o0 = 16 * (s * 2 * j)
			for q = 0, s - 1 do
				local a = i0 + (16 * q)
				local a0r, a0i = buffer.readf64(src, a), buffer.readf64(src, a + 8) :: number
				local a1r, a1i = buffer.readf64(src, a + mE), buffer.readf64(src, (a + mE) + 8) :: number
				local br, bi = a0r - a1r, a0i - a1i
				local o = o0 + (16 * q)
				buffer.writef64(dst, o, a0r + a1r)
				buffer.writef64(dst, o + 8, a0i + a1i)
				do
					local here_ = o + sE
					buffer.writef64(dst, here_, br * w1r - bi * w1i)
					buffer.writef64(dst, here_ + 8, br * w1i + bi * w1r)
				end
			end
		end
	elseif p == 3 then
		for j = 0, m - 1 do
			local t = 6 * j
			local w1r, w1i, w2r, w2i = tw[t + 3], tw[t + 4], tw[t + 5], tw[t + 6]
			local i0, mE = 16 * (s * j), 16 * (s * m)
			local o0 = 16 * (s * 3 * j)
			for q = 0, s - 1 do
				local a = i0 + (16 * q)
				local a0r, a0i = buffer.readf64(src, a), buffer.readf64(src, a + 8) :: number
				local a1r, a1i = buffer.readf64(src, a + mE), buffer.readf64(src, (a + mE) + 8) :: number
				local a2r, a2i = buffer.readf64(src, a + 2 * mE), buffer.readf64(src, (a + 2 * mE) + 8) :: number
				local tr, ti = a1r + a2r, a1i + a2i
				local ur, ui = SQRT3_2 * (a1r - a2r), SQRT3_2 * (a1i - a2i)
				local cr, ci = a0r - 0.5 * tr, a0i - 0.5 * ti
				-- b1 = c - i u, b2 = c + i u
				local b1r, b1i = cr + ui, ci - ur
				local b2r, b2i = cr - ui, ci + ur
				local o = o0 + (16 * q)
				buffer.writef64(dst, o, a0r + tr)
				buffer.writef64(dst, o + 8, a0i + ti)
				do
					local here_ = o + sE
					buffer.writef64(dst, here_, b1r * w1r - b1i * w1i)
					buffer.writef64(dst, here_ + 8, b1r * w1i + b1i * w1r)
				end
				do
					local here_ = o + 2 * sE
					buffer.writef64(dst, here_, b2r * w2r - b2i * w2i)
					buffer.writef64(dst, here_ + 8, b2r * w2i + b2i * w2r)
				end
			end
		end
	elseif p == 5 then
		for j = 0, m - 1 do
			local t = 10 * j
			local w1r, w1i, w2r, w2i = tw[t + 3], tw[t + 4], tw[t + 5], tw[t + 6]
			local w3r, w3i, w4r, w4i = tw[t + 7], tw[t + 8], tw[t + 9], tw[t + 10]
			local i0, mE = 16 * (s * j), 16 * (s * m)
			local o0 = 16 * (s * 5 * j)
			for q = 0, s - 1 do
				local a = i0 + (16 * q)
				local a0r, a0i = buffer.readf64(src, a), buffer.readf64(src, a + 8) :: number
				local a1r, a1i = buffer.readf64(src, a + mE), buffer.readf64(src, (a + mE) + 8) :: number
				local a2r, a2i = buffer.readf64(src, a + 2 * mE), buffer.readf64(src, (a + 2 * mE) + 8) :: number
				local a3r, a3i = buffer.readf64(src, a + 3 * mE), buffer.readf64(src, (a + 3 * mE) + 8) :: number
				local a4r, a4i = buffer.readf64(src, a + 4 * mE), buffer.readf64(src, (a + 4 * mE) + 8) :: number
				local t1r, t1i, t2r, t2i = a1r + a4r, a1i + a4i, a2r + a3r, a2i + a3i
				local t3r, t3i, t4r, t4i = a1r - a4r, a1i - a4i, a2r - a3r, a2i - a3i
				local r1r, r1i = a0r + C1 * t1r + C2 * t2r, a0i + C1 * t1i + C2 * t2i
				local r2r, r2i = a0r + C2 * t1r + C1 * t2r, a0i + C2 * t1i + C1 * t2i
				local s1r, s1i = S1 * t3r + S2 * t4r, S1 * t3i + S2 * t4i
				local s2r, s2i = S2 * t3r - S1 * t4r, S2 * t3i - S1 * t4i
				-- b1 = r1 - i s1, b4 = r1 + i s1, b2 = r2 - i s2, b3 = r2 + i s2
				local b1r, b1i, b4r, b4i = r1r + s1i, r1i - s1r, r1r - s1i, r1i + s1r
				local b2r, b2i, b3r, b3i = r2r + s2i, r2i - s2r, r2r - s2i, r2i + s2r
				local o = o0 + (16 * q)
				buffer.writef64(dst, o, a0r + t1r + t2r)
				buffer.writef64(dst, o + 8, a0i + t1i + t2i)
				do
					local here_ = o + sE
					buffer.writef64(dst, here_, b1r * w1r - b1i * w1i)
					buffer.writef64(dst, here_ + 8, b1r * w1i + b1i * w1r)
				end
				do
					local here_ = o + 2 * sE
					buffer.writef64(dst, here_, b2r * w2r - b2i * w2i)
					buffer.writef64(dst, here_ + 8, b2r * w2i + b2i * w2r)
				end
				do
					local here_ = o + 3 * sE
					buffer.writef64(dst, here_, b3r * w3r - b3i * w3i)
					buffer.writef64(dst, here_ + 8, b3r * w3i + b3i * w3r)
				end
				do
					local here_ = o + 4 * sE
					buffer.writef64(dst, here_, b4r * w4r - b4i * w4i)
					buffer.writef64(dst, here_ + 8, b4r * w4i + b4i * w4r)
				end
			end
		end
	else
		-- Any other small prime: a direct p-point DFT.
		local ar, ai = table.create(p, 0), table.create(p, 0)
		for j = 0, m - 1 do
			local i0, mE = 16 * (s * j), 16 * (s * m)
			local o0 = 16 * (s * p * j)
			for q = 0, s - 1 do
				local a = i0 + (16 * q)
				for r = 0, p - 1 do
					ar[r + 1], ai[r + 1] = buffer.readf64(src, a + r * mE), buffer.readf64(src, (a + r * mE) + 8) :: number
				end
				local o = o0 + (16 * q)
				for k = 0, p - 1 do
					local br, bi = 0, 0
					for r = 0, p - 1 do
						local e = (r * k) % p
						local cr, ci = wp[2 * e + 1], wp[2 * e + 2]
						br += ar[r + 1] * cr - ai[r + 1] * ci
						bi += ar[r + 1] * ci + ai[r + 1] * cr
					end
					local wr, wi = tw[2 * (j * p + k) + 1], tw[2 * (j * p + k) + 2]
					do
						local here_ = o + k * sE
						buffer.writef64(dst, here_, br * wr - bi * wi)
						buffer.writef64(dst, here_ + 8, br * wi + bi * wr)
					end
				end
			end
		end
	end
end

local function conjugate_in_place(x: buffer)
	for k = 8, buffer.len(x) - 8, 16 do
		-- (k: the offset of an imaginary part)
		buffer.writef64(x, k, -buffer.readf64(x, k))
	end
end

local fft_plan: (n: number) -> FFTPlan

-- The unscaled forward transform of the length-n array x, in place.
local function transform(plan: FFTPlan, x: buffer)
	local n = plan.n
	if n <= 1 then
		return
	end
	local impl = plan.impl
	if impl.stages then
		local src, dst = x, impl.scratch
		local s = 1
		for _, stage in impl.stages do
			stockham_pass(src, dst, stage, s)
			src, dst = dst, src
			s *= stage.p
		end
		if src ~= x then
			buffer.copy(x, 0, src, 0, 16 * n)
		end
		return
	end
	-- Bluestein: X_k = c_k sum_j (x_j c_j) conj(c_(k-j)) with the chirp c_j = exp(-i pi j^2 / n),
	-- a circular convolution of length M >= 2n - 1 done with power-of-two FFTs.
	local B = impl.blue
	local M, w, chirp, bhat = B.M, B.work, B.chirp, B.bhat
	for j = 0, n - 1 do
		local xr, xi = buffer.readf64(x, 16 * j), buffer.readf64(x, (16 * j) + 8) :: number
		local cr, ci = chirp[2 * j + 1], chirp[2 * j + 2]
		do
			local here_ = 16 * j
			buffer.writef64(w, here_, xr * cr - xi * ci)
			buffer.writef64(w, here_ + 8, xr * ci + xi * cr)
		end
	end
	buffer.fill(w, 16 * n, 0, 16 * (M - n))
	transform(B.inner, w)
	for k = 0, M - 1 do
		local wr, wi = buffer.readf64(w, 16 * k), buffer.readf64(w, (16 * k) + 8) :: number
		local br, bi = bhat[2 * k + 1], bhat[2 * k + 2]
		-- conjugated, ready for the inverse transform
		do
			local here_ = 16 * k
			buffer.writef64(w, here_, wr * br - wi * bi)
			buffer.writef64(w, here_ + 8, -(wr * bi + wi * br))
		end
	end
	transform(B.inner, w)
	for k = 0, n - 1 do
		local wr, wi = buffer.readf64(w, 16 * k), buffer.readf64(w, (16 * k) + 8) :: number
		local vr, vi = wr / M, -wi / M
		local cr, ci = chirp[2 * k + 1], chirp[2 * k + 2]
		do
			local here_ = 16 * k
			buffer.writef64(x, here_, vr * cr - vi * ci)
			buffer.writef64(x, here_ + 8, vr * ci + vi * cr)
		end
	end
end

-- A reusable plan for transforms of length n: twiddle factors (computed in double
-- precision) and workspace. Lengths whose prime factors are all at most 13 use mixed-radix
-- Stockham passes; others use Bluestein's algorithm. fft and ifft make (and cache) plans
-- themselves when none is passed.
fft_plan = function(n: number): FFTPlan
	assert(n >= 0 and n % 1 == 0, "fft length must be a nonnegative integer")
	local cached = plan_cache[n]
	if cached then
		hold(cached)
		return cached
	end
	local impl: any = {}
	local radices = if n > 1 then radices_of(n) else nil
	if n <= 1 then
		impl.stages = {}
	elseif radices then
		impl.stages = {}
		local L = n
		for _, p in radices do
			local m = L // p
			local tw = table.create(2 * L, 0)
			for j = 0, m - 1 do
				for k = 0, p - 1 do
					tw[2 * (j * p + k) + 1], tw[2 * (j * p + k) + 2] = root(j * k, L)
				end
			end
			local wp = table.create(2 * p, 0)
			for t = 0, p - 1 do
				wp[2 * t + 1], wp[2 * t + 2] = root(t, p)
			end
			table.insert(impl.stages, { p = p, L = L, tw = tw, wp = wp })
			L = m
		end
		impl.scratch = buffer.create(16 * n)
	else
		local M = 1
		while M < 2 * n - 1 do
			M *= 2
		end
		local inner = fft_plan(M)
		local chirp = table.create(2 * n, 0)
		for j = 0, n - 1 do
			-- exp(-i pi j^2 / n), with j^2 reduced mod 2n
			chirp[2 * j + 1], chirp[2 * j + 2] = root((j * j) % (2 * n), 2 * n)
		end
		local b = buffer.create(16 * M)
		for j = 0, n - 1 do
			local cr, ci = chirp[2 * j + 1], -chirp[2 * j + 2]
			do
				local here_ = 16 * j
				buffer.writef64(b, here_, cr)
				buffer.writef64(b, here_ + 8, ci)
			end
			if j > 0 then
				do
					local here_ = 16 * (M - j)
					buffer.writef64(b, here_, cr)
					buffer.writef64(b, here_ + 8, ci)
				end
			end
		end
		transform(inner, b)
		local bhat = table.create(2 * M, 0)
		for k = 0, M - 1 do
			bhat[2 * k + 1], bhat[2 * k + 2] = buffer.readf64(b, 16 * k), buffer.readf64(b, (16 * k) + 8) :: number
		end
		impl.blue = { M = M, inner = inner, chirp = chirp, bhat = bhat, work = buffer.create(16 * M) }
	end
	local plan = { n = n, impl = impl }
	plan_cache[n] = plan
	hold(plan)
	return plan
end

local function plan_for(x: buffer, plan: FFTPlan?): FFTPlan
	local n = length(x)
	local p = plan or fft_plan(n)
	assert(p.n == n, "the plan is for a different length")
	return p
end

-- Discrete Fourier transform X_k = sum_j x_j exp(-2 pi i j k / n), in place. Returns x.
local function fft(x: buffer, plan: FFTPlan?): buffer
	transform(plan_for(x, plan), x)
	return x
end

-- Inverse transform x_j = (1/n) sum_k X_k exp(2 pi i j k / n), in place. Returns x.
local function ifft(x: buffer, plan: FFTPlan?): buffer
	local p = plan_for(x, plan)
	conjugate_in_place(x)
	transform(p, x)
	local n = p.n
	for k = 0, buffer.len(x) - 16, 16 do
		buffer.writef64(x, k, buffer.readf64(x, k) / n)
		buffer.writef64(x, k + 8, -buffer.readf64(x, k + 8) / n)
	end
	return x
end

-- fft of a copy of x; x is not modified.
local function fft_copy(x: buffer, plan: FFTPlan?): buffer
	return fft(copy(nil, x), plan)
end

-- ifft of a copy of x; x is not modified.
local function ifft_copy(x: buffer, plan: FFTPlan?): buffer
	return ifft(copy(nil, x), plan)
end

-- dst (cols by rows) = transpose of src (rows by cols), both column-major, in 32 by 32
-- tiles so both sides stay in cache.
local function transpose_into(dst: buffer, src: buffer, rows: number, cols: number)
	for j0 = 0, cols - 1, 32 do
		local j1 = math.min(j0 + 31, cols - 1)
		for i0 = 0, rows - 1, 32 do
			local i1 = math.min(i0 + 31, rows - 1)
			for j = j0, j1 do
				local s = 16 * (j * rows)
				local d = 16 * j
				for i = i0, i1 do
					local o, t = s + (16 * i), d + (16 * (i * cols))
					buffer.writef64(dst, t, buffer.readf64(src, o))
					buffer.writef64(dst, t + 8, buffer.readf64(src, o + 8))
				end
			end
		end
	end
end

-- Transforms every column, then every row, of A, in place. The rows are transformed as
-- the columns of the transpose, so every transform reads contiguous memory.
local function transform2(A: Matrix, f: (buffer, FFTPlan?) -> buffer): Matrix
	local m, n = A.rows, A.cols
	local a = A.data
	local function columns(data: buffer, len: number, count: number)
		local line = buffer.create(16 * len)
		local plan = fft_plan(len)
		for j = 0, count - 1 do
			buffer.copy(line, 0, data, 16 * (j * len), 16 * len)
			f(line, plan)
			buffer.copy(data, 16 * (j * len), line, 0, 16 * len)
		end
	end
	columns(a, m, n)
	if n > 1 then
		local t = buffer.create(16 * m * n)
		transpose_into(t, a, m, n)
		columns(t, n, m)
		transpose_into(a, t, n, m)
	end
	return A
end

-- Two-dimensional DFT of a matrix, in place. Returns A.
local function fft2(A: Matrix): Matrix
	return transform2(A, fft)
end

-- Inverse two-dimensional DFT of a matrix, in place. Returns A.
local function ifft2(A: Matrix): Matrix
	return transform2(A, ifft)
end

return {
	fft = fft,
	fft2 = fft2,
	fft_copy = fft_copy,
	fft_plan = fft_plan,
	ifft = ifft,
	ifft2 = ifft2,
	ifft_copy = ifft_copy,
}
