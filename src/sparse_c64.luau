		end
	end

	local function pj3(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = 16 * 3 * I, 144 * I
			local tr0, ti0, tr1, ti1, tr2, ti2 = buffer.readf64(r, base + 16 * 0), buffer.readf64(r, base + 16 * 0 + 8), buffer.readf64(r, base + 16 * 1), buffer.readf64(r, base + 16 * 1 + 8), buffer.readf64(r, base + 16 * 2), buffer.readf64(r, base + 16 * 2 + 8)
