				buffer.writef64(o, base + 16 * 0, ur)
				buffer.writef64(o, base + 16 * 0 + 8, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 16), buffer.readf64(inv, v + 24); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 80), buffer.readf64(inv, v + 88); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 144), buffer.readf64(inv, v + 152); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				do local ar, ai = buffer.readf64(inv, v + 208), buffer.readf64(inv, v + 216); ur += ar * tr3 - ai * ti3; ui += ar * ti3 + ai * tr3 end
				buffer.writef64(o, base + 16 * 1, ur)
				buffer.writef64(o, base + 16 * 1 + 8, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 32), buffer.readf64(inv, v + 40); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 96), buffer.readf64(inv, v + 104); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 160), buffer.readf64(inv, v + 168); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				do local ar, ai = buffer.readf64(inv, v + 224), buffer.readf64(inv, v + 232); ur += ar * tr3 - ai * ti3; ui += ar * ti3 + ai * tr3 end
				buffer.writef64(o, base + 16 * 2, ur)
				buffer.writef64(o, base + 16 * 2 + 8, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 48), buffer.readf64(inv, v + 56); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 112), buffer.readf64(inv, v + 120); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 176), buffer.readf64(inv, v + 184); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				do local ar, ai = buffer.readf64(inv, v + 240), buffer.readf64(inv, v + 248); ur += ar * tr3 - ai * ti3; ui += ar * ti3 + ai * tr3 end
				buffer.writef64(o, base + 16 * 3, ur)
				buffer.writef64(o, base + 16 * 3 + 8, ui)
			end
		end
	end

	spk.block[4] = { mv = mv4, mvt = mvt4, jacobi = pj4 }
end

-- S x, accumulated in double precision. A general S is applied column by column (a
-- scatter into a double accumulator); one marked hermitian as S^H x and one marked
-- symmetric as S^T x, gathers down its columns, about 10% faster still since each sum
-- stays in locals.
local function sparse_matvec(out: buffer?, S: Sparse, x: buffer): buffer
	assert(length(x) == S.cols, "matrix and vector sizes do not match")
	local o = output(out, 16 * S.rows)
	assert(o ~= x, "output cannot be the input vector")
	if S.hermitian then
		spk.gather(o, S, x, -1)
		return o
	elseif S.symmetric then
		spk.gather(o, S, x, 1)
		return o
	end
	local acc = if 8 == 8 then o else buffer.create(16 * S.rows)
	buffer.fill(acc, 0, 0)
	spk.scatter(acc, S, x)
	if acc ~= o then
		for i = 0, S.rows - 1 do
			do
				local here_ = 16 * i
				buffer.writef64(o, here_, buffer.readf64(acc, 16 * i))
				buffer.writef64(o, here_ + 8, buffer.readf64(acc, 16 * i + 8))
			end
		end
	end
	return o
end

-- S^H x.
local function sparse_matvec_adjoint(out: buffer?, S: Sparse, x: buffer): buffer
	assert(length(x) == S.rows, "matrix and vector sizes do not match")
	local o = output(out, 16 * S.cols)
	assert(o ~= x, "output cannot be the input vector")
	spk.gather(o, S, x, -1)
	return o
end

-- S B for a dense matrix B, as a dense matrix.
local function sparse_matmul(out: Matrix?, S: Sparse, B: Matrix): Matrix
	assert(B.rows == S.cols, "matrix sizes do not match")
	local o = matoutput(out, S.rows, B.cols)
	assert(o.data ~= B.data, "output cannot be an input")
	local col, res = create(S.cols), create(S.rows)
	for j = 0, B.cols - 1 do
		buffer.copy(col, 0, B.data, 16 * j * S.cols, 16 * S.cols)
		sparse_matvec(res, S, col)
		buffer.copy(o.data, 16 * j * S.rows, res, 0, 16 * S.rows)
	end
	return o
end

local function transpose_sparse(S: Sparse, sign: number): Sparse
	local colrows, colre, colim = empty_columns(S.rows)
	for j = 0, S.cols - 1 do
		for p = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local r = buffer.readu32(S.rowind, 4 * p) + 1
			local re, im = buffer.readf64(S.values, 16 * p), buffer.readf64(S.values, (16 * p) + 8) :: number
			table.insert(colrows[r], j)
			table.insert(colre[r], re)
			table.insert(colim[r], sign * im)
		end
	end
	local T = assemble(S.cols, S.rows, colrows, colre, colim)
	T.symmetric, T.hermitian = S.symmetric, S.hermitian
	return T
end

-- S^T.
local function sparse_transpose(S: Sparse): Sparse
	return transpose_sparse(S, 1)
end

-- S^H.
local function sparse_adjoint(S: Sparse): Sparse
	return transpose_sparse(S, -1)
end

-- Symmetric permutations of sparse matrices (values copied as bytes: `bytes` per entry).

-- The positions of a permutation: inv[perm[k]] = k (0-based positions, as a table).
local function perm_positions(perm: buffer, n: number): { number }
	assert(buffer.len(perm) == 4 * n, "the permutation must have one entry per row")
	local inv = table.create(n, -1)
	for k = 0, n - 1 do
		local v = buffer.readi32(perm, 4 * k)
		assert(v >= 1 and v <= n and inv[v] == -1, "not a permutation")
		inv[v] = k
	end
	return inv
end

local function permute_sparse(S: Sparse, perm: buffer, bytes: number): Sparse
	local n = S.rows
	assert(S.cols == n, "matrix must be square")
	local inv = perm_positions(perm, n)
	local nnz = buffer.readu32(S.colptr, 4 * n)
	local colptr = buffer.create(4 * (n + 1))
	local rowind = buffer.create(4 * nnz)
	local values = buffer.create(bytes * nnz)
	local rows, srcs = {}, {}
	local p = 0
	for l = 0, n - 1 do
		buffer.writeu32(colptr, 4 * l, p)
		-- column l of P A P^T is column perm[l] of A, rows renumbered, then sorted
		local j = buffer.readi32(perm, 4 * l) - 1
		local count = 0
		for q = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local r = inv[buffer.readu32(S.rowind, 4 * q) + 1]
			-- insertion sort: columns are short
			local k = count
			while k > 0 and rows[k] > r do
				rows[k + 1], srcs[k + 1] = rows[k], srcs[k]
				k -= 1
			end
			rows[k + 1], srcs[k + 1] = r, q
			count += 1
		end
		for k = 1, count do
			buffer.writeu32(rowind, 4 * p, rows[k])
			buffer.copy(values, bytes * p, S.values, bytes * srcs[k], bytes)
			p += 1
		end
	end
	buffer.writeu32(colptr, 4 * n, p)
	return { rows = n, cols = n, colptr = colptr, rowind = rowind, values = values, symmetric = S.symmetric, hermitian = S.hermitian }
end

local function symband_sparse(S: Sparse, perm: buffer?, into: SymBanded?, bytes: number): SymBanded
	local n = S.rows
	assert(S.cols == n, "matrix must be square")
	local inv: { number }? = if perm then perm_positions(perm, n) else nil
	-- the half bandwidth under perm
	local kd = 0
	for j = 0, n - 1 do
		local pj = if inv then inv[j + 1] else j
		for q = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local r = buffer.readu32(S.rowind, 4 * q)
			local pr = if inv then inv[r + 1] else r
			if pr - pj > kd then
				kd = pr - pj
			end
		end
	end
	local B: SymBanded
	if into and into.n == n and into.kd == kd then
		B = into
		buffer.fill(B.data, 0, 0)
	else
		B = { n = n, kd = kd, data = buffer.create(bytes * (kd + 1) * n) }
	end
	local d = B.data
	for j = 0, n - 1 do
		local pj = if inv then inv[j + 1] else j
		for q = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local r = buffer.readu32(S.rowind, 4 * q)
			local pr = if inv then inv[r + 1] else r
			if pr >= pj then
				buffer.copy(d, bytes * (pj * kd + pr), S.values, bytes * q, bytes)
			end
		end
	end
	return B
end

-- Sparse Cholesky factorization

-- The ordering of a sparse Cholesky factorization: "amd" (approximate minimum degree, the
-- default), "rcm" (reverse Cuthill-McKee), "natural", or a permutation.
local function chol_order(S: Sparse, order: (string | buffer)?): buffer
	if type(order) == "buffer" then
		assert(buffer.len(order) == 4 * S.cols, "sparse_chol: the order must have one entry per column")
		return order
	end
	local G = graph.of(S)
	if order == nil or order == "amd" then
		return graph.amd(G)
	elseif order == "rcm" then
		return graph.rcm(G)
	end
	assert(order == "natural", "sparse_chol: order must be \"amd\", \"rcm\", \"natural\" or a permutation")
	local p = buffer.create(4 * S.cols)
	for k = 0, S.cols - 1 do
		buffer.writei32(p, 4 * k, k + 1)
	end
	return p
end

-- The numeric factorization into L's values (see the real modules' chol_numeric), with
-- S = L L^H: each update is a set of products of rows of a block with conjugated rows.
-- Returns false if a pivot was not positive.
local function chol_numeric(sym: any, A: Sparse, L: buffer, work: any): boolean
	local ns = sym.nsuper
	local super, rowptr, rows, valptr, col2super, amap = sym.super, sym.rowptr, sym.rows, sym.valptr, sym.col2super, sym.amap
	buffer.fill(L, 0, 0)
	local Av = A.values
	for p = 0, buffer.readu32(A.colptr, 4 * A.cols) - 1 do
		local dst = buffer.readu32(amap, 4 * p)
		if dst ~= 0 then
			local o = 16 * (dst - 1)
			local ar, ai = buffer.readf64(L, o), buffer.readf64(L, o + 8) :: number
			local br, bi = buffer.readf64(Av, 16 * p), buffer.readf64(Av, (16 * p) + 8) :: number
			buffer.writef64(L, o, ar + br)
			buffer.writef64(L, o + 8, ai + bi)
		end
	end
	local rel, head, link, dpos = work.rel, work.head, work.link, work.dpos
	buffer.fill(head, 0, 255)
	for s = 0, ns - 1 do
		local c0: number = buffer.readu32(super, 4 * s)
		local K: number = buffer.readu32(super, 4 * (s + 1)) - c0
		local c1 = c0 + K
		local r0: number = buffer.readu32(rowptr, 4 * s)
		local R: number = buffer.readu32(rowptr, 4 * (s + 1)) - r0
		local base: number = buffer.readu32(valptr, 4 * s)
		for r = 0, R - 1 do
			buffer.writeu32(rel, 4 * buffer.readu32(rows, 4 * (r0 + r)), r)
		end
		local d = buffer.readi32(head, 4 * s)
		buffer.writei32(head, 4 * s, -1)
		while d >= 0 do
			local dnext = buffer.readi32(link, 4 * d)
			local Kd: number = buffer.readu32(super, 4 * (d + 1)) - buffer.readu32(super, 4 * d)
			local dr0: number = buffer.readu32(rowptr, 4 * d)
			local dr1: number = buffer.readu32(rowptr, 4 * (d + 1))
			local dbase: number = buffer.readu32(valptr, 4 * d)
			local q: number = buffer.readu32(dpos, 4 * d)
			local q2 = q
			while q2 < dr1 and buffer.readu32(rows, 4 * q2) < c1 do
				q2 += 1
			end
			-- C = L_d[rows from jj] L_d[rows jj .. q2 - 1]^H, lower part, subtracted into the
			-- block: two columns of C at a time against two rows
			local stride = 16 * Kd
			local last = stride - 16
			local jj = q
			while jj < q2 do
				local colA = buffer.readu32(rows, 4 * jj) - c0
				local ojA = 16 * (dbase + (jj - dr0) * Kd)
				local pair = jj + 1 < q2
				local colB = if pair then buffer.readu32(rows, 4 * (jj + 1)) - c0 else 0
				local ojB = ojA + stride
				-- row jj, column A: a squared norm
				local sq = 0
				for t = 0, last, 16 do
					local ar, ai = buffer.readf64(L, ojA + t), buffer.readf64(L, (ojA + t) + 8) :: number
					sq += ar * ar + ai * ai
				end
				local target = 16 * (base + buffer.readu32(rel, 4 * buffer.readu32(rows, 4 * jj)) * K + colA)
				local xr, xi = buffer.readf64(L, target), buffer.readf64(L, target + 8) :: number
				buffer.writef64(L, target, xr - sq)
				buffer.writef64(L, target + 8, xi)
				local ii = jj + 1
				local oi = ojA + stride
				while ii < dr1 do
					local two = pair and ii + 1 < dr1
					-- rows ii (and ii + 1) against columns A (and B)
					local p1r, p1i, q1r, q1i, p2r, p2i, q2r, q2i = 0, 0, 0, 0, 0, 0, 0, 0
					if two then
						for t = 0, last, 16 do
							local ar, ai = buffer.readf64(L, ojA + t), buffer.readf64(L, (ojA + t) + 8) :: number
							local br, bi = buffer.readf64(L, ojB + t), buffer.readf64(L, (ojB + t) + 8) :: number
							local yr, yi = buffer.readf64(L, oi + t), buffer.readf64(L, (oi + t) + 8) :: number
							local zr, zi = buffer.readf64(L, oi + stride + t), buffer.readf64(L, (oi + stride + t) + 8) :: number
							p1r += yr * ar + yi * ai
							p1i += yi * ar - yr * ai
							q1r += yr * br + yi * bi
							q1i += yi * br - yr * bi
							p2r += zr * ar + zi * ai
							p2i += zi * ar - zr * ai
							q2r += zr * br + zi * bi
							q2i += zi * br - zr * bi
						end
					else
						for t = 0, last, 16 do
							local ar, ai = buffer.readf64(L, ojA + t), buffer.readf64(L, (ojA + t) + 8) :: number
							local yr, yi = buffer.readf64(L, oi + t), buffer.readf64(L, (oi + t) + 8) :: number
							p1r += yr * ar + yi * ai
							p1i += yi * ar - yr * ai
							if pair then
								local br, bi = buffer.readf64(L, ojB + t), buffer.readf64(L, (ojB + t) + 8) :: number
								q1r += yr * br + yi * bi
								q1i += yi * br - yr * bi
							end
						end
					end
					local rb = base + buffer.readu32(rel, 4 * buffer.readu32(rows, 4 * ii)) * K
					local o = 16 * (rb + colA)
					xr, xi = buffer.readf64(L, o), buffer.readf64(L, o + 8) :: number
					buffer.writef64(L, o, xr - p1r)
					buffer.writef64(L, o + 8, xi - p1i)
					if pair then
						o = 16 * (rb + colB)
						xr, xi = buffer.readf64(L, o), buffer.readf64(L, o + 8) :: number
						buffer.writef64(L, o, xr - q1r)
						buffer.writef64(L, o + 8, xi - q1i)
					end
					if two then
						rb = base + buffer.readu32(rel, 4 * buffer.readu32(rows, 4 * (ii + 1))) * K
						o = 16 * (rb + colA)
						xr, xi = buffer.readf64(L, o), buffer.readf64(L, o + 8) :: number
						buffer.writef64(L, o, xr - p2r)
						buffer.writef64(L, o + 8, xi - p2i)
						o = 16 * (rb + colB)
						xr, xi = buffer.readf64(L, o), buffer.readf64(L, o + 8) :: number
						buffer.writef64(L, o, xr - q2r)
						buffer.writef64(L, o + 8, xi - q2i)
						ii += 2
						oi += 2 * stride
					else
						ii += 1
						oi += stride
					end
				end
				jj += if pair then 2 else 1
			end
			buffer.writeu32(dpos, 4 * d, q2)
			if q2 < dr1 then
				local s2 = buffer.readu32(col2super, 4 * buffer.readu32(rows, 4 * q2))
				buffer.writei32(link, 4 * d, buffer.readi32(head, 4 * s2))
				buffer.writei32(head, 4 * s2, d)
			end
			d = dnext
		end
		-- the dense block: Cholesky of its diagonal block, then the rows below solved
		-- against it, two at a time
		for r = 0, K - 1 do
			local orow = 16 * (base + r * K)
			for t = 0, r do
				local ot = 16 * (base + t * K)
				local sr, si = buffer.readf64(L, orow + 16 * t), buffer.readf64(L, (orow + 16 * t) + 8) :: number
				for u = 0, 16 * (t - 1), 16 do
					local ar, ai = buffer.readf64(L, orow + u), buffer.readf64(L, (orow + u) + 8) :: number
					local br, bi = buffer.readf64(L, ot + u), buffer.readf64(L, (ot + u) + 8) :: number
					sr -= ar * br + ai * bi
					si -= ai * br - ar * bi
				end
				if t == r then
					if not (sr > 0) then
						return false
					end
					do
						local here_ = orow + 16 * t
						buffer.writef64(L, here_, math.sqrt(sr))
						buffer.writef64(L, here_ + 8, 0)
					end
				else
					local dt = buffer.readf64(L, ot + 16 * t)
					do
						local here_ = orow + 16 * t
						buffer.writef64(L, here_, sr / dt)
						buffer.writef64(L, here_ + 8, si / dt)
					end
				end
			end
		end
		local stride = 16 * K
		local r = K
		while r < R do
			local two = r + 1 < R
			local o1 = 16 * (base + r * K)
			local o2 = o1 + stride
			for t = 0, K - 1 do
				local ot = 16 * (base + t * K)
				local at = 16 * t
				local sr, si = buffer.readf64(L, o1 + at), buffer.readf64(L, (o1 + at) + 8) :: number
				local zr, zi = 0, 0
				if two then
					zr, zi = buffer.readf64(L, o2 + at), buffer.readf64(L, (o2 + at) + 8) :: number
				end
				for u = 0, at - 16, 16 do
					-- subtract row(u) conj(L[t, u])
					local br, bi = buffer.readf64(L, ot + u), buffer.readf64(L, (ot + u) + 8) :: number
					local ar, ai = buffer.readf64(L, o1 + u), buffer.readf64(L, (o1 + u) + 8) :: number
					sr -= ar * br + ai * bi
					si -= ai * br - ar * bi
					if two then
						local cr, ci = buffer.readf64(L, o2 + u), buffer.readf64(L, (o2 + u) + 8) :: number
						zr -= cr * br + ci * bi
						zi -= ci * br - cr * bi
					end
				end
				local dt = buffer.readf64(L, ot + at)
				do
					local here_ = o1 + at
					buffer.writef64(L, here_, sr / dt)
					buffer.writef64(L, here_ + 8, si / dt)
				end
				if two then
					do
						local here_ = o2 + at
						buffer.writef64(L, here_, zr / dt)
						buffer.writef64(L, here_ + 8, zi / dt)
					end
				end
			end
			r += if two then 2 else 1
		end
		if R > K then
			buffer.writeu32(dpos, 4 * s, r0 + K)
			local s2 = buffer.readu32(col2super, 4 * buffer.readu32(rows, 4 * (r0 + K)))
			buffer.writei32(link, 4 * s, buffer.readi32(head, 4 * s2))
			buffer.writei32(head, 4 * s2, s)
		end
	end
	return true
end

-- Sparse Cholesky factorization P S P^T = L L^H of a Hermitian positive definite sparse
-- matrix (both triangles stored; the lower one is read after ordering). Options as the
-- real modules' sparse_chol: order ("amd", "rcm", "natural" or a permutation), relax and
-- reuse. F.definite is false if a pivot was not positive.
local function sparse_chol(S: Sparse, options: types.SparseCholOptions?): types.SparseCholesky
	local o: types.SparseCholOptions = options or {}
	assert(S.rows == S.cols, "sparse_chol: matrix must be square")
	local F = o.reuse :: any
	if F == nil or F.symbolic.ptr ~= S.colptr or F.symbolic.ind ~= S.rowind then
		local sym = graph.chol_analysis(graph.of(S), chol_order(S, o.order), { relax = o.relax })
		local n = S.rows
		F = {
			n = n,
			symbolic = sym,
			perm = sym.perm,
			values = buffer.create(16 * sym.nnz),
			definite = false,
			nnz = sym.nnz,
			madds = sym.madds,
			work = {
				rel = buffer.create(4 * n),
				head = buffer.create(4 * sym.nsuper),
				link = buffer.create(4 * sym.nsuper),
				dpos = buffer.create(4 * sym.nsuper),
				x = buffer.create(16 * n),
			},
		}
	end
	F.definite = chol_numeric(F.symbolic, S, F.values, F.work)
	return F
end

-- The solution of S x = b from sparse_chol's factorization (out may be b).
local function sparse_chol_solve(out: buffer?, F: types.SparseCholesky, b: buffer): buffer
	local Fa = F :: any
	local sym = Fa.symbolic
	local n = Fa.n
	local o = output(out, 16 * n)
	local x = Fa.work.x -- (re, im) pairs of f64
	local perm, super, rowptr, rows, valptr = sym.perm, sym.super, sym.rowptr, sym.rows, sym.valptr
	local L = Fa.values
	for k = 0, n - 1 do
		local re, im = buffer.readf64(b, 16 * (buffer.readi32(perm, 4 * k) - 1)), buffer.readf64(b, (16 * (buffer.readi32(perm, 4 * k) - 1)) + 8) :: number
		buffer.writef64(x, 16 * k, re)
		buffer.writef64(x, 16 * k + 8, im)
	end
	local ns = sym.nsuper
	-- L y = P b
	for s = 0, ns - 1 do
		local c0: number = buffer.readu32(super, 4 * s)
		local K: number = buffer.readu32(super, 4 * (s + 1)) - c0
		local r0: number = buffer.readu32(rowptr, 4 * s)
		local R: number = buffer.readu32(rowptr, 4 * (s + 1)) - r0
		local base: number = buffer.readu32(valptr, 4 * s)
		for t = 0, K - 1 do
			local ot = 16 * (base + t * K)
			local at = 16 * (c0 + t)
			local sr, si = buffer.readf64(x, at), buffer.readf64(x, at + 8)
			for u = 0, t - 1 do
				local ar, ai = buffer.readf64(L, ot + 16 * u), buffer.readf64(L, (ot + 16 * u) + 8) :: number
				local xr, xi = buffer.readf64(x, 16 * (c0 + u)), buffer.readf64(x, 16 * (c0 + u) + 8)
				sr -= ar * xr - ai * xi
				si -= ar * xi + ai * xr
			end
			local dt = buffer.readf64(L, ot + 16 * t)
			buffer.writef64(x, at, sr / dt)
			buffer.writef64(x, at + 8, si / dt)
		end
		-- the rows below, two at a time (each read of the block's solution feeding both)
		local stride = 16 * K
		local r = K
		while r < R do
			local two = r + 1 < R
			local o1 = 16 * (base + r * K)
			local o2 = o1 + stride
			local sr, si, zr, zi = 0, 0, 0, 0
			for t = 0, K - 1 do
				local at = 16 * (c0 + t)
				local xr, xi = buffer.readf64(x, at), buffer.readf64(x, at + 8)
				local ar, ai = buffer.readf64(L, o1 + 16 * t), buffer.readf64(L, (o1 + 16 * t) + 8) :: number
				sr += ar * xr - ai * xi
				si += ar * xi + ai * xr
				if two then
					local br, bi = buffer.readf64(L, o2 + 16 * t), buffer.readf64(L, (o2 + 16 * t) + 8) :: number
					zr += br * xr - bi * xi
					zi += br * xi + bi * xr
				end
			end
			local row = 16 * buffer.readu32(rows, 4 * (r0 + r))
			buffer.writef64(x, row, buffer.readf64(x, row) - sr)
			buffer.writef64(x, row + 8, buffer.readf64(x, row + 8) - si)
			if two then
				row = 16 * buffer.readu32(rows, 4 * (r0 + r + 1))
				buffer.writef64(x, row, buffer.readf64(x, row) - zr)
				buffer.writef64(x, row + 8, buffer.readf64(x, row + 8) - zi)
				r += 2
			else
				r += 1
			end
		end
	end
	-- L^H z = y
	for s = ns - 1, 0, -1 do
		local c0: number = buffer.readu32(super, 4 * s)
		local K: number = buffer.readu32(super, 4 * (s + 1)) - c0
		local r0: number = buffer.readu32(rowptr, 4 * s)
		local R: number = buffer.readu32(rowptr, 4 * (s + 1)) - r0
		local base: number = buffer.readu32(valptr, 4 * s)
		-- the block's columns take the rows below (x[t] -= sum of conj(L[r, t]) x[row r]),
		-- two columns at a time summed in locals
		if R > K then
			local stride = 16 * K
			local t = 0
			while t < K do
				local two = t + 1 < K
				local sr, si, zr, zi = 0, 0, 0, 0
				local ol = 16 * (base + K * K + t)
				for q = r0 + K, r0 + R - 1 do
					local row = 16 * buffer.readu32(rows, 4 * q)
					local yr, yi = buffer.readf64(x, row), buffer.readf64(x, row + 8)
					local ar, ai = buffer.readf64(L, ol), buffer.readf64(L, ol + 8) :: number
					sr += ar * yr + ai * yi
					si += ar * yi - ai * yr
					if two then
						local br, bi = buffer.readf64(L, ol + 16), buffer.readf64(L, (ol + 16) + 8) :: number
						zr += br * yr + bi * yi
						zi += br * yi - bi * yr
					end
					ol += stride
				end
				local at = 16 * (c0 + t)
				buffer.writef64(x, at, buffer.readf64(x, at) - sr)
				buffer.writef64(x, at + 8, buffer.readf64(x, at + 8) - si)
				if two then
					buffer.writef64(x, at + 16, buffer.readf64(x, at + 16) - zr)
					buffer.writef64(x, at + 24, buffer.readf64(x, at + 24) - zi)
					t += 2
				else
					t += 1
				end
			end
		end
		for t = K - 1, 0, -1 do
			local at = 16 * (c0 + t)
			local sr, si = buffer.readf64(x, at), buffer.readf64(x, at + 8)
			for u = t + 1, K - 1 do
				local ar, ai = buffer.readf64(L, 16 * (base + u * K + t)), buffer.readf64(L, (16 * (base + u * K + t)) + 8) :: number
				local xr, xi = buffer.readf64(x, 16 * (c0 + u)), buffer.readf64(x, 16 * (c0 + u) + 8)
				sr -= ar * xr + ai * xi
				si -= ar * xi - ai * xr
			end
			local dt = buffer.readf64(L, 16 * (base + t * K + t))
			buffer.writef64(x, at, sr / dt)
			buffer.writef64(x, at + 8, si / dt)
		end
	end
	for k = 0, n - 1 do
		do
			local here_ = 16 * (buffer.readi32(perm, 4 * k) - 1)
			buffer.writef64(o, here_, buffer.readf64(x, 16 * k))
			buffer.writef64(o, here_ + 8, buffer.readf64(x, 16 * k + 8))
		end
	end
	return o
end

-- P S P^T for the permutation perm (a buffer of 32-bit integers, as graph.rcm returns):
-- entry (k, l) is S's entry (perm[k], perm[l]).
local function sparse_permute(S: Sparse, perm: buffer): Sparse
	return permute_sparse(S, perm, 16)
end

-- The band of the Hermitian matrix P S P^T (perm as for sparse_permute; default the
-- identity) in symmetric band storage, for band_chol: kd is the permuted pattern's half
-- bandwidth, and the lower triangle is read. into is reused when it has that shape.
local function sparse_symband(S: Sparse, perm: buffer?, into: SymBanded?): SymBanded
	return symband_sparse(S, perm, into, 16)
end

-- A + B.
local function sparse_add(A: Sparse, B: Sparse): Sparse
	assert(A.rows == B.rows and A.cols == B.cols, "matrix sizes do not match")
	local colrows, colre, colim = empty_columns(A.cols)
	for j = 0, A.cols - 1 do
		local p, pe = buffer.readu32(A.colptr, 4 * j), buffer.readu32(A.colptr, 4 * (j + 1))
		local q, qe = buffer.readu32(B.colptr, 4 * j), buffer.readu32(B.colptr, 4 * (j + 1))
		local rs, vr, vi = colrows[j + 1], colre[j + 1], colim[j + 1]
		while p < pe or q < qe do
			local ra = if p < pe then buffer.readu32(A.rowind, 4 * p) else math.huge
			local rb = if q < qe then buffer.readu32(B.rowind, 4 * q) else math.huge
			local re, im = 0, 0
			if ra <= rb then
				local ar, ai = buffer.readf64(A.values, 16 * p), buffer.readf64(A.values, (16 * p) + 8) :: number
				re += ar
				im += ai
				p += 1
			end
			if rb <= ra then
				local br, bi = buffer.readf64(B.values, 16 * q), buffer.readf64(B.values, (16 * q) + 8) :: number
				re += br
				im += bi
				q += 1
			end
			table.insert(rs, math.min(ra, rb))
			table.insert(vr, re)
			table.insert(vi, im)
		end
	end
	local C = assemble(A.rows, A.cols, colrows, colre, colim)
	C.symmetric, C.hermitian = A.symmetric and B.symmetric, A.hermitian and B.hermitian
	return C
end

-- The Jacobi (diagonal) preconditioner of a square S, for the iterative solvers:
-- out := r ./ diag(S). Every diagonal entry must be nonzero.
local function sparse_jacobi(S: Sparse): (out: buffer, r: buffer) -> buffer
	assert(S.rows == S.cols, "matrix must be square")
	local d = sparse_diag(S)
	-- The inverses in double precision, in a buffer (table reads cost several buffer
	-- reads in the loop below).
	local inv = buffer.create(16 * S.rows)
	for i = 0, S.rows - 1 do
		local vr, vi = buffer.readf64(d, 16 * i), buffer.readf64(d, (16 * i) + 8) :: number
		assert(vr ~= 0 or vi ~= 0, "a diagonal entry is zero")
		local cr, ci = complex64.inv(vr, vi)
		buffer.writef64(inv, 16 * i, cr)
		buffer.writef64(inv, 16 * i + 8, ci)
	end
	local stop = 16 * (S.rows - 1)
	return function(out: buffer, r: buffer): buffer
		do
			local k_start, k_stop = 0, stop
			local k_split = k_start + (16) * (((k_stop - k_start) // (16) + 1) // 4 * 4)
			for k = k_start, k_split - 1, 4 * (16) do
				do
					local xr, xi = buffer.readf64(r, k), buffer.readf64(r, k + 8) :: number
					local c = (16 // 16) * k
					local cr, ci = buffer.readf64(inv, c), buffer.readf64(inv, c + 8)
					buffer.writef64(out, k, xr * cr - xi * ci)
					buffer.writef64(out, k + 8, xr * ci + xi * cr)
				end
				do
					local xr, xi = buffer.readf64(r, (k + 16 * 1)), buffer.readf64(r, (k + 16 * 1) + 8) :: number
					local c = (16 // 16) * (k + 16 * 1)
					local cr, ci = buffer.readf64(inv, c), buffer.readf64(inv, c + 8)
					buffer.writef64(out, (k + 16 * 1), xr * cr - xi * ci)
					buffer.writef64(out, (k + 16 * 1) + 8, xr * ci + xi * cr)
				end
				do
					local xr, xi = buffer.readf64(r, (k + 16 * 2)), buffer.readf64(r, (k + 16 * 2) + 8) :: number
					local c = (16 // 16) * (k + 16 * 2)
					local cr, ci = buffer.readf64(inv, c), buffer.readf64(inv, c + 8)
					buffer.writef64(out, (k + 16 * 2), xr * cr - xi * ci)
					buffer.writef64(out, (k + 16 * 2) + 8, xr * ci + xi * cr)
				end
				do
					local xr, xi = buffer.readf64(r, (k + 16 * 3)), buffer.readf64(r, (k + 16 * 3) + 8) :: number
					local c = (16 // 16) * (k + 16 * 3)
					local cr, ci = buffer.readf64(inv, c), buffer.readf64(inv, c + 8)
					buffer.writef64(out, (k + 16 * 3), xr * cr - xi * ci)
					buffer.writef64(out, (k + 16 * 3) + 8, xr * ci + xi * cr)
				end
			end
			for k = k_split, k_stop, 16 do
				local xr, xi = buffer.readf64(r, k), buffer.readf64(r, k + 8) :: number
				local c = (16 // 16) * k
				local cr, ci = buffer.readf64(inv, c), buffer.readf64(inv, c + 8)
				buffer.writef64(out, k, xr * cr - xi * ci)
				buffer.writef64(out, k + 8, xr * ci + xi * cr)
			end
		end
		return out
	end
end

-- Preconditioners for the iterative solvers

-- The SSOR preconditioner of a square S with relaxation omega (0 < omega < 2; the default
-- 1 is symmetric Gauss-Seidel): M = (D + w L) D^-1 (D + w U) / (w (2 - w)), with D, L, U
-- the diagonal and strictly lower and upper parts. Returns out := M^-1 r. If S is
-- Hermitian positive definite, so is M (usable with CG). Every diagonal entry must be
-- nonzero.
local function sparse_ssor(S: Sparse, omega: number?): (out: buffer, r: buffer) -> buffer
	local w = omega or 1
	assert(w > 0 and w < 2, "omega must be between 0 and 2")
	assert(S.rows == S.cols, "matrix must be square")
	local n = S.rows
	local dr, di = totable(sparse_diag(S))
	for i = 1, n do
		assert(dr[i] ~= 0 or di[i] ~= 0, "a diagonal entry is zero")
	end
	local colptr, rowind, vals = S.colptr, S.rowind, S.values
	local yr, yi = table.create(n, 0), table.create(n, 0)
	local factor = w * (2 - w)
	return function(out: buffer, r: buffer): buffer
		for i = 1, n do
			yr[i], yi[i] = buffer.readf64(r, 16 * (i - 1)), buffer.readf64(r, (16 * (i - 1)) + 8) :: number
		end
		-- (D + w L) y = r, column by column.
		for j = 0, n - 1 do
			local ar, ai = complex64.div(yr[j + 1], yi[j + 1], dr[j + 1], di[j + 1])
			yr[j + 1], yi[j + 1] = ar, ai
			for p = buffer.readu32(colptr, 4 * j), buffer.readu32(colptr, 4 * (j + 1)) - 1 do
				local i = buffer.readu32(rowind, 4 * p)
				if i > j then
					local vr, vi = w * buffer.readf64(vals, 16 * p), w * buffer.readf64(vals, (16 * p) + 8)
					yr[i + 1] -= vr * ar - vi * ai
					yi[i + 1] -= vr * ai + vi * ar
				end
			end
		end
		for i = 1, n do
			yr[i], yi[i] = complex64.mul(yr[i], yi[i], dr[i], di[i])
		end
		-- (D + w U) z = D y, backwards.
		for j = n - 1, 0, -1 do
			local zr, zi = complex64.div(yr[j + 1], yi[j + 1], dr[j + 1], di[j + 1])
			yr[j + 1], yi[j + 1] = zr, zi
			for p = buffer.readu32(colptr, 4 * j), buffer.readu32(colptr, 4 * (j + 1)) - 1 do
				local i = buffer.readu32(rowind, 4 * p)
				if i < j then
					local vr, vi = w * buffer.readf64(vals, 16 * p), w * buffer.readf64(vals, (16 * p) + 8)
					yr[i + 1] -= vr * zr - vi * zi
					yi[i + 1] -= vr * zi + vi * zr
				end
			end
		end
		for i = 1, n do
			do
				local here_ = 16 * (i - 1)
				buffer.writef64(out, here_, yr[i] * factor)
				buffer.writef64(out, here_ + 8, yi[i] * factor)
			end
		end
		return out
	end
end

-- Incomplete LU factorization ILU(0) of a square S, in place: S's values are overwritten
-- with L and U in S's own sparsity pattern (no fill-in). Every diagonal entry must be
-- stored; singular is true if one is missing or a pivot is zero. sparse_ilu0_copy leaves
-- S unchanged.
local function sparse_ilu0(S: Sparse): SparseILU
	assert(S.rows == S.cols, "matrix must be square")
	local n = S.rows
	local colptr, rowind, vals = S.colptr, S.rowind, S.values
	local pos: { [number]: number } = {}
	local diag = table.create(n, 0)
	local singular = false
	for j = 0, n - 1 do
		local p0, p1 = buffer.readu32(colptr, 4 * j), buffer.readu32(colptr, 4 * (j + 1)) - 1
		for p = p0, p1 do
			pos[buffer.readu32(rowind, 4 * p)] = p
		end
		for p = p0, p1 do
			local k = buffer.readu32(rowind, 4 * p)
			if k >= j then
				break
			end
			local ur, ui = buffer.readf64(vals, 16 * p), buffer.readf64(vals, (16 * p) + 8) :: number
			if ur ~= 0 or ui ~= 0 then
				for q = diag[k + 1] + 1, buffer.readu32(colptr, 4 * (k + 1)) - 1 do
					local t = pos[buffer.readu32(rowind, 4 * q)]
					if t then
						local lr, li = buffer.readf64(vals, 16 * q), buffer.readf64(vals, (16 * q) + 8) :: number
						do
							local here_ = 16 * t
							buffer.writef64(vals, here_, buffer.readf64(vals, here_) - (lr * ur - li * ui))
							buffer.writef64(vals, here_ + 8, buffer.readf64(vals, here_ + 8) - (lr * ui + li * ur))
						end
					end
				end
			end
		end
		local dp = pos[j]
		local pr = if dp then buffer.readf64(vals, 16 * dp) else 0
		local pi = if dp then buffer.readf64(vals, (16 * dp) + 8) else 0
		if dp == nil or (pr == 0 and pi == 0) then
			singular = true
			diag[j + 1] = if dp then dp else p0
		else
			diag[j + 1] = dp
			for p = dp + 1, p1 do
				local o = 16 * p
				local qr, qi = complex64.div(buffer.readf64(vals, o), buffer.readf64(vals, o + 8), pr, pi)
				buffer.writef64(vals, o, qr)
				buffer.writef64(vals, o + 8, qi)
			end
		end
		for p = p0, p1 do
			pos[buffer.readu32(rowind, 4 * p)] = nil
		end
	end
	return { lu = S, diag = diag, singular = singular }
end

local function sparse_copy(S: Sparse): Sparse
	return { rows = S.rows, cols = S.cols, colptr = S.colptr, rowind = S.rowind, values = copy(nil, S.values), symmetric = S.symmetric, hermitian = S.hermitian }
end

-- sparse_ilu0 of a copy of S (the index arrays are shared, the values copied).
local function sparse_ilu0_copy(S: Sparse): SparseILU
	return sparse_ilu0(sparse_copy(S))
end

-- out := (L U)^-1 r given F = sparse_ilu0(S); use it as a preconditioner with
-- function(out, r) return sparse_ilu0_solve(out, F, r) end.
local function sparse_ilu0_solve(out: buffer?, F: SparseILU, r: buffer): buffer
	assert(not F.singular, "the incomplete factorization is singular")
	local S = F.lu
	local n = S.rows
	assert(length(r) == n, "matrix and vector sizes do not match")
	local colptr, rowind, vals, diag = S.colptr, S.rowind, S.values, F.diag
	local yr, yi = totable(r)
	for j = 0, n - 1 do
		local ar, ai = yr[j + 1], yi[j + 1]
		for p = diag[j + 1] + 1, buffer.readu32(colptr, 4 * (j + 1)) - 1 do
			local i = buffer.readu32(rowind, 4 * p) + 1
			local lr, li = buffer.readf64(vals, 16 * p), buffer.readf64(vals, (16 * p) + 8) :: number
			yr[i] -= lr * ar - li * ai
			yi[i] -= lr * ai + li * ar
		end
	end
	for j = n - 1, 0, -1 do
		local d = 16 * (diag[j + 1])
		local ar, ai = complex64.div(yr[j + 1], yi[j + 1], buffer.readf64(vals, d), buffer.readf64(vals, d + 8))
		yr[j + 1], yi[j + 1] = ar, ai
		for p = buffer.readu32(colptr, 4 * j), diag[j + 1] - 1 do
			local i = buffer.readu32(rowind, 4 * p) + 1
			local vr, vi = buffer.readf64(vals, 16 * p), buffer.readf64(vals, (16 * p) + 8) :: number
			yr[i] -= vr * ar - vi * ai
			yi[i] -= vr * ai + vi * ar
		end
	end
	local o = output(out, 16 * n)
	for i = 1, n do
		do
			local here_ = 16 * (i - 1)
			buffer.writef64(o, here_, yr[i])
			buffer.writef64(o, here_ + 8, yi[i])
		end
	end
	return o
end

-- Incomplete Cholesky factorization IC(0) of a Hermitian positive definite S, in place:
-- only the lower triangle (and the real parts of the diagonal) is read, and it is
-- overwritten with L in its own sparsity pattern (no fill-in). It can break down even for
-- positive definite S (definite is then false); it cannot for M-matrices such as discrete
-- Laplacians. sparse_ic0_copy leaves S unchanged.
local function sparse_ic0(S: Sparse): SparseIC
	assert(S.rows == S.cols, "matrix must be square")
	local n = S.rows
	local colptr, rowind, vals = S.colptr, S.rowind, S.values
	local diag = table.create(n, 0)
	for j = 0, n - 1 do
		local dp = find(S, j, j)
		if dp == nil then
			return { ic = S, diag = diag, definite = false }
		end
		diag[j + 1] = dp
		local djj = buffer.readf64(vals, 16 * dp)
		if not (djj > 0) then
			return { ic = S, diag = diag, definite = false }
		end
		djj = math.sqrt(djj)
		do
			local here_ = 16 * dp
			buffer.writef64(vals, here_, djj)
			buffer.writef64(vals, here_ + 8, 0)
		end
		local p1 = buffer.readu32(colptr, 4 * (j + 1)) - 1
		for p = dp + 1, p1 do
			do
				local here_ = 16 * p
				buffer.writef64(vals, here_, buffer.readf64(vals, here_) / djj)
				buffer.writef64(vals, here_ + 8, buffer.readf64(vals, here_ + 8) / djj)
			end
		end
		-- A(i, k) -= L(i, j) conj(L(k, j)) for j < k <= i, where the pattern has an entry.
		for q = dp + 1, p1 do
			local k = buffer.readu32(rowind, 4 * q)
			local kr, ki = buffer.readf64(vals, 16 * q), buffer.readf64(vals, (16 * q) + 8) :: number
			for p = q, p1 do
				local t = find(S, buffer.readu32(rowind, 4 * p), k)
				if t then
					local lr, li = buffer.readf64(vals, 16 * p), buffer.readf64(vals, (16 * p) + 8) :: number
					local o = 16 * t
					local ar = buffer.readf64(vals, o) - (lr * kr + li * ki)
					local ai = if p == q then 0 else buffer.readf64(vals, o + 8) - (li * kr - lr * ki)
					buffer.writef64(vals, o, ar)
					buffer.writef64(vals, o + 8, ai)
				end
			end
		end
	end
	return { ic = S, diag = diag, definite = true }
end

-- sparse_ic0 of a copy of S (the index arrays are shared, the values copied).
local function sparse_ic0_copy(S: Sparse): SparseIC
	return sparse_ic0(sparse_copy(S))
end

-- out := (L L^H)^-1 r given F = sparse_ic0(S); use it as a preconditioner with
-- function(out, r) return sparse_ic0_solve(out, F, r) end.
local function sparse_ic0_solve(out: buffer?, F: SparseIC, r: buffer): buffer
	assert(F.definite, "the incomplete Cholesky factorization broke down")
	local S = F.ic
	local n = S.rows
	assert(length(r) == n, "matrix and vector sizes do not match")
	local colptr, rowind, vals, diag = S.colptr, S.rowind, S.values, F.diag
	local yr, yi = totable(r)
	-- L y = r (real diagonal)
	for j = 0, n - 1 do
		local d = buffer.readf64(vals, 16 * (diag[j + 1]))
		local ar, ai = yr[j + 1] / d, yi[j + 1] / d
		yr[j + 1], yi[j + 1] = ar, ai
		for p = diag[j + 1] + 1, buffer.readu32(colptr, 4 * (j + 1)) - 1 do
			local i = buffer.readu32(rowind, 4 * p) + 1
			local lr, li = buffer.readf64(vals, 16 * p), buffer.readf64(vals, (16 * p) + 8) :: number
			yr[i] -= lr * ar - li * ai
			yi[i] -= lr * ai + li * ar
		end
	end
	-- L^H z = y
	for j = n - 1, 0, -1 do
		local sr, si = yr[j + 1], yi[j + 1]
		for p = diag[j + 1] + 1, buffer.readu32(colptr, 4 * (j + 1)) - 1 do
			local i = buffer.readu32(rowind, 4 * p) + 1
			local lr, li = buffer.readf64(vals, 16 * p), buffer.readf64(vals, (16 * p) + 8) :: number
			-- conj(l) z_i
			sr -= lr * yr[i] + li * yi[i]
			si -= lr * yi[i] - li * yr[i]
		end
		local d = buffer.readf64(vals, 16 * (diag[j + 1]))
		yr[j + 1], yi[j + 1] = sr / d, si / d
	end
	local o = output(out, 16 * n)
	for i = 1, n do
		do
			local here_ = 16 * (i - 1)
			buffer.writef64(o, here_, yr[i])
			buffer.writef64(o, here_ + 8, yi[i])
		end
	end
	return o
end

-- Functions taking or returning complex scalars. The *_pair functions above pass them
-- as (re, im) number pairs; each type exports them in its own scalar format.

-- Block sparse matrices

-- Position (0-based) of block (I, J) (0-based) in B's arrays, or nil.
local function find_block(B: BlockSparse, I: number, J: number): number?
	local lo, hi = buffer.readu32(B.rowptr, 4 * I), buffer.readu32(B.rowptr, 4 * (I + 1)) - 1
	while lo <= hi do
		local mid = (lo + hi) // 2
		local c = buffer.readu32(B.colind, 4 * mid)
		if c == J then
			return mid
		elseif c < J then
			lo = mid + 1
		else
			hi = mid - 1
		end
	end
	return nil
end

-- The block sparse matrix with block row I's blocks at the (sorted, distinct) block
-- columns colsets[I + 1], values zero.
local function block_pattern(rows: number, cols: number, block: number, colsets: { { number } }): BlockSparse
	local br = rows // block
	local nb = 0
	for I = 1, br do
		nb += #colsets[I]
	end
	local rowptr, colind = buffer.create(4 * (br + 1)), buffer.create(4 * nb)
	local p = 0
	for I = 1, br do
		buffer.writeu32(rowptr, 4 * (I - 1), p)
		for _, J in colsets[I] do
			buffer.writeu32(colind, 4 * p, J)
			p += 1
		end
	end
	buffer.writeu32(rowptr, 4 * br, p)
	return { rows = rows, cols = cols, block = block, rowptr = rowptr, colind = colind, values = create(block * block * nb) }
end

-- A rows by cols block sparse matrix with block by block blocks from block triplets:
-- block (ii[k], jj[k]) (1-based block indices) gets the block^2 entries of values from
-- element block^2 (k - 1) + 1 on, column-major; repeated positions are summed.
local function bsparse(rows: number, cols: number, block: number, ii: { number }, jj: { number }, values: buffer): BlockSparse
	assert(block >= 1 and block % 1 == 0 and rows % block == 0 and cols % block == 0, "rows and cols must be multiples of the block size")
	local bb = block * block
	local count = #ii
	assert(#jj == count and length(values) == bb * count, "need block^2 values per block position")
	local br, bc = rows // block, cols // block
	local colsets = table.create(br) :: { { number } }
	for I = 1, br do
		colsets[I] = {}
	end
	local seen = {} :: { [number]: boolean }
	for k = 1, count do
		local I, J = ii[k], jj[k]
		assert(I % 1 == 0 and J % 1 == 0 and I >= 1 and I <= br and J >= 1 and J <= bc, "block position outside the matrix")
		local key = (I - 1) * bc + (J - 1)
		if not seen[key] then
			seen[key] = true
			table.insert(colsets[I], J - 1)
		end
	end
	for I = 1, br do
		table.sort(colsets[I])
	end
	local B = block_pattern(rows, cols, block, colsets)
	-- Sum in double precision, then round once.
	local acc = buffer.create(16 * bb * buffer.len(B.colind) // 4)
	for k = 1, count do
		local p = find_block(B, ii[k] - 1, jj[k] - 1) :: number
		for e = 0, bb - 1 do
			local a, s = 16 * (bb * p + e), 16 * (bb * (k - 1) + e)
			buffer.writef64(acc, a, buffer.readf64(acc, a) + buffer.readf64(values, s))
			buffer.writef64(acc, a + 8, buffer.readf64(acc, a + 8) + buffer.readf64(values, s + 8))
		end
	end
	for e = 0, buffer.len(acc) // 16 - 1 do
		do
			local here_ = 16 * e
			buffer.writef64(B.values, here_, buffer.readf64(acc, 16 * e))
			buffer.writef64(B.values, here_ + 8, buffer.readf64(acc, 16 * e + 8))
		end
	end
	return B
end

-- S in blocks of block by block (every block holding a stored entry of S is stored
-- whole); S's symmetric and hermitian marks carry over.
local function bsparse_from_sparse(S: Sparse, block: number): BlockSparse
	assert(block >= 1 and block % 1 == 0 and S.rows % block == 0 and S.cols % block == 0, "rows and cols must be multiples of the block size")
	local br, bb = S.rows // block, block * block
	local colsets = table.create(br) :: { { number } }
	local seen = table.create(br) :: { { [number]: boolean } }
	for I = 1, br do
		colsets[I], seen[I] = {}, {}
	end
	for j = 0, S.cols - 1 do
		local J = j // block
		for p = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local I = buffer.readu32(S.rowind, 4 * p) // block + 1
			if not seen[I][J] then
				seen[I][J] = true
				table.insert(colsets[I], J)
			end
		end
	end
	for I = 1, br do
		table.sort(colsets[I])
	end
	local B = block_pattern(S.rows, S.cols, block, colsets)
	for j = 0, S.cols - 1 do
		for p = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local r = buffer.readu32(S.rowind, 4 * p)
			local q = find_block(B, r // block, j // block) :: number
			local re, im = buffer.readf64(S.values, 16 * p), buffer.readf64(S.values, (16 * p) + 8) :: number
			do
				local here_ = 16 * (bb * q + (j % block) * block + r % block)
				buffer.writef64(B.values, here_, re)
				buffer.writef64(B.values, here_ + 8, im)
			end
		end
	end
	B.symmetric, B.hermitian = S.symmetric, S.hermitian
	return B
end

-- B as a Sparse matrix, every entry of its stored blocks stored (zeros included).
local function bsparse_sparse(B: BlockSparse): Sparse
	local b, bb = B.block, B.block * B.block
	local colrows, colre, colim = empty_columns(B.cols)
	for I = 0, B.rows // b - 1 do
		for p = buffer.readu32(B.rowptr, 4 * I), buffer.readu32(B.rowptr, 4 * (I + 1)) - 1 do
			local J = buffer.readu32(B.colind, 4 * p)
			for k = 0, b - 1 do
				local rs, vr, vi = colrows[J * b + k + 1], colre[J * b + k + 1], colim[J * b + k + 1]
				for r = 0, b - 1 do
					local s = 16 * (bb * p + k * b + r)
					table.insert(rs, I * b + r)
					table.insert(vr, buffer.readf64(B.values, s))
					table.insert(vi, buffer.readf64(B.values, s + 8))
				end
			end
		end
	end
	local S = assemble(B.rows, B.cols, colrows, colre, colim)
	S.symmetric, S.hermitian = B.symmetric, B.hermitian
	return S
end

-- Number of stored entries (block^2 per stored block).
local function bsparse_nnz(B: BlockSparse): number
	return B.block * B.block * (buffer.len(B.colind) // 4)
end

-- The number p (1-based) of block (I, J) (1-based block indices), or nil if it is not
-- stored: its entries are values[block^2 (p - 1) + 1 .. block^2 p], column-major. For
-- updating values in place (a Jacobian refilled each step on a fixed pattern).
local function bsparse_block(B: BlockSparse, I: number, J: number): number?
	local p = find_block(B, I - 1, J - 1)
	return if p then p + 1 else nil
end

-- Position (0-based element) of entry (i, j) (1-based), or nil.
local function bsparse_at(B: BlockSparse, i: number, j: number): number?
	local b = B.block
	local p = find_block(B, (i - 1) // b, (j - 1) // b)
	return if p then b * b * p + ((j - 1) % b) * b + (i - 1) % b else nil
end

-- Entry (i, j), 1-based, as (re, im) (0 if not stored).
local function bsparse_get(B: BlockSparse, i: number, j: number): (number, number)
	local e = bsparse_at(B, i, j)
	if not e then
		return 0, 0
	end
	return buffer.readf64(B.values, 16 * e), buffer.readf64(B.values, (16 * e) + 8) :: number
end

-- The diagonal, as an array of min(rows, cols) entries.
local function bsparse_diag(B: BlockSparse): buffer
	local b = B.block
	local k = math.min(B.rows, B.cols)
	local d = create(k)
	for I = 0, k // b - 1 do
		local p = find_block(B, I, I)
		if p then
			for r = 0, b - 1 do
				local s = 16 * (b * b * p + r * b + r)
				local re, im = buffer.readf64(B.values, s), buffer.readf64(B.values, s + 8) :: number
				do
					local here_ = 16 * (I * b + r)
					buffer.writef64(d, here_, re)
					buffer.writef64(d, here_ + 8, im)
				end
			end
		end
	end
	return d
end

-- B x, accumulated in double precision (generated kernels for blocks of 2, 3 and 4).
local function bsparse_matvec(out: buffer?, B: BlockSparse, x: buffer): buffer
	assert(length(x) == B.cols, "matrix and vector sizes do not match")
	local o = output(out, 16 * B.rows)
	assert(o ~= x, "output cannot be the input vector")
	local kernel = spk.block[B.block]
	if kernel then
		kernel.mv(o, B, x)
		return o
	end
	local b = B.block
	local bb = b * b
	local sr, si = table.create(b, 0), table.create(b, 0)
	for I = 0, B.rows // b - 1 do
		for r = 1, b do
			sr[r], si[r] = 0, 0
		end
		for p = buffer.readu32(B.rowptr, 4 * I), buffer.readu32(B.rowptr, 4 * (I + 1)) - 1 do
			local J = buffer.readu32(B.colind, 4 * p)
			for k = 0, b - 1 do
				local xr, xi = buffer.readf64(x, 16 * (J * b + k)), buffer.readf64(x, (16 * (J * b + k)) + 8) :: number
				local v = bb * p + k * b
				for r = 0, b - 1 do
					local ar, ai = buffer.readf64(B.values, 16 * (v + r)), buffer.readf64(B.values, (16 * (v + r)) + 8) :: number
					sr[r + 1] += ar * xr - ai * xi
					si[r + 1] += ar * xi + ai * xr
				end
			end
		end
		for r = 0, b - 1 do
			do
				local here_ = 16 * (I * b + r)
				buffer.writef64(o, here_, sr[r + 1])
				buffer.writef64(o, here_ + 8, si[r + 1])
			end
		end
	end
	return o
end

-- B^H x (B x when B is marked hermitian).
local function bsparse_matvec_adjoint(out: buffer?, B: BlockSparse, x: buffer): buffer
	if B.hermitian then
		return bsparse_matvec(out, B, x)
	end
	assert(length(x) == B.rows, "matrix and vector sizes do not match")
	local o = output(out, 16 * B.cols)
	assert(o ~= x, "output cannot be the input vector")
	local acc = if 8 == 8 then o else buffer.create(16 * B.cols)
	buffer.fill(acc, 0, 0)
	local kernel = spk.block[B.block]
	if kernel then
		kernel.mvt(acc, B, x)
	else
		local b = B.block
		local bb = b * b
		for I = 0, B.rows // b - 1 do
			for p = buffer.readu32(B.rowptr, 4 * I), buffer.readu32(B.rowptr, 4 * (I + 1)) - 1 do
				local J = buffer.readu32(B.colind, 4 * p)
				for k = 0, b - 1 do
					local ur, ui = 0, 0
					for r = 0, b - 1 do
						local s, t = 16 * (bb * p + k * b + r), 16 * (I * b + r)
						local ar, ai = buffer.readf64(B.values, s), buffer.readf64(B.values, s + 8) :: number
						local xr, xi = buffer.readf64(x, t), buffer.readf64(x, t + 8) :: number
						ur += ar * xr + ai * xi
						ui += ar * xi - ai * xr
					end
					local a = 16 * (J * b + k)
					buffer.writef64(acc, a, buffer.readf64(acc, a) + ur)
					buffer.writef64(acc, a + 8, buffer.readf64(acc, a + 8) + ui)
				end
			end
		end
	end
	if acc ~= o then
		for i = 0, B.cols - 1 do
			do
				local here_ = 16 * i
				buffer.writef64(o, here_, buffer.readf64(acc, 16 * i))
				buffer.writef64(o, here_ + 8, buffer.readf64(acc, 16 * i + 8))
			end
		end
	end
	return o
end

-- The block Jacobi preconditioner of a square B, for the iterative solvers: out :=
-- blockdiag(B)^-1 r, the diagonal blocks inverted once (in double precision, by
-- Gauss-Jordan elimination with partial pivoting by |re| + |im|). It keeps each node's
-- coupling between its own unknowns, which scalar Jacobi drops, and is unchanged by a
-- unitary change of a node's coordinates. Every diagonal block must be stored and
-- nonsingular; for a Hermitian positive definite B it is Hermitian positive definite.
local function bsparse_jacobi(B: BlockSparse): (out: buffer, r: buffer) -> buffer
	assert(B.rows == B.cols, "matrix must be square")
	local b = B.block
	local bb, nb = b * b, B.rows // b
	local inv = buffer.create(16 * bb * nb)
	local ar, ai = table.create(bb, 0), table.create(bb, 0)
	local zr, zi = table.create(bb, 0), table.create(bb, 0)
	for I = 0, nb - 1 do
		local p = find_block(B, I, I)
		assert(p, "a diagonal block is not stored")
		for e = 1, bb do
			local s = 16 * (bb * (p :: number) + e - 1)
			ar[e], ai[e] = buffer.readf64(B.values, s), buffer.readf64(B.values, s + 8) :: number
			zr[e], zi[e] = if (e - 1) // b == (e - 1) % b then 1 else 0, 0
		end
		-- Gauss-Jordan on [a | z], column-major (entry (r, c) at c * b + r + 1).
		for c = 0, b - 1 do
			local cc = c * b + c + 1
			local piv, best = c, math.abs(ar[cc]) + math.abs(ai[cc])
			for r = c + 1, b - 1 do
				local v = math.abs(ar[c * b + r + 1]) + math.abs(ai[c * b + r + 1])
				if v > best then
					piv, best = r, v
				end
			end
			assert(best > 0, "a diagonal block is singular")
			if piv ~= c then
				for k = 0, b - 1 do
					local u, w = k * b + c + 1, k * b + piv + 1
					ar[u], ar[w], ai[u], ai[w] = ar[w], ar[u], ai[w], ai[u]
					zr[u], zr[w], zi[u], zi[w] = zr[w], zr[u], zi[w], zi[u]
				end
			end
			local dr, di = complex64.inv(ar[cc], ai[cc])
			for k = 0, b - 1 do
				local u = k * b + c + 1
				ar[u], ai[u] = ar[u] * dr - ai[u] * di, ar[u] * di + ai[u] * dr
				zr[u], zi[u] = zr[u] * dr - zi[u] * di, zr[u] * di + zi[u] * dr
			end
			for r = 0, b - 1 do
				local fr, fi = ar[c * b + r + 1], ai[c * b + r + 1]
				if r ~= c and (fr ~= 0 or fi ~= 0) then
					for k = 0, b - 1 do
						local u, w = k * b + r + 1, k * b + c + 1
						ar[u] -= fr * ar[w] - fi * ai[w]
						ai[u] -= fr * ai[w] + fi * ar[w]
						zr[u] -= fr * zr[w] - fi * zi[w]
						zi[u] -= fr * zi[w] + fi * zr[w]
					end
				end
			end
		end
		for e = 1, bb do
			buffer.writef64(inv, 16 * (bb * I + e - 1), zr[e])
			buffer.writef64(inv, 16 * (bb * I + e - 1) + 8, zi[e])
		end
	end
	local kernel = spk.block[b]
	return function(out: buffer, r: buffer): buffer
		local o = output(out, 16 * B.rows)
		if kernel then
			kernel.jacobi(o, inv, r, nb)
			return o
		end
		local tr, ti = table.create(b, 0), table.create(b, 0)
		for I = 0, nb - 1 do
			for k = 0, b - 1 do
				tr[k + 1], ti[k + 1] = buffer.readf64(r, 16 * (I * b + k)), buffer.readf64(r, (16 * (I * b + k)) + 8) :: number
			end
			for i = 0, b - 1 do
				local ur, ui = 0, 0
				for k = 0, b - 1 do
					local e = 16 * (bb * I + k * b + i)
					local cr, ci = buffer.readf64(inv, e), buffer.readf64(inv, e + 8)
					ur += cr * tr[k + 1] - ci * ti[k + 1]
					ui += cr * ti[k + 1] + ci * tr[k + 1]
				end
				do
					local here_ = 16 * (I * b + i)
					buffer.writef64(o, here_, ur)
					buffer.writef64(o, here_ + 8, ui)
				end
			end
		end
		return o
	end
end

