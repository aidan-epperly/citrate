				do local ar, ai = buffer.readf64(vals, v + 16 * 1), buffer.readf64(vals, v + 16 * 1 + 8); sr1 += ar * xr0 - ai * xi0; si1 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 4), buffer.readf64(vals, v + 16 * 4 + 8); sr1 += ar * xr1 - ai * xi1; si1 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 7), buffer.readf64(vals, v + 16 * 7 + 8); sr1 += ar * xr2 - ai * xi2; si1 += ar * xi2 + ai * xr2 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 2), buffer.readf64(vals, v + 16 * 2 + 8); sr2 += ar * xr0 - ai * xi0; si2 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 5), buffer.readf64(vals, v + 16 * 5 + 8); sr2 += ar * xr1 - ai * xi1; si2 += ar * xi1 + ai * xr1 end
