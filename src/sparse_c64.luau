				do local ar, ai = buffer.readf64(vals, v + 16 * 12), buffer.readf64(vals, v + 16 * 12 + 8); sr0 += ar * xr3 - ai * xi3; si0 += ar * xi3 + ai * xr3 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 1), buffer.readf64(vals, v + 16 * 1 + 8); sr1 += ar * xr0 - ai * xi0; si1 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 5), buffer.readf64(vals, v + 16 * 5 + 8); sr1 += ar * xr1 - ai * xi1; si1 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 9), buffer.readf64(vals, v + 16 * 9 + 8); sr1 += ar * xr2 - ai * xi2; si1 += ar * xi2 + ai * xr2 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 13), buffer.readf64(vals, v + 16 * 13 + 8); sr1 += ar * xr3 - ai * xi3; si1 += ar * xi3 + ai * xr3 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 2), buffer.readf64(vals, v + 16 * 2 + 8); sr2 += ar * xr0 - ai * xi0; si2 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 6), buffer.readf64(vals, v + 16 * 6 + 8); sr2 += ar * xr1 - ai * xi1; si2 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 10), buffer.readf64(vals, v + 16 * 10 + 8); sr2 += ar * xr2 - ai * xi2; si2 += ar * xi2 + ai * xr2 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 14), buffer.readf64(vals, v + 16 * 14 + 8); sr2 += ar * xr3 - ai * xi3; si2 += ar * xi3 + ai * xr3 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 3), buffer.readf64(vals, v + 16 * 3 + 8); sr3 += ar * xr0 - ai * xi0; si3 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 7), buffer.readf64(vals, v + 16 * 7 + 8); sr3 += ar * xr1 - ai * xi1; si3 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 11), buffer.readf64(vals, v + 16 * 11 + 8); sr3 += ar * xr2 - ai * xi2; si3 += ar * xi2 + ai * xr2 end
				do local ar, ai = buffer.readf64(vals, v + 16 * 15), buffer.readf64(vals, v + 16 * 15 + 8); sr3 += ar * xr3 - ai * xi3; si3 += ar * xi3 + ai * xr3 end
			end
			local w = 16 * 4 * I
			buffer.writef64(o, w + 16 * 0, sr0)
