					local ur, ui = 0, 0
					do local ar, ai = buffer.readf64(vals, v + 16 * 4), buffer.readf64(vals, v + 16 * 4 + 8); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = buffer.readf64(vals, v + 16 * 5), buffer.readf64(vals, v + 16 * 5 + 8); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = buffer.readf64(vals, v + 16 * 6), buffer.readf64(vals, v + 16 * 6 + 8); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					do local ar, ai = buffer.readf64(vals, v + 16 * 7), buffer.readf64(vals, v + 16 * 7 + 8); ur += ar * xr3 + ai * xi3; ui += ar * xi3 - ai * xr3 end
					buffer.writef64(acc, c + 16, buffer.readf64(acc, c + 16) + ur)
					buffer.writef64(acc, c + 16 + 8, buffer.readf64(acc, c + 16 + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = buffer.readf64(vals, v + 16 * 8), buffer.readf64(vals, v + 16 * 8 + 8); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = buffer.readf64(vals, v + 16 * 9), buffer.readf64(vals, v + 16 * 9 + 8); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = buffer.readf64(vals, v + 16 * 10), buffer.readf64(vals, v + 16 * 10 + 8); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					do local ar, ai = buffer.readf64(vals, v + 16 * 11), buffer.readf64(vals, v + 16 * 11 + 8); ur += ar * xr3 + ai * xi3; ui += ar * xi3 - ai * xr3 end
					buffer.writef64(acc, c + 32, buffer.readf64(acc, c + 32) + ur)
					buffer.writef64(acc, c + 32 + 8, buffer.readf64(acc, c + 32 + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = buffer.readf64(vals, v + 16 * 12), buffer.readf64(vals, v + 16 * 12 + 8); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = buffer.readf64(vals, v + 16 * 13), buffer.readf64(vals, v + 16 * 13 + 8); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = buffer.readf64(vals, v + 16 * 14), buffer.readf64(vals, v + 16 * 14 + 8); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					do local ar, ai = buffer.readf64(vals, v + 16 * 15), buffer.readf64(vals, v + 16 * 15 + 8); ur += ar * xr3 + ai * xi3; ui += ar * xi3 - ai * xr3 end
