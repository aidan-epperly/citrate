	local function mvt4(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 4 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = 16 * 4 * I
			local xr0, xi0, xr1, xi1, xr2, xi2, xr3, xi3 = buffer.readf64(x, xb + 16 * 0), buffer.readf64(x, xb + 16 * 0 + 8), buffer.readf64(x, xb + 16 * 1), buffer.readf64(x, xb + 16 * 1 + 8), buffer.readf64(x, xb + 16 * 2), buffer.readf64(x, xb + 16 * 2 + 8), buffer.readf64(x, xb + 16 * 3), buffer.readf64(x, xb + 16 * 3 + 8)
