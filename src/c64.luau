--!strict
--!native
--!optimize 2
-- Generated by tools/generate.py from templates/complex.luau.in. Edit the template, not this file.

-- Double-precision complex arrays (buffers of interleaved 8-byte real and imaginary parts) and
-- column-major matrices. Indices are 1-based. Arithmetic is done in double precision
-- and rounded once per stored value. Every `out` argument may be nil, in which case a
-- new result is allocated. Complex scalars are (re, im) pairs of numbers, as in complex64.

local types = require("./types")
local complex64 = require("./complex64")

export type Matrix = types.Matrix
export type LU = types.LU
export type QR = types.QR
export type QRP = types.QRP
export type Cholesky = types.Cholesky
export type Form = types.Form

-- Arrays

local function create(n: number): buffer
	return buffer.create(16 * n)
end

local function length(x: buffer): number
	return buffer.len(x) // 16
end

local function similar(x: buffer): buffer
	return buffer.create(buffer.len(x))
end

local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

local function check_same(x: buffer, y: buffer)
	assert(buffer.len(x) == buffer.len(y), "arrays have different lengths")
end

local function from(re: { number }, im: { number }?): buffer
	local n = #re
	assert(im == nil or #im == n, "real and imaginary parts have different lengths")
	local x = buffer.create(16 * n)
	for i = 1, n do
		local k = 16 * (i - 1)
		buffer.writef64(x, k, re[i])
		if im then
			buffer.writef64(x, k + 8, im[i])
		end
	end
	return x
end

-- Returns the real and imaginary parts as two tables.
local function totable(x: buffer): ({ number }, { number })
	local n = length(x)
	local re, im = table.create(n, 0), table.create(n, 0)
	for i = 1, n do
		local k = 16 * (i - 1)
		re[i] = buffer.readf64(x, k)
		im[i] = buffer.readf64(x, k + 8)
	end
	return re, im
end

local function copy(out: buffer?, x: buffer): buffer
	local o = output(out, buffer.len(x))
	if o ~= x then
		buffer.copy(o, 0, x)
	end
	return o
end

local function fill_pair(out: buffer, re: number, im: number): buffer
	for k = 0, buffer.len(out) - 16, 16 do
		buffer.writef64(out, k, re)
		buffer.writef64(out, k + 8, im)
	end
	return out
end

-- Builds a complex array from real arrays of the same precision.
local function complexify(re: buffer, im: buffer?): buffer
	assert(im == nil or buffer.len(im) == buffer.len(re), "parts have different lengths")
	local n = buffer.len(re) // 8
	local x = buffer.create(16 * n)
	for i = 0, n - 1 do
		buffer.writef64(x, 16 * i, buffer.readf64(re, 8 * i))
		if im then
			buffer.writef64(x, 16 * i + 8, buffer.readf64(im, 8 * i))
		end
	end
	return x
end

local function real(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, 8 * n)
	for i = 0, n - 1 do
		buffer.writef64(o, 8 * i, buffer.readf64(x, 16 * i))
	end
	return o
end

local function imag(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, 8 * n)
	for i = 0, n - 1 do
		buffer.writef64(o, 8 * i, buffer.readf64(x, 16 * i + 8))
	end
	return o
end

-- Elementwise modulus, as a real array.
local function abs(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, 8 * n)
	for i = 0, n - 1 do
		buffer.writef64(o, 8 * i, complex64.abs(buffer.readf64(x, 16 * i), buffer.readf64(x, 16 * i + 8)))
	end
	return o
end

local function conj(out: buffer?, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 16, 16 do
		buffer.writef64(o, k, buffer.readf64(x, k))
		buffer.writef64(o, k + 8, -buffer.readf64(x, k + 8))
	end
	return o
end

-- Addition, subtraction and real scaling act on the real and imaginary parts alike.
local function add(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef64(o, k, buffer.readf64(x, k) + buffer.readf64(y, k))
	end
	return o
end

local function sub(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef64(o, k, buffer.readf64(x, k) - buffer.readf64(y, k))
	end
	return o
end

local function scale(out: buffer?, a: number, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef64(o, k, a * buffer.readf64(x, k))
	end
	return o
end

-- a * x + y with a real
local function axpy(out: buffer?, a: number, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef64(o, k, a * buffer.readf64(x, k) + buffer.readf64(y, k))
	end
	return o
end

-- Elementwise (Hadamard) product.
local function mul(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 16, 16 do
		local xr, xi = buffer.readf64(x, k), buffer.readf64(x, k + 8)
		local yr, yi = buffer.readf64(y, k), buffer.readf64(y, k + 8)
		buffer.writef64(o, k, xr * yr - xi * yi)
		buffer.writef64(o, k + 8, xr * yi + xi * yr)
	end
	return o
end

local function cscale_pair(out: buffer?, ar: number, ai: number, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 16, 16 do
		local xr, xi = buffer.readf64(x, k), buffer.readf64(x, k + 8)
		buffer.writef64(o, k, ar * xr - ai * xi)
		buffer.writef64(o, k + 8, ar * xi + ai * xr)
	end
	return o
end

local function caxpy_pair(out: buffer?, ar: number, ai: number, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 16, 16 do
		local xr, xi = buffer.readf64(x, k), buffer.readf64(x, k + 8)
		buffer.writef64(o, k, ar * xr - ai * xi + buffer.readf64(y, k))
		buffer.writef64(o, k + 8, ar * xi + ai * xr + buffer.readf64(y, k + 8))
	end
	return o
end

-- sum x_i y_i (no conjugation)
local function dotu_pair(x: buffer, y: buffer): (number, number)
	check_same(x, y)
	local sr, si = 0, 0
	for k = 0, buffer.len(x) - 16, 16 do
		local xr, xi = buffer.readf64(x, k), buffer.readf64(x, k + 8)
		local yr, yi = buffer.readf64(y, k), buffer.readf64(y, k + 8)
		sr += xr * yr - xi * yi
		si += xr * yi + xi * yr
	end
	return sr, si
end

-- sum conj(x_i) y_i
local function dotc_pair(x: buffer, y: buffer): (number, number)
	check_same(x, y)
	local sr, si = 0, 0
	for k = 0, buffer.len(x) - 16, 16 do
		local xr, xi = buffer.readf64(x, k), buffer.readf64(x, k + 8)
		local yr, yi = buffer.readf64(y, k), buffer.readf64(y, k + 8)
		sr += xr * yr + xi * yi
		si += xr * yi - xi * yr
	end
	return sr, si
end

local function sum_pair(x: buffer): (number, number)
	local sr, si = 0, 0
	for k = 0, buffer.len(x) - 16, 16 do
		sr += buffer.readf64(x, k)
		si += buffer.readf64(x, k + 8)
	end
	return sr, si
end

-- Largest modulus (NaN if any element is NaN, 0 for an empty array).
local function amax(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - 16, 16 do
		local a = complex64.abs(buffer.readf64(x, k), buffer.readf64(x, k + 8))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	return m
end

-- Euclidean norm of `count` consecutive reals starting at byte offset `start`. The plain
-- sum of squares is used unless it overflowed or may have lost digits to underflow; then
-- the values are rescaled by the largest magnitude. NaN if any value is NaN.
local function segment_norm(x: buffer, start: number, count: number): number
	local stop = start + 8 * (count - 1)
	local s = 0
	for k = start, stop, 8 do
		local v = buffer.readf64(x, k)
		s += v * v
	end
	if s > 2 ^ -500 and s < math.huge then
		return math.sqrt(s)
	end
	local m = 0
	for k = start, stop, 8 do
		local a = math.abs(buffer.readf64(x, k))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	if m == 0 or m == math.huge then
		return m
	end
	s = 0
	for k = start, stop, 8 do
		local v = buffer.readf64(x, k) / m
		s += v * v
	end
	return m * math.sqrt(s)
end

-- sqrt(a^2 + b^2 + c^2) without overflow or underflow.
local function hypot3(a: number, b: number, c: number): number
	a, b, c = math.abs(a), math.abs(b), math.abs(c)
	local m = math.max(a, b, c)
	if m == 0 or m == math.huge or m ~= m then
		return m
	end
	a, b, c = a / m, b / m, c / m
	return m * math.sqrt(a * a + b * b + c * c)
end

-- Euclidean norm (of the 2n real components), without overflow or underflow.
local function norm(x: buffer): number
	return segment_norm(x, 0, 2 * length(x))
end

-- Matrices

local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(16 * rows * cols) }
end

local function matoutput(out: Matrix?, rows: number, cols: number): Matrix
	if out == nil then
		return matrix(rows, cols)
	end
	assert(out.rows == rows and out.cols == cols, "output has the wrong shape")
	return out
end

-- Builds a matrix from tables of rows of the real and (optional) imaginary parts.
local function matfrom(re: { { number } }, im: { { number } }?): Matrix
	local rows = #re
	local cols = if rows > 0 then #re[1] else 0
	assert(im == nil or #im == rows, "real and imaginary parts have different shapes")
	local A = matrix(rows, cols)
	for i = 1, rows do
		local row = re[i]
		assert(#row == cols, "rows have different lengths")
		local irow = if im then im[i] else nil
		assert(irow == nil or #irow == cols, "real and imaginary parts have different shapes")
		for j = 1, cols do
			local k = 16 * ((j - 1) * rows + i - 1)
			buffer.writef64(A.data, k, row[j])
			if irow then
				buffer.writef64(A.data, k + 8, irow[j])
			end
		end
	end
	return A
end

-- Returns tables of rows of the real and imaginary parts.
local function mattotable(A: Matrix): ({ { number } }, { { number } })
	local re, im = table.create(A.rows) :: { { number } }, table.create(A.rows) :: { { number } }
	for i = 1, A.rows do
		local rrow, irow = table.create(A.cols, 0), table.create(A.cols, 0)
		for j = 1, A.cols do
			local k = 16 * ((j - 1) * A.rows + i - 1)
			rrow[j] = buffer.readf64(A.data, k)
			irow[j] = buffer.readf64(A.data, k + 8)
		end
		re[i], im[i] = rrow, irow
	end
	return re, im
end

local function identity(n: number): Matrix
	local A = matrix(n, n)
	for i = 0, n - 1 do
		buffer.writef64(A.data, 16 * (i * n + i), 1)
	end
	return A
end

local function matcopy(out: Matrix?, A: Matrix): Matrix
	local o = matoutput(out, A.rows, A.cols)
	if o.data ~= A.data then
		buffer.copy(o.data, 0, A.data)
	end
	return o
end

local function transpose_impl(out: Matrix?, A: Matrix, sign: number): Matrix
	local m, n = A.rows, A.cols
	local o = matoutput(out, n, m)
	assert(o.data ~= A.data, "transpose cannot be done in place")
	local a, d = A.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local s, t = 16 * (j * m + i), 16 * (i * n + j)
			buffer.writef64(d, t, buffer.readf64(a, s))
			buffer.writef64(d, t + 8, sign * buffer.readf64(a, s + 8))
		end
	end
	return o
end

local function transpose(out: Matrix?, A: Matrix): Matrix
	return transpose_impl(out, A, 1)
end

-- Conjugate transpose.
local function adjoint(out: Matrix?, A: Matrix): Matrix
	return transpose_impl(out, A, -1)
end

-- A x
local function matvec(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(buffer.len(x) == 16 * n, "matrix and vector sizes do not match")
	local o = output(out, 16 * m)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, m - 1 do
		local sr, si = 0, 0
		for j = 0, n - 1 do
			local k = 16 * (j * m + i)
			local ar, ai = buffer.readf64(a, k), buffer.readf64(a, k + 8)
			local xr, xi = buffer.readf64(x, 16 * j), buffer.readf64(x, 16 * j + 8)
			sr += ar * xr - ai * xi
			si += ar * xi + ai * xr
		end
		buffer.writef64(o, 16 * i, sr)
		buffer.writef64(o, 16 * i + 8, si)
	end
	return o
end

-- A B
local function matmul(out: Matrix?, A: Matrix, B: Matrix): Matrix
	local m, p, n = A.rows, A.cols, B.cols
	assert(B.rows == p, "matrix sizes do not match")
	local o = matoutput(out, m, n)
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	local a, b, c = A.data, B.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local sr, si = 0, 0
			for k = 0, p - 1 do
				local s, t = 16 * (k * m + i), 16 * (j * p + k)
				local ar, ai = buffer.readf64(a, s), buffer.readf64(a, s + 8)
				local br, bi = buffer.readf64(b, t), buffer.readf64(b, t + 8)
				sr += ar * br - ai * bi
				si += ar * bi + ai * br
			end
			buffer.writef64(c, 16 * (j * m + i), sr)
			buffer.writef64(c, 16 * (j * m + i) + 8, si)
		end
	end
	return o
end

-- LU factorization with partial pivoting (pivots chosen by |re| + |im|), in place: A is
-- overwritten with L and U (see types.LU) and returned as F.lu. lu_copy leaves A unchanged.
local function lu(A: Matrix): LU
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local piv = table.create(n, 0)
	local sign = 1
	local singular = false
	for k = 0, n - 1 do
		local p, best = k, -1
		for i = k, n - 1 do
			local off = 16 * (k * n + i)
			local v = math.abs(buffer.readf64(a, off)) + math.abs(buffer.readf64(a, off + 8))
			if v > best then
				p, best = i, v
			end
		end
		piv[k + 1] = p + 1
		if p ~= k then
			sign = -sign
			for j = 0, n - 1 do
				local s, t = 16 * (j * n + k), 16 * (j * n + p)
				local tr, ti = buffer.readf64(a, s), buffer.readf64(a, s + 8)
				buffer.writef64(a, s, buffer.readf64(a, t))
				buffer.writef64(a, s + 8, buffer.readf64(a, t + 8))
				buffer.writef64(a, t, tr)
				buffer.writef64(a, t + 8, ti)
			end
		end
		local pr, pi = buffer.readf64(a, 16 * (k * n + k)), buffer.readf64(a, 16 * (k * n + k) + 8)
		if pr == 0 and pi == 0 then
			singular = true
		else
			for i = k + 1, n - 1 do
				local off = 16 * (k * n + i)
				local qr, qi = complex64.div(buffer.readf64(a, off), buffer.readf64(a, off + 8), pr, pi)
				buffer.writef64(a, off, qr)
				buffer.writef64(a, off + 8, qi)
			end
			for j = k + 1, n - 1 do
				local s = 16 * (j * n + k)
				local br, bi = buffer.readf64(a, s), buffer.readf64(a, s + 8)
				for i = k + 1, n - 1 do
					local off, l = 16 * (j * n + i), 16 * (k * n + i)
					local lr, li = buffer.readf64(a, l), buffer.readf64(a, l + 8)
					buffer.writef64(a, off, buffer.readf64(a, off) - (lr * br - li * bi))
					buffer.writef64(a, off + 8, buffer.readf64(a, off + 8) - (lr * bi + li * br))
				end
			end
		end
	end
	return { lu = A, piv = piv, sign = sign, singular = singular }
end

-- LU factorization of a copy of A; A is not modified.
local function lu_copy(A: Matrix): LU
	return lu(matcopy(nil, A))
end

-- Solves A x = b given F = lu(A).
local function lu_solve(out: buffer?, F: LU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.lu.rows
	assert(buffer.len(b) == 16 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a, piv = F.lu.data, F.piv
	for k = 0, n - 1 do
		local p = piv[k + 1] - 1
		if p ~= k then
			local s, t = 16 * k, 16 * p
			local tr, ti = buffer.readf64(o, s), buffer.readf64(o, s + 8)
			buffer.writef64(o, s, buffer.readf64(o, t))
			buffer.writef64(o, s + 8, buffer.readf64(o, t + 8))
			buffer.writef64(o, t, tr)
			buffer.writef64(o, t + 8, ti)
		end
	end
	for j = 0, n - 1 do
		local xr, xi = buffer.readf64(o, 16 * j), buffer.readf64(o, 16 * j + 8)
		for i = j + 1, n - 1 do
			local off, l = 16 * i, 16 * (j * n + i)
			local lr, li = buffer.readf64(a, l), buffer.readf64(a, l + 8)
			buffer.writef64(o, off, buffer.readf64(o, off) - (lr * xr - li * xi))
			buffer.writef64(o, off + 8, buffer.readf64(o, off + 8) - (lr * xi + li * xr))
		end
	end
	for j = n - 1, 0, -1 do
		local d = 16 * (j * n + j)
		local xr, xi = complex64.div(buffer.readf64(o, 16 * j), buffer.readf64(o, 16 * j + 8), buffer.readf64(a, d), buffer.readf64(a, d + 8))
		buffer.writef64(o, 16 * j, xr)
		buffer.writef64(o, 16 * j + 8, xi)
		for i = 0, j - 1 do
			local off, u = 16 * i, 16 * (j * n + i)
			local ur, ui = buffer.readf64(a, u), buffer.readf64(a, u + 8)
			buffer.writef64(o, off, buffer.readf64(o, off) - (ur * xr - ui * xi))
			buffer.writef64(o, off + 8, buffer.readf64(o, off + 8) - (ur * xi + ui * xr))
		end
	end
	return o
end

local function det_pair(A: Matrix): (number, number)
	local F = lu_copy(A)
	local dr, di = F.sign, 0
	local n = A.rows
	for k = 0, n - 1 do
		local off = 16 * (k * n + k)
		dr, di = complex64.mul(dr, di, buffer.readf64(F.lu.data, off), buffer.readf64(F.lu.data, off + 8))
	end
	return dr, di
end

-- Cholesky

-- Cholesky factorization A = L L^H of a Hermitian positive definite matrix, in place:
-- the lower triangle of A is overwritten with L (whose diagonal is real) and returned as
-- F.chol. Only the lower triangle of A is read, and only the real parts of its diagonal;
-- the strictly upper triangle is left as it was. If A is not positive definite,
-- F.definite is false and A is partly overwritten. chol_copy leaves A unchanged.
local function chol(A: Matrix): Cholesky
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	for j = 0, n - 1 do
		local diag = 16 * (j * n + j)
		local d = buffer.readf64(a, diag)
		if not (d > 0) then
			return { chol = A, definite = false }
		end
		local ljj = math.sqrt(d)
		buffer.writef64(a, diag, ljj)
		buffer.writef64(a, diag + 8, 0)
		for i = j + 1, n - 1 do
			local off = 16 * (j * n + i)
			buffer.writef64(a, off, buffer.readf64(a, off) / ljj)
			buffer.writef64(a, off + 8, buffer.readf64(a, off + 8) / ljj)
		end
		-- Subtract the new column's outer product, l l^H, from the trailing lower triangle.
		for c = j + 1, n - 1 do
			local s = 16 * (j * n + c)
			-- conj(L[c, j])
			local cr, ci = buffer.readf64(a, s), -buffer.readf64(a, s + 8)
			for i = c, n - 1 do
				local off, l = 16 * (c * n + i), 16 * (j * n + i)
				local lr, li = buffer.readf64(a, l), buffer.readf64(a, l + 8)
				buffer.writef64(a, off, buffer.readf64(a, off) - (lr * cr - li * ci))
				buffer.writef64(a, off + 8, buffer.readf64(a, off + 8) - (lr * ci + li * cr))
			end
		end
	end
	return { chol = A, definite = true }
end

-- Cholesky factorization of a copy of A; A is not modified.
local function chol_copy(A: Matrix): Cholesky
	return chol(matcopy(nil, A))
end

-- The lower triangular factor L, with zeros above the diagonal.
local function chol_l(out: Matrix?, F: Cholesky): Matrix
	local n = F.chol.rows
	local o = matoutput(out, n, n)
	local a, l = F.chol.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = 16 * (j * n + i)
			if i >= j then
				buffer.writef64(l, off, buffer.readf64(a, off))
				buffer.writef64(l, off + 8, buffer.readf64(a, off + 8))
			else
				buffer.writef64(l, off, 0)
				buffer.writef64(l, off + 8, 0)
			end
		end
	end
	return o
end

-- Solves A x = b given F = chol(A). b is not modified unless it is passed as out.
local function chol_solve(out: buffer?, F: Cholesky, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local n = F.chol.rows
	assert(buffer.len(b) == 16 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = F.chol.data
	-- L y = b (the diagonal of L is real)
	for j = 0, n - 1 do
		local d = buffer.readf64(a, 16 * (j * n + j))
		local yr, yi = buffer.readf64(o, 16 * j) / d, buffer.readf64(o, 16 * j + 8) / d
		buffer.writef64(o, 16 * j, yr)
		buffer.writef64(o, 16 * j + 8, yi)
		for i = j + 1, n - 1 do
			local off, l = 16 * i, 16 * (j * n + i)
			local lr, li = buffer.readf64(a, l), buffer.readf64(a, l + 8)
			buffer.writef64(o, off, buffer.readf64(o, off) - (lr * yr - li * yi))
			buffer.writef64(o, off + 8, buffer.readf64(o, off + 8) - (lr * yi + li * yr))
		end
	end
	-- L^H x = y, a conjugated dot product down each column of L.
	for j = n - 1, 0, -1 do
		local sr, si = buffer.readf64(o, 16 * j), buffer.readf64(o, 16 * j + 8)
		for i = j + 1, n - 1 do
			local l = 16 * (j * n + i)
			local lr, li = buffer.readf64(a, l), buffer.readf64(a, l + 8)
			local xr, xi = buffer.readf64(o, 16 * i), buffer.readf64(o, 16 * i + 8)
			sr -= lr * xr + li * xi
			si -= lr * xi - li * xr
		end
		local d = buffer.readf64(a, 16 * (j * n + j))
		buffer.writef64(o, 16 * j, sr / d)
		buffer.writef64(o, 16 * j + 8, si / d)
	end
	return o
end

-- Householder QR

-- Unit roundoff of the storage precision.
local EPS = 2 ^ -53

-- Applies I - t v v^H, t = tr + i ti, to the `len` values of x starting at byte offset
-- `xs`. v starts at byte offset `vs` of `a`; its first entry is an implicit 1.
local function reflect(a: buffer, vs: number, len: number, tr: number, ti: number, x: buffer, xs: number)
	local wr, wi = buffer.readf64(x, xs), buffer.readf64(x, xs + 8)
	for i = 1, len - 1 do
		local v, y = vs + 16 * i, xs + 16 * i
		local vr, vi = buffer.readf64(a, v), buffer.readf64(a, v + 8)
		local yr, yi = buffer.readf64(x, y), buffer.readf64(x, y + 8)
		wr += vr * yr + vi * yi
		wi += vr * yi - vi * yr
	end
	if wr == 0 and wi == 0 then
		return
	end
	wr, wi = tr * wr - ti * wi, tr * wi + ti * wr
	buffer.writef64(x, xs, buffer.readf64(x, xs) - wr)
	buffer.writef64(x, xs + 8, buffer.readf64(x, xs + 8) - wi)
	for i = 1, len - 1 do
		local v, y = vs + 16 * i, xs + 16 * i
		local vr, vi = buffer.readf64(a, v), buffer.readf64(a, v + 8)
		buffer.writef64(x, y, buffer.readf64(x, y) - (wr * vr - wi * vi))
		buffer.writef64(x, y + 8, buffer.readf64(x, y + 8) - (wr * vi + wi * vr))
	end
end

-- Turns the `len` values of `a` starting at byte offset `diag` into a Householder
-- reflector, in place: the real beta at `diag` and v below it (its leading 1 is
-- implicit). Stores tau as element k of `tau` and returns it; tau = 0 (H = I) when the
-- value at `diag` is already real and there is nothing below it to zero.
local function householder(a: buffer, diag: number, len: number, tau: buffer, k: number): (number, number)
	local ar, ai = buffer.readf64(a, diag), buffer.readf64(a, diag + 8)
	local xnorm = segment_norm(a, diag + 16, 2 * (len - 1))
	if xnorm == 0 and ai == 0 then
		buffer.writef64(tau, 16 * k, 0)
		buffer.writef64(tau, 16 * k + 8, 0)
		return 0, 0
	end
	local beta = hypot3(ar, ai, xnorm)
	if ar >= 0 then
		beta = -beta
	end
	buffer.writef64(tau, 16 * k, (beta - ar) / beta)
	buffer.writef64(tau, 16 * k + 8, -ai / beta)
	-- Re(alpha) and beta have opposite signs, so alpha - beta cannot cancel.
	local dr = ar - beta
	for off = diag + 16, diag + 16 * (len - 1), 16 do
		local vr, vi = complex64.div(buffer.readf64(a, off), buffer.readf64(a, off + 8), dr, ai)
		buffer.writef64(a, off, vr)
		buffer.writef64(a, off + 8, vi)
	end
	buffer.writef64(a, diag, beta)
	buffer.writef64(a, diag + 8, 0)
	return buffer.readf64(tau, 16 * k), buffer.readf64(tau, 16 * k + 8)
end

-- Solves R z = y in place on the first r entries of y, where R is the leading r by r
-- block of the upper triangle stored in `a` (a matrix with m rows).
local function back_substitute(a: buffer, m: number, r: number, y: buffer)
	for j = r - 1, 0, -1 do
		local d = 16 * (j * m + j)
		local rr, ri = buffer.readf64(a, d), buffer.readf64(a, d + 8)
		assert(rr ~= 0 or ri ~= 0, "matrix is rank deficient")
		local yr, yi = complex64.div(buffer.readf64(y, 16 * j), buffer.readf64(y, 16 * j + 8), rr, ri)
		buffer.writef64(y, 16 * j, yr)
		buffer.writef64(y, 16 * j + 8, yi)
		for i = 0, j - 1 do
			local off, u = 16 * i, 16 * (j * m + i)
			local ur, ui = buffer.readf64(a, u), buffer.readf64(a, u + 8)
			buffer.writef64(y, off, buffer.readf64(y, off) - (ur * yr - ui * yi))
			buffer.writef64(y, off + 8, buffer.readf64(y, off + 8) - (ur * yi + ui * yr))
		end
	end
end

-- Householder QR factorization, in place: A is overwritten (see types.QR for the layout)
-- and returned as F.qr. The diagonal of R is real. qr_copy leaves A unchanged.
local function qr(A: Matrix): QR
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(16 * kmax)
	for k = 0, kmax - 1 do
		local diag = 16 * (k * m + k)
		local tr, ti = householder(a, diag, m - k, tau, k)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, 16 * (j * m + k))
			end
		end
	end
	return { qr = A, tau = tau }
end

-- Householder QR factorization of a copy of A; A is not modified.
local function qr_copy(A: Matrix): QR
	return qr(matcopy(nil, A))
end

-- x := Q^H x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_qh(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == 16 * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = 0, buffer.len(tau) // 16 - 1 do
		local tr, ti = buffer.readf64(tau, 16 * k), buffer.readf64(tau, 16 * k + 8)
		reflect(a, 16 * (k * m + k), m - k, tr, -ti, x, 16 * k)
	end
	return x
end

-- x := Q x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_q(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == 16 * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = buffer.len(tau) // 16 - 1, 0, -1 do
		local tr, ti = buffer.readf64(tau, 16 * k), buffer.readf64(tau, 16 * k + 8)
		reflect(a, 16 * (k * m + k), m - k, tr, ti, x, 16 * k)
	end
	return x
end

-- The min(rows, cols) by cols upper triangular factor R. Also accepts a QRP factorization.
local function qr_r(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, kmax, n)
	local a, r = F.qr.data, o.data
	for j = 0, n - 1 do
		for i = 0, kmax - 1 do
			local s, t = 16 * (j * m + i), 16 * (j * kmax + i)
			if i <= j then
				buffer.writef64(r, t, buffer.readf64(a, s))
				buffer.writef64(r, t + 8, buffer.readf64(a, s + 8))
			else
				buffer.writef64(r, t, 0)
				buffer.writef64(r, t + 8, 0)
			end
		end
	end
	return o
end

-- The rows by min(rows, cols) factor Q with orthonormal columns (the thin Q). Also
-- accepts a QRP factorization.
local function qr_q(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, m, kmax)
	local a, tau, q = F.qr.data, F.tau, o.data
	buffer.fill(q, 0, 0)
	for c = 0, kmax - 1 do
		buffer.writef64(q, 16 * (c * m + c), 1)
		-- Reflectors after column c leave the unit vector e_c unchanged.
		for k = c, 0, -1 do
			local tr, ti = buffer.readf64(tau, 16 * k), buffer.readf64(tau, 16 * k + 8)
			reflect(a, 16 * (k * m + k), m - k, tr, ti, q, 16 * (c * m + k))
		end
	end
	return o
end

-- Least squares: the x minimizing |A x - b| for A with rows >= cols and full column
-- rank, given F = qr(A). b is not modified. Also returns the residual norm |A x - b|.
local function qr_solve(out: buffer?, F: QR, b: buffer): (buffer, number)
	local m, n = F.qr.rows, F.qr.cols
	assert(m >= n, "least squares needs at least as many rows as columns")
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, n, y)
	local o = output(out, 16 * n)
	buffer.copy(o, 0, y, 0, 16 * n)
	return o, segment_norm(y, 16 * n, 2 * (m - n))
end

-- Column-pivoted QR

-- Householder QR with column pivoting, A P = Q R, in place: A is overwritten as in qr and
-- returned as F.qr; column j of A P is column perm[j] of A. Each step moves the remaining
-- column of largest norm to the front, so |R_11| >= |R_22| >= ... and small trailing
-- diagonal entries reveal the numerical rank. qrp_copy leaves A unchanged.
local function qrp(A: Matrix): QRP
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(16 * kmax)
	local perm = table.create(n, 0)
	-- Norms of the unfactored part of each column (partial), and the norm at the last
	-- recomputation (reference), for LAPACK's safeguarded downdating.
	local partial, reference = table.create(n, 0), table.create(n, 0)
	for j = 1, n do
		perm[j] = j
		local v = segment_norm(a, 16 * (j - 1) * m, 2 * m)
		partial[j], reference[j] = v, v
	end
	local recompute = math.sqrt(EPS)
	for k = 0, kmax - 1 do
		local p, best = k, -1
		for j = k, n - 1 do
			if partial[j + 1] > best then
				p, best = j, partial[j + 1]
			end
		end
		if p ~= k then
			for i = 0, m - 1 do
				local s, t = 16 * (k * m + i), 16 * (p * m + i)
				local sr, si = buffer.readf64(a, s), buffer.readf64(a, s + 8)
				buffer.writef64(a, s, buffer.readf64(a, t))
				buffer.writef64(a, s + 8, buffer.readf64(a, t + 8))
				buffer.writef64(a, t, sr)
				buffer.writef64(a, t + 8, si)
			end
			perm[k + 1], perm[p + 1] = perm[p + 1], perm[k + 1]
			partial[p + 1], reference[p + 1] = partial[k + 1], reference[k + 1]
		end

		local diag = 16 * (k * m + k)
		local tr, ti = householder(a, diag, m - k, tau, k)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, 16 * (j * m + k))
			end
		end

		-- Remove row k from the remaining partial norms. When cancellation would leave too
		-- few correct digits, recompute the norm instead.
		for j = k + 1, n - 1 do
			local v = partial[j + 1]
			if v ~= 0 then
				local off = 16 * (j * m + k)
				local ratio = complex64.abs(buffer.readf64(a, off), buffer.readf64(a, off + 8)) / v
				local left = math.max(0, 1 - ratio * ratio)
				local drift = v / reference[j + 1]
				if left * drift * drift <= recompute then
					local fresh = segment_norm(a, off + 16, 2 * (m - k - 1))
					partial[j + 1], reference[j + 1] = fresh, fresh
				else
					partial[j + 1] = v * math.sqrt(left)
				end
			end
		end
	end
	return { qr = A, tau = tau, perm = perm }
end

-- Column-pivoted QR of a copy of A; A is not modified.
local function qrp_copy(A: Matrix): QRP
	return qrp(matcopy(nil, A))
end

-- Numerical rank: the number of leading diagonal entries of R with |R_kk| > tol |R_11|.
-- The default tol is max(rows, cols) times the unit roundoff of the storage precision.
local function qrp_rank(F: QRP, tol: number?): number
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	if kmax == 0 then
		return 0
	end
	local a = F.qr.data
	local limit = (tol or math.max(m, n) * EPS) * complex64.abs(buffer.readf64(a, 0), buffer.readf64(a, 8))
	for k = 0, kmax - 1 do
		local d = 16 * (k * m + k)
		if not (complex64.abs(buffer.readf64(a, d), buffer.readf64(a, d + 8)) > limit) then
			return k
		end
	end
	return kmax
end

-- Least squares for any shape and rank, given F = qrp(A): the basic solution, which
-- uses only the first r = qrp_rank(F, tol) pivot columns and sets the other variables
-- to zero. b is not modified. Also returns the residual norm |A x - b| and r.
local function qrp_solve(out: buffer?, F: QRP, b: buffer, tol: number?): (buffer, number, number)
	local m, n = F.qr.rows, F.qr.cols
	local r = qrp_rank(F, tol)
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, r, y)
	local o = output(out, 16 * n)
	buffer.fill(o, 0, 0)
	for j = 1, r do
		local s, t = 16 * (j - 1), 16 * (F.perm[j] - 1)
		buffer.writef64(o, t, buffer.readf64(y, s))
		buffer.writef64(o, t + 8, buffer.readf64(y, s + 8))
	end
	return o, segment_norm(y, 16 * r, 2 * (m - r)), r
end

-- Functions taking or returning complex scalars. The *_pair functions above pass them
-- as (re, im) number pairs; each type exports them in its own scalar format.

local function get(x: buffer, i: number): (number, number)
	local k = 16 * (i - 1)
	return buffer.readf64(x, k), buffer.readf64(x, k + 8)
end

local function set(x: buffer, i: number, re: number, im: number)
	local k = 16 * (i - 1)
	buffer.writef64(x, k, re)
	buffer.writef64(x, k + 8, im)
end

local function matget(A: Matrix, i: number, j: number): (number, number)
	local k = 16 * ((j - 1) * A.rows + i - 1)
	return buffer.readf64(A.data, k), buffer.readf64(A.data, k + 8)
end

local function matset(A: Matrix, i: number, j: number, re: number, im: number)
	local k = 16 * ((j - 1) * A.rows + i - 1)
	buffer.writef64(A.data, k, re)
	buffer.writef64(A.data, k + 8, im)
end

local fill = fill_pair
local cscale = cscale_pair
local caxpy = caxpy_pair
local dot = dotu_pair
local dotc = dotc_pair
local sum = sum_pair
local det = det_pair

-- Solves A x = b. `form` says what A is:
--   "matrix" (or nil)  a matrix. Square: LU with partial pivoting. More rows than
--                      columns: the least-squares solution, by Householder QR. More
--                      columns than rows: the basic solution, by column-pivoted QR.
--   "lu"               a factorization from lu or lu_copy
--   "qr"               a factorization from qr or qr_copy (least squares if tall)
--   "qrp"              a factorization from qrp or qrp_copy (any shape or rank; see
--                      qrp_solve, whose default rank tolerance is used)
--   "chol"             a factorization from chol or chol_copy
-- Neither A nor b is modified.
local function solve(out: buffer?, A: Matrix | LU | QR | QRP | Cholesky, b: buffer, form: Form?): buffer
	local t = A :: any
	if form == "lu" then
		assert(type(t) == "table" and t.lu ~= nil, `solve: form "lu" needs a factorization from lu`)
		return lu_solve(out, A :: LU, b)
	elseif form == "qr" then
		assert(type(t) == "table" and t.qr ~= nil, `solve: form "qr" needs a factorization from qr`)
		assert(t.perm == nil, `solve: this is a pivoted factorization; use form "qrp"`)
		return (qr_solve(out, A :: QR, b))
	elseif form == "qrp" then
		assert(type(t) == "table" and t.perm ~= nil, `solve: form "qrp" needs a factorization from qrp`)
		return (qrp_solve(out, A :: QRP, b))
	elseif form == "chol" then
		assert(type(t) == "table" and t.chol ~= nil, `solve: form "chol" needs a factorization from chol`)
		return chol_solve(out, A :: Cholesky, b)
	end
	assert(form == nil or form == "matrix", `solve: unknown form {form}`)
	assert(type(t) == "table" and t.data ~= nil, "solve: A is not a matrix (pass its form)")
	local M = A :: Matrix
	if M.rows == M.cols then
		return lu_solve(out, lu_copy(M), b)
	elseif M.rows > M.cols then
		return (qr_solve(out, qr_copy(M), b))
	end
	return (qrp_solve(out, qrp_copy(M), b))
end

