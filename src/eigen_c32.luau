-- Reals per matrix entry, for the shared tridiagonal eigensolver.
local PARTS = 2

-- Implicit symmetric QR with Wilkinson shifts on the real symmetric tridiagonal matrix
-- with diagonal d[1..n] and off-diagonal e[1..n-1]. d and e are Luau tables, so the
-- iteration runs in double precision whatever the storage precision. On return d holds
-- the eigenvalues in ascending order and e is destroyed. If z is given (an n by n matrix
-- whose entries are PARTS reals each), every rotation is applied to its columns and the
-- columns are sorted with the eigenvalues.
local function tridiagonal_eigen(d: { number }, e: { number }, z: buffer?, n: number)
	local column = 4 * PARTS * n
	local reals = PARTS * n

	-- Columns k and k+1 (1-based) of z := [c z_k + s z_k+1, -s z_k + c z_k+1].
	local function rotate(zb: buffer, k: number, c: number, s: number)
		local p, q = column * (k - 1), column * k
		for i = 0, reals - 1 do
			local zp, zq = buffer.readf32(zb, p + (4 * i)), buffer.readf32(zb, q + (4 * i))
			buffer.writef32(zb, p + (4 * i), c * zp + s * zq)
			buffer.writef32(zb, q + (4 * i), c * zq - s * zp)
		end
	end

	-- e[i] is negligible next to its diagonal neighbours (LAPACK's steqr test).
	local function negligible(i: number): boolean
		local v = math.abs(e[i])
		return v <= 2 ^ -53 * math.sqrt(math.abs(d[i])) * math.sqrt(math.abs(d[i + 1])) or v < 2 ^ -1000
	end

	local iterations, limit = 0, 30 * math.max(n, 1)
	local h = n
	while h > 1 do
		if negligible(h - 1) then
			e[h - 1] = 0
			h -= 1
			continue
		end
		-- The unreduced block is l..h.
		local l = h - 1
		while l > 1 and not negligible(l - 1) do
			l -= 1
		end
		if l > 1 then
			e[l - 1] = 0
		end
		iterations += 1
		if iterations > limit then
			error("eigh: the QR iteration did not converge")
		end

		-- Wilkinson shift: the eigenvalue of the trailing 2 by 2 block closer to d[h].
		local half = (d[h - 1] - d[h]) / 2
		local eh = e[h - 1]
		local r = hypot3(half, eh, 0)
		local mu = d[h] - eh * (eh / (half + (if half >= 0 then r else -r)))

		-- Chase the bulge from the top of the block to the bottom.
		local x, bulge = d[l] - mu, e[l]
		for k = l, h - 1 do
			local c, s, len = 1, 0, x
			if bulge ~= 0 then
				len = hypot3(x, bulge, 0)
				c, s = x / len, bulge / len
			end
			if k > l then
				e[k - 1] = len
			end
			local a, b, cc = d[k], e[k], d[k + 1]
			d[k] = c * c * a + 2 * c * s * b + s * s * cc
			d[k + 1] = s * s * a - 2 * c * s * b + c * c * cc
			e[k] = c * s * (cc - a) + (c * c - s * s) * b
			if k < h - 1 then
				x = e[k]
				bulge = s * e[k + 1]
				e[k + 1] = c * e[k + 1]
			end
			if z then
				rotate(z, k, c, s)
			end
		end
	end

	-- Selection sort into ascending order, moving the columns of z along.
	for i = 1, n - 1 do
		local best = i
		for j = i + 1, n do
			if d[j] < d[best] then
				best = j
			end
		end
		if best ~= i then
			d[i], d[best] = d[best], d[i]
			if z then
				local p, q = column * (i - 1), column * (best - 1)
				for k = 0, reals - 1 do
					local tmp = buffer.readf32(z, p + (4 * k))
					buffer.writef32(z, p + (4 * k), buffer.readf32(z, q + (4 * k)))
					buffer.writef32(z, q + (4 * k), tmp)
				end
			end
		end
	end
end

-- In place, LAPACK's ung2r: the `count` reflectors stored below the diagonal of the first
-- columns of the `rows` by `cols` block at (r0, r0) of the matrix in `a` (leading
-- dimension ld, with their tau values in `tau`) are replaced by the first `cols` columns
-- of the block's Q = H_1 ... H_count.
local function form_q(a: buffer, ld: number, r0: number, rows: number, cols: number, count: number, tau: buffer)
	for j = count, cols - 1 do
		for i = 0, rows - 1 do
			do
				local here_ = 8 * ((r0 + j) * ld + r0 + i)
				buffer.writef32(a, here_, if i == j then 1 else 0)
				buffer.writef32(a, here_ + 4, 0)
			end
		end
	end
	for i = count - 1, 0, -1 do
		local tr, ti = buffer.readf32(tau, 8 * i), buffer.readf32(tau, (8 * i) + 4) :: number
		for j = i + 1, cols - 1 do
			reflect(a, 8 * ((r0 + i) * ld + r0 + i), rows - i, tr, ti, a, 8 * ((r0 + j) * ld + r0 + i))
		end
		for r = i + 1, rows - 1 do
			local off = 8 * ((r0 + i) * ld + r0 + r)
			local vr, vi = buffer.readf32(a, off), buffer.readf32(a, off + 4) :: number
			buffer.writef32(a, off, -(tr * vr - ti * vi))
			buffer.writef32(a, off + 4, -(tr * vi + ti * vr))
		end
		do
			local here_ = 8 * ((r0 + i) * ld + r0 + i)
			buffer.writef32(a, here_, 1 - tr)
			buffer.writef32(a, here_ + 4, -ti)
		end
		for r = 0, i - 1 do
			do
				local here_ = 8 * ((r0 + i) * ld + r0 + r)
				buffer.writef32(a, here_, 0)
				buffer.writef32(a, here_ + 4, 0)
			end
		end
	end
end

-- Forms in place the n by n Q = H_0 ... H_count-1 of a Hessenberg or tridiagonal
-- reduction, whose reflector k acts on rows k+1.. and is stored below row k+1 of column k.
local function form_reduction_q(a: buffer, n: number, count: number, tau: buffer)
	if n == 0 then
		return
	end
	-- Move each reflector one column right, so that it sits below the diagonal of the
	-- trailing n-1 by n-1 block, where form_q expects it.
	for k = count - 1, 0, -1 do
		for i = k + 2, n - 1 do
			local s = 8 * (k * n + i)
			do
				local here_ = 8 * ((k + 1) * n + i)
				buffer.writef32(a, here_, buffer.readf32(a, s))
				buffer.writef32(a, here_ + 4, buffer.readf32(a, s + 4))
			end
		end
	end
	for i = 0, n - 1 do
		local one = if i == 0 then 1 else 0
		do
			local here_ = 8 * (0 * n + i)
			buffer.writef32(a, here_, one)
			buffer.writef32(a, here_ + 4, 0)
		end
		do
			local here_ = 8 * (i * n + 0)
			buffer.writef32(a, here_, one)
			buffer.writef32(a, here_ + 4, 0)
		end
	end
	form_q(a, n, 1, n - 1, n - 1, count, tau)
end

-- Hessenberg reduction restricted to rows and columns ilo..ihi (0-based), for a matrix
-- that is already upper triangular outside that block (as balancing leaves it): only
-- reflectors inside the block are made (tau = 0 elsewhere), but they are applied to the
-- whole matrix.
local function hess_range(A: Matrix, ilo: number, ihi: number): Hessenberg
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local count = math.max(n - 2, 0)
	local tau = create(count)
	local wr, wi = table.create(n, 0), table.create(n, 0)
	for k = ilo, ihi - 2 do
		local vs = 8 * (k * n + (k + 1))
		local len = ihi - k
		local tr, ti = householder(a, vs, len, tau, k)
		if tr ~= 0 or ti ~= 0 then
			-- From the left, H^H: rows k+1.. of columns k+1..
			for j = k + 1, n - 1 do
				reflect(a, vs, len, tr, -ti, a, 8 * (j * n + (k + 1)))
			end
			-- From the right: A := A - tau (A v) v^H on columns k+1..
			for i = 0, ihi do
				wr[i + 1], wi[i + 1] = buffer.readf32(a, 8 * ((k + 1) * n + i)), buffer.readf32(a, (8 * ((k + 1) * n + i)) + 4) :: number
			end
			for c = 1, len - 1 do
				local vr, vi = buffer.readf32(a, vs + (8 * c)), buffer.readf32(a, (vs + (8 * c)) + 4) :: number
				local col = 8 * ((k + 1 + c) * n + 0)
				for i = 0, ihi do
					local ar, ai = buffer.readf32(a, col + (8 * i)), buffer.readf32(a, (col + (8 * i)) + 4) :: number
					wr[i + 1] += ar * vr - ai * vi
					wi[i + 1] += ar * vi + ai * vr
				end
			end
			for c = 0, len - 1 do
				local vr, vi = 1, 0
				if c > 0 then
					vr, vi = buffer.readf32(a, vs + (8 * c)), buffer.readf32(a, (vs + (8 * c)) + 4) :: number
				end
				-- tau conj(v_c)
				local fr, fi = tr * vr + ti * vi, ti * vr - tr * vi
				local col = 8 * ((k + 1 + c) * n + 0)
				for i = 0, ihi do
					local xr, xi = wr[i + 1], wi[i + 1]
					do
						local here_ = col + (8 * i)
						buffer.writef32(a, here_, buffer.readf32(a, here_) - (xr * fr - xi * fi))
						buffer.writef32(a, here_ + 4, buffer.readf32(a, here_ + 4) - (xr * fi + xi * fr))
					end
				end
			end
		end
	end
	return { hess = A, tau = tau }
end

-- Upper Hessenberg reduction A = Q H Q^H (^T for real A), in place: A is overwritten with H
-- on and above the subdiagonal and, below it, the reflectors H_k = I - tau_k v_k v_k^H (v_k
-- has a 1 in row k+1, not stored, and is stored below that in column k).
-- Q = H_0 ... H_n-3. hess_copy leaves A unchanged.
local function hess(A: Matrix): Hessenberg
	return hess_range(A, 0, A.rows - 1)
end

-- Hessenberg reduction of a copy of A; A is not modified.
local function hess_copy(A: Matrix): Hessenberg
	return hess(matcopy(nil, A))
end

-- The upper Hessenberg factor H, with zeros below the subdiagonal.
local function hess_h(out: Matrix?, F: Hessenberg): Matrix
	local n = F.hess.rows
	local o = matoutput(out, n, n)
	local a, h = F.hess.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = 8 * (j * n + i)
			if i <= j + 1 then
				buffer.writef32(h, off, buffer.readf32(a, off))
				buffer.writef32(h, off + 4, buffer.readf32(a, off + 4))
			else
				buffer.writef32(h, off, 0)
				buffer.writef32(h, off + 4, 0)
			end
		end
	end
	return o
end

-- The unitary factor Q.
local function hess_q(out: Matrix?, F: Hessenberg): Matrix
	local n = F.hess.rows
	local o = matcopy(out, F.hess)
	form_reduction_q(o.data, n, length(F.tau), F.tau)
	return o
end

-- Reduces the Hermitian matrix whose lower triangle is in A to real symmetric tridiagonal
-- form, A = Q T Q^H, in place (LAPACK's hetd2): returns T's diagonal d and off-diagonal e
-- as tables and leaves the reflectors (stored as in hess) and their tau in A and `tau`.
-- Only the real parts of the diagonal of A are read.
local function tridiagonalize(A: Matrix): ({ number }, { number }, buffer)
	local n = A.rows
	local a = A.data
	local count = math.max(n - 1, 0)
	local tau = create(count)
	local d, e = table.create(n, 0), table.create(count, 0)
	local vr, vi = table.create(n, 0), table.create(n, 0)
	local xr, xi = table.create(n, 0), table.create(n, 0)
	for k = 0, count - 1 do
		local vs = 8 * (k * n + (k + 1))
		local len = n - k - 1
		local tr, ti = householder(a, vs, len, tau, k)
		e[k + 1] = buffer.readf32(a, vs)
		if tr ~= 0 or ti ~= 0 then
			vr[1], vi[1] = 1, 0
			for r = 1, len - 1 do
				vr[r + 1], vi[r + 1] = buffer.readf32(a, vs + (8 * r)), buffer.readf32(a, (vs + (8 * r)) + 4) :: number
			end
			-- y = A22 v from the lower triangle of A22 = A[k+1.., k+1..] (real diagonal).
			for r = 1, len do
				xr[r], xi[r] = 0, 0
			end
			for c = 0, len - 1 do
				local col = 8 * ((k + 1 + c) * n + (k + 1))
				local cr, ci = vr[c + 1], vi[c + 1]
				local diag = buffer.readf32(a, col + (8 * c))
				local accr, acci = diag * cr, diag * ci
				for r = c + 1, len - 1 do
					local ar, ai = buffer.readf32(a, col + (8 * r)), buffer.readf32(a, (col + (8 * r)) + 4) :: number
					-- A[r, c] v_c
					xr[r + 1] += ar * cr - ai * ci
					xi[r + 1] += ar * ci + ai * cr
					-- conj(A[r, c]) v_r
					local pr, pi = vr[r + 1], vi[r + 1]
					accr += ar * pr + ai * pi
					acci += ar * pi - ai * pr
				end
				xr[c + 1] += accr
				xi[c + 1] += acci
			end
			-- x = tau y, and x^H v
			local sr, si = 0, 0
			for r = 1, len do
				local yr, yi = xr[r], xi[r]
				xr[r], xi[r] = tr * yr - ti * yi, tr * yi + ti * yr
				sr += xr[r] * vr[r] + xi[r] * vi[r]
				si += xr[r] * vi[r] - xi[r] * vr[r]
			end
			-- w = x + alpha v with alpha = -(tau / 2) (x^H v)
			local alr, ali = -0.5 * (tr * sr - ti * si), -0.5 * (tr * si + ti * sr)
			for r = 1, len do
				local pr, pi = vr[r], vi[r]
				xr[r] += alr * pr - ali * pi
				xi[r] += alr * pi + ali * pr
			end
			-- A22 := A22 - v w^H - w v^H on the lower triangle; the diagonal stays real.
			for c = 0, len - 1 do
				local col = 8 * ((k + 1 + c) * n + (k + 1))
				local cvr, cvi, cwr, cwi = vr[c + 1], vi[c + 1], xr[c + 1], xi[c + 1]
				for r = c, len - 1 do
					local off = col + (8 * r)
					local pr, pi, qr, qi = vr[r + 1], vi[r + 1], xr[r + 1], xi[r + 1]
					-- v_r conj(w_c) + w_r conj(v_c)
					local ur = pr * cwr + pi * cwi + qr * cvr + qi * cvi
					local ui = pi * cwr - pr * cwi + qi * cvr - qr * cvi
					buffer.writef32(a, off, buffer.readf32(a, off) - ur)
					buffer.writef32(a, off + 4, if r == c then 0 else buffer.readf32(a, off + 4) - ui)
				end
			end
		end
		d[k + 1] = buffer.readf32(a, 8 * (k * n + k))
	end
	if n > 0 then
		d[n] = buffer.readf32(a, 8 * ((n - 1) * n + (n - 1)))
	end
	return d, e, tau
end

-- Eigenvalues (ascending, as a real array of the same precision) and, unless vectors is
-- false, orthonormal eigenvectors of a Hermitian matrix, in place: only the lower
-- triangle of A (and the real parts of its diagonal) is read, and A is overwritten with
-- the eigenvectors (column j belongs to values[j]), or with workspace if vectors is false.
-- Tridiagonalization, then implicit QR with Wilkinson shifts in double precision. If the
-- part read holds a NaN or an infinity, the values and A are all NaN. eigh_copy leaves A
-- unchanged.
local function eigh(A: Matrix, vectors: boolean?): Eigh
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local want = vectors ~= false
	-- Non-finite input (in the part that is read: the lower triangle without the imaginary
	-- parts of the diagonal) gives NaN values and a NaN A.
	for j = 0, n - 1 do
		local o = 8 * (j * n + j)
		if any_nonfinite(A.data, o, 1) or any_nonfinite(A.data, o + (8 * 1), 2 * (n - j - 1)) then
			local values = buffer.create(4 * n)
			fill_nan(values, 0, n)
			fill_nan(A.data, 0, 2 * n * n)
			return { values = values, vectors = if want then A else nil }
		end
	end
	-- Scaled into a safe range (see range_factor), by the part that is read; the values are
	-- scaled back and the vectors do not change.
	local big = 0
	for j = 0, n - 1 do
		big = math.max(big, math.abs(buffer.readf32(A.data, 8 * (j * n + j))))
		for i = j + 1, n - 1 do
			local o = 8 * (j * n + i)
			big = math.max(big, math.abs(buffer.readf32(A.data, o)), math.abs(buffer.readf32(A.data, o + 4)))
		end
	end
	local sc = range_factor(big)
	if sc ~= 1 then
		scale(A.data, sc, A.data)
	end
	local d, e, tau = tridiagonalize(A)
	if want then
		form_reduction_q(A.data, n, length(tau), tau)
	end
	tridiagonal_eigen(d, e, if want then A.data else nil, n)
	local values = buffer.create(4 * n)
	for i = 1, n do
		buffer.writef32(values, 4 * (i - 1), d[i] / sc)
	end
	return { values = values, vectors = if want then A else nil }
end

-- Hermitian eigendecomposition of a copy of A; A is not modified.
local function eigh_copy(A: Matrix, vectors: boolean?): Eigh
	return eigh(matcopy(nil, A), vectors)
end

-- Nonsymmetric eigenvalues

local function cabs1(re: number, im: number): number
	return math.abs(re) + math.abs(im)
end

-- A reflector I - tau v v^H, v = (1, v2), taking (alpha, x) to (beta, 0) with beta real.
-- Returns beta, tau and v2 (complex numbers as pairs).
local function small_reflector(ar: number, ai: number, xr: number, xi: number): (number, number, number, number, number)
	local xnorm = hypot3(xr, xi, 0)
	if xnorm == 0 and ai == 0 then
		return ar, 0, 0, 0, 0
	end
	local beta = hypot3(ar, ai, xnorm)
	if ar >= 0 then
		beta = -beta
	end
	local v2r, v2i = complex64.div(xr, xi, ar - beta, ai)
	return beta, (beta - ar) / beta, -ai / beta, v2r, v2i
end

-- Single-shift Francis QR (LAPACK's lahqr for complex matrices) on the upper Hessenberg
-- matrix in h (n by n, zero below the subdiagonal), in place. With wantt, h becomes the
-- upper triangular Schur form T. With z, the unitary transformations are accumulated
-- into its columns. Returns the eigenvalues (real and imaginary parts) in the order of
-- T's diagonal.
local function complex_schur(h: buffer, n: number, wantt: boolean, z: buffer?, ilo: number, ihi: number): ({ number }, { number })
	local wr, wi = table.create(n, 0), table.create(n, 0)
	local ulp = 2 * EPS
	local smlnum = 2 ^ -1000 * (n / ulp)
	local itmax = 30 * math.max(10, n)
	local kdefl = 0
	-- Eigenvalues outside ilo..ihi were isolated by balancing: they are on the diagonal.
	for k = 0, n - 1 do
		if k < ilo or k > ihi then
			wr[k + 1], wi[k + 1] = buffer.readf32(h, 8 * (k * n + k)), buffer.readf32(h, (8 * (k * n + k)) + 4) :: number
		end
	end
	local i = ihi
	while i >= ilo do
		local l = ilo
		local converged = false
		for _ = 0, itmax do
			-- Look for a negligible subdiagonal entry (Ahues and Tisseur's test).
			local k = i
			while k > l do
				local sub = math.abs(buffer.readf32(h, 8 * ((k - 1) * n + k))) + math.abs(buffer.readf32(h, (8 * ((k - 1) * n + k)) + 4))
				if sub <= smlnum then
					break
				end
				local tst = (math.abs(buffer.readf32(h, 8 * ((k - 1) * n + (k - 1)))) + math.abs(buffer.readf32(h, (8 * ((k - 1) * n + (k - 1))) + 4))) + (math.abs(buffer.readf32(h, 8 * (k * n + k))) + math.abs(buffer.readf32(h, (8 * (k * n + k)) + 4)))
				if tst == 0 then
					if k - 2 >= ilo then
						tst += math.abs(buffer.readf32(h, 8 * ((k - 2) * n + (k - 1)))) + math.abs(buffer.readf32(h, (8 * ((k - 2) * n + (k - 1))) + 4))
					end
					if k + 1 <= ihi then
						tst += math.abs(buffer.readf32(h, 8 * (k * n + (k + 1)))) + math.abs(buffer.readf32(h, (8 * (k * n + (k + 1))) + 4))
					end
				end
				if sub <= ulp * tst then
					local sup = math.abs(buffer.readf32(h, 8 * (k * n + (k - 1)))) + math.abs(buffer.readf32(h, (8 * (k * n + (k - 1))) + 4))
					local ab, ba = math.max(sub, sup), math.min(sub, sup)
					local pr, pi = buffer.readf32(h, 8 * ((k - 1) * n + (k - 1))), buffer.readf32(h, (8 * ((k - 1) * n + (k - 1))) + 4) :: number
					local qr, qi = buffer.readf32(h, 8 * (k * n + k)), buffer.readf32(h, (8 * (k * n + k)) + 4) :: number
					local hkk, gap = cabs1(qr, qi), cabs1(pr - qr, pi - qi)
					local aa, bb = math.max(hkk, gap), math.min(hkk, gap)
					local s = aa + ab
					if ba * (ab / s) <= math.max(smlnum, ulp * (bb * (aa / s))) then
						break
					end
				end
				k -= 1
			end
			l = k
			if l > ilo then
				do
					local here__ = 8 * ((l - 1) * n + l)
					buffer.writef32(h, here__, 0)
					buffer.writef32(h, here__ + 4, 0)
				end
			end
			if l >= i then
				converged = true
				break
			end
			kdefl += 1
			local i1, i2 = if wantt then 0 else l, if wantt then n - 1 else i

			-- Shift: Wilkinson's (the eigenvalue of the trailing 2 by 2 block closer to the
			-- bottom corner), or an exceptional shift after 10 (top) or 20 (bottom)
			-- iterations without a deflation.
			local tr, ti
			if kdefl % 20 == 0 then
				local hr, hi = buffer.readf32(h, 8 * (i * n + i)), buffer.readf32(h, (8 * (i * n + i)) + 4) :: number
				tr, ti = hr + 0.75 * (math.abs(buffer.readf32(h, 8 * ((i - 1) * n + i))) + math.abs(buffer.readf32(h, (8 * ((i - 1) * n + i)) + 4))), hi
			elseif kdefl % 10 == 0 then
				local hr, hi = buffer.readf32(h, 8 * (l * n + l)), buffer.readf32(h, (8 * (l * n + l)) + 4) :: number
				tr, ti = hr + 0.75 * (math.abs(buffer.readf32(h, 8 * (l * n + (l + 1)))) + math.abs(buffer.readf32(h, (8 * (l * n + (l + 1))) + 4))), hi
			else
				tr, ti = buffer.readf32(h, 8 * (i * n + i)), buffer.readf32(h, (8 * (i * n + i)) + 4) :: number
				local br, bi = buffer.readf32(h, 8 * (i * n + (i - 1))), buffer.readf32(h, (8 * (i * n + (i - 1))) + 4) :: number
				local cr, ci = buffer.readf32(h, 8 * ((i - 1) * n + i)), buffer.readf32(h, (8 * ((i - 1) * n + i)) + 4) :: number
				-- (Separate locals: only the last argument of a call expands to all its values.)
				local sbr, sbi = complex64.sqrt(br, bi)
				local scr, sci = complex64.sqrt(cr, ci)
				local ur, ui = complex64.mul(sbr, sbi, scr, sci)
				local s = cabs1(ur, ui)
				if s ~= 0 then
					local ar, ai = buffer.readf32(h, 8 * ((i - 1) * n + (i - 1))), buffer.readf32(h, (8 * ((i - 1) * n + (i - 1))) + 4) :: number
					local xr, xi = 0.5 * (ar - tr), 0.5 * (ai - ti)
					local sx = cabs1(xr, xi)
					s = math.max(s, sx)
					local qr, qi = complex64.mul(xr / s, xi / s, xr / s, xi / s)
					local pr, pi = complex64.mul(ur / s, ui / s, ur / s, ui / s)
					local yr, yi = complex64.sqrt(qr + pr, qi + pi)
					yr, yi = s * yr, s * yi
					if sx > 0 and (xr / sx) * yr + (xi / sx) * yi < 0 then
						yr, yi = -yr, -yi
					end
					local dr, di = complex64.div(ur, ui, xr + yr, xi + yi)
					local er, ei = complex64.mul(ur, ui, dr, di)
					tr, ti = tr - er, ti - ei
				end
			end

			-- Look for two consecutive small subdiagonal entries, to start lower.
			local m = i - 1
			local v1r, v1i, v2r, v2i = 0, 0, 0, 0
			while true do
				local h11r, h11i = buffer.readf32(h, 8 * (m * n + m)), buffer.readf32(h, (8 * (m * n + m)) + 4) :: number
				local h22r, h22i = buffer.readf32(h, 8 * ((m + 1) * n + (m + 1))), buffer.readf32(h, (8 * ((m + 1) * n + (m + 1))) + 4) :: number
				local sr, si = h11r - tr, h11i - ti
				local h21r, h21i = buffer.readf32(h, 8 * (m * n + (m + 1))), buffer.readf32(h, (8 * (m * n + (m + 1))) + 4) :: number
				local s = cabs1(sr, si) + cabs1(h21r, h21i)
				v1r, v1i, v2r, v2i = sr / s, si / s, h21r / s, h21i / s
				if m == l then
					break
				end
				local h10 = math.abs(buffer.readf32(h, 8 * ((m - 1) * n + m))) + math.abs(buffer.readf32(h, (8 * ((m - 1) * n + m)) + 4))
				if h10 * cabs1(v2r, v2i) <= ulp * (cabs1(v1r, v1i) * (cabs1(h11r, h11i) + cabs1(h22r, h22i))) then
					break
				end
				m -= 1
			end

			-- The single-shift step: chase the bulge from row m to the bottom.
			for k2 = m, i - 1 do
				if k2 > m then
					v1r, v1i = buffer.readf32(h, 8 * ((k2 - 1) * n + k2)), buffer.readf32(h, (8 * ((k2 - 1) * n + k2)) + 4) :: number
					v2r, v2i = buffer.readf32(h, 8 * ((k2 - 1) * n + (k2 + 1))), buffer.readf32(h, (8 * ((k2 - 1) * n + (k2 + 1))) + 4) :: number
				end
				local beta, t1r, t1i, w2r, w2i = small_reflector(v1r, v1i, v2r, v2i)
				if k2 > m then
					do
						local here__ = 8 * ((k2 - 1) * n + k2)
						buffer.writef32(h, here__, beta)
						buffer.writef32(h, here__ + 4, 0)
					end
					do
						local here__ = 8 * ((k2 - 1) * n + (k2 + 1))
						buffer.writef32(h, here__, 0)
						buffer.writef32(h, here__ + 4, 0)
					end
				elseif m > l then
					-- H^H applied to (h, 0): h (1 - conj tau)
					local hr, hi = buffer.readf32(h, 8 * ((k2 - 1) * n + k2)), buffer.readf32(h, (8 * ((k2 - 1) * n + k2)) + 4) :: number
					local nr, ni = complex64.mul(hr, hi, 1 - t1r, t1i)
					do
						local here__ = 8 * ((k2 - 1) * n + k2)
						buffer.writef32(h, here__, nr)
						buffer.writef32(h, here__ + 4, ni)
					end
				end
				if t1r ~= 0 or t1i ~= 0 then
					-- From the left, H^H = I - conj(tau) v v^H, on rows k2, k2+1.
					for j = k2, i2 do
						local o = 8 * (j * n + k2)
						local ar, ai = buffer.readf32(h, o), buffer.readf32(h, o + 4) :: number
						local br, bi = buffer.readf32(h, o + (8 * 1)), buffer.readf32(h, (o + (8 * 1)) + 4) :: number
						-- conj(tau) (a + conj(w2) b)
						local sr, si = ar + w2r * br + w2i * bi, ai + w2r * bi - w2i * br
						sr, si = t1r * sr + t1i * si, t1r * si - t1i * sr
						buffer.writef32(h, o, ar - sr)
						buffer.writef32(h, o + 4, ai - si)
						do
							local here_ = o + (8 * 1)
							buffer.writef32(h, here_, br - (sr * w2r - si * w2i))
							buffer.writef32(h, here_ + 4, bi - (sr * w2i + si * w2r))
						end
					end
					-- From the right, H = I - tau v v^H, on columns k2, k2+1.
					local function right(buf: buffer, first: number, last: number)
						local c0, c1 = 8 * (k2 * n), 8 * ((k2 + 1) * n)
						for j = first, last do
							local o = 8 * j
							local ar, ai = buffer.readf32(buf, c0 + o), buffer.readf32(buf, (c0 + o) + 4) :: number
							local br, bi = buffer.readf32(buf, c1 + o), buffer.readf32(buf, (c1 + o) + 4) :: number
							-- tau (a + w2 b)
							local sr, si = ar + w2r * br - w2i * bi, ai + w2r * bi + w2i * br
							sr, si = t1r * sr - t1i * si, t1r * si + t1i * sr
							do
								local here_ = c0 + o
								buffer.writef32(buf, here_, ar - sr)
								buffer.writef32(buf, here_ + 4, ai - si)
							end
							-- b - s conj(w2)
							do
								local here_ = c1 + o
								buffer.writef32(buf, here_, br - (sr * w2r + si * w2i))
								buffer.writef32(buf, here_ + 4, bi - (si * w2r - sr * w2i))
							end
						end
					end
					right(h, i1, math.min(k2 + 2, i))
					if z then
						right(z, 0, n - 1)
					end
				end
			end
		end
		if not converged then
			error("eig: the QR iteration did not converge")
		end
		wr[i + 1], wi[i + 1] = buffer.readf32(h, 8 * (i * n + i)), buffer.readf32(h, (8 * (i * n + i)) + 4) :: number
		kdefl = 0
		i = l - 1
	end
	return wr, wi
end

-- Overwrites the columns of Z with unit eigenvectors of A = Z T Z^H, given the upper
-- triangular T of a complex Schur factorization: column k belongs to T's k-th diagonal
-- entry. (LAPACK's trevc followed by the back-transformation, normalized to unit length.)
local function eigvecs_from_schur(T: Matrix, Z: Matrix)
	local n = T.rows
	assert(T.cols == n and Z.rows == n and Z.cols == n, "matrix sizes do not match")
	local t, zb = T.data, Z.data
	local xr, xi = table.create(n, 0), table.create(n, 0)
	local cr, ci = table.create(n, 0), table.create(n, 0)
	local ulp = 2 * EPS
	local smlnum = 2 ^ -1000 * (n / ulp)
	-- Descending, so the columns of Z still needed are not yet overwritten.
	for k = n - 1, 0, -1 do
		local lr, li = buffer.readf32(t, 8 * (k * n + k)), buffer.readf32(t, (8 * (k * n + k)) + 4) :: number
		local smin = math.max(ulp * cabs1(lr, li), smlnum)
		-- Solve (T[0..k-1, 0..k-1] - lambda) x = -T[0..k-1, k], with x_k = 1.
		xr[k + 1], xi[k + 1] = 1, 0
		for r = 0, k - 1 do
			local o = 8 * (k * n + r)
			xr[r + 1], xi[r + 1] = -buffer.readf32(t, o), -buffer.readf32(t, o + 4)
		end
		for j = k - 1, 0, -1 do
			local dr, di = buffer.readf32(t, 8 * (j * n + j)), buffer.readf32(t, (8 * (j * n + j)) + 4) :: number
			dr, di = dr - lr, di - li
			-- Perturb a (nearly) repeated eigenvalue, as trevc does.
			if cabs1(dr, di) < smin then
				dr, di = smin, 0
			end
			local yr, yi = complex64.div(xr[j + 1], xi[j + 1], dr, di)
			-- Rescale everything if the solution is about to overflow.
			local size = cabs1(yr, yi)
			if size > 2 ^ 500 then
				local f = 1 / size
				for r = 1, k + 1 do
					xr[r], xi[r] = xr[r] * f, xi[r] * f
				end
				yr, yi = yr * f, yi * f
			end
			xr[j + 1], xi[j + 1] = yr, yi
			for r = 0, j - 1 do
				local tr, ti = buffer.readf32(t, 8 * (j * n + r)), buffer.readf32(t, (8 * (j * n + r)) + 4) :: number
				xr[r + 1] -= tr * yr - ti * yi
				xi[r + 1] -= tr * yi + ti * yr
			end
		end
		-- Back-transform: column k := Z[:, 0..k] x, then normalize.
		for r = 1, n do
			cr[r], ci[r] = 0, 0
		end
		for j = 0, k do
			local pr, pi = xr[j + 1], xi[j + 1]
			local col = 8 * (j * n)
			for r = 0, n - 1 do
				local zr, zi = buffer.readf32(zb, col + (8 * r)), buffer.readf32(zb, (col + (8 * r)) + 4) :: number
				cr[r + 1] += zr * pr - zi * pi
				ci[r + 1] += zr * pi + zi * pr
			end
		end
		local big = 0
		for r = 1, n do
			big = math.max(big, math.abs(cr[r]), math.abs(ci[r]))
		end
		local s = 0
		if big > 0 then
			for r = 1, n do
				local a, b = cr[r] / big, ci[r] / big
				s += a * a + b * b
			end
		end
		local scale = if big > 0 then 1 / (big * math.sqrt(s)) else 0
		local col = 8 * (k * n)
		for r = 0, n - 1 do
			do
				local here_ = col + (8 * r)
				buffer.writef32(zb, here_, cr[r + 1] * scale)
				buffer.writef32(zb, here_ + 4, ci[r + 1] * scale)
			end
		end
	end
end

-- Reduces A to Hessenberg form and runs complex_schur on it; returns the Schur vectors
-- (if wantz) and the eigenvalues. With ilo and ihi (from balance), only that block is iterated on.
local function schur_impl(A: Matrix, wantt: boolean, wantz: boolean, ilo: number?, ihi: number?): (Matrix?, { number }, { number })
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	if any_nonfinite(A.data, 0, 2 * n * n) then
		-- NaN or infinity in, NaN out: T, Z and the eigenvalues.
		fill_nan(A.data, 0, 2 * n * n)
		local Z = if wantz then matrix(n, n) else nil
		if Z then
			fill_nan(Z.data, 0, 2 * n * n)
		end
		return Z, table.create(n, 0 / 0) :: { number }, table.create(n, 0 / 0) :: { number }
	end
	local lo, hi = ilo or 0, ihi or n - 1
	local F = hess_range(A, lo, hi)
	local Z = if wantz then hess_q(nil, F) else nil
	local a = A.data
	for j = 0, n - 3 do
		for i = j + 2, n - 1 do
			do
				local here_ = 8 * (j * n + i)
				buffer.writef32(a, here_, 0)
				buffer.writef32(a, here_ + 4, 0)
			end
		end
	end
	local wr, wi = complex_schur(a, n, wantt, if Z then Z.data else nil, lo, hi)
	return Z, wr, wi
end

local function complex_values(wr: { number }, wi: { number }): buffer
	local values = create(#wr)
	for k = 1, #wr do
		do
			local here_ = 8 * (k - 1)
			buffer.writef32(values, here_, wr[k])
			buffer.writef32(values, here_ + 4, wi[k])
		end
	end
	return values
end

-- Complex Schur factorization A = Z T Z^H, in place: A is overwritten with the upper
-- triangular T. Z is computed unless vectors is false. values holds T's diagonal (the
-- eigenvalues). If A holds a NaN or an infinity, T, Z and the values are all NaN.
-- schur_copy leaves A unchanged.
local function schur(A: Matrix, vectors: boolean?): Schur
	-- Scaled into a safe range and back (Z does not change).
	local sc = range_scale(A.data)
	local Z, wr, wi = schur_impl(A, true, vectors ~= false)
	if sc ~= 1 then
		scale(A.data, 1 / sc, A.data)
		for k = 1, #wr do
			wr[k] /= sc
			wi[k] /= sc
		end
	end
	return { schur = A, z = Z, values = complex_values(wr, wi) }
end

-- Complex Schur factorization of a copy of A; A is not modified.
local function schur_copy(A: Matrix, vectors: boolean?): Schur
	return schur(matcopy(nil, A), vectors)
end

-- What balance did: rows and columns ilo..ihi (0-based) form the block left to the
-- eigensolver, scale holds the diagonal of D, and swaps lists the row/column exchanges in
-- order (as pairs).
type Balance = { ilo: number, ihi: number, scale: { number }, swaps: { number } }

-- Balances the square matrix A in place, as LAPACK's gebal does:
-- 1. Permutation: a row that is zero off the diagonal isolates an eigenvalue (its diagonal
--    entry) and is moved to the bottom; a column that is zero off the diagonal likewise, to
--    the top. Repeating this leaves A block upper triangular, with triangular blocks
--    outside rows and columns ilo..ihi, so only that block needs the QR algorithm.
-- 2. Scaling: A := D^-1 A D on that block, with D a diagonal of powers of 2 (exact),
--    chosen so each row and the matching column have similar 2-norms. The eigenvalues are
--    unchanged but computed more accurately when A is badly scaled, because the
--    eigensolver's error is proportional to |A|.
-- Eigenvectors of the original A are P D times those of the balanced matrix (unbalance).
local function balance(A: Matrix): Balance
	local n = A.rows
	local a = A.data
	local swaps = {}
	-- Exchanges rows i and j and columns i and j (a permutation similarity).
	local function exchange(i: number, j: number)
		if i == j then
			return
		end
		table.insert(swaps, i)
		table.insert(swaps, j)
		for k = 0, n - 1 do
			do
				local s_ = 8 * (i * n + k)
				local t_ = 8 * (j * n + k)
				local re_, im_ = buffer.readf32(a, s_), buffer.readf32(a, s_ + 4)
				buffer.writef32(a, s_, buffer.readf32(a, t_))
				buffer.writef32(a, s_ + 4, buffer.readf32(a, t_ + 4))
				buffer.writef32(a, t_, re_)
				buffer.writef32(a, t_ + 4, im_)
			end
		end
		for k = 0, n - 1 do
			do
				local s_ = 8 * (k * n + i)
				local t_ = 8 * (k * n + j)
				local re_, im_ = buffer.readf32(a, s_), buffer.readf32(a, s_ + 4)
				buffer.writef32(a, s_, buffer.readf32(a, t_))
				buffer.writef32(a, s_ + 4, buffer.readf32(a, t_ + 4))
				buffer.writef32(a, t_, re_)
				buffer.writef32(a, t_ + 4, im_)
			end
		end
	end
	local lo, hi = 0, n - 1
	-- Rows zero off the diagonal (in columns 0..hi): move to the bottom.
	local found = true
	while found and hi > 0 do
		found = false
		for j = hi, 0, -1 do
			local zero = true
			for c = 0, hi do
				if c ~= j and (buffer.readf32(a, 8 * (c * n + j)) ~= 0 or buffer.readf32(a, (8 * (c * n + j)) + 4) ~= 0) then
					zero = false
					break
				end
			end
			if zero then
				exchange(j, hi)
				hi -= 1
				found = true
				break
			end
		end
	end
	-- Columns zero off the diagonal (in rows lo..hi): move to the top.
	found = true
	while found and lo < hi do
		found = false
		for j = lo, hi do
			local zero = true
			for r = lo, hi do
				if r ~= j and (buffer.readf32(a, 8 * (j * n + r)) ~= 0 or buffer.readf32(a, (8 * (j * n + r)) + 4) ~= 0) then
					zero = false
					break
				end
			end
			if zero then
				exchange(j, lo)
				lo += 1
				found = true
				break
			end
		end
	end
	-- Scaling of the block lo..hi.
	local d = table.create(n, 1)
	local function rownorm(i: number): number
		local big = 0
		for j = lo, hi do
			local o = 8 * (j * n + i)
			big = math.max(big, math.abs(buffer.readf32(a, o)), math.abs(buffer.readf32(a, o + 4)))
		end
		if big == 0 then
			return 0
		end
		local s = 0
		for j = lo, hi do
			local vr, vi = buffer.readf32(a, 8 * (j * n + i)), buffer.readf32(a, (8 * (j * n + i)) + 4) :: number
			vr, vi = vr / big, vi / big
			s += vr * vr + vi * vi
		end
		return big * math.sqrt(s)
	end
	local converged = false
	while not converged do
		converged = true
		for i = lo, hi do
			local c, r = segment_norm(a, 8 * (i * n + lo), 2 * (hi - lo + 1)), rownorm(i)
			if c > 0 and r > 0 then
				-- Column i times f and row i divided by f have norms about c f and r / f; take
				-- the power of 2 that brings those within a factor of 2 of each other.
				local f, cf, rf = 1, c, r
				while cf < rf / 2 and f < 2 ^ 500 do
					f, cf, rf = f * 2, cf * 2, rf / 2
				end
				while cf >= rf * 2 and f > 2 ^ -500 do
					f, cf, rf = f / 2, cf / 2, rf * 2
				end
				if cf + rf < 0.95 * (c + r) then
					converged = false
					d[i + 1] *= f
					for j = 0, n - 1 do
						do
							local here_ = 8 * (j * n + i)
							buffer.writef32(a, here_, buffer.readf32(a, here_) / f)
							buffer.writef32(a, here_ + 4, buffer.readf32(a, here_ + 4) / f)
						end
						do
							local here_ = 8 * (i * n + j)
							buffer.writef32(a, here_, buffer.readf32(a, here_) * f)
							buffer.writef32(a, here_ + 4, buffer.readf32(a, here_ + 4) * f)
						end
					end
				end
			end
		end
	end
	return { ilo = lo, ihi = hi, scale = d, swaps = swaps }
end

-- Maps eigenvectors of a balanced matrix back (x = P D x') and rescales each to unit length.
local function unbalance(v: buffer, n: number, B: Balance)
	local d, swaps = B.scale, B.swaps
	for j = 0, n - 1 do
		local col = 8 * (j * n)
		for i = 0, n - 1 do
			do
				local here_ = col + (8 * i)
				buffer.writef32(v, here_, buffer.readf32(v, here_) * (d[i + 1]))
				buffer.writef32(v, here_ + 4, buffer.readf32(v, here_ + 4) * (d[i + 1]))
			end
		end
		-- Undo the exchanges, last first.
		for s = #swaps - 1, 1, -2 do
			do
				local s_ = col + (8 * (swaps[s]))
				local t_ = col + (8 * (swaps[s + 1]))
				local re_, im_ = buffer.readf32(v, s_), buffer.readf32(v, s_ + 4)
				buffer.writef32(v, s_, buffer.readf32(v, t_))
				buffer.writef32(v, s_ + 4, buffer.readf32(v, t_ + 4))
				buffer.writef32(v, t_, re_)
				buffer.writef32(v, t_ + 4, im_)
			end
		end
		local nrm = segment_norm(v, col, 2 * n)
		if nrm > 0 then
			for i = 0, n - 1 do
				do
					local here_ = col + (8 * i)
					buffer.writef32(v, here_, buffer.readf32(v, here_) / nrm)
					buffer.writef32(v, here_ + 4, buffer.readf32(v, here_ + 4) / nrm)
				end
			end
		end
	end
end

-- Eigenvalues and, unless vectors is false, unit eigenvectors of a general complex
-- matrix: column k of vectors belongs to values[k]. Unless balanced is false, A is
-- balanced first (permuted and scaled; see balance), as LAPACK's geev does by default. A
-- is overwritten with the (balanced) Schur form, or with workspace if vectors is false;
-- the eigenvectors are a new matrix. If A holds a NaN or an infinity, the values, the
-- vectors and A are all NaN. eig_copy leaves A unchanged.
local function eig(A: Matrix, vectors: boolean?, balanced: boolean?): Eig
	local want = vectors ~= false
	assert(A.cols == A.rows, "matrix must be square")
	if any_nonfinite(A.data, 0, 2 * A.rows * A.rows) then
		-- schur_impl returns NaN for everything.
		local Z, wr, wi = schur_impl(A, want, want)
		return { values = complex_values(wr, wi), vectors = Z }
	end
	-- Scaled into a safe range (see range_scale); the values and A are scaled back at the
	-- end, and the vectors do not change.
	local sc = range_scale(A.data)
	local bal = if balanced ~= false then balance(A) else nil
	local Z, wr, wi = schur_impl(A, want, want, if bal then bal.ilo else nil, if bal then bal.ihi else nil)
	if Z then
		eigvecs_from_schur(A, Z)
		if bal then
			unbalance(Z.data, A.rows, bal)
		end
	end
	if sc ~= 1 then
		scale(A.data, 1 / sc, A.data)
		for k = 1, #wr do
			wr[k] /= sc
			wi[k] /= sc
		end
	end
	return { values = complex_values(wr, wi), vectors = Z }
end

-- Eigendecomposition of a copy of A; A is not modified.
local function eig_copy(A: Matrix, vectors: boolean?, balanced: boolean?): Eig
	return eig(matcopy(nil, A), vectors, balanced)
end

-- Rotation (c, s, r) with c f + s g = r and -s f + c g = 0 (LAPACK's lartg).
local function lartg(f: number, g: number): (number, number, number)
	if g == 0 then
		return 1, 0, f
	elseif f == 0 then
		return 0, 1, g
	end
	local r = hypot3(f, g, 0)
	if f < 0 then
		r = -r
	end
	return f / r, g / r, r
end

-- Singular values (smaller, larger) of [f g; 0 h] (LAPACK's las2).
local function las2(f: number, g: number, h: number): (number, number)
	local fa, ga, ha = math.abs(f), math.abs(g), math.abs(h)
	local fhmn, fhmx = math.min(fa, ha), math.max(fa, ha)
	if fhmn == 0 then
		if fhmx == 0 then
			return 0, ga
		end
		local big, small = math.max(fhmx, ga), math.min(fhmx, ga)
		return 0, big * math.sqrt(1 + (small / big) ^ 2)
	elseif ga < fhmx then
		local as = 1 + fhmn / fhmx
		local at = (fhmx - fhmn) / fhmx
		local au = (ga / fhmx) ^ 2
		local c = 2 / (math.sqrt(as * as + au) + math.sqrt(at * at + au))
		return fhmn * c, fhmx / c
	end
	local au = fhmx / ga
	if au == 0 then
		return (fhmn * fhmx) / ga, ga
	end
	local as = 1 + fhmn / fhmx
	local at = (fhmx - fhmn) / fhmx
	local c = 1 / (math.sqrt(1 + (as * au) ^ 2) + math.sqrt(1 + (at * au) ^ 2))
	return 2 * (fhmn * c) * au, ga / (c + c)
end

-- SVD of [f g; 0 h] (LAPACK's lasv2): returns ssmin, ssmax (signed) and the rotations
-- (snr, csr) and (snl, csl) with
-- [csl snl; -snl csl] [f g; 0 h] [csr -snr; snr csr] = [ssmax 0; 0 ssmin].
local function lasv2(f: number, g: number, h: number): (number, number, number, number, number, number)
	local function sign(a: number, b: number): number
		return if b >= 0 then math.abs(a) else -math.abs(a)
	end
	local ft, fa, ht, ha = f, math.abs(f), h, math.abs(h)
	-- pmax: which entry has the largest magnitude (1 = f, 2 = g, 3 = h).
	local pmax = 1
	local swap = ha > fa
	if swap then
		pmax = 3
		ft, ht = ht, ft
		fa, ha = ha, fa
	end
	local gt, ga = g, math.abs(g)
	local clt, crt, slt, srt = 1, 1, 0, 0
	local ssmin: number, ssmax: number = 0, 0
	if ga == 0 then
		ssmin, ssmax = ha, fa
	else
		local gasmal = true
		if ga > fa then
			pmax = 2
			if fa / ga < 2 ^ -53 then
				-- g is far larger than the diagonal.
				gasmal = false
				ssmax = ga
				ssmin = if ha > 1 then fa / (ga / ha) else (fa / ga) * ha
				clt, slt, srt, crt = 1, ht / gt, 1, ft / gt
			end
		end
		if gasmal then
			local dd = fa - ha
			local l = if dd == fa then 1 else dd / fa
			local m = gt / ft
			local t = 2 - l
			local mm, tt = m * m, t * t
			local s = math.sqrt(tt + mm)
			local r = if l == 0 then math.abs(m) else math.sqrt(l * l + mm)
			local a = 0.5 * (s + r)
			ssmin, ssmax = ha / a, fa * a
			if mm == 0 then
				t = if l == 0 then sign(2, ft) * sign(1, gt) else gt / sign(dd, ft) + m / t
			else
				t = (m / (s + t) + m / (r + l)) * (1 + a)
			end
			l = math.sqrt(t * t + 4)
			crt, srt = 2 / l, t / l
			clt = (crt + srt * m) / a
			slt = (ht / ft) * srt / a
		end
	end
	local csl, snl, csr, snr
	if swap then
		csl, snl, csr, snr = srt, crt, slt, clt
	else
		csl, snl, csr, snr = clt, slt, crt, srt
	end
	local tsign
	if pmax == 1 then
		tsign = sign(1, csr) * sign(1, csl) * sign(1, f)
	elseif pmax == 2 then
		tsign = sign(1, snr) * sign(1, csl) * sign(1, g)
	else
		tsign = sign(1, snr) * sign(1, snl) * sign(1, h)
	end
	ssmax = sign(ssmax, tsign)
	ssmin = sign(ssmin, tsign * sign(1, f) * sign(1, h))
	return ssmin, ssmax, snr, csr, snl, csl
end

-- Singular values of the real upper bidiagonal matrix with diagonal d[1..n] and
-- superdiagonal e[1..n-1] (LAPACK's bdsqr): implicit QR with shifts from the trailing
-- (or leading) 2 by 2 block, and Demmel and Kahan's zero-shift sweeps whenever a shift
-- would spoil the relative accuracy of the small singular values. d and e are Luau
-- tables, so the iteration runs in double precision. On return d holds the singular
-- values in descending order and e is destroyed. If u (urows by n) and v (vrows by n)
-- are given, with PARTS reals per entry, the left rotations are applied to the columns
-- of u and the right ones to the columns of v, and both are sorted with the values.
local function bidiagonal_svd(d: { number }, e: { number }, n: number, u: buffer?, urows: number, v: buffer?, vrows: number)
	if n == 0 then
		return
	end
	-- Columns p and q (1-based) of buf := [c p + s q, c q - s p].
	local function rotate(buf: buffer, rows: number, p: number, q: number, c: number, s: number)
		local column = 4 * PARTS * rows
		local op, oq = column * (p - 1), column * (q - 1)
		for i = 0, PARTS * rows - 1 do
			local x, y = buffer.readf32(buf, op + (4 * i)), buffer.readf32(buf, oq + (4 * i))
			buffer.writef32(buf, op + (4 * i), c * x + s * y)
			buffer.writef32(buf, oq + (4 * i), c * y - s * x)
		end
	end
	local function rotv(p: number, q: number, c: number, s: number)
		if v then
			rotate(v, vrows, p, q, c, s)
		end
	end
	local function rotu(p: number, q: number, c: number, s: number)
		if u then
			rotate(u, urows, p, q, c, s)
		end
	end

	local eps = 2 ^ -53
	local tol = math.max(10, math.min(100, eps ^ (-1 / 8))) * eps
	local maxitr = 6

	-- Threshold for negligible entries, from an estimate of the smallest singular value.
	local sminoa = math.abs(d[1])
	local mu = sminoa
	for i = 2, n do
		if sminoa == 0 then
			break
		end
		mu = math.abs(d[i]) * (mu / (mu + math.abs(e[i - 1])))
		sminoa = math.min(sminoa, mu)
	end
	sminoa /= math.sqrt(n)
	local thresh = math.max(tol * sminoa, maxitr * n * n * 2 ^ -1022)
	local maxit = maxitr * n * n
	local iter = 0
	local oldll, oldm = -1, -1
	local idir = 0

	local m = n
	while m > 1 do
		if iter > maxit then
			error("svd: the QR iteration did not converge")
		end
		-- Find the unreduced block ll..m.
		local smax = math.abs(d[m])
		local ll = 0
		for idx = m - 1, 1, -1 do
			local abss, abse = math.abs(d[idx]), math.abs(e[idx])
			if abse <= thresh then
				ll = idx
				break
			end
			smax = math.max(smax, abss, abse)
		end
		if ll > 0 then
			e[ll] = 0
			if ll == m - 1 then
				-- The bottom value has converged.
				m -= 1
				continue
			end
		end
		ll += 1

		if ll == m - 1 then
			-- A 2 by 2 block: solve it directly.
			local sigmn, sigmx, sinr, cosr, sinl, cosl = lasv2(d[m - 1], e[m - 1], d[m])
			d[m - 1], e[m - 1], d[m] = sigmx, 0, sigmn
			rotv(m - 1, m, cosr, sinr)
			rotu(m - 1, m, cosl, sinl)
			m -= 2
			continue
		end

		-- For a new block, chase toward the smaller end: down if graded downward.
		if ll > oldm or m < oldll then
			idir = if math.abs(d[ll]) >= math.abs(d[m]) then 1 else 2
		end

		-- Convergence tests that preserve relative accuracy; sminl estimates the smallest
		-- singular value of the block.
		local sminl = 0
		local split = false
		if idir == 1 then
			if math.abs(e[m - 1]) <= tol * math.abs(d[m]) then
				e[m - 1] = 0
				continue
			end
			mu = math.abs(d[ll])
			sminl = mu
			for i = ll, m - 1 do
				if math.abs(e[i]) <= tol * mu then
					e[i] = 0
					split = true
					break
				end
				mu = math.abs(d[i + 1]) * (mu / (mu + math.abs(e[i])))
				sminl = math.min(sminl, mu)
			end
		else
			if math.abs(e[ll]) <= tol * math.abs(d[ll]) then
				e[ll] = 0
				continue
			end
			mu = math.abs(d[m])
			sminl = mu
			for i = m - 1, ll, -1 do
				if math.abs(e[i]) <= tol * mu then
					e[i] = 0
					split = true
					break
				end
				mu = math.abs(d[i]) * (mu / (mu + math.abs(e[i])))
				sminl = math.min(sminl, mu)
			end
		end
		if split then
			continue
		end
		oldll, oldm = ll, m

		-- Shift: the smaller singular value of the 2 by 2 block at the far end, unless it
		-- would destroy the relative accuracy of the small values; then use zero.
		local shift = 0
		if n * tol * (sminl / smax) > math.max(eps, 0.01 * tol) then
			local sll
			if idir == 1 then
				sll = math.abs(d[ll])
				shift = las2(d[m - 1], e[m - 1], d[m])
			else
				sll = math.abs(d[m])
				shift = las2(d[ll], e[ll], d[ll + 1])
			end
			if sll > 0 and (shift / sll) ^ 2 < eps then
				shift = 0
			end
		end
		iter += m - ll

		if shift == 0 then
			-- Demmel and Kahan's zero-shift QR sweep.
			local cs, sn, oldcs, oldsn, r = 1, 0, 1, 0, 0
			if idir == 1 then
				for i = ll, m - 1 do
					cs, sn, r = lartg(d[i] * cs, e[i])
					if i > ll then
						e[i - 1] = oldsn * r
					end
					oldcs, oldsn, d[i] = lartg(oldcs * r, d[i + 1] * sn)
					rotv(i, i + 1, cs, sn)
					rotu(i, i + 1, oldcs, oldsn)
				end
				local hh = d[m] * cs
				d[m], e[m - 1] = hh * oldcs, hh * oldsn
				if math.abs(e[m - 1]) <= thresh then
					e[m - 1] = 0
				end
			else
				for i = m, ll + 1, -1 do
					cs, sn, r = lartg(d[i] * cs, e[i - 1])
					if i < m then
						e[i] = oldsn * r
					end
					oldcs, oldsn, d[i] = lartg(oldcs * r, d[i - 1] * sn)
					rotv(i - 1, i, oldcs, -oldsn)
					rotu(i - 1, i, cs, -sn)
				end
				local hh = d[ll] * cs
				d[ll], e[ll] = hh * oldcs, hh * oldsn
				if math.abs(e[ll]) <= thresh then
					e[ll] = 0
				end
			end
		else
			-- Shifted QR sweep (chase the bulge).
			if idir == 1 then
				local f = (math.abs(d[ll]) - shift) * ((if d[ll] >= 0 then 1 else -1) + shift / d[ll])
				local g = e[ll]
				for i = ll, m - 1 do
					local cosr, sinr, r = lartg(f, g)
					if i > ll then
						e[i - 1] = r
					end
					f = cosr * d[i] + sinr * e[i]
					e[i] = cosr * e[i] - sinr * d[i]
					g = sinr * d[i + 1]
					d[i + 1] = cosr * d[i + 1]
					local cosl, sinl, r2 = lartg(f, g)
					d[i] = r2
					f = cosl * e[i] + sinl * d[i + 1]
					d[i + 1] = cosl * d[i + 1] - sinl * e[i]
					if i < m - 1 then
						g = sinl * e[i + 1]
						e[i + 1] = cosl * e[i + 1]
					end
					rotv(i, i + 1, cosr, sinr)
					rotu(i, i + 1, cosl, sinl)
				end
				e[m - 1] = f
				if math.abs(e[m - 1]) <= thresh then
					e[m - 1] = 0
				end
			else
				local f = (math.abs(d[m]) - shift) * ((if d[m] >= 0 then 1 else -1) + shift / d[m])
				local g = e[m - 1]
				for i = m, ll + 1, -1 do
					local cosr, sinr, r = lartg(f, g)
					if i < m then
						e[i] = r
					end
					f = cosr * d[i] + sinr * e[i - 1]
					e[i - 1] = cosr * e[i - 1] - sinr * d[i]
					g = sinr * d[i - 1]
					d[i - 1] = cosr * d[i - 1]
					local cosl, sinl, r2 = lartg(f, g)
					d[i] = r2
					f = cosl * e[i - 1] + sinl * d[i - 1]
					d[i - 1] = cosl * d[i - 1] - sinl * e[i - 1]
					if i > ll + 1 then
						g = sinl * e[i - 2]
						e[i - 2] = cosl * e[i - 2]
					end
					rotv(i - 1, i, cosl, -sinl)
					rotu(i - 1, i, cosr, -sinr)
				end
				e[ll] = f
				if math.abs(e[ll]) <= thresh then
					e[ll] = 0
				end
			end
		end
	end

	-- Make the values nonnegative (flipping the matching right vector), then sort them in
	-- descending order with their vectors.
	for i = 1, n do
		if d[i] < 0 then
			d[i] = -d[i]
			if v then
				local column = 4 * PARTS * vrows
				for k = 0, PARTS * vrows - 1 do
					local off = column * (i - 1) + 4 * k
					buffer.writef32(v, off, -buffer.readf32(v, off))
				end
			end
		end
	end
	local function swap(buf: buffer, rows: number, p: number, q: number)
		local column = 4 * PARTS * rows
		local op, oq = column * (p - 1), column * (q - 1)
		for i = 0, PARTS * rows - 1 do
			local tmp = buffer.readf32(buf, op + (4 * i))
			buffer.writef32(buf, op + (4 * i), buffer.readf32(buf, oq + (4 * i)))
			buffer.writef32(buf, oq + (4 * i), tmp)
		end
	end
	for i = 1, n - 1 do
		local best = i
		for j = i + 1, n do
			if d[j] > d[best] then
				best = j
			end
		end
		if best ~= i then
			d[i], d[best] = d[best], d[i]
			if u then
				swap(u, urows, i, best)
			end
			if v then
				swap(v, vrows, i, best)
			end
		end
	end
end

-- Reduces A (rows >= cols) to real upper bidiagonal form A = Q B P^H in place (LAPACK's
-- gebd2 for complex matrices), returning B's diagonal d and superdiagonal e as tables.
-- The left reflectors stay below the diagonal of A (as in qr), with their tau in tauq;
-- right reflector k acts on columns k+1.. and stays in row k from column k+2 on, with its
-- tau in taup.
local function bidiagonalize(A: Matrix): ({ number }, { number }, buffer, buffer)
	local m, n = A.rows, A.cols
	local a = A.data
	local tauq = create(n)
	local taup = create(math.max(n - 1, 0))
	local d, e = table.create(n, 0), table.create(math.max(n - 1, 0), 0)
	local row = create(n)
	local wr, wi = table.create(m, 0), table.create(m, 0)
	for k = 0, n - 1 do
		local diag = 8 * (k * m + k)
		local tr, ti = householder(a, diag, m - k, tauq, k)
		d[k + 1] = buffer.readf32(a, diag)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, 8 * (j * m + k))
			end
		end
		if k < n - 1 then
			-- The conjugate of row k from column k+1 on is gathered and reflected; v is
			-- put back in the row.
			local len = n - k - 1
			for c = 0, len - 1 do
				local o = 8 * ((k + 1 + c) * m + k)
				do
					local here_ = 8 * c
					buffer.writef32(row, here_, buffer.readf32(a, o))
					buffer.writef32(row, here_ + 4, -buffer.readf32(a, o + 4))
				end
			end
			local pr, pi = householder(row, 0, len, taup, k)
			e[k + 1] = buffer.readf32(row, 0)
			for c = 0, len - 1 do
				local o = 8 * c
				do
					local here_ = 8 * ((k + 1 + c) * m + k)
					buffer.writef32(a, here_, buffer.readf32(row, o))
					buffer.writef32(a, here_ + 4, buffer.readf32(row, o + 4))
				end
			end
			if pr ~= 0 or pi ~= 0 then
				-- Rows k+1.. of columns k+1..: A := A (I - tau v v^H), v = (1, row[1..]).
				for r = k + 1, m - 1 do
					wr[r + 1], wi[r + 1] = buffer.readf32(a, 8 * ((k + 1) * m + r)), buffer.readf32(a, (8 * ((k + 1) * m + r)) + 4) :: number
				end
				for c = 1, len - 1 do
					local vr, vi = buffer.readf32(row, 8 * c), buffer.readf32(row, (8 * c) + 4) :: number
					local col = 8 * ((k + 1 + c) * m)
					for r = k + 1, m - 1 do
						local ar, ai = buffer.readf32(a, col + (8 * r)), buffer.readf32(a, (col + (8 * r)) + 4) :: number
						wr[r + 1] += ar * vr - ai * vi
						wi[r + 1] += ar * vi + ai * vr
					end
				end
				for c = 0, len - 1 do
					local vr, vi = 1, 0
					if c > 0 then
						vr, vi = buffer.readf32(row, 8 * c), buffer.readf32(row, (8 * c) + 4) :: number
					end
					-- tau conj(v_c)
					local fr, fi = pr * vr + pi * vi, pi * vr - pr * vi
					local col = 8 * ((k + 1 + c) * m)
					for r = k + 1, m - 1 do
						local xr, xi = wr[r + 1], wi[r + 1]
						do
							local here_ = col + (8 * r)
							buffer.writef32(a, here_, buffer.readf32(a, here_) - (xr * fr - xi * fi))
							buffer.writef32(a, here_ + 4, buffer.readf32(a, here_ + 4) - (xr * fi + xi * fr))
						end
					end
				end
			end
		end
	end
	return d, e, tauq, taup
end

-- svd for rows >= cols, in place.
local function svd_tall(A: Matrix, want: boolean): Svd
	local m, n = A.rows, A.cols
	if any_nonfinite(A.data, 0, 2 * m * n) then
		local values = buffer.create(4 * n)
		fill_nan(values, 0, n)
		fill_nan(A.data, 0, 2 * m * n)
		local V = if want then matrix(n, n) else nil
		if V then
			fill_nan(V.data, 0, 2 * n * n)
		end
		return { values = values, u = if want then A else nil, v = V }
	end
	-- Scaled into a safe range (see range_scale); the values are scaled back, and U and V
	-- do not change.
	local sc = range_scale(A.data)
	local d, e, tauq, taup = bidiagonalize(A)
	local V: Matrix? = nil
	if want then
		-- V = P from the right reflectors, then U = the first n columns of Q, in A.
		local P = matrix(n, n)
		for k = 0, n - 3 do
			for c = k + 2, n - 1 do
				local s = 8 * (c * m + k)
				do
					local here_ = 8 * (k * n + c)
					buffer.writef32(P.data, here_, buffer.readf32(A.data, s))
					buffer.writef32(P.data, here_ + 4, buffer.readf32(A.data, s + 4))
				end
			end
		end
		form_reduction_q(P.data, n, math.max(n - 1, 0), taup)
		form_q(A.data, m, 0, m, n, n, tauq)
		V = P
	end
	bidiagonal_svd(d, e, n, if want then A.data else nil, m, if V then V.data else nil, n)
	local values = buffer.create(4 * n)
	for i = 1, n do
		buffer.writef32(values, 4 * (i - 1), d[i])
	end
	if sc ~= 1 then
		scale(values, 1 / sc, values)
	end
	return { values = values, u = if want then A else nil, v = V }
end

-- Singular value decomposition A = U diag(values) V^H: values (descending, nonnegative,
-- a real array of the same precision) and, unless vectors is false, U (rows by k) and V
-- (cols by k) with orthonormal columns, k = min(rows, cols). Golub-Kahan
-- bidiagonalization, then implicit QR on the real bidiagonal in double precision, keeping
-- the small singular values relatively accurate. In place when rows >= cols: A is
-- overwritten with U (or with workspace if vectors is false). A wide A is not modified
-- (its adjoint is decomposed instead). If A holds a NaN or an infinity, every output is
-- NaN. svd_copy never modifies A.
local function svd(A: Matrix, vectors: boolean?): Svd
	if A.rows < A.cols then
		local F = svd_tall(adjoint(nil, A), vectors ~= false)
		return { values = F.values, u = F.v, v = F.u }
	end
	return svd_tall(A, vectors ~= false)
end

-- Singular value decomposition of a copy of A; A is not modified.
local function svd_copy(A: Matrix, vectors: boolean?): Svd
	if A.rows < A.cols then
		return svd(A, vectors)
	end
	return svd(matcopy(nil, A), vectors)
end

-- The pseudoinverse A^+ = V S^+ U^H (cols by rows), by the SVD of a copy of A; singular
-- values at or below tol * s_1 (default max(rows, cols) * eps, as for svd_solve) count as
-- zero. A is not modified. NaN or infinite input gives an all-NaN result. To apply A^+ to
-- vectors, solving with form "svd" is cheaper than forming it.
local function pinv(A: Matrix, tol: number?): Matrix
	local m, n = A.rows, A.cols
	local F = svd_copy(A)
	local U, V = F.u :: Matrix, F.v :: Matrix
	local k, s = U.cols, F.values
	local X = matrix(n, m)
	if k > 0 and buffer.readf32(s, 0) ~= buffer.readf32(s, 0) then
		fill_nan(X.data, 0, 2 * n * m)
		return X
	end
	local limit = (tol or math.max(m, n) * EPS) * (if k > 0 then buffer.readf32(s, 0) else 0)
	local u, v, x = U.data, V.data, X.data
	local rr, ri = table.create(n, 0), table.create(n, 0)
	-- Column q of X is sum over i of v_i (conj(u_qi) / s_i).
	for i = 0, k - 1 do
		local si = buffer.readf32(s, 4 * i)
		if not (si > limit) then
			break
		end
		for p = 0, n - 1 do
			local o = 8 * (i * n + p)
			rr[p + 1], ri[p + 1] = buffer.readf32(v, o) / si, buffer.readf32(v, o + 4) / si
		end
		for q = 0, m - 1 do
			local o = 8 * (i * m + q)
			local cr, ci = buffer.readf32(u, o), -buffer.readf32(u, o + 4)
			if cr ~= 0 or ci ~= 0 then
				local col = 8 * (q * n)
				for p = 0, n - 1 do
					local t = col + (8 * p)
					buffer.writef32(x, t, buffer.readf32(x, t) + cr * rr[p + 1] - ci * ri[p + 1])
					buffer.writef32(x, t + 4, buffer.readf32(x, t + 4) + cr * ri[p + 1] + ci * rr[p + 1])
				end
			end
		end
	end
	return X
end

-- Matrix norms: kind 1 (largest column sum of |a_ij|), "inf" (largest row sum), 2
-- (largest singular value) or "fro" (Frobenius; the default).
local function matnorm(A: Matrix, kind: (number | string)?): number
	local m, n = A.rows, A.cols
	local a = A.data
	if kind == nil or kind == "fro" then
		return norm(a)
	elseif kind == 2 then
		if m == 0 or n == 0 then
			return 0
		end
		return buffer.readf32(svd_copy(A, false).values, 0)
	elseif kind == 1 then
		local best = 0
		for j = 0, n - 1 do
			local s = 0
			for i = 0, m - 1 do
				s += complex64.abs(cread(a, j * m + i))
			end
			if not (s <= best) then
				best = s
			end
		end
		return best
	elseif kind == "inf" then
		local rows = table.create(m, 0) :: { number }
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				rows[i + 1] += complex64.abs(cread(a, j * m + i))
			end
		end
		local best = 0
		for _, s in rows do
			if not (s <= best) then
				best = s
			end
		end
		return best
	end
	error(`matnorm: unknown kind {kind}`)
end
-- The Hermitian tridiagonal eigenproblem.

-- Eigenvalues (ascending, a real array) and, unless vectors is false, orthonormal
-- eigenvectors of the Hermitian tridiagonal matrix T: the real parts of its diagonal
-- and T.lower are read (T.upper should be conj(T.lower) and is ignored). A diagonal
-- unitary D makes the off-diagonal real and nonnegative (T = D T2 D^H), then implicit QR
-- with Wilkinson shifts runs on T2 in double precision, as inside eigh; the vectors are
-- D times those of T2. T is not modified; the vectors are a new matrix.
local function tridiag_eigh(T: Tridiagonal, vectors: boolean?): Eigh
	local n = length(T.diag)
	local d = table.create(n, 0) :: { number }
	local e = table.create(math.max(n - 1, 0), 0) :: { number }
	local pr, pi = table.create(n, 1) :: { number }, table.create(n, 0) :: { number }
	for i = 1, n do
		d[i] = buffer.readf32(T.diag, 8 * (i - 1))
	end
	for i = 1, n - 1 do
		local lr, li = buffer.readf32(T.lower, 8 * (i - 1)), buffer.readf32(T.lower, (8 * (i - 1)) + 4) :: number
		local a = complex64.abs(lr, li)
		e[i] = a
		-- phi_(i+1) = phi_i l_i / |l_i|
		if a > 0 then
			local r, m = complex64.mul(pr[i], pi[i], lr / a, li / a)
			pr[i + 1] = r
			pi[i + 1] = m
		else
			pr[i + 1] = pr[i]
			pi[i + 1] = pi[i]
		end
	end
	local Z = if vectors ~= false then identity(n) else nil
	tridiagonal_eigen(d, e, if Z then Z.data else nil, n)
	if Z then
		for j = 0, n - 1 do
			for k = 0, n - 1 do
				local o = 8 * (j * n + k)
				local zr, zi = buffer.readf32(Z.data, o), buffer.readf32(Z.data, o + 4) :: number
				buffer.writef32(Z.data, o, zr * pr[k + 1] - zi * pi[k + 1])
				buffer.writef32(Z.data, o + 4, zr * pi[k + 1] + zi * pr[k + 1])
			end
		end
	end
	local values = buffer.create(4 * n)
	for i = 1, n do
		buffer.writef32(values, 4 * (i - 1), d[i])
	end
	return { values = values, vectors = Z }
end

-- Polar decomposition

-- QDWH (Nakatsukasa, Bai and Gygi 2010; in the form of Nakatsukasa and Higham 2013) for a
-- matrix with rows >= cols: returns U, with orthonormal columns, of A = U H as a new
-- matrix, and the number of iterations. X_0 = A / alpha with alpha = |A|_F >= |A|_2, and
-- l_0 <= sigma_min(X_0) from |R^-1|_F of A's QR factor. Each step applies the best
-- rational function of type (3, 2) for the current bound l, mapping [l, 1] into [l', 1]:
--   X' = (b / c) X + (a - b / c) X (I + c X^H X)^-1,
-- computed through the QR factorization of [sqrt(c) X; I] while c is large (for
-- stability) and through a Cholesky factorization once c <= 100. It converges cubically;
-- at most about 6 steps for condition numbers up to 1 / eps.
local function qdwh(A: Matrix): (Matrix, number)
	local m, n = A.rows, A.cols
	local alpha = norm(A.data)
	if alpha == 0 then
		-- The zero matrix: any U with orthonormal columns will do; take I's first columns.
		local U = matrix(m, n)
		for j = 0, n - 1 do
			buffer.writef32(U.data, ENTRY * (j * m + j), 1)
		end
		return U, 0
	end
	local X = matcopy(nil, A)
	X.data = scale(X.data, 1 / alpha, X.data)
	-- l_0: sigma_min(X) = sigma_min(R) >= 1 / |R^-1|_2 >= 1 / |R^-1|_F. A singular R gives
	-- l = eps, below which singular values are rounding noise.
	local R = qr_r(nil, qr_copy(X))
	local ok, Rinv = pcall(inv_copy, R)
	local l = if ok then 1 / norm((Rinv :: Matrix).data) else 0
	if not (l > EPS) then
		l = EPS
	end
	l = math.min(l, 1)
	local I = identity(n)
	local iterations = 0
	while iterations < 30 do
		local l2 = l * l
		local d = (4 * (1 - l2) / (l2 * l2)) ^ (1 / 3)
		local a = math.sqrt(1 + d) + 0.5 * math.sqrt(8 - 4 * d + 8 * (2 - l2) / (l2 * math.sqrt(1 + d)))
		local b = (a - 1) ^ 2 / 4
		local c = a + b - 1
		local Xnew = matrix(m, n)
		if c > 100 then
			-- [sqrt(c) X; I] = [Q1; Q2] R; then X' = (b / c) X + (a - b / c) / sqrt(c) Q1 Q2^H.
			local rc = math.sqrt(c)
			local stacked = matrix(m + n, n)
			local sx = scale(nil, rc, X.data)
			for j = 0, n - 1 do
				buffer.copy(stacked.data, ENTRY * j * (m + n), sx, ENTRY * j * m, ENTRY * m)
				buffer.writef32(stacked.data, ENTRY * (j * (m + n) + m + j), 1)
			end
			local Q = qr_q(nil, qr(stacked))
			local Q1, Q2 = matrix(m, n), matrix(n, n)
			for j = 0, n - 1 do
				buffer.copy(Q1.data, ENTRY * j * m, Q.data, ENTRY * j * (m + n), ENTRY * m)
				buffer.copy(Q2.data, ENTRY * j * n, Q.data, ENTRY * (j * (m + n) + m), ENTRY * n)
			end
			local P = matmul(nil, Q1, conj_transpose(nil, Q2))
			Xnew.data = axpy(nil, (a - b / c) / rc, P.data, scale(nil, b / c, X.data))
		else
			-- Z = I + c X^H X is positive definite; X Z^-1 = (Z^-1 X^H)^H.
			local Z = matmul(nil, conj_transpose(nil, X), X)
			Z.data = axpy(Z.data, c, Z.data, I.data)
			local F = chol(Z)
			local Y = solve(nil, F, conj_transpose(nil, X), "chol")
			Xnew.data = axpy(nil, a - b / c, conj_transpose(nil, Y).data, scale(nil, b / c, X.data))
		end
		iterations += 1
		local change = norm(sub(nil, Xnew.data, X.data))
		X = Xnew
		l = math.min(l * (a + b * l2) / (1 + c * l2), 1)
		-- Cubic convergence: once a step changes X by at most (5 eps)^(1/3), X is accurate
		-- to about 5 eps.
		if 1 - l <= 10 * EPS and change <= (5 * EPS) ^ (1 / 3) then
			break
		end
	end
	return X, iterations
end

-- Polar decomposition A = U H, in place: U has orthonormal columns (rows, if A is wide)
-- and overwrites A; H = U^H A is Hermitian positive semidefinite (cols by cols), new.
-- F.iterations counts the QDWH steps (see qdwh). For full-rank A both factors are unique;
-- U is then the closest matrix with orthonormal columns (or rows) to A in every unitarily
-- invariant norm. If A is exactly rank deficient, U is the canonical partial isometry
-- (U^H U projects onto the range of H); a numerically rank-deficient A, whose tiny singular
-- values rounding has made nonzero, gets an orthonormal U in a few more steps. A wide A is
-- handled through its adjoint. A NaN or infinite entry gives NaN factors. polar_copy
-- leaves A unchanged.
local function polar(A: Matrix): Polar
	local m, n = A.rows, A.cols
	local reals = buffer.len(A.data) // 4
	if any_nonfinite(A.data, 0, reals) then
		fill_nan(A.data, 0, reals)
		local H = matrix(n, n)
		fill_nan(H.data, 0, buffer.len(H.data) // 4)
		return { u = A, h = H, iterations = 0 }
	end
	local U: Matrix, iterations: number
	if m >= n then
		U, iterations = qdwh(A)
	else
		local V: Matrix
		V, iterations = qdwh(conj_transpose(nil, A))
		U = conj_transpose(nil, V)
	end
	local H = matmul(nil, conj_transpose(nil, U), A)
	-- Rounding leaves H very slightly non-Hermitian; take the Hermitian part.
	H.data = scale(nil, 0.5, add(nil, H.data, conj_transpose(nil, H).data))
	buffer.copy(A.data, 0, U.data)
	return { u = A, h = H, iterations = iterations }
end

-- The polar decomposition of a copy of A; A is not modified.
local function polar_copy(A: Matrix): Polar
	return polar(matcopy(nil, A))
end

-- The numerical rank of A from the SVD F: singular values above tol * s_1 (default
-- tol = max(rows, cols) * eps, as for svd_solve).
local function svd_rank(F: Svd, m: number, n: number, tol: number?): number
	local k = math.min(m, n)
	if k == 0 then
		return 0
	end
	local s = F.values
	local limit = (tol or math.max(m, n) * EPS) * buffer.readf32(s, 0)
	local r = 0
	while r < k and buffer.readf32(s, 4 * r) > limit do
		r += 1
	end
	return r
end

-- The numerical rank (see svd_rank for tol).
local function rank(A: Matrix, tol: number?): number
	return svd_rank(svd_copy(A, false), A.rows, A.cols, tol)
end

-- An orthonormal basis of the range of A (rows by rank), from the SVD.
local function orth(A: Matrix, tol: number?): Matrix
	local m, n = A.rows, A.cols
	local F = svd_copy(A)
	local r = svd_rank(F, m, n, tol)
	local U = F.u :: Matrix
	local o = matrix(m, r)
	buffer.copy(o.data, 0, U.data, 0, ENTRY * m * r)
	return o
end

-- An orthonormal basis of the null space of A (cols by cols - rank): the orthogonal
-- complement of the first rank right singular vectors, completed through the full Q
-- of their QR factorization.
local function null_space(A: Matrix, tol: number?): Matrix
	local m, n = A.rows, A.cols
	local F = svd_copy(A)
	local r = svd_rank(F, m, n, tol)
	local N = matrix(n, n - r)
	if r == 0 then
		for j = 0, n - 1 do
			buffer.writef32(N.data, ENTRY * (j * n + j), 1)
		end
		return N
	end
	local Vr = matrix(n, r)
	buffer.copy(Vr.data, 0, (F.v :: Matrix).data, 0, ENTRY * n * r)
	local Q = qr(Vr)
	for j = r + 1, n do
		local e = unit(n, j)
		qr_apply_q(Q, e)
		buffer.copy(N.data, ENTRY * (j - r - 1) * n, e)
	end
	return N
end

-- The condition number in the given norm (see matnorm): kind 2 (the default) is
-- s_max / s_min from the SVD, for any shape (inf if rank deficient); kinds 1, "inf"
-- and "fro" use the inverse of a square A (inf if singular).
local function cond(A: Matrix, kind: (number | string)?): number
	local k = kind or 2
	if k == 2 then
		local q = math.min(A.rows, A.cols)
		if q == 0 then
			return 0
		end
		local s = svd_copy(A, false).values
		local smin = buffer.readf32(s, 4 * (q - 1))
		return if smin == 0 then math.huge else buffer.readf32(s, 0) / smin
	end
	assert(A.rows == A.cols, "cond: this norm needs a square matrix")
	local F = lu_copy(A)
	if F.singular then
		return math.huge
	end
	return matnorm(A, k) * matnorm(inv_copy(A), k)
end

-- An estimate of the reciprocal condition number 1 / (|A|_1 |A^-1|_1) from the LU
-- factorization, in O(n^2) after it (LAPACK's gecon): |A^-1|_1 by Hager's method
-- with Higham's refinements, which is almost always within a factor of 3 and never an
-- overestimate. Returns 0 for a singular matrix. A is not modified.
local function rcond(A: Matrix): number
	local n = A.rows
	assert(A.cols == n, "rcond needs a square matrix")
	if n == 0 then
		return math.huge
	end
	local anorm = matnorm(A, 1)
	local F = lu_copy(A)
	if F.singular or anorm == 0 then
		return 0
	end
	-- Hager: maximize |A^-1 x|_1 over |x|_1 = 1 by a few gradient steps.
	local x = buffer.create(ENTRY * n)
	for i = 0, n - 1 do
		buffer.writef32(x, ENTRY * i, 1 / n)
	end
	local est, last = 0, 0
	for iter = 1, 5 do
		local y = lu_solve(nil, F, x)
		est = math.max(est, asum(y))
		if iter > 1 and est <= last then
			break
		end
		last = est
		local z = lu_solve_adjoint(nil, F, signs(y))
		local zmax, j = argmax(z)
		if iter > 1 and zmax <= rdot(z, x) then
			break
		end
		x = unit(n, j)
	end
	-- Higham's extra vector x_i = (-1)^i (1 + i / (n - 1)) guards against the cases
	-- where the gradient steps stall.
	local alt = buffer.create(buffer.len(x))
	for i = 0, n - 1 do
		buffer.writef32(alt, ENTRY * i, (if i % 2 == 0 then 1 else -1) * (1 + (if n > 1 then i / (n - 1) else 0)))
	end
	est = math.max(est, 2 * asum(lu_solve(nil, F, alt)) / (3 * n))
	return 1 / (anorm * est)
end

local function abs1(re: number, im: number): number
	return math.abs(re) + math.abs(im)
end

-- A rotation (c real, s complex) with [c s; -conj(s) c] [a; b] = [r; 0].
local function rotation(ar: number, ai: number, br: number, bi: number): (number, number, number)
	if br == 0 and bi == 0 then
		return 1, 0, 0
	end
	local na = complex64.abs(ar, ai)
	if na == 0 then
		return 0, 1, 0
	end
	local r = hypot3(na, complex64.abs(br, bi), 0)
	local c = na / r
	-- s = (a / |a|) conj(b) / r
	local ur, ui = ar / na, ai / na
	return c, (ur * br + ui * bi) / r, (ui * br - ur * bi) / r
end

-- Rows i, j of the n by n matrix in buf, columns c0..n-1:
-- (x, y) := (c x + s y, -conj(s) x + c y).
local function rows(buf: buffer, n: number, i: number, j: number, c0: number, c: number, sr: number, si: number)
	for col = math.max(c0, 0), n - 1 do
		local xr, xi = cread(buf, col * n + i)
		local yr, yi = cread(buf, col * n + j)
		cwrite(buf, col * n + i, c * xr + sr * yr - si * yi, c * xi + sr * yi + si * yr)
		cwrite(buf, col * n + j, -(sr * xr + si * xi) + c * yr, -(sr * xi - si * xr) + c * yi)
	end
end

-- Columns keep and other of rows 0..r1 of the n by n matrix in buf:
-- (keep, other) := (c keep + s other, -conj(s) keep + c other). Chosen with
-- rotation(keep_value, other_value), it zeros the other column's entry in that row.
local function cols(buf: buffer, n: number, keep: number, other: number, r1: number, c: number, sr: number, si: number)
	for row = 0, math.min(r1, n - 1) do
		local xr, xi = cread(buf, keep * n + row)
		local yr, yi = cread(buf, other * n + row)
		cwrite(buf, keep * n + row, c * xr + sr * yr - si * yi, c * xi + sr * yi + si * yr)
		cwrite(buf, other * n + row, -(sr * xr + si * xi) + c * yr, -(sr * xi - si * xr) + c * yi)
	end
end

-- Q := Q G^H for a row rotation G on rows i, j: columns i, j of Q become
-- (c q_i + conj(s) q_j, -s q_i + c q_j).
local function qcols(Q: buffer, n: number, i: number, j: number, c: number, sr: number, si: number)
	for row = 0, n - 1 do
		local xr, xi = cread(Q, i * n + row)
		local yr, yi = cread(Q, j * n + row)
		-- c x + conj(s) y, then -s x + c y
		cwrite(Q, i * n + row, c * xr + sr * yr + si * yi, c * xi + sr * yi - si * yr)
		cwrite(Q, j * n + row, -(sr * xr - si * xi) + c * yr, -(sr * xi + si * xr) + c * yi)
	end
end

-- The generalized Schur form A = Q S Z^H, B = Q P Z^H with S and P upper triangular,
-- in place (A becomes S and B becomes P), by Moler and Stewart's QZ algorithm with
-- single Wilkinson-type shifts: B is made triangular by a QR factorization, A
-- Hessenberg by rotations that keep B triangular, then QZ steps deflate eigenvalues
-- from the bottom. A (numerically) zero diagonal entry of P in the active block is
-- chased to the top of the block with rotations that keep the Hessenberg-triangular
-- form, where it splits off an infinite eigenvalue. Returns Q and Z (if wanted).
local function qz(A: Matrix, B: Matrix, want: boolean): (Matrix?, Matrix?)
	local n = A.rows
	assert(A.cols == n and B.rows == n and B.cols == n, "qz needs square matrices of one size")
	local F = qr(matcopy(nil, B))
	local Q = if want then qr_q(nil, F) else nil
	local R = qr_r(nil, F)
	buffer.copy(B.data, 0, R.data)
	-- A := Q0^H A, column by column.
	for j = 0, n - 1 do
		local col = create(n)
		buffer.copy(col, 0, A.data, 8 * (j * n), 8 * n)
		qr_apply_qh(F, col)
		buffer.copy(A.data, 8 * (j * n), col)
	end
	local Z = if want then identity(n) else nil
	local h, t = A.data, B.data
	-- Hessenberg-triangular reduction.
	for j = 0, n - 3 do
		for i = n - 1, j + 2, -1 do
			local ar, ai = cread(h, j * n + i - 1)
			local br, bi = cread(h, j * n + i)
			local c, sr, si = rotation(ar, ai, br, bi)
			rows(h, n, i - 1, i, j, c, sr, si)
			rows(t, n, i - 1, i, i - 1, c, sr, si)
			if Q then
				qcols(Q.data, n, i - 1, i, c, sr, si)
			end
			-- B now has fill at (i, i-1): zero it with columns (i, i-1).
			local kr, ki = cread(t, i * n + i)
			local orr, oi = cread(t, (i - 1) * n + i)
			c, sr, si = rotation(kr, ki, orr, oi)
			cols(t, n, i, i - 1, i, c, sr, si)
			cols(h, n, i, i - 1, n - 1, c, sr, si)
			if Z then
				cols(Z.data, n, i, i - 1, n - 1, c, sr, si)
			end
		end
	end
	-- Zero below the subdiagonal of A and below the diagonal of B exactly.
	for j = 0, n - 1 do
		for i = j + 2, n - 1 do
			cwrite(h, j * n + i, 0, 0)
		end
		for i = j + 1, n - 1 do
			cwrite(t, j * n + i, 0, 0)
		end
	end
	local tnorm = norm(t)
	local hnorm = norm(h)
	local ihi = n - 1
	local its, total = 0, 0
	local limit = 30 * math.max(n, 1)
	while ihi >= 0 do
		-- Active block l..ihi: H(l, l-1) negligible.
		local l = ihi
		while l > 0 do
			local sr0, si0 = cread(h, (l - 1) * n + l)
			local ar, ai = cread(h, l * n + l)
			local pr, pi = cread(h, (l - 1) * n + l - 1)
			local scale = abs1(ar, ai) + abs1(pr, pi)
			if scale == 0 then
				scale = hnorm
			end
			if abs1(sr0, si0) <= EPS * scale then
				cwrite(h, (l - 1) * n + l, 0, 0)
				break
			end
			l -= 1
		end
		if l == ihi then
			ihi -= 1
			its = 0
			continue
		end
		-- A negligible diagonal entry of P in the block: chase it to the top (row l),
		-- where a rotation of rows l, l+1 splits off an infinite eigenvalue.
		local zero = -1
		for j = l, ihi do
			if abs1(cread(t, j * n + j)) <= EPS * tnorm then
				cwrite(t, j * n + j, 0, 0)
				zero = j
				break
			end
		end
		if zero >= 0 then
			for j = zero, l + 1, -1 do
				-- Columns (j, j-1) of P: zero P(j-1, j-1), keeping column j.
				local kr, ki = cread(t, j * n + j - 1)
				local orr, oi = cread(t, (j - 1) * n + j - 1)
				local c, sr, si = rotation(kr, ki, orr, oi)
				cols(t, n, j, j - 1, j, c, sr, si)
				cols(h, n, j, j - 1, math.min(j + 1, n - 1), c, sr, si)
				if Z then
					cols(Z.data, n, j, j - 1, n - 1, c, sr, si)
				end
				cwrite(t, (j - 1) * n + j - 1, 0, 0)
				-- That filled H(j+1, j-1) (unless j is the block's last row): zero it
				-- with rows (j, j+1).
				if j + 1 <= ihi then
					local ar, ai = cread(h, (j - 1) * n + j)
					local br, bi = cread(h, (j - 1) * n + j + 1)
					c, sr, si = rotation(ar, ai, br, bi)
					rows(h, n, j, j + 1, j - 1, c, sr, si)
					rows(t, n, j, j + 1, j, c, sr, si)
					if Q then
						qcols(Q.data, n, j, j + 1, c, sr, si)
					end
					cwrite(h, (j - 1) * n + j + 1, 0, 0)
				end
			end
			-- P(l, l) = 0: rows (l, l+1) zero H(l+1, l) and keep P triangular.
			local ar, ai = cread(h, l * n + l)
			local br, bi = cread(h, l * n + l + 1)
			local c, sr, si = rotation(ar, ai, br, bi)
			rows(h, n, l, l + 1, l, c, sr, si)
			rows(t, n, l, l + 1, l, c, sr, si)
			if Q then
				qcols(Q.data, n, l, l + 1, c, sr, si)
			end
			cwrite(h, l * n + l + 1, 0, 0)
			cwrite(t, l * n + l + 1, 0, 0)
			continue
		end
		its += 1
		total += 1
		if total > limit then
			error("qz: the iteration did not converge")
		end
		-- Shift: the eigenvalue of the trailing 2 by 2 pencil closest to
		-- H(ihi, ihi) / P(ihi, ihi); an exceptional shift every 10 iterations.
		local a11r, a11i = cread(h, (ihi - 1) * n + ihi - 1)
		local a21r, a21i = cread(h, (ihi - 1) * n + ihi)
		local a12r, a12i = cread(h, ihi * n + ihi - 1)
		local a22r, a22i = cread(h, ihi * n + ihi)
		local b11r, b11i = cread(t, (ihi - 1) * n + ihi - 1)
		local b12r, b12i = cread(t, ihi * n + ihi - 1)
		local b22r, b22i = cread(t, ihi * n + ihi)
		local sigr, sigi
		if its % 10 == 0 then
			local er, ei = complex64.div(a22r, a22i, b22r, b22i)
			local bump = abs1(a21r, a21i) / math.max(abs1(b11r, b11i), EPS * tnorm)
			sigr, sigi = er + bump, ei
		else
			-- det(H2 - lambda P2) = qa lambda^2 - qb lambda + qc.
			local qar, qai = complex64.mul(b11r, b11i, b22r, b22i)
			local m1r, m1i = complex64.mul(a11r, a11i, b22r, b22i)
			local m2r, m2i = complex64.mul(a22r, a22i, b11r, b11i)
			local m3r, m3i = complex64.mul(a21r, a21i, b12r, b12i)
			local qbr, qbi = m1r + m2r - m3r, m1i + m2i - m3i
			local d1r, d1i = complex64.mul(a11r, a11i, a22r, a22i)
			local d2r, d2i = complex64.mul(a12r, a12i, a21r, a21i)
			local qcr, qci = d1r - d2r, d1i - d2i
			-- Roots (qb +- sqrt(qb^2 - 4 qa qc)) / (2 qa).
			local s1r, s1i = complex64.mul(qbr, qbi, qbr, qbi)
			local s2r, s2i = complex64.mul(qar, qai, qcr, qci)
			local dr, di = complex64.sqrt(s1r - 4 * s2r, s1i - 4 * s2i)
			local tr, ti = complex64.div(a22r, a22i, b22r, b22i)
			local r1r, r1i = complex64.div(qbr + dr, qbi + di, 2 * qar, 2 * qai)
			local r2r, r2i = complex64.div(qbr - dr, qbi - di, 2 * qar, 2 * qai)
			if r1r ~= r1r or r2r ~= r2r then
				sigr, sigi = tr, ti
			elseif abs1(r1r - tr, r1i - ti) <= abs1(r2r - tr, r2i - ti) then
				sigr, sigi = r1r, r1i
			else
				sigr, sigi = r2r, r2i
			end
		end
		-- The first rotation comes from the first column of H - sigma P.
		local h0r, h0i = cread(h, l * n + l)
		local p0r, p0i = cread(t, l * n + l)
		local spr, spi = complex64.mul(sigr, sigi, p0r, p0i)
		local h1r, h1i = cread(h, l * n + l + 1)
		local c, sr, si = rotation(h0r - spr, h0i - spi, h1r, h1i)
		rows(h, n, l, l + 1, l, c, sr, si)
		rows(t, n, l, l + 1, l, c, sr, si)
		if Q then
			qcols(Q.data, n, l, l + 1, c, sr, si)
		end
		-- Chase the bulge down.
		for k = l, ihi - 1 do
			-- P fill at (k+1, k): columns (k+1, k).
			local kr, ki = cread(t, (k + 1) * n + k + 1)
			local orr, oi = cread(t, k * n + k + 1)
			c, sr, si = rotation(kr, ki, orr, oi)
			cols(t, n, k + 1, k, k + 1, c, sr, si)
			cols(h, n, k + 1, k, math.min(k + 2, ihi), c, sr, si)
			if Z then
				cols(Z.data, n, k + 1, k, n - 1, c, sr, si)
			end
			cwrite(t, k * n + k + 1, 0, 0)
			-- H fill at (k+2, k): rows (k+1, k+2).
			if k + 2 <= ihi then
				local ar, ai = cread(h, k * n + k + 1)
				local br, bi = cread(h, k * n + k + 2)
				c, sr, si = rotation(ar, ai, br, bi)
				rows(h, n, k + 1, k + 2, k, c, sr, si)
				rows(t, n, k + 1, k + 2, k + 1, c, sr, si)
				if Q then
					qcols(Q.data, n, k + 1, k + 2, c, sr, si)
				end
				cwrite(h, k * n + k + 2, 0, 0)
			end
		end
	end
	return Q, Z
end

-- The Hermitian-definite generalized eigenproblem (shared by the real and complex
-- modules).

-- The columns of the triangular solve T X = B, one right-hand side at a time.
local function tri_solve_matrix(T: Matrix, B: Matrix, uplo: Uplo): Matrix
	local n = B.rows
	local X = matrix(n, B.cols)
	local col = buffer.create(ENTRY * n)
	for j = 0, B.cols - 1 do
		buffer.copy(col, 0, B.data, ENTRY * j * n, ENTRY * n)
		buffer.copy(X.data, ENTRY * j * n, triangular_solve(nil, T, col, uplo))
	end
	return X
end

-- Eigenvalues (ascending) and, unless vectors is false, eigenvectors of A x = lambda B x
-- for Hermitian A and Hermitian positive definite B (LAPACK's sygv): with B = L L^H it
-- solves the standard problem for C = L^-1 A L^-H and maps the vectors back by
-- x = L^-H y, so they are B-orthonormal (X^H B X = I). A must be Hermitian (both
-- triangles are read); only B's lower triangle is read. In place: B is overwritten with
-- its Cholesky factor and A with the eigenvectors (or workspace). An error if B is not
-- positive definite. eigh_gen_copy leaves both unchanged.
local function eigh_gen(A: Matrix, B: Matrix, vectors: boolean?): Eigh
	local n = A.rows
	assert(A.cols == n and B.rows == n and B.cols == n, "eigh_gen needs square matrices of one size")
	local F = chol(B)
	assert(F.definite, "eigh_gen: B must be positive definite")
	local L = chol_l(nil, F)
	local W = tri_solve_matrix(L, A, "lower")
	local C = tri_solve_matrix(L, conj_transpose(nil, W), "lower")
	C.data = scale(nil, 0.5, add(nil, C.data, conj_transpose(nil, C).data))
	local E = eigh(C, vectors)
	if E.vectors then
		local X = tri_solve_matrix(conj_transpose(nil, L), E.vectors, "upper")
		buffer.copy(A.data, 0, X.data)
		return { values = E.values, vectors = A }
	end
	return { values = E.values, vectors = nil }
end

-- The generalized problem on copies; A and B are not modified.
local function eigh_gen_copy(A: Matrix, B: Matrix, vectors: boolean?): Eigh
	return eigh_gen(matcopy(nil, A), matcopy(nil, B), vectors)
end

-- Generalized eigenvalues lambda = alpha / beta of A x = lambda B x and, unless vectors
-- is false, unit eigenvectors, by the QZ algorithm (see qz). values holds alpha / beta,
-- with an infinite eigenvalue (beta = 0, possible when B is singular) as (inf, 0) and
-- an undefined one (alpha = beta = 0: a singular pencil) as NaN; alpha and beta are
-- returned too. Column k of vectors belongs to values[k]. In place: A and B are
-- overwritten with the generalized Schur form. eig_gen_copy leaves them unchanged.
local function eig_gen(A: Matrix, B: Matrix, vectors: boolean?): GenEig
	local n = A.rows
	assert(A.cols == n and B.rows == n and B.cols == n, "eig_gen needs square matrices of one size")
	local want = vectors ~= false
	local reals = 2 * n * n
	if any_nonfinite(A.data, 0, reals) or any_nonfinite(B.data, 0, reals) then
		local function nans(count: number): buffer
			local b = buffer.create(4 * count)
			fill_nan(b, 0, count)
			return b
		end
		local V = if want then matrix(n, n) else nil
		if V then
			fill_nan(V.data, 0, reals)
		end
		fill_nan(A.data, 0, reals)
		fill_nan(B.data, 0, reals)
		return { values = nans(2 * n), alpha = nans(2 * n), beta = nans(2 * n), vectors = V }
	end
	local _, Z = qz(A, B, want)
	local s, p = A.data, B.data
	local alpha, beta, values = create(n), create(n), create(n)
	for k = 0, n - 1 do
		local ar, ai = cread(s, k * n + k)
		local br, bi = cread(p, k * n + k)
		cwrite(alpha, k, ar, ai)
		cwrite(beta, k, br, bi)
		if br == 0 and bi == 0 then
			if ar == 0 and ai == 0 then
				cwrite(values, k, 0 / 0, 0 / 0)
			else
				cwrite(values, k, math.huge, 0)
			end
		else
			cwrite(values, k, complex64.div(ar, ai, br, bi))
		end
	end
	local V: Matrix? = nil
	if Z then
		-- Right eigenvectors of the triangular pencil: (beta S - alpha P) x = 0 with
		-- x_k = 1, by back substitution (tiny denominators perturbed, as in tgevc),
		-- then Z x, normalized.
		local snorm, pnorm = norm(s), norm(p)
		local X = matrix(n, n)
		local xr, xi = table.create(n, 0) :: { number }, table.create(n, 0) :: { number }
		for k = 0, n - 1 do
			local ar, ai = cread(alpha, k)
			local br, bi = cread(beta, k)
			local smin = math.max(EPS * (complex64.abs(br, bi) * snorm + complex64.abs(ar, ai) * pnorm), 1e-300)
			for i = 0, n - 1 do
				xr[i + 1], xi[i + 1] = 0, 0
			end
			xr[k + 1] = 1
			for j = k - 1, 0, -1 do
				local sr, si = 0, 0
				for i = j + 1, k do
					local s1r, s1i = complex64.mul(br, bi, cread(s, i * n + j))
					local p1r, p1i = complex64.mul(ar, ai, cread(p, i * n + j))
					local cr, ci = s1r - p1r, s1i - p1i
					sr -= cr * xr[i + 1] - ci * xi[i + 1]
					si -= cr * xi[i + 1] + ci * xr[i + 1]
				end
				local d1r, d1i = complex64.mul(br, bi, cread(s, j * n + j))
				local d2r, d2i = complex64.mul(ar, ai, cread(p, j * n + j))
				local dr, di = d1r - d2r, d1i - d2i
				if complex64.abs(dr, di) < smin then
					dr, di = smin, 0
				end
				xr[j + 1], xi[j + 1] = complex64.div(sr, si, dr, di)
			end
			-- Column k of X := Z x.
			local col = create(n)
			for i = 0, k do
				local wr0, wi0 = xr[i + 1], xi[i + 1]
				if wr0 ~= 0 or wi0 ~= 0 then
					for r = 0, n - 1 do
						local zr, zi = cread(Z.data, i * n + r)
						local cr, ci = cread(col, r)
						cwrite(col, r, cr + zr * wr0 - zi * wi0, ci + zr * wi0 + zi * wr0)
					end
				end
			end
			local nrm = norm(col)
			if nrm > 0 then
				col = scale(col, 1 / nrm, col)
			end
			buffer.copy(X.data, 8 * (k * n), col)
		end
		V = X
	end
	return { values = values, alpha = alpha, beta = beta, vectors = V }
end

-- The generalized eigenproblem on copies; A and B are not modified.
local function eig_gen_copy(A: Matrix, B: Matrix, vectors: boolean?): GenEig
	return eig_gen(matcopy(nil, A), matcopy(nil, B), vectors)
end

type RsvdOptions = { oversample: number?, power: number?, seed: number? }

-- A rank-k approximation A ~ U diag(values) V^H by the randomized SVD (Halko, Martinsson
-- and Tropp 2011): an orthonormal basis Q of the range of A Omega for a Gaussian Omega
-- with k + options.oversample (default 10) columns, refined by options.power (default
-- 2) power iterations (each re-orthonormalized), then the SVD of the small Q^H A.
-- options.seed seeds math.random (the global generator) for reproducible results.
-- Accurate when the singular values decay; the power iterations help when they decay
-- slowly. A is not modified.
local function rsvd(A: Matrix, k: number, options: RsvdOptions?): Svd
	local o: RsvdOptions = options or {}
	local m, n = A.rows, A.cols
	local kk = math.min(k, m, n)
	local l = math.min(kk + (o.oversample or 10), m, n)
	if o.seed then
		math.randomseed(o.seed)
	end
	local Omega = matrix(n, l)
	local reals = buffer.len(Omega.data) // 4
	for i = 0, reals - 1 do
		-- Box-Muller: a standard normal from two uniforms.
		local u1 = math.max(math.random(), 1e-300)
		buffer.writef32(Omega.data, 4 * i, math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * math.random()))
	end
	local Ah = conj_transpose(nil, A)
	local Q = qr_q(nil, qr(matmul(nil, A, Omega)))
	for _ = 1, o.power or 2 do
		local Z = qr_q(nil, qr(matmul(nil, Ah, Q)))
		Q = qr_q(nil, qr(matmul(nil, A, Z)))
	end
	local B = matmul(nil, conj_transpose(nil, Q), A)
	local S = svd(B)
	local U = matmul(nil, Q, S.u :: Matrix)
	local values = buffer.create(4 * kk)
	buffer.copy(values, 0, S.values, 0, 4 * kk)
	local Uk, Vk = matrix(m, kk), matrix(n, kk)
	buffer.copy(Uk.data, 0, U.data, 0, ENTRY * m * kk)
	buffer.copy(Vk.data, 0, (S.v :: Matrix).data, 0, ENTRY * n * kk)
	return { values = values, u = Uk, v = Vk }
end

type RandOptions = { tol: number?, seed: number? }

-- An index j drawn with probability w[j] / total (w nonnegative, total = sum of w).
local function draw(w: { number }, total: number): number
	local u = math.random() * total
	local acc = 0
	for j = 1, #w do
		acc += w[j]
		if u < acc and w[j] > 0 then
			return j
		end
	end
	-- Rounding left u at the end: the last index with positive weight.
	for j = #w, 1, -1 do
		if w[j] > 0 then
			return j
		end
	end
	return 1
end

-- Randomly pivoted Cholesky (Chen, Epperly, Tropp and Webber 2022) for a Hermitian
-- positive semidefinite matrix given by its size n, its diagonal (a table of n real
-- numbers) and a function column(j) returning column j (1-based) as an array. Builds
-- A ~ F F^H, where F has one column per step: each step draws a pivot s with
-- probability proportional to the diagonal of the residual A - F F^H, then takes the
-- residual's column s, scaled by its pivot's square root. Only the chosen columns of A
-- are ever requested, so A need not be formed (kernel matrices, for instance): about
-- k^2 n work and k columns. The result is a Nystrom approximation, near-optimal in
-- trace norm: it stops after k steps, or once trace(A - F F^H) <= options.tol
-- (default 0) times trace(A). options.seed seeds math.random (the global generator).
-- Returns { factor = F (n by rank), pivots (the chosen columns, 1-based), rank,
-- residual = trace(A - F F^H) }.
local function rpcholesky_columns(n: number, diag: { number }, column: (j: number) -> buffer, k: number, options: RandOptions?): RPCholesky
	local o: RandOptions = options or {}
	if o.seed then
		math.randomseed(o.seed)
	end
	local d = table.create(n, 0) :: { number }
	local total0 = 0
	for i = 1, n do
		d[i] = math.max(diag[i], 0)
		total0 += d[i]
	end
	local tol = (o.tol or 0) * total0
	local kk = math.min(k, n)
	local F = matrix(n, kk)
	local pivots: { number } = {}
	local cols: { buffer } = {}
	local total = total0
	local r = 0
	while r < kk and total > tol and total > 0 do
		local s = draw(d, total)
		-- g = A(:, s) - F(:, 1..r) F(s, 1..r)^H
		local g = copy(nil, column(s))
		for l = 1, r do
			local fr, fi = eget(cols[l], s - 1)
			g = caxpy_pair(g, -fr, fi, cols[l], g)
		end
		local gs = eget(g, s - 1)
		if not (gs > 0) then
			-- The residual vanishes at s (to rounding): nothing left there.
			d[s] = 0
		else
			r += 1
			local f = scale(g, 1 / math.sqrt(gs), g)
			cols[r] = f
			table.insert(pivots, s)
			buffer.copy(F.data, ENTRY * (r - 1) * n, f)
			for i = 1, n do
				local fr, fi = eget(f, i - 1)
				d[i] = math.max(d[i] - (fr * fr + fi * fi), 0)
			end
			d[s] = 0
		end
		total = 0
		for i = 1, n do
			total += d[i]
		end
	end
	local out = matrix(n, r)
	buffer.copy(out.data, 0, F.data, 0, ENTRY * n * r)
	return { factor = out, pivots = pivots, rank = r, residual = total }
end

-- Randomly pivoted Cholesky of a Hermitian positive semidefinite matrix A (see
-- rpcholesky_columns; only the diagonal and the chosen columns are read). A is not
-- modified.
local function rpcholesky(A: Matrix, k: number, options: RandOptions?): RPCholesky
	local n = A.rows
	assert(A.cols == n, "rpcholesky needs a square matrix")
	local diag = table.create(n, 0) :: { number }
	for i = 1, n do
		diag[i] = eget(A.data, (i - 1) * n + i - 1)
	end
	return rpcholesky_columns(n, diag, function(j: number): buffer
		local c = buffer.create(ENTRY * n)
		buffer.copy(c, 0, A.data, ENTRY * (j - 1) * n, ENTRY * n)
		return c
	end, k, options)
end

-- Randomly pivoted QR (adaptive sampling; Deshpande and Vempala 2006): A ~ Q R from k
-- columns of A chosen at random, each with probability proportional to its squared
-- norm after projecting out the columns chosen so far. Q (rows by rank) is an
-- orthonormal basis of the chosen columns, made by modified Gram-Schmidt run twice,
-- and R = Q^H A, so Q R is the projection of A onto them. It is RPCholesky applied to
-- A^H A, and near-optimal in the Frobenius norm. Stops after k steps, or once
-- |A - Q R|_F^2 <= options.tol (default 0) times |A|_F^2; options.seed seeds
-- math.random. About k m n work. Returns { q, r, pivots (the chosen columns, 1-based),
-- rank, residual = |A - Q R|_F^2 }. A is not modified.
local function rpqr(A: Matrix, k: number, options: RandOptions?): RPQR
	local o: RandOptions = options or {}
	if o.seed then
		math.randomseed(o.seed)
	end
	local m, n = A.rows, A.cols
	local kk = math.min(k, m, n)
	local function col(j: number): buffer
		local c = buffer.create(ENTRY * m)
		buffer.copy(c, 0, A.data, ENTRY * (j - 1) * m, ENTRY * m)
		return c
	end
	local c = table.create(n, 0) :: { number }
	local total0 = 0
	for j = 1, n do
		local v = norm(col(j))
		c[j] = v * v
		total0 += c[j]
	end
	local tol = (o.tol or 0) * total0
	local Q: { buffer } = {}
	local rows: { { number } } = {} -- R by rows, as (re, im) pairs per column
	local rowsi: { { number } } = {}
	local pivots: { number } = {}
	local total = total0
	local r = 0
	while r < kk and total > tol and total > 0 do
		local s = draw(c, total)
		local q = col(s)
		for _ = 1, 2 do
			for l = 1, r do
				local hr, hi = dotc_pair(Q[l], q)
				q = caxpy_pair(q, -hr, -hi, Q[l], q)
			end
		end
		local qn = norm(q)
		if not (qn > 0) then
			c[s] = 0
		else
			r += 1
			q = scale(q, 1 / qn, q)
			Q[r] = q
			table.insert(pivots, s)
			-- Row r of R = q^H A, and the residual column norms shrink by |q^H a_j|^2.
			local rr, ri = table.create(n, 0) :: { number }, table.create(n, 0) :: { number }
			for j = 1, n do
				local hr, hi = dotc_pair(q, col(j))
				rr[j], ri[j] = hr, hi
				c[j] = math.max(c[j] - (hr * hr + hi * hi), 0)
			end
			c[s] = 0
			rows[r], rowsi[r] = rr, ri
		end
		total = 0
		for j = 1, n do
			total += c[j]
		end
	end
	local Qm, Rm = matrix(m, r), matrix(r, n)
	for l = 1, r do
		buffer.copy(Qm.data, ENTRY * (l - 1) * m, Q[l])
		for j = 1, n do
			eset(Rm.data, (j - 1) * r + l - 1, rows[l][j], rowsi[l][j])
		end
	end
	return { q = Qm, r = Rm, pivots = pivots, rank = r, residual = total }
end

