-- Types and small helpers shared by the parts. They are copied into each part rather than
-- imported, so calls to them are inlined (a call into another module costs several times
-- more); the generator drops the ones a part does not use.

type Matrix = types.Matrix

-- A rows by cols matrix of zeros.
local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(8 * rows * cols) }
end

local function cread(x: buffer, i: number): (number, number)
	return buffer.readf32(x, 8 * i), buffer.readf32(x, 8 * i + 4)
end

local function cwrite(x: buffer, i: number, re: number, im: number)
	buffer.writef32(x, 8 * i, re)
	buffer.writef32(x, 8 * i + 4, im)
end

-- Element i (0-based) as (re, im), and its setter, for code shared with the real modules.
local eget = cread
local eset = cwrite

-- Padé coefficients b_0 .. b_m of exp, and the 1-norm thresholds theta_m below which
-- the [m/m] approximant is accurate to unit roundoff (Higham 2005; single precision
-- uses its own thresholds and stops at m = 7).
local PADE: { [number]: { number } } = {
	[3] = { 120, 60, 12, 1 },
	[5] = { 30240, 15120, 3360, 420, 30, 1 },
	[7] = { 17297280, 8648640, 1995840, 277200, 25200, 1512, 56, 1 },
	[9] = { 17643225600, 8821612800, 2075673600, 302702400, 30270240, 2162160, 110880, 3960, 90, 1 },
	[13] = {
		64764752532480000,
		32382376266240000,
		7771770303897600,
		1187353796428800,
		129060195264000,
		10559470521600,
		670442572800,
		33522128640,
		1323241920,
		40840800,
		960960,
		16380,
		182,
		1,
	},
}
local THETA: { { number } } = if EPS > 1e-10
	then { { 3, 4.258730016922831e-1 }, { 5, 1.880152677804762 }, { 7, 3.925724783138660 } }
	else {
		{ 3, 1.495585217958292e-2 },
		{ 5, 2.539398330063230e-1 },
		{ 7, 9.504178996162932e-1 },
		{ 9, 2.097847961257068 },
		{ 13, 5.371920351148152 },
	}

-- M := M + c I.
local function add_identity(M: Matrix, c: number)
	local n = M.rows
	for i = 0, n - 1 do
		local re, im = eget(M.data, i * n + i)
		eset(M.data, i * n + i, re + c, im)
	end
end

-- The [m/m] Padé approximant r_m(A) = (V - U)^-1 (V + U), U odd and V even in A. Works in
-- a fixed set of n by n matrices (6 for m < 13, 5 for m = 13), each product written into
-- one no longer needed, and returns one of them.
local function pade(A: Matrix, m: number): Matrix
	local n = A.rows
	local b = PADE[m]
	local A2 = matmul(nil, A, A)
	local U: Matrix, P: Matrix, Q: Matrix
	if m < 13 then
		-- W = b_2 I + b_4 A^2 + ..., V = b_1 I + b_3 A^2 + ...; powers of A^2 alternate
		-- between X1 and X2
		local W, V = matrix(n, n), matrix(n, n)
		add_identity(W, b[2])
		add_identity(V, b[1])
		local X1: Matrix?, X2: Matrix? = nil, nil
		local Pk = A2
		for k = 1, (m - 1) // 2 do
			axpy(W.data, b[2 * k + 2], Pk.data, W.data)
			axpy(V.data, b[2 * k + 1], Pk.data, V.data)
			if k < (m - 1) // 2 then
				local into = if Pk == X1 then X2 else X1
				Pk = matmul(into, Pk, A2)
				if into == nil then
					if X1 == nil then
						X1 = Pk
					else
						X2 = Pk
					end
				end
			end
		end
		U = matmul(nil, A, W)
		-- Q = V - U into W, P = V + U into V
		Q = W
		sub(Q.data, V.data, U.data)
		P = V
		add(P.data, V.data, U.data)
	else
		local A4 = matmul(nil, A2, A2)
		local A6 = matmul(nil, A4, A2)
		-- T = b_14 A^6 + b_12 A^4 + b_10 A^2; W = A^6 T + b_8 A^6 + b_6 A^4 + b_4 A^2 + b_2 I
		local T = matrix(n, n)
		scale(T.data, b[14], A6.data)
		axpy(T.data, b[12], A4.data, T.data)
		axpy(T.data, b[10], A2.data, T.data)
		local W = matmul(nil, A6, T)
		axpy(W.data, b[8], A6.data, W.data)
		axpy(W.data, b[6], A4.data, W.data)
		axpy(W.data, b[4], A2.data, W.data)
		add_identity(W, b[2])
		U = matmul(T, A, W) -- (T is free now)
		-- V = A^6 (b_13 A^6 + b_11 A^4 + b_9 A^2) + b_7 A^6 + b_5 A^4 + b_3 A^2 + b_1 I: the
		-- product's factor into W, the rest into A4, the product into A2
		scale(W.data, b[13], A6.data)
		axpy(W.data, b[11], A4.data, W.data)
		axpy(W.data, b[9], A2.data, W.data)
		scale(A4.data, b[5], A4.data)
		axpy(A4.data, b[7], A6.data, A4.data)
		axpy(A4.data, b[3], A2.data, A4.data)
		add_identity(A4, b[1])
		local V = matmul(A2, A6, W)
		axpy(V.data, 1, A4.data, V.data)
		-- P = V + U into A4, Q = V - U into A6
		P = A4
		add(P.data, V.data, U.data)
		Q = A6
		sub(Q.data, V.data, U.data)
	end
	-- X = Q^-1 P, factoring Q in place, into U (free now)
	return solve(U, lu(Q), P, "lu")
end

-- Diagonal scaling D (powers of 2, so exact) making each row and column of D^-1 A D about
-- equally large off the diagonal (the scaling step of LAPACK's gebal). Returns D^-1 A D
-- and D's diagonal.
local function scaling_balance(A: Matrix): (Matrix, { number })
	local n = A.rows
	local B = matcopy(nil, A)
	local b = B.data
	local d = table.create(n, 1)
	local function mag(i: number, j: number): number
		local re, im = eget(b, j * n + i)
		return math.abs(re) + math.abs(im)
	end
	local converged = false
	while not converged do
		converged = true
		for i = 0, n - 1 do
			local c, r = 0, 0
			for j = 0, n - 1 do
				if j ~= i then
					c += mag(j, i)
					r += mag(i, j)
				end
			end
			if c > 0 and r > 0 then
				local f, cf, rf = 1, c, r
				while cf < rf / 2 and f < 2 ^ 500 do
					f, cf, rf = f * 2, cf * 2, rf / 2
				end
				while cf >= rf * 2 and f > 2 ^ -500 do
					f, cf, rf = f / 2, cf / 2, rf * 2
				end
				if cf + rf < 0.95 * (c + r) then
					converged = false
					d[i + 1] *= f
					for j = 0, n - 1 do
						local re, im = eget(b, i * n + j) -- column i times f
						eset(b, i * n + j, re * f, im * f)
						re, im = eget(b, j * n + i) -- row i divided by f
						eset(b, j * n + i, re / f, im / f)
					end
				end
			end
		end
	end
	return B, d
end

-- The matrix exponential, by scaling and squaring with Padé approximants (Higham
-- 2005): the smallest degree m in {3, 5, 7, 9, 13} whose threshold covers |A|_1, or
-- else degree 13 on A / 2^s, squared s times. A is first balanced, exp(A) = D exp(B) D^-1
-- with B = D^-1 A D, when that makes |B|_1 smaller (as Al-Mohy and Higham 2009 advise):
-- badly scaled matrices, such as a stiff spring's [0 1; -w^2 -2 z w], otherwise lose
-- digits in the squaring (1e-6 against 1e-12 at w = 6283 over a unit step). A is not
-- modified; NaN or infinite entries give a NaN result.
local function expm_unbalanced(A: Matrix): Matrix
	local n = A.rows
	local a = matnorm(A, 1)
	for _, mt in THETA do
		if a <= mt[2] then
			return pade(A, mt[1])
		end
	end
	local top = THETA[#THETA]
	local s = math.max(0, math.ceil(math.log(a / top[2], 2)))
	local As = matrix(n, n)
	scale(As.data, 2 ^ -s, A.data)
	local X = pade(As, top[1])
	-- squaring, alternating between X and As (free now)
	local Y = As
	for _ = 1, s do
		X, Y = matmul(Y, X, X), X
	end
	return X
end

local function expm(A: Matrix): Matrix
	local n = A.rows
	assert(A.cols == n, "expm needs a square matrix")
	local reals = buffer.len(A.data) // 4
	if any_nonfinite(A.data, 0, reals) then
		local X = matrix(n, n)
		fill_nan(X.data, 0, reals)
		return X
	end
	if n == 0 then
		return matrix(0, 0)
	end
	local B, d = scaling_balance(A)
	if not (matnorm(B, 1) < matnorm(A, 1)) then
		return expm_unbalanced(A)
	end
	local X = expm_unbalanced(B)
	local x = X.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local re, im = eget(x, j * n + i)
			local f = d[i + 1] / d[j + 1]
			eset(x, j * n + i, re * f, im * f)
		end
	end
	return X
end

-- The principal square root R (R^2 = T) of an upper triangular T, column by column
-- (Björck and Hammarling): r_ii = sqrt(t_ii), and for i < j
--   r_ij = (t_ij - sum_(i<k<j) r_ik r_kj) / (r_ii + r_jj).
-- Undefined (infinite entries) when r_ii + r_jj = 0, which needs a zero eigenvalue
-- with a nontrivial Jordan block or two eigenvalues on opposite branches.
local function sqrtm_triangular(T: Matrix, out: Matrix?): Matrix
	local n = T.rows
	-- (into out, if given: upper triangular, or zero below the diagonal, and not T)
	local R = out or matrix(n, n)
	assert(R ~= T and R.rows == n and R.cols == n, "sqrtm_triangular: out must be another n by n matrix")
	local t, r = T.data, R.data
	for i = 0, n - 1 do
		cwrite(r, i * n + i, complex64.sqrt(cread(t, i * n + i)))
	end
	for j = 1, n - 1 do
		local jr, ji = cread(r, j * n + j)
		for i = j - 1, 0, -1 do
			local sr, si = cread(t, j * n + i)
			for k = i + 1, j - 1 do
				local ar, ai = cread(r, k * n + i)
				local br, bi = cread(r, j * n + k)
				sr -= ar * br - ai * bi
				si -= ar * bi + ai * br
			end
			local ir, ii = cread(r, i * n + i)
			cwrite(r, j * n + i, complex64.div(sr, si, ir + jr, ii + ji))
		end
	end
	return R
end

-- Gauss-Legendre nodes and weights on [0, 1] (8 points): log(I + X) =
-- integral over [0, 1] of X (I + t X)^-1 dt, exact to about 1e-19 for |X| <= 0.25.
local GL_X = {
	0.019855071751231856,
	0.10166676129318664,
	0.2372337950418355,
	0.4082826787521751,
	0.5917173212478249,
	0.7627662049581645,
	0.8983332387068134,
	0.9801449282487681,
}
local GL_W = {
	0.05061426814518813,
	0.11119051722668724,
	0.15685332293894363,
	0.18134189168918100,
	0.18134189168918100,
	0.15685332293894363,
	0.11119051722668724,
	0.05061426814518813,
}

-- The principal logarithm of an upper triangular T by inverse scaling and squaring:
-- square roots until |T^(1/2^s) - I|_1 <= 1/4, then the quadrature rule above (a
-- diagonal Padé approximant of log(1 + x)), times 2^s. An error if T is singular to
-- working precision.
local function logm_triangular(T: Matrix): Matrix
	local n = T.rows
	-- Singular to working precision: an eigenvalue below eps times the largest.
	local big = 0
	for i = 0, n - 1 do
		big = math.max(big, complex64.abs(cread(T.data, i * n + i)))
	end
	for i = 0, n - 1 do
		assert(complex64.abs(cread(T.data, i * n + i)) > EPS * big, "logm: the matrix is singular")
	end
	-- square roots, alternating between Tk and a spare, until Tk - I is small
	local Tk, spare: Matrix? = matcopy(nil, T), nil
	local s = 0
	local X = matrix(n, n)
	while true do
		matcopy(X, Tk)
		for i = 0, n - 1 do
			local re, im = cread(X.data, i * n + i)
			cwrite(X.data, i * n + i, re - 1, im)
		end
		if matnorm(X, 1) <= 0.25 or s >= 64 then
			break
		end
		Tk, spare = sqrtm_triangular(Tk, spare), Tk
		s += 1
	end
	-- L = sum over the nodes of w_q (I + t_q X)^-1 X; each term an upper triangular solve,
	-- column by column, into Y
	local L, Y = matrix(n, n), matrix(n, n)
	local x, y = X.data, Y.data
	for q = 1, 8 do
		local t = GL_X[q]
		for j = 0, n - 1 do
			for i = j, 0, -1 do
				local sr, si = cread(x, j * n + i)
				for k = i + 1, j do
					local ar, ai = cread(x, k * n + i)
					local br, bi = cread(y, j * n + k)
					sr -= t * (ar * br - ai * bi)
					si -= t * (ar * bi + ai * br)
				end
				local dr, di = cread(x, i * n + i)
				cwrite(y, j * n + i, complex64.div(sr, si, 1 + t * dr, t * di))
			end
		end
		axpy(L.data, GL_W[q], y, L.data)
	end
	scale(L.data, 2 ^ s, L.data)
	return L
end

-- The principal square root of A: X^2 = A with every eigenvalue in the right half
-- plane (closed). By the Schur method: A = Z T Z^H, X = Z sqrt(T) Z^H. A is not
-- modified.
local function sqrtm(A: Matrix): Matrix
	assert(A.rows == A.cols, "sqrtm needs a square matrix")
	local F = schur_copy(A)
	local Z = F.z :: Matrix
	return gemm(nil, 1, matmul(nil, Z, sqrtm_triangular(F.schur)), Z, 0, "n", "c")
end

-- The principal logarithm of A: exp(X) = A with eigenvalue imaginary parts in
-- (-pi, pi]. By the Schur method; an error if A is singular. A is not modified.
local function logm(A: Matrix): Matrix
	assert(A.rows == A.cols, "logm needs a square matrix")
	local F = schur_copy(A)
	local Z = F.z :: Matrix
	return gemm(nil, 1, matmul(nil, Z, logm_triangular(F.schur)), Z, 0, "n", "c")
end

-- The solution X of A X + X B = C (A m by m, B n by n, C m by n), by the
-- Bartels-Stewart method: with Schur forms A = U S U^H and B = V T V^H it solves
-- S Y + Y T = U^H C V column by column (each an upper triangular system with diagonal
-- S + t_jj I), and X = U Y V^H. Unique when A and -B share no eigenvalue; an error if
-- they share one exactly. Nothing is modified.
local function sylvester(A: Matrix, B: Matrix, C: Matrix): Matrix
	local m, n = A.rows, B.rows
	assert(A.cols == m and B.cols == n and C.rows == m and C.cols == n, "sylvester: sizes do not match")
	local FA, FB = schur_copy(A), schur_copy(B)
	local U, Vb = FA.z :: Matrix, FB.z :: Matrix
	local S, T = FA.schur.data, FB.schur.data
	local Y = matmul(nil, gemm(nil, 1, U, C, 0, "c"), Vb)
	local y = Y.data
	for j = 0, n - 1 do
		-- rhs = y_j - sum_(k<j) t_kj y_k
		for k = 0, j - 1 do
			local tr, ti = cread(T, j * n + k)
			if tr ~= 0 or ti ~= 0 then
				for i = 0, m - 1 do
					local vr, vi = cread(y, k * m + i)
					local cr, ci = cread(y, j * m + i)
					cwrite(y, j * m + i, cr - (tr * vr - ti * vi), ci - (tr * vi + ti * vr))
				end
			end
		end
		local djr, dji = cread(T, j * n + j)
		for i = m - 1, 0, -1 do
			local sr, si = cread(y, j * m + i)
			for l = i + 1, m - 1 do
				local ar, ai = cread(S, l * m + i)
				local vr, vi = cread(y, j * m + l)
				sr -= ar * vr - ai * vi
				si -= ar * vi + ai * vr
			end
			local dr, di = cread(S, i * m + i)
			dr, di = dr + djr, di + dji
			assert(dr ~= 0 or di ~= 0, "sylvester: A and -B share an eigenvalue")
			cwrite(y, j * m + i, complex64.div(sr, si, dr, di))
		end
	end
	return gemm(nil, 1, matmul(nil, U, Y), Vb, 0, "n", "c")
end

-- The solution X of the continuous Lyapunov equation A X + X A^H = Q (see sylvester).
local function lyapunov(A: Matrix, Q: Matrix): Matrix
	return sylvester(A, adjoint(nil, A), Q)
end

-- The solution X of the discrete Lyapunov (Stein) equation A X A^H - X + Q = 0: for a
-- stable A (spectral radius < 1), X = sum over k of A^k Q (A^H)^k, the steady-state
-- covariance of x_(k+1) = A x_k + w_k with noise covariance Q. By the Schur method:
-- A = U S U^H, then S Y S^H - Y + U^H Q U = 0 column by column from the last, each an
-- upper triangular system (I - conj(s_jj) S) y_j = known; X = U Y U^H, O(n^3). Unique
-- unless lambda_i conj(lambda_j) = 1 for two eigenvalues; an error if exactly so.
-- Nothing is modified.
local function dlyapunov(A: Matrix, Q: Matrix): Matrix
	local n = A.rows
	assert(A.cols == n and Q.rows == n and Q.cols == n, "dlyapunov: sizes do not match")
	local F = schur_copy(A)
	local U = F.z :: Matrix
	local S = F.schur.data
	local Y = matmul(nil, gemm(nil, 1, U, Q, 0, "c"), U)
	local y = Y.data
	-- SY holds S y_l for the columns l already solved.
	local SY = matrix(n, n)
	local sy = SY.data
	for j = n - 1, 0, -1 do
		-- rhs = q_j + sum_(l > j) conj(s_jl) (S y_l)
		for l = j + 1, n - 1 do
			local sr, si = cread(S, l * n + j)
			si = -si
			if sr ~= 0 or si ~= 0 then
				for i = 0, n - 1 do
					local vr, vi = cread(sy, l * n + i)
					local cr, ci = cread(y, j * n + i)
					cwrite(y, j * n + i, cr + sr * vr - si * vi, ci + sr * vi + si * vr)
				end
			end
		end
		-- (I - conj(s_jj) S) y_j = rhs, upper triangular, from the bottom.
		local cr0, ci0 = cread(S, j * n + j)
		ci0 = -ci0
		for i = n - 1, 0, -1 do
			local tr, ti = cread(y, j * n + i)
			for k = i + 1, n - 1 do
				-- the term -conj(s_jj) s_ik y_k moves to the right-hand side
				local ar, ai = cread(S, k * n + i)
				local pr, pi = cr0 * ar - ci0 * ai, cr0 * ai + ci0 * ar
				local vr, vi = cread(y, j * n + k)
				tr += pr * vr - pi * vi
				ti += pr * vi + pi * vr
			end
			local dr, di = cread(S, i * n + i)
			local mr, mi = 1 - (cr0 * dr - ci0 * di), -(cr0 * di + ci0 * dr)
			assert(mr ~= 0 or mi ~= 0, "dlyapunov: two eigenvalues have lambda_i conj(lambda_j) = 1")
			cwrite(y, j * n + i, complex64.div(tr, ti, mr, mi))
		end
		-- S y_j, for the columns before.
		for i = 0, n - 1 do
			local sr, si = 0, 0
			for k = i, n - 1 do
				local ar, ai = cread(S, k * n + i)
				local vr, vi = cread(y, j * n + k)
				sr += ar * vr - ai * vi
				si += ar * vi + ai * vr
			end
			cwrite(sy, j * n + i, sr, si)
		end
	end
	return gemm(nil, 1, matmul(nil, U, Y), U, 0, "n", "c")
end

return {
	dlyapunov = dlyapunov,
	expm = expm,
	logm = logm,
	logm_triangular = logm_triangular,
	lyapunov = lyapunov,
	sqrtm = sqrtm,
	sqrtm_triangular = sqrtm_triangular,
	sylvester = sylvester,
}
