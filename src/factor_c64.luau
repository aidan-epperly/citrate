-- Bytes per matrix entry.
local ENTRY = buffer.len(matrix(1, 1).data)

-- LU factorization with partial pivoting (pivots chosen by |re| + |im|), in place: A is
-- overwritten with L and U (see types.LU) and returned as F.lu. lu_copy leaves A unchanged.
local function lu(A: Matrix): LU
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local piv = table.create(n, 0)
	local sign = 1
	local singular = false
	for k = 0, n - 1 do
		local p, best = k, -1
		for i = k, n - 1 do
			local off = 16 * (k * n + i)
			local v = math.abs(buffer.readf64(a, off)) + math.abs(buffer.readf64(a, off + 8))
			if v > best then
				p, best = i, v
			end
		end
		piv[k + 1] = p + 1
		if p ~= k then
			sign = -sign
			for j = 0, n - 1 do
				local s, t = 16 * (j * n + k), 16 * (j * n + p)
				local tr, ti = buffer.readf64(a, s), buffer.readf64(a, s + 8)
				buffer.writef64(a, s, buffer.readf64(a, t))
				buffer.writef64(a, s + 8, buffer.readf64(a, t + 8))
				buffer.writef64(a, t, tr)
				buffer.writef64(a, t + 8, ti)
			end
		end
		local pr, pi = buffer.readf64(a, 16 * (k * n + k)), buffer.readf64(a, 16 * (k * n + k) + 8)
		if pr == 0 and pi == 0 then
			singular = true
		else
			for i = k + 1, n - 1 do
				local off = 16 * (k * n + i)
				local qr, qi = complex64.div(buffer.readf64(a, off), buffer.readf64(a, off + 8), pr, pi)
				buffer.writef64(a, off, qr)
				buffer.writef64(a, off + 8, qi)
			end
			for j = k + 1, n - 1 do
				local s = 16 * (j * n + k)
				local br, bi = buffer.readf64(a, s), buffer.readf64(a, s + 8)
				for i = k + 1, n - 1 do
					local off, l = 16 * (j * n + i), 16 * (k * n + i)
					local lr, li = buffer.readf64(a, l), buffer.readf64(a, l + 8)
					buffer.writef64(a, off, buffer.readf64(a, off) - (lr * br - li * bi))
					buffer.writef64(a, off + 8, buffer.readf64(a, off + 8) - (lr * bi + li * br))
				end
			end
		end
	end
	return { lu = A, piv = piv, sign = sign, singular = singular }
end

-- LU factorization of a copy of A; A is not modified.
local function lu_copy(A: Matrix): LU
	return lu(matcopy(nil, A))
end

-- Solves A x = b given F = lu(A).
local function lu_solve(out: buffer?, F: LU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.lu.rows
	assert(buffer.len(b) == 16 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a, piv = F.lu.data, F.piv
	for k = 0, n - 1 do
		local p = piv[k + 1] - 1
		if p ~= k then
			local s, t = 16 * k, 16 * p
			local tr, ti = buffer.readf64(o, s), buffer.readf64(o, s + 8)
			buffer.writef64(o, s, buffer.readf64(o, t))
			buffer.writef64(o, s + 8, buffer.readf64(o, t + 8))
			buffer.writef64(o, t, tr)
			buffer.writef64(o, t + 8, ti)
		end
	end
	for j = 0, n - 1 do
		local xr, xi = buffer.readf64(o, 16 * j), buffer.readf64(o, 16 * j + 8)
		for i = j + 1, n - 1 do
			local off, l = 16 * i, 16 * (j * n + i)
			local lr, li = buffer.readf64(a, l), buffer.readf64(a, l + 8)
			buffer.writef64(o, off, buffer.readf64(o, off) - (lr * xr - li * xi))
			buffer.writef64(o, off + 8, buffer.readf64(o, off + 8) - (lr * xi + li * xr))
		end
	end
	for j = n - 1, 0, -1 do
		local d = 16 * (j * n + j)
		local xr, xi = complex64.div(buffer.readf64(o, 16 * j), buffer.readf64(o, 16 * j + 8), buffer.readf64(a, d), buffer.readf64(a, d + 8))
		buffer.writef64(o, 16 * j, xr)
		buffer.writef64(o, 16 * j + 8, xi)
		for i = 0, j - 1 do
			local off, u = 16 * i, 16 * (j * n + i)
			local ur, ui = buffer.readf64(a, u), buffer.readf64(a, u + 8)
			buffer.writef64(o, off, buffer.readf64(o, off) - (ur * xr - ui * xi))
			buffer.writef64(o, off + 8, buffer.readf64(o, off + 8) - (ur * xi + ui * xr))
		end
	end
	return o
end

-- The inverse of a square matrix, in place (LAPACK's getrf + getri): A is overwritten
-- with A^-1 and returned. An error if A is exactly singular. Solving with solve (or a
-- factorization) is faster and more accurate than forming A^-1 and multiplying; use this
-- when the inverse itself is needed. inv_copy leaves A unchanged.
local function inv(A: Matrix): Matrix
	local F = lu(A)
	assert(not F.singular, "inv: matrix is singular")
	local n = A.rows
	local a = A.data
	local function at(i: number, j: number): number
		return 16 * (j * n + i)
	end
	-- U := U^-1 (trti2): column j of the inverse is -u_jj^-1 times the inverted leading
	-- block times the old column.
	for j = 0, n - 1 do
		local ur, ui = complex64.inv(buffer.readf64(a, at(j, j)), buffer.readf64(a, at(j, j) + 8))
		buffer.writef64(a, at(j, j), ur)
		buffer.writef64(a, at(j, j) + 8, ui)
		for k = 0, j - 1 do
			local tr, ti = buffer.readf64(a, at(k, j)), buffer.readf64(a, at(k, j) + 8)
			if tr ~= 0 or ti ~= 0 then
				for i = 0, k - 1 do
					local o, q = at(i, j), at(i, k)
					local qr, qi = buffer.readf64(a, q), buffer.readf64(a, q + 8)
					buffer.writef64(a, o, buffer.readf64(a, o) + tr * qr - ti * qi)
					buffer.writef64(a, o + 8, buffer.readf64(a, o + 8) + tr * qi + ti * qr)
				end
				local dr, di = buffer.readf64(a, at(k, k)), buffer.readf64(a, at(k, k) + 8)
				buffer.writef64(a, at(k, j), tr * dr - ti * di)
				buffer.writef64(a, at(k, j) + 8, tr * di + ti * dr)
			end
		end
		for i = 0, j - 1 do
			local o = at(i, j)
			local xr, xi = buffer.readf64(a, o), buffer.readf64(a, o + 8)
			buffer.writef64(a, o, -(ur * xr - ui * xi))
			buffer.writef64(a, o + 8, -(ur * xi + ui * xr))
		end
	end
	-- Solve X L = U^-1 for X = (P A)^-1, a column at a time from the right (getri).
	local wr, wi = table.create(n, 0), table.create(n, 0)
	for j = n - 1, 0, -1 do
		for i = j + 1, n - 1 do
			wr[i + 1], wi[i + 1] = buffer.readf64(a, at(i, j)), buffer.readf64(a, at(i, j) + 8)
			buffer.writef64(a, at(i, j), 0)
			buffer.writef64(a, at(i, j) + 8, 0)
		end
		for k = j + 1, n - 1 do
			local cr, ci = wr[k + 1], wi[k + 1]
			if cr ~= 0 or ci ~= 0 then
				for i = 0, n - 1 do
					local o, q = at(i, j), at(i, k)
					local qr, qi = buffer.readf64(a, q), buffer.readf64(a, q + 8)
					buffer.writef64(a, o, buffer.readf64(a, o) - (qr * cr - qi * ci))
					buffer.writef64(a, o + 8, buffer.readf64(a, o + 8) - (qr * ci + qi * cr))
				end
			end
		end
	end
	-- A^-1 = X P: undo the row interchanges as column interchanges, last first.
	for j = n - 2, 0, -1 do
		local p = F.piv[j + 1] - 1
		if p ~= j then
			for i = 0, n - 1 do
				local s, t = at(i, j), at(i, p)
				local sr, si = buffer.readf64(a, s), buffer.readf64(a, s + 8)
				buffer.writef64(a, s, buffer.readf64(a, t))
				buffer.writef64(a, s + 8, buffer.readf64(a, t + 8))
				buffer.writef64(a, t, sr)
				buffer.writef64(a, t + 8, si)
			end
		end
	end
	return A
end

-- The inverse of a copy of A; A is not modified.
local function inv_copy(A: Matrix): Matrix
	return inv(matcopy(nil, A))
end

-- The determinant, from an LU factorization of a copy (A is not modified); see slogdet for large or small determinants.
local function det_pair(A: Matrix): (number, number)
	local F = lu_copy(A)
	local dr, di = F.sign, 0
	local n = A.rows
	for k = 0, n - 1 do
		local off = 16 * (k * n + k)
		dr, di = complex64.mul(dr, di, buffer.readf64(F.lu.data, off), buffer.readf64(F.lu.data, off + 8))
	end
	return dr, di
end

-- Cholesky

-- Cholesky factorization A = L L^H of a Hermitian positive definite matrix, in place:
-- the lower triangle of A is overwritten with L (whose diagonal is real) and returned as
-- F.chol. Only the lower triangle of A is read, and only the real parts of its diagonal;
-- the strictly upper triangle is left as it was. If A is not positive definite,
-- F.definite is false and A is partly overwritten. chol_copy leaves A unchanged.
local function chol(A: Matrix): Cholesky
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	for j = 0, n - 1 do
		local diag = 16 * (j * n + j)
		local d = buffer.readf64(a, diag)
		if not (d > 0) then
			return { chol = A, definite = false }
		end
		local ljj = math.sqrt(d)
		buffer.writef64(a, diag, ljj)
		buffer.writef64(a, diag + 8, 0)
		for i = j + 1, n - 1 do
			local off = 16 * (j * n + i)
			buffer.writef64(a, off, buffer.readf64(a, off) / ljj)
			buffer.writef64(a, off + 8, buffer.readf64(a, off + 8) / ljj)
		end
		-- Subtract the new column's outer product, l l^H, from the trailing lower triangle.
		for c = j + 1, n - 1 do
			local s = 16 * (j * n + c)
			-- conj(L[c, j])
			local cr, ci = buffer.readf64(a, s), -buffer.readf64(a, s + 8)
			for i = c, n - 1 do
				local off, l = 16 * (c * n + i), 16 * (j * n + i)
				local lr, li = buffer.readf64(a, l), buffer.readf64(a, l + 8)
				buffer.writef64(a, off, buffer.readf64(a, off) - (lr * cr - li * ci))
				buffer.writef64(a, off + 8, buffer.readf64(a, off + 8) - (lr * ci + li * cr))
			end
		end
	end
	return { chol = A, definite = true }
end

-- Cholesky factorization of a copy of A; A is not modified.
local function chol_copy(A: Matrix): Cholesky
	return chol(matcopy(nil, A))
end

-- The lower triangular factor L, with zeros above the diagonal.
local function chol_l(out: Matrix?, F: Cholesky): Matrix
	local n = F.chol.rows
	local o = matoutput(out, n, n)
	local a, l = F.chol.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = 16 * (j * n + i)
			if i >= j then
				buffer.writef64(l, off, buffer.readf64(a, off))
				buffer.writef64(l, off + 8, buffer.readf64(a, off + 8))
			else
				buffer.writef64(l, off, 0)
				buffer.writef64(l, off + 8, 0)
			end
		end
	end
	return o
end

-- Solves A x = b given F = chol(A). b is not modified unless it is passed as out.
local function chol_solve(out: buffer?, F: Cholesky, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local n = F.chol.rows
	assert(buffer.len(b) == 16 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = F.chol.data
	-- L y = b (the diagonal of L is real)
	for j = 0, n - 1 do
		local d = buffer.readf64(a, 16 * (j * n + j))
		local yr, yi = buffer.readf64(o, 16 * j) / d, buffer.readf64(o, 16 * j + 8) / d
		buffer.writef64(o, 16 * j, yr)
		buffer.writef64(o, 16 * j + 8, yi)
		for i = j + 1, n - 1 do
			local off, l = 16 * i, 16 * (j * n + i)
			local lr, li = buffer.readf64(a, l), buffer.readf64(a, l + 8)
			buffer.writef64(o, off, buffer.readf64(o, off) - (lr * yr - li * yi))
			buffer.writef64(o, off + 8, buffer.readf64(o, off + 8) - (lr * yi + li * yr))
		end
	end
	-- L^H x = y, a conjugated dot product down each column of L.
	for j = n - 1, 0, -1 do
		local sr, si = buffer.readf64(o, 16 * j), buffer.readf64(o, 16 * j + 8)
		for i = j + 1, n - 1 do
			local l = 16 * (j * n + i)
			local lr, li = buffer.readf64(a, l), buffer.readf64(a, l + 8)
			local xr, xi = buffer.readf64(o, 16 * i), buffer.readf64(o, 16 * i + 8)
			sr -= lr * xr + li * xi
			si -= lr * xi - li * xr
		end
		local d = buffer.readf64(a, 16 * (j * n + j))
		buffer.writef64(o, 16 * j, sr / d)
		buffer.writef64(o, 16 * j + 8, si / d)
	end
	return o
end

-- Householder QR

-- Unit roundoff of the storage precision.
local EPS = 2 ^ -53

-- Applies I - t v v^H, t = tr + i ti, to the `len` values of x starting at byte offset
-- `xs`. v starts at byte offset `vs` of `a`; its first entry is an implicit 1.
local function reflect(a: buffer, vs: number, len: number, tr: number, ti: number, x: buffer, xs: number)
	local wr, wi = buffer.readf64(x, xs), buffer.readf64(x, xs + 8)
	for i = 1, len - 1 do
		local v, y = vs + 16 * i, xs + 16 * i
		local vr, vi = buffer.readf64(a, v), buffer.readf64(a, v + 8)
		local yr, yi = buffer.readf64(x, y), buffer.readf64(x, y + 8)
		wr += vr * yr + vi * yi
		wi += vr * yi - vi * yr
	end
	if wr == 0 and wi == 0 then
		return
	end
	wr, wi = tr * wr - ti * wi, tr * wi + ti * wr
	buffer.writef64(x, xs, buffer.readf64(x, xs) - wr)
	buffer.writef64(x, xs + 8, buffer.readf64(x, xs + 8) - wi)
	for i = 1, len - 1 do
		local v, y = vs + 16 * i, xs + 16 * i
		local vr, vi = buffer.readf64(a, v), buffer.readf64(a, v + 8)
		buffer.writef64(x, y, buffer.readf64(x, y) - (wr * vr - wi * vi))
		buffer.writef64(x, y + 8, buffer.readf64(x, y + 8) - (wr * vi + wi * vr))
	end
end

-- Turns the `len` values of `a` starting at byte offset `diag` into a Householder
-- reflector, in place: the real beta at `diag` and v below it (its leading 1 is
-- implicit). Stores tau as element k of `tau` and returns it; tau = 0 (H = I) when the
-- value at `diag` is already real and there is nothing below it to zero.
local function householder(a: buffer, diag: number, len: number, tau: buffer, k: number): (number, number)
	local ar, ai = buffer.readf64(a, diag), buffer.readf64(a, diag + 8)
	local xnorm = segment_norm(a, diag + 16, 2 * (len - 1))
	if xnorm == 0 and ai == 0 then
		buffer.writef64(tau, 16 * k, 0)
		buffer.writef64(tau, 16 * k + 8, 0)
		return 0, 0
	end
	local beta = hypot3(ar, ai, xnorm)
	if ar >= 0 then
		beta = -beta
	end
	buffer.writef64(tau, 16 * k, (beta - ar) / beta)
	buffer.writef64(tau, 16 * k + 8, -ai / beta)
	-- Re(alpha) and beta have opposite signs, so alpha - beta cannot cancel.
	local dr = ar - beta
	for off = diag + 16, diag + 16 * (len - 1), 16 do
		local vr, vi = complex64.div(buffer.readf64(a, off), buffer.readf64(a, off + 8), dr, ai)
		buffer.writef64(a, off, vr)
		buffer.writef64(a, off + 8, vi)
	end
	buffer.writef64(a, diag, beta)
	buffer.writef64(a, diag + 8, 0)
	return buffer.readf64(tau, 16 * k), buffer.readf64(tau, 16 * k + 8)
end

-- Solves R z = y in place on the first r entries of y, where R is the leading r by r
-- block of the upper triangle stored in `a` (a matrix with m rows).
local function back_substitute(a: buffer, m: number, r: number, y: buffer)
	for j = r - 1, 0, -1 do
		local d = 16 * (j * m + j)
		local rr, ri = buffer.readf64(a, d), buffer.readf64(a, d + 8)
		assert(rr ~= 0 or ri ~= 0, "matrix is rank deficient")
		local yr, yi = complex64.div(buffer.readf64(y, 16 * j), buffer.readf64(y, 16 * j + 8), rr, ri)
		buffer.writef64(y, 16 * j, yr)
		buffer.writef64(y, 16 * j + 8, yi)
		for i = 0, j - 1 do
			local off, u = 16 * i, 16 * (j * m + i)
			local ur, ui = buffer.readf64(a, u), buffer.readf64(a, u + 8)
			buffer.writef64(y, off, buffer.readf64(y, off) - (ur * yr - ui * yi))
			buffer.writef64(y, off + 8, buffer.readf64(y, off + 8) - (ur * yi + ui * yr))
		end
	end
end

-- Householder QR factorization, in place: A is overwritten (see types.QR for the layout)
-- and returned as F.qr. The diagonal of R is real. qr_copy leaves A unchanged.
local function qr(A: Matrix): QR
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(16 * kmax)
	for k = 0, kmax - 1 do
		local diag = 16 * (k * m + k)
		local tr, ti = householder(a, diag, m - k, tau, k)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, 16 * (j * m + k))
			end
		end
	end
	return { qr = A, tau = tau }
end

-- Householder QR factorization of a copy of A; A is not modified.
local function qr_copy(A: Matrix): QR
	return qr(matcopy(nil, A))
end

-- x := Q^H x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_qh(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == 16 * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = 0, buffer.len(tau) // 16 - 1 do
		local tr, ti = buffer.readf64(tau, 16 * k), buffer.readf64(tau, 16 * k + 8)
		reflect(a, 16 * (k * m + k), m - k, tr, -ti, x, 16 * k)
	end
	return x
end

-- x := Q x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_q(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == 16 * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = buffer.len(tau) // 16 - 1, 0, -1 do
		local tr, ti = buffer.readf64(tau, 16 * k), buffer.readf64(tau, 16 * k + 8)
		reflect(a, 16 * (k * m + k), m - k, tr, ti, x, 16 * k)
	end
	return x
end

-- The min(rows, cols) by cols upper triangular factor R. Also accepts a QRP factorization.
local function qr_r(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, kmax, n)
	local a, r = F.qr.data, o.data
	for j = 0, n - 1 do
		for i = 0, kmax - 1 do
			local s, t = 16 * (j * m + i), 16 * (j * kmax + i)
			if i <= j then
				buffer.writef64(r, t, buffer.readf64(a, s))
				buffer.writef64(r, t + 8, buffer.readf64(a, s + 8))
			else
				buffer.writef64(r, t, 0)
				buffer.writef64(r, t + 8, 0)
			end
		end
	end
	return o
end

-- The rows by min(rows, cols) factor Q with orthonormal columns (the thin Q). Also
-- accepts a QRP factorization.
local function qr_q(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, m, kmax)
	local a, tau, q = F.qr.data, F.tau, o.data
	buffer.fill(q, 0, 0)
	for c = 0, kmax - 1 do
		buffer.writef64(q, 16 * (c * m + c), 1)
		-- Reflectors after column c leave the unit vector e_c unchanged.
		for k = c, 0, -1 do
			local tr, ti = buffer.readf64(tau, 16 * k), buffer.readf64(tau, 16 * k + 8)
			reflect(a, 16 * (k * m + k), m - k, tr, ti, q, 16 * (c * m + k))
		end
	end
	return o
end

-- Least squares: the x minimizing |A x - b| for A with rows >= cols and full column
-- rank, given F = qr(A). b is not modified. Also returns the residual norm |A x - b|.
local function qr_solve(out: buffer?, F: QR, b: buffer): (buffer, number)
	local m, n = F.qr.rows, F.qr.cols
	assert(m >= n, "least squares needs at least as many rows as columns")
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, n, y)
	local o = output(out, 16 * n)
	buffer.copy(o, 0, y, 0, 16 * n)
	return o, segment_norm(y, 16 * n, 2 * (m - n))
end

-- Column-pivoted QR

-- Householder QR with column pivoting, A P = Q R, in place: A is overwritten as in qr and
-- returned as F.qr; column j of A P is column perm[j] of A. Each step moves the remaining
-- column of largest norm to the front, so |R_11| >= |R_22| >= ... and small trailing
-- diagonal entries reveal the numerical rank. qrp_copy leaves A unchanged.
local function qrp(A: Matrix): QRP
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(16 * kmax)
	local perm = table.create(n, 0)
	-- Norms of the unfactored part of each column (partial), and the norm at the last
	-- recomputation (reference), for LAPACK's safeguarded downdating.
	local partial, reference = table.create(n, 0), table.create(n, 0)
	for j = 1, n do
		perm[j] = j
		local v = segment_norm(a, 16 * (j - 1) * m, 2 * m)
		partial[j], reference[j] = v, v
	end
	local recompute = math.sqrt(EPS)
	for k = 0, kmax - 1 do
		local p, best = k, -1
		for j = k, n - 1 do
			if partial[j + 1] > best then
				p, best = j, partial[j + 1]
			end
		end
		if p ~= k then
			for i = 0, m - 1 do
				local s, t = 16 * (k * m + i), 16 * (p * m + i)
				local sr, si = buffer.readf64(a, s), buffer.readf64(a, s + 8)
				buffer.writef64(a, s, buffer.readf64(a, t))
				buffer.writef64(a, s + 8, buffer.readf64(a, t + 8))
				buffer.writef64(a, t, sr)
				buffer.writef64(a, t + 8, si)
			end
			perm[k + 1], perm[p + 1] = perm[p + 1], perm[k + 1]
			partial[p + 1], reference[p + 1] = partial[k + 1], reference[k + 1]
		end

		local diag = 16 * (k * m + k)
		local tr, ti = householder(a, diag, m - k, tau, k)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, 16 * (j * m + k))
			end
		end

		-- Remove row k from the remaining partial norms. When cancellation would leave too
		-- few correct digits, recompute the norm instead.
		for j = k + 1, n - 1 do
			local v = partial[j + 1]
			if v ~= 0 then
				local off = 16 * (j * m + k)
				local ratio = complex64.abs(buffer.readf64(a, off), buffer.readf64(a, off + 8)) / v
				local left = math.max(0, 1 - ratio * ratio)
				local drift = v / reference[j + 1]
				if left * drift * drift <= recompute then
					local fresh = segment_norm(a, off + 16, 2 * (m - k - 1))
					partial[j + 1], reference[j + 1] = fresh, fresh
				else
					partial[j + 1] = v * math.sqrt(left)
				end
			end
		end
	end
	return { qr = A, tau = tau, perm = perm }
end

-- Column-pivoted QR of a copy of A; A is not modified.
local function qrp_copy(A: Matrix): QRP
	return qrp(matcopy(nil, A))
end

-- Numerical rank: the number of leading diagonal entries of R with |R_kk| > tol |R_11|.
-- The default tol is max(rows, cols) times the unit roundoff of the storage precision.
local function qrp_rank(F: QRP, tol: number?): number
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	if kmax == 0 then
		return 0
	end
	local a = F.qr.data
	local limit = (tol or math.max(m, n) * EPS) * complex64.abs(buffer.readf64(a, 0), buffer.readf64(a, 8))
	for k = 0, kmax - 1 do
		local d = 16 * (k * m + k)
		if not (complex64.abs(buffer.readf64(a, d), buffer.readf64(a, d + 8)) > limit) then
			return k
		end
	end
	return kmax
end

-- Least squares for any shape and rank, given F = qrp(A): the basic solution, which
-- uses only the first r = qrp_rank(F, tol) pivot columns and sets the other variables
-- to zero. b is not modified. Also returns the residual norm |A x - b| and r.
local function qrp_solve(out: buffer?, F: QRP, b: buffer, tol: number?): (buffer, number, number)
	local m, n = F.qr.rows, F.qr.cols
	local r = qrp_rank(F, tol)
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, r, y)
	local o = output(out, 16 * n)
	buffer.fill(o, 0, 0)
	for j = 1, r do
		local s, t = 16 * (j - 1), 16 * (F.perm[j] - 1)
		buffer.writef64(o, t, buffer.readf64(y, s))
		buffer.writef64(o, t + 8, buffer.readf64(y, s + 8))
	end
	return o, segment_norm(y, 16 * r, 2 * (m - r)), r
end

-- The minimum-norm least-squares solution x = A^+ b for any shape and rank, given
-- F = svd(A) with its vectors: x = sum over i <= r of v_i (u_i^H b) / s_i, where r counts
-- the singular values above tol * s_1 (default tol = max(rows, cols) * eps, as for
-- qrp_rank); smaller ones are treated as zero. Unlike qrp_solve's basic solution, x is the
-- shortest of all least-squares solutions. b is not modified. Also returns the residual
-- norm |A x - b| and r. NaN singular values (from non-finite input) give a NaN x.
local function svd_solve(out: buffer?, F: Svd, b: buffer, tol: number?): (buffer, number, number)
	local U, V = F.u, F.v
	assert(U ~= nil and V ~= nil, "svd_solve needs the singular vectors")
	local m, n, k = U.rows, V.rows, U.cols
	assert(length(b) == m, "b has the wrong length")
	local s, u, v = F.values, U.data, V.data
	local o = output(out, 16 * n)
	if k > 0 and buffer.readf64(s, 0) ~= buffer.readf64(s, 0) then
		fill_nan(o, 0, 2 * n)
		return o, 0 / 0, 0
	end
	local limit = (tol or math.max(m, n) * EPS) * (if k > 0 then buffer.readf64(s, 0) else 0)
	local r = 0
	while r < k and buffer.readf64(s, 8 * r) > limit do
		r += 1
	end
	-- The residual b - U_r U_r^H b, projected one column at a time, and x.
	local rr, ri = table.create(m, 0), table.create(m, 0)
	for i = 1, m do
		rr[i], ri[i] = buffer.readf64(b, 16 * (i - 1)), buffer.readf64(b, 16 * (i - 1) + 8)
	end
	local xr, xi = table.create(n, 0), table.create(n, 0)
	for j = 0, r - 1 do
		local col = 16 * j * m
		-- c = u_j^H res
		local cr, ci = 0, 0
		for i = 0, m - 1 do
			local ur, ui = buffer.readf64(u, col + 16 * i), buffer.readf64(u, col + 16 * i + 8)
			cr += ur * rr[i + 1] + ui * ri[i + 1]
			ci += ur * ri[i + 1] - ui * rr[i + 1]
		end
		for i = 0, m - 1 do
			local ur, ui = buffer.readf64(u, col + 16 * i), buffer.readf64(u, col + 16 * i + 8)
			rr[i + 1] -= cr * ur - ci * ui
			ri[i + 1] -= cr * ui + ci * ur
		end
		local sj = buffer.readf64(s, 8 * j)
		local wr, wi = cr / sj, ci / sj
		local vcol = 16 * j * n
		for i = 0, n - 1 do
			local vr, vi = buffer.readf64(v, vcol + 16 * i), buffer.readf64(v, vcol + 16 * i + 8)
			xr[i + 1] += wr * vr - wi * vi
			xi[i + 1] += wr * vi + wi * vr
		end
	end
	for i = 1, n do
		buffer.writef64(o, 16 * (i - 1), xr[i])
		buffer.writef64(o, 16 * (i - 1) + 8, xi[i])
	end
	local big = 0
	for i = 1, m do
		big = math.max(big, math.abs(rr[i]), math.abs(ri[i]))
	end
	local ss = 0
	if big > 0 then
		for i = 1, m do
			ss += (rr[i] / big) ^ 2 + (ri[i] / big) ^ 2
		end
	end
	return o, big * math.sqrt(ss), r
end
local det = det_pair

-- The phase (a unit complex number) and the log of the absolute value of det(A),
-- without overflow: returns (phase re, phase im, log |det|), with phase 0 and log -inf
-- for a singular matrix.
local function slogdet_pair(A: Matrix): (number, number, number)
	local F = lu_copy(A)
	local n = A.rows
	local pr, pi, logabs = F.sign, 0, 0
	for k = 0, n - 1 do
		local ur, ui = cread(F.lu.data, k * n + k)
		local a = complex64.abs(ur, ui)
		if a == 0 then
			return 0, 0, -math.huge
		end
		pr, pi = complex64.mul(pr, pi, ur / a, ui / a)
		logabs += math.log(a)
	end
	-- Renormalize the phase against rounding drift.
	local a = complex64.abs(pr, pi)
	return pr / a, pi / a, logabs
end

-- Solves A^H x = b given F = lu(A) (P A = L U, so A^H = U^H L^H P).
local function lu_solve_adjoint(out: buffer?, F: LU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.lu.rows
	assert(buffer.len(b) == 16 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = F.lu.data
	-- U^H y = b, forward.
	for j = 0, n - 1 do
		local sr, si = cread(o, j)
		for i = 0, j - 1 do
			local ur, ui = cread(a, j * n + i)
			local yr, yi = cread(o, i)
			-- s -= conj(u_ij) y_i
			sr -= ur * yr + ui * yi
			si -= ur * yi - ui * yr
		end
		local dr, di = cread(a, j * n + j)
		cwrite(o, j, complex64.div(sr, si, dr, -di))
	end
	-- L^H z = y, backward (unit diagonal).
	for j = n - 1, 0, -1 do
		local sr, si = cread(o, j)
		for i = j + 1, n - 1 do
			local lr, li = cread(a, j * n + i)
			local zr, zi = cread(o, i)
			sr -= lr * zr + li * zi
			si -= lr * zi - li * zr
		end
		cwrite(o, j, sr, si)
	end
	-- x = P^T z: the interchanges in reverse.
	for k = n - 1, 0, -1 do
		local p = F.piv[k + 1] - 1
		if p ~= k then
			local xr, xi = cread(o, k)
			cwrite(o, k, cread(o, p))
			cwrite(o, p, xr, xi)
		end
	end
	return o
end

-- Helpers for the condition estimator: the 1-norm of a vector (sum of moduli), the
-- unit-modulus signs x / |x| of its entries (1 for zero), the index (1-based) and
-- modulus of its largest entry, the real part of the inner product, and e_j.
local function asum(x: buffer): number
	local s = 0
	for i = 0, length(x) - 1 do
		s += complex64.abs(cread(x, i))
	end
	return s
end

local function signs(x: buffer): buffer
	local o = buffer.create(buffer.len(x))
	for i = 0, length(x) - 1 do
		local r, m = cread(x, i)
		local a = complex64.abs(r, m)
		if a == 0 then
			cwrite(o, i, 1, 0)
		else
			cwrite(o, i, r / a, m / a)
		end
	end
	return o
end

local function argmax(x: buffer): (number, number)
	local best, at = -1, 1
	for i = 0, length(x) - 1 do
		local v = complex64.abs(cread(x, i))
		if v > best then
			best, at = v, i + 1
		end
	end
	return best, at
end

local function unit(n: number, j: number): buffer
	local e = create(n)
	buffer.writef64(e, 16 * (j - 1), 1)
	return e
end
local slogdet = slogdet_pair

-- Hermitian indefinite factorization (Bunch-Kaufman).

-- The Bunch-Kaufman factorization P A P^T = L D L^H of a Hermitian (possibly
-- indefinite) matrix, in place (LAPACK's hetf2, lower): only the lower triangle of A
-- (and the real parts of its diagonal) is read; it is overwritten with L (unit lower
-- triangular, below the diagonal) and the block diagonal D (real 1 by 1 blocks and
-- Hermitian 2 by 2 blocks). piv is as in LAPACK's ipiv, 1-based: piv[k] > 0 for a 1 by
-- 1 block (row k was swapped with piv[k]), piv[k] = piv[k+1] < 0 for a 2 by 2 block (row
-- k+1 was swapped with -piv[k]). ldl_copy leaves A unchanged.
local function ldl(A: Matrix): LDL
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local function get(i: number, j: number): (number, number)
		local o = 16 * (j * n + i)
		return buffer.readf64(a, o), buffer.readf64(a, o + 8)
	end
	local function set(i: number, j: number, re: number, im: number)
		local o = 16 * (j * n + i)
		buffer.writef64(a, o, re)
		buffer.writef64(a, o + 8, im)
	end
	local function mag(i: number, j: number): number
		return complex64.abs(get(i, j))
	end
	local piv = table.create(n, 0) :: { number }
	local singular = false
	local alpha = (1 + math.sqrt(17)) / 8
	local k = 0
	while k < n do
		local kstep = 1
		local kp = k
		local absakk = math.abs((get(k, k)))
		local imax, colmax = k, 0
		for i = k + 1, n - 1 do
			local v = mag(i, k)
			if v > colmax then
				imax, colmax = i, v
			end
		end
		if math.max(absakk, colmax) == 0 then
			singular = true
			local re = get(k, k)
			set(k, k, re, 0)
		else
			if absakk < alpha * colmax then
				local rowmax = 0
				for j = k, imax - 1 do
					rowmax = math.max(rowmax, mag(imax, j))
				end
				for j = imax + 1, n - 1 do
					rowmax = math.max(rowmax, mag(j, imax))
				end
				if absakk >= alpha * colmax * (colmax / rowmax) then
					kp = k
				elseif math.abs((get(imax, imax))) >= alpha * rowmax then
					kp = imax
				else
					kp = imax
					kstep = 2
				end
			end
			local kk = k + kstep - 1
			if kp ~= kk then
				-- Interchange rows and columns kk and kp of the trailing matrix (with
				-- the conjugations a Hermitian matrix in lower storage needs).
				for i = kp + 1, n - 1 do
					local xr, xi = get(i, kk)
					local yr, yi = get(i, kp)
					set(i, kk, yr, yi)
					set(i, kp, xr, xi)
				end
				for j = kk + 1, kp - 1 do
					local xr, xi = get(j, kk)
					local yr, yi = get(kp, j)
					set(j, kk, yr, -yi)
					set(kp, j, xr, -xi)
				end
				local mr, mi = get(kp, kk)
				set(kp, kk, mr, -mi)
				local d1 = get(kk, kk)
				local d2 = get(kp, kp)
				set(kk, kk, d2, 0)
				set(kp, kp, d1, 0)
				if kstep == 2 then
					local akk = get(k, k)
					set(k, k, akk, 0)
					local xr, xi = get(k + 1, k)
					local yr, yi = get(kp, k)
					set(k + 1, k, yr, yi)
					set(kp, k, xr, xi)
				end
			else
				local akk = get(k, k)
				set(k, k, akk, 0)
				if kstep == 2 then
					local ak1 = get(k + 1, k + 1)
					set(k + 1, k + 1, ak1, 0)
				end
			end
			if kstep == 1 then
				-- A(k+1:, k+1:) -= x x^H / d (d real), then x /= d.
				local r1 = 1 / (get(k, k))
				for j = k + 1, n - 1 do
					local xjr, xji = get(j, k)
					local fr, fi = r1 * xjr, -r1 * xji
					if fr ~= 0 or fi ~= 0 then
						for i = j, n - 1 do
							local xr, xi = get(i, k)
							local cr, ci = get(i, j)
							set(i, j, cr - (xr * fr - xi * fi), ci - (xr * fi + xi * fr))
						end
						local djr = get(j, j)
						set(j, j, djr, 0)
					end
				end
				for i = k + 1, n - 1 do
					local xr, xi = get(i, k)
					set(i, k, xr * r1, xi * r1)
				end
			elseif k < n - 2 then
				local er, ei = get(k + 1, k)
				local d = complex64.abs(er, ei)
				local d11 = (get(k + 1, k + 1)) / d
				local d22 = (get(k, k)) / d
				local tt = 1 / (d11 * d22 - 1)
				local d21r, d21i = er / d, ei / d
				d = tt / d
				for j = k + 2, n - 1 do
					local ajr, aji = get(j, k)
					local bjr, bji = get(j, k + 1)
					-- wk = d (d11 a_j - d21 b_j); wkp1 = d (d22 b_j - conj(d21) a_j)
					local wkr = d * (d11 * ajr - (d21r * bjr - d21i * bji))
					local wki = d * (d11 * aji - (d21r * bji + d21i * bjr))
					local wpr = d * (d22 * bjr - (d21r * ajr + d21i * aji))
					local wpi = d * (d22 * bji - (d21r * aji - d21i * ajr))
					for i = j, n - 1 do
						local xr, xi = get(i, k)
						local yr, yi = get(i, k + 1)
						local cr, ci = get(i, j)
						-- c -= x conj(wk) + y conj(wkp1)
						cr -= xr * wkr + xi * wki + yr * wpr + yi * wpi
						ci -= xi * wkr - xr * wki + yi * wpr - yr * wpi
						set(i, j, cr, ci)
					end
					set(j, k, wkr, wki)
					set(j, k + 1, wpr, wpi)
					local djr = get(j, j)
					set(j, j, djr, 0)
				end
			end
		end
		if kstep == 1 then
			piv[k + 1] = kp + 1
		else
			piv[k + 1] = -(kp + 1)
			piv[k + 2] = -(kp + 1)
		end
		k += kstep
	end
	return { ldl = A, piv = piv, singular = singular }
end

-- The factorization of a copy of A; A is not modified.
local function ldl_copy(A: Matrix): LDL
	return ldl(matcopy(nil, A))
end

-- Solves A x = b given F = ldl(A) (LAPACK's hetrs).
local function ldl_solve(out: buffer?, F: LDL, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.ldl.rows
	assert(buffer.len(b) == 16 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a, piv = F.ldl.data, F.piv
	local function get(i: number, j: number): (number, number)
		local off = 16 * (j * n + i)
		return buffer.readf64(a, off), buffer.readf64(a, off + 8)
	end
	local function x(i: number): (number, number)
		return buffer.readf64(o, 16 * i), buffer.readf64(o, 16 * i + 8)
	end
	local function setx(i: number, re: number, im: number)
		buffer.writef64(o, 16 * i, re)
		buffer.writef64(o, 16 * i + 8, im)
	end
	local function swapx(i: number, j: number)
		local ar, ai = x(i)
		local br, bi = x(j)
		setx(i, br, bi)
		setx(j, ar, ai)
	end
	-- L D y = P b.
	local k = 0
	while k < n do
		if piv[k + 1] > 0 then
			swapx(k, piv[k + 1] - 1)
			local xr, xi = x(k)
			for i = k + 1, n - 1 do
				local lr, li = get(i, k)
				local cr, ci = x(i)
				setx(i, cr - (lr * xr - li * xi), ci - (lr * xi + li * xr))
			end
			local d = get(k, k)
			setx(k, xr / d, xi / d)
			k += 1
		else
			swapx(k + 1, -piv[k + 1] - 1)
			local xr, xi = x(k)
			local yr, yi = x(k + 1)
			for i = k + 2, n - 1 do
				local lr, li = get(i, k)
				local mr, mi = get(i, k + 1)
				local cr, ci = x(i)
				cr -= lr * xr - li * xi + mr * yr - mi * yi
				ci -= lr * xi + li * xr + mr * yi + mi * yr
				setx(i, cr, ci)
			end
			local er, ei = get(k + 1, k)
			local dkk = (get(k, k)) -- diagonal entries of D are real
			local dk1 = (get(k + 1, k + 1))
			local akm1r, akm1i = complex64.div(dkk, 0, er, -ei)
			local akr, aki = complex64.div(dk1, 0, er, ei)
			local dr, di = complex64.mul(akm1r, akm1i, akr, aki)
			dr -= 1
			local bkm1r, bkm1i = complex64.div(xr, xi, er, -ei)
			local bkr, bki = complex64.div(yr, yi, er, ei)
			local t1r, t1i = complex64.mul(akr, aki, bkm1r, bkm1i)
			local t2r, t2i = complex64.mul(akm1r, akm1i, bkr, bki)
			setx(k, complex64.div(t1r - bkr, t1i - bki, dr, di))
			setx(k + 1, complex64.div(t2r - bkm1r, t2i - bkm1i, dr, di))
			k += 2
		end
	end
	-- L^H x = y, then undo the interchanges.
	local function back(k0: number)
		local sr, si = x(k0)
		for i = k + 1, n - 1 do
			local lr, li = get(i, k0)
			local cr, ci = x(i)
			-- s -= conj(l) c
			sr -= lr * cr + li * ci
			si -= lr * ci - li * cr
		end
		setx(k0, sr, si)
	end
	k = n - 1
	while k >= 0 do
		back(k)
		if piv[k + 1] > 0 then
			swapx(k, piv[k + 1] - 1)
			k -= 1
		else
			back(k - 1)
			swapx(k, -piv[k + 1] - 1)
			k -= 2
		end
	end
	return o
end

-- The inertia of A from F = ldl(A): the numbers of positive, negative and zero
-- eigenvalues. Each 2 by 2 block has one of each sign.
local function ldl_inertia(F: LDL): (number, number, number)
	local n = F.ldl.rows
	local pos, neg, zero = 0, 0, 0
	local k = 0
	while k < n do
		if F.piv[k + 1] > 0 then
			local d = buffer.readf64(F.ldl.data, 16 * (k * n + k))
			if d > 0 then
				pos += 1
			elseif d < 0 then
				neg += 1
			else
				zero += 1
			end
			k += 1
		else
			pos += 1
			neg += 1
			k += 2
		end
	end
	return pos, neg, zero
end

type SolveFunction =
	((out: buffer?, A: Matrix | LU | QR | QRP | Cholesky | LDL | Svd, b: buffer, form: Form?) -> buffer)
	& ((out: Matrix?, A: Matrix | LU | QR | QRP | Cholesky | LDL | Svd, B: Matrix, form: Form?) -> Matrix)

-- Solves A x = b, or A X = B for a matrix B of right-hand sides (one factorization serves
-- every column; X is a new matrix, or `out`). `form` says what A is:
--   "matrix" (or nil)  a matrix. Square: LU with partial pivoting. More rows than
--                      columns: the least-squares solution, by Householder QR. More
--                      columns than rows: the basic solution, by column-pivoted QR.
--   "lu"               a factorization from lu or lu_copy
--   "qr"               a factorization from qr or qr_copy (least squares if tall)
--   "qrp"              a factorization from qrp or qrp_copy (any shape or rank; see
--                      qrp_solve, whose default rank tolerance is used)
--   "chol"             a factorization from chol or chol_copy
--   "ldl"              a factorization from ldl or ldl_copy (symmetric indefinite)
--   "svd"              a decomposition from svd or svd_copy, with vectors: the
--                      pseudoinverse solution A^+ b (minimum-norm least squares, any
--                      shape or rank; see svd_solve, whose default tolerance is used)
-- Neither A nor b is modified.
local function solve_impl(out: any, A: any, b: any, form: Form?): any
	local t = A :: any
	-- The solver for one right-hand side, and the number of unknowns.
	local one: any
	local n: number
	if form == "lu" then
		assert(type(t) == "table" and t.lu ~= nil, `solve: form "lu" needs a factorization from lu`)
		local F = A :: LU
		n = F.lu.cols
		one = function(o, v)
			return lu_solve(o, F, v)
		end
	elseif form == "qr" then
		assert(type(t) == "table" and t.qr ~= nil, `solve: form "qr" needs a factorization from qr`)
		assert(t.perm == nil, `solve: this is a pivoted factorization; use form "qrp"`)
		local F = A :: QR
		n = F.qr.cols
		one = function(o, v)
			return (qr_solve(o, F, v))
		end
	elseif form == "qrp" then
		assert(type(t) == "table" and t.perm ~= nil, `solve: form "qrp" needs a factorization from qrp`)
		local F = A :: QRP
		n = F.qr.cols
		one = function(o, v)
			return (qrp_solve(o, F, v))
		end
	elseif form == "chol" then
		assert(type(t) == "table" and t.chol ~= nil, `solve: form "chol" needs a factorization from chol`)
		local F = A :: Cholesky
		n = F.chol.cols
		one = function(o, v)
			return chol_solve(o, F, v)
		end
	elseif form == "ldl" then
		assert(type(t) == "table" and t.ldl ~= nil, `solve: form "ldl" needs a factorization from ldl`)
		local F = A :: LDL
		n = F.ldl.cols
		one = function(o, v)
			return ldl_solve(o, F, v)
		end
	elseif form == "svd" then
		assert(
			type(t) == "table" and t.values ~= nil and t.u ~= nil and t.v ~= nil,
			`solve: form "svd" needs a decomposition from svd with vectors`
		)
		local F = A :: Svd
		n = (F.v :: Matrix).rows
		one = function(o, v)
			return (svd_solve(o, F, v))
		end
	else
		assert(form == nil or form == "matrix", `solve: unknown form {form}`)
		assert(type(t) == "table" and t.data ~= nil, "solve: A is not a matrix (pass its form)")
		local M = A :: Matrix
		n = M.cols
		if M.rows == M.cols then
			local F = lu_copy(M)
			one = function(o, v)
				return lu_solve(o, F, v)
			end
		elseif M.rows > M.cols then
			local F = qr_copy(M)
			one = function(o, v)
				return (qr_solve(o, F, v))
			end
		else
			local F = qrp_copy(M)
			one = function(o, v)
				return (qrp_solve(o, F, v))
			end
		end
	end
	local solve1 = one :: (buffer?, buffer) -> buffer
	if type(b) == "buffer" then
		return solve1(out, b)
	end
	assert(type(b) == "table" and b.data ~= nil, "solve: b must be a vector or a matrix")
	local B = b :: Matrix
	local X = matoutput(out, n, B.cols)
	assert(X.data ~= B.data, "output cannot be the right-hand side")
	local col, x = buffer.create(ENTRY * B.rows), buffer.create(ENTRY * n)
	for j = 0, B.cols - 1 do
		buffer.copy(col, 0, B.data, ENTRY * j * B.rows, ENTRY * B.rows)
		solve1(x, col)
		buffer.copy(X.data, ENTRY * j * n, x)
	end
	return X
end

local solve: SolveFunction = solve_impl :: any

-- A rotation (c real, s complex) with [c s; -conj(s) c] [f; g] = [r; 0]; also r.
local function rotation(fr: number, fi: number, gr: number, gi: number): (number, number, number, number, number)
	if gr == 0 and gi == 0 then
		return 1, 0, 0, fr, fi
	end
	local nf = complex64.abs(fr, fi)
	if nf == 0 then
		return 0, 1, 0, gr, gi
	end
	local r = hypot3(nf, complex64.abs(gr, gi), 0)
	local ur, ui = fr / nf, fi / nf
	return nf / r, (ur * gr + ui * gi) / r, (ui * gr - ur * gi) / r, ur * r, ui * r
end

-- Rows i and j (0-based) of M, columns c0..: (x, y) := (c x + s y, -conj(s) x + c y).
local function rows(M: Matrix, i: number, j: number, c0: number, c: number, sr: number, si: number)
	local m = M.rows
	for col = math.max(c0, 0), M.cols - 1 do
		local xr, xi = eget(M.data, col * m + i)
		local yr, yi = eget(M.data, col * m + j)
		eset(M.data, col * m + i, c * xr + sr * yr - si * yi, c * xi + sr * yi + si * yr)
		eset(M.data, col * m + j, -(sr * xr + si * xi) + c * yr, -(sr * xi - si * xr) + c * yi)
	end
end

-- Q := Q G^H for that rotation on rows i, j: columns i, j of Q become
-- (c q_i + conj(s) q_j, -s q_i + c q_j).
local function qcols(Q: Matrix, i: number, j: number, c: number, sr: number, si: number)
	local m = Q.rows
	for row = 0, m - 1 do
		local xr, xi = eget(Q.data, i * m + row)
		local yr, yi = eget(Q.data, j * m + row)
		eset(Q.data, i * m + row, c * xr + sr * yr + si * yi, c * xi + sr * yi - si * yr)
		eset(Q.data, j * m + row, -(sr * xr - si * xi) + c * yr, -(sr * xi + si * xr) + c * yi)
	end
end

-- Rotations on rows (k, k+1) for k = from..to, zeroing R(k+1, k): back to upper
-- triangular from upper Hessenberg in those columns.
local function retriangularize(Q: Matrix, R: Matrix, from: number, to: number)
	local m = R.rows
	for k = from, to do
		local ar, ai = eget(R.data, k * m + k)
		local br, bi = eget(R.data, k * m + k + 1)
		local c, sr, si = rotation(ar, ai, br, bi)
		rows(R, k, k + 1, k, c, sr, si)
		eset(R.data, k * m + k + 1, 0, 0)
		qcols(Q, k, k + 1, c, sr, si)
	end
end

-- The full QR factorization A = Q R as explicit matrices: Q (rows by rows) unitary and
-- R (rows by cols) upper triangular, the form the update functions below work on. A is
-- not modified.
local function qr_full(A: Matrix): QRFull
	local m, n = A.rows, A.cols
	local F = qr_copy(A)
	local Q = matrix(m, m)
	for j = 1, m do
		local e = unit(m, j)
		qr_apply_q(F, e)
		buffer.copy(Q.data, ENTRY * (j - 1) * m, e)
	end
	local R = matrix(m, n)
	local k = math.min(m, n)
	local Rk = qr_r(nil, F)
	for j = 0, n - 1 do
		buffer.copy(R.data, ENTRY * j * m, Rk.data, ENTRY * j * k, ENTRY * k)
	end
	return { q = Q, r = R }
end

-- The rank-one update A + u v^H = Q' R', in place on F = qr_full(A) (Golub and Van Loan
-- 6.5.1): rotations take Q^H u to a multiple of e_1, making R upper Hessenberg; the
-- update then changes only R's first row, and rotations restore the triangle. O(m^2 +
-- m n). Returns F.
local function qr_update(F: QRFull, u: buffer, v: buffer): QRFull
	local Q, R = F.q, F.r
	local m, n = R.rows, R.cols
	assert(length(u) == m and length(v) == n, "qr_update: sizes do not match")
	local w = matvec_adjoint(nil, Q, u)
	for k = m - 1, 1, -1 do
		local ar, ai = eget(w, k - 1)
		local br, bi = eget(w, k)
		local c, sr, si, rr, ri = rotation(ar, ai, br, bi)
		eset(w, k - 1, rr, ri)
		eset(w, k, 0, 0)
		rows(R, k - 1, k, k - 1, c, sr, si)
		qcols(Q, k - 1, k, c, sr, si)
	end
	-- R(0, :) += w_0 conj(v)^T
	local w0r, w0i = eget(w, 0)
	for j = 0, n - 1 do
		local vr, vi = eget(v, j)
		local rr, ri = eget(R.data, j * m)
		eset(R.data, j * m, rr + w0r * vr + w0i * vi, ri + w0i * vr - w0r * vi)
	end
	retriangularize(Q, R, 0, math.min(m - 1, n) - 1)
	return F
end

-- Removes column j (1-based) from the factored matrix: R loses that column, which leaves
-- it upper Hessenberg from column j on, and rotations restore the triangle. Q is updated
-- in place; F.r is replaced. Returns F.
local function qr_delete_col(F: QRFull, j: number): QRFull
	local Q, R = F.q, F.r
	local m, n = R.rows, R.cols
	assert(j >= 1 and j <= n, "qr_delete_col: column out of range")
	local Rn = matrix(m, n - 1)
	if j > 1 then
		buffer.copy(Rn.data, 0, R.data, 0, ENTRY * m * (j - 1))
	end
	if j < n then
		buffer.copy(Rn.data, ENTRY * m * (j - 1), R.data, ENTRY * m * j, ENTRY * m * (n - j))
	end
	retriangularize(Q, Rn, j - 1, math.min(m - 1, n - 1) - 1)
	F.r = Rn
	return F
end

-- Inserts x as column j (1-based; j = cols + 1 appends) of the factored matrix: the new
-- column of R is Q^H x, whose entries below row j are rotated away from the bottom up.
-- Q is updated in place; F.r is replaced. Returns F.
local function qr_insert_col(F: QRFull, j: number, x: buffer): QRFull
	local Q, R = F.q, F.r
	local m, n = R.rows, R.cols
	assert(j >= 1 and j <= n + 1, "qr_insert_col: position out of range")
	assert(length(x) == m, "qr_insert_col: the column has the wrong length")
	local Rn = matrix(m, n + 1)
	if j > 1 then
		buffer.copy(Rn.data, 0, R.data, 0, ENTRY * m * (j - 1))
	end
	buffer.copy(Rn.data, ENTRY * m * (j - 1), matvec_adjoint(nil, Q, x))
	if j <= n then
		buffer.copy(Rn.data, ENTRY * m * j, R.data, ENTRY * m * (j - 1), ENTRY * m * (n - j + 1))
	end
	local jj = j - 1
	for k = m - 1, jj + 1, -1 do
		local ar, ai = eget(Rn.data, jj * m + k - 1)
		local br, bi = eget(Rn.data, jj * m + k)
		local c, sr, si = rotation(ar, ai, br, bi)
		rows(Rn, k - 1, k, jj, c, sr, si)
		eset(Rn.data, jj * m + k, 0, 0)
		qcols(Q, k - 1, k, c, sr, si)
	end
	F.r = Rn
	return F
end

-- The rank-one update A + x x^H of a Cholesky factorization F = chol(A), in place on
-- F.chol's lower triangle (LINPACK's chud): one rotation per column, O(n^2). x is not
-- modified. Returns F.
local function chol_update(F: Cholesky, x: buffer): Cholesky
	local L = F.chol
	local n = L.rows
	assert(F.definite, "chol_update needs a positive definite factorization")
	assert(length(x) == n, "chol_update: sizes do not match")
	local w = copy(nil, x)
	for k = 0, n - 1 do
		local lkk = eget(L.data, k * n + k)
		local xr, xi = eget(w, k)
		local r = hypot3(lkk, xr, xi)
		local c, sr, si = lkk / r, xr / r, xi / r
		eset(L.data, k * n + k, r, 0)
		for i = k + 1, n - 1 do
			local lr, li = eget(L.data, k * n + i)
			local yr, yi = eget(w, i)
			-- l := c l + conj(s) y; y := -s l + c y
			eset(L.data, k * n + i, c * lr + sr * yr + si * yi, c * li + sr * yi - si * yr)
			eset(w, i, -(sr * lr - si * li) + c * yr, -(sr * li + si * lr) + c * yi)
		end
	end
	return F
end

-- The rank-one downdate A - x x^H of a Cholesky factorization F = chol(A), in place
-- (LINPACK's chdd, with hyperbolic rotations). An error, leaving F unchanged, if
-- A - x x^H is not positive definite. x is not modified. Returns F.
local function chol_downdate(F: Cholesky, x: buffer): Cholesky
	local L = F.chol
	local n = L.rows
	assert(F.definite, "chol_downdate needs a positive definite factorization")
	assert(length(x) == n, "chol_downdate: sizes do not match")
	local work = copy(nil, L.data)
	local w = copy(nil, x)
	for k = 0, n - 1 do
		local lkk = eget(work, k * n + k)
		local xr, xi = eget(w, k)
		local d = lkk * lkk - (xr * xr + xi * xi)
		assert(d > 0, "chol_downdate: the result is not positive definite")
		local r = math.sqrt(d)
		local c, sr, si = r / lkk, xr / lkk, xi / lkk
		eset(work, k * n + k, r, 0)
		for i = k + 1, n - 1 do
			local lr, li = eget(work, k * n + i)
			local yr, yi = eget(w, i)
			-- l := (l - conj(s) y) / c; y := c y - s l
			local nr, ni = (lr - (sr * yr + si * yi)) / c, (li - (sr * yi - si * yr)) / c
			eset(work, k * n + i, nr, ni)
			eset(w, i, c * yr - (sr * nr - si * ni), c * yi - (sr * ni + si * nr))
		end
	end
	buffer.copy(L.data, 0, work)
	return F
end

type RefineOptions = { tol: number?, maxiter: number?, method: string?, inner: number? }

-- The module that does the factorization: single precision for the double modules,
-- the module itself otherwise.
local low = require("./c32")
local LOW = true

-- The infinity norm of A (the largest row sum of moduli), for the stopping rule.
local function inf_norm(A: Matrix): number
	local m, n = A.rows, A.cols
	local best = 0
	for i = 0, m - 1 do
		local s = 0
		for j = 0, n - 1 do
			local re, im = eget(A.data, j * m + i)
			s += math.sqrt(re * re + im * im)
		end
		if not (s <= best) then
			best = s -- NaN propagates
		end
	end
	return best
end

-- A copy of x's values in single precision (the double modules) or x itself.
local function down(x: buffer): buffer
	if not LOW then
		return x
	end
	local n = buffer.len(x) // 8
	local y = buffer.create(4 * n)
	for i = 0, n - 1 do
		buffer.writef32(y, 4 * i, buffer.readf64(x, 8 * i))
	end
	return y
end

local function up(y: buffer): buffer
	if not LOW then
		return y
	end
	local n = buffer.len(y) // 4
	local x = buffer.create(8 * n)
	for i = 0, n - 1 do
		buffer.writef64(x, 8 * i, buffer.readf32(y, 4 * i))
	end
	return x
end

-- GMRES on the left-preconditioned correction equation M^-1 A d = M^-1 r, from d = 0,
-- with at most maxinner steps or until the preconditioned residual drops by tol: the
-- inner solver of GMRES-IR (Carson and Higham 2017). Modified Gram-Schmidt run twice
-- keeps the basis orthonormal; complex Givens rotations reduce the Hessenberg matrix.
local function gmres_correction(A: Matrix, precond: (buffer) -> buffer, r: buffer, maxinner: number, tol: number): buffer
	local z = precond(r)
	local beta = norm(z)
	if beta == 0 then
		return z
	end
	local V = { scale(nil, 1 / beta, z) }
	local hr: { { number } }, hi: { { number } } = {}, {}
	local cs: { number }, snr: { number }, sni: { number } = {}, {}, {}
	local gr, gi = { beta }, { 0 }
	local k = 0
	for j = 1, maxinner do
		local w = precond(matvec(nil, A, V[j]))
		local colr, coli = table.create(j + 1, 0) :: { number }, table.create(j + 1, 0) :: { number }
		for _ = 1, 2 do
			for i = 1, j do
				local cr, ci = dotc_pair(V[i], w)
				colr[i] += cr
				coli[i] += ci
				w = caxpy_pair(w, -cr, -ci, V[i], w)
			end
		end
		local hn = norm(w)
		colr[j + 1], coli[j + 1] = hn, 0
		-- Earlier rotations, then a new one zeroing h(j+1, j).
		for i = 1, j - 1 do
			local xr, xi, yr, yi = colr[i], coli[i], colr[i + 1], coli[i + 1]
			local c, sr, si = cs[i], snr[i], sni[i]
			colr[i], coli[i] = c * xr + sr * yr - si * yi, c * xi + sr * yi + si * yr
			colr[i + 1], coli[i + 1] = -(sr * xr + si * xi) + c * yr, -(sr * xi - si * xr) + c * yi
		end
		local ar, ai = colr[j], coli[j]
		local na = complex64.abs(ar, ai)
		local rr = hypot3(na, hn, 0)
		local c, sr, si
		if na == 0 then
			c, sr, si = 0, 1, 0
		else
			-- s = (a / |a|) conj(b) / r with b = hn real
			c, sr, si = na / rr, ar / na * hn / rr, ai / na * hn / rr
		end
		cs[j], snr[j], sni[j] = c, sr, si
		colr[j], coli[j] = c * ar + sr * hn, c * ai + si * hn
		colr[j + 1], coli[j + 1] = 0, 0
		hr[j], hi[j] = colr, coli
		-- g(j+1) = -conj(s) g(j); g(j) = c g(j)
		local g1r, g1i = gr[j], gi[j]
		gr[j + 1], gi[j + 1] = -(sr * g1r + si * g1i), -(sr * g1i - si * g1r)
		gr[j], gi[j] = c * g1r, c * g1i
		k = j
		if hn == 0 or complex64.abs(gr[j + 1], gi[j + 1]) <= tol * beta then
			break
		end
		V[j + 1] = scale(w, 1 / hn, w)
	end
	-- Back substitution H y = g, then d = V y.
	local yr, yi = table.create(k, 0) :: { number }, table.create(k, 0) :: { number }
	for i = k, 1, -1 do
		local tr, ti = gr[i], gi[i]
		for l = i + 1, k do
			local ar, ai = hr[l][i], hi[l][i]
			tr -= ar * yr[l] - ai * yi[l]
			ti -= ar * yi[l] + ai * yr[l]
		end
		yr[i], yi[i] = complex64.div(tr, ti, hr[i][i], hi[i][i])
	end
	local d = scale(nil, 0, V[1])
	for i = 1, k do
		d = caxpy_pair(d, yr[i], yi[i], V[i], d)
	end
	return d
end

-- Solves the square system A x = b by iterative refinement, factoring A once (LU with
-- partial pivoting) and correcting x by solves with the residual b - A x. Returns x and
-- { iterations, converged, fallback }. A and b are not modified.
--
-- Double modules (LAPACK's dsgesv): the factorization is in single precision and the
-- residual in double, until |b - A x| <= sqrt(n) eps |A| |x|: a double-precision solution
-- from single-precision factors (half the memory) while cond(A) is below about 1e7.
-- Beyond that, or if the single-precision LU is singular, it falls back to a double
-- factorization. (Luau computes in double either way, so unlike in compiled code this
-- is not faster than solve.)
--
-- Single modules (as LAPACK's extra-precise refinement): the residual is computed in
-- double precision before it is rounded, and the corrections continue until they are
-- below eps |x| or stop shrinking. That improves the forward error from about
-- cond(A) eps to about eps while cond(A) is below about 1 / eps (1e7); converged says
-- whether the corrections reached eps |x|.
--
-- options.method = "gmres" solves each correction equation by GMRES preconditioned with
-- the factorization (GMRES-IR, Carson and Higham 2017), up to options.inner (default
-- 30) steps, instead of by one solve with it. GMRES copes with a much rougher
-- preconditioner, so refinement keeps converging to about cond(A) = 1 / eps_single^2
-- (about 1e14) instead of 1 / eps_single; in the double modules the single-precision
-- factors are then applied in double arithmetic.
local function solve_refined(out: buffer?, A: Matrix, b: buffer, options: RefineOptions?): (buffer, { iterations: number, converged: boolean, fallback: boolean })
	local n = A.rows
	assert(A.cols == n, "solve_refined needs a square matrix")
	local o: RefineOptions = options or {}
	local useGmres = o.method == "gmres"
	assert(o.method == nil or o.method == "lu" or useGmres, "solve_refined: method must be \"lu\" or \"gmres\"")
	local maxiter = o.maxiter or 30
	local anorm = inf_norm(A)
	local bnorm = norm(b)
	-- The stopping rule of dsgesv: |r| <= |x| |A| eps sqrt(n).
	local tol = o.tol or EPS * math.sqrt(math.max(n, 1))
	local LF: any
	local lowsolve: (buffer) -> buffer
	if LOW then
		local LA = low.matrix(n, n)
		LA.data = down(A.data)
		LF = low.lu(LA)
		lowsolve = function(r: buffer): buffer
			return up(low.lu_solve(nil, LF, down(r)))
		end
	else
		LF = lu_copy(A)
		lowsolve = function(r: buffer): buffer
			return lu_solve(nil, LF, r)
		end
	end
	local function fallback(iterations: number): (buffer, { iterations: number, converged: boolean, fallback: boolean })
		local x = lu_solve(out, lu_copy(A), b)
		return x, { iterations = iterations, converged = true, fallback = true }
	end
	if LF.singular then
		return fallback(0)
	end
	-- One correction: a solve with the factorization, or GMRES preconditioned by it.
	local correct = lowsolve
	if useGmres then
		local precond = lowsolve
		if LOW then
			-- The single-precision factors, applied in double arithmetic.
			local F2: LU = { lu = matrix(n, n), piv = LF.piv, sign = LF.sign, singular = false }
			F2.lu.data = up(LF.lu.data)
			precond = function(r: buffer): buffer
				return lu_solve(nil, F2, r)
			end
		end
		local inner = o.inner or 30
		local itol = math.sqrt(EPS)
		correct = function(r: buffer): buffer
			return gmres_correction(A, precond, r, math.min(inner, n), itol)
		end
	end
	local x = lowsolve(b)
	if bnorm == 0 then
		return copy(out, x), { iterations = 0, converged = true, fallback = false }
	end
	if not LOW then
		-- b - A x accumulated in double precision, rounded once.
		local function residual(y: buffer): buffer
			local m = n
			local rr, ri = table.create(m, 0) :: { number }, table.create(m, 0) :: { number }
			for i = 0, m - 1 do
				rr[i + 1], ri[i + 1] = eget(b, i)
			end
			for j = 0, n - 1 do
				local yr, yi = eget(y, j)
				if yr ~= 0 or yi ~= 0 then
					for i = 0, m - 1 do
						local ar, ai = eget(A.data, j * m + i)
						rr[i + 1] -= ar * yr - ai * yi
						ri[i + 1] -= ar * yi + ai * yr
					end
				end
			end
			local r = buffer.create(buffer.len(b))
			for i = 0, m - 1 do
				eset(r, i, rr[i + 1], ri[i + 1])
			end
			return r
		end
		local last = math.huge
		for iteration = 1, maxiter do
			local d = correct(residual(x))
			local dnorm = norm(d)
			-- No longer improving: the corrections stall, or (plain refinement) one is as
			-- large as x itself, so the factorization cannot resolve the error (cond(A)
			-- eps > 1). GMRES corrections are trusted at any size: when x starts off
			-- wrong, the right correction is as large as x. x is as accurate as this
			-- method allows.
			if not (dnorm < 0.5 * last) or (not useGmres and dnorm >= norm(x)) then
				return copy(out, x), { iterations = iteration - 1, converged = false, fallback = false }
			end
			last = dnorm
			x = axpy(x, 1, d, x)
			if dnorm <= EPS * norm(x) then
				return copy(out, x), { iterations = iteration, converged = true, fallback = false }
			end
		end
		return copy(out, x), { iterations = maxiter, converged = false, fallback = false }
	end
	local last = math.huge
	for iteration = 0, maxiter do
		local r = sub(nil, b, matvec(nil, A, x))
		local rnorm = norm(r)
		if rnorm <= tol * norm(x) * anorm then
			return copy(out, x), { iterations = iteration, converged = true, fallback = false }
		end
		if iteration == maxiter then
			break
		end
		local d = correct(r)
		local dnorm = norm(d)
		-- The corrections must shrink; if they stall, single precision is not enough.
		if not (dnorm < 0.5 * last) and iteration > 1 then
			return fallback(iteration)
		end
		last = dnorm
		x = axpy(x, 1, d, x)
	end
	return fallback(maxiter)
end

