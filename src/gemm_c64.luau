					u3_0 += a3 * c0 - b3 * d0; v3_0 += a3 * d0 + b3 * c0; u3_1 += a3 * c1 - b3 * d1; v3_1 += a3 * d1 + b3 * c1; u3_2 += a3 * c2 - b3 * d2; v3_2 += a3 * d2 + b3 * c2; u3_3 += a3 * c3 - b3 * d3; v3_3 += a3 * d3 + b3 * c3
				end
				do
					local o = 16 * ((j + 0) * m + i + 0)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u0_0)
						buffer.writef64(c, o + 8, alpha * v0_0)
					else
						buffer.writef64(c, o, alpha * u0_0 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v0_0 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 0) * m + i + 1)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u1_0)
						buffer.writef64(c, o + 8, alpha * v1_0)
					else
						buffer.writef64(c, o, alpha * u1_0 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v1_0 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 0) * m + i + 2)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u2_0)
						buffer.writef64(c, o + 8, alpha * v2_0)
					else
						buffer.writef64(c, o, alpha * u2_0 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v2_0 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 0) * m + i + 3)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u3_0)
						buffer.writef64(c, o + 8, alpha * v3_0)
					else
						buffer.writef64(c, o, alpha * u3_0 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v3_0 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 1) * m + i + 0)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u0_1)
						buffer.writef64(c, o + 8, alpha * v0_1)
					else
						buffer.writef64(c, o, alpha * u0_1 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v0_1 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 1) * m + i + 1)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u1_1)
						buffer.writef64(c, o + 8, alpha * v1_1)
					else
						buffer.writef64(c, o, alpha * u1_1 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v1_1 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 1) * m + i + 2)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u2_1)
						buffer.writef64(c, o + 8, alpha * v2_1)
					else
						buffer.writef64(c, o, alpha * u2_1 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v2_1 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 1) * m + i + 3)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u3_1)
						buffer.writef64(c, o + 8, alpha * v3_1)
					else
						buffer.writef64(c, o, alpha * u3_1 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v3_1 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 2) * m + i + 0)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u0_2)
						buffer.writef64(c, o + 8, alpha * v0_2)
					else
						buffer.writef64(c, o, alpha * u0_2 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v0_2 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 2) * m + i + 1)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u1_2)
						buffer.writef64(c, o + 8, alpha * v1_2)
					else
						buffer.writef64(c, o, alpha * u1_2 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v1_2 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 2) * m + i + 2)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u2_2)
						buffer.writef64(c, o + 8, alpha * v2_2)
					else
						buffer.writef64(c, o, alpha * u2_2 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v2_2 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 2) * m + i + 3)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u3_2)
						buffer.writef64(c, o + 8, alpha * v3_2)
					else
						buffer.writef64(c, o, alpha * u3_2 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v3_2 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 3) * m + i + 0)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u0_3)
						buffer.writef64(c, o + 8, alpha * v0_3)
					else
						buffer.writef64(c, o, alpha * u0_3 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v0_3 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 3) * m + i + 1)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u1_3)
						buffer.writef64(c, o + 8, alpha * v1_3)
					else
						buffer.writef64(c, o, alpha * u1_3 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v1_3 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 3) * m + i + 2)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u2_3)
						buffer.writef64(c, o + 8, alpha * v2_3)
					else
						buffer.writef64(c, o, alpha * u2_3 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v2_3 + beta * buffer.readf64(c, o + 8))
					end
				end
				do
					local o = 16 * ((j + 3) * m + i + 3)
					if beta == 0 then
						buffer.writef64(c, o, alpha * u3_3)
						buffer.writef64(c, o + 8, alpha * v3_3)
					else
						buffer.writef64(c, o, alpha * u3_3 + beta * buffer.readf64(c, o))
						buffer.writef64(c, o + 8, alpha * v3_3 + beta * buffer.readf64(c, o + 8))
					end
				end
			end
		end
	end

	local function single(R: buffer, Q: buffer, c: buffer, m: number, p: number, i0: number, i1: number, j0: number, j1: number, alpha: number, beta: number)
		for j = j0, j1 - 1 do
			for i = i0, i1 - 1 do
				local u, v = 0, 0
				local r, q = 16 * i * p, 16 * j * p
				for k = 0, 16 * (p - 1), 16 do
					local a, b = buffer.readf64(R, r + k), buffer.readf64(R, r + k + 8)
					local x, y = buffer.readf64(Q, q + k), buffer.readf64(Q, q + k + 8)
					u += a * x - b * y
					v += a * y + b * x
				end
				local o = 16 * (j * m + i)
				if beta == 0 then
					buffer.writef64(c, o, alpha * u)
					buffer.writef64(c, o + 8, alpha * v)
				else
					buffer.writef64(c, o, alpha * u + beta * buffer.readf64(c, o))
					buffer.writef64(c, o + 8, alpha * v + beta * buffer.readf64(c, o + 8))
				end
			end
		end
	end

	-- Cover rows i0 .. i1 - 1 and columns j0 .. j1 - 1: 8 by 8 blocks, then 4 by 4
	-- blocks over what is left, then single entries.
	function gemm_kernel(R: buffer, Q: buffer, c: buffer, m: number, p: number, n: number, alpha: number, beta: number)
		local mb, nb = m - m % 8, n - n % 8
		big(R, Q, c, m, p, 0, mb, 0, nb, alpha, beta)
		-- The right strip (all rows) and the bottom strip (the big blocks' columns).
		local function rest(i0: number, i1: number, j0: number, j1: number)
			if i1 <= i0 or j1 <= j0 then
				return
			end
			local i4 = i0 + (i1 - i0) - (i1 - i0) % 4
			local j4 = j0 + (j1 - j0) - (j1 - j0) % 4
			small(R, Q, c, m, p, i0, i4, j0, j4, alpha, beta)
			single(R, Q, c, m, p, i4, i1, j0, j4, alpha, beta)
			single(R, Q, c, m, p, i0, i1, j4, j1, alpha, beta)
		end
		rest(0, m, nb, n)
		rest(mb, m, 0, nb)
	end
end

-- The rows of A (m by p, column-major) laid out contiguously: element i * p + k is A[i, k]
-- (conjugated when conj is set).
local function pack_rows(A: Matrix, conj: boolean?): buffer
	local m, p = A.rows, A.cols
	local a = A.data
	local R = buffer.create(16 * m * p)
	local sign = if conj then -1 else 1
	for k = 0, p - 1 do
		for i = 0, m - 1 do
			local s, t = 16 * (i * p + k), 16 * (k * m + i)
			buffer.writef64(R, s, buffer.readf64(a, t))
			buffer.writef64(R, s + 8, sign * buffer.readf64(a, t + 8))
		end
	end
	return R
end

-- out := A B (a new matrix if out is nil); see gemm for scaled and transposed products.
local function matmul(out: Matrix?, A: Matrix, B: Matrix): Matrix
	local m, p, n = A.rows, A.cols, B.cols
	assert(B.rows == p, "matrix sizes do not match")
	local o = matoutput(out, m, n)
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	-- B's columns are already contiguous; A's rows are packed.
	gemm_kernel(pack_rows(A), B.data, o.data, m, p, n, 1, 0)
	return o
end

-- C := alpha op(A) op(B) + beta C (BLAS gemm) with real alpha and beta, where op is
-- "n" (as is), "t" (transposed) or "c" (conjugate transposed). C is new (or out) when
-- beta is 0 or nil. Sums run in double precision and each entry is rounded once.
local function gemm(C: Matrix?, alpha: number, A: Matrix, B: Matrix, beta: number?, opa: string?, opb: string?): Matrix
	local ta, tb = opa ~= nil and opa ~= "n", opb ~= nil and opb ~= "n"
	local m, kk = if ta then A.cols else A.rows, if ta then A.rows else A.cols
	local kb, n = if tb then B.cols else B.rows, if tb then B.rows else B.cols
	assert(kk == kb, "gemm: inner dimensions do not match")
	local b0 = beta or 0
	local o: Matrix
	if b0 == 0 then
		o = matoutput(C, m, n)
	else
		assert(C ~= nil and C.rows == m and C.cols == n, "gemm: beta needs a C of the right shape")
		o = C
	end
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	-- The kernel wants op(A)'s rows and op(B)'s columns contiguous: A^T's rows are A's
	-- columns and B's columns are as stored; the others are packed, and A^H's rows are
	-- A's columns conjugated.
	local R: buffer
	if not ta then
		R = pack_rows(A)
	elseif opa == "c" then
		R = conj(nil, A.data)
	else
		R = A.data
	end
	local Q: buffer
	if not tb then
		Q = B.data
	elseif opb == "c" then
		Q = pack_rows(B, true)
	else
		Q = pack_rows(B)
	end
	gemm_kernel(R, Q, o.data, m, kk, n, alpha, b0)
	return o
end

return {
	gemm = gemm,
	matmul = matmul,
}
