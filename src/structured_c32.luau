--!strict
--!native
--!optimize 2
-- Generated by tools/generate.py from templates/complex/structured.luau.in. Edit the template, not this file.

-- Single-precision complex structured matrices: triangular, tridiagonal, banded, circulant and Toeplitz.
-- Indices are 1-based; arithmetic is done in double precision and rounded once per stored
-- value; every `out` argument may be nil, in which case a new result is allocated.
-- Functions marked (LAPACK's ...) are translations of LAPACK's reference routines
-- (modified BSD license; see licenses/LAPACK-LICENSE.txt).

local types = require("./types")
local complex64 = require("./complex64")
local array_part = require("./array_c32")
local fft_part = require("./fft_c32")
local conj = array_part.conj
local copy = array_part.copy
local mul = array_part.mul
local totable = array_part.totable
local fft = fft_part.fft
local fft_copy = fft_part.fft_copy
local ifft = fft_part.ifft

-- Types and small helpers shared by the parts. They are copied into each part rather than
-- imported, so calls to them are inlined (a call into another module costs several times
-- more); the generator drops the ones a part does not use.

type Matrix = types.Matrix
type Uplo = types.Uplo
type Tridiagonal = types.Tridiagonal
type TridiagonalLU = types.TridiagonalLU
type TridiagonalLDL = types.TridiagonalLDL
type Banded = types.Banded
type BandedLU = types.BandedLU
type BandedCholesky = types.BandedCholesky
type Circulant = types.Circulant
type Toeplitz = types.Toeplitz

-- An array of n zeros.
local function create(n: number): buffer
	return buffer.create(8 * n)
end

-- The number of (complex) elements of x.
local function length(x: buffer): number
	return buffer.len(x) // 8
end

local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

-- A rows by cols matrix of zeros.
local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(8 * rows * cols) }
end

-- Triangular matrices

-- Solves T x = b, where T is the upper or lower triangle of A (the other triangle is not
-- read); with unit, the diagonal is taken to be 1 and not read either. In place if out is b.
local function triangular_solve(out: buffer?, A: Matrix, b: buffer, uplo: Uplo, unit: boolean?): buffer
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	assert(uplo == "upper" or uplo == "lower", "uplo must be \"upper\" or \"lower\"")
	assert(buffer.len(b) == 8 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = A.data
	local upper = uplo == "upper"
	local first, last, step = if upper then n - 1 else 0, if upper then 0 else n - 1, if upper then -1 else 1
	for j = first, last, step do
		local xr, xi = buffer.readf32(o, 8 * j), buffer.readf32(o, (8 * j) + 4) :: number
		if not unit then
			local d = 8 * (j * n + j)
			xr, xi = complex64.div(xr, xi, buffer.readf32(a, d), buffer.readf32(a, d + 4) :: number)
			do
				local here_ = 8 * j
				buffer.writef32(o, here_, xr)
				buffer.writef32(o, here_ + 4, xi)
			end
		end
		local lo, hi = if upper then 0 else j + 1, if upper then j - 1 else n - 1
		for i = lo, hi do
			local q = 8 * (j * n + i)
			local ar, ai = buffer.readf32(a, q), buffer.readf32(a, q + 4) :: number
			do
				local here_ = 8 * i
				buffer.writef32(o, here_, buffer.readf32(o, here_) - (ar * xr - ai * xi))
				buffer.writef32(o, here_ + 4, buffer.readf32(o, here_ + 4) - (ar * xi + ai * xr))
			end
		end
	end
	return o
end

-- T x for the upper or lower triangle T of A (as in triangular_solve).
local function triangular_matvec(out: buffer?, A: Matrix, x: buffer, uplo: Uplo, unit: boolean?): buffer
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	assert(uplo == "upper" or uplo == "lower", "uplo must be \"upper\" or \"lower\"")
	assert(buffer.len(x) == 8 * n, "matrix and vector sizes do not match")
	local o = output(out, 8 * n)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, n - 1 do
		local sr = if unit then buffer.readf32(x, 8 * i) else 0
		local si = if unit then buffer.readf32(x, (8 * i) + 4) else 0
		local lo, hi = if uplo == "upper" then i else 0, if uplo == "upper" then n - 1 else i
		if unit then
			if uplo == "upper" then
				lo += 1
			else
				hi -= 1
			end
		end
		for j = lo, hi do
			local q = 8 * (j * n + i)
			local ar, ai = buffer.readf32(a, q), buffer.readf32(a, q + 4) :: number
			local yr, yi = buffer.readf32(x, 8 * j), buffer.readf32(x, (8 * j) + 4) :: number
			sr += ar * yr - ai * yi
			si += ar * yi + ai * yr
		end
		do
			local here_ = 8 * i
			buffer.writef32(o, here_, sr)
			buffer.writef32(o, here_ + 4, si)
		end
	end
	return o
end

-- Tridiagonal matrices

-- A tridiagonal matrix from its subdiagonal (n-1), diagonal (n) and superdiagonal (n-1).
-- The arrays are used as they are (not copied).
local function tridiagonal(lower: buffer, diag: buffer, upper: buffer): Tridiagonal
	local n = length(diag)
	assert(length(lower) == math.max(n - 1, 0) and length(upper) == math.max(n - 1, 0), "need n-1 off-diagonal entries")
	return { lower = lower, diag = diag, upper = upper }
end

-- A copy of T.
local function tridiag_copy(T: Tridiagonal): Tridiagonal
	return { lower = copy(nil, T.lower), diag = copy(nil, T.diag), upper = copy(nil, T.upper) }
end

-- The dense matrix.
local function tridiag_matrix(T: Tridiagonal): Matrix
	local n = length(T.diag)
	local A = matrix(n, n)
	local a, dl, d, du = A.data, T.lower, T.diag, T.upper
	for i = 0, n - 1 do
		local s = 8 * i
		do
			local here_ = 8 * (i * n + i)
			buffer.writef32(a, here_, buffer.readf32(d, s))
			buffer.writef32(a, here_ + 4, buffer.readf32(d, s + 4))
		end
		if i < n - 1 then
			do
				local here_ = 8 * (i * n + (i + 1))
				buffer.writef32(a, here_, buffer.readf32(dl, s))
				buffer.writef32(a, here_ + 4, buffer.readf32(dl, s + 4))
			end
			do
				local here_ = 8 * ((i + 1) * n + i)
				buffer.writef32(a, here_, buffer.readf32(du, s))
				buffer.writef32(a, here_ + 4, buffer.readf32(du, s + 4))
			end
		end
	end
	return A
end

-- T x
local function tridiag_matvec(out: buffer?, T: Tridiagonal, x: buffer): buffer
	local n = length(T.diag)
	assert(length(x) == n, "matrix and vector sizes do not match")
	local o = output(out, 8 * n)
	assert(o ~= x, "output cannot be the input vector")
	local dl, d, du = T.lower, T.diag, T.upper
	for i = 0, n - 1 do
		-- (Separate locals: only the last argument of a call expands to all its values.)
		local dr, di = buffer.readf32(d, 8 * i), buffer.readf32(d, (8 * i) + 4) :: number
		local vr, vi = buffer.readf32(x, 8 * i), buffer.readf32(x, (8 * i) + 4) :: number
		local sr, si = complex64.mul(dr, di, vr, vi)
		if i > 0 then
			local lr, li = buffer.readf32(dl, 8 * (i - 1)), buffer.readf32(dl, (8 * (i - 1)) + 4) :: number
			local xr, xi = buffer.readf32(x, 8 * (i - 1)), buffer.readf32(x, (8 * (i - 1)) + 4) :: number
			sr += lr * xr - li * xi
			si += lr * xi + li * xr
		end
		if i < n - 1 then
			local ur, ui = buffer.readf32(du, 8 * i), buffer.readf32(du, (8 * i) + 4) :: number
			local xr, xi = buffer.readf32(x, 8 * (i + 1)), buffer.readf32(x, (8 * (i + 1)) + 4) :: number
			sr += ur * xr - ui * xi
			si += ur * xi + ui * xr
		end
		do
			local here_ = 8 * i
			buffer.writef32(o, here_, sr)
			buffer.writef32(o, here_ + 4, si)
		end
	end
	return o
end

-- LU factorization with partial pivoting (LAPACK's gttrf, pivoting on |re| + |im|), in
-- place: T's arrays are overwritten with the factors. tridiag_lu_copy leaves T unchanged.
local function tridiag_lu(T: Tridiagonal): TridiagonalLU
	local n = length(T.diag)
	local dl, d, du = T.lower, T.diag, T.upper
	local du2 = buffer.create(8 * math.max(n - 2, 0))
	local piv = table.create(n, 0)
	for i = 0, n - 2 do
		local dr, di = buffer.readf32(d, 8 * i), buffer.readf32(d, (8 * i) + 4) :: number
		local lr, li = buffer.readf32(dl, 8 * i), buffer.readf32(dl, (8 * i) + 4) :: number
		if math.abs(dr) + math.abs(di) >= math.abs(lr) + math.abs(li) then
			piv[i + 1] = i + 1
			if dr ~= 0 or di ~= 0 then
				local fr, fi = complex64.div(lr, li, dr, di)
				do
					local here_ = 8 * i
					buffer.writef32(dl, here_, fr)
					buffer.writef32(dl, here_ + 4, fi)
				end
				local ur, ui = buffer.readf32(du, 8 * i), buffer.readf32(du, (8 * i) + 4) :: number
				do
					local here_ = 8 * (i + 1)
					buffer.writef32(d, here_, buffer.readf32(d, here_) - (fr * ur - fi * ui))
					buffer.writef32(d, here_ + 4, buffer.readf32(d, here_ + 4) - (fr * ui + fi * ur))
				end
			end
		else
			local fr, fi = complex64.div(dr, di, lr, li)
			do
				local here_ = 8 * i
				buffer.writef32(d, here_, lr)
				buffer.writef32(d, here_ + 4, li)
			end
			do
				local here_ = 8 * i
				buffer.writef32(dl, here_, fr)
				buffer.writef32(dl, here_ + 4, fi)
			end
			local tr, ti = buffer.readf32(du, 8 * i), buffer.readf32(du, (8 * i) + 4) :: number
			local nr, ni = buffer.readf32(d, 8 * (i + 1)), buffer.readf32(d, (8 * (i + 1)) + 4) :: number
			do
				local here_ = 8 * i
				buffer.writef32(du, here_, nr)
				buffer.writef32(du, here_ + 4, ni)
			end
			do
				local here_ = 8 * (i + 1)
				buffer.writef32(d, here_, tr - (fr * nr - fi * ni))
				buffer.writef32(d, here_ + 4, ti - (fr * ni + fi * nr))
			end
			if i < n - 2 then
				local ur, ui = buffer.readf32(du, 8 * (i + 1)), buffer.readf32(du, (8 * (i + 1)) + 4) :: number
				do
					local here_ = 8 * i
					buffer.writef32(du2, here_, ur)
					buffer.writef32(du2, here_ + 4, ui)
				end
				do
					local here_ = 8 * (i + 1)
					buffer.writef32(du, here_, -(fr * ur - fi * ui))
					buffer.writef32(du, here_ + 4, -(fr * ui + fi * ur))
				end
			end
			piv[i + 1] = i + 2
		end
	end
	if n > 0 then
		piv[n] = n
	end
	local singular = false
	for i = 0, n - 1 do
		local dr, di = buffer.readf32(d, 8 * i), buffer.readf32(d, (8 * i) + 4) :: number
		if dr == 0 and di == 0 then
			singular = true
		end
	end
	return { lu = T, du2 = du2, piv = piv, singular = singular }
end

-- tridiag_lu of a copy of T; T is not modified.
local function tridiag_lu_copy(T: Tridiagonal): TridiagonalLU
	return tridiag_lu(tridiag_copy(T))
end

-- Solves T x = b given F = tridiag_lu(T). In place if out is b.
local function tridiag_lu_solve(out: buffer?, F: TridiagonalLU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local dl, d, du, du2 = F.lu.lower, F.lu.diag, F.lu.upper, F.du2
	local n = length(d)
	assert(length(b) == n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	for i = 0, n - 2 do
		local br, bi = buffer.readf32(o, 8 * i), buffer.readf32(o, (8 * i) + 4) :: number
		local nr, ni = buffer.readf32(o, 8 * (i + 1)), buffer.readf32(o, (8 * (i + 1)) + 4) :: number
		local lr, li = buffer.readf32(dl, 8 * i), buffer.readf32(dl, (8 * i) + 4) :: number
		if F.piv[i + 1] == i + 1 then
			do
				local here_ = 8 * (i + 1)
				buffer.writef32(o, here_, nr - (lr * br - li * bi))
				buffer.writef32(o, here_ + 4, ni - (lr * bi + li * br))
			end
		else
			do
				local here_ = 8 * i
				buffer.writef32(o, here_, nr)
				buffer.writef32(o, here_ + 4, ni)
			end
			do
				local here_ = 8 * (i + 1)
				buffer.writef32(o, here_, br - (lr * nr - li * ni))
				buffer.writef32(o, here_ + 4, bi - (lr * ni + li * nr))
			end
		end
	end
	for i = n - 1, 0, -1 do
		local sr, si = buffer.readf32(o, 8 * i), buffer.readf32(o, (8 * i) + 4) :: number
		if i < n - 1 then
			local ur, ui = buffer.readf32(du, 8 * i), buffer.readf32(du, (8 * i) + 4) :: number
			local xr, xi = buffer.readf32(o, 8 * (i + 1)), buffer.readf32(o, (8 * (i + 1)) + 4) :: number
			sr -= ur * xr - ui * xi
			si -= ur * xi + ui * xr
		end
		if i < n - 2 then
			local ur, ui = buffer.readf32(du2, 8 * i), buffer.readf32(du2, (8 * i) + 4) :: number
			local xr, xi = buffer.readf32(o, 8 * (i + 2)), buffer.readf32(o, (8 * (i + 2)) + 4) :: number
			sr -= ur * xr - ui * xi
			si -= ur * xi + ui * xr
		end
		local dr, di = buffer.readf32(d, 8 * i), buffer.readf32(d, (8 * i) + 4) :: number
		local xr, xi = complex64.div(sr, si, dr, di)
		do
			local here_ = 8 * i
			buffer.writef32(o, here_, xr)
			buffer.writef32(o, here_ + 4, xi)
		end
	end
	return o
end

-- LDL^H factorization of a Hermitian positive definite tridiagonal matrix (LAPACK's
-- pttrf), in place: only T.diag (its real parts) and T.lower are read; they are
-- overwritten with D and the subdiagonal of L. definite is false if T is not positive
-- definite (T is then partly overwritten). tridiag_ldl_copy leaves T unchanged.
local function tridiag_ldl(T: Tridiagonal): TridiagonalLDL
	local d, e = T.diag, T.lower
	local n = length(d)
	for i = 0, n - 1 do
		local di = buffer.readf32(d, 8 * i)
		buffer.writef32(d, (8 * i) + 4, 0)
		if not (di > 0) then
			return { ldl = T, definite = false }
		end
		if i < n - 1 then
			local er, ei = buffer.readf32(e, 8 * i), buffer.readf32(e, (8 * i) + 4) :: number
			local lr, li = er / di, ei / di
			do
				local here_ = 8 * i
				buffer.writef32(e, here_, lr)
				buffer.writef32(e, here_ + 4, li)
			end
			-- d_i+1 -= l conj(e) = |e|^2 / d_i
			buffer.writef32(d, 8 * (i + 1), buffer.readf32(d, 8 * (i + 1)) - (lr * er + li * ei))
		end
	end
	return { ldl = T, definite = true }
end

-- tridiag_ldl of a copy of T; T is not modified.
local function tridiag_ldl_copy(T: Tridiagonal): TridiagonalLDL
	return tridiag_ldl(tridiag_copy(T))
end

-- Solves T x = b given F = tridiag_ldl(T). In place if out is b.
local function tridiag_ldl_solve(out: buffer?, F: TridiagonalLDL, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local d, e = F.ldl.diag, F.ldl.lower
	local n = length(d)
	assert(length(b) == n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	-- L y = b
	for i = 1, n - 1 do
		local pr, pi = buffer.readf32(o, 8 * (i - 1)), buffer.readf32(o, (8 * (i - 1)) + 4) :: number
		local lr, li = buffer.readf32(e, 8 * (i - 1)), buffer.readf32(e, (8 * (i - 1)) + 4) :: number
		do
			local here_ = 8 * i
			buffer.writef32(o, here_, buffer.readf32(o, here_) - (lr * pr - li * pi))
			buffer.writef32(o, here_ + 4, buffer.readf32(o, here_ + 4) - (lr * pi + li * pr))
		end
	end
	-- D z = y
	for i = 0, n - 1 do
		local dr = buffer.readf32(d, 8 * i)
		do
			local here_ = 8 * i
			buffer.writef32(o, here_, buffer.readf32(o, here_) / dr)
			buffer.writef32(o, here_ + 4, buffer.readf32(o, here_ + 4) / dr)
		end
	end
	-- L^H x = z
	for i = n - 2, 0, -1 do
		local nr, ni = buffer.readf32(o, 8 * (i + 1)), buffer.readf32(o, (8 * (i + 1)) + 4) :: number
		local lr, li = buffer.readf32(e, 8 * i), buffer.readf32(e, (8 * i) + 4) :: number
		-- conj(l) x_i+1
		do
			local here_ = 8 * i
			buffer.writef32(o, here_, buffer.readf32(o, here_) - (lr * nr + li * ni))
			buffer.writef32(o, here_ + 4, buffer.readf32(o, here_ + 4) - (lr * ni - li * nr))
		end
	end
	return o
end

-- Banded matrices

-- A zero n by n banded matrix with kl subdiagonals and ku superdiagonals.
local function banded(n: number, kl: number, ku: number): Banded
	assert(kl >= 0 and ku >= 0, "bandwidths must be nonnegative")
	local ld = 2 * kl + ku + 1
	return { n = n, kl = kl, ku = ku, ld = ld, data = buffer.create(8 * ld * n) }
end

-- A copy of B.
local function band_copy(B: Banded): Banded
	local C = banded(B.n, B.kl, B.ku)
	buffer.copy(C.data, 0, B.data)
	return C
end

local function in_band(B: Banded, i: number, j: number): boolean
	return i - j <= B.kl and j - i <= B.ku and i >= 1 and j >= 1 and i <= B.n and j <= B.n
end

-- Entry (i, j), 1-based, as a vector; 0 outside the band.
local function band_get(B: Banded, i: number, j: number): vector
	if not in_band(B, i, j) then
		return vector.create(0, 0, 0)
	end
	local a, o = B.data, 8 * ((j - 1) * B.ld + B.kl + B.ku + (i - 1) - (j - 1))
	local re, im = buffer.readf32(a, o), buffer.readf32(a, o + 4) :: number
	return vector.create(re, im, 0)
end

-- Sets entry (i, j), 1-based, which must lie in the band.
local function band_set(B: Banded, i: number, j: number, z: vector)
	assert(in_band(B, i, j), "entry is outside the band")
	local a = B.data
	do
		local here_ = 8 * ((j - 1) * B.ld + B.kl + B.ku + (i - 1) - (j - 1))
		buffer.writef32(a, here_, z.x)
		buffer.writef32(a, here_ + 4, z.y)
	end
end

-- The band of the square matrix A (entries outside it are dropped).
local function band_from_matrix(A: Matrix, kl: number, ku: number): Banded
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local B = banded(n, kl, ku)
	local dense, band = A.data, B.data
	for j = 0, n - 1 do
		for i = math.max(0, j - ku), math.min(n - 1, j + kl) do
			local s = 8 * (j * n + i)
			do
				local here_ = 8 * (j * B.ld + B.kl + B.ku + i - j)
				buffer.writef32(band, here_, buffer.readf32(dense, s))
				buffer.writef32(band, here_ + 4, buffer.readf32(dense, s + 4))
			end
		end
	end
	return B
end

-- The dense matrix.
local function band_matrix(B: Banded): Matrix
	local n = B.n
	local A = matrix(n, n)
	local dense, band = A.data, B.data
	for j = 0, n - 1 do
		for i = math.max(0, j - B.ku), math.min(n - 1, j + B.kl) do
			local s = 8 * (j * B.ld + B.kl + B.ku + i - j)
			do
				local here_ = 8 * (j * n + i)
				buffer.writef32(dense, here_, buffer.readf32(band, s))
				buffer.writef32(dense, here_ + 4, buffer.readf32(band, s + 4))
			end
		end
	end
	return A
end

-- B x
local function band_matvec(out: buffer?, B: Banded, x: buffer): buffer
	local n = B.n
	assert(length(x) == n, "matrix and vector sizes do not match")
	local o = output(out, 8 * n)
	assert(o ~= x, "output cannot be the input vector")
	buffer.fill(o, 0, 0)
	local a = B.data
	for j = 0, n - 1 do
		local xr, xi = buffer.readf32(x, 8 * j), buffer.readf32(x, (8 * j) + 4) :: number
		for i = math.max(0, j - B.ku), math.min(n - 1, j + B.kl) do
			local q = 8 * (j * B.ld + B.kl + B.ku + i - j)
			local ar, ai = buffer.readf32(a, q), buffer.readf32(a, q + 4) :: number
			local sr, si = buffer.readf32(o, 8 * i), buffer.readf32(o, (8 * i) + 4) :: number
			do
				local here_ = 8 * i
				buffer.writef32(o, here_, sr + ar * xr - ai * xi)
				buffer.writef32(o, here_ + 4, si + ar * xi + ai * xr)
			end
		end
	end
	return o
end

-- Banded LU with partial pivoting (LAPACK's gbtf2, pivoting on |re| + |im|), in place: B is
-- overwritten with the factors, U getting up to kl + ku superdiagonals in B's extra rows.
-- band_lu_copy leaves B unchanged.
local function band_lu(B: Banded): BandedLU
	local n, kl, ku = B.n, B.kl, B.ku
	local kv = kl + ku
	local a = B.data
	for j = 0, n - 1 do
		for i = math.max(0, j - kv), j - ku - 1 do
			do
				local here_ = 8 * (j * B.ld + kv + i - j)
				buffer.writef32(a, here_, 0)
				buffer.writef32(a, here_ + 4, 0)
			end
		end
	end
	local piv = table.create(n, 0)
	local singular = false
	local ju = 0
	for j = 0, n - 1 do
		local km = math.min(kl, n - 1 - j)
		local p, best = j, -1
		for i = j, j + km do
			local q = 8 * (j * B.ld + kv + i - j)
			local vr, vi = buffer.readf32(a, q), buffer.readf32(a, q + 4) :: number
			local v = math.abs(vr) + math.abs(vi)
			if v > best then
				p, best = i, v
			end
		end
		piv[j + 1] = p + 1
		local q = 8 * (j * B.ld + kv + p - j)
		local pr, pi = buffer.readf32(a, q), buffer.readf32(a, q + 4) :: number
		if pr ~= 0 or pi ~= 0 then
			ju = math.max(ju, math.min(j + ku + (p - j), n - 1))
			if p ~= j then
				for c = j, ju do
					do
						local s_ = 8 * (c * B.ld + kv + j - c)
						local t_ = 8 * (c * B.ld + kv + p - c)
						local re_, im_ = buffer.readf32(a, s_), buffer.readf32(a, s_ + 4)
						buffer.writef32(a, s_, buffer.readf32(a, t_))
						buffer.writef32(a, s_ + 4, buffer.readf32(a, t_ + 4))
						buffer.writef32(a, t_, re_)
						buffer.writef32(a, t_ + 4, im_)
					end
				end
			end
			if km > 0 then
				local dq = 8 * (j * B.ld + kv + j - j)
				local dr, di = buffer.readf32(a, dq), buffer.readf32(a, dq + 4) :: number
				for i = j + 1, j + km do
					local vq = 8 * (j * B.ld + kv + i - j)
					local vr, vi = buffer.readf32(a, vq), buffer.readf32(a, vq + 4) :: number
					local qr, qi = complex64.div(vr, vi, dr, di)
					buffer.writef32(a, vq, qr)
					buffer.writef32(a, vq + 4, qi)
				end
				for c = j + 1, ju do
					local yq = 8 * (c * B.ld + kv + j - c)
					local yr, yi = buffer.readf32(a, yq), buffer.readf32(a, yq + 4) :: number
					if yr ~= 0 or yi ~= 0 then
						for i = j + 1, j + km do
							local lq = 8 * (j * B.ld + kv + i - j)
							local lr, li = buffer.readf32(a, lq), buffer.readf32(a, lq + 4) :: number
							do
								local here_ = 8 * (c * B.ld + kv + i - c)
								buffer.writef32(a, here_, buffer.readf32(a, here_) - (lr * yr - li * yi))
								buffer.writef32(a, here_ + 4, buffer.readf32(a, here_ + 4) - (lr * yi + li * yr))
							end
						end
					end
				end
			end
		else
			singular = true
		end
	end
	return { lu = B, piv = piv, singular = singular }
end

-- band_lu of a copy of B; B is not modified.
local function band_lu_copy(B: Banded): BandedLU
	return band_lu(band_copy(B))
end

-- Solves B x = b given F = band_lu(B). In place if out is b.
local function band_lu_solve(out: buffer?, F: BandedLU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local B = F.lu
	local n, kl, ku = B.n, B.kl, B.ku
	local kv = kl + ku
	assert(length(b) == n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = B.data
	for j = 0, n - 2 do
		local p = F.piv[j + 1] - 1
		if p ~= j then
			do
				local s_ = 8 * j
				local t_ = 8 * p
				local re_, im_ = buffer.readf32(o, s_), buffer.readf32(o, s_ + 4)
				buffer.writef32(o, s_, buffer.readf32(o, t_))
				buffer.writef32(o, s_ + 4, buffer.readf32(o, t_ + 4))
				buffer.writef32(o, t_, re_)
				buffer.writef32(o, t_ + 4, im_)
			end
		end
		local yr, yi = buffer.readf32(o, 8 * j), buffer.readf32(o, (8 * j) + 4) :: number
		for i = j + 1, math.min(n - 1, j + kl) do
			local q = 8 * (j * B.ld + kv + i - j)
			local lr, li = buffer.readf32(a, q), buffer.readf32(a, q + 4) :: number
			do
				local here_ = 8 * i
				buffer.writef32(o, here_, buffer.readf32(o, here_) - (lr * yr - li * yi))
				buffer.writef32(o, here_ + 4, buffer.readf32(o, here_ + 4) - (lr * yi + li * yr))
			end
		end
	end
	for j = n - 1, 0, -1 do
		local dq = 8 * (j * B.ld + kv + j - j)
		local dr, di = buffer.readf32(a, dq), buffer.readf32(a, dq + 4) :: number
		local vr, vi = buffer.readf32(o, 8 * j), buffer.readf32(o, (8 * j) + 4) :: number
		local xr, xi = complex64.div(vr, vi, dr, di)
		do
			local here_ = 8 * j
			buffer.writef32(o, here_, xr)
			buffer.writef32(o, here_ + 4, xi)
		end
		for i = math.max(0, j - kv), j - 1 do
			local q = 8 * (j * B.ld + kv + i - j)
			local ur, ui = buffer.readf32(a, q), buffer.readf32(a, q + 4) :: number
			do
				local here_ = 8 * i
				buffer.writef32(o, here_, buffer.readf32(o, here_) - (ur * xr - ui * xi))
				buffer.writef32(o, here_ + 4, buffer.readf32(o, here_ + 4) - (ur * xi + ui * xr))
			end
		end
	end
	return o
end

-- Banded Cholesky A = L L^H of a Hermitian positive definite matrix (LAPACK's pbtf2,
-- lower), in place: only the diagonal (its real parts) and the kl subdiagonals are read and
-- overwritten with L. definite is false if B is not positive definite (B is then partly
-- overwritten). band_chol_copy leaves B unchanged.
local function band_chol(B: Banded): BandedCholesky
	local n, kd = B.n, B.kl
	local a = B.data
	for j = 0, n - 1 do
		local ajj = buffer.readf32(a, 8 * (j * B.ld + B.kl + B.ku + j - j))
		if not (ajj > 0) then
			return { chol = B, definite = false }
		end
		ajj = math.sqrt(ajj)
		do
			local here_ = 8 * (j * B.ld + B.kl + B.ku + j - j)
			buffer.writef32(a, here_, ajj)
			buffer.writef32(a, here_ + 4, 0)
		end
		local kn = math.min(kd, n - 1 - j)
		for i = j + 1, j + kn do
			do
				local here_ = 8 * (j * B.ld + B.kl + B.ku + i - j)
				buffer.writef32(a, here_, buffer.readf32(a, here_) / ajj)
				buffer.writef32(a, here_ + 4, buffer.readf32(a, here_ + 4) / ajj)
			end
		end
		-- Trailing lower band -= x x^H, x = column j below the diagonal.
		for c = j + 1, j + kn do
			local cq = 8 * (j * B.ld + B.kl + B.ku + c - j)
			local cr, ci = buffer.readf32(a, cq), buffer.readf32(a, cq + 4) :: number
			for i = c, j + kn do
				local xq = 8 * (j * B.ld + B.kl + B.ku + i - j)
				local xr, xi = buffer.readf32(a, xq), buffer.readf32(a, xq + 4) :: number
				local vq = 8 * (c * B.ld + B.kl + B.ku + i - c)
				local vr, vi = buffer.readf32(a, vq), buffer.readf32(a, vq + 4) :: number
				-- x_i conj(x_c)
				buffer.writef32(a, vq, vr - (xr * cr + xi * ci))
				buffer.writef32(a, vq + 4, if i == c then 0 else vi - (xi * cr - xr * ci))
			end
		end
	end
	return { chol = B, definite = true }
end

-- band_chol of a copy of B; B is not modified.
local function band_chol_copy(B: Banded): BandedCholesky
	return band_chol(band_copy(B))
end

-- Solves B x = b given F = band_chol(B). In place if out is b.
local function band_chol_solve(out: buffer?, F: BandedCholesky, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local B = F.chol
	local n, kd = B.n, B.kl
	assert(length(b) == n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = B.data
	-- L y = b (real diagonal)
	for j = 0, n - 1 do
		local d = buffer.readf32(a, 8 * (j * B.ld + B.kl + B.ku + j - j))
		local vr, vi = buffer.readf32(o, 8 * j), buffer.readf32(o, (8 * j) + 4) :: number
		local yr, yi = vr / d, vi / d
		do
			local here_ = 8 * j
			buffer.writef32(o, here_, yr)
			buffer.writef32(o, here_ + 4, yi)
		end
		for i = j + 1, math.min(n - 1, j + kd) do
			local q = 8 * (j * B.ld + B.kl + B.ku + i - j)
			local lr, li = buffer.readf32(a, q), buffer.readf32(a, q + 4) :: number
			do
				local here_ = 8 * i
				buffer.writef32(o, here_, buffer.readf32(o, here_) - (lr * yr - li * yi))
				buffer.writef32(o, here_ + 4, buffer.readf32(o, here_ + 4) - (lr * yi + li * yr))
			end
		end
	end
	-- L^H x = y
	for j = n - 1, 0, -1 do
		local sr, si = buffer.readf32(o, 8 * j), buffer.readf32(o, (8 * j) + 4) :: number
		for i = j + 1, math.min(n - 1, j + kd) do
			local q = 8 * (j * B.ld + B.kl + B.ku + i - j)
			local lr, li = buffer.readf32(a, q), buffer.readf32(a, q + 4) :: number
			local xr, xi = buffer.readf32(o, 8 * i), buffer.readf32(o, (8 * i) + 4) :: number
			-- conj(l) x
			sr -= lr * xr + li * xi
			si -= lr * xi - li * xr
		end
		local d = buffer.readf32(a, 8 * (j * B.ld + B.kl + B.ku + j - j))
		do
			local here_ = 8 * j
			buffer.writef32(o, here_, sr / d)
			buffer.writef32(o, here_ + 4, si / d)
		end
	end
	return o
end

-- Circulant and Toeplitz matrices

-- The circulant matrix with first column c (its eigenvalues are computed now).
local function circulant(c: buffer): Circulant
	return { n = length(c), eig = fft_copy(c) }
end

-- C x, by FFT.
local function circulant_matvec(out: buffer?, C: Circulant, x: buffer): buffer
	assert(length(x) == C.n, "matrix and vector sizes do not match")
	local o = copy(out, x)
	fft(o)
	mul(o, o, C.eig)
	return ifft(o)
end

-- Solves C x = b, by FFT. In place if out is b.
local function circulant_solve(out: buffer?, C: Circulant, b: buffer): buffer
	assert(length(b) == C.n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	fft(o)
	local eig = C.eig
	for k = 0, C.n - 1 do
		local er, ei = buffer.readf32(eig, 8 * k), buffer.readf32(eig, (8 * k) + 4) :: number
		assert(er ~= 0 or ei ~= 0, "circulant matrix is singular")
		local vr, vi = buffer.readf32(o, 8 * k), buffer.readf32(o, (8 * k) + 4) :: number
		local qr, qi = complex64.div(vr, vi, er, ei)
		do
			local here_ = 8 * k
			buffer.writef32(o, here_, qr)
			buffer.writef32(o, here_ + 4, qi)
		end
	end
	return ifft(o)
end

-- The dense matrix.
local function circulant_matrix(c: buffer): Matrix
	local n = length(c)
	local A = matrix(n, n)
	local a = A.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local s = 8 * ((i - j) % n)
			do
				local here_ = 8 * (j * n + i)
				buffer.writef32(a, here_, buffer.readf32(c, s))
				buffer.writef32(a, here_ + 4, buffer.readf32(c, s + 4))
			end
		end
	end
	return A
end

-- The Toeplitz matrix with first column col and first row row (default: conj(col), which
-- makes it Hermitian when col[1] is real, as in SciPy). row[1] is ignored. Both arrays are
-- copied.
local function toeplitz(col: buffer, row: buffer?): Toeplitz
	local n = length(col)
	local r = if row then row else conj(nil, col)
	assert(length(r) == n, "first row and first column have different lengths")
	local M = 1
	while M < 2 * n - 1 do
		M *= 2
	end
	local e = create(M)
	for k = 0, n - 1 do
		local s = 8 * k
		buffer.writef32(e, s, buffer.readf32(col, s))
		buffer.writef32(e, s + 4, buffer.readf32(col, s + 4))
		if k > 0 then
			do
				local here_ = 8 * (M - k)
				buffer.writef32(e, here_, buffer.readf32(r, s))
				buffer.writef32(e, here_ + 4, buffer.readf32(r, s + 4))
			end
		end
	end
	return { n = n, col = copy(nil, col), row = copy(nil, r), embed = circulant(e) }
end

-- The dense matrix.
local function toeplitz_matrix(T: Toeplitz): Matrix
	local n = T.n
	local A = matrix(n, n)
	local a, col, row = A.data, T.col, T.row
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			if i >= j then
				local s = 8 * (i - j)
				do
					local here_ = 8 * (j * n + i)
					buffer.writef32(a, here_, buffer.readf32(col, s))
					buffer.writef32(a, here_ + 4, buffer.readf32(col, s + 4))
				end
			else
				local s = 8 * (j - i)
				do
					local here_ = 8 * (j * n + i)
					buffer.writef32(a, here_, buffer.readf32(row, s))
					buffer.writef32(a, here_ + 4, buffer.readf32(row, s + 4))
				end
			end
		end
	end
	return A
end

-- T x, by FFT through the circulant embedding.
local function toeplitz_matvec(out: buffer?, T: Toeplitz, x: buffer): buffer
	local n = T.n
	assert(length(x) == n, "matrix and vector sizes do not match")
	local o = output(out, 8 * n)
	if n == 0 then
		return o
	end
	local padded = create(T.embed.n)
	buffer.copy(padded, 0, x, 0, 8 * n)
	circulant_matvec(padded, T.embed, padded)
	buffer.copy(o, 0, padded, 0, 8 * n)
	return o
end

-- Solves T x = b by Levinson's recursion, O(n^2) in double precision. It needs every
-- leading principal submatrix of T to be nonsingular (it raises an error otherwise) and is
-- reliable for well-conditioned, especially Hermitian positive definite, matrices; for
-- other Toeplitz systems use solve on toeplitz_matrix(T). In place if out is b.
local function toeplitz_solve(out: buffer?, T: Toeplitz, b: buffer): buffer
	local n = T.n
	assert(length(b) == n, "matrix and vector sizes do not match")
	local br, bi = totable(b)
	local o = output(out, 8 * n)
	if n == 0 then
		return o
	end
	local cr, ci = totable(T.col)
	local rr, ri = totable(T.row)
	local function t(k: number): (number, number)
		if k >= 0 then
			return cr[k + 1], ci[k + 1]
		end
		return rr[1 - k], ri[1 - k]
	end
	assert(cr[1] ~= 0 or ci[1] ~= 0, "toeplitz_solve: a leading principal submatrix is singular")
	local ir, ii = complex64.inv(cr[1], ci[1])
	local fr, fi, gr, gi = { ir }, { ii }, { ir }, { ii }
	local xr, xi = {}, {}
	xr[1], xi[1] = complex64.mul(br[1], bi[1], ir, ii)
	for m = 1, n - 1 do
		local efr, efi, egr, egi, exr, exi = 0, 0, 0, 0, 0, 0
		for j = 1, m do
			local tr, ti = t(m + 1 - j)
			efr += tr * fr[j] - ti * fi[j]
			efi += tr * fi[j] + ti * fr[j]
			exr += tr * xr[j] - ti * xi[j]
			exi += tr * xi[j] + ti * xr[j]
			local sr, si = t(-j)
			egr += sr * gr[j] - si * gi[j]
			egi += sr * gi[j] + si * gr[j]
		end
		local pr, pi = complex64.mul(efr, efi, egr, egi)
		local dr, di = 1 - pr, -pi
		assert(dr ~= 0 or di ~= 0, "toeplitz_solve: a leading principal submatrix is singular")
		local qr, qi = complex64.inv(dr, di)
		local nfr, nfi = table.create(m + 1, 0), table.create(m + 1, 0)
		local ngr, ngi = table.create(m + 1, 0), table.create(m + 1, 0)
		for j = 1, m + 1 do
			local ajr, aji = if j <= m then fr[j] else 0, if j <= m then fi[j] else 0
			local bjr, bji = if j >= 2 then gr[j - 1] else 0, if j >= 2 then gi[j - 1] else 0
			-- (f_j - ef g_j-1) / den and (g_j-1 - eg f_j) / den
			local ur, ui = ajr - (efr * bjr - efi * bji), aji - (efr * bji + efi * bjr)
			local vr, vi = bjr - (egr * ajr - egi * aji), bji - (egr * aji + egi * ajr)
			nfr[j], nfi[j] = ur * qr - ui * qi, ur * qi + ui * qr
			ngr[j], ngi[j] = vr * qr - vi * qi, vr * qi + vi * qr
		end
		fr, fi, gr, gi = nfr, nfi, ngr, ngi
		xr[m + 1], xi[m + 1] = 0, 0
		local sr, si = br[m + 1] - exr, bi[m + 1] - exi
		for j = 1, m + 1 do
			xr[j] += sr * gr[j] - si * gi[j]
			xi[j] += sr * gi[j] + si * gr[j]
		end
	end
	for j = 1, n do
		do
			local here_ = 8 * (j - 1)
			buffer.writef32(o, here_, xr[j])
			buffer.writef32(o, here_ + 4, xi[j])
		end
	end
	return o
end

return {
	band_chol = band_chol,
	band_chol_copy = band_chol_copy,
	band_chol_solve = band_chol_solve,
	band_copy = band_copy,
	band_from_matrix = band_from_matrix,
	band_get = band_get,
	band_lu = band_lu,
	band_lu_copy = band_lu_copy,
	band_lu_solve = band_lu_solve,
	band_matrix = band_matrix,
	band_matvec = band_matvec,
	band_set = band_set,
	banded = banded,
	circulant = circulant,
	circulant_matrix = circulant_matrix,
	circulant_matvec = circulant_matvec,
	circulant_solve = circulant_solve,
	toeplitz = toeplitz,
	toeplitz_matrix = toeplitz_matrix,
	toeplitz_matvec = toeplitz_matvec,
	toeplitz_solve = toeplitz_solve,
	triangular_matvec = triangular_matvec,
	triangular_solve = triangular_solve,
	tridiag_copy = tridiag_copy,
	tridiag_ldl = tridiag_ldl,
	tridiag_ldl_copy = tridiag_ldl_copy,
	tridiag_ldl_solve = tridiag_ldl_solve,
	tridiag_lu = tridiag_lu,
	tridiag_lu_copy = tridiag_lu_copy,
	tridiag_lu_solve = tridiag_lu_solve,
	tridiag_matrix = tridiag_matrix,
	tridiag_matvec = tridiag_matvec,
	tridiagonal = tridiagonal,
}
