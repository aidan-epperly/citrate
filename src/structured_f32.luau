--!strict
--!native
--!optimize 2
-- Generated by tools/generate.py from templates/real/structured.luau.in. Edit the template, not this file.

-- Single-precision real structured matrices: triangular, tridiagonal, banded, circulant and Toeplitz.
-- Indices are 1-based; arithmetic is done in double precision and rounded once per stored
-- value; every `out` argument may be nil, in which case a new result is allocated.
-- Functions marked (LAPACK's ...) are translations of LAPACK's reference routines
-- (modified BSD license; see licenses/LAPACK-LICENSE.txt).

local types = require("./types")
-- Complex results use the complex modules of the same precision.
local complexmod = require("./c32")
local complex64 = require("./complex64")
local array_part = require("./array_f32")
local fft_part = require("./fft_f32")
local copy = array_part.copy
local totable = array_part.totable
local CE = fft_part.CE
local irfft = fft_part.irfft
local rfft = fft_part.rfft

-- Types and small helpers shared by the parts. They are copied into each part rather than
-- imported, so calls to them are inlined (a call into another module costs several times
-- more); the generator drops the ones a part does not use.

type Matrix = types.Matrix
type Uplo = types.Uplo
type Tridiagonal = types.Tridiagonal
type TridiagonalLU = types.TridiagonalLU
type TridiagonalLDL = types.TridiagonalLDL
type Banded = types.Banded
type BandedLU = types.BandedLU
type BandedCholesky = types.BandedCholesky
type SymBanded = types.SymBanded
type Circulant = types.Circulant
type Toeplitz = types.Toeplitz

-- An array of n zeros.
local function create(n: number): buffer
	return buffer.create(4 * n)
end

-- The number of elements of x.
local function length(x: buffer): number
	return buffer.len(x) // 4
end

local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

-- A rows by cols matrix of zeros.
local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(4 * rows * cols) }
end

-- An array of n 32-bit integers (pivots and permutations: 4 bytes an entry where a table
-- takes 16), the one given if it has that length.
local function int_array(n: number, old: buffer?): buffer
	if old and buffer.len(old) == 4 * n then
		return old
	end
	return buffer.create(4 * n)
end

-- Triangular matrices

-- Solves T x = b, where T is the upper or lower triangle of A (the other triangle is not
-- read); with unit, the diagonal is taken to be 1 and not read either. In place if out is b.
local function triangular_solve(out: buffer?, A: Matrix, b: buffer, uplo: Uplo, unit: boolean?): buffer
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	assert(uplo == "upper" or uplo == "lower", "uplo must be \"upper\" or \"lower\"")
	assert(buffer.len(b) == 4 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = A.data
	if uplo == "upper" then
		for j = n - 1, 0, -1 do
			local xj = buffer.readf32(o, 4 * j)
			if not unit then
				xj /= buffer.readf32(a, 4 * (j * n + j))
				buffer.writef32(o, 4 * j, xj)
			end
			for i = 0, j - 1 do
				do
					local here_ = 4 * i
					buffer.writef32(o, here_, buffer.readf32(o, here_) - (buffer.readf32(a, 4 * (j * n + i)) * xj))
				end
			end
		end
	else
		for j = 0, n - 1 do
			local xj = buffer.readf32(o, 4 * j)
			if not unit then
				xj /= buffer.readf32(a, 4 * (j * n + j))
				buffer.writef32(o, 4 * j, xj)
			end
			for i = j + 1, n - 1 do
				do
					local here_ = 4 * i
					buffer.writef32(o, here_, buffer.readf32(o, here_) - (buffer.readf32(a, 4 * (j * n + i)) * xj))
				end
			end
		end
	end
	return o
end

-- T x for the upper or lower triangle T of A (as in triangular_solve).
local function triangular_matvec(out: buffer?, A: Matrix, x: buffer, uplo: Uplo, unit: boolean?): buffer
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	assert(uplo == "upper" or uplo == "lower", "uplo must be \"upper\" or \"lower\"")
	assert(buffer.len(x) == 4 * n, "matrix and vector sizes do not match")
	local o = output(out, 4 * n)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, n - 1 do
		local s = if unit then buffer.readf32(x, 4 * i) else 0
		local first, last = if uplo == "upper" then i else 0, if uplo == "upper" then n - 1 else i
		if unit then
			if uplo == "upper" then
				first += 1
			else
				last -= 1
			end
		end
		for j = first, last do
			s += buffer.readf32(a, 4 * (j * n + i)) * buffer.readf32(x, 4 * j)
		end
		buffer.writef32(o, 4 * i, s)
	end
	return o
end

-- Tridiagonal matrices

-- A tridiagonal matrix from its subdiagonal (n-1), diagonal (n) and superdiagonal (n-1).
-- The arrays are used as they are (not copied).
local function tridiagonal(lower: buffer, diag: buffer, upper: buffer): Tridiagonal
	local n = length(diag)
	assert(length(lower) == math.max(n - 1, 0) and length(upper) == math.max(n - 1, 0), "need n-1 off-diagonal entries")
	return { lower = lower, diag = diag, upper = upper }
end

-- A copy of T.
local function tridiag_copy(T: Tridiagonal, into: Tridiagonal?): Tridiagonal
	-- (into: a tridiagonal matrix of the same size to copy into)
	if into and into ~= T and length(into.diag) == length(T.diag) then
		copy(into.lower, T.lower)
		copy(into.diag, T.diag)
		copy(into.upper, T.upper)
		return into
	end
	return { lower = copy(nil, T.lower), diag = copy(nil, T.diag), upper = copy(nil, T.upper) }
end

-- The dense matrix.
local function tridiag_matrix(T: Tridiagonal): Matrix
	local n = length(T.diag)
	local A = matrix(n, n)
	for i = 0, n - 1 do
		buffer.writef32(A.data, 4 * (i * n + i), buffer.readf32(T.diag, 4 * i))
		if i < n - 1 then
			buffer.writef32(A.data, 4 * (i * n + (i + 1)), buffer.readf32(T.lower, 4 * i))
			buffer.writef32(A.data, 4 * ((i + 1) * n + i), buffer.readf32(T.upper, 4 * i))
		end
	end
	return A
end

-- T x
local function tridiag_matvec(out: buffer?, T: Tridiagonal, x: buffer): buffer
	local n = length(T.diag)
	assert(length(x) == n, "matrix and vector sizes do not match")
	local o = output(out, 4 * n)
	assert(o ~= x, "output cannot be the input vector")
	local dl, d, du = T.lower, T.diag, T.upper
	for i = 0, n - 1 do
		local s = buffer.readf32(d, 4 * i) * buffer.readf32(x, 4 * i)
		if i > 0 then
			s += buffer.readf32(dl, 4 * (i - 1)) * buffer.readf32(x, 4 * (i - 1))
		end
		if i < n - 1 then
			s += buffer.readf32(du, 4 * i) * buffer.readf32(x, 4 * (i + 1))
		end
		buffer.writef32(o, 4 * i, s)
	end
	return o
end

-- LU factorization with partial pivoting (LAPACK's gttrf), in place: T's arrays are
-- overwritten with the factors. tridiag_lu_copy leaves T unchanged.
local function tridiag_lu(T: Tridiagonal, reuse: TridiagonalLU?): TridiagonalLU
	local n = length(T.diag)
	local dl, d, du = T.lower, T.diag, T.upper
	local du2 = if reuse and buffer.len(reuse.du2) == 4 * math.max(n - 2, 0) then reuse.du2 else buffer.create(4 * math.max(n - 2, 0))
	local piv = int_array(n, if reuse then reuse.piv else nil)
	for i = 0, n - 2 do
		local di, li = buffer.readf32(d, 4 * i), buffer.readf32(dl, 4 * i)
		if math.abs(di) >= math.abs(li) then
			-- No row interchange.
			buffer.writei32(piv, 4 * ((i + 1) - 1), i + 1)
			if di ~= 0 then
				local fact = li / di
				buffer.writef32(dl, 4 * i, fact)
				buffer.writef32(d, 4 * (i + 1), buffer.readf32(d, 4 * (i + 1)) - fact * buffer.readf32(du, 4 * i))
			end
		else
			-- Interchange rows i and i+1.
			local fact = di / li
			buffer.writef32(d, 4 * i, li)
			buffer.writef32(dl, 4 * i, fact)
			local temp = buffer.readf32(du, 4 * i)
			buffer.writef32(du, 4 * i, buffer.readf32(d, 4 * (i + 1)))
			buffer.writef32(d, 4 * (i + 1), temp - fact * buffer.readf32(d, 4 * (i + 1)))
			if i < n - 2 then
				buffer.writef32(du2, 4 * i, buffer.readf32(du, 4 * (i + 1)))
				buffer.writef32(du, 4 * (i + 1), -fact * buffer.readf32(du, 4 * (i + 1)))
			end
			buffer.writei32(piv, 4 * ((i + 1) - 1), i + 2)
		end
	end
	if n > 0 then
		buffer.writei32(piv, 4 * (n - 1), n)
	end
	local singular = false
	for i = 0, n - 1 do
		if buffer.readf32(d, 4 * i) == 0 then
			singular = true
		end
	end
	local F: TridiagonalLU = reuse or ({} :: any)
	F.lu, F.du2, F.piv, F.singular = T, du2, piv, singular
	return F
end

-- tridiag_lu of a copy of T; T is not modified.
local function tridiag_lu_copy(T: Tridiagonal, reuse: TridiagonalLU?): TridiagonalLU
	return tridiag_lu(tridiag_copy(T, if reuse then reuse.lu else nil), reuse)
end

-- Solves T x = b given F = tridiag_lu(T). In place if out is b.
local function tridiag_lu_solve(out: buffer?, F: TridiagonalLU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local dl, d, du, du2 = F.lu.lower, F.lu.diag, F.lu.upper, F.du2
	local n = length(d)
	assert(length(b) == n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	-- L y = P b
	for i = 0, n - 2 do
		local bi, bn = buffer.readf32(o, 4 * i), buffer.readf32(o, 4 * (i + 1))
		if buffer.readi32(F.piv, 4 * ((i + 1) - 1)) == i + 1 then
			buffer.writef32(o, 4 * (i + 1), bn - buffer.readf32(dl, 4 * i) * bi)
		else
			buffer.writef32(o, 4 * i, bn)
			buffer.writef32(o, 4 * (i + 1), bi - buffer.readf32(dl, 4 * i) * bn)
		end
	end
	-- U x = y
	for i = n - 1, 0, -1 do
		local s = buffer.readf32(o, 4 * i)
		if i < n - 1 then
			s -= buffer.readf32(du, 4 * i) * buffer.readf32(o, 4 * (i + 1))
		end
		if i < n - 2 then
			s -= buffer.readf32(du2, 4 * i) * buffer.readf32(o, 4 * (i + 2))
		end
		buffer.writef32(o, 4 * i, s / buffer.readf32(d, 4 * i))
	end
	return o
end

-- LDL^T factorization of a symmetric positive definite tridiagonal matrix (LAPACK's
-- pttrf), in place: only T.diag and T.lower are read; they are overwritten with D and the
-- subdiagonal of L. definite is false if T is not positive definite (T is then partly
-- overwritten). tridiag_ldl_copy leaves T unchanged.
local function tridiag_ldl(T: Tridiagonal, reuse: TridiagonalLDL?): TridiagonalLDL
	local d, e = T.diag, T.lower
	local n = length(d)
	for i = 0, n - 1 do
		local di = buffer.readf32(d, 4 * i)
		if not (di > 0) then
			local F: TridiagonalLDL = reuse or ({} :: any)
			F.ldl, F.definite = T, false
			return F
		end
		if i < n - 1 then
			local ei = buffer.readf32(e, 4 * i)
			local l = ei / di
			buffer.writef32(e, 4 * i, l)
			do
				local here_ = 4 * (i + 1)
				buffer.writef32(d, here_, buffer.readf32(d, here_) - (l * ei))
			end
		end
	end
	local F: TridiagonalLDL = reuse or ({} :: any)
	F.ldl, F.definite = T, true
	return F
end

-- tridiag_ldl of a copy of T; T is not modified.
local function tridiag_ldl_copy(T: Tridiagonal, reuse: TridiagonalLDL?): TridiagonalLDL
	return tridiag_ldl(tridiag_copy(T, if reuse then reuse.ldl else nil), reuse)
end

-- Solves T x = b given F = tridiag_ldl(T). In place if out is b.
local function tridiag_ldl_solve(out: buffer?, F: TridiagonalLDL, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local d, e = F.ldl.diag, F.ldl.lower
	local n = length(d)
	assert(length(b) == n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	for i = 1, n - 1 do
		do
			local here_ = 4 * i
			buffer.writef32(o, here_, buffer.readf32(o, here_) - (buffer.readf32(o, 4 * (i - 1)) * buffer.readf32(e, 4 * (i - 1))))
		end
	end
	for i = 0, n - 1 do
		do
			local here_ = 4 * i
			buffer.writef32(o, here_, buffer.readf32(o, here_) / buffer.readf32(d, 4 * i))
		end
	end
	for i = n - 2, 0, -1 do
		do
			local here_ = 4 * i
			buffer.writef32(o, here_, buffer.readf32(o, here_) - (buffer.readf32(o, 4 * (i + 1)) * buffer.readf32(e, 4 * i)))
		end
	end
	return o
end

-- Banded matrices

-- A zero n by n banded matrix with kl subdiagonals and ku superdiagonals.
local function banded(n: number, kl: number, ku: number): Banded
	assert(kl >= 0 and ku >= 0, "bandwidths must be nonnegative")
	local ld = 2 * kl + ku + 1
	return { n = n, kl = kl, ku = ku, ld = ld, data = buffer.create(4 * ld * n) }
end

-- A copy of B.
local function band_copy(B: Banded, into: Banded?): Banded
	-- (into: a banded matrix of the same shape to copy into)
	local C = if into and into ~= B and into.n == B.n and into.kl == B.kl and into.ku == B.ku then into else banded(B.n, B.kl, B.ku)
	buffer.copy(C.data, 0, B.data)
	return C
end

local function in_band(B: Banded, i: number, j: number): boolean
	return i - j <= B.kl and j - i <= B.ku and i >= 1 and j >= 1 and i <= B.n and j <= B.n
end

-- Entry (i, j), 1-based; 0 outside the band.
local function band_get(B: Banded, i: number, j: number): number
	if not in_band(B, i, j) then
		return 0
	end
	return buffer.readf32(B.data, 4 * ((j - 1) * B.ld + B.kl + B.ku + (i - 1) - (j - 1)))
end

-- Sets entry (i, j), 1-based, which must lie in the band.
local function band_set(B: Banded, i: number, j: number, v: number)
	assert(in_band(B, i, j), "entry is outside the band")
	buffer.writef32(B.data, 4 * ((j - 1) * B.ld + B.kl + B.ku + (i - 1) - (j - 1)), v)
end

-- The band of the square matrix A (entries outside it are dropped).
local function band_from_matrix(A: Matrix, kl: number, ku: number): Banded
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local B = banded(n, kl, ku)
	for j = 0, n - 1 do
		for i = math.max(0, j - ku), math.min(n - 1, j + kl) do
			buffer.writef32(B.data, 4 * (j * B.ld + B.kl + B.ku + i - j), buffer.readf32(A.data, 4 * (j * n + i)))
		end
	end
	return B
end

-- The dense matrix.
local function band_matrix(B: Banded): Matrix
	local n = B.n
	local A = matrix(n, n)
	for j = 0, n - 1 do
		for i = math.max(0, j - B.ku), math.min(n - 1, j + B.kl) do
			buffer.writef32(A.data, 4 * (j * n + i), buffer.readf32(B.data, 4 * (j * B.ld + B.kl + B.ku + i - j)))
		end
	end
	return A
end

-- B x
local function band_matvec(out: buffer?, B: Banded, x: buffer): buffer
	local ld: number, kv: number, data = B.ld, B.kl + B.ku, B.data
	local n = B.n
	assert(length(x) == n, "matrix and vector sizes do not match")
	local o = output(out, 4 * n)
	assert(o ~= x, "output cannot be the input vector")
	buffer.fill(o, 0, 0)
	for j = 0, n - 1 do
		local xj = buffer.readf32(x, 4 * j)
		local cj: number = 4 * (j * (ld - 1) + kv)
		for i = math.max(0, j - B.ku), math.min(n - 1, j + B.kl) do
			do
				local here_ = 4 * i
				buffer.writef32(o, here_, buffer.readf32(o, here_) + (buffer.readf32(data, cj + (4 * i)) * xj))
			end
		end
	end
	return o
end

-- Symmetric banded matrices (LAPACK's storage for pbtrf, lower): the diagonal and kd
-- subdiagonals of a symmetric n by n matrix. Entry (i, j), i >= j (0-based), is row i - j
-- of column j of `data`, which has kd + 1 rows: under half a Banded's storage (2 kd + 1
-- rows, and kd more for LU's fill-in). band_chol and band_chol_solve take either.
local function symbanded(n: number, kd: number): SymBanded
	assert(kd >= 0, "the bandwidth must be nonnegative")
	return { n = n, kd = kd, data = buffer.create(4 * (kd + 1) * n) }
end

-- A copy of S (into a symmetric banded matrix of the same shape, if given).
local function symband_copy(S: SymBanded, into: SymBanded?): SymBanded
	local C = if into and into ~= S and into.n == S.n and into.kd == S.kd then into else symbanded(S.n, S.kd)
	buffer.copy(C.data, 0, S.data)
	return C
end

-- Entry (i, j), 1-based, in either triangle; 0 outside the band.
local function symband_get(S: SymBanded, i: number, j: number): number
	if i < j then
		i, j = j, i
	end
	if i - j > S.kd or j < 1 or i > S.n then
		return 0
	end
	return buffer.readf32(S.data, 4 * ((j - 1) * S.kd + (i - 1)))
end

-- Sets entries (i, j) and (j, i), 1-based, which must lie in the band.
local function symband_set(S: SymBanded, i: number, j: number, v: number)
	if i < j then
		i, j = j, i
	end
	assert(i - j <= S.kd and j >= 1 and i <= S.n, "entry is outside the band")
	buffer.writef32(S.data, 4 * ((j - 1) * S.kd + (i - 1)), v)
end

-- The band of the symmetric matrix A (its lower triangle is read).
local function symband_from_matrix(A: Matrix, kd: number): SymBanded
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local S = symbanded(n, kd)
	for j = 0, n - 1 do
		for i = j, math.min(n - 1, j + kd) do
			buffer.writef32(S.data, 4 * (j * S.kd + i), buffer.readf32(A.data, 4 * (j * n + i)))
		end
	end
	return S
end

-- The dense symmetric matrix.
local function symband_matrix(S: SymBanded): Matrix
	local n = S.n
	local A = matrix(n, n)
	for j = 0, n - 1 do
		for i = j, math.min(n - 1, j + S.kd) do
			local v = buffer.readf32(S.data, 4 * (j * S.kd + i))
			buffer.writef32(A.data, 4 * (j * n + i), v)
			buffer.writef32(A.data, 4 * (i * n + j), v)
		end
	end
	return A
end

-- S x
local function symband_matvec(out: buffer?, S: SymBanded, x: buffer): buffer
	local n, kd = S.n, S.kd
	assert(length(x) == n, "matrix and vector sizes do not match")
	local o = output(out, 4 * n)
	assert(o ~= x, "output cannot be the input vector")
	buffer.fill(o, 0, 0)
	local a = S.data
	for j = 0, n - 1 do
		local xj = buffer.readf32(x, 4 * j)
		local cj: number = 4 * (j * kd)
		-- column j below the diagonal feeds rows j+1.., and (by symmetry) row j
		local s = buffer.readf32(a, cj + (4 * j)) * xj
		for i = j + 1, math.min(n - 1, j + kd) do
			local aij = buffer.readf32(a, cj + (4 * i))
			do
				local here_ = 4 * i
				buffer.writef32(o, here_, buffer.readf32(o, here_) + (aij * xj))
			end
			s += aij * buffer.readf32(x, 4 * i)
		end
		do
			local here_ = 4 * j
			buffer.writef32(o, here_, buffer.readf32(o, here_) + s)
		end
	end
	return o
end

-- Banded LU with partial pivoting (LAPACK's gbtf2), in place: B is overwritten with the
-- factors, U getting up to kl + ku superdiagonals in B's extra rows. band_lu_copy leaves
-- B unchanged.
local function band_lu(B: Banded, reuse: BandedLU?): BandedLU
	local n, kl, ku = B.n, B.kl, B.ku
	local kv: number = kl + ku
	local a = B.data
	local ld: number = B.ld
	-- Clear the fill-in rows above the original band.
	for j = 0, n - 1 do
		local cj: number = 4 * (j * (ld - 1) + kv)
		for i = math.max(0, j - kv), j - ku - 1 do
			buffer.writef32(a, cj + (4 * i), 0)
		end
	end
	local piv = int_array(n, if reuse then reuse.piv else nil)
	local singular = false
	local ju = 0
	for j = 0, n - 1 do
		local km = math.min(kl, n - 1 - j)
		local cj: number = 4 * (j * (ld - 1) + kv)
		local p, best = j, -1
		for i = j, j + km do
			local v = math.abs(buffer.readf32(a, cj + (4 * i)))
			if v > best then
				p, best = i, v
			end
		end
		buffer.writei32(piv, 4 * ((j + 1) - 1), p + 1)
		local pivot = buffer.readf32(a, cj + (4 * p))
		if pivot ~= 0 then
			ju = math.max(ju, math.min(j + ku + (p - j), n - 1))
			if p ~= j then
				for c = j, ju do
					local cc: number = 4 * (c * (ld - 1) + kv)
					do
						local s_ = cc + (4 * j)
						local t_ = cc + (4 * p)
						local tmp_ = buffer.readf32(a, s_)
						buffer.writef32(a, s_, buffer.readf32(a, t_))
						buffer.writef32(a, t_, tmp_)
					end
				end
			end
			if km > 0 then
				local djj = buffer.readf32(a, cj + (4 * j))
				for i = j + 1, j + km do
					do
						local here_ = cj + (4 * i)
						buffer.writef32(a, here_, buffer.readf32(a, here_) / djj)
					end
				end
				for c = j + 1, ju do
					local cc: number = 4 * (c * (ld - 1) + kv)
					local y = buffer.readf32(a, cc + (4 * j))
					if y ~= 0 then
						for i = j + 1, j + km do
							do
								local here_ = cc + (4 * i)
								buffer.writef32(a, here_, buffer.readf32(a, here_) - (buffer.readf32(a, cj + (4 * i)) * y))
							end
						end
					end
				end
			end
		else
			singular = true
		end
	end
	local F: BandedLU = reuse or ({} :: any)
	F.lu, F.piv, F.singular = B, piv, singular
	return F
end

-- band_lu of a copy of B; B is not modified.
local function band_lu_copy(B: Banded, reuse: BandedLU?): BandedLU
	return band_lu(band_copy(B, if reuse then reuse.lu else nil), reuse)
end

-- Solves B x = b given F = band_lu(B). In place if out is b.
local function band_lu_solve(out: buffer?, F: BandedLU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local B = F.lu
	local n, kl, ku = B.n, B.kl, B.ku
	local kv: number = kl + ku
	assert(length(b) == n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = B.data
	local ld: number = B.ld
	-- L y = P b, applying the interchanges as they happened.
	for j = 0, n - 2 do
		local p = buffer.readi32(F.piv, 4 * ((j + 1) - 1)) - 1
		if p ~= j then
			do
				local s_ = 4 * j
				local t_ = 4 * p
				local tmp_ = buffer.readf32(o, s_)
				buffer.writef32(o, s_, buffer.readf32(o, t_))
				buffer.writef32(o, t_, tmp_)
			end
		end
		local yj = buffer.readf32(o, 4 * j)
		local cj: number = 4 * (j * (ld - 1) + kv)
		for i = j + 1, math.min(n - 1, j + kl) do
			do
				local here_ = 4 * i
				buffer.writef32(o, here_, buffer.readf32(o, here_) - (buffer.readf32(a, cj + (4 * i)) * yj))
			end
		end
	end
	-- U x = y, U with kl + ku superdiagonals.
	for j = n - 1, 0, -1 do
		local cj: number = 4 * (j * (ld - 1) + kv)
		local xj = buffer.readf32(o, 4 * j) / buffer.readf32(a, cj + (4 * j))
		buffer.writef32(o, 4 * j, xj)
		for i = math.max(0, j - kv), j - 1 do
			do
				local here_ = 4 * i
				buffer.writef32(o, here_, buffer.readf32(o, here_) - (buffer.readf32(a, cj + (4 * i)) * xj))
			end
		end
	end
	return o
end

-- Banded Cholesky A = L L^T of a symmetric positive definite matrix (LAPACK's pbtf2,
-- lower), in place: only the diagonal and the kl subdiagonals are read and overwritten
-- with L. definite is false if B is not positive definite (B is then partly overwritten).
-- band_chol_copy leaves B unchanged.
local function band_chol(B: Banded | SymBanded, reuse: BandedCholesky?): BandedCholesky
	local L: any = B
	local sym = L.kd ~= nil
	local n: number, kd: number = L.n, if sym then L.kd else L.kl
	local a = L.data
	-- column j starts at element j * stride + off: symmetric storage has kd + 1 rows from the
	-- diagonal; a Banded's diagonal is row kl + ku of its ld
	local stride: number, off: number = if sym then kd else L.ld - 1, if sym then 0 else L.kl + L.ku
	-- Entry (i, j) is at col(j) + elem(i): the column's base offset is computed once per
	-- column, not per entry (interpreted, that was most of the inner loop).
	for j = 0, n - 1 do
		local cj: number = 4 * (j * stride + off)
		local ajj = buffer.readf32(a, cj + (4 * j))
		if not (ajj > 0) then
			local F: BandedCholesky = reuse or ({} :: any)
			F.chol, F.definite = B, false
			return F
		end
		ajj = math.sqrt(ajj)
		buffer.writef32(a, cj + (4 * j), ajj)
		local kn = math.min(kd, n - 1 - j)
		for i = j + 1, j + kn do
			do
				local here_ = cj + (4 * i)
				buffer.writef32(a, here_, buffer.readf32(a, here_) / ajj)
			end
		end
		-- Trailing lower band -= x x^T, x = column j below the diagonal: entries c..j+kn of
		-- column c, stepping by byte offset o, against the same rows of column j (at o + d).
		for c = j + 1, j + kn do
			local cc: number = 4 * (c * stride + off)
			local xc = buffer.readf32(a, cj + (4 * c))
			local d = cj - cc
			for o = cc + (4 * c), cc + (4 * (j + kn)), (4 * 1) do
				buffer.writef32(a, o, buffer.readf32(a, o) - buffer.readf32(a, o + d) * xc)
			end
		end
	end
	local F: BandedCholesky = reuse or ({} :: any)
	F.chol, F.definite = B, true
	return F
end

-- band_chol of a copy of B; B is not modified.
local function band_chol_copy(B: Banded | SymBanded, reuse: BandedCholesky?): BandedCholesky
	local into: any = if reuse then reuse.chol else nil
	if (B :: any).kd ~= nil then
		return band_chol(symband_copy(B :: any, into), reuse)
	end
	return band_chol(band_copy(B :: any, into), reuse)
end

-- Solves B x = b given F = band_chol(B). In place if out is b.
local function band_chol_solve(out: buffer?, F: BandedCholesky, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local L: any = F.chol
	local sym = L.kd ~= nil
	local n: number, kd: number = L.n, if sym then L.kd else L.kl
	assert(length(b) == n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = L.data
	local stride: number, off: number = if sym then kd else L.ld - 1, if sym then 0 else L.kl + L.ku
	-- L y = b
	for j = 0, n - 1 do
		local cj: number = 4 * (j * stride + off)
		local yj = buffer.readf32(o, 4 * j) / buffer.readf32(a, cj + (4 * j))
		buffer.writef32(o, 4 * j, yj)
		for i = j + 1, math.min(n - 1, j + kd) do
			do
				local here_ = 4 * i
				buffer.writef32(o, here_, buffer.readf32(o, here_) - (buffer.readf32(a, cj + (4 * i)) * yj))
			end
		end
	end
	-- L^T x = y
	for j = n - 1, 0, -1 do
		local cj: number = 4 * (j * stride + off)
		local s = buffer.readf32(o, 4 * j)
		for i = j + 1, math.min(n - 1, j + kd) do
			s -= buffer.readf32(a, cj + (4 * i)) * buffer.readf32(o, 4 * i)
		end
		buffer.writef32(o, 4 * j, s / buffer.readf32(a, cj + (4 * j)))
	end
	return o
end

-- Circulant and Toeplitz matrices

-- The circulant matrix with first column c (its eigenvalues are computed now).
local function circulant(c: buffer): Circulant
	return { n = length(c), eig = rfft(nil, c) }
end

-- C x, by FFT.
local function circulant_matvec(out: buffer?, C: Circulant, x: buffer): buffer
	assert(length(x) == C.n, "matrix and vector sizes do not match")
	local X = rfft(nil, x)
	complexmod.mul(X, X, C.eig)
	return irfft(out, X, C.n)
end

-- Solves C x = b, by FFT. In place if out is b.
local function circulant_solve(out: buffer?, C: Circulant, b: buffer): buffer
	assert(length(b) == C.n, "matrix and vector sizes do not match")
	local X = rfft(nil, b)
	local eig = C.eig
	for k = 0, buffer.len(X) - CE, CE do
		local er, ei = buffer.readf32(eig, k), buffer.readf32(eig, k + 4) :: number
		assert(er ~= 0 or ei ~= 0, "circulant matrix is singular")
		local qr, qi = complex64.div(buffer.readf32(X, k), buffer.readf32(X, k + 4), er, ei)
		buffer.writef32(X, k, qr)
		buffer.writef32(X, k + 4, qi)
	end
	return irfft(out, X, C.n)
end

-- The dense matrix.
local function circulant_matrix(c: buffer): Matrix
	local n = length(c)
	local A = matrix(n, n)
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			buffer.writef32(A.data, 4 * (j * n + i), buffer.readf32(c, 4 * ((i - j) % n)))
		end
	end
	return A
end

-- The Toeplitz matrix with first column col and first row row (default: col, which makes
-- it symmetric). row[1] is ignored, as in SciPy. Both arrays are copied.
local function toeplitz(col: buffer, row: buffer?): Toeplitz
	local n = length(col)
	local r = row or col
	assert(length(r) == n, "first row and first column have different lengths")
	local M = 1
	while M < 2 * n - 1 do
		M *= 2
	end
	-- A circulant of size M whose leading n by n block is T.
	local e = create(M)
	for k = 0, n - 1 do
		buffer.writef32(e, 4 * k, buffer.readf32(col, 4 * k))
		if k > 0 then
			buffer.writef32(e, 4 * (M - k), buffer.readf32(r, 4 * k))
		end
	end
	return { n = n, col = copy(nil, col), row = copy(nil, r), embed = circulant(e) }
end

-- The dense matrix.
local function toeplitz_matrix(T: Toeplitz): Matrix
	local n = T.n
	local A = matrix(n, n)
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local v = if i >= j then buffer.readf32(T.col, 4 * (i - j)) else buffer.readf32(T.row, 4 * (j - i))
			buffer.writef32(A.data, 4 * (j * n + i), v)
		end
	end
	return A
end

-- T x, by FFT through the circulant embedding.
local function toeplitz_matvec(out: buffer?, T: Toeplitz, x: buffer): buffer
	local n = T.n
	assert(length(x) == n, "matrix and vector sizes do not match")
	local o = output(out, 4 * n)
	if n == 0 then
		return o
	end
	local padded = create(T.embed.n)
	buffer.copy(padded, 0, x, 0, 4 * n)
	local y = circulant_matvec(nil, T.embed, padded)
	buffer.copy(o, 0, y, 0, 4 * n)
	return o
end

-- Solves T x = b by Levinson's recursion, O(n^2) in double precision. It needs every
-- leading principal submatrix of T to be nonsingular (it raises an error otherwise) and is
-- reliable for well-conditioned, especially symmetric positive definite, matrices; for
-- other Toeplitz systems use solve on toeplitz_matrix(T). In place if out is b.
local function toeplitz_solve(out: buffer?, T: Toeplitz, b: buffer): buffer
	local n = T.n
	assert(length(b) == n, "matrix and vector sizes do not match")
	local bt = totable(b)
	local o = output(out, 4 * n)
	if n == 0 then
		return o
	end
	local col, row = totable(T.col), totable(T.row)
	local function t(k: number): number
		return if k >= 0 then col[k + 1] else row[1 - k]
	end
	local t0 = col[1]
	assert(t0 ~= 0, "toeplitz_solve: a leading principal submatrix is singular")
	-- f and g solve T_m f = e_1 and T_m g = e_m; x solves T_m x = b[1..m].
	local f, g, x = { 1 / t0 }, { 1 / t0 }, { bt[1] / t0 }
	for m = 1, n - 1 do
		local ef, eg, ex = 0, 0, 0
		for j = 1, m do
			local tj = t(m + 1 - j)
			ef += tj * f[j]
			ex += tj * x[j]
			eg += t(-j) * g[j]
		end
		local den = 1 - ef * eg
		assert(den ~= 0, "toeplitz_solve: a leading principal submatrix is singular")
		local fn, gn = table.create(m + 1, 0), table.create(m + 1, 0)
		for j = 1, m + 1 do
			local fj = if j <= m then f[j] else 0
			local gj = if j >= 2 then g[j - 1] else 0
			fn[j] = (fj - ef * gj) / den
			gn[j] = (gj - eg * fj) / den
		end
		f, g = fn, gn
		x[m + 1] = 0
		local c = bt[m + 1] - ex
		for j = 1, m + 1 do
			x[j] += c * g[j]
		end
	end
	for j = 1, n do
		buffer.writef32(o, 4 * (j - 1), x[j])
	end
	return o
end

return {
	band_chol = band_chol,
	band_chol_copy = band_chol_copy,
	band_chol_solve = band_chol_solve,
	symbanded = symbanded,
	symband_copy = symband_copy,
	symband_get = symband_get,
	symband_set = symband_set,
	symband_from_matrix = symband_from_matrix,
	symband_matrix = symband_matrix,
	symband_matvec = symband_matvec,
	band_copy = band_copy,
	band_from_matrix = band_from_matrix,
	band_get = band_get,
	band_lu = band_lu,
	band_lu_copy = band_lu_copy,
	band_lu_solve = band_lu_solve,
	band_matrix = band_matrix,
	band_matvec = band_matvec,
	band_set = band_set,
	banded = banded,
	circulant = circulant,
	circulant_matrix = circulant_matrix,
	circulant_matvec = circulant_matvec,
	circulant_solve = circulant_solve,
	toeplitz = toeplitz,
	toeplitz_matrix = toeplitz_matrix,
	toeplitz_matvec = toeplitz_matvec,
	toeplitz_solve = toeplitz_solve,
	triangular_matvec = triangular_matvec,
	triangular_solve = triangular_solve,
	tridiag_copy = tridiag_copy,
	tridiag_ldl = tridiag_ldl,
	tridiag_ldl_copy = tridiag_ldl_copy,
	tridiag_ldl_solve = tridiag_ldl_solve,
	tridiag_lu = tridiag_lu,
	tridiag_lu_copy = tridiag_lu_copy,
	tridiag_lu_solve = tridiag_lu_solve,
	tridiag_matrix = tridiag_matrix,
	tridiag_matvec = tridiag_matvec,
	tridiagonal = tridiagonal,
}
