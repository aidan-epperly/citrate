--!strict
--!native
--!optimize 2
-- Generated by tools/generate.py from templates/xpbd/xpbd.luau.in. Edit the template, not this file.

-- The XPBD solver's core for points stored as f64 buffers (see xpbd.luau, which chooses the
-- storage by the caller's representation, for what it computes). Positions, velocities and
-- the positions at the start of a substep are kept in this storage; the constraints are
-- packed into a buffer of doubles, so the sweep reads no tables.

-- Storage. A point's slot: its byte offset in a buffer, or its index in a table of vectors.
local function create3(n: number): buffer
	return buffer.create(3 * 8 * n)
end
local function copy3(dst: buffer, src: buffer, _n: number)
	buffer.copy(dst, 0, src)
end

-- Constraint records in a buffer of doubles, STRIDE per constraint: kind, the particles a
-- and b, three parameters (a distance constraint's length; an offset's d), compliance and
-- damping.
local STRIDE = 8
local DISTANCE, OFFSET = 1, 2
-- Collider kinds.
local SPHERE, CAPSULE, PLANE = 1, 2, 3

export type Collider = { kind: number, a: vector, b: vector, radius: number }

local function new(positions: buffer, n: number, options: any): any
	local o = options or {}
	local X = create3(n)
	copy3(X, positions, n)
	local P = create3(n)
	copy3(P, X, n)
	local V = create3(n)
	-- inverse masses and collision radii, one double per particle
	local W, radius = buffer.create(8 * n), buffer.create(8 * n)
	for i = 1, n do
		local m = if type(o.mass) == "table" then o.mass[i] else o.mass or 1
		assert(m > 0, "xpbd.new: masses must be positive")
		buffer.writef64(W, 8 * (i - 1), 1 / m)
		buffer.writef64(radius, 8 * (i - 1), if type(o.radius) == "table" then o.radius[i] else o.radius or 0)
	end
	local records: { number } = {}
	local packed = buffer.create(0)
	local count = 0
	local dirty = false
	local world: any = {
		n = n,
		x = X,
		v = V,
		gravity = o.gravity or vector.zero,
		drag = o.drag or 0,
		wind = o.wind or vector.zero,
		friction = o.friction or 0,
		colliders = {} :: { Collider },
		t = 0,
		stats = { steps = 0, substeps = 0 },
	}
	local kinematic: { number } = {}
	local kstart: { [number]: vector } = {}
	local ktarget: { [number]: vector } = {}

	local function add(kind: number, a: number, b: number, p1: number, p2: number, p3: number, alpha: number, beta: number)
		assert(a >= 1 and a <= n and b >= 1 and b <= n and a ~= b, "xpbd: constraint particles out of range")
		for _, v in { kind, a, b, p1, p2, p3, alpha, beta } do
			table.insert(records, v)
		end
		count += 1
		dirty = true
	end

	function world.distance(self: any, a: number, b: number, compliance: number, damping: number?, length: number?)
		local ax, ay, az = buffer.readf64(X, 3 * 8 * (a - 1)), buffer.readf64(X, (3 * 8 * (a - 1)) + 8), buffer.readf64(X, (3 * 8 * (a - 1)) + 2 * 8) :: number
		local bx, by, bz = buffer.readf64(X, 3 * 8 * (b - 1)), buffer.readf64(X, (3 * 8 * (b - 1)) + 8), buffer.readf64(X, (3 * 8 * (b - 1)) + 2 * 8) :: number
		local len = length or math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2 + (bz - az) ^ 2)
		add(DISTANCE, a, b, len, 0, 0, compliance, damping or 0)
	end

	function world.offset(self: any, a: number, b: number, d: vector, compliance: number, damping: number?)
		add(OFFSET, a, b, d.x, d.y, d.z, compliance, damping or 0)
	end

	function world.pin(self: any, i: number)
		buffer.writef64(W, 8 * (i - 1), 0)
		table.insert(kinematic, i)
		local px, py, pz = buffer.readf64(X, 3 * 8 * (i - 1)), buffer.readf64(X, (3 * 8 * (i - 1)) + 8), buffer.readf64(X, (3 * 8 * (i - 1)) + 2 * 8) :: number
		ktarget[i] = vector.create(px, py, pz)
	end

	function world.move(self: any, i: number, p: vector)
		ktarget[i] = p
	end

	function world.position(self: any, i: number): vector
		local px, py, pz = buffer.readf64(X, 3 * 8 * (i - 1)), buffer.readf64(X, (3 * 8 * (i - 1)) + 8), buffer.readf64(X, (3 * 8 * (i - 1)) + 2 * 8) :: number
		return vector.create(px, py, pz)
	end

	function world.velocity(self: any, i: number): vector
		local px, py, pz = buffer.readf64(V, 3 * 8 * (i - 1)), buffer.readf64(V, (3 * 8 * (i - 1)) + 8), buffer.readf64(V, (3 * 8 * (i - 1)) + 2 * 8) :: number
		return vector.create(px, py, pz)
	end

	function world.sphere(self: any, center: vector, r: number): Collider
		local c = { kind = SPHERE, a = center, b = center, radius = r }
		table.insert(self.colliders, c)
		return c
	end

	function world.capsule(self: any, a: vector, b: vector, r: number): Collider
		local c = { kind = CAPSULE, a = a, b = b, radius = r }
		table.insert(self.colliders, c)
		return c
	end

	function world.plane(self: any, point: vector, normal: vector): Collider
		local c = { kind = PLANE, a = point, b = vector.normalize(normal), radius = 0 }
		table.insert(self.colliders, c)
		return c
	end

	-- Pushes particle i (slot s, radius r) out of the colliders; friction removes that
	-- fraction of its motion along the surface during the substep.
	local function collide(s: number, r: number)
		local x, y, z = buffer.readf64(X, s), buffer.readf64(X, s + 8), buffer.readf64(X, s + 2 * 8) :: number
		local touched = false
		local nx, ny, nz = 0, 0, 0
		for _, c in world.colliders do
			local qx, qy, qz, R
			if c.kind == PLANE then
				local d = (x - c.a.x) * c.b.x + (y - c.a.y) * c.b.y + (z - c.a.z) * c.b.z - r
				if d < 0 then
					x, y, z = x - d * c.b.x, y - d * c.b.y, z - d * c.b.z
					touched, nx, ny, nz = true, c.b.x, c.b.y, c.b.z
				end
				continue
			elseif c.kind == SPHERE then
				qx, qy, qz, R = c.a.x, c.a.y, c.a.z, c.radius
			else
				-- the closest point of the segment
				local ex, ey, ez = c.b.x - c.a.x, c.b.y - c.a.y, c.b.z - c.a.z
				local ee = ex * ex + ey * ey + ez * ez
				local u = if ee > 0 then math.clamp(((x - c.a.x) * ex + (y - c.a.y) * ey + (z - c.a.z) * ez) / ee, 0, 1) else 0
				qx, qy, qz, R = c.a.x + u * ex, c.a.y + u * ey, c.a.z + u * ez, c.radius
			end
			local dx, dy, dz = x - qx, y - qy, z - qz
			local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
			local reach = R + r
			if dist < reach and dist > 0 then
				local k = reach / dist
				x, y, z = qx + dx * k, qy + dy * k, qz + dz * k
				touched, nx, ny, nz = true, dx / dist, dy / dist, dz / dist
			end
		end
		if touched and world.friction > 0 then
			local px, py, pz = buffer.readf64(P, s), buffer.readf64(P, s + 8), buffer.readf64(P, s + 2 * 8) :: number
			local mx, my, mz = x - px, y - py, z - pz
			local mn = mx * nx + my * ny + mz * nz
			local f = world.friction
			x, y, z = x - f * (mx - mn * nx), y - f * (my - mn * ny), z - f * (mz - mn * nz)
		end
		if touched then
			buffer.writef64(X, s, x)
			buffer.writef64(X, s + 8, y)
			buffer.writef64(X, s + 2 * 8, z)
		end
	end

	function world.step(self: any, dt: number, substeps: number?)
		local steps = substeps or 1
		local h = dt / steps
		if dirty then
			packed = buffer.create(8 * #records)
			for k, v in records do
				buffer.writef64(packed, 8 * (k - 1), v)
			end
			dirty = false
		end
		local C = packed
		local gx, gy, gz = self.gravity.x * h, self.gravity.y * h, self.gravity.z * h
		local wx, wy, wz = self.wind.x, self.wind.y, self.wind.z
		local keep = math.exp(-self.drag * h)
		local hasc = #self.colliders > 0
		for _, i in kinematic do
			kstart[i] = self:position(i)
		end
		for s = 1, steps do
			copy3(P, X, n)
			-- predict: drag toward the wind's velocity, then gravity whole (so that at rest a
			-- constraint holds exactly m g)
			for i = 1, n do
				if buffer.readf64(W, 8 * (i - 1)) > 0 then
					local o = 3 * 8 * (i - 1)
					local vx, vy, vz = buffer.readf64(V, o), buffer.readf64(V, o + 8), buffer.readf64(V, o + 2 * 8) :: number
					vx, vy, vz = wx + (vx - wx) * keep + gx, wy + (vy - wy) * keep + gy, wz + (vz - wz) * keep + gz
					buffer.writef64(V, o, vx)
					buffer.writef64(V, o + 8, vy)
					buffer.writef64(V, o + 2 * 8, vz)
					local x, y, z = buffer.readf64(X, o), buffer.readf64(X, o + 8), buffer.readf64(X, o + 2 * 8) :: number
					buffer.writef64(X, o, x + h * vx)
					buffer.writef64(X, o + 8, y + h * vy)
					buffer.writef64(X, o + 2 * 8, z + h * vz)
				end
			end
			for _, i in kinematic do
				local u = s / steps
				local a, b = kstart[i], ktarget[i]
				local p = a + (b - a) * u
				do
					local here_ = 3 * 8 * (i - 1)
					buffer.writef64(X, here_, p.x)
					buffer.writef64(X, here_ + 8, p.y)
					buffer.writef64(X, here_ + 2 * 8, p.z)
				end
			end
			-- one Gauss-Seidel sweep over the constraints
			for k = 0, count - 1 do
				local base = 8 * STRIDE * k
				local kind = buffer.readf64(C, base)
				local a, b = buffer.readf64(C, base + 8), buffer.readf64(C, base + 16)
				local wa, wb = buffer.readf64(W, 8 * (a - 1)), buffer.readf64(W, 8 * (b - 1))
				local wsum = wa + wb
				if wsum == 0 then
					continue
				end
				local alpha, beta = buffer.readf64(C, base + 48), buffer.readf64(C, base + 56)
				local at = alpha / (h * h)
				local gamma = alpha * beta / h
				local oa, ob = 3 * 8 * (a - 1), 3 * 8 * (b - 1)
				local ax, ay, az = buffer.readf64(X, oa), buffer.readf64(X, oa + 8), buffer.readf64(X, oa + 2 * 8) :: number
				local bx, by, bz = buffer.readf64(X, ob), buffer.readf64(X, ob + 8), buffer.readf64(X, ob + 2 * 8) :: number
				-- the relative displacement since the substep began, for the damping term (not
				-- needed without damping, as for rigid rods)
				local rx, ry, rz = 0, 0, 0
				if gamma ~= 0 then
					local pax, pay, paz = buffer.readf64(P, oa), buffer.readf64(P, oa + 8), buffer.readf64(P, oa + 2 * 8) :: number
					local pbx, pby, pbz = buffer.readf64(P, ob), buffer.readf64(P, ob + 8), buffer.readf64(P, ob + 2 * 8) :: number
					rx = (bx - pbx) - (ax - pax)
					ry = (by - pby) - (ay - pay)
					rz = (bz - pbz) - (az - paz)
				end
				if kind == DISTANCE then
					local ex, ey, ez = bx - ax, by - ay, bz - az
					local len = math.sqrt(ex * ex + ey * ey + ez * ez)
					if len > 0 then
						local ux, uy, uz = ex / len, ey / len, ez / len
						local Cv = len - buffer.readf64(C, base + 24)
						local rate = ux * rx + uy * ry + uz * rz
						local dl = (-Cv - gamma * rate) / ((1 + gamma) * wsum + at)
						ax, ay, az = ax - wa * dl * ux, ay - wa * dl * uy, az - wa * dl * uz
						bx, by, bz = bx + wb * dl * ux, by + wb * dl * uy, bz + wb * dl * uz
					end
				else
					local den = (1 + gamma) * wsum + at
					local lx = (-(bx - ax - buffer.readf64(C, base + 24)) - gamma * rx) / den
					local ly = (-(by - ay - buffer.readf64(C, base + 32)) - gamma * ry) / den
					local lz = (-(bz - az - buffer.readf64(C, base + 40)) - gamma * rz) / den
					ax, ay, az = ax - wa * lx, ay - wa * ly, az - wa * lz
					bx, by, bz = bx + wb * lx, by + wb * ly, bz + wb * lz
				end
				buffer.writef64(X, oa, ax)
				buffer.writef64(X, oa + 8, ay)
				buffer.writef64(X, oa + 2 * 8, az)
				buffer.writef64(X, ob, bx)
				buffer.writef64(X, ob + 8, by)
				buffer.writef64(X, ob + 2 * 8, bz)
			end
			if hasc then
				for i = 1, n do
					if buffer.readf64(W, 8 * (i - 1)) > 0 then
						collide(3 * 8 * (i - 1), buffer.readf64(radius, 8 * (i - 1)))
					end
				end
			end
			-- velocities from the change in position
			for i = 1, n do
				local o = 3 * 8 * (i - 1)
				local x, y, z = buffer.readf64(X, o), buffer.readf64(X, o + 8), buffer.readf64(X, o + 2 * 8) :: number
				local px, py, pz = buffer.readf64(P, o), buffer.readf64(P, o + 8), buffer.readf64(P, o + 2 * 8) :: number
				buffer.writef64(V, o, (x - px) / h)
				buffer.writef64(V, o + 8, (y - py) / h)
				buffer.writef64(V, o + 2 * 8, (z - pz) / h)
			end
		end
		self.t += dt
		self.stats.steps += 1
		self.stats.substeps += steps
	end

	return world
end

return {
	new = new,
}
