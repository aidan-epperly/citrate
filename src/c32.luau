-- Arrays

local function create(n: number): buffer
	return buffer.create(8 * n)
end

local function length(x: buffer): number
	return buffer.len(x) // 8
end

local function similar(x: buffer): buffer
	return buffer.create(buffer.len(x))
end

local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

local function check_same(x: buffer, y: buffer)
	assert(buffer.len(x) == buffer.len(y), "arrays have different lengths")
end

local function from(re: { number }, im: { number }?): buffer
	local n = #re
	assert(im == nil or #im == n, "real and imaginary parts have different lengths")
	local x = buffer.create(8 * n)
	for i = 1, n do
		local k = 8 * (i - 1)
		buffer.writef32(x, k, re[i])
		if im then
			buffer.writef32(x, k + 4, im[i])
		end
	end
	return x
end

-- Returns the real and imaginary parts as two tables.
local function totable(x: buffer): ({ number }, { number })
	local n = length(x)
	local re, im = table.create(n, 0), table.create(n, 0)
	for i = 1, n do
		local k = 8 * (i - 1)
		re[i] = buffer.readf32(x, k)
		im[i] = buffer.readf32(x, k + 4)
	end
	return re, im
end

local function copy(out: buffer?, x: buffer): buffer
	local o = output(out, buffer.len(x))
	if o ~= x then
		buffer.copy(o, 0, x)
	end
	return o
end

local function fill_pair(out: buffer, re: number, im: number): buffer
	for k = 0, buffer.len(out) - 8, 8 do
		buffer.writef32(out, k, re)
		buffer.writef32(out, k + 4, im)
	end
	return out
end

-- Builds a complex array from real arrays of the same precision.
local function complexify(re: buffer, im: buffer?): buffer
	assert(im == nil or buffer.len(im) == buffer.len(re), "parts have different lengths")
	local n = buffer.len(re) // 4
	local x = buffer.create(8 * n)
	for i = 0, n - 1 do
		buffer.writef32(x, 8 * i, buffer.readf32(re, 4 * i))
		if im then
			buffer.writef32(x, 8 * i + 4, buffer.readf32(im, 4 * i))
		end
	end
	return x
end

local function real(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, 4 * n)
	for i = 0, n - 1 do
		buffer.writef32(o, 4 * i, buffer.readf32(x, 8 * i))
	end
	return o
end

local function imag(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, 4 * n)
	for i = 0, n - 1 do
		buffer.writef32(o, 4 * i, buffer.readf32(x, 8 * i + 4))
	end
	return o
end

-- Elementwise modulus, as a real array.
local function abs(out: buffer?, x: buffer): buffer
	local n = length(x)
	local o = output(out, 4 * n)
	for i = 0, n - 1 do
		buffer.writef32(o, 4 * i, complex64.abs(buffer.readf32(x, 8 * i), buffer.readf32(x, 8 * i + 4)))
	end
	return o
end

local function conj(out: buffer?, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef32(o, k, buffer.readf32(x, k))
		buffer.writef32(o, k + 4, -buffer.readf32(x, k + 4))
	end
	return o
end

-- Addition, subtraction and real scaling act on the real and imaginary parts alike.
local function add(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(o, k, buffer.readf32(x, k) + buffer.readf32(y, k))
	end
	return o
end

local function sub(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(o, k, buffer.readf32(x, k) - buffer.readf32(y, k))
	end
	return o
end

local function scale(out: buffer?, a: number, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(o, k, a * buffer.readf32(x, k))
	end
	return o
end

-- a * x + y with a real
local function axpy(out: buffer?, a: number, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(o, k, a * buffer.readf32(x, k) + buffer.readf32(y, k))
	end
	return o
end

-- Elementwise (Hadamard) product.
local function mul(out: buffer?, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		local xr, xi = buffer.readf32(x, k), buffer.readf32(x, k + 4)
		local yr, yi = buffer.readf32(y, k), buffer.readf32(y, k + 4)
		buffer.writef32(o, k, xr * yr - xi * yi)
		buffer.writef32(o, k + 4, xr * yi + xi * yr)
	end
	return o
end

local function cscale_pair(out: buffer?, ar: number, ai: number, x: buffer): buffer
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		local xr, xi = buffer.readf32(x, k), buffer.readf32(x, k + 4)
		buffer.writef32(o, k, ar * xr - ai * xi)
		buffer.writef32(o, k + 4, ar * xi + ai * xr)
	end
	return o
end

local function caxpy_pair(out: buffer?, ar: number, ai: number, x: buffer, y: buffer): buffer
	check_same(x, y)
	local o = output(out, buffer.len(x))
	for k = 0, buffer.len(x) - 8, 8 do
		local xr, xi = buffer.readf32(x, k), buffer.readf32(x, k + 4)
		buffer.writef32(o, k, ar * xr - ai * xi + buffer.readf32(y, k))
		buffer.writef32(o, k + 4, ar * xi + ai * xr + buffer.readf32(y, k + 4))
	end
	return o
end

-- sum x_i y_i (no conjugation)
local function dotu_pair(x: buffer, y: buffer): (number, number)
	check_same(x, y)
	local sr, si = 0, 0
	for k = 0, buffer.len(x) - 8, 8 do
		local xr, xi = buffer.readf32(x, k), buffer.readf32(x, k + 4)
		local yr, yi = buffer.readf32(y, k), buffer.readf32(y, k + 4)
		sr += xr * yr - xi * yi
		si += xr * yi + xi * yr
	end
	return sr, si
end

-- Re(sum conj(x_i) y_i): the real inner product of the underlying real vector space
-- (the dot product of the 2n real components).
local function realdot(x: buffer, y: buffer): number
	check_same(x, y)
	local s = 0
	for k = 0, buffer.len(x) - 4, 4 do
		s += buffer.readf32(x, k) * buffer.readf32(y, k)
	end
	return s
end

-- sum conj(x_i) y_i
local function dotc_pair(x: buffer, y: buffer): (number, number)
	check_same(x, y)
	local sr, si = 0, 0
	for k = 0, buffer.len(x) - 8, 8 do
		local xr, xi = buffer.readf32(x, k), buffer.readf32(x, k + 4)
		local yr, yi = buffer.readf32(y, k), buffer.readf32(y, k + 4)
		sr += xr * yr + xi * yi
		si += xr * yi - xi * yr
	end
	return sr, si
end

local function sum_pair(x: buffer): (number, number)
	local sr, si = 0, 0
	for k = 0, buffer.len(x) - 8, 8 do
		sr += buffer.readf32(x, k)
		si += buffer.readf32(x, k + 4)
	end
	return sr, si
end

-- Largest modulus (NaN if any element is NaN, 0 for an empty array).
local function amax(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - 8, 8 do
		local a = complex64.abs(buffer.readf32(x, k), buffer.readf32(x, k + 4))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	return m
end

-- Euclidean norm of `count` consecutive reals starting at byte offset `start`. The plain
-- sum of squares is used unless it overflowed or may have lost digits to underflow; then
-- the values are rescaled by the largest magnitude. NaN if any value is NaN.
local function segment_norm(x: buffer, start: number, count: number): number
	local stop = start + 4 * (count - 1)
	local s = 0
	for k = start, stop, 4 do
		local v = buffer.readf32(x, k)
		s += v * v
	end
	if s > 2 ^ -500 and s < math.huge then
		return math.sqrt(s)
	end
	local m = 0
	for k = start, stop, 4 do
		local a = math.abs(buffer.readf32(x, k))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	if m == 0 or m == math.huge then
		return m
	end
	s = 0
	for k = start, stop, 4 do
		local v = buffer.readf32(x, k) / m
		s += v * v
	end
	return m * math.sqrt(s)
end

-- True if any of `count` consecutive reals starting at byte offset `start` is NaN or
-- infinite (v - v is NaN exactly for those).
local function any_nonfinite(x: buffer, start: number, count: number): boolean
	for k = start, start + 4 * (count - 1), 4 do
		local v = buffer.readf32(x, k)
		if v - v ~= 0 then
			return true
		end
	end
	return false
end

-- Sets `count` consecutive reals starting at byte offset `start` to NaN.
local function fill_nan(x: buffer, start: number, count: number)
	for k = start, start + 4 * (count - 1), 4 do
		buffer.writef32(x, k, 0 / 0)
	end
end

-- range_factor(m) is 1 if m is in [2^-459, 2^459] (LAPACK's smlnum and bignum for
-- doubles), and otherwise the power of 2 that brings m near 1. range_scale(x) scales x in
-- place by range_factor of its largest |value| and returns that factor. The eigen and SVD
-- drivers scale this way, as LAPACK's do, so their iterations neither underflow nor
-- overflow and their absolute thresholds (such as trevc's smlnum) stay negligible. Scaling
-- by a power of 2 is exact unless an entry lands in the subnormal range. Stored f32 values
-- are never outside the range.
local function range_factor(m: number): number
	if m == 0 or m == math.huge or m ~= m or (m >= 2 ^ -459 and m <= 2 ^ 459) then
		return 1
	end
	local _, e = math.frexp(m)
	return 2 ^ -e
end

local function range_scale(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - 4, 4 do
		local a = math.abs(buffer.readf32(x, k))
		if a > m then
			m = a
		end
	end
	local f = range_factor(m)
	if f == 1 then
		return 1
	end
	for k = 0, buffer.len(x) - 4, 4 do
		buffer.writef32(x, k, buffer.readf32(x, k) * f)
	end
	return f
end

-- sqrt(a^2 + b^2 + c^2) without overflow or underflow.
local function hypot3(a: number, b: number, c: number): number
	a, b, c = math.abs(a), math.abs(b), math.abs(c)
	local m = math.max(a, b, c)
	if m == 0 or m == math.huge or m ~= m then
		return m
	end
	a, b, c = a / m, b / m, c / m
	return m * math.sqrt(a * a + b * b + c * c)
end

-- Euclidean norm (of the 2n real components), without overflow or underflow.
local function norm(x: buffer): number
	return segment_norm(x, 0, 2 * length(x))
end

-- Matrices

local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(8 * rows * cols) }
end

local function matoutput(out: Matrix?, rows: number, cols: number): Matrix
	if out == nil then
		return matrix(rows, cols)
	end
	assert(out.rows == rows and out.cols == cols, "output has the wrong shape")
	return out
end

-- Builds a matrix from tables of rows of the real and (optional) imaginary parts.
local function matfrom(re: { { number } }, im: { { number } }?): Matrix
	local rows = #re
	local cols = if rows > 0 then #re[1] else 0
	assert(im == nil or #im == rows, "real and imaginary parts have different shapes")
	local A = matrix(rows, cols)
	for i = 1, rows do
		local row = re[i]
		assert(#row == cols, "rows have different lengths")
		local irow = if im then im[i] else nil
		assert(irow == nil or #irow == cols, "real and imaginary parts have different shapes")
		for j = 1, cols do
			local k = 8 * ((j - 1) * rows + i - 1)
			buffer.writef32(A.data, k, row[j])
			if irow then
				buffer.writef32(A.data, k + 4, irow[j])
			end
		end
	end
	return A
end

-- Returns tables of rows of the real and imaginary parts.
local function mattotable(A: Matrix): ({ { number } }, { { number } })
	local re, im = table.create(A.rows) :: { { number } }, table.create(A.rows) :: { { number } }
	for i = 1, A.rows do
		local rrow, irow = table.create(A.cols, 0), table.create(A.cols, 0)
		for j = 1, A.cols do
			local k = 8 * ((j - 1) * A.rows + i - 1)
			rrow[j] = buffer.readf32(A.data, k)
			irow[j] = buffer.readf32(A.data, k + 4)
		end
		re[i], im[i] = rrow, irow
	end
	return re, im
end

local function identity(n: number): Matrix
	local A = matrix(n, n)
	for i = 0, n - 1 do
		buffer.writef32(A.data, 8 * (i * n + i), 1)
	end
	return A
end

local function matcopy(out: Matrix?, A: Matrix): Matrix
	local o = matoutput(out, A.rows, A.cols)
	if o.data ~= A.data then
		buffer.copy(o.data, 0, A.data)
	end
	return o
end

local function transpose_impl(out: Matrix?, A: Matrix, sign: number): Matrix
	local m, n = A.rows, A.cols
	local o = matoutput(out, n, m)
	assert(o.data ~= A.data, "transpose cannot be done in place")
	local a, d = A.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local s, t = 8 * (j * m + i), 8 * (i * n + j)
			buffer.writef32(d, t, buffer.readf32(a, s))
			buffer.writef32(d, t + 4, sign * buffer.readf32(a, s + 4))
		end
	end
	return o
end

local function transpose(out: Matrix?, A: Matrix): Matrix
	return transpose_impl(out, A, 1)
end

-- Conjugate transpose.
local function adjoint(out: Matrix?, A: Matrix): Matrix
	return transpose_impl(out, A, -1)
end

-- A x
local function matvec(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(buffer.len(x) == 8 * n, "matrix and vector sizes do not match")
	local o = output(out, 8 * m)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, m - 1 do
		local sr, si = 0, 0
		for j = 0, n - 1 do
			local k = 8 * (j * m + i)
			local ar, ai = buffer.readf32(a, k), buffer.readf32(a, k + 4)
			local xr, xi = buffer.readf32(x, 8 * j), buffer.readf32(x, 8 * j + 4)
			sr += ar * xr - ai * xi
			si += ar * xi + ai * xr
		end
		buffer.writef32(o, 8 * i, sr)
		buffer.writef32(o, 8 * i + 4, si)
	end
	return o
end

-- A B
local function matmul(out: Matrix?, A: Matrix, B: Matrix): Matrix
	local m, p, n = A.rows, A.cols, B.cols
	assert(B.rows == p, "matrix sizes do not match")
	local o = matoutput(out, m, n)
	assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
	local a, b, c = A.data, B.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local sr, si = 0, 0
			for k = 0, p - 1 do
				local s, t = 8 * (k * m + i), 8 * (j * p + k)
				local ar, ai = buffer.readf32(a, s), buffer.readf32(a, s + 4)
				local br, bi = buffer.readf32(b, t), buffer.readf32(b, t + 4)
				sr += ar * br - ai * bi
				si += ar * bi + ai * br
			end
			buffer.writef32(c, 8 * (j * m + i), sr)
			buffer.writef32(c, 8 * (j * m + i) + 4, si)
		end
	end
	return o
end

-- LU factorization with partial pivoting (pivots chosen by |re| + |im|), in place: A is
-- overwritten with L and U (see types.LU) and returned as F.lu. lu_copy leaves A unchanged.
local function lu(A: Matrix): LU
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local piv = table.create(n, 0)
	local sign = 1
	local singular = false
	for k = 0, n - 1 do
		local p, best = k, -1
		for i = k, n - 1 do
			local off = 8 * (k * n + i)
			local v = math.abs(buffer.readf32(a, off)) + math.abs(buffer.readf32(a, off + 4))
			if v > best then
				p, best = i, v
			end
		end
		piv[k + 1] = p + 1
		if p ~= k then
			sign = -sign
			for j = 0, n - 1 do
				local s, t = 8 * (j * n + k), 8 * (j * n + p)
				local tr, ti = buffer.readf32(a, s), buffer.readf32(a, s + 4)
				buffer.writef32(a, s, buffer.readf32(a, t))
				buffer.writef32(a, s + 4, buffer.readf32(a, t + 4))
				buffer.writef32(a, t, tr)
				buffer.writef32(a, t + 4, ti)
			end
		end
		local pr, pi = buffer.readf32(a, 8 * (k * n + k)), buffer.readf32(a, 8 * (k * n + k) + 4)
		if pr == 0 and pi == 0 then
			singular = true
		else
			for i = k + 1, n - 1 do
				local off = 8 * (k * n + i)
				local qr, qi = complex64.div(buffer.readf32(a, off), buffer.readf32(a, off + 4), pr, pi)
				buffer.writef32(a, off, qr)
				buffer.writef32(a, off + 4, qi)
			end
			for j = k + 1, n - 1 do
				local s = 8 * (j * n + k)
				local br, bi = buffer.readf32(a, s), buffer.readf32(a, s + 4)
				for i = k + 1, n - 1 do
					local off, l = 8 * (j * n + i), 8 * (k * n + i)
					local lr, li = buffer.readf32(a, l), buffer.readf32(a, l + 4)
					buffer.writef32(a, off, buffer.readf32(a, off) - (lr * br - li * bi))
					buffer.writef32(a, off + 4, buffer.readf32(a, off + 4) - (lr * bi + li * br))
				end
			end
		end
	end
	return { lu = A, piv = piv, sign = sign, singular = singular }
end

-- LU factorization of a copy of A; A is not modified.
local function lu_copy(A: Matrix): LU
	return lu(matcopy(nil, A))
end

-- Solves A x = b given F = lu(A).
local function lu_solve(out: buffer?, F: LU, b: buffer): buffer
	assert(not F.singular, "matrix is singular")
	local n = F.lu.rows
	assert(buffer.len(b) == 8 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a, piv = F.lu.data, F.piv
	for k = 0, n - 1 do
		local p = piv[k + 1] - 1
		if p ~= k then
			local s, t = 8 * k, 8 * p
			local tr, ti = buffer.readf32(o, s), buffer.readf32(o, s + 4)
			buffer.writef32(o, s, buffer.readf32(o, t))
			buffer.writef32(o, s + 4, buffer.readf32(o, t + 4))
			buffer.writef32(o, t, tr)
			buffer.writef32(o, t + 4, ti)
		end
	end
	for j = 0, n - 1 do
		local xr, xi = buffer.readf32(o, 8 * j), buffer.readf32(o, 8 * j + 4)
		for i = j + 1, n - 1 do
			local off, l = 8 * i, 8 * (j * n + i)
			local lr, li = buffer.readf32(a, l), buffer.readf32(a, l + 4)
			buffer.writef32(o, off, buffer.readf32(o, off) - (lr * xr - li * xi))
			buffer.writef32(o, off + 4, buffer.readf32(o, off + 4) - (lr * xi + li * xr))
		end
	end
	for j = n - 1, 0, -1 do
		local d = 8 * (j * n + j)
		local xr, xi = complex64.div(buffer.readf32(o, 8 * j), buffer.readf32(o, 8 * j + 4), buffer.readf32(a, d), buffer.readf32(a, d + 4))
		buffer.writef32(o, 8 * j, xr)
		buffer.writef32(o, 8 * j + 4, xi)
		for i = 0, j - 1 do
			local off, u = 8 * i, 8 * (j * n + i)
			local ur, ui = buffer.readf32(a, u), buffer.readf32(a, u + 4)
			buffer.writef32(o, off, buffer.readf32(o, off) - (ur * xr - ui * xi))
			buffer.writef32(o, off + 4, buffer.readf32(o, off + 4) - (ur * xi + ui * xr))
		end
	end
	return o
end

-- The inverse of a square matrix, in place (LAPACK's getrf + getri): A is overwritten
-- with A^-1 and returned. An error if A is exactly singular. Solving with solve (or a
-- factorization) is faster and more accurate than forming A^-1 and multiplying; use this
-- when the inverse itself is needed. inv_copy leaves A unchanged.
local function inv(A: Matrix): Matrix
	local F = lu(A)
	assert(not F.singular, "inv: matrix is singular")
	local n = A.rows
	local a = A.data
	local function at(i: number, j: number): number
		return 8 * (j * n + i)
	end
	-- U := U^-1 (trti2): column j of the inverse is -u_jj^-1 times the inverted leading
	-- block times the old column.
	for j = 0, n - 1 do
		local ur, ui = complex64.inv(buffer.readf32(a, at(j, j)), buffer.readf32(a, at(j, j) + 4))
		buffer.writef32(a, at(j, j), ur)
		buffer.writef32(a, at(j, j) + 4, ui)
		for k = 0, j - 1 do
			local tr, ti = buffer.readf32(a, at(k, j)), buffer.readf32(a, at(k, j) + 4)
			if tr ~= 0 or ti ~= 0 then
				for i = 0, k - 1 do
					local o, q = at(i, j), at(i, k)
					local qr, qi = buffer.readf32(a, q), buffer.readf32(a, q + 4)
					buffer.writef32(a, o, buffer.readf32(a, o) + tr * qr - ti * qi)
					buffer.writef32(a, o + 4, buffer.readf32(a, o + 4) + tr * qi + ti * qr)
				end
				local dr, di = buffer.readf32(a, at(k, k)), buffer.readf32(a, at(k, k) + 4)
				buffer.writef32(a, at(k, j), tr * dr - ti * di)
				buffer.writef32(a, at(k, j) + 4, tr * di + ti * dr)
			end
		end
		for i = 0, j - 1 do
			local o = at(i, j)
			local xr, xi = buffer.readf32(a, o), buffer.readf32(a, o + 4)
			buffer.writef32(a, o, -(ur * xr - ui * xi))
			buffer.writef32(a, o + 4, -(ur * xi + ui * xr))
		end
	end
	-- Solve X L = U^-1 for X = (P A)^-1, a column at a time from the right (getri).
	local wr, wi = table.create(n, 0), table.create(n, 0)
	for j = n - 1, 0, -1 do
		for i = j + 1, n - 1 do
			wr[i + 1], wi[i + 1] = buffer.readf32(a, at(i, j)), buffer.readf32(a, at(i, j) + 4)
			buffer.writef32(a, at(i, j), 0)
			buffer.writef32(a, at(i, j) + 4, 0)
		end
		for k = j + 1, n - 1 do
			local cr, ci = wr[k + 1], wi[k + 1]
			if cr ~= 0 or ci ~= 0 then
				for i = 0, n - 1 do
					local o, q = at(i, j), at(i, k)
					local qr, qi = buffer.readf32(a, q), buffer.readf32(a, q + 4)
					buffer.writef32(a, o, buffer.readf32(a, o) - (qr * cr - qi * ci))
					buffer.writef32(a, o + 4, buffer.readf32(a, o + 4) - (qr * ci + qi * cr))
				end
			end
		end
	end
	-- A^-1 = X P: undo the row interchanges as column interchanges, last first.
	for j = n - 2, 0, -1 do
		local p = F.piv[j + 1] - 1
		if p ~= j then
			for i = 0, n - 1 do
				local s, t = at(i, j), at(i, p)
				local sr, si = buffer.readf32(a, s), buffer.readf32(a, s + 4)
				buffer.writef32(a, s, buffer.readf32(a, t))
				buffer.writef32(a, s + 4, buffer.readf32(a, t + 4))
				buffer.writef32(a, t, sr)
				buffer.writef32(a, t + 4, si)
			end
		end
	end
	return A
end

-- The inverse of a copy of A; A is not modified.
local function inv_copy(A: Matrix): Matrix
	return inv(matcopy(nil, A))
end

local function det_pair(A: Matrix): (number, number)
	local F = lu_copy(A)
	local dr, di = F.sign, 0
	local n = A.rows
	for k = 0, n - 1 do
		local off = 8 * (k * n + k)
		dr, di = complex64.mul(dr, di, buffer.readf32(F.lu.data, off), buffer.readf32(F.lu.data, off + 4))
	end
	return dr, di
end

-- Cholesky

-- Cholesky factorization A = L L^H of a Hermitian positive definite matrix, in place:
-- the lower triangle of A is overwritten with L (whose diagonal is real) and returned as
-- F.chol. Only the lower triangle of A is read, and only the real parts of its diagonal;
-- the strictly upper triangle is left as it was. If A is not positive definite,
-- F.definite is false and A is partly overwritten. chol_copy leaves A unchanged.
local function chol(A: Matrix): Cholesky
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	for j = 0, n - 1 do
		local diag = 8 * (j * n + j)
		local d = buffer.readf32(a, diag)
		if not (d > 0) then
			return { chol = A, definite = false }
		end
		local ljj = math.sqrt(d)
		buffer.writef32(a, diag, ljj)
		buffer.writef32(a, diag + 4, 0)
		for i = j + 1, n - 1 do
			local off = 8 * (j * n + i)
			buffer.writef32(a, off, buffer.readf32(a, off) / ljj)
			buffer.writef32(a, off + 4, buffer.readf32(a, off + 4) / ljj)
		end
		-- Subtract the new column's outer product, l l^H, from the trailing lower triangle.
		for c = j + 1, n - 1 do
			local s = 8 * (j * n + c)
			-- conj(L[c, j])
			local cr, ci = buffer.readf32(a, s), -buffer.readf32(a, s + 4)
			for i = c, n - 1 do
				local off, l = 8 * (c * n + i), 8 * (j * n + i)
				local lr, li = buffer.readf32(a, l), buffer.readf32(a, l + 4)
				buffer.writef32(a, off, buffer.readf32(a, off) - (lr * cr - li * ci))
				buffer.writef32(a, off + 4, buffer.readf32(a, off + 4) - (lr * ci + li * cr))
			end
		end
	end
	return { chol = A, definite = true }
end

-- Cholesky factorization of a copy of A; A is not modified.
local function chol_copy(A: Matrix): Cholesky
	return chol(matcopy(nil, A))
end

-- The lower triangular factor L, with zeros above the diagonal.
local function chol_l(out: Matrix?, F: Cholesky): Matrix
	local n = F.chol.rows
	local o = matoutput(out, n, n)
	local a, l = F.chol.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = 8 * (j * n + i)
			if i >= j then
				buffer.writef32(l, off, buffer.readf32(a, off))
				buffer.writef32(l, off + 4, buffer.readf32(a, off + 4))
			else
				buffer.writef32(l, off, 0)
				buffer.writef32(l, off + 4, 0)
			end
		end
	end
	return o
end

-- Solves A x = b given F = chol(A). b is not modified unless it is passed as out.
local function chol_solve(out: buffer?, F: Cholesky, b: buffer): buffer
	assert(F.definite, "matrix is not positive definite")
	local n = F.chol.rows
	assert(buffer.len(b) == 8 * n, "matrix and vector sizes do not match")
	local o = copy(out, b)
	local a = F.chol.data
	-- L y = b (the diagonal of L is real)
	for j = 0, n - 1 do
		local d = buffer.readf32(a, 8 * (j * n + j))
		local yr, yi = buffer.readf32(o, 8 * j) / d, buffer.readf32(o, 8 * j + 4) / d
		buffer.writef32(o, 8 * j, yr)
		buffer.writef32(o, 8 * j + 4, yi)
		for i = j + 1, n - 1 do
			local off, l = 8 * i, 8 * (j * n + i)
			local lr, li = buffer.readf32(a, l), buffer.readf32(a, l + 4)
			buffer.writef32(o, off, buffer.readf32(o, off) - (lr * yr - li * yi))
			buffer.writef32(o, off + 4, buffer.readf32(o, off + 4) - (lr * yi + li * yr))
		end
	end
	-- L^H x = y, a conjugated dot product down each column of L.
	for j = n - 1, 0, -1 do
		local sr, si = buffer.readf32(o, 8 * j), buffer.readf32(o, 8 * j + 4)
		for i = j + 1, n - 1 do
			local l = 8 * (j * n + i)
			local lr, li = buffer.readf32(a, l), buffer.readf32(a, l + 4)
			local xr, xi = buffer.readf32(o, 8 * i), buffer.readf32(o, 8 * i + 4)
			sr -= lr * xr + li * xi
			si -= lr * xi - li * xr
		end
		local d = buffer.readf32(a, 8 * (j * n + j))
		buffer.writef32(o, 8 * j, sr / d)
		buffer.writef32(o, 8 * j + 4, si / d)
	end
	return o
end

-- Householder QR

-- Unit roundoff of the storage precision.
local EPS = 2 ^ -24

-- Applies I - t v v^H, t = tr + i ti, to the `len` values of x starting at byte offset
-- `xs`. v starts at byte offset `vs` of `a`; its first entry is an implicit 1.
local function reflect(a: buffer, vs: number, len: number, tr: number, ti: number, x: buffer, xs: number)
	local wr, wi = buffer.readf32(x, xs), buffer.readf32(x, xs + 4)
	for i = 1, len - 1 do
		local v, y = vs + 8 * i, xs + 8 * i
		local vr, vi = buffer.readf32(a, v), buffer.readf32(a, v + 4)
		local yr, yi = buffer.readf32(x, y), buffer.readf32(x, y + 4)
		wr += vr * yr + vi * yi
		wi += vr * yi - vi * yr
	end
	if wr == 0 and wi == 0 then
		return
	end
	wr, wi = tr * wr - ti * wi, tr * wi + ti * wr
	buffer.writef32(x, xs, buffer.readf32(x, xs) - wr)
	buffer.writef32(x, xs + 4, buffer.readf32(x, xs + 4) - wi)
	for i = 1, len - 1 do
		local v, y = vs + 8 * i, xs + 8 * i
		local vr, vi = buffer.readf32(a, v), buffer.readf32(a, v + 4)
		buffer.writef32(x, y, buffer.readf32(x, y) - (wr * vr - wi * vi))
		buffer.writef32(x, y + 4, buffer.readf32(x, y + 4) - (wr * vi + wi * vr))
	end
end

-- Turns the `len` values of `a` starting at byte offset `diag` into a Householder
-- reflector, in place: the real beta at `diag` and v below it (its leading 1 is
-- implicit). Stores tau as element k of `tau` and returns it; tau = 0 (H = I) when the
-- value at `diag` is already real and there is nothing below it to zero.
local function householder(a: buffer, diag: number, len: number, tau: buffer, k: number): (number, number)
	local ar, ai = buffer.readf32(a, diag), buffer.readf32(a, diag + 4)
	local xnorm = segment_norm(a, diag + 8, 2 * (len - 1))
	if xnorm == 0 and ai == 0 then
		buffer.writef32(tau, 8 * k, 0)
		buffer.writef32(tau, 8 * k + 4, 0)
		return 0, 0
	end
	local beta = hypot3(ar, ai, xnorm)
	if ar >= 0 then
		beta = -beta
	end
	buffer.writef32(tau, 8 * k, (beta - ar) / beta)
	buffer.writef32(tau, 8 * k + 4, -ai / beta)
	-- Re(alpha) and beta have opposite signs, so alpha - beta cannot cancel.
	local dr = ar - beta
	for off = diag + 8, diag + 8 * (len - 1), 8 do
		local vr, vi = complex64.div(buffer.readf32(a, off), buffer.readf32(a, off + 4), dr, ai)
		buffer.writef32(a, off, vr)
		buffer.writef32(a, off + 4, vi)
	end
	buffer.writef32(a, diag, beta)
	buffer.writef32(a, diag + 4, 0)
	return buffer.readf32(tau, 8 * k), buffer.readf32(tau, 8 * k + 4)
end

-- Solves R z = y in place on the first r entries of y, where R is the leading r by r
-- block of the upper triangle stored in `a` (a matrix with m rows).
local function back_substitute(a: buffer, m: number, r: number, y: buffer)
	for j = r - 1, 0, -1 do
		local d = 8 * (j * m + j)
		local rr, ri = buffer.readf32(a, d), buffer.readf32(a, d + 4)
		assert(rr ~= 0 or ri ~= 0, "matrix is rank deficient")
		local yr, yi = complex64.div(buffer.readf32(y, 8 * j), buffer.readf32(y, 8 * j + 4), rr, ri)
		buffer.writef32(y, 8 * j, yr)
		buffer.writef32(y, 8 * j + 4, yi)
		for i = 0, j - 1 do
			local off, u = 8 * i, 8 * (j * m + i)
			local ur, ui = buffer.readf32(a, u), buffer.readf32(a, u + 4)
			buffer.writef32(y, off, buffer.readf32(y, off) - (ur * yr - ui * yi))
			buffer.writef32(y, off + 4, buffer.readf32(y, off + 4) - (ur * yi + ui * yr))
		end
	end
end

-- Householder QR factorization, in place: A is overwritten (see types.QR for the layout)
-- and returned as F.qr. The diagonal of R is real. qr_copy leaves A unchanged.
local function qr(A: Matrix): QR
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(8 * kmax)
	for k = 0, kmax - 1 do
		local diag = 8 * (k * m + k)
		local tr, ti = householder(a, diag, m - k, tau, k)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, 8 * (j * m + k))
			end
		end
	end
	return { qr = A, tau = tau }
end

-- Householder QR factorization of a copy of A; A is not modified.
local function qr_copy(A: Matrix): QR
	return qr(matcopy(nil, A))
end

-- x := Q^H x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_qh(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == 8 * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = 0, buffer.len(tau) // 8 - 1 do
		local tr, ti = buffer.readf32(tau, 8 * k), buffer.readf32(tau, 8 * k + 4)
		reflect(a, 8 * (k * m + k), m - k, tr, -ti, x, 8 * k)
	end
	return x
end

-- x := Q x, in place. Returns x. Also accepts a QRP factorization.
local function qr_apply_q(F: QR, x: buffer): buffer
	local m = F.qr.rows
	assert(buffer.len(x) == 8 * m, "matrix and vector sizes do not match")
	local a, tau = F.qr.data, F.tau
	for k = buffer.len(tau) // 8 - 1, 0, -1 do
		local tr, ti = buffer.readf32(tau, 8 * k), buffer.readf32(tau, 8 * k + 4)
		reflect(a, 8 * (k * m + k), m - k, tr, ti, x, 8 * k)
	end
	return x
end

-- The min(rows, cols) by cols upper triangular factor R. Also accepts a QRP factorization.
local function qr_r(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, kmax, n)
	local a, r = F.qr.data, o.data
	for j = 0, n - 1 do
		for i = 0, kmax - 1 do
			local s, t = 8 * (j * m + i), 8 * (j * kmax + i)
			if i <= j then
				buffer.writef32(r, t, buffer.readf32(a, s))
				buffer.writef32(r, t + 4, buffer.readf32(a, s + 4))
			else
				buffer.writef32(r, t, 0)
				buffer.writef32(r, t + 4, 0)
			end
		end
	end
	return o
end

-- The rows by min(rows, cols) factor Q with orthonormal columns (the thin Q). Also
-- accepts a QRP factorization.
local function qr_q(out: Matrix?, F: QR): Matrix
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	local o = matoutput(out, m, kmax)
	local a, tau, q = F.qr.data, F.tau, o.data
	buffer.fill(q, 0, 0)
	for c = 0, kmax - 1 do
		buffer.writef32(q, 8 * (c * m + c), 1)
		-- Reflectors after column c leave the unit vector e_c unchanged.
		for k = c, 0, -1 do
			local tr, ti = buffer.readf32(tau, 8 * k), buffer.readf32(tau, 8 * k + 4)
			reflect(a, 8 * (k * m + k), m - k, tr, ti, q, 8 * (c * m + k))
		end
	end
	return o
end

-- Least squares: the x minimizing |A x - b| for A with rows >= cols and full column
-- rank, given F = qr(A). b is not modified. Also returns the residual norm |A x - b|.
local function qr_solve(out: buffer?, F: QR, b: buffer): (buffer, number)
	local m, n = F.qr.rows, F.qr.cols
	assert(m >= n, "least squares needs at least as many rows as columns")
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, n, y)
	local o = output(out, 8 * n)
	buffer.copy(o, 0, y, 0, 8 * n)
	return o, segment_norm(y, 8 * n, 2 * (m - n))
end

-- Column-pivoted QR

-- Householder QR with column pivoting, A P = Q R, in place: A is overwritten as in qr and
-- returned as F.qr; column j of A P is column perm[j] of A. Each step moves the remaining
-- column of largest norm to the front, so |R_11| >= |R_22| >= ... and small trailing
-- diagonal entries reveal the numerical rank. qrp_copy leaves A unchanged.
local function qrp(A: Matrix): QRP
	local m, n = A.rows, A.cols
	local kmax = math.min(m, n)
	local a = A.data
	local tau = buffer.create(8 * kmax)
	local perm = table.create(n, 0)
	-- Norms of the unfactored part of each column (partial), and the norm at the last
	-- recomputation (reference), for LAPACK's safeguarded downdating.
	local partial, reference = table.create(n, 0), table.create(n, 0)
	for j = 1, n do
		perm[j] = j
		local v = segment_norm(a, 8 * (j - 1) * m, 2 * m)
		partial[j], reference[j] = v, v
	end
	local recompute = math.sqrt(EPS)
	for k = 0, kmax - 1 do
		local p, best = k, -1
		for j = k, n - 1 do
			if partial[j + 1] > best then
				p, best = j, partial[j + 1]
			end
		end
		if p ~= k then
			for i = 0, m - 1 do
				local s, t = 8 * (k * m + i), 8 * (p * m + i)
				local sr, si = buffer.readf32(a, s), buffer.readf32(a, s + 4)
				buffer.writef32(a, s, buffer.readf32(a, t))
				buffer.writef32(a, s + 4, buffer.readf32(a, t + 4))
				buffer.writef32(a, t, sr)
				buffer.writef32(a, t + 4, si)
			end
			perm[k + 1], perm[p + 1] = perm[p + 1], perm[k + 1]
			partial[p + 1], reference[p + 1] = partial[k + 1], reference[k + 1]
		end

		local diag = 8 * (k * m + k)
		local tr, ti = householder(a, diag, m - k, tau, k)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, 8 * (j * m + k))
			end
		end

		-- Remove row k from the remaining partial norms. When cancellation would leave too
		-- few correct digits, recompute the norm instead.
		for j = k + 1, n - 1 do
			local v = partial[j + 1]
			if v ~= 0 then
				local off = 8 * (j * m + k)
				local ratio = complex64.abs(buffer.readf32(a, off), buffer.readf32(a, off + 4)) / v
				local left = math.max(0, 1 - ratio * ratio)
				local drift = v / reference[j + 1]
				if left * drift * drift <= recompute then
					local fresh = segment_norm(a, off + 8, 2 * (m - k - 1))
					partial[j + 1], reference[j + 1] = fresh, fresh
				else
					partial[j + 1] = v * math.sqrt(left)
				end
			end
		end
	end
	return { qr = A, tau = tau, perm = perm }
end

-- Column-pivoted QR of a copy of A; A is not modified.
local function qrp_copy(A: Matrix): QRP
	return qrp(matcopy(nil, A))
end

-- Numerical rank: the number of leading diagonal entries of R with |R_kk| > tol |R_11|.
-- The default tol is max(rows, cols) times the unit roundoff of the storage precision.
local function qrp_rank(F: QRP, tol: number?): number
	local m, n = F.qr.rows, F.qr.cols
	local kmax = math.min(m, n)
	if kmax == 0 then
		return 0
	end
	local a = F.qr.data
	local limit = (tol or math.max(m, n) * EPS) * complex64.abs(buffer.readf32(a, 0), buffer.readf32(a, 4))
	for k = 0, kmax - 1 do
		local d = 8 * (k * m + k)
		if not (complex64.abs(buffer.readf32(a, d), buffer.readf32(a, d + 4)) > limit) then
			return k
		end
	end
	return kmax
end

-- Least squares for any shape and rank, given F = qrp(A): the basic solution, which
-- uses only the first r = qrp_rank(F, tol) pivot columns and sets the other variables
-- to zero. b is not modified. Also returns the residual norm |A x - b| and r.
local function qrp_solve(out: buffer?, F: QRP, b: buffer, tol: number?): (buffer, number, number)
	local m, n = F.qr.rows, F.qr.cols
	local r = qrp_rank(F, tol)
	local y = qr_apply_qh(F, copy(nil, b))
	back_substitute(F.qr.data, m, r, y)
	local o = output(out, 8 * n)
	buffer.fill(o, 0, 0)
	for j = 1, r do
		local s, t = 8 * (j - 1), 8 * (F.perm[j] - 1)
		buffer.writef32(o, t, buffer.readf32(y, s))
		buffer.writef32(o, t + 4, buffer.readf32(y, s + 4))
	end
	return o, segment_norm(y, 8 * r, 2 * (m - r)), r
end

-- Hessenberg reduction and Hermitian eigenvalues

-- Reals per matrix entry, for the shared tridiagonal eigensolver.
local PARTS = 2

-- Implicit symmetric QR with Wilkinson shifts on the real symmetric tridiagonal matrix
-- with diagonal d[1..n] and off-diagonal e[1..n-1]. d and e are Luau tables, so the
-- iteration runs in double precision whatever the storage precision. On return d holds
-- the eigenvalues in ascending order and e is destroyed. If z is given (an n by n matrix
-- whose entries are PARTS reals each), every rotation is applied to its columns and the
-- columns are sorted with the eigenvalues.
local function tridiagonal_eigen(d: { number }, e: { number }, z: buffer?, n: number)
	local column = 4 * PARTS * n
	local reals = PARTS * n

	-- Columns k and k+1 (1-based) of z := [c z_k + s z_k+1, -s z_k + c z_k+1].
	local function rotate(zb: buffer, k: number, c: number, s: number)
		local p, q = column * (k - 1), column * k
		for i = 0, reals - 1 do
			local zp, zq = buffer.readf32(zb, p + 4 * i), buffer.readf32(zb, q + 4 * i)
			buffer.writef32(zb, p + 4 * i, c * zp + s * zq)
			buffer.writef32(zb, q + 4 * i, c * zq - s * zp)
		end
	end

	-- e[i] is negligible next to its diagonal neighbours (LAPACK's steqr test).
	local function negligible(i: number): boolean
		local v = math.abs(e[i])
		return v <= 2 ^ -53 * math.sqrt(math.abs(d[i])) * math.sqrt(math.abs(d[i + 1])) or v < 2 ^ -1000
	end

	local iterations, limit = 0, 30 * math.max(n, 1)
	local h = n
	while h > 1 do
		if negligible(h - 1) then
			e[h - 1] = 0
			h -= 1
			continue
		end
		-- The unreduced block is l..h.
		local l = h - 1
		while l > 1 and not negligible(l - 1) do
			l -= 1
		end
		if l > 1 then
			e[l - 1] = 0
		end
		iterations += 1
		if iterations > limit then
			error("eigh: the QR iteration did not converge")
		end

		-- Wilkinson shift: the eigenvalue of the trailing 2 by 2 block closer to d[h].
		local half = (d[h - 1] - d[h]) / 2
		local eh = e[h - 1]
		local r = hypot3(half, eh, 0)
		local mu = d[h] - eh * (eh / (half + (if half >= 0 then r else -r)))

		-- Chase the bulge from the top of the block to the bottom.
		local x, bulge = d[l] - mu, e[l]
		for k = l, h - 1 do
			local c, s, len = 1, 0, x
			if bulge ~= 0 then
				len = hypot3(x, bulge, 0)
				c, s = x / len, bulge / len
			end
			if k > l then
				e[k - 1] = len
			end
			local a, b, cc = d[k], e[k], d[k + 1]
			d[k] = c * c * a + 2 * c * s * b + s * s * cc
			d[k + 1] = s * s * a - 2 * c * s * b + c * c * cc
			e[k] = c * s * (cc - a) + (c * c - s * s) * b
			if k < h - 1 then
				x = e[k]
				bulge = s * e[k + 1]
				e[k + 1] = c * e[k + 1]
			end
			if z then
				rotate(z, k, c, s)
			end
		end
	end

	-- Selection sort into ascending order, moving the columns of z along.
	for i = 1, n - 1 do
		local best = i
		for j = i + 1, n do
			if d[j] < d[best] then
				best = j
			end
		end
		if best ~= i then
			d[i], d[best] = d[best], d[i]
			if z then
				local p, q = column * (i - 1), column * (best - 1)
				for k = 0, reals - 1 do
					local tmp = buffer.readf32(z, p + 4 * k)
					buffer.writef32(z, p + 4 * k, buffer.readf32(z, q + 4 * k))
					buffer.writef32(z, q + 4 * k, tmp)
				end
			end
		end
	end
end

-- In place, LAPACK's ung2r: the `count` reflectors stored below the diagonal of the first
-- columns of the `rows` by `cols` block at (r0, r0) of the matrix in `a` (leading
-- dimension ld, with their tau values in `tau`) are replaced by the first `cols` columns
-- of the block's Q = H_1 ... H_count.
local function form_q(a: buffer, ld: number, r0: number, rows: number, cols: number, count: number, tau: buffer)
	local function at(i: number, j: number): number
		return 8 * ((r0 + j) * ld + r0 + i)
	end
	for j = count, cols - 1 do
		for i = 0, rows - 1 do
			buffer.writef32(a, at(i, j), if i == j then 1 else 0)
			buffer.writef32(a, at(i, j) + 4, 0)
		end
	end
	for i = count - 1, 0, -1 do
		local tr, ti = buffer.readf32(tau, 8 * i), buffer.readf32(tau, 8 * i + 4)
		for j = i + 1, cols - 1 do
			reflect(a, at(i, i), rows - i, tr, ti, a, at(i, j))
		end
		for r = i + 1, rows - 1 do
			local off = at(r, i)
			local vr, vi = buffer.readf32(a, off), buffer.readf32(a, off + 4)
			buffer.writef32(a, off, -(tr * vr - ti * vi))
			buffer.writef32(a, off + 4, -(tr * vi + ti * vr))
		end
		buffer.writef32(a, at(i, i), 1 - tr)
		buffer.writef32(a, at(i, i) + 4, -ti)
		for r = 0, i - 1 do
			buffer.writef32(a, at(r, i), 0)
			buffer.writef32(a, at(r, i) + 4, 0)
		end
	end
end

-- Forms in place the n by n Q = H_0 ... H_count-1 of a Hessenberg or tridiagonal
-- reduction, whose reflector k acts on rows k+1.. and is stored below row k+1 of column k.
local function form_reduction_q(a: buffer, n: number, count: number, tau: buffer)
	if n == 0 then
		return
	end
	-- Move each reflector one column right, so that it sits below the diagonal of the
	-- trailing n-1 by n-1 block, where form_q expects it.
	for k = count - 1, 0, -1 do
		for i = k + 2, n - 1 do
			local s, t = 8 * (k * n + i), 8 * ((k + 1) * n + i)
			buffer.writef32(a, t, buffer.readf32(a, s))
			buffer.writef32(a, t + 4, buffer.readf32(a, s + 4))
		end
	end
	for i = 0, n - 1 do
		local one = if i == 0 then 1 else 0
		buffer.writef32(a, 8 * i, one)
		buffer.writef32(a, 8 * i + 4, 0)
		buffer.writef32(a, 8 * (i * n), one)
		buffer.writef32(a, 8 * (i * n) + 4, 0)
	end
	form_q(a, n, 1, n - 1, n - 1, count, tau)
end

-- Hessenberg reduction restricted to rows and columns ilo..ihi (0-based), for a matrix
-- that is already upper triangular outside that block (as balancing leaves it): only
-- reflectors inside the block are made (tau = 0 elsewhere), but they are applied to the
-- whole matrix.
local function hess_range(A: Matrix, ilo: number, ihi: number): Hessenberg
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local a = A.data
	local count = math.max(n - 2, 0)
	local tau = buffer.create(8 * count)
	local wr, wi = table.create(n, 0), table.create(n, 0)
	for k = ilo, ihi - 2 do
		local vs = 8 * (k * n + k + 1)
		local len = ihi - k
		local tr, ti = householder(a, vs, len, tau, k)
		if tr ~= 0 or ti ~= 0 then
			-- From the left, H^H: rows k+1.. of columns k+1..
			for j = k + 1, n - 1 do
				reflect(a, vs, len, tr, -ti, a, 8 * (j * n + k + 1))
			end
			-- From the right: A := A - tau (A v) v^H on columns k+1..
			for i = 0, ihi do
				local off = 8 * ((k + 1) * n + i)
				wr[i + 1], wi[i + 1] = buffer.readf32(a, off), buffer.readf32(a, off + 4)
			end
			for c = 1, len - 1 do
				local vr, vi = buffer.readf32(a, vs + 8 * c), buffer.readf32(a, vs + 8 * c + 4)
				local col = 8 * ((k + 1 + c) * n)
				for i = 0, ihi do
					local ar, ai = buffer.readf32(a, col + 8 * i), buffer.readf32(a, col + 8 * i + 4)
					wr[i + 1] += ar * vr - ai * vi
					wi[i + 1] += ar * vi + ai * vr
				end
			end
			for c = 0, len - 1 do
				local vr = if c > 0 then buffer.readf32(a, vs + 8 * c) else 1
				local vi = if c > 0 then buffer.readf32(a, vs + 8 * c + 4) else 0
				-- tau conj(v_c)
				local fr, fi = tr * vr + ti * vi, ti * vr - tr * vi
				local col = 8 * ((k + 1 + c) * n)
				for i = 0, ihi do
					local off = col + 8 * i
					local xr, xi = wr[i + 1], wi[i + 1]
					buffer.writef32(a, off, buffer.readf32(a, off) - (xr * fr - xi * fi))
					buffer.writef32(a, off + 4, buffer.readf32(a, off + 4) - (xr * fi + xi * fr))
				end
			end
		end
	end
	return { hess = A, tau = tau }
end


-- Upper Hessenberg reduction A = Q H Q^H (^T for real A), in place: A is overwritten with H
-- on and above the subdiagonal and, below it, the reflectors H_k = I - tau_k v_k v_k^H (v_k
-- has a 1 in row k+1, not stored, and is stored below that in column k).
-- Q = H_0 ... H_n-3. hess_copy leaves A unchanged.
local function hess(A: Matrix): Hessenberg
	return hess_range(A, 0, A.rows - 1)
end

-- Hessenberg reduction of a copy of A; A is not modified.
local function hess_copy(A: Matrix): Hessenberg
	return hess(matcopy(nil, A))
end

-- The upper Hessenberg factor H, with zeros below the subdiagonal.
local function hess_h(out: Matrix?, F: Hessenberg): Matrix
	local n = F.hess.rows
	local o = matoutput(out, n, n)
	local a, h = F.hess.data, o.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local off = 8 * (j * n + i)
			if i <= j + 1 then
				buffer.writef32(h, off, buffer.readf32(a, off))
				buffer.writef32(h, off + 4, buffer.readf32(a, off + 4))
			else
				buffer.writef32(h, off, 0)
				buffer.writef32(h, off + 4, 0)
			end
		end
	end
	return o
end

-- The unitary factor Q.
local function hess_q(out: Matrix?, F: Hessenberg): Matrix
	local n = F.hess.rows
	local o = matcopy(out, F.hess)
	form_reduction_q(o.data, n, buffer.len(F.tau) // 8, F.tau)
	return o
end

-- Reduces the Hermitian matrix whose lower triangle is in A to real symmetric tridiagonal
-- form, A = Q T Q^H, in place (LAPACK's hetd2): returns T's diagonal d and off-diagonal e
-- as tables and leaves the reflectors (stored as in hess) and their tau in A and `tau`.
-- Only the real parts of the diagonal of A are read.
local function tridiagonalize(A: Matrix): ({ number }, { number }, buffer)
	local n = A.rows
	local a = A.data
	local count = math.max(n - 1, 0)
	local tau = buffer.create(8 * count)
	local d, e = table.create(n, 0), table.create(count, 0)
	local vr, vi = table.create(n, 0), table.create(n, 0)
	local xr, xi = table.create(n, 0), table.create(n, 0)
	for k = 0, count - 1 do
		local vs = 8 * (k * n + k + 1)
		local len = n - k - 1
		local tr, ti = householder(a, vs, len, tau, k)
		e[k + 1] = buffer.readf32(a, vs)
		if tr ~= 0 or ti ~= 0 then
			vr[1], vi[1] = 1, 0
			for r = 1, len - 1 do
				vr[r + 1], vi[r + 1] = buffer.readf32(a, vs + 8 * r), buffer.readf32(a, vs + 8 * r + 4)
			end
			-- y = A22 v from the lower triangle of A22 = A[k+1.., k+1..] (real diagonal).
			for r = 1, len do
				xr[r], xi[r] = 0, 0
			end
			for c = 0, len - 1 do
				local col = 8 * ((k + 1 + c) * n + k + 1)
				local cr, ci = vr[c + 1], vi[c + 1]
				local diag = buffer.readf32(a, col + 8 * c)
				local accr, acci = diag * cr, diag * ci
				for r = c + 1, len - 1 do
					local ar, ai = buffer.readf32(a, col + 8 * r), buffer.readf32(a, col + 8 * r + 4)
					-- A[r, c] v_c
					xr[r + 1] += ar * cr - ai * ci
					xi[r + 1] += ar * ci + ai * cr
					-- conj(A[r, c]) v_r
					local pr, pi = vr[r + 1], vi[r + 1]
					accr += ar * pr + ai * pi
					acci += ar * pi - ai * pr
				end
				xr[c + 1] += accr
				xi[c + 1] += acci
			end
			-- x = tau y, and x^H v
			local sr, si = 0, 0
			for r = 1, len do
				local yr, yi = xr[r], xi[r]
				xr[r], xi[r] = tr * yr - ti * yi, tr * yi + ti * yr
				sr += xr[r] * vr[r] + xi[r] * vi[r]
				si += xr[r] * vi[r] - xi[r] * vr[r]
			end
			-- w = x + alpha v with alpha = -(tau / 2) (x^H v)
			local alr, ali = -0.5 * (tr * sr - ti * si), -0.5 * (tr * si + ti * sr)
			for r = 1, len do
				local pr, pi = vr[r], vi[r]
				xr[r] += alr * pr - ali * pi
				xi[r] += alr * pi + ali * pr
			end
			-- A22 := A22 - v w^H - w v^H on the lower triangle; the diagonal stays real.
			for c = 0, len - 1 do
				local col = 8 * ((k + 1 + c) * n + k + 1)
				local cvr, cvi, cwr, cwi = vr[c + 1], vi[c + 1], xr[c + 1], xi[c + 1]
				for r = c, len - 1 do
					local off = col + 8 * r
					local pr, pi, qr, qi = vr[r + 1], vi[r + 1], xr[r + 1], xi[r + 1]
					-- v_r conj(w_c) + w_r conj(v_c)
					local ur = pr * cwr + pi * cwi + qr * cvr + qi * cvi
					local ui = pi * cwr - pr * cwi + qi * cvr - qr * cvi
					buffer.writef32(a, off, buffer.readf32(a, off) - ur)
					buffer.writef32(a, off + 4, if r == c then 0 else buffer.readf32(a, off + 4) - ui)
				end
			end
		end
		d[k + 1] = buffer.readf32(a, 8 * (k * n + k))
	end
	if n > 0 then
		d[n] = buffer.readf32(a, 8 * ((n - 1) * n + n - 1))
	end
	return d, e, tau
end

-- Eigenvalues (ascending, as a real array of the same precision) and, unless vectors is
-- false, orthonormal eigenvectors of a Hermitian matrix, in place: only the lower
-- triangle of A (and the real parts of its diagonal) is read, and A is overwritten with
-- the eigenvectors (column j belongs to values[j]), or with workspace if vectors is false.
-- Tridiagonalization, then implicit QR with Wilkinson shifts in double precision. If the
-- part read holds a NaN or an infinity, the values and A are all NaN. eigh_copy leaves A
-- unchanged.
local function eigh(A: Matrix, vectors: boolean?): Eigh
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	local want = vectors ~= false
	-- Non-finite input (in the part that is read: the lower triangle without the imaginary
	-- parts of the diagonal) gives NaN values and a NaN A.
	for j = 0, n - 1 do
		local o = 8 * (j * n + j)
		if any_nonfinite(A.data, o, 1) or any_nonfinite(A.data, o + 8, 2 * (n - j - 1)) then
			local values = buffer.create(4 * n)
			fill_nan(values, 0, n)
			fill_nan(A.data, 0, 2 * n * n)
			return { values = values, vectors = if want then A else nil }
		end
	end
	-- Scaled into a safe range (see range_factor), by the part that is read; the values are
	-- scaled back and the vectors do not change.
	local big = 0
	for j = 0, n - 1 do
		big = math.max(big, math.abs(buffer.readf32(A.data, 8 * (j * n + j))))
		for i = j + 1, n - 1 do
			local o = 8 * (j * n + i)
			big = math.max(big, math.abs(buffer.readf32(A.data, o)), math.abs(buffer.readf32(A.data, o + 4)))
		end
	end
	local sc = range_factor(big)
	if sc ~= 1 then
		scale(A.data, sc, A.data)
	end
	local d, e, tau = tridiagonalize(A)
	if want then
		form_reduction_q(A.data, n, buffer.len(tau) // 8, tau)
	end
	tridiagonal_eigen(d, e, if want then A.data else nil, n)
	local values = buffer.create(4 * n)
	for i = 1, n do
		buffer.writef32(values, 4 * (i - 1), d[i] / sc)
	end
	return { values = values, vectors = if want then A else nil }
end

-- Hermitian eigendecomposition of a copy of A; A is not modified.
local function eigh_copy(A: Matrix, vectors: boolean?): Eigh
	return eigh(matcopy(nil, A), vectors)
end

-- Nonsymmetric eigenvalues

local function cabs1(re: number, im: number): number
	return math.abs(re) + math.abs(im)
end

-- A reflector I - tau v v^H, v = (1, v2), taking (alpha, x) to (beta, 0) with beta real.
-- Returns beta, tau and v2 (complex numbers as pairs).
local function small_reflector(ar: number, ai: number, xr: number, xi: number): (number, number, number, number, number)
	local xnorm = hypot3(xr, xi, 0)
	if xnorm == 0 and ai == 0 then
		return ar, 0, 0, 0, 0
	end
	local beta = hypot3(ar, ai, xnorm)
	if ar >= 0 then
		beta = -beta
	end
	local v2r, v2i = complex64.div(xr, xi, ar - beta, ai)
	return beta, (beta - ar) / beta, -ai / beta, v2r, v2i
end

-- Single-shift Francis QR (LAPACK's lahqr for complex matrices) on the upper Hessenberg
-- matrix in h (n by n, zero below the subdiagonal), in place. With wantt, h becomes the
-- upper triangular Schur form T. With z, the unitary transformations are accumulated
-- into its columns. Returns the eigenvalues (real and imaginary parts) in the order of
-- T's diagonal.
local function complex_schur(h: buffer, n: number, wantt: boolean, z: buffer?, ilo: number, ihi: number): ({ number }, { number })
	local function at(i: number, j: number): number
		return 8 * (j * n + i)
	end
	local function H(i: number, j: number): (number, number)
		local o = at(i, j)
		return buffer.readf32(h, o), buffer.readf32(h, o + 4)
	end
	local function set(i: number, j: number, re: number, im: number)
		local o = at(i, j)
		buffer.writef32(h, o, re)
		buffer.writef32(h, o + 4, im)
	end
	local function habs(i: number, j: number): number
		local o = at(i, j)
		return math.abs(buffer.readf32(h, o)) + math.abs(buffer.readf32(h, o + 4))
	end
	local wr, wi = table.create(n, 0), table.create(n, 0)
	local ulp = 2 * EPS
	local smlnum = 2 ^ -1000 * (n / ulp)
	local itmax = 30 * math.max(10, n)
	local kdefl = 0
	-- Eigenvalues outside ilo..ihi were isolated by balancing: they are on the diagonal.
	for k = 0, n - 1 do
		if k < ilo or k > ihi then
			wr[k + 1], wi[k + 1] = H(k, k)
		end
	end
	local i = ihi
	while i >= ilo do
		local l = ilo
		local converged = false
		for _ = 0, itmax do
			-- Look for a negligible subdiagonal entry (Ahues and Tisseur's test).
			local k = i
			while k > l do
				local sub = habs(k, k - 1)
				if sub <= smlnum then
					break
				end
				local tst = habs(k - 1, k - 1) + habs(k, k)
				if tst == 0 then
					if k - 2 >= ilo then
						tst += habs(k - 1, k - 2)
					end
					if k + 1 <= ihi then
						tst += habs(k + 1, k)
					end
				end
				if sub <= ulp * tst then
					local sup = habs(k - 1, k)
					local ab, ba = math.max(sub, sup), math.min(sub, sup)
					local pr, pi = H(k - 1, k - 1)
					local qr, qi = H(k, k)
					local hkk, gap = cabs1(qr, qi), cabs1(pr - qr, pi - qi)
					local aa, bb = math.max(hkk, gap), math.min(hkk, gap)
					local s = aa + ab
					if ba * (ab / s) <= math.max(smlnum, ulp * (bb * (aa / s))) then
						break
					end
				end
				k -= 1
			end
			l = k
			if l > ilo then
				set(l, l - 1, 0, 0)
			end
			if l >= i then
				converged = true
				break
			end
			kdefl += 1
			local i1, i2 = if wantt then 0 else l, if wantt then n - 1 else i

			-- Shift: Wilkinson's (the eigenvalue of the trailing 2 by 2 block closer to the
			-- bottom corner), or an exceptional shift after 10 (top) or 20 (bottom)
			-- iterations without a deflation.
			local tr, ti
			if kdefl % 20 == 0 then
				local hr, hi = H(i, i)
				tr, ti = hr + 0.75 * habs(i, i - 1), hi
			elseif kdefl % 10 == 0 then
				local hr, hi = H(l, l)
				tr, ti = hr + 0.75 * habs(l + 1, l), hi
			else
				tr, ti = H(i, i)
				local br, bi = H(i - 1, i)
				local cr, ci = H(i, i - 1)
				-- (Separate locals: only the last argument of a call expands to all its values.)
				local sbr, sbi = complex64.sqrt(br, bi)
				local scr, sci = complex64.sqrt(cr, ci)
				local ur, ui = complex64.mul(sbr, sbi, scr, sci)
				local s = cabs1(ur, ui)
				if s ~= 0 then
					local ar, ai = H(i - 1, i - 1)
					local xr, xi = 0.5 * (ar - tr), 0.5 * (ai - ti)
					local sx = cabs1(xr, xi)
					s = math.max(s, sx)
					local qr, qi = complex64.mul(xr / s, xi / s, xr / s, xi / s)
					local pr, pi = complex64.mul(ur / s, ui / s, ur / s, ui / s)
					local yr, yi = complex64.sqrt(qr + pr, qi + pi)
					yr, yi = s * yr, s * yi
					if sx > 0 and (xr / sx) * yr + (xi / sx) * yi < 0 then
						yr, yi = -yr, -yi
					end
					local dr, di = complex64.div(ur, ui, xr + yr, xi + yi)
					local er, ei = complex64.mul(ur, ui, dr, di)
					tr, ti = tr - er, ti - ei
				end
			end

			-- Look for two consecutive small subdiagonal entries, to start lower.
			local m = i - 1
			local v1r, v1i, v2r, v2i = 0, 0, 0, 0
			while true do
				local h11r, h11i = H(m, m)
				local h22r, h22i = H(m + 1, m + 1)
				local sr, si = h11r - tr, h11i - ti
				local h21r, h21i = H(m + 1, m)
				local s = cabs1(sr, si) + cabs1(h21r, h21i)
				v1r, v1i, v2r, v2i = sr / s, si / s, h21r / s, h21i / s
				if m == l then
					break
				end
				local h10 = habs(m, m - 1)
				if h10 * cabs1(v2r, v2i) <= ulp * (cabs1(v1r, v1i) * (cabs1(h11r, h11i) + cabs1(h22r, h22i))) then
					break
				end
				m -= 1
			end

			-- The single-shift step: chase the bulge from row m to the bottom.
			for k2 = m, i - 1 do
				if k2 > m then
					v1r, v1i = H(k2, k2 - 1)
					v2r, v2i = H(k2 + 1, k2 - 1)
				end
				local beta, t1r, t1i, w2r, w2i = small_reflector(v1r, v1i, v2r, v2i)
				if k2 > m then
					set(k2, k2 - 1, beta, 0)
					set(k2 + 1, k2 - 1, 0, 0)
				elseif m > l then
					-- H^H applied to (h, 0): h (1 - conj tau)
					local hr, hi = H(k2, k2 - 1)
					set(k2, k2 - 1, complex64.mul(hr, hi, 1 - t1r, t1i))
				end
				if t1r ~= 0 or t1i ~= 0 then
					-- From the left, H^H = I - conj(tau) v v^H, on rows k2, k2+1.
					for j = k2, i2 do
						local o = 8 * (j * n + k2)
						local ar, ai = buffer.readf32(h, o), buffer.readf32(h, o + 4)
						local br, bi = buffer.readf32(h, o + 8), buffer.readf32(h, o + 8 + 4)
						-- conj(tau) (a + conj(w2) b)
						local sr, si = ar + w2r * br + w2i * bi, ai + w2r * bi - w2i * br
						sr, si = t1r * sr + t1i * si, t1r * si - t1i * sr
						buffer.writef32(h, o, ar - sr)
						buffer.writef32(h, o + 4, ai - si)
						buffer.writef32(h, o + 8, br - (sr * w2r - si * w2i))
						buffer.writef32(h, o + 8 + 4, bi - (sr * w2i + si * w2r))
					end
					-- From the right, H = I - tau v v^H, on columns k2, k2+1.
					local function right(buf: buffer, first: number, last: number)
						local c0, c1 = 8 * (k2 * n), 8 * ((k2 + 1) * n)
						for j = first, last do
							local o = 8 * j
							local ar, ai = buffer.readf32(buf, c0 + o), buffer.readf32(buf, c0 + o + 4)
							local br, bi = buffer.readf32(buf, c1 + o), buffer.readf32(buf, c1 + o + 4)
							-- tau (a + w2 b)
							local sr, si = ar + w2r * br - w2i * bi, ai + w2r * bi + w2i * br
							sr, si = t1r * sr - t1i * si, t1r * si + t1i * sr
							buffer.writef32(buf, c0 + o, ar - sr)
							buffer.writef32(buf, c0 + o + 4, ai - si)
							-- b - s conj(w2)
							buffer.writef32(buf, c1 + o, br - (sr * w2r + si * w2i))
							buffer.writef32(buf, c1 + o + 4, bi - (si * w2r - sr * w2i))
						end
					end
					right(h, i1, math.min(k2 + 2, i))
					if z then
						right(z, 0, n - 1)
					end
				end
			end
		end
		if not converged then
			error("eig: the QR iteration did not converge")
		end
		wr[i + 1], wi[i + 1] = H(i, i)
		kdefl = 0
		i = l - 1
	end
	return wr, wi
end

-- Overwrites the columns of Z with unit eigenvectors of A = Z T Z^H, given the upper
-- triangular T of a complex Schur factorization: column k belongs to T's k-th diagonal
-- entry. (LAPACK's trevc followed by the back-transformation, normalized to unit length.)
local function eigvecs_from_schur(T: Matrix, Z: Matrix)
	local n = T.rows
	assert(T.cols == n and Z.rows == n and Z.cols == n, "matrix sizes do not match")
	local t, zb = T.data, Z.data
	local xr, xi = table.create(n, 0), table.create(n, 0)
	local cr, ci = table.create(n, 0), table.create(n, 0)
	local ulp = 2 * EPS
	local smlnum = 2 ^ -1000 * (n / ulp)
	-- Descending, so the columns of Z still needed are not yet overwritten.
	for k = n - 1, 0, -1 do
		local lo = 8 * (k * n + k)
		local lr, li = buffer.readf32(t, lo), buffer.readf32(t, lo + 4)
		local smin = math.max(ulp * cabs1(lr, li), smlnum)
		-- Solve (T[0..k-1, 0..k-1] - lambda) x = -T[0..k-1, k], with x_k = 1.
		xr[k + 1], xi[k + 1] = 1, 0
		for r = 0, k - 1 do
			local o = 8 * (k * n + r)
			xr[r + 1], xi[r + 1] = -buffer.readf32(t, o), -buffer.readf32(t, o + 4)
		end
		for j = k - 1, 0, -1 do
			local o = 8 * (j * n + j)
			local dr, di = buffer.readf32(t, o) - lr, buffer.readf32(t, o + 4) - li
			-- Perturb a (nearly) repeated eigenvalue, as trevc does.
			if cabs1(dr, di) < smin then
				dr, di = smin, 0
			end
			local yr, yi = complex64.div(xr[j + 1], xi[j + 1], dr, di)
			-- Rescale everything if the solution is about to overflow.
			local size = cabs1(yr, yi)
			if size > 2 ^ 500 then
				local f = 1 / size
				for r = 1, k + 1 do
					xr[r], xi[r] = xr[r] * f, xi[r] * f
				end
				yr, yi = yr * f, yi * f
			end
			xr[j + 1], xi[j + 1] = yr, yi
			for r = 0, j - 1 do
				local q = 8 * (j * n + r)
				local tr, ti = buffer.readf32(t, q), buffer.readf32(t, q + 4)
				xr[r + 1] -= tr * yr - ti * yi
				xi[r + 1] -= tr * yi + ti * yr
			end
		end
		-- Back-transform: column k := Z[:, 0..k] x, then normalize.
		for r = 1, n do
			cr[r], ci[r] = 0, 0
		end
		for j = 0, k do
			local pr, pi = xr[j + 1], xi[j + 1]
			local col = 8 * (j * n)
			for r = 0, n - 1 do
				local zr, zi = buffer.readf32(zb, col + 8 * r), buffer.readf32(zb, col + 8 * r + 4)
				cr[r + 1] += zr * pr - zi * pi
				ci[r + 1] += zr * pi + zi * pr
			end
		end
		local big = 0
		for r = 1, n do
			big = math.max(big, math.abs(cr[r]), math.abs(ci[r]))
		end
		local s = 0
		if big > 0 then
			for r = 1, n do
				local a, b = cr[r] / big, ci[r] / big
				s += a * a + b * b
			end
		end
		local scale = if big > 0 then 1 / (big * math.sqrt(s)) else 0
		local col = 8 * (k * n)
		for r = 0, n - 1 do
			buffer.writef32(zb, col + 8 * r, cr[r + 1] * scale)
			buffer.writef32(zb, col + 8 * r + 4, ci[r + 1] * scale)
		end
	end
end

-- Reduces A to Hessenberg form and runs complex_schur on it; returns the Schur vectors
-- (if wantz) and the eigenvalues. With ilo and ihi (from balance), only that block is iterated on.
local function schur_impl(A: Matrix, wantt: boolean, wantz: boolean, ilo: number?, ihi: number?): (Matrix?, { number }, { number })
	local n = A.rows
	assert(A.cols == n, "matrix must be square")
	if any_nonfinite(A.data, 0, 2 * n * n) then
		-- NaN or infinity in, NaN out: T, Z and the eigenvalues.
		fill_nan(A.data, 0, 2 * n * n)
		local Z = if wantz then matrix(n, n) else nil
		if Z then
			fill_nan(Z.data, 0, 2 * n * n)
		end
		return Z, table.create(n, 0 / 0) :: { number }, table.create(n, 0 / 0) :: { number }
	end
	local lo, hi = ilo or 0, ihi or n - 1
	local F = hess_range(A, lo, hi)
	local Z = if wantz then hess_q(nil, F) else nil
	local a = A.data
	for j = 0, n - 3 do
		for i = j + 2, n - 1 do
			buffer.writef32(a, 8 * (j * n + i), 0)
			buffer.writef32(a, 8 * (j * n + i) + 4, 0)
		end
	end
	local wr, wi = complex_schur(a, n, wantt, if Z then Z.data else nil, lo, hi)
	return Z, wr, wi
end

local function complex_values(wr: { number }, wi: { number }): buffer
	local values = buffer.create(8 * #wr)
	for k = 1, #wr do
		buffer.writef32(values, 8 * (k - 1), wr[k])
		buffer.writef32(values, 8 * (k - 1) + 4, wi[k])
	end
	return values
end

-- Complex Schur factorization A = Z T Z^H, in place: A is overwritten with the upper
-- triangular T. Z is computed unless vectors is false. values holds T's diagonal (the
-- eigenvalues). If A holds a NaN or an infinity, T, Z and the values are all NaN.
-- schur_copy leaves A unchanged.
local function schur(A: Matrix, vectors: boolean?): Schur
	-- Scaled into a safe range and back (Z does not change).
	local sc = range_scale(A.data)
	local Z, wr, wi = schur_impl(A, true, vectors ~= false)
	if sc ~= 1 then
		scale(A.data, 1 / sc, A.data)
		for k = 1, #wr do
			wr[k] /= sc
			wi[k] /= sc
		end
	end
	return { schur = A, z = Z, values = complex_values(wr, wi) }
end

-- Complex Schur factorization of a copy of A; A is not modified.
local function schur_copy(A: Matrix, vectors: boolean?): Schur
	return schur(matcopy(nil, A), vectors)
end

-- What balance did: rows and columns ilo..ihi (0-based) form the block left to the
-- eigensolver, scale holds the diagonal of D, and swaps lists the row/column exchanges in
-- order (as pairs).
type Balance = { ilo: number, ihi: number, scale: { number }, swaps: { number } }

-- Balances the square matrix A in place, as LAPACK's gebal does:
-- 1. Permutation: a row that is zero off the diagonal isolates an eigenvalue (its diagonal
--    entry) and is moved to the bottom; a column that is zero off the diagonal likewise, to
--    the top. Repeating this leaves A block upper triangular, with triangular blocks
--    outside rows and columns ilo..ihi, so only that block needs the QR algorithm.
-- 2. Scaling: A := D^-1 A D on that block, with D a diagonal of powers of 2 (exact),
--    chosen so each row and the matching column have similar 2-norms. The eigenvalues are
--    unchanged but computed more accurately when A is badly scaled, because the
--    eigensolver's error is proportional to |A|.
-- Eigenvectors of the original A are P D times those of the balanced matrix (unbalance).
local function balance(A: Matrix): Balance
	local n = A.rows
	local a = A.data
	local function at(i: number, j: number): number
		return 8 * (j * n + i)
	end
	local function nonzero(o: number): boolean
		return buffer.readf32(a, o) ~= 0 or buffer.readf32(a, o + 4) ~= 0
	end
	local swaps = {}
	-- Exchanges rows i and j and columns i and j (a permutation similarity).
	local function exchange(i: number, j: number)
		if i == j then
			return
		end
		table.insert(swaps, i)
		table.insert(swaps, j)
		local function swap(s: number, t: number)
			for part = 0, 4, 4 do
				local tmp = buffer.readf32(a, s + part)
				buffer.writef32(a, s + part, buffer.readf32(a, t + part))
				buffer.writef32(a, t + part, tmp)
			end
		end
		for k = 0, n - 1 do
			swap(at(k, i), at(k, j))
		end
		for k = 0, n - 1 do
			swap(at(i, k), at(j, k))
		end
	end
	local lo, hi = 0, n - 1
	-- Rows zero off the diagonal (in columns 0..hi): move to the bottom.
	local found = true
	while found and hi > 0 do
		found = false
		for j = hi, 0, -1 do
			local zero = true
			for c = 0, hi do
				if c ~= j and nonzero(at(j, c)) then
					zero = false
					break
				end
			end
			if zero then
				exchange(j, hi)
				hi -= 1
				found = true
				break
			end
		end
	end
	-- Columns zero off the diagonal (in rows lo..hi): move to the top.
	found = true
	while found and lo < hi do
		found = false
		for j = lo, hi do
			local zero = true
			for r = lo, hi do
				if r ~= j and nonzero(at(r, j)) then
					zero = false
					break
				end
			end
			if zero then
				exchange(j, lo)
				lo += 1
				found = true
				break
			end
		end
	end
	-- Scaling of the block lo..hi.
	local d = table.create(n, 1)
	local function rownorm(i: number): number
		local big = 0
		for j = lo, hi do
			local o = at(i, j)
			big = math.max(big, math.abs(buffer.readf32(a, o)), math.abs(buffer.readf32(a, o + 4)))
		end
		if big == 0 then
			return 0
		end
		local s = 0
		for j = lo, hi do
			local o = at(i, j)
			local vr, vi = buffer.readf32(a, o) / big, buffer.readf32(a, o + 4) / big
			s += vr * vr + vi * vi
		end
		return big * math.sqrt(s)
	end
	local converged = false
	while not converged do
		converged = true
		for i = lo, hi do
			local c, r = segment_norm(a, at(lo, i), 2 * (hi - lo + 1)), rownorm(i)
			if c > 0 and r > 0 then
				-- Column i times f and row i divided by f have norms about c f and r / f; take
				-- the power of 2 that brings those within a factor of 2 of each other.
				local f, cf, rf = 1, c, r
				while cf < rf / 2 and f < 2 ^ 500 do
					f, cf, rf = f * 2, cf * 2, rf / 2
				end
				while cf >= rf * 2 and f > 2 ^ -500 do
					f, cf, rf = f / 2, cf / 2, rf * 2
				end
				if cf + rf < 0.95 * (c + r) then
					converged = false
					d[i + 1] *= f
					for j = 0, n - 1 do
						local o, p = at(i, j), at(j, i)
						buffer.writef32(a, o, buffer.readf32(a, o) / f)
						buffer.writef32(a, o + 4, buffer.readf32(a, o + 4) / f)
						buffer.writef32(a, p, buffer.readf32(a, p) * f)
						buffer.writef32(a, p + 4, buffer.readf32(a, p + 4) * f)
					end
				end
			end
		end
	end
	return { ilo = lo, ihi = hi, scale = d, swaps = swaps }
end

-- Maps eigenvectors of a balanced matrix back (x = P D x') and rescales each to unit length.
local function unbalance(v: buffer, n: number, B: Balance)
	local d, swaps = B.scale, B.swaps
	for j = 0, n - 1 do
		local col = 8 * j * n
		for i = 0, n - 1 do
			local o = col + 8 * i
			buffer.writef32(v, o, buffer.readf32(v, o) * d[i + 1])
			buffer.writef32(v, o + 4, buffer.readf32(v, o + 4) * d[i + 1])
		end
		-- Undo the exchanges, last first.
		for s = #swaps - 1, 1, -2 do
			local p, q = col + 8 * swaps[s], col + 8 * swaps[s + 1]
			for part = 0, 4, 4 do
				local tmp = buffer.readf32(v, p + part)
				buffer.writef32(v, p + part, buffer.readf32(v, q + part))
				buffer.writef32(v, q + part, tmp)
			end
		end
		local nrm = segment_norm(v, col, 2 * n)
		if nrm > 0 then
			for k = col, col + 8 * n - 4, 4 do
				buffer.writef32(v, k, buffer.readf32(v, k) / nrm)
			end
		end
	end
end

-- Eigenvalues and, unless vectors is false, unit eigenvectors of a general complex
-- matrix: column k of vectors belongs to values[k]. Unless balanced is false, A is
-- balanced first (permuted and scaled; see balance), as LAPACK's geev does by default. A
-- is overwritten with the (balanced) Schur form, or with workspace if vectors is false;
-- the eigenvectors are a new matrix. If A holds a NaN or an infinity, the values, the
-- vectors and A are all NaN. eig_copy leaves A unchanged.
local function eig(A: Matrix, vectors: boolean?, balanced: boolean?): Eig
	local want = vectors ~= false
	assert(A.cols == A.rows, "matrix must be square")
	if any_nonfinite(A.data, 0, 2 * A.rows * A.rows) then
		-- schur_impl returns NaN for everything.
		local Z, wr, wi = schur_impl(A, want, want)
		return { values = complex_values(wr, wi), vectors = Z }
	end
	-- Scaled into a safe range (see range_scale); the values and A are scaled back at the
	-- end, and the vectors do not change.
	local sc = range_scale(A.data)
	local bal = if balanced ~= false then balance(A) else nil
	local Z, wr, wi = schur_impl(A, want, want, if bal then bal.ilo else nil, if bal then bal.ihi else nil)
	if Z then
		eigvecs_from_schur(A, Z)
		if bal then
			unbalance(Z.data, A.rows, bal)
		end
	end
	if sc ~= 1 then
		scale(A.data, 1 / sc, A.data)
		for k = 1, #wr do
			wr[k] /= sc
			wi[k] /= sc
		end
	end
	return { values = complex_values(wr, wi), vectors = Z }
end

-- Eigendecomposition of a copy of A; A is not modified.
local function eig_copy(A: Matrix, vectors: boolean?, balanced: boolean?): Eig
	return eig(matcopy(nil, A), vectors, balanced)
end

-- Singular value decomposition

-- Rotation (c, s, r) with c f + s g = r and -s f + c g = 0 (LAPACK's lartg).
local function lartg(f: number, g: number): (number, number, number)
	if g == 0 then
		return 1, 0, f
	elseif f == 0 then
		return 0, 1, g
	end
	local r = hypot3(f, g, 0)
	if f < 0 then
		r = -r
	end
	return f / r, g / r, r
end

-- Singular values (smaller, larger) of [f g; 0 h] (LAPACK's las2).
local function las2(f: number, g: number, h: number): (number, number)
	local fa, ga, ha = math.abs(f), math.abs(g), math.abs(h)
	local fhmn, fhmx = math.min(fa, ha), math.max(fa, ha)
	if fhmn == 0 then
		if fhmx == 0 then
			return 0, ga
		end
		local big, small = math.max(fhmx, ga), math.min(fhmx, ga)
		return 0, big * math.sqrt(1 + (small / big) ^ 2)
	elseif ga < fhmx then
		local as = 1 + fhmn / fhmx
		local at = (fhmx - fhmn) / fhmx
		local au = (ga / fhmx) ^ 2
		local c = 2 / (math.sqrt(as * as + au) + math.sqrt(at * at + au))
		return fhmn * c, fhmx / c
	end
	local au = fhmx / ga
	if au == 0 then
		return (fhmn * fhmx) / ga, ga
	end
	local as = 1 + fhmn / fhmx
	local at = (fhmx - fhmn) / fhmx
	local c = 1 / (math.sqrt(1 + (as * au) ^ 2) + math.sqrt(1 + (at * au) ^ 2))
	return 2 * (fhmn * c) * au, ga / (c + c)
end

-- SVD of [f g; 0 h] (LAPACK's lasv2): returns ssmin, ssmax (signed) and the rotations
-- (snr, csr) and (snl, csl) with
-- [csl snl; -snl csl] [f g; 0 h] [csr -snr; snr csr] = [ssmax 0; 0 ssmin].
local function lasv2(f: number, g: number, h: number): (number, number, number, number, number, number)
	local function sign(a: number, b: number): number
		return if b >= 0 then math.abs(a) else -math.abs(a)
	end
	local ft, fa, ht, ha = f, math.abs(f), h, math.abs(h)
	-- pmax: which entry has the largest magnitude (1 = f, 2 = g, 3 = h).
	local pmax = 1
	local swap = ha > fa
	if swap then
		pmax = 3
		ft, ht = ht, ft
		fa, ha = ha, fa
	end
	local gt, ga = g, math.abs(g)
	local clt, crt, slt, srt = 1, 1, 0, 0
	local ssmin: number, ssmax: number = 0, 0
	if ga == 0 then
		ssmin, ssmax = ha, fa
	else
		local gasmal = true
		if ga > fa then
			pmax = 2
			if fa / ga < 2 ^ -53 then
				-- g is far larger than the diagonal.
				gasmal = false
				ssmax = ga
				ssmin = if ha > 1 then fa / (ga / ha) else (fa / ga) * ha
				clt, slt, srt, crt = 1, ht / gt, 1, ft / gt
			end
		end
		if gasmal then
			local dd = fa - ha
			local l = if dd == fa then 1 else dd / fa
			local m = gt / ft
			local t = 2 - l
			local mm, tt = m * m, t * t
			local s = math.sqrt(tt + mm)
			local r = if l == 0 then math.abs(m) else math.sqrt(l * l + mm)
			local a = 0.5 * (s + r)
			ssmin, ssmax = ha / a, fa * a
			if mm == 0 then
				t = if l == 0 then sign(2, ft) * sign(1, gt) else gt / sign(dd, ft) + m / t
			else
				t = (m / (s + t) + m / (r + l)) * (1 + a)
			end
			l = math.sqrt(t * t + 4)
			crt, srt = 2 / l, t / l
			clt = (crt + srt * m) / a
			slt = (ht / ft) * srt / a
		end
	end
	local csl, snl, csr, snr
	if swap then
		csl, snl, csr, snr = srt, crt, slt, clt
	else
		csl, snl, csr, snr = clt, slt, crt, srt
	end
	local tsign
	if pmax == 1 then
		tsign = sign(1, csr) * sign(1, csl) * sign(1, f)
	elseif pmax == 2 then
		tsign = sign(1, snr) * sign(1, csl) * sign(1, g)
	else
		tsign = sign(1, snr) * sign(1, snl) * sign(1, h)
	end
	ssmax = sign(ssmax, tsign)
	ssmin = sign(ssmin, tsign * sign(1, f) * sign(1, h))
	return ssmin, ssmax, snr, csr, snl, csl
end

-- Singular values of the real upper bidiagonal matrix with diagonal d[1..n] and
-- superdiagonal e[1..n-1] (LAPACK's bdsqr): implicit QR with shifts from the trailing
-- (or leading) 2 by 2 block, and Demmel and Kahan's zero-shift sweeps whenever a shift
-- would spoil the relative accuracy of the small singular values. d and e are Luau
-- tables, so the iteration runs in double precision. On return d holds the singular
-- values in descending order and e is destroyed. If u (urows by n) and v (vrows by n)
-- are given, with PARTS reals per entry, the left rotations are applied to the columns
-- of u and the right ones to the columns of v, and both are sorted with the values.
local function bidiagonal_svd(d: { number }, e: { number }, n: number, u: buffer?, urows: number, v: buffer?, vrows: number)
	if n == 0 then
		return
	end
	-- Columns p and q (1-based) of buf := [c p + s q, c q - s p].
	local function rotate(buf: buffer, rows: number, p: number, q: number, c: number, s: number)
		local column = 4 * PARTS * rows
		local op, oq = column * (p - 1), column * (q - 1)
		for i = 0, PARTS * rows - 1 do
			local x, y = buffer.readf32(buf, op + 4 * i), buffer.readf32(buf, oq + 4 * i)
			buffer.writef32(buf, op + 4 * i, c * x + s * y)
			buffer.writef32(buf, oq + 4 * i, c * y - s * x)
		end
	end
	local function rotv(p: number, q: number, c: number, s: number)
		if v then
			rotate(v, vrows, p, q, c, s)
		end
	end
	local function rotu(p: number, q: number, c: number, s: number)
		if u then
			rotate(u, urows, p, q, c, s)
		end
	end

	local eps = 2 ^ -53
	local tol = math.max(10, math.min(100, eps ^ (-1 / 8))) * eps
	local maxitr = 6

	-- Threshold for negligible entries, from an estimate of the smallest singular value.
	local sminoa = math.abs(d[1])
	local mu = sminoa
	for i = 2, n do
		if sminoa == 0 then
			break
		end
		mu = math.abs(d[i]) * (mu / (mu + math.abs(e[i - 1])))
		sminoa = math.min(sminoa, mu)
	end
	sminoa /= math.sqrt(n)
	local thresh = math.max(tol * sminoa, maxitr * n * n * 2 ^ -1022)
	local maxit = maxitr * n * n
	local iter = 0
	local oldll, oldm = -1, -1
	local idir = 0

	local m = n
	while m > 1 do
		if iter > maxit then
			error("svd: the QR iteration did not converge")
		end
		-- Find the unreduced block ll..m.
		local smax = math.abs(d[m])
		local ll = 0
		for idx = m - 1, 1, -1 do
			local abss, abse = math.abs(d[idx]), math.abs(e[idx])
			if abse <= thresh then
				ll = idx
				break
			end
			smax = math.max(smax, abss, abse)
		end
		if ll > 0 then
			e[ll] = 0
			if ll == m - 1 then
				-- The bottom value has converged.
				m -= 1
				continue
			end
		end
		ll += 1

		if ll == m - 1 then
			-- A 2 by 2 block: solve it directly.
			local sigmn, sigmx, sinr, cosr, sinl, cosl = lasv2(d[m - 1], e[m - 1], d[m])
			d[m - 1], e[m - 1], d[m] = sigmx, 0, sigmn
			rotv(m - 1, m, cosr, sinr)
			rotu(m - 1, m, cosl, sinl)
			m -= 2
			continue
		end

		-- For a new block, chase toward the smaller end: down if graded downward.
		if ll > oldm or m < oldll then
			idir = if math.abs(d[ll]) >= math.abs(d[m]) then 1 else 2
		end

		-- Convergence tests that preserve relative accuracy; sminl estimates the smallest
		-- singular value of the block.
		local sminl = 0
		local split = false
		if idir == 1 then
			if math.abs(e[m - 1]) <= tol * math.abs(d[m]) then
				e[m - 1] = 0
				continue
			end
			mu = math.abs(d[ll])
			sminl = mu
			for i = ll, m - 1 do
				if math.abs(e[i]) <= tol * mu then
					e[i] = 0
					split = true
					break
				end
				mu = math.abs(d[i + 1]) * (mu / (mu + math.abs(e[i])))
				sminl = math.min(sminl, mu)
			end
		else
			if math.abs(e[ll]) <= tol * math.abs(d[ll]) then
				e[ll] = 0
				continue
			end
			mu = math.abs(d[m])
			sminl = mu
			for i = m - 1, ll, -1 do
				if math.abs(e[i]) <= tol * mu then
					e[i] = 0
					split = true
					break
				end
				mu = math.abs(d[i]) * (mu / (mu + math.abs(e[i])))
				sminl = math.min(sminl, mu)
			end
		end
		if split then
			continue
		end
		oldll, oldm = ll, m

		-- Shift: the smaller singular value of the 2 by 2 block at the far end, unless it
		-- would destroy the relative accuracy of the small values; then use zero.
		local shift = 0
		if n * tol * (sminl / smax) > math.max(eps, 0.01 * tol) then
			local sll
			if idir == 1 then
				sll = math.abs(d[ll])
				shift = las2(d[m - 1], e[m - 1], d[m])
			else
				sll = math.abs(d[m])
				shift = las2(d[ll], e[ll], d[ll + 1])
			end
			if sll > 0 and (shift / sll) ^ 2 < eps then
				shift = 0
			end
		end
		iter += m - ll

		if shift == 0 then
			-- Demmel and Kahan's zero-shift QR sweep.
			local cs, sn, oldcs, oldsn, r = 1, 0, 1, 0, 0
			if idir == 1 then
				for i = ll, m - 1 do
					cs, sn, r = lartg(d[i] * cs, e[i])
					if i > ll then
						e[i - 1] = oldsn * r
					end
					oldcs, oldsn, d[i] = lartg(oldcs * r, d[i + 1] * sn)
					rotv(i, i + 1, cs, sn)
					rotu(i, i + 1, oldcs, oldsn)
				end
				local hh = d[m] * cs
				d[m], e[m - 1] = hh * oldcs, hh * oldsn
				if math.abs(e[m - 1]) <= thresh then
					e[m - 1] = 0
				end
			else
				for i = m, ll + 1, -1 do
					cs, sn, r = lartg(d[i] * cs, e[i - 1])
					if i < m then
						e[i] = oldsn * r
					end
					oldcs, oldsn, d[i] = lartg(oldcs * r, d[i - 1] * sn)
					rotv(i - 1, i, oldcs, -oldsn)
					rotu(i - 1, i, cs, -sn)
				end
				local hh = d[ll] * cs
				d[ll], e[ll] = hh * oldcs, hh * oldsn
				if math.abs(e[ll]) <= thresh then
					e[ll] = 0
				end
			end
		else
			-- Shifted QR sweep (chase the bulge).
			if idir == 1 then
				local f = (math.abs(d[ll]) - shift) * ((if d[ll] >= 0 then 1 else -1) + shift / d[ll])
				local g = e[ll]
				for i = ll, m - 1 do
					local cosr, sinr, r = lartg(f, g)
					if i > ll then
						e[i - 1] = r
					end
					f = cosr * d[i] + sinr * e[i]
					e[i] = cosr * e[i] - sinr * d[i]
					g = sinr * d[i + 1]
					d[i + 1] = cosr * d[i + 1]
					local cosl, sinl, r2 = lartg(f, g)
					d[i] = r2
					f = cosl * e[i] + sinl * d[i + 1]
					d[i + 1] = cosl * d[i + 1] - sinl * e[i]
					if i < m - 1 then
						g = sinl * e[i + 1]
						e[i + 1] = cosl * e[i + 1]
					end
					rotv(i, i + 1, cosr, sinr)
					rotu(i, i + 1, cosl, sinl)
				end
				e[m - 1] = f
				if math.abs(e[m - 1]) <= thresh then
					e[m - 1] = 0
				end
			else
				local f = (math.abs(d[m]) - shift) * ((if d[m] >= 0 then 1 else -1) + shift / d[m])
				local g = e[m - 1]
				for i = m, ll + 1, -1 do
					local cosr, sinr, r = lartg(f, g)
					if i < m then
						e[i] = r
					end
					f = cosr * d[i] + sinr * e[i - 1]
					e[i - 1] = cosr * e[i - 1] - sinr * d[i]
					g = sinr * d[i - 1]
					d[i - 1] = cosr * d[i - 1]
					local cosl, sinl, r2 = lartg(f, g)
					d[i] = r2
					f = cosl * e[i - 1] + sinl * d[i - 1]
					d[i - 1] = cosl * d[i - 1] - sinl * e[i - 1]
					if i > ll + 1 then
						g = sinl * e[i - 2]
						e[i - 2] = cosl * e[i - 2]
					end
					rotv(i - 1, i, cosl, -sinl)
					rotu(i - 1, i, cosr, -sinr)
				end
				e[ll] = f
				if math.abs(e[ll]) <= thresh then
					e[ll] = 0
				end
			end
		end
	end

	-- Make the values nonnegative (flipping the matching right vector), then sort them in
	-- descending order with their vectors.
	for i = 1, n do
		if d[i] < 0 then
			d[i] = -d[i]
			if v then
				local column = 4 * PARTS * vrows
				for k = 0, PARTS * vrows - 1 do
					local off = column * (i - 1) + 4 * k
					buffer.writef32(v, off, -buffer.readf32(v, off))
				end
			end
		end
	end
	local function swap(buf: buffer, rows: number, p: number, q: number)
		local column = 4 * PARTS * rows
		local op, oq = column * (p - 1), column * (q - 1)
		for i = 0, PARTS * rows - 1 do
			local tmp = buffer.readf32(buf, op + 4 * i)
			buffer.writef32(buf, op + 4 * i, buffer.readf32(buf, oq + 4 * i))
			buffer.writef32(buf, oq + 4 * i, tmp)
		end
	end
	for i = 1, n - 1 do
		local best = i
		for j = i + 1, n do
			if d[j] > d[best] then
				best = j
			end
		end
		if best ~= i then
			d[i], d[best] = d[best], d[i]
			if u then
				swap(u, urows, i, best)
			end
			if v then
				swap(v, vrows, i, best)
			end
		end
	end
end

-- Reduces A (rows >= cols) to real upper bidiagonal form A = Q B P^H in place (LAPACK's
-- gebd2 for complex matrices), returning B's diagonal d and superdiagonal e as tables.
-- The left reflectors stay below the diagonal of A (as in qr), with their tau in tauq;
-- right reflector k acts on columns k+1.. and stays in row k from column k+2 on, with its
-- tau in taup.
local function bidiagonalize(A: Matrix): ({ number }, { number }, buffer, buffer)
	local m, n = A.rows, A.cols
	local a = A.data
	local tauq = buffer.create(8 * n)
	local taup = buffer.create(8 * math.max(n - 1, 0))
	local d, e = table.create(n, 0), table.create(math.max(n - 1, 0), 0)
	local row = buffer.create(8 * n)
	local wr, wi = table.create(m, 0), table.create(m, 0)
	for k = 0, n - 1 do
		local diag = 8 * (k * m + k)
		local tr, ti = householder(a, diag, m - k, tauq, k)
		d[k + 1] = buffer.readf32(a, diag)
		if tr ~= 0 or ti ~= 0 then
			for j = k + 1, n - 1 do
				reflect(a, diag, m - k, tr, -ti, a, 8 * (j * m + k))
			end
		end
		if k < n - 1 then
			-- The conjugate of row k from column k+1 on is gathered and reflected; v is
			-- put back in the row.
			local len = n - k - 1
			for c = 0, len - 1 do
				local o = 8 * ((k + 1 + c) * m + k)
				buffer.writef32(row, 8 * c, buffer.readf32(a, o))
				buffer.writef32(row, 8 * c + 4, -buffer.readf32(a, o + 4))
			end
			local pr, pi = householder(row, 0, len, taup, k)
			e[k + 1] = buffer.readf32(row, 0)
			for c = 0, len - 1 do
				local o = 8 * ((k + 1 + c) * m + k)
				buffer.writef32(a, o, buffer.readf32(row, 8 * c))
				buffer.writef32(a, o + 4, buffer.readf32(row, 8 * c + 4))
			end
			if pr ~= 0 or pi ~= 0 then
				-- Rows k+1.. of columns k+1..: A := A (I - tau v v^H), v = (1, row[1..]).
				for r = k + 1, m - 1 do
					local o = 8 * ((k + 1) * m + r)
					wr[r + 1], wi[r + 1] = buffer.readf32(a, o), buffer.readf32(a, o + 4)
				end
				for c = 1, len - 1 do
					local vr, vi = buffer.readf32(row, 8 * c), buffer.readf32(row, 8 * c + 4)
					local col = 8 * ((k + 1 + c) * m)
					for r = k + 1, m - 1 do
						local ar, ai = buffer.readf32(a, col + 8 * r), buffer.readf32(a, col + 8 * r + 4)
						wr[r + 1] += ar * vr - ai * vi
						wi[r + 1] += ar * vi + ai * vr
					end
				end
				for c = 0, len - 1 do
					local vr = if c == 0 then 1 else buffer.readf32(row, 8 * c)
					local vi = if c == 0 then 0 else buffer.readf32(row, 8 * c + 4)
					-- tau conj(v_c)
					local fr, fi = pr * vr + pi * vi, pi * vr - pr * vi
					local col = 8 * ((k + 1 + c) * m)
					for r = k + 1, m - 1 do
						local o = col + 8 * r
						local xr, xi = wr[r + 1], wi[r + 1]
						buffer.writef32(a, o, buffer.readf32(a, o) - (xr * fr - xi * fi))
						buffer.writef32(a, o + 4, buffer.readf32(a, o + 4) - (xr * fi + xi * fr))
					end
				end
			end
		end
	end
	return d, e, tauq, taup
end

-- svd for rows >= cols, in place.
local function svd_tall(A: Matrix, want: boolean): Svd
	local m, n = A.rows, A.cols
	if any_nonfinite(A.data, 0, 2 * m * n) then
		local values = buffer.create(4 * n)
		fill_nan(values, 0, n)
		fill_nan(A.data, 0, 2 * m * n)
		local V = if want then matrix(n, n) else nil
		if V then
			fill_nan(V.data, 0, 2 * n * n)
		end
		return { values = values, u = if want then A else nil, v = V }
	end
	-- Scaled into a safe range (see range_scale); the values are scaled back, and U and V
	-- do not change.
	local sc = range_scale(A.data)
	local d, e, tauq, taup = bidiagonalize(A)
	local V: Matrix? = nil
	if want then
		-- V = P from the right reflectors, then U = the first n columns of Q, in A.
		local P = matrix(n, n)
		for k = 0, n - 3 do
			for c = k + 2, n - 1 do
				local s, t = 8 * (c * m + k), 8 * (k * n + c)
				buffer.writef32(P.data, t, buffer.readf32(A.data, s))
				buffer.writef32(P.data, t + 4, buffer.readf32(A.data, s + 4))
			end
		end
		form_reduction_q(P.data, n, math.max(n - 1, 0), taup)
		form_q(A.data, m, 0, m, n, n, tauq)
		V = P
	end
	bidiagonal_svd(d, e, n, if want then A.data else nil, m, if V then V.data else nil, n)
	local values = buffer.create(4 * n)
	for i = 1, n do
		buffer.writef32(values, 4 * (i - 1), d[i])
	end
	if sc ~= 1 then
		scale(values, 1 / sc, values)
	end
	return { values = values, u = if want then A else nil, v = V }
end

-- Singular value decomposition A = U diag(values) V^H: values (descending, nonnegative,
-- a real array of the same precision) and, unless vectors is false, U (rows by k) and V
-- (cols by k) with orthonormal columns, k = min(rows, cols). Golub-Kahan
-- bidiagonalization, then implicit QR on the real bidiagonal in double precision, keeping
-- the small singular values relatively accurate. In place when rows >= cols: A is
-- overwritten with U (or with workspace if vectors is false). A wide A is not modified
-- (its adjoint is decomposed instead). If A holds a NaN or an infinity, every output is
-- NaN. svd_copy never modifies A.
local function svd(A: Matrix, vectors: boolean?): Svd
	if A.rows < A.cols then
		local F = svd_tall(adjoint(nil, A), vectors ~= false)
		return { values = F.values, u = F.v, v = F.u }
	end
	return svd_tall(A, vectors ~= false)
end

-- Singular value decomposition of a copy of A; A is not modified.
local function svd_copy(A: Matrix, vectors: boolean?): Svd
	if A.rows < A.cols then
		return svd(A, vectors)
	end
	return svd(matcopy(nil, A), vectors)
end

-- The minimum-norm least-squares solution x = A^+ b for any shape and rank, given
-- F = svd(A) with its vectors: x = sum over i <= r of v_i (u_i^H b) / s_i, where r counts
-- the singular values above tol * s_1 (default tol = max(rows, cols) * eps, as for
-- qrp_rank); smaller ones are treated as zero. Unlike qrp_solve's basic solution, x is the
-- shortest of all least-squares solutions. b is not modified. Also returns the residual
-- norm |A x - b| and r. NaN singular values (from non-finite input) give a NaN x.
local function svd_solve(out: buffer?, F: Svd, b: buffer, tol: number?): (buffer, number, number)
	local U, V = F.u, F.v
	assert(U ~= nil and V ~= nil, "svd_solve needs the singular vectors")
	local m, n, k = U.rows, V.rows, U.cols
	assert(length(b) == m, "b has the wrong length")
	local s, u, v = F.values, U.data, V.data
	local o = output(out, 8 * n)
	if k > 0 and buffer.readf32(s, 0) ~= buffer.readf32(s, 0) then
		fill_nan(o, 0, 2 * n)
		return o, 0 / 0, 0
	end
	local limit = (tol or math.max(m, n) * EPS) * (if k > 0 then buffer.readf32(s, 0) else 0)
	local r = 0
	while r < k and buffer.readf32(s, 4 * r) > limit do
		r += 1
	end
	-- The residual b - U_r U_r^H b, projected one column at a time, and x.
	local rr, ri = table.create(m, 0), table.create(m, 0)
	for i = 1, m do
		rr[i], ri[i] = buffer.readf32(b, 8 * (i - 1)), buffer.readf32(b, 8 * (i - 1) + 4)
	end
	local xr, xi = table.create(n, 0), table.create(n, 0)
	for j = 0, r - 1 do
		local col = 8 * j * m
		-- c = u_j^H res
		local cr, ci = 0, 0
		for i = 0, m - 1 do
			local ur, ui = buffer.readf32(u, col + 8 * i), buffer.readf32(u, col + 8 * i + 4)
			cr += ur * rr[i + 1] + ui * ri[i + 1]
			ci += ur * ri[i + 1] - ui * rr[i + 1]
		end
		for i = 0, m - 1 do
			local ur, ui = buffer.readf32(u, col + 8 * i), buffer.readf32(u, col + 8 * i + 4)
			rr[i + 1] -= cr * ur - ci * ui
			ri[i + 1] -= cr * ui + ci * ur
		end
		local sj = buffer.readf32(s, 4 * j)
		local wr, wi = cr / sj, ci / sj
		local vcol = 8 * j * n
		for i = 0, n - 1 do
			local vr, vi = buffer.readf32(v, vcol + 8 * i), buffer.readf32(v, vcol + 8 * i + 4)
			xr[i + 1] += wr * vr - wi * vi
			xi[i + 1] += wr * vi + wi * vr
		end
	end
	for i = 1, n do
		buffer.writef32(o, 8 * (i - 1), xr[i])
		buffer.writef32(o, 8 * (i - 1) + 4, xi[i])
	end
	local big = 0
	for i = 1, m do
		big = math.max(big, math.abs(rr[i]), math.abs(ri[i]))
	end
	local ss = 0
	if big > 0 then
		for i = 1, m do
			ss += (rr[i] / big) ^ 2 + (ri[i] / big) ^ 2
		end
	end
	return o, big * math.sqrt(ss), r
end

-- The pseudoinverse A^+ = V S^+ U^H (cols by rows), by the SVD of a copy of A; singular
-- values at or below tol * s_1 (default max(rows, cols) * eps, as for svd_solve) count as
-- zero. A is not modified. NaN or infinite input gives an all-NaN result. To apply A^+ to
-- vectors, solving with form "svd" is cheaper than forming it.
local function pinv(A: Matrix, tol: number?): Matrix
	local m, n = A.rows, A.cols
	local F = svd_copy(A)
	local U, V = F.u :: Matrix, F.v :: Matrix
	local k, s = U.cols, F.values
	local X = matrix(n, m)
	if k > 0 and buffer.readf32(s, 0) ~= buffer.readf32(s, 0) then
		fill_nan(X.data, 0, 2 * n * m)
		return X
	end
	local limit = (tol or math.max(m, n) * EPS) * (if k > 0 then buffer.readf32(s, 0) else 0)
	local u, v, x = U.data, V.data, X.data
	local rr, ri = table.create(n, 0), table.create(n, 0)
	-- Column q of X is sum over i of v_i (conj(u_qi) / s_i).
	for i = 0, k - 1 do
		local si = buffer.readf32(s, 4 * i)
		if not (si > limit) then
			break
		end
		for p = 0, n - 1 do
			local o = 8 * (i * n + p)
			rr[p + 1], ri[p + 1] = buffer.readf32(v, o) / si, buffer.readf32(v, o + 4) / si
		end
		for q = 0, m - 1 do
			local o = 8 * (i * m + q)
			local cr, ci = buffer.readf32(u, o), -buffer.readf32(u, o + 4)
			if cr ~= 0 or ci ~= 0 then
				local col = 8 * q * n
				for p = 0, n - 1 do
					local t = col + 8 * p
					buffer.writef32(x, t, buffer.readf32(x, t) + cr * rr[p + 1] - ci * ri[p + 1])
					buffer.writef32(x, t + 4, buffer.readf32(x, t + 4) + cr * ri[p + 1] + ci * rr[p + 1])
				end
			end
		end
	end
	return X
end

-- Fast Fourier transform

-- exp(-2 pi i k / n) as (re, im). k is reduced mod n first, so the angle stays accurate
-- for large k.
local function root(k: number, n: number): (number, number)
	local a = -2 * math.pi * (k % n) / n
	return math.cos(a), math.sin(a)
end

local SQRT3_2 = math.sqrt(3) / 2
local C1, C2 = math.cos(2 * math.pi / 5), math.cos(4 * math.pi / 5)
local S1, S2 = math.sin(2 * math.pi / 5), math.sin(4 * math.pi / 5)

-- Plans by length. Weak values: a plan nobody holds may be collected and rebuilt later.
local plan_cache: { [number]: FFTPlan } = setmetatable({}, { __mode = "v" }) :: any

-- Radices for the Stockham passes (4s, then 2s, then odd primes up to 13), or nil when a
-- larger prime factor makes Bluestein's algorithm the better choice.
local function radices_of(n: number): { number }?
	local r = {}
	while n % 4 == 0 do
		table.insert(r, 4)
		n //= 4
	end
	while n % 2 == 0 do
		table.insert(r, 2)
		n //= 2
	end
	local p = 3
	while n > 1 and p <= 13 do
		while n % p == 0 do
			table.insert(r, p)
			n //= p
		end
		p += 2
	end
	return if n == 1 then r else nil
end

-- One pass of the self-sorting (Stockham) decimation-in-frequency FFT. For the stage of
-- length L with radix p, m = L / p, and stride s:
--   dst[q + s (p j + k)] = w_L^(j k) sum_r src[q + s (j + r m)] w_p^(r k).
local function stockham_pass(src: buffer, dst: buffer, stage: any, s: number)
	local p, L, tw, wp = stage.p, stage.L, stage.tw, stage.wp
	local m = L // p
	local sE = 8 * s
	if p == 4 then
		for j = 0, m - 1 do
			local t = 8 * j
			local w1r, w1i, w2r, w2i, w3r, w3i = tw[t + 3], tw[t + 4], tw[t + 5], tw[t + 6], tw[t + 7], tw[t + 8]
			local i0, mE = 8 * s * j, 8 * s * m
			local o0 = 8 * s * 4 * j
			for q = 0, s - 1 do
				local a = i0 + 8 * q
				local a0r, a0i = buffer.readf32(src, a), buffer.readf32(src, a + 4)
				local a1r, a1i = buffer.readf32(src, a + mE), buffer.readf32(src, a + mE + 4)
				local a2r, a2i = buffer.readf32(src, a + 2 * mE), buffer.readf32(src, a + 2 * mE + 4)
				local a3r, a3i = buffer.readf32(src, a + 3 * mE), buffer.readf32(src, a + 3 * mE + 4)
				local t0r, t0i, t1r, t1i = a0r + a2r, a0i + a2i, a0r - a2r, a0i - a2i
				local t2r, t2i, t3r, t3i = a1r + a3r, a1i + a3i, a1r - a3r, a1i - a3i
				-- b1 = t1 - i t3, b3 = t1 + i t3
				local b1r, b1i = t1r + t3i, t1i - t3r
				local b2r, b2i = t0r - t2r, t0i - t2i
				local b3r, b3i = t1r - t3i, t1i + t3r
				local o = o0 + 8 * q
				buffer.writef32(dst, o, t0r + t2r)
				buffer.writef32(dst, o + 4, t0i + t2i)
				buffer.writef32(dst, o + sE, b1r * w1r - b1i * w1i)
				buffer.writef32(dst, o + sE + 4, b1r * w1i + b1i * w1r)
				buffer.writef32(dst, o + 2 * sE, b2r * w2r - b2i * w2i)
				buffer.writef32(dst, o + 2 * sE + 4, b2r * w2i + b2i * w2r)
				buffer.writef32(dst, o + 3 * sE, b3r * w3r - b3i * w3i)
				buffer.writef32(dst, o + 3 * sE + 4, b3r * w3i + b3i * w3r)
			end
		end
	elseif p == 2 then
		for j = 0, m - 1 do
			local w1r, w1i = tw[4 * j + 3], tw[4 * j + 4]
			local i0, mE = 8 * s * j, 8 * s * m
			local o0 = 8 * s * 2 * j
			for q = 0, s - 1 do
				local a = i0 + 8 * q
				local a0r, a0i = buffer.readf32(src, a), buffer.readf32(src, a + 4)
				local a1r, a1i = buffer.readf32(src, a + mE), buffer.readf32(src, a + mE + 4)
				local br, bi = a0r - a1r, a0i - a1i
				local o = o0 + 8 * q
				buffer.writef32(dst, o, a0r + a1r)
				buffer.writef32(dst, o + 4, a0i + a1i)
				buffer.writef32(dst, o + sE, br * w1r - bi * w1i)
				buffer.writef32(dst, o + sE + 4, br * w1i + bi * w1r)
			end
		end
	elseif p == 3 then
		for j = 0, m - 1 do
			local t = 6 * j
			local w1r, w1i, w2r, w2i = tw[t + 3], tw[t + 4], tw[t + 5], tw[t + 6]
			local i0, mE = 8 * s * j, 8 * s * m
			local o0 = 8 * s * 3 * j
			for q = 0, s - 1 do
				local a = i0 + 8 * q
				local a0r, a0i = buffer.readf32(src, a), buffer.readf32(src, a + 4)
				local a1r, a1i = buffer.readf32(src, a + mE), buffer.readf32(src, a + mE + 4)
				local a2r, a2i = buffer.readf32(src, a + 2 * mE), buffer.readf32(src, a + 2 * mE + 4)
				local tr, ti = a1r + a2r, a1i + a2i
				local ur, ui = SQRT3_2 * (a1r - a2r), SQRT3_2 * (a1i - a2i)
				local cr, ci = a0r - 0.5 * tr, a0i - 0.5 * ti
				-- b1 = c - i u, b2 = c + i u
				local b1r, b1i = cr + ui, ci - ur
				local b2r, b2i = cr - ui, ci + ur
				local o = o0 + 8 * q
				buffer.writef32(dst, o, a0r + tr)
				buffer.writef32(dst, o + 4, a0i + ti)
				buffer.writef32(dst, o + sE, b1r * w1r - b1i * w1i)
				buffer.writef32(dst, o + sE + 4, b1r * w1i + b1i * w1r)
				buffer.writef32(dst, o + 2 * sE, b2r * w2r - b2i * w2i)
				buffer.writef32(dst, o + 2 * sE + 4, b2r * w2i + b2i * w2r)
			end
		end
	elseif p == 5 then
		for j = 0, m - 1 do
			local t = 10 * j
			local w1r, w1i, w2r, w2i = tw[t + 3], tw[t + 4], tw[t + 5], tw[t + 6]
			local w3r, w3i, w4r, w4i = tw[t + 7], tw[t + 8], tw[t + 9], tw[t + 10]
			local i0, mE = 8 * s * j, 8 * s * m
			local o0 = 8 * s * 5 * j
			for q = 0, s - 1 do
				local a = i0 + 8 * q
				local a0r, a0i = buffer.readf32(src, a), buffer.readf32(src, a + 4)
				local a1r, a1i = buffer.readf32(src, a + mE), buffer.readf32(src, a + mE + 4)
				local a2r, a2i = buffer.readf32(src, a + 2 * mE), buffer.readf32(src, a + 2 * mE + 4)
				local a3r, a3i = buffer.readf32(src, a + 3 * mE), buffer.readf32(src, a + 3 * mE + 4)
				local a4r, a4i = buffer.readf32(src, a + 4 * mE), buffer.readf32(src, a + 4 * mE + 4)
				local t1r, t1i, t2r, t2i = a1r + a4r, a1i + a4i, a2r + a3r, a2i + a3i
				local t3r, t3i, t4r, t4i = a1r - a4r, a1i - a4i, a2r - a3r, a2i - a3i
				local r1r, r1i = a0r + C1 * t1r + C2 * t2r, a0i + C1 * t1i + C2 * t2i
				local r2r, r2i = a0r + C2 * t1r + C1 * t2r, a0i + C2 * t1i + C1 * t2i
				local s1r, s1i = S1 * t3r + S2 * t4r, S1 * t3i + S2 * t4i
				local s2r, s2i = S2 * t3r - S1 * t4r, S2 * t3i - S1 * t4i
				-- b1 = r1 - i s1, b4 = r1 + i s1, b2 = r2 - i s2, b3 = r2 + i s2
				local b1r, b1i, b4r, b4i = r1r + s1i, r1i - s1r, r1r - s1i, r1i + s1r
				local b2r, b2i, b3r, b3i = r2r + s2i, r2i - s2r, r2r - s2i, r2i + s2r
				local o = o0 + 8 * q
				buffer.writef32(dst, o, a0r + t1r + t2r)
				buffer.writef32(dst, o + 4, a0i + t1i + t2i)
				buffer.writef32(dst, o + sE, b1r * w1r - b1i * w1i)
				buffer.writef32(dst, o + sE + 4, b1r * w1i + b1i * w1r)
				buffer.writef32(dst, o + 2 * sE, b2r * w2r - b2i * w2i)
				buffer.writef32(dst, o + 2 * sE + 4, b2r * w2i + b2i * w2r)
				buffer.writef32(dst, o + 3 * sE, b3r * w3r - b3i * w3i)
				buffer.writef32(dst, o + 3 * sE + 4, b3r * w3i + b3i * w3r)
				buffer.writef32(dst, o + 4 * sE, b4r * w4r - b4i * w4i)
				buffer.writef32(dst, o + 4 * sE + 4, b4r * w4i + b4i * w4r)
			end
		end
	else
		-- Any other small prime: a direct p-point DFT.
		local ar, ai = table.create(p, 0), table.create(p, 0)
		for j = 0, m - 1 do
			local i0, mE = 8 * s * j, 8 * s * m
			local o0 = 8 * s * p * j
			for q = 0, s - 1 do
				local a = i0 + 8 * q
				for r = 0, p - 1 do
					ar[r + 1], ai[r + 1] = buffer.readf32(src, a + r * mE), buffer.readf32(src, a + r * mE + 4)
				end
				local o = o0 + 8 * q
				for k = 0, p - 1 do
					local br, bi = 0, 0
					for r = 0, p - 1 do
						local e = (r * k) % p
						local cr, ci = wp[2 * e + 1], wp[2 * e + 2]
						br += ar[r + 1] * cr - ai[r + 1] * ci
						bi += ar[r + 1] * ci + ai[r + 1] * cr
					end
					local wr, wi = tw[2 * (j * p + k) + 1], tw[2 * (j * p + k) + 2]
					buffer.writef32(dst, o + k * sE, br * wr - bi * wi)
					buffer.writef32(dst, o + k * sE + 4, br * wi + bi * wr)
				end
			end
		end
	end
end

local function conjugate_in_place(x: buffer)
	for k = 4, buffer.len(x) - 4, 8 do
		buffer.writef32(x, k, -buffer.readf32(x, k))
	end
end

local fft_plan: (n: number) -> FFTPlan

-- The unscaled forward transform of the length-n array x, in place.
local function transform(plan: FFTPlan, x: buffer)
	local n = plan.n
	if n <= 1 then
		return
	end
	local impl = plan.impl
	if impl.stages then
		local src, dst = x, impl.scratch
		local s = 1
		for _, stage in impl.stages do
			stockham_pass(src, dst, stage, s)
			src, dst = dst, src
			s *= stage.p
		end
		if src ~= x then
			buffer.copy(x, 0, src, 0, 8 * n)
		end
		return
	end
	-- Bluestein: X_k = c_k sum_j (x_j c_j) conj(c_(k-j)) with the chirp c_j = exp(-i pi j^2 / n),
	-- a circular convolution of length M >= 2n - 1 done with power-of-two FFTs.
	local B = impl.blue
	local M, w, chirp, bhat = B.M, B.work, B.chirp, B.bhat
	for j = 0, n - 1 do
		local xr, xi = buffer.readf32(x, 8 * j), buffer.readf32(x, 8 * j + 4)
		local cr, ci = chirp[2 * j + 1], chirp[2 * j + 2]
		buffer.writef32(w, 8 * j, xr * cr - xi * ci)
		buffer.writef32(w, 8 * j + 4, xr * ci + xi * cr)
	end
	buffer.fill(w, 8 * n, 0, 8 * (M - n))
	transform(B.inner, w)
	for k = 0, M - 1 do
		local wr, wi = buffer.readf32(w, 8 * k), buffer.readf32(w, 8 * k + 4)
		local br, bi = bhat[2 * k + 1], bhat[2 * k + 2]
		-- conjugated, ready for the inverse transform
		buffer.writef32(w, 8 * k, wr * br - wi * bi)
		buffer.writef32(w, 8 * k + 4, -(wr * bi + wi * br))
	end
	transform(B.inner, w)
	for k = 0, n - 1 do
		local vr, vi = buffer.readf32(w, 8 * k) / M, -buffer.readf32(w, 8 * k + 4) / M
		local cr, ci = chirp[2 * k + 1], chirp[2 * k + 2]
		buffer.writef32(x, 8 * k, vr * cr - vi * ci)
		buffer.writef32(x, 8 * k + 4, vr * ci + vi * cr)
	end
end

-- A reusable plan for transforms of length n: twiddle factors (computed in double
-- precision) and workspace. Lengths whose prime factors are all at most 13 use mixed-radix
-- Stockham passes; others use Bluestein's algorithm. fft and ifft make (and cache) plans
-- themselves when none is passed.
fft_plan = function(n: number): FFTPlan
	assert(n >= 0 and n % 1 == 0, "fft length must be a nonnegative integer")
	local cached = plan_cache[n]
	if cached then
		return cached
	end
	local impl: any = {}
	local radices = if n > 1 then radices_of(n) else nil
	if n <= 1 then
		impl.stages = {}
	elseif radices then
		impl.stages = {}
		local L = n
		for _, p in radices do
			local m = L // p
			local tw = table.create(2 * L, 0)
			for j = 0, m - 1 do
				for k = 0, p - 1 do
					tw[2 * (j * p + k) + 1], tw[2 * (j * p + k) + 2] = root(j * k, L)
				end
			end
			local wp = table.create(2 * p, 0)
			for t = 0, p - 1 do
				wp[2 * t + 1], wp[2 * t + 2] = root(t, p)
			end
			table.insert(impl.stages, { p = p, L = L, tw = tw, wp = wp })
			L = m
		end
		impl.scratch = buffer.create(8 * n)
	else
		local M = 1
		while M < 2 * n - 1 do
			M *= 2
		end
		local inner = fft_plan(M)
		local chirp = table.create(2 * n, 0)
		for j = 0, n - 1 do
			-- exp(-i pi j^2 / n), with j^2 reduced mod 2n
			chirp[2 * j + 1], chirp[2 * j + 2] = root((j * j) % (2 * n), 2 * n)
		end
		local b = buffer.create(8 * M)
		for j = 0, n - 1 do
			local cr, ci = chirp[2 * j + 1], -chirp[2 * j + 2]
			buffer.writef32(b, 8 * j, cr)
			buffer.writef32(b, 8 * j + 4, ci)
			if j > 0 then
				buffer.writef32(b, 8 * (M - j), cr)
				buffer.writef32(b, 8 * (M - j) + 4, ci)
			end
		end
		transform(inner, b)
		local bhat = table.create(2 * M, 0)
		for k = 0, M - 1 do
			bhat[2 * k + 1], bhat[2 * k + 2] = buffer.readf32(b, 8 * k), buffer.readf32(b, 8 * k + 4)
		end
		impl.blue = { M = M, inner = inner, chirp = chirp, bhat = bhat, work = buffer.create(8 * M) }
	end
	local plan = { n = n, impl = impl }
	plan_cache[n] = plan
	return plan
end

local function plan_for(x: buffer, plan: FFTPlan?): FFTPlan
	local n = length(x)
	local p = plan or fft_plan(n)
	assert(p.n == n, "the plan is for a different length")
	return p
end

-- Discrete Fourier transform X_k = sum_j x_j exp(-2 pi i j k / n), in place. Returns x.
local function fft(x: buffer, plan: FFTPlan?): buffer
	transform(plan_for(x, plan), x)
	return x
end

-- Inverse transform x_j = (1/n) sum_k X_k exp(2 pi i j k / n), in place. Returns x.
local function ifft(x: buffer, plan: FFTPlan?): buffer
	local p = plan_for(x, plan)
	conjugate_in_place(x)
	transform(p, x)
	local n = p.n
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef32(x, k, buffer.readf32(x, k) / n)
		buffer.writef32(x, k + 4, -buffer.readf32(x, k + 4) / n)
	end
	return x
end

-- fft of a copy of x; x is not modified.
local function fft_copy(x: buffer, plan: FFTPlan?): buffer
	return fft(copy(nil, x), plan)
end

-- ifft of a copy of x; x is not modified.
local function ifft_copy(x: buffer, plan: FFTPlan?): buffer
	return ifft(copy(nil, x), plan)
end

-- Transforms every column, then every row, of A, in place.
local function transform2(A: Matrix, f: (buffer, FFTPlan?) -> buffer): Matrix
	local m, n = A.rows, A.cols
	local a = A.data
	local col = buffer.create(8 * m)
	local pm = fft_plan(m)
	for j = 0, n - 1 do
		buffer.copy(col, 0, a, 8 * j * m, 8 * m)
		f(col, pm)
		buffer.copy(a, 8 * j * m, col, 0, 8 * m)
	end
	local row = buffer.create(8 * n)
	local pn = fft_plan(n)
	for i = 0, m - 1 do
		for j = 0, n - 1 do
			buffer.copy(row, 8 * j, a, 8 * (j * m + i), 8)
		end
		f(row, pn)
		for j = 0, n - 1 do
			buffer.copy(a, 8 * (j * m + i), row, 8 * j, 8)
		end
	end
	return A
end

-- Two-dimensional DFT of a matrix, in place. Returns A.
local function fft2(A: Matrix): Matrix
	return transform2(A, fft)
end

-- Inverse two-dimensional DFT of a matrix, in place. Returns A.
local function ifft2(A: Matrix): Matrix
	return transform2(A, ifft)
end

-- Functions defined inside do blocks, exported through this table: a Luau function (here,
-- the module) may hold at most 200 locals.
local ext = {}

-- Structured and sparse matrices: in a do block (exported through ext) so their locals
-- do not count toward the module's limit of 200.
do
	-- Triangular matrices

	-- Solves T x = b, where T is the upper or lower triangle of A (the other triangle is not
	-- read); with unit, the diagonal is taken to be 1 and not read either. In place if out is b.
	local function triangular_solve(out: buffer?, A: Matrix, b: buffer, uplo: Uplo, unit: boolean?): buffer
		local n = A.rows
		assert(A.cols == n, "matrix must be square")
		assert(uplo == "upper" or uplo == "lower", "uplo must be \"upper\" or \"lower\"")
		assert(buffer.len(b) == 8 * n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = A.data
		local upper = uplo == "upper"
		local first, last, step = if upper then n - 1 else 0, if upper then 0 else n - 1, if upper then -1 else 1
		for j = first, last, step do
			local xr, xi = buffer.readf32(o, 8 * j), buffer.readf32(o, 8 * j + 4)
			if not unit then
				local d = 8 * (j * n + j)
				xr, xi = complex64.div(xr, xi, buffer.readf32(a, d), buffer.readf32(a, d + 4))
				buffer.writef32(o, 8 * j, xr)
				buffer.writef32(o, 8 * j + 4, xi)
			end
			local lo, hi = if upper then 0 else j + 1, if upper then j - 1 else n - 1
			for i = lo, hi do
				local q = 8 * (j * n + i)
				local ar, ai = buffer.readf32(a, q), buffer.readf32(a, q + 4)
				buffer.writef32(o, 8 * i, buffer.readf32(o, 8 * i) - (ar * xr - ai * xi))
				buffer.writef32(o, 8 * i + 4, buffer.readf32(o, 8 * i + 4) - (ar * xi + ai * xr))
			end
		end
		return o
	end

	-- T x for the upper or lower triangle T of A (as in triangular_solve).
	local function triangular_matvec(out: buffer?, A: Matrix, x: buffer, uplo: Uplo, unit: boolean?): buffer
		local n = A.rows
		assert(A.cols == n, "matrix must be square")
		assert(uplo == "upper" or uplo == "lower", "uplo must be \"upper\" or \"lower\"")
		assert(buffer.len(x) == 8 * n, "matrix and vector sizes do not match")
		local o = output(out, 8 * n)
		assert(o ~= x, "output cannot be the input vector")
		local a = A.data
		for i = 0, n - 1 do
			local sr = if unit then buffer.readf32(x, 8 * i) else 0
			local si = if unit then buffer.readf32(x, 8 * i + 4) else 0
			local lo, hi = if uplo == "upper" then i else 0, if uplo == "upper" then n - 1 else i
			if unit then
				if uplo == "upper" then
					lo += 1
				else
					hi -= 1
				end
			end
			for j = lo, hi do
				local q = 8 * (j * n + i)
				local ar, ai = buffer.readf32(a, q), buffer.readf32(a, q + 4)
				local yr, yi = buffer.readf32(x, 8 * j), buffer.readf32(x, 8 * j + 4)
				sr += ar * yr - ai * yi
				si += ar * yi + ai * yr
			end
			buffer.writef32(o, 8 * i, sr)
			buffer.writef32(o, 8 * i + 4, si)
		end
		return o
	end

	-- Tridiagonal matrices

	local function cget(arr: buffer, i: number): (number, number)
		return buffer.readf32(arr, 8 * i), buffer.readf32(arr, 8 * i + 4)
	end

	local function cset(arr: buffer, i: number, re: number, im: number)
		buffer.writef32(arr, 8 * i, re)
		buffer.writef32(arr, 8 * i + 4, im)
	end

	-- A tridiagonal matrix from its subdiagonal (n-1), diagonal (n) and superdiagonal (n-1).
	-- The arrays are used as they are (not copied).
	local function tridiagonal(lower: buffer, diag: buffer, upper: buffer): Tridiagonal
		local n = length(diag)
		assert(length(lower) == math.max(n - 1, 0) and length(upper) == math.max(n - 1, 0), "need n-1 off-diagonal entries")
		return { lower = lower, diag = diag, upper = upper }
	end

	local function tridiag_copy(T: Tridiagonal): Tridiagonal
		return { lower = copy(nil, T.lower), diag = copy(nil, T.diag), upper = copy(nil, T.upper) }
	end

	-- The dense matrix.
	local function tridiag_matrix(T: Tridiagonal): Matrix
		local n = length(T.diag)
		local A = matrix(n, n)
		for i = 0, n - 1 do
			cset(A.data, i * n + i, cget(T.diag, i))
			if i < n - 1 then
				cset(A.data, i * n + i + 1, cget(T.lower, i))
				cset(A.data, (i + 1) * n + i, cget(T.upper, i))
			end
		end
		return A
	end

	-- T x
	local function tridiag_matvec(out: buffer?, T: Tridiagonal, x: buffer): buffer
		local n = length(T.diag)
		assert(length(x) == n, "matrix and vector sizes do not match")
		local o = output(out, 8 * n)
		assert(o ~= x, "output cannot be the input vector")
		for i = 0, n - 1 do
			-- (Separate locals: only the last argument of a call expands to all its values.)
			local dr, di = cget(T.diag, i)
			local vr, vi = cget(x, i)
			local sr, si = complex64.mul(dr, di, vr, vi)
			if i > 0 then
				local lr, li = cget(T.lower, i - 1)
				local xr, xi = cget(x, i - 1)
				sr += lr * xr - li * xi
				si += lr * xi + li * xr
			end
			if i < n - 1 then
				local ur, ui = cget(T.upper, i)
				local xr, xi = cget(x, i + 1)
				sr += ur * xr - ui * xi
				si += ur * xi + ui * xr
			end
			cset(o, i, sr, si)
		end
		return o
	end

	-- LU factorization with partial pivoting (LAPACK's gttrf, pivoting on |re| + |im|), in
	-- place: T's arrays are overwritten with the factors. tridiag_lu_copy leaves T unchanged.
	local function tridiag_lu(T: Tridiagonal): TridiagonalLU
		local n = length(T.diag)
		local dl, d, du = T.lower, T.diag, T.upper
		local du2 = buffer.create(8 * math.max(n - 2, 0))
		local piv = table.create(n, 0)
		for i = 0, n - 2 do
			local dr, di = cget(d, i)
			local lr, li = cget(dl, i)
			if math.abs(dr) + math.abs(di) >= math.abs(lr) + math.abs(li) then
				piv[i + 1] = i + 1
				if dr ~= 0 or di ~= 0 then
					local fr, fi = complex64.div(lr, li, dr, di)
					cset(dl, i, fr, fi)
					local ur, ui = cget(du, i)
					local nr, ni = cget(d, i + 1)
					cset(d, i + 1, nr - (fr * ur - fi * ui), ni - (fr * ui + fi * ur))
				end
			else
				local fr, fi = complex64.div(dr, di, lr, li)
				cset(d, i, lr, li)
				cset(dl, i, fr, fi)
				local tr, ti = cget(du, i)
				local nr, ni = cget(d, i + 1)
				cset(du, i, nr, ni)
				cset(d, i + 1, tr - (fr * nr - fi * ni), ti - (fr * ni + fi * nr))
				if i < n - 2 then
					local ur, ui = cget(du, i + 1)
					cset(du2, i, ur, ui)
					cset(du, i + 1, -(fr * ur - fi * ui), -(fr * ui + fi * ur))
				end
				piv[i + 1] = i + 2
			end
		end
		if n > 0 then
			piv[n] = n
		end
		local singular = false
		for i = 0, n - 1 do
			local dr, di = cget(d, i)
			if dr == 0 and di == 0 then
				singular = true
			end
		end
		return { lu = T, du2 = du2, piv = piv, singular = singular }
	end

	-- tridiag_lu of a copy of T; T is not modified.
	local function tridiag_lu_copy(T: Tridiagonal): TridiagonalLU
		return tridiag_lu(tridiag_copy(T))
	end

	-- Solves T x = b given F = tridiag_lu(T). In place if out is b.
	local function tridiag_lu_solve(out: buffer?, F: TridiagonalLU, b: buffer): buffer
		assert(not F.singular, "matrix is singular")
		local dl, d, du, du2 = F.lu.lower, F.lu.diag, F.lu.upper, F.du2
		local n = length(d)
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		for i = 0, n - 2 do
			local br, bi = cget(o, i)
			local nr, ni = cget(o, i + 1)
			local lr, li = cget(dl, i)
			if F.piv[i + 1] == i + 1 then
				cset(o, i + 1, nr - (lr * br - li * bi), ni - (lr * bi + li * br))
			else
				cset(o, i, nr, ni)
				cset(o, i + 1, br - (lr * nr - li * ni), bi - (lr * ni + li * nr))
			end
		end
		for i = n - 1, 0, -1 do
			local sr, si = cget(o, i)
			if i < n - 1 then
				local ur, ui = cget(du, i)
				local xr, xi = cget(o, i + 1)
				sr -= ur * xr - ui * xi
				si -= ur * xi + ui * xr
			end
			if i < n - 2 then
				local ur, ui = cget(du2, i)
				local xr, xi = cget(o, i + 2)
				sr -= ur * xr - ui * xi
				si -= ur * xi + ui * xr
			end
			local dr, di = cget(d, i)
			cset(o, i, complex64.div(sr, si, dr, di))
		end
		return o
	end

	-- LDL^H factorization of a Hermitian positive definite tridiagonal matrix (LAPACK's
	-- pttrf), in place: only T.diag (its real parts) and T.lower are read; they are
	-- overwritten with D and the subdiagonal of L. definite is false if T is not positive
	-- definite (T is then partly overwritten). tridiag_ldl_copy leaves T unchanged.
	local function tridiag_ldl(T: Tridiagonal): TridiagonalLDL
		local d, e = T.diag, T.lower
		local n = length(d)
		for i = 0, n - 1 do
			local di = buffer.readf32(d, 8 * i)
			buffer.writef32(d, 8 * i + 4, 0)
			if not (di > 0) then
				return { ldl = T, definite = false }
			end
			if i < n - 1 then
				local er, ei = cget(e, i)
				local lr, li = er / di, ei / di
				cset(e, i, lr, li)
				-- d_i+1 -= l conj(e) = |e|^2 / d_i
				buffer.writef32(d, 8 * (i + 1), buffer.readf32(d, 8 * (i + 1)) - (lr * er + li * ei))
			end
		end
		return { ldl = T, definite = true }
	end

	-- tridiag_ldl of a copy of T; T is not modified.
	local function tridiag_ldl_copy(T: Tridiagonal): TridiagonalLDL
		return tridiag_ldl(tridiag_copy(T))
	end

	-- Solves T x = b given F = tridiag_ldl(T). In place if out is b.
	local function tridiag_ldl_solve(out: buffer?, F: TridiagonalLDL, b: buffer): buffer
		assert(F.definite, "matrix is not positive definite")
		local d, e = F.ldl.diag, F.ldl.lower
		local n = length(d)
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		-- L y = b
		for i = 1, n - 1 do
			local pr, pi = cget(o, i - 1)
			local lr, li = cget(e, i - 1)
			local br, bi = cget(o, i)
			cset(o, i, br - (lr * pr - li * pi), bi - (lr * pi + li * pr))
		end
		-- D z = y
		for i = 0, n - 1 do
			local dr = buffer.readf32(d, 8 * i)
			local br, bi = cget(o, i)
			cset(o, i, br / dr, bi / dr)
		end
		-- L^H x = z
		for i = n - 2, 0, -1 do
			local nr, ni = cget(o, i + 1)
			local lr, li = cget(e, i)
			local br, bi = cget(o, i)
			-- conj(l) x_i+1
			cset(o, i, br - (lr * nr + li * ni), bi - (lr * ni - li * nr))
		end
		return o
	end

	-- Banded matrices

	-- A zero n by n banded matrix with kl subdiagonals and ku superdiagonals.
	local function banded(n: number, kl: number, ku: number): Banded
		assert(kl >= 0 and ku >= 0, "bandwidths must be nonnegative")
		local ld = 2 * kl + ku + 1
		return { n = n, kl = kl, ku = ku, ld = ld, data = buffer.create(8 * ld * n) }
	end

	local function band_copy(B: Banded): Banded
		local C = banded(B.n, B.kl, B.ku)
		buffer.copy(C.data, 0, B.data)
		return C
	end

	-- Element index (not bytes) of entry (i, j), 0-based.
	local function band_index(B: Banded, i: number, j: number): number
		return j * B.ld + B.kl + B.ku + i - j
	end

	local function in_band(B: Banded, i: number, j: number): boolean
		return i - j <= B.kl and j - i <= B.ku and i >= 1 and j >= 1 and i <= B.n and j <= B.n
	end

	-- Entry (i, j), 1-based, as a vector; 0 outside the band.
	local function band_get(B: Banded, i: number, j: number): vector
		if not in_band(B, i, j) then
			return vector.create(0, 0, 0)
		end
		local re, im = cget(B.data, band_index(B, i - 1, j - 1))
		return vector.create(re, im, 0)
	end

	-- Sets entry (i, j), 1-based, which must lie in the band.
	local function band_set(B: Banded, i: number, j: number, z: vector)
		assert(in_band(B, i, j), "entry is outside the band")
		cset(B.data, band_index(B, i - 1, j - 1), z.x, z.y)
	end

	-- The band of the square matrix A (entries outside it are dropped).
	local function band_from_matrix(A: Matrix, kl: number, ku: number): Banded
		local n = A.rows
		assert(A.cols == n, "matrix must be square")
		local B = banded(n, kl, ku)
		for j = 0, n - 1 do
			for i = math.max(0, j - ku), math.min(n - 1, j + kl) do
				cset(B.data, band_index(B, i, j), cget(A.data, j * n + i))
			end
		end
		return B
	end

	-- The dense matrix.
	local function band_matrix(B: Banded): Matrix
		local n = B.n
		local A = matrix(n, n)
		for j = 0, n - 1 do
			for i = math.max(0, j - B.ku), math.min(n - 1, j + B.kl) do
				cset(A.data, j * n + i, cget(B.data, band_index(B, i, j)))
			end
		end
		return A
	end

	-- B x
	local function band_matvec(out: buffer?, B: Banded, x: buffer): buffer
		local n = B.n
		assert(length(x) == n, "matrix and vector sizes do not match")
		local o = output(out, 8 * n)
		assert(o ~= x, "output cannot be the input vector")
		buffer.fill(o, 0, 0)
		for j = 0, n - 1 do
			local xr, xi = cget(x, j)
			for i = math.max(0, j - B.ku), math.min(n - 1, j + B.kl) do
				local ar, ai = cget(B.data, band_index(B, i, j))
				local sr, si = cget(o, i)
				cset(o, i, sr + ar * xr - ai * xi, si + ar * xi + ai * xr)
			end
		end
		return o
	end

	-- Banded LU with partial pivoting (LAPACK's gbtf2, pivoting on |re| + |im|), in place: B is
	-- overwritten with the factors, U getting up to kl + ku superdiagonals in B's extra rows.
	-- band_lu_copy leaves B unchanged.
	local function band_lu(B: Banded): BandedLU
		local n, kl, ku = B.n, B.kl, B.ku
		local kv = kl + ku
		local a = B.data
		local function at(i: number, j: number): number
			return j * B.ld + kv + i - j
		end
		for j = 0, n - 1 do
			for i = math.max(0, j - kv), j - ku - 1 do
				cset(a, at(i, j), 0, 0)
			end
		end
		local piv = table.create(n, 0)
		local singular = false
		local ju = 0
		for j = 0, n - 1 do
			local km = math.min(kl, n - 1 - j)
			local p, best = j, -1
			for i = j, j + km do
				local vr, vi = cget(a, at(i, j))
				local v = math.abs(vr) + math.abs(vi)
				if v > best then
					p, best = i, v
				end
			end
			piv[j + 1] = p + 1
			local pr, pi = cget(a, at(p, j))
			if pr ~= 0 or pi ~= 0 then
				ju = math.max(ju, math.min(j + ku + (p - j), n - 1))
				if p ~= j then
					for c = j, ju do
						local sr, si = cget(a, at(j, c))
						cset(a, at(j, c), cget(a, at(p, c)))
						cset(a, at(p, c), sr, si)
					end
				end
				if km > 0 then
					local dr, di = cget(a, at(j, j))
					for i = j + 1, j + km do
						local vr, vi = cget(a, at(i, j))
						cset(a, at(i, j), complex64.div(vr, vi, dr, di))
					end
					for c = j + 1, ju do
						local yr, yi = cget(a, at(j, c))
						if yr ~= 0 or yi ~= 0 then
							for i = j + 1, j + km do
								local lr, li = cget(a, at(i, j))
								local vr, vi = cget(a, at(i, c))
								cset(a, at(i, c), vr - (lr * yr - li * yi), vi - (lr * yi + li * yr))
							end
						end
					end
				end
			else
				singular = true
			end
		end
		return { lu = B, piv = piv, singular = singular }
	end

	-- band_lu of a copy of B; B is not modified.
	local function band_lu_copy(B: Banded): BandedLU
		return band_lu(band_copy(B))
	end

	-- Solves B x = b given F = band_lu(B). In place if out is b.
	local function band_lu_solve(out: buffer?, F: BandedLU, b: buffer): buffer
		assert(not F.singular, "matrix is singular")
		local B = F.lu
		local n, kl, ku = B.n, B.kl, B.ku
		local kv = kl + ku
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = B.data
		local function at(i: number, j: number): number
			return j * B.ld + kv + i - j
		end
		for j = 0, n - 2 do
			local p = F.piv[j + 1] - 1
			if p ~= j then
				local sr, si = cget(o, j)
				cset(o, j, cget(o, p))
				cset(o, p, sr, si)
			end
			local yr, yi = cget(o, j)
			for i = j + 1, math.min(n - 1, j + kl) do
				local lr, li = cget(a, at(i, j))
				local vr, vi = cget(o, i)
				cset(o, i, vr - (lr * yr - li * yi), vi - (lr * yi + li * yr))
			end
		end
		for j = n - 1, 0, -1 do
			local dr, di = cget(a, at(j, j))
			local vr, vi = cget(o, j)
			local xr, xi = complex64.div(vr, vi, dr, di)
			cset(o, j, xr, xi)
			for i = math.max(0, j - kv), j - 1 do
				local ur, ui = cget(a, at(i, j))
				local sr, si = cget(o, i)
				cset(o, i, sr - (ur * xr - ui * xi), si - (ur * xi + ui * xr))
			end
		end
		return o
	end

	-- Banded Cholesky A = L L^H of a Hermitian positive definite matrix (LAPACK's pbtf2,
	-- lower), in place: only the diagonal (its real parts) and the kl subdiagonals are read and
	-- overwritten with L. definite is false if B is not positive definite (B is then partly
	-- overwritten). band_chol_copy leaves B unchanged.
	local function band_chol(B: Banded): BandedCholesky
		local n, kd = B.n, B.kl
		local a = B.data
		for j = 0, n - 1 do
			local ajj = cget(a, band_index(B, j, j))
			if not (ajj > 0) then
				return { chol = B, definite = false }
			end
			ajj = math.sqrt(ajj)
			cset(a, band_index(B, j, j), ajj, 0)
			local kn = math.min(kd, n - 1 - j)
			for i = j + 1, j + kn do
				local vr, vi = cget(a, band_index(B, i, j))
				cset(a, band_index(B, i, j), vr / ajj, vi / ajj)
			end
			-- Trailing lower band -= x x^H, x = column j below the diagonal.
			for c = j + 1, j + kn do
				local cr, ci = cget(a, band_index(B, c, j))
				for i = c, j + kn do
					local xr, xi = cget(a, band_index(B, i, j))
					local vr, vi = cget(a, band_index(B, i, c))
					-- x_i conj(x_c)
					cset(a, band_index(B, i, c), vr - (xr * cr + xi * ci), if i == c then 0 else vi - (xi * cr - xr * ci))
				end
			end
		end
		return { chol = B, definite = true }
	end

	-- band_chol of a copy of B; B is not modified.
	local function band_chol_copy(B: Banded): BandedCholesky
		return band_chol(band_copy(B))
	end

	-- Solves B x = b given F = band_chol(B). In place if out is b.
	local function band_chol_solve(out: buffer?, F: BandedCholesky, b: buffer): buffer
		assert(F.definite, "matrix is not positive definite")
		local B = F.chol
		local n, kd = B.n, B.kl
		assert(length(b) == n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = B.data
		-- L y = b (real diagonal)
		for j = 0, n - 1 do
			local d = cget(a, band_index(B, j, j))
			local vr, vi = cget(o, j)
			local yr, yi = vr / d, vi / d
			cset(o, j, yr, yi)
			for i = j + 1, math.min(n - 1, j + kd) do
				local lr, li = cget(a, band_index(B, i, j))
				local sr, si = cget(o, i)
				cset(o, i, sr - (lr * yr - li * yi), si - (lr * yi + li * yr))
			end
		end
		-- L^H x = y
		for j = n - 1, 0, -1 do
			local sr, si = cget(o, j)
			for i = j + 1, math.min(n - 1, j + kd) do
				local lr, li = cget(a, band_index(B, i, j))
				local xr, xi = cget(o, i)
				-- conj(l) x
				sr -= lr * xr + li * xi
				si -= lr * xi - li * xr
			end
			local d = cget(a, band_index(B, j, j))
			cset(o, j, sr / d, si / d)
		end
		return o
	end

	-- Circulant and Toeplitz matrices

	-- The circulant matrix with first column c (its eigenvalues are computed now).
	local function circulant(c: buffer): Circulant
		return { n = length(c), eig = fft_copy(c) }
	end

	-- C x, by FFT.
	local function circulant_matvec(out: buffer?, C: Circulant, x: buffer): buffer
		assert(length(x) == C.n, "matrix and vector sizes do not match")
		local o = copy(out, x)
		fft(o)
		mul(o, o, C.eig)
		return ifft(o)
	end

	-- Solves C x = b, by FFT. In place if out is b.
	local function circulant_solve(out: buffer?, C: Circulant, b: buffer): buffer
		assert(length(b) == C.n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		fft(o)
		for k = 0, C.n - 1 do
			local er, ei = cget(C.eig, k)
			assert(er ~= 0 or ei ~= 0, "circulant matrix is singular")
			local vr, vi = cget(o, k)
			cset(o, k, complex64.div(vr, vi, er, ei))
		end
		return ifft(o)
	end

	-- The dense matrix.
	local function circulant_matrix(c: buffer): Matrix
		local n = length(c)
		local A = matrix(n, n)
		for j = 0, n - 1 do
			for i = 0, n - 1 do
				cset(A.data, j * n + i, cget(c, (i - j) % n))
			end
		end
		return A
	end

	-- The Toeplitz matrix with first column col and first row row (default: conj(col), which
	-- makes it Hermitian when col[1] is real, as in SciPy). row[1] is ignored. Both arrays are
	-- copied.
	local function toeplitz(col: buffer, row: buffer?): Toeplitz
		local n = length(col)
		local r = if row then row else conj(nil, col)
		assert(length(r) == n, "first row and first column have different lengths")
		local M = 1
		while M < 2 * n - 1 do
			M *= 2
		end
		local e = create(M)
		for k = 0, n - 1 do
			cset(e, k, cget(col, k))
			if k > 0 then
				cset(e, M - k, cget(r, k))
			end
		end
		return { n = n, col = copy(nil, col), row = copy(nil, r), embed = circulant(e) }
	end

	-- The dense matrix.
	local function toeplitz_matrix(T: Toeplitz): Matrix
		local n = T.n
		local A = matrix(n, n)
		for j = 0, n - 1 do
			for i = 0, n - 1 do
				if i >= j then
					cset(A.data, j * n + i, cget(T.col, i - j))
				else
					cset(A.data, j * n + i, cget(T.row, j - i))
				end
			end
		end
		return A
	end

	-- T x, by FFT through the circulant embedding.
	local function toeplitz_matvec(out: buffer?, T: Toeplitz, x: buffer): buffer
		local n = T.n
		assert(length(x) == n, "matrix and vector sizes do not match")
		local o = output(out, 8 * n)
		if n == 0 then
			return o
		end
		local padded = create(T.embed.n)
		buffer.copy(padded, 0, x, 0, 8 * n)
		circulant_matvec(padded, T.embed, padded)
		buffer.copy(o, 0, padded, 0, 8 * n)
		return o
	end

	-- Solves T x = b by Levinson's recursion, O(n^2) in double precision. It needs every
	-- leading principal submatrix of T to be nonsingular (it raises an error otherwise) and is
	-- reliable for well-conditioned, especially Hermitian positive definite, matrices; for
	-- other Toeplitz systems use solve on toeplitz_matrix(T). In place if out is b.
	local function toeplitz_solve(out: buffer?, T: Toeplitz, b: buffer): buffer
		local n = T.n
		assert(length(b) == n, "matrix and vector sizes do not match")
		local br, bi = totable(b)
		local o = output(out, 8 * n)
		if n == 0 then
			return o
		end
		local cr, ci = totable(T.col)
		local rr, ri = totable(T.row)
		local function t(k: number): (number, number)
			if k >= 0 then
				return cr[k + 1], ci[k + 1]
			end
			return rr[1 - k], ri[1 - k]
		end
		assert(cr[1] ~= 0 or ci[1] ~= 0, "toeplitz_solve: a leading principal submatrix is singular")
		local ir, ii = complex64.inv(cr[1], ci[1])
		local fr, fi, gr, gi = { ir }, { ii }, { ir }, { ii }
		local xr, xi = {}, {}
		xr[1], xi[1] = complex64.mul(br[1], bi[1], ir, ii)
		for m = 1, n - 1 do
			local efr, efi, egr, egi, exr, exi = 0, 0, 0, 0, 0, 0
			for j = 1, m do
				local tr, ti = t(m + 1 - j)
				efr += tr * fr[j] - ti * fi[j]
				efi += tr * fi[j] + ti * fr[j]
				exr += tr * xr[j] - ti * xi[j]
				exi += tr * xi[j] + ti * xr[j]
				local sr, si = t(-j)
				egr += sr * gr[j] - si * gi[j]
				egi += sr * gi[j] + si * gr[j]
			end
			local pr, pi = complex64.mul(efr, efi, egr, egi)
			local dr, di = 1 - pr, -pi
			assert(dr ~= 0 or di ~= 0, "toeplitz_solve: a leading principal submatrix is singular")
			local qr, qi = complex64.inv(dr, di)
			local nfr, nfi = table.create(m + 1, 0), table.create(m + 1, 0)
			local ngr, ngi = table.create(m + 1, 0), table.create(m + 1, 0)
			for j = 1, m + 1 do
				local ajr, aji = if j <= m then fr[j] else 0, if j <= m then fi[j] else 0
				local bjr, bji = if j >= 2 then gr[j - 1] else 0, if j >= 2 then gi[j - 1] else 0
				-- (f_j - ef g_j-1) / den and (g_j-1 - eg f_j) / den
				local ur, ui = ajr - (efr * bjr - efi * bji), aji - (efr * bji + efi * bjr)
				local vr, vi = bjr - (egr * ajr - egi * aji), bji - (egr * aji + egi * ajr)
				nfr[j], nfi[j] = ur * qr - ui * qi, ur * qi + ui * qr
				ngr[j], ngi[j] = vr * qr - vi * qi, vr * qi + vi * qr
			end
			fr, fi, gr, gi = nfr, nfi, ngr, ngi
			xr[m + 1], xi[m + 1] = 0, 0
			local sr, si = br[m + 1] - exr, bi[m + 1] - exi
			for j = 1, m + 1 do
				xr[j] += sr * gr[j] - si * gi[j]
				xi[j] += sr * gi[j] + si * gr[j]
			end
		end
		for j = 1, n do
			cset(o, j - 1, xr[j], xi[j])
		end
		return o
	end

	-- Sparse matrices

	local function u32(b: buffer, i: number): number
		return buffer.readu32(b, 4 * i)
	end

	-- Assembles a compressed sparse column matrix from per-column lists of rows and values
	-- (real and imaginary parts), rows already sorted and distinct.
	local function assemble(rows: number, cols: number, colrows: { { number } }, colre: { { number } }, colim: { { number } }): Sparse
		local nnz = 0
		for j = 1, cols do
			nnz += #colrows[j]
		end
		local colptr = buffer.create(4 * (cols + 1))
		local rowind = buffer.create(4 * nnz)
		local values = buffer.create(8 * nnz)
		local p = 0
		for j = 1, cols do
			buffer.writeu32(colptr, 4 * (j - 1), p)
			local rs, vr, vi = colrows[j], colre[j], colim[j]
			for k = 1, #rs do
				buffer.writeu32(rowind, 4 * p, rs[k])
				buffer.writef32(values, 8 * p, vr[k])
				buffer.writef32(values, 8 * p + 4, vi[k])
				p += 1
			end
		end
		buffer.writeu32(colptr, 4 * cols, p)
		return { rows = rows, cols = cols, colptr = colptr, rowind = rowind, values = values }
	end

	local function empty_columns(cols: number): ({ { number } }, { { number } }, { { number } })
		local r, a, b = table.create(cols) :: { { number } }, table.create(cols) :: { { number } }, table.create(cols) :: { { number } }
		for j = 1, cols do
			r[j], a[j], b[j] = {}, {}, {}
		end
		return r, a, b
	end

	-- A rows by cols sparse matrix from triplets: entry (ii[k], jj[k]) (1-based) gets
	-- values[k]; repeated positions are summed, as in SciPy. Explicit zeros are kept.
	local function sparse(rows: number, cols: number, ii: { number }, jj: { number }, values: buffer): Sparse
		local count = #ii
		assert(#jj == count and length(values) == count, "need as many values as positions")
		local order = table.create(count, 0)
		for k = 1, count do
			local i, j = ii[k], jj[k]
			assert(i % 1 == 0 and j % 1 == 0 and i >= 1 and i <= rows and j >= 1 and j <= cols, "position outside the matrix")
			order[k] = k
		end
		table.sort(order, function(a: number, b: number): boolean
			if jj[a] ~= jj[b] then
				return jj[a] < jj[b]
			end
			return ii[a] < ii[b]
		end)
		local colrows, colre, colim = empty_columns(cols)
		for _, k in order do
			local j = jj[k]
			local rs, vr, vi = colrows[j], colre[j], colim[j]
			local re, im = buffer.readf32(values, 8 * (k - 1)), buffer.readf32(values, 8 * (k - 1) + 4)
			if #rs > 0 and rs[#rs] == ii[k] - 1 then
				vr[#vr] += re
				vi[#vi] += im
			else
				table.insert(rs, ii[k] - 1)
				table.insert(vr, re)
				table.insert(vi, im)
			end
		end
		return assemble(rows, cols, colrows, colre, colim)
	end

	-- Number of stored entries.
	local function sparse_nnz(S: Sparse): number
		return buffer.len(S.rowind) // 4
	end

	-- The nonzero entries of the dense matrix A.
	local function sparse_from_matrix(A: Matrix): Sparse
		local m, n = A.rows, A.cols
		local colrows, colre, colim = empty_columns(n)
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				local re, im = buffer.readf32(A.data, 8 * (j * m + i)), buffer.readf32(A.data, 8 * (j * m + i) + 4)
				if re ~= 0 or im ~= 0 then
					table.insert(colrows[j + 1], i)
					table.insert(colre[j + 1], re)
					table.insert(colim[j + 1], im)
				end
			end
		end
		return assemble(m, n, colrows, colre, colim)
	end

	-- The dense matrix.
	local function sparse_matrix(S: Sparse): Matrix
		local A = matrix(S.rows, S.cols)
		for j = 0, S.cols - 1 do
			for p = u32(S.colptr, j), u32(S.colptr, j + 1) - 1 do
				local o = 8 * (j * S.rows + u32(S.rowind, p))
				buffer.writef32(A.data, o, buffer.readf32(S.values, 8 * p))
				buffer.writef32(A.data, o + 4, buffer.readf32(S.values, 8 * p + 4))
			end
		end
		return A
	end

	-- Position of entry (i, j) (0-based) in the stored arrays, or nil.
	local function find(S: Sparse, i: number, j: number): number?
		local lo, hi = u32(S.colptr, j), u32(S.colptr, j + 1) - 1
		while lo <= hi do
			local mid = (lo + hi) // 2
			local r = u32(S.rowind, mid)
			if r == i then
				return mid
			elseif r < i then
				lo = mid + 1
			else
				hi = mid - 1
			end
		end
		return nil
	end

	-- Entry (i, j), 1-based, as a vector (0 if not stored).
	local function sparse_get(S: Sparse, i: number, j: number): vector
		local p = find(S, i - 1, j - 1)
		if not p then
			return vector.create(0, 0, 0)
		end
		return vector.create(buffer.readf32(S.values, 8 * p), buffer.readf32(S.values, 8 * p + 4), 0)
	end

	-- The diagonal, as an array of min(rows, cols) entries.
	local function sparse_diag(S: Sparse): buffer
		local k = math.min(S.rows, S.cols)
		local d = create(k)
		for i = 0, k - 1 do
			local p = find(S, i, i)
			if p then
				buffer.writef32(d, 8 * i, buffer.readf32(S.values, 8 * p))
				buffer.writef32(d, 8 * i + 4, buffer.readf32(S.values, 8 * p + 4))
			end
		end
		return d
	end

	-- S x, accumulated in double precision.
	local function sparse_matvec(out: buffer?, S: Sparse, x: buffer): buffer
		assert(length(x) == S.cols, "matrix and vector sizes do not match")
		local o = output(out, 8 * S.rows)
		assert(o ~= x, "output cannot be the input vector")
		local accr, acci = table.create(S.rows, 0), table.create(S.rows, 0)
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		for j = 0, S.cols - 1 do
			local xr, xi = buffer.readf32(x, 8 * j), buffer.readf32(x, 8 * j + 4)
			if xr ~= 0 or xi ~= 0 then
				for p = buffer.readu32(colptr, 4 * j), buffer.readu32(colptr, 4 * j + 4) - 1 do
					local r = buffer.readu32(rowind, 4 * p) + 1
					local ar, ai = buffer.readf32(vals, 8 * p), buffer.readf32(vals, 8 * p + 4)
					accr[r] += ar * xr - ai * xi
					acci[r] += ar * xi + ai * xr
				end
			end
		end
		for i = 1, S.rows do
			buffer.writef32(o, 8 * (i - 1), accr[i])
			buffer.writef32(o, 8 * (i - 1) + 4, acci[i])
		end
		return o
	end

	-- S^H x.
	local function sparse_matvec_adjoint(out: buffer?, S: Sparse, x: buffer): buffer
		assert(length(x) == S.rows, "matrix and vector sizes do not match")
		local o = output(out, 8 * S.cols)
		assert(o ~= x, "output cannot be the input vector")
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		for j = 0, S.cols - 1 do
			local sr, si = 0, 0
			for p = buffer.readu32(colptr, 4 * j), buffer.readu32(colptr, 4 * j + 4) - 1 do
				local r = buffer.readu32(rowind, 4 * p)
				local ar, ai = buffer.readf32(vals, 8 * p), buffer.readf32(vals, 8 * p + 4)
				local xr, xi = buffer.readf32(x, 8 * r), buffer.readf32(x, 8 * r + 4)
				-- conj(a) x
				sr += ar * xr + ai * xi
				si += ar * xi - ai * xr
			end
			buffer.writef32(o, 8 * j, sr)
			buffer.writef32(o, 8 * j + 4, si)
		end
		return o
	end

	-- S B for a dense matrix B, as a dense matrix.
	local function sparse_matmul(out: Matrix?, S: Sparse, B: Matrix): Matrix
		assert(B.rows == S.cols, "matrix sizes do not match")
		local o = matoutput(out, S.rows, B.cols)
		assert(o.data ~= B.data, "output cannot be an input")
		local col, res = create(S.cols), create(S.rows)
		for j = 0, B.cols - 1 do
			buffer.copy(col, 0, B.data, 8 * j * S.cols, 8 * S.cols)
			sparse_matvec(res, S, col)
			buffer.copy(o.data, 8 * j * S.rows, res, 0, 8 * S.rows)
		end
		return o
	end

	local function transpose_sparse(S: Sparse, sign: number): Sparse
		local colrows, colre, colim = empty_columns(S.rows)
		for j = 0, S.cols - 1 do
			for p = u32(S.colptr, j), u32(S.colptr, j + 1) - 1 do
				local r = u32(S.rowind, p) + 1
				table.insert(colrows[r], j)
				table.insert(colre[r], buffer.readf32(S.values, 8 * p))
				table.insert(colim[r], sign * buffer.readf32(S.values, 8 * p + 4))
			end
		end
		return assemble(S.cols, S.rows, colrows, colre, colim)
	end

	-- S^T.
	local function sparse_transpose(S: Sparse): Sparse
		return transpose_sparse(S, 1)
	end

	-- S^H.
	local function sparse_adjoint(S: Sparse): Sparse
		return transpose_sparse(S, -1)
	end

	-- A + B.
	local function sparse_add(A: Sparse, B: Sparse): Sparse
		assert(A.rows == B.rows and A.cols == B.cols, "matrix sizes do not match")
		local colrows, colre, colim = empty_columns(A.cols)
		for j = 0, A.cols - 1 do
			local p, pe = u32(A.colptr, j), u32(A.colptr, j + 1)
			local q, qe = u32(B.colptr, j), u32(B.colptr, j + 1)
			local rs, vr, vi = colrows[j + 1], colre[j + 1], colim[j + 1]
			while p < pe or q < qe do
				local ra = if p < pe then u32(A.rowind, p) else math.huge
				local rb = if q < qe then u32(B.rowind, q) else math.huge
				local re, im = 0, 0
				if ra <= rb then
					re += buffer.readf32(A.values, 8 * p)
					im += buffer.readf32(A.values, 8 * p + 4)
					p += 1
				end
				if rb <= ra then
					re += buffer.readf32(B.values, 8 * q)
					im += buffer.readf32(B.values, 8 * q + 4)
					q += 1
				end
				table.insert(rs, math.min(ra, rb))
				table.insert(vr, re)
				table.insert(vi, im)
			end
		end
		return assemble(A.rows, A.cols, colrows, colre, colim)
	end

	-- The Jacobi (diagonal) preconditioner of a square S, for the iterative solvers:
	-- out := r ./ diag(S). Every diagonal entry must be nonzero.
	local function sparse_jacobi(S: Sparse): (out: buffer, r: buffer) -> buffer
		assert(S.rows == S.cols, "matrix must be square")
		local d = sparse_diag(S)
		local ir, ii = table.create(S.rows, 0), table.create(S.rows, 0)
		for i = 0, S.rows - 1 do
			local vr, vi = buffer.readf32(d, 8 * i), buffer.readf32(d, 8 * i + 4)
			assert(vr ~= 0 or vi ~= 0, "a diagonal entry is zero")
			ir[i + 1], ii[i + 1] = complex64.inv(vr, vi)
		end
		return function(out: buffer, r: buffer): buffer
			for i = 0, S.rows - 1 do
				local xr, xi = buffer.readf32(r, 8 * i), buffer.readf32(r, 8 * i + 4)
				local cr, ci = ir[i + 1], ii[i + 1]
				buffer.writef32(out, 8 * i, xr * cr - xi * ci)
				buffer.writef32(out, 8 * i + 4, xr * ci + xi * cr)
			end
			return out
		end
	end

	-- Preconditioners for the iterative solvers

	-- The SSOR preconditioner of a square S with relaxation omega (0 < omega < 2; the default
	-- 1 is symmetric Gauss-Seidel): M = (D + w L) D^-1 (D + w U) / (w (2 - w)), with D, L, U
	-- the diagonal and strictly lower and upper parts. Returns out := M^-1 r. If S is
	-- Hermitian positive definite, so is M (usable with CG). Every diagonal entry must be
	-- nonzero.
	local function sparse_ssor(S: Sparse, omega: number?): (out: buffer, r: buffer) -> buffer
		local w = omega or 1
		assert(w > 0 and w < 2, "omega must be between 0 and 2")
		assert(S.rows == S.cols, "matrix must be square")
		local n = S.rows
		local dr, di = totable(sparse_diag(S))
		for i = 1, n do
			assert(dr[i] ~= 0 or di[i] ~= 0, "a diagonal entry is zero")
		end
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local yr, yi = table.create(n, 0), table.create(n, 0)
		local factor = w * (2 - w)
		return function(out: buffer, r: buffer): buffer
			for i = 1, n do
				yr[i], yi[i] = buffer.readf32(r, 8 * (i - 1)), buffer.readf32(r, 8 * (i - 1) + 4)
			end
			-- (D + w L) y = r, column by column.
			for j = 0, n - 1 do
				local ar, ai = complex64.div(yr[j + 1], yi[j + 1], dr[j + 1], di[j + 1])
				yr[j + 1], yi[j + 1] = ar, ai
				for p = u32(colptr, j), u32(colptr, j + 1) - 1 do
					local i = u32(rowind, p)
					if i > j then
						local vr, vi = w * buffer.readf32(vals, 8 * p), w * buffer.readf32(vals, 8 * p + 4)
						yr[i + 1] -= vr * ar - vi * ai
						yi[i + 1] -= vr * ai + vi * ar
					end
				end
			end
			for i = 1, n do
				yr[i], yi[i] = complex64.mul(yr[i], yi[i], dr[i], di[i])
			end
			-- (D + w U) z = D y, backwards.
			for j = n - 1, 0, -1 do
				local zr, zi = complex64.div(yr[j + 1], yi[j + 1], dr[j + 1], di[j + 1])
				yr[j + 1], yi[j + 1] = zr, zi
				for p = u32(colptr, j), u32(colptr, j + 1) - 1 do
					local i = u32(rowind, p)
					if i < j then
						local vr, vi = w * buffer.readf32(vals, 8 * p), w * buffer.readf32(vals, 8 * p + 4)
						yr[i + 1] -= vr * zr - vi * zi
						yi[i + 1] -= vr * zi + vi * zr
					end
				end
			end
			for i = 1, n do
				buffer.writef32(out, 8 * (i - 1), yr[i] * factor)
				buffer.writef32(out, 8 * (i - 1) + 4, yi[i] * factor)
			end
			return out
		end
	end

	-- Incomplete LU factorization ILU(0) of a square S, in place: S's values are overwritten
	-- with L and U in S's own sparsity pattern (no fill-in). Every diagonal entry must be
	-- stored; singular is true if one is missing or a pivot is zero. sparse_ilu0_copy leaves
	-- S unchanged.
	local function sparse_ilu0(S: Sparse): SparseILU
		assert(S.rows == S.cols, "matrix must be square")
		local n = S.rows
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local pos: { [number]: number } = {}
		local diag = table.create(n, 0)
		local singular = false
		for j = 0, n - 1 do
			local p0, p1 = u32(colptr, j), u32(colptr, j + 1) - 1
			for p = p0, p1 do
				pos[u32(rowind, p)] = p
			end
			for p = p0, p1 do
				local k = u32(rowind, p)
				if k >= j then
					break
				end
				local ur, ui = buffer.readf32(vals, 8 * p), buffer.readf32(vals, 8 * p + 4)
				if ur ~= 0 or ui ~= 0 then
					for q = diag[k + 1] + 1, u32(colptr, k + 1) - 1 do
						local t = pos[u32(rowind, q)]
						if t then
							local lr, li = buffer.readf32(vals, 8 * q), buffer.readf32(vals, 8 * q + 4)
							buffer.writef32(vals, 8 * t, buffer.readf32(vals, 8 * t) - (lr * ur - li * ui))
							buffer.writef32(vals, 8 * t + 4, buffer.readf32(vals, 8 * t + 4) - (lr * ui + li * ur))
						end
					end
				end
			end
			local dp = pos[j]
			local pr = if dp then buffer.readf32(vals, 8 * dp) else 0
			local pi = if dp then buffer.readf32(vals, 8 * dp + 4) else 0
			if dp == nil or (pr == 0 and pi == 0) then
				singular = true
				diag[j + 1] = if dp then dp else p0
			else
				diag[j + 1] = dp
				for p = dp + 1, p1 do
					local qr, qi = complex64.div(buffer.readf32(vals, 8 * p), buffer.readf32(vals, 8 * p + 4), pr, pi)
					buffer.writef32(vals, 8 * p, qr)
					buffer.writef32(vals, 8 * p + 4, qi)
				end
			end
			for p = p0, p1 do
				pos[u32(rowind, p)] = nil
			end
		end
		return { lu = S, diag = diag, singular = singular }
	end

	local function sparse_copy(S: Sparse): Sparse
		return { rows = S.rows, cols = S.cols, colptr = S.colptr, rowind = S.rowind, values = copy(nil, S.values) }
	end

	-- sparse_ilu0 of a copy of S (the index arrays are shared, the values copied).
	local function sparse_ilu0_copy(S: Sparse): SparseILU
		return sparse_ilu0(sparse_copy(S))
	end

	-- out := (L U)^-1 r given F = sparse_ilu0(S); use it as a preconditioner with
	-- function(out, r) return sparse_ilu0_solve(out, F, r) end.
	local function sparse_ilu0_solve(out: buffer?, F: SparseILU, r: buffer): buffer
		assert(not F.singular, "the incomplete factorization is singular")
		local S = F.lu
		local n = S.rows
		assert(length(r) == n, "matrix and vector sizes do not match")
		local colptr, rowind, vals, diag = S.colptr, S.rowind, S.values, F.diag
		local yr, yi = totable(r)
		for j = 0, n - 1 do
			local ar, ai = yr[j + 1], yi[j + 1]
			for p = diag[j + 1] + 1, u32(colptr, j + 1) - 1 do
				local i = u32(rowind, p) + 1
				local lr, li = buffer.readf32(vals, 8 * p), buffer.readf32(vals, 8 * p + 4)
				yr[i] -= lr * ar - li * ai
				yi[i] -= lr * ai + li * ar
			end
		end
		for j = n - 1, 0, -1 do
			local d = 8 * diag[j + 1]
			local ar, ai = complex64.div(yr[j + 1], yi[j + 1], buffer.readf32(vals, d), buffer.readf32(vals, d + 4))
			yr[j + 1], yi[j + 1] = ar, ai
			for p = u32(colptr, j), diag[j + 1] - 1 do
				local i = u32(rowind, p) + 1
				local vr, vi = buffer.readf32(vals, 8 * p), buffer.readf32(vals, 8 * p + 4)
				yr[i] -= vr * ar - vi * ai
				yi[i] -= vr * ai + vi * ar
			end
		end
		local o = output(out, 8 * n)
		for i = 1, n do
			buffer.writef32(o, 8 * (i - 1), yr[i])
			buffer.writef32(o, 8 * (i - 1) + 4, yi[i])
		end
		return o
	end

	-- Incomplete Cholesky factorization IC(0) of a Hermitian positive definite S, in place:
	-- only the lower triangle (and the real parts of the diagonal) is read, and it is
	-- overwritten with L in its own sparsity pattern (no fill-in). It can break down even for
	-- positive definite S (definite is then false); it cannot for M-matrices such as discrete
	-- Laplacians. sparse_ic0_copy leaves S unchanged.
	local function sparse_ic0(S: Sparse): SparseIC
		assert(S.rows == S.cols, "matrix must be square")
		local n = S.rows
		local colptr, rowind, vals = S.colptr, S.rowind, S.values
		local diag = table.create(n, 0)
		for j = 0, n - 1 do
			local dp = find(S, j, j)
			if dp == nil then
				return { ic = S, diag = diag, definite = false }
			end
			diag[j + 1] = dp
			local djj = buffer.readf32(vals, 8 * dp)
			if not (djj > 0) then
				return { ic = S, diag = diag, definite = false }
			end
			djj = math.sqrt(djj)
			buffer.writef32(vals, 8 * dp, djj)
			buffer.writef32(vals, 8 * dp + 4, 0)
			local p1 = u32(colptr, j + 1) - 1
			for p = dp + 1, p1 do
				buffer.writef32(vals, 8 * p, buffer.readf32(vals, 8 * p) / djj)
				buffer.writef32(vals, 8 * p + 4, buffer.readf32(vals, 8 * p + 4) / djj)
			end
			-- A(i, k) -= L(i, j) conj(L(k, j)) for j < k <= i, where the pattern has an entry.
			for q = dp + 1, p1 do
				local k = u32(rowind, q)
				local kr, ki = buffer.readf32(vals, 8 * q), buffer.readf32(vals, 8 * q + 4)
				for p = q, p1 do
					local t = find(S, u32(rowind, p), k)
					if t then
						local lr, li = buffer.readf32(vals, 8 * p), buffer.readf32(vals, 8 * p + 4)
						local ar = buffer.readf32(vals, 8 * t) - (lr * kr + li * ki)
						local ai = if p == q then 0 else buffer.readf32(vals, 8 * t + 4) - (li * kr - lr * ki)
						buffer.writef32(vals, 8 * t, ar)
						buffer.writef32(vals, 8 * t + 4, ai)
					end
				end
			end
		end
		return { ic = S, diag = diag, definite = true }
	end

	-- sparse_ic0 of a copy of S (the index arrays are shared, the values copied).
	local function sparse_ic0_copy(S: Sparse): SparseIC
		return sparse_ic0(sparse_copy(S))
	end

	-- out := (L L^H)^-1 r given F = sparse_ic0(S); use it as a preconditioner with
	-- function(out, r) return sparse_ic0_solve(out, F, r) end.
	local function sparse_ic0_solve(out: buffer?, F: SparseIC, r: buffer): buffer
		assert(F.definite, "the incomplete Cholesky factorization broke down")
		local S = F.ic
		local n = S.rows
		assert(length(r) == n, "matrix and vector sizes do not match")
		local colptr, rowind, vals, diag = S.colptr, S.rowind, S.values, F.diag
		local yr, yi = totable(r)
		-- L y = r (real diagonal)
		for j = 0, n - 1 do
			local d = buffer.readf32(vals, 8 * diag[j + 1])
			local ar, ai = yr[j + 1] / d, yi[j + 1] / d
			yr[j + 1], yi[j + 1] = ar, ai
			for p = diag[j + 1] + 1, u32(colptr, j + 1) - 1 do
				local i = u32(rowind, p) + 1
				local lr, li = buffer.readf32(vals, 8 * p), buffer.readf32(vals, 8 * p + 4)
				yr[i] -= lr * ar - li * ai
				yi[i] -= lr * ai + li * ar
			end
		end
		-- L^H z = y
		for j = n - 1, 0, -1 do
			local sr, si = yr[j + 1], yi[j + 1]
			for p = diag[j + 1] + 1, u32(colptr, j + 1) - 1 do
				local i = u32(rowind, p) + 1
				local lr, li = buffer.readf32(vals, 8 * p), buffer.readf32(vals, 8 * p + 4)
				-- conj(l) z_i
				sr -= lr * yr[i] + li * yi[i]
				si -= lr * yi[i] - li * yr[i]
			end
			local d = buffer.readf32(vals, 8 * diag[j + 1])
			yr[j + 1], yi[j + 1] = sr / d, si / d
		end
		local o = output(out, 8 * n)
		for i = 1, n do
			buffer.writef32(o, 8 * (i - 1), yr[i])
			buffer.writef32(o, 8 * (i - 1) + 4, yi[i])
		end
		return o
	end

	-- Functions taking or returning complex scalars. The *_pair functions above pass them
	-- as (re, im) number pairs; each type exports them in its own scalar format.

	ext.triangular_solve = triangular_solve
	ext.triangular_matvec = triangular_matvec
	ext.cget = cget
	ext.cset = cset
	ext.tridiagonal = tridiagonal
	ext.tridiag_copy = tridiag_copy
	ext.tridiag_matrix = tridiag_matrix
	ext.tridiag_matvec = tridiag_matvec
	ext.tridiag_lu = tridiag_lu
	ext.tridiag_lu_copy = tridiag_lu_copy
	ext.tridiag_lu_solve = tridiag_lu_solve
	ext.tridiag_ldl = tridiag_ldl
	ext.tridiag_ldl_copy = tridiag_ldl_copy
	ext.tridiag_ldl_solve = tridiag_ldl_solve
	ext.banded = banded
	ext.band_copy = band_copy
	ext.band_index = band_index
	ext.in_band = in_band
	ext.band_get = band_get
	ext.band_set = band_set
	ext.band_from_matrix = band_from_matrix
	ext.band_matrix = band_matrix
	ext.band_matvec = band_matvec
	ext.band_lu = band_lu
	ext.band_lu_copy = band_lu_copy
	ext.band_lu_solve = band_lu_solve
	ext.band_chol = band_chol
	ext.band_chol_copy = band_chol_copy
	ext.band_chol_solve = band_chol_solve
	ext.circulant = circulant
	ext.circulant_matvec = circulant_matvec
	ext.circulant_solve = circulant_solve
	ext.circulant_matrix = circulant_matrix
	ext.toeplitz = toeplitz
	ext.toeplitz_matrix = toeplitz_matrix
	ext.toeplitz_matvec = toeplitz_matvec
	ext.toeplitz_solve = toeplitz_solve
	ext.u32 = u32
	ext.assemble = assemble
	ext.empty_columns = empty_columns
	ext.sparse = sparse
	ext.sparse_nnz = sparse_nnz
	ext.sparse_from_matrix = sparse_from_matrix
	ext.sparse_matrix = sparse_matrix
	ext.find = find
	ext.sparse_get = sparse_get
	ext.sparse_diag = sparse_diag
	ext.sparse_matvec = sparse_matvec
	ext.sparse_matvec_adjoint = sparse_matvec_adjoint
	ext.sparse_matmul = sparse_matmul
	ext.transpose_sparse = transpose_sparse
	ext.sparse_transpose = sparse_transpose
	ext.sparse_adjoint = sparse_adjoint
	ext.sparse_add = sparse_add
	ext.sparse_jacobi = sparse_jacobi
	ext.sparse_ssor = sparse_ssor
	ext.sparse_ilu0 = sparse_ilu0
	ext.sparse_copy = sparse_copy
	ext.sparse_ilu0_copy = sparse_ilu0_copy
	ext.sparse_ilu0_solve = sparse_ilu0_solve
	ext.sparse_ic0 = sparse_ic0
	ext.sparse_ic0_copy = sparse_ic0_copy
	ext.sparse_ic0_solve = sparse_ic0_solve
end

local function get(x: buffer, i: number): vector
	local k = 8 * (i - 1)
	return vector.create(buffer.readf32(x, k), buffer.readf32(x, k + 4), 0)
end

local function set(x: buffer, i: number, z: vector)
	local k = 8 * (i - 1)
	buffer.writef32(x, k, z.x)
	buffer.writef32(x, k + 4, z.y)
end

local function matget(A: Matrix, i: number, j: number): vector
	local k = 8 * ((j - 1) * A.rows + i - 1)
	return vector.create(buffer.readf32(A.data, k), buffer.readf32(A.data, k + 4), 0)
end

local function matset(A: Matrix, i: number, j: number, z: vector)
	local k = 8 * ((j - 1) * A.rows + i - 1)
	buffer.writef32(A.data, k, z.x)
	buffer.writef32(A.data, k + 4, z.y)
end

local function fill(out: buffer, z: vector): buffer
	return fill_pair(out, z.x, z.y)
end

local function cscale(out: buffer?, a: vector, x: buffer): buffer
	return cscale_pair(out, a.x, a.y, x)
end

local function caxpy(out: buffer?, a: vector, x: buffer, y: buffer): buffer
	return caxpy_pair(out, a.x, a.y, x, y)
end

local function dot(x: buffer, y: buffer): vector
	return vector.create(dotu_pair(x, y))
end

local function dotc(x: buffer, y: buffer): vector
	return vector.create(dotc_pair(x, y))
end

local function sum(x: buffer): vector
	return vector.create(sum_pair(x))
end

local function det(A: Matrix): vector
	return vector.create(det_pair(A))
end

-- Matrix utilities, matrix norms, slogdet and adjoint LU solves.
-- Scalar coefficients (ger, gemm) are real; complex scalar results are pairs (c64) or
-- vectors (c32), as elsewhere.

do
	local function rd(x: buffer, i: number): (number, number)
		return buffer.readf32(x, 8 * i), buffer.readf32(x, 8 * i + 4)
	end

	local function wr(x: buffer, i: number, re: number, im: number)
		buffer.writef32(x, 8 * i, re)
		buffer.writef32(x, 8 * i + 4, im)
	end

	-- The sum of the diagonal, as (re, im).
	function ext.trace_pair(A: Matrix): (number, number)
		local sr, si = 0, 0
		for i = 0, math.min(A.rows, A.cols) - 1 do
			local r, m = rd(A.data, i * A.rows + i)
			sr += r
			si += m
		end
		return sr, si
	end

	-- The diagonal (min(rows, cols) entries), as an array.
	function ext.diag(out: buffer?, A: Matrix): buffer
		local n = math.min(A.rows, A.cols)
		local o = output(out, 8 * n)
		for i = 0, n - 1 do
			wr(o, i, rd(A.data, i * A.rows + i))
		end
		return o
	end

	-- The square matrix with the array x on its diagonal.
	function ext.diagm(x: buffer): Matrix
		local n = length(x)
		local D = matrix(n, n)
		for i = 0, n - 1 do
			wr(D.data, i * n + i, rd(x, i))
		end
		return D
	end

	-- The Kronecker product: the block matrix [a_ij B].
	function ext.kron(A: Matrix, B: Matrix): Matrix
		local m, n, p, q = A.rows, A.cols, B.rows, B.cols
		local K = matrix(m * p, n * q)
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				local ar, ai = rd(A.data, j * m + i)
				if ar ~= 0 or ai ~= 0 then
					for l = 0, q - 1 do
						local col = (j * q + l) * m * p + i * p
						for r = 0, p - 1 do
							local br, bi = rd(B.data, l * p + r)
							wr(K.data, col + r, ar * br - ai * bi, ar * bi + ai * br)
						end
					end
				end
			end
		end
		return K
	end

	-- The outer product x y^H.
	function ext.outer(out: Matrix?, x: buffer, y: buffer): Matrix
		local m, n = length(x), length(y)
		local o = matoutput(out, m, n)
		for j = 0, n - 1 do
			local yr, yi = rd(y, j)
			yi = -yi
			for i = 0, m - 1 do
				local xr, xi = rd(x, i)
				wr(o.data, j * m + i, xr * yr - xi * yi, xr * yi + xi * yr)
			end
		end
		return o
	end

	-- The rank-one update A := A + a x y^H with real a, in place (BLAS gerc); returns A.
	function ext.ger(A: Matrix, a: number, x: buffer, y: buffer): Matrix
		local m, n = A.rows, A.cols
		assert(length(x) == m and length(y) == n, "ger: sizes do not match")
		for j = 0, n - 1 do
			local yr, yi = rd(y, j)
			local fr, fi = a * yr, -a * yi
			if fr ~= 0 or fi ~= 0 then
				for i = 0, m - 1 do
					local xr, xi = rd(x, i)
					local cr, ci = rd(A.data, j * m + i)
					wr(A.data, j * m + i, cr + xr * fr - xi * fi, ci + xr * fi + xi * fr)
				end
			end
		end
		return A
	end

	-- A^H x, without forming the adjoint.
	function ext.matvec_adjoint(out: buffer?, A: Matrix, x: buffer): buffer
		local m, n = A.rows, A.cols
		assert(length(x) == m, "matvec_adjoint: sizes do not match")
		local o = output(out, 8 * n)
		assert(o ~= x, "output cannot be the input vector")
		for j = 0, n - 1 do
			local sr, si = 0, 0
			for i = 0, m - 1 do
				local ar, ai = rd(A.data, j * m + i)
				local xr, xi = rd(x, i)
				sr += ar * xr + ai * xi
				si += ar * xi - ai * xr
			end
			wr(o, j, sr, si)
		end
		return o
	end

	-- C := alpha op(A) op(B) + beta C (BLAS gemm) with real alpha and beta, where op is
	-- "n" (as is), "t" (transposed) or "c" (conjugate transposed). C is new (or out) when
	-- beta is 0 or nil. Sums run in double precision and each entry is rounded once.
	function ext.gemm(C: Matrix?, alpha: number, A: Matrix, B: Matrix, beta: number?, opa: string?, opb: string?): Matrix
		local ta, tb = opa ~= nil and opa ~= "n", opb ~= nil and opb ~= "n"
		local ca, cb = if opa == "c" then -1 else 1, if opb == "c" then -1 else 1
		local m, kk = if ta then A.cols else A.rows, if ta then A.rows else A.cols
		local kb, n = if tb then B.cols else B.rows, if tb then B.rows else B.cols
		assert(kk == kb, "gemm: inner dimensions do not match")
		local b0 = beta or 0
		local o: Matrix
		if b0 == 0 then
			o = matoutput(C, m, n)
		else
			assert(C ~= nil and C.rows == m and C.cols == n, "gemm: beta needs a C of the right shape")
			o = C
		end
		assert(o.data ~= A.data and o.data ~= B.data, "output cannot be an input")
		local am, bm = A.rows, B.rows
		for j = 0, n - 1 do
			for i = 0, m - 1 do
				local sr, si = 0, 0
				for k = 0, kk - 1 do
					local xr, xi = rd(A.data, if ta then i * am + k else k * am + i)
					local yr, yi = rd(B.data, if tb then k * bm + j else j * bm + k)
					xi *= ca
					yi *= cb
					sr += xr * yr - xi * yi
					si += xr * yi + xi * yr
				end
				local cr, ci = 0, 0
				if b0 ~= 0 then
					cr, ci = rd(o.data, j * m + i)
				end
				wr(o.data, j * m + i, alpha * sr + b0 * cr, alpha * si + b0 * ci)
			end
		end
		return o
	end

	-- The phase (a unit complex number) and the log of the absolute value of det(A),
	-- without overflow: returns (phase re, phase im, log |det|), with phase 0 and log -inf
	-- for a singular matrix.
	function ext.slogdet_pair(A: Matrix): (number, number, number)
		local F = lu_copy(A)
		local n = A.rows
		local pr, pi, logabs = F.sign, 0, 0
		for k = 0, n - 1 do
			local ur, ui = rd(F.lu.data, k * n + k)
			local a = complex64.abs(ur, ui)
			if a == 0 then
				return 0, 0, -math.huge
			end
			pr, pi = complex64.mul(pr, pi, ur / a, ui / a)
			logabs += math.log(a)
		end
		-- Renormalize the phase against rounding drift.
		local a = complex64.abs(pr, pi)
		return pr / a, pi / a, logabs
	end

	-- Matrix norms: kind 1 (largest column sum of |a_ij|), "inf" (largest row sum), 2
	-- (largest singular value) or "fro" (Frobenius; the default).
	function ext.matnorm(A: Matrix, kind: (number | string)?): number
		local m, n = A.rows, A.cols
		local a = A.data
		if kind == nil or kind == "fro" then
			return norm(a)
		elseif kind == 2 then
			if m == 0 or n == 0 then
				return 0
			end
			return buffer.readf32(svd_copy(A, false).values, 0)
		elseif kind == 1 then
			local best = 0
			for j = 0, n - 1 do
				local s = 0
				for i = 0, m - 1 do
					s += complex64.abs(rd(a, j * m + i))
				end
				if not (s <= best) then
					best = s
				end
			end
			return best
		elseif kind == "inf" then
			local rows = table.create(m, 0) :: { number }
			for j = 0, n - 1 do
				for i = 0, m - 1 do
					rows[i + 1] += complex64.abs(rd(a, j * m + i))
				end
			end
			local best = 0
			for _, s in rows do
				if not (s <= best) then
					best = s
				end
			end
			return best
		end
		error(`matnorm: unknown kind {kind}`)
	end

	-- Solves A^H x = b given F = lu(A) (P A = L U, so A^H = U^H L^H P).
	function ext.lu_solve_adjoint(out: buffer?, F: LU, b: buffer): buffer
		assert(not F.singular, "matrix is singular")
		local n = F.lu.rows
		assert(buffer.len(b) == 8 * n, "matrix and vector sizes do not match")
		local o = copy(out, b)
		local a = F.lu.data
		-- U^H y = b, forward.
		for j = 0, n - 1 do
			local sr, si = rd(o, j)
			for i = 0, j - 1 do
				local ur, ui = rd(a, j * n + i)
				local yr, yi = rd(o, i)
				-- s -= conj(u_ij) y_i
				sr -= ur * yr + ui * yi
				si -= ur * yi - ui * yr
			end
			local dr, di = rd(a, j * n + j)
			wr(o, j, complex64.div(sr, si, dr, -di))
		end
		-- L^H z = y, backward (unit diagonal).
		for j = n - 1, 0, -1 do
			local sr, si = rd(o, j)
			for i = j + 1, n - 1 do
				local lr, li = rd(a, j * n + i)
				local zr, zi = rd(o, i)
				sr -= lr * zr + li * zi
				si -= lr * zi - li * zr
			end
			wr(o, j, sr, si)
		end
		-- x = P^T z: the interchanges in reverse.
		for k = n - 1, 0, -1 do
			local p = F.piv[k + 1] - 1
			if p ~= k then
				local xr, xi = rd(o, k)
				wr(o, k, rd(o, p))
				wr(o, p, xr, xi)
			end
		end
		return o
	end

	-- Helpers for the condition estimator: the 1-norm of a vector (sum of moduli), the
	-- unit-modulus signs x / |x| of its entries (1 for zero), the index (1-based) and
	-- modulus of its largest entry, the real part of the inner product, and e_j.
	function ext.asum(x: buffer): number
		local s = 0
		for i = 0, length(x) - 1 do
			s += complex64.abs(rd(x, i))
		end
		return s
	end

	function ext.signs(x: buffer): buffer
		local o = buffer.create(buffer.len(x))
		for i = 0, length(x) - 1 do
			local r, m = rd(x, i)
			local a = complex64.abs(r, m)
			if a == 0 then
				wr(o, i, 1, 0)
			else
				wr(o, i, r / a, m / a)
			end
		end
		return o
	end

	function ext.argmax(x: buffer): (number, number)
		local best, at = -1, 1
		for i = 0, length(x) - 1 do
			local v = complex64.abs(rd(x, i))
			if v > best then
				best, at = v, i + 1
			end
		end
		return best, at
	end

	ext.rdot = realdot

	function ext.unit(n: number, j: number): buffer
		local e = create(n)
		buffer.writef32(e, 8 * (j - 1), 1)
		return e
	end
end

function ext.trace(A: Matrix): vector
	return vector.create(ext.trace_pair(A))
end

-- (phase as a vector, log |det|)
function ext.slogdet(A: Matrix): (vector, number)
	local pr, pi, logabs = ext.slogdet_pair(A)
	return vector.create(pr, pi, 0), logabs
end

-- Bytes per matrix entry.
local ENTRY = buffer.len(matrix(1, 1).data)

-- Solves A x = b, or A X = B for a matrix B of right-hand sides (one factorization serves
-- every column; X is a new matrix, or `out`). `form` says what A is:
--   "matrix" (or nil)  a matrix. Square: LU with partial pivoting. More rows than
--                      columns: the least-squares solution, by Householder QR. More
--                      columns than rows: the basic solution, by column-pivoted QR.
--   "lu"               a factorization from lu or lu_copy
--   "qr"               a factorization from qr or qr_copy (least squares if tall)
--   "qrp"              a factorization from qrp or qrp_copy (any shape or rank; see
--                      qrp_solve, whose default rank tolerance is used)
--   "chol"             a factorization from chol or chol_copy
--   "svd"              a decomposition from svd or svd_copy, with vectors: the
--                      pseudoinverse solution A^+ b (minimum-norm least squares, any
--                      shape or rank; see svd_solve, whose default tolerance is used)
-- Neither A nor b is modified.
local function solve_impl(out: any, A: any, b: any, form: Form?): any
	local t = A :: any
	-- The solver for one right-hand side, and the number of unknowns.
	local one: any
	local n: number
	if form == "lu" then
		assert(type(t) == "table" and t.lu ~= nil, `solve: form "lu" needs a factorization from lu`)
		local F = A :: LU
		n = F.lu.cols
		one = function(o, v)
			return lu_solve(o, F, v)
		end
	elseif form == "qr" then
		assert(type(t) == "table" and t.qr ~= nil, `solve: form "qr" needs a factorization from qr`)
		assert(t.perm == nil, `solve: this is a pivoted factorization; use form "qrp"`)
		local F = A :: QR
		n = F.qr.cols
		one = function(o, v)
			return (qr_solve(o, F, v))
		end
	elseif form == "qrp" then
		assert(type(t) == "table" and t.perm ~= nil, `solve: form "qrp" needs a factorization from qrp`)
		local F = A :: QRP
		n = F.qr.cols
		one = function(o, v)
			return (qrp_solve(o, F, v))
		end
	elseif form == "chol" then
		assert(type(t) == "table" and t.chol ~= nil, `solve: form "chol" needs a factorization from chol`)
		local F = A :: Cholesky
		n = F.chol.cols
		one = function(o, v)
			return chol_solve(o, F, v)
		end
	elseif form == "svd" then
		assert(
			type(t) == "table" and t.values ~= nil and t.u ~= nil and t.v ~= nil,
			`solve: form "svd" needs a decomposition from svd with vectors`
		)
		local F = A :: Svd
		n = (F.v :: Matrix).rows
		one = function(o, v)
			return (svd_solve(o, F, v))
		end
	else
		assert(form == nil or form == "matrix", `solve: unknown form {form}`)
		assert(type(t) == "table" and t.data ~= nil, "solve: A is not a matrix (pass its form)")
		local M = A :: Matrix
		n = M.cols
		if M.rows == M.cols then
			local F = lu_copy(M)
			one = function(o, v)
				return lu_solve(o, F, v)
			end
		elseif M.rows > M.cols then
			local F = qr_copy(M)
			one = function(o, v)
				return (qr_solve(o, F, v))
			end
		else
			local F = qrp_copy(M)
			one = function(o, v)
				return (qrp_solve(o, F, v))
			end
		end
	end
	local solve1 = one :: (buffer?, buffer) -> buffer
	if type(b) == "buffer" then
		return solve1(out, b)
	end
	assert(type(b) == "table" and b.data ~= nil, "solve: b must be a vector or a matrix")
	local B = b :: Matrix
	local X = matoutput(out, n, B.cols)
	assert(X.data ~= B.data, "output cannot be the right-hand side")
	local col, x = buffer.create(ENTRY * B.rows), buffer.create(ENTRY * n)
	for j = 0, B.cols - 1 do
		buffer.copy(col, 0, B.data, ENTRY * j * B.rows, ENTRY * B.rows)
		solve1(x, col)
		buffer.copy(X.data, ENTRY * j * n, x)
	end
	return X
end

type SolveFunction =
	((out: buffer?, A: Matrix | LU | QR | QRP | Cholesky | Svd, b: buffer, form: Form?) -> buffer)
	& ((out: Matrix?, A: Matrix | LU | QR | QRP | Cholesky | Svd, B: Matrix, form: Form?) -> Matrix)

local solve: SolveFunction = solve_impl :: any

-- The conjugate transpose, for the shared polar code.
local conj_transpose = adjoint

-- Polar decomposition

-- QDWH (Nakatsukasa, Bai and Gygi 2010; in the form of Nakatsukasa and Higham 2013) for a
-- matrix with rows >= cols: returns U, with orthonormal columns, of A = U H as a new
-- matrix, and the number of iterations. X_0 = A / alpha with alpha = |A|_F >= |A|_2, and
-- l_0 <= sigma_min(X_0) from |R^-1|_F of A's QR factor. Each step applies the best
-- rational function of type (3, 2) for the current bound l, mapping [l, 1] into [l', 1]:
--   X' = (b / c) X + (a - b / c) X (I + c X^H X)^-1,
-- computed through the QR factorization of [sqrt(c) X; I] while c is large (for
-- stability) and through a Cholesky factorization once c <= 100. It converges cubically;
-- at most about 6 steps for condition numbers up to 1 / eps.
local function qdwh(A: Matrix): (Matrix, number)
	local m, n = A.rows, A.cols
	local alpha = norm(A.data)
	if alpha == 0 then
		-- The zero matrix: any U with orthonormal columns will do; take I's first columns.
		local U = matrix(m, n)
		for j = 0, n - 1 do
			buffer.writef32(U.data, ENTRY * (j * m + j), 1)
		end
		return U, 0
	end
	local X = matcopy(nil, A)
	X.data = scale(X.data, 1 / alpha, X.data)
	-- l_0: sigma_min(X) = sigma_min(R) >= 1 / |R^-1|_2 >= 1 / |R^-1|_F. A singular R gives
	-- l = eps, below which singular values are rounding noise.
	local R = qr_r(nil, qr_copy(X))
	local ok, Rinv = pcall(inv_copy, R)
	local l = if ok then 1 / norm((Rinv :: Matrix).data) else 0
	if not (l > EPS) then
		l = EPS
	end
	l = math.min(l, 1)
	local I = identity(n)
	local iterations = 0
	while iterations < 30 do
		local l2 = l * l
		local d = (4 * (1 - l2) / (l2 * l2)) ^ (1 / 3)
		local a = math.sqrt(1 + d) + 0.5 * math.sqrt(8 - 4 * d + 8 * (2 - l2) / (l2 * math.sqrt(1 + d)))
		local b = (a - 1) ^ 2 / 4
		local c = a + b - 1
		local Xnew = matrix(m, n)
		if c > 100 then
			-- [sqrt(c) X; I] = [Q1; Q2] R; then X' = (b / c) X + (a - b / c) / sqrt(c) Q1 Q2^H.
			local rc = math.sqrt(c)
			local stacked = matrix(m + n, n)
			local sx = scale(nil, rc, X.data)
			for j = 0, n - 1 do
				buffer.copy(stacked.data, ENTRY * j * (m + n), sx, ENTRY * j * m, ENTRY * m)
				buffer.writef32(stacked.data, ENTRY * (j * (m + n) + m + j), 1)
			end
			local Q = qr_q(nil, qr(stacked))
			local Q1, Q2 = matrix(m, n), matrix(n, n)
			for j = 0, n - 1 do
				buffer.copy(Q1.data, ENTRY * j * m, Q.data, ENTRY * j * (m + n), ENTRY * m)
				buffer.copy(Q2.data, ENTRY * j * n, Q.data, ENTRY * (j * (m + n) + m), ENTRY * n)
			end
			local P = matmul(nil, Q1, conj_transpose(nil, Q2))
			Xnew.data = axpy(nil, (a - b / c) / rc, P.data, scale(nil, b / c, X.data))
		else
			-- Z = I + c X^H X is positive definite; X Z^-1 = (Z^-1 X^H)^H.
			local Z = matmul(nil, conj_transpose(nil, X), X)
			Z.data = axpy(Z.data, c, Z.data, I.data)
			local F = chol(Z)
			local Y = solve(nil, F, conj_transpose(nil, X), "chol")
			Xnew.data = axpy(nil, a - b / c, conj_transpose(nil, Y).data, scale(nil, b / c, X.data))
		end
		iterations += 1
		local change = norm(sub(nil, Xnew.data, X.data))
		X = Xnew
		l = math.min(l * (a + b * l2) / (1 + c * l2), 1)
		-- Cubic convergence: once a step changes X by at most (5 eps)^(1/3), X is accurate
		-- to about 5 eps.
		if 1 - l <= 10 * EPS and change <= (5 * EPS) ^ (1 / 3) then
			break
		end
	end
	return X, iterations
end

-- Polar decomposition A = U H, in place: U has orthonormal columns (rows, if A is wide)
-- and overwrites A; H = U^H A is Hermitian positive semidefinite (cols by cols), new.
-- F.iterations counts the QDWH steps (see qdwh). For full-rank A both factors are unique;
-- U is then the closest matrix with orthonormal columns (or rows) to A in every unitarily
-- invariant norm. If A is exactly rank deficient, U is the canonical partial isometry
-- (U^H U projects onto the range of H); a numerically rank-deficient A, whose tiny singular
-- values rounding has made nonzero, gets an orthonormal U in a few more steps. A wide A is
-- handled through its adjoint. A NaN or infinite entry gives NaN factors. polar_copy
-- leaves A unchanged.
local function polar(A: Matrix): Polar
	local m, n = A.rows, A.cols
	local reals = buffer.len(A.data) // 4
	if any_nonfinite(A.data, 0, reals) then
		fill_nan(A.data, 0, reals)
		local H = matrix(n, n)
		fill_nan(H.data, 0, buffer.len(H.data) // 4)
		return { u = A, h = H, iterations = 0 }
	end
	local U: Matrix, iterations: number
	if m >= n then
		U, iterations = qdwh(A)
	else
		local V: Matrix
		V, iterations = qdwh(conj_transpose(nil, A))
		U = conj_transpose(nil, V)
	end
	local H = matmul(nil, conj_transpose(nil, U), A)
	-- Rounding leaves H very slightly non-Hermitian; take the Hermitian part.
	H.data = scale(nil, 0.5, add(nil, H.data, conj_transpose(nil, H).data))
	buffer.copy(A.data, 0, U.data)
	return { u = A, h = H, iterations = iterations }
end

-- The polar decomposition of a copy of A; A is not modified.
local function polar_copy(A: Matrix): Polar
	return polar(matcopy(nil, A))
end

-- Submatrices, rank and subspaces, condition numbers and the matrix exponential (shared by
-- the real and complex modules; entries are ENTRY bytes).

do
	-- Rows i0..i1 and columns j0..j1 of A (1-based, inclusive) as a new matrix (or out).
	function ext.submatrix(out: Matrix?, A: Matrix, i0: number, i1: number, j0: number, j1: number): Matrix
		assert(1 <= i0 and i0 <= i1 + 1 and i1 <= A.rows, "submatrix: rows out of range")
		assert(1 <= j0 and j0 <= j1 + 1 and j1 <= A.cols, "submatrix: columns out of range")
		local r, c = i1 - i0 + 1, j1 - j0 + 1
		local o = matoutput(out, r, c)
		assert(o.data ~= A.data, "output cannot be the input")
		for j = 0, c - 1 do
			buffer.copy(o.data, ENTRY * j * r, A.data, ENTRY * ((j0 - 1 + j) * A.rows + i0 - 1), ENTRY * r)
		end
		return o
	end

	-- Copies B into A with B's first entry at (i0, j0) (1-based); returns A.
	function ext.setsubmatrix(A: Matrix, i0: number, j0: number, B: Matrix): Matrix
		assert(i0 >= 1 and j0 >= 1 and i0 + B.rows - 1 <= A.rows and j0 + B.cols - 1 <= A.cols, "setsubmatrix: B does not fit")
		for j = 0, B.cols - 1 do
			buffer.copy(A.data, ENTRY * ((j0 - 1 + j) * A.rows + i0 - 1), B.data, ENTRY * j * B.rows, ENTRY * B.rows)
		end
		return A
	end

	-- [A1 A2 ...]: the matrices side by side (equal row counts).
	function ext.hstack(list: { Matrix }): Matrix
		assert(#list > 0, "hstack needs at least one matrix")
		local m, n = list[1].rows, 0
		for _, B in list do
			assert(B.rows == m, "hstack: row counts differ")
			n += B.cols
		end
		local o = matrix(m, n)
		local at = 0
		for _, B in list do
			buffer.copy(o.data, at, B.data)
			at += buffer.len(B.data)
		end
		return o
	end

	-- [A1; A2; ...]: the matrices stacked vertically (equal column counts).
	function ext.vstack(list: { Matrix }): Matrix
		assert(#list > 0, "vstack needs at least one matrix")
		local m, n = 0, list[1].cols
		for _, B in list do
			assert(B.cols == n, "vstack: column counts differ")
			m += B.rows
		end
		local o = matrix(m, n)
		local row = 1
		for _, B in list do
			ext.setsubmatrix(o, row, 1, B)
			row += B.rows
		end
		return o
	end

	-- The numerical rank of A from the SVD F: singular values above tol * s_1 (default
	-- tol = max(rows, cols) * eps, as for svd_solve).
	local function svd_rank(F: Svd, m: number, n: number, tol: number?): number
		local k = math.min(m, n)
		if k == 0 then
			return 0
		end
		local s = F.values
		local limit = (tol or math.max(m, n) * EPS) * buffer.readf32(s, 0)
		local r = 0
		while r < k and buffer.readf32(s, 4 * r) > limit do
			r += 1
		end
		return r
	end

	-- The numerical rank (see svd_rank for tol).
	function ext.rank(A: Matrix, tol: number?): number
		return svd_rank(svd_copy(A, false), A.rows, A.cols, tol)
	end

	-- An orthonormal basis of the range of A (rows by rank), from the SVD.
	function ext.orth(A: Matrix, tol: number?): Matrix
		local m, n = A.rows, A.cols
		local F = svd_copy(A)
		local r = svd_rank(F, m, n, tol)
		local U = F.u :: Matrix
		local o = matrix(m, r)
		buffer.copy(o.data, 0, U.data, 0, ENTRY * m * r)
		return o
	end

	-- An orthonormal basis of the null space of A (cols by cols - rank): the orthogonal
	-- complement of the first rank right singular vectors, completed through the full Q
	-- of their QR factorization.
	function ext.null_space(A: Matrix, tol: number?): Matrix
		local m, n = A.rows, A.cols
		local F = svd_copy(A)
		local r = svd_rank(F, m, n, tol)
		local N = matrix(n, n - r)
		if r == 0 then
			for j = 0, n - 1 do
				buffer.writef32(N.data, ENTRY * (j * n + j), 1)
			end
			return N
		end
		local Vr = matrix(n, r)
		buffer.copy(Vr.data, 0, (F.v :: Matrix).data, 0, ENTRY * n * r)
		local Q = qr(Vr)
		for j = r + 1, n do
			local e = ext.unit(n, j)
			qr_apply_q(Q, e)
			buffer.copy(N.data, ENTRY * (j - r - 1) * n, e)
		end
		return N
	end

	-- The condition number in the given norm (see matnorm): kind 2 (the default) is
	-- s_max / s_min from the SVD, for any shape (inf if rank deficient); kinds 1, "inf"
	-- and "fro" use the inverse of a square A (inf if singular).
	function ext.cond(A: Matrix, kind: (number | string)?): number
		local k = kind or 2
		if k == 2 then
			local q = math.min(A.rows, A.cols)
			if q == 0 then
				return 0
			end
			local s = svd_copy(A, false).values
			local smin = buffer.readf32(s, 4 * (q - 1))
			return if smin == 0 then math.huge else buffer.readf32(s, 0) / smin
		end
		assert(A.rows == A.cols, "cond: this norm needs a square matrix")
		local F = lu_copy(A)
		if F.singular then
			return math.huge
		end
		return ext.matnorm(A, k) * ext.matnorm(inv_copy(A), k)
	end

	-- An estimate of the reciprocal condition number 1 / (|A|_1 |A^-1|_1) from the LU
	-- factorization, in O(n^2) after it (LAPACK's gecon): |A^-1|_1 by Hager's method
	-- with Higham's refinements, which is almost always within a factor of 3 and never an
	-- overestimate. Returns 0 for a singular matrix. A is not modified.
	function ext.rcond(A: Matrix): number
		local n = A.rows
		assert(A.cols == n, "rcond needs a square matrix")
		if n == 0 then
			return math.huge
		end
		local anorm = ext.matnorm(A, 1)
		local F = lu_copy(A)
		if F.singular or anorm == 0 then
			return 0
		end
		-- Hager: maximize |A^-1 x|_1 over |x|_1 = 1 by a few gradient steps.
		local x = buffer.create(ENTRY * n)
		for i = 0, n - 1 do
			buffer.writef32(x, ENTRY * i, 1 / n)
		end
		local est, last = 0, 0
		for iter = 1, 5 do
			local y = lu_solve(nil, F, x)
			est = math.max(est, ext.asum(y))
			if iter > 1 and est <= last then
				break
			end
			last = est
			local z = ext.lu_solve_adjoint(nil, F, ext.signs(y))
			local zmax, j = ext.argmax(z)
			if iter > 1 and zmax <= ext.rdot(z, x) then
				break
			end
			x = ext.unit(n, j)
		end
		-- Higham's extra vector x_i = (-1)^i (1 + i / (n - 1)) guards against the cases
		-- where the gradient steps stall.
		local alt = buffer.create(buffer.len(x))
		for i = 0, n - 1 do
			buffer.writef32(alt, ENTRY * i, (if i % 2 == 0 then 1 else -1) * (1 + (if n > 1 then i / (n - 1) else 0)))
		end
		est = math.max(est, 2 * ext.asum(lu_solve(nil, F, alt)) / (3 * n))
		return 1 / (anorm * est)
	end

	-- Padé coefficients b_0 .. b_m of exp, and the 1-norm thresholds theta_m below which
	-- the [m/m] approximant is accurate to unit roundoff (Higham 2005; single precision
	-- uses its own thresholds and stops at m = 7).
	local PADE: { [number]: { number } } = {
		[3] = { 120, 60, 12, 1 },
		[5] = { 30240, 15120, 3360, 420, 30, 1 },
		[7] = { 17297280, 8648640, 1995840, 277200, 25200, 1512, 56, 1 },
		[9] = { 17643225600, 8821612800, 2075673600, 302702400, 30270240, 2162160, 110880, 3960, 90, 1 },
		[13] = {
			64764752532480000,
			32382376266240000,
			7771770303897600,
			1187353796428800,
			129060195264000,
			10559470521600,
			670442572800,
			33522128640,
			1323241920,
			40840800,
			960960,
			16380,
			182,
			1,
		},
	}
	local THETA: { { number } } = if EPS > 1e-10
		then { { 3, 4.258730016922831e-1 }, { 5, 1.880152677804762 }, { 7, 3.925724783138660 } }
		else {
			{ 3, 1.495585217958292e-2 },
			{ 5, 2.539398330063230e-1 },
			{ 7, 9.504178996162932e-1 },
			{ 9, 2.097847961257068 },
			{ 13, 5.371920351148152 },
		}

	-- The [m/m] Padé approximant r_m(A) = (V - U)^-1 (V + U), U odd and V even in A.
	local function pade(A: Matrix, m: number): Matrix
		local n = A.rows
		local b = PADE[m]
		local I = identity(n)
		local A2 = matmul(nil, A, A)
		local U: Matrix, V: Matrix
		if m < 13 then
			local us, vs = scale(nil, b[2], I.data), scale(nil, b[1], I.data)
			local P = A2
			for k = 1, (m - 1) // 2 do
				us = axpy(us, b[2 * k + 2], P.data, us)
				vs = axpy(vs, b[2 * k + 1], P.data, vs)
				if k < (m - 1) // 2 then
					P = matmul(nil, P, A2)
				end
			end
			local W = matrix(n, n)
			W.data = us
			U = matmul(nil, A, W)
			V = matrix(n, n)
			V.data = vs
		else
			local A4 = matmul(nil, A2, A2)
			local A6 = matmul(nil, A4, A2)
			local function combo(c6: number, c4: number, c2: number, c0: number): Matrix
				local M = matrix(n, n)
				local d = scale(nil, c6, A6.data)
				d = axpy(d, c4, A4.data, d)
				d = axpy(d, c2, A2.data, d)
				M.data = axpy(d, c0, I.data, d)
				return M
			end
			local inner = combo(b[14], b[12], b[10], 0)
			local W = matmul(nil, A6, inner)
			W.data = axpy(W.data, 1, combo(b[8], b[6], b[4], b[2]).data, W.data)
			U = matmul(nil, A, W)
			V = matmul(nil, A6, combo(b[13], b[11], b[9], 0))
			V.data = axpy(V.data, 1, combo(b[7], b[5], b[3], b[1]).data, V.data)
		end
		local P, Q = matrix(n, n), matrix(n, n)
		P.data = add(nil, V.data, U.data)
		Q.data = sub(nil, V.data, U.data)
		return solve(nil, Q, P)
	end

	-- The matrix exponential, by scaling and squaring with Padé approximants (Higham
	-- 2005): the smallest degree m in {3, 5, 7, 9, 13} whose threshold covers |A|_1, or
	-- else degree 13 on A / 2^s, squared s times. A is not modified; NaN or infinite
	-- entries give a NaN result.
	function ext.expm(A: Matrix): Matrix
		local n = A.rows
		assert(A.cols == n, "expm needs a square matrix")
		local reals = buffer.len(A.data) // 4
		if any_nonfinite(A.data, 0, reals) then
			local X = matrix(n, n)
			fill_nan(X.data, 0, reals)
			return X
		end
		if n == 0 then
			return matrix(0, 0)
		end
		local a = ext.matnorm(A, 1)
		for _, mt in THETA do
			if a <= mt[2] then
				return pade(A, mt[1])
			end
		end
		local top = THETA[#THETA]
		local s = math.max(0, math.ceil(math.log(a / top[2], 2)))
		local As = matrix(n, n)
		As.data = scale(nil, 2 ^ -s, A.data)
		local X = pade(As, top[1])
		for _ = 1, s do
			X = matmul(nil, X, X)
		end
		return X
	end
end

-- Matrix square root and logarithm by the Schur method (complex module).

do
	local function rd(x: buffer, i: number): (number, number)
		return buffer.readf32(x, 8 * i), buffer.readf32(x, 8 * i + 4)
	end

	local function wr(x: buffer, i: number, re: number, im: number)
		buffer.writef32(x, 8 * i, re)
		buffer.writef32(x, 8 * i + 4, im)
	end

	-- The principal square root R (R^2 = T) of an upper triangular T, column by column
	-- (Björck and Hammarling): r_ii = sqrt(t_ii), and for i < j
	--   r_ij = (t_ij - sum_(i<k<j) r_ik r_kj) / (r_ii + r_jj).
	-- Undefined (infinite entries) when r_ii + r_jj = 0, which needs a zero eigenvalue
	-- with a nontrivial Jordan block or two eigenvalues on opposite branches.
	function ext.sqrtm_triangular(T: Matrix): Matrix
		local n = T.rows
		local R = matrix(n, n)
		local t, r = T.data, R.data
		for i = 0, n - 1 do
			wr(r, i * n + i, complex64.sqrt(rd(t, i * n + i)))
		end
		for j = 1, n - 1 do
			local jr, ji = rd(r, j * n + j)
			for i = j - 1, 0, -1 do
				local sr, si = rd(t, j * n + i)
				for k = i + 1, j - 1 do
					local ar, ai = rd(r, k * n + i)
					local br, bi = rd(r, j * n + k)
					sr -= ar * br - ai * bi
					si -= ar * bi + ai * br
				end
				local ir, ii = rd(r, i * n + i)
				wr(r, j * n + i, complex64.div(sr, si, ir + jr, ii + ji))
			end
		end
		return R
	end

	-- Gauss-Legendre nodes and weights on [0, 1] (8 points): log(I + X) =
	-- integral over [0, 1] of X (I + t X)^-1 dt, exact to about 1e-19 for |X| <= 0.25.
	local GL_X = {
		0.019855071751231856,
		0.10166676129318664,
		0.2372337950418355,
		0.4082826787521751,
		0.5917173212478249,
		0.7627662049581645,
		0.8983332387068134,
		0.9801449282487681,
	}
	local GL_W = {
		0.05061426814518813,
		0.11119051722668724,
		0.15685332293894363,
		0.18134189168918100,
		0.18134189168918100,
		0.15685332293894363,
		0.11119051722668724,
		0.05061426814518813,
	}

	-- The principal logarithm of an upper triangular T by inverse scaling and squaring:
	-- square roots until |T^(1/2^s) - I|_1 <= 1/4, then the quadrature rule above (a
	-- diagonal Padé approximant of log(1 + x)), times 2^s. An error if T is singular to
	-- working precision.
	function ext.logm_triangular(T: Matrix): Matrix
		local n = T.rows
		-- Singular to working precision: an eigenvalue below eps times the largest.
		local big = 0
		for i = 0, n - 1 do
			big = math.max(big, complex64.abs(rd(T.data, i * n + i)))
		end
		for i = 0, n - 1 do
			assert(complex64.abs(rd(T.data, i * n + i)) > EPS * big, "logm: the matrix is singular")
		end
		local I = identity(n)
		local Tk = matcopy(nil, T)
		local s = 0
		local X = matrix(n, n)
		while true do
			X.data = sub(nil, Tk.data, I.data)
			if ext.matnorm(X, 1) <= 0.25 or s >= 64 then
				break
			end
			Tk = ext.sqrtm_triangular(Tk)
			s += 1
		end
		local L = matrix(n, n)
		for q = 1, 8 do
			local M = matrix(n, n)
			M.data = axpy(nil, GL_X[q], X.data, I.data)
			local Y = solve(nil, M, X)
			L.data = axpy(L.data, GL_W[q], Y.data, L.data)
		end
		L.data = scale(L.data, 2 ^ s, L.data)
		return L
	end

	-- The principal square root of A: X^2 = A with every eigenvalue in the right half
	-- plane (closed). By the Schur method: A = Z T Z^H, X = Z sqrt(T) Z^H. A is not
	-- modified.
	function ext.sqrtm(A: Matrix): Matrix
		assert(A.rows == A.cols, "sqrtm needs a square matrix")
		local F = schur_copy(A)
		local Z = F.z :: Matrix
		return matmul(nil, matmul(nil, Z, ext.sqrtm_triangular(F.schur)), adjoint(nil, Z))
	end

	-- The principal logarithm of A: exp(X) = A with eigenvalue imaginary parts in
	-- (-pi, pi]. By the Schur method; an error if A is singular. A is not modified.
	function ext.logm(A: Matrix): Matrix
		assert(A.rows == A.cols, "logm needs a square matrix")
		local F = schur_copy(A)
		local Z = F.z :: Matrix
		return matmul(nil, matmul(nil, Z, ext.logm_triangular(F.schur)), adjoint(nil, Z))
	end
end

