-- Generated by tools/generate.py from templates/complex/matrix.luau.in. Edit the template, not this file.

-- Double-precision complex matrices (column-major): creation and access, transposes, matrix-vector
-- products, submatrices and other utilities.
-- Indices are 1-based; arithmetic is done in double precision and rounded once per stored
-- value; every `out` argument may be nil, in which case a new result is allocated.

local types = require("./types")

-- Types and small helpers shared by the parts. They are copied into each part rather than
-- imported, so calls to them are inlined (a call into another module costs several times
-- more); the generator drops the ones a part does not use.

type Matrix = types.Matrix

-- The number of (complex) elements of x.
local function length(x: buffer): number
	return buffer.len(x) // 16
end

local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

-- A rows by cols matrix of zeros.
local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(16 * rows * cols) }
end

local function matoutput(out: Matrix?, rows: number, cols: number): Matrix
	if out == nil then
		return matrix(rows, cols)
	end
	assert(out.rows == rows and out.cols == cols, "output has the wrong shape")
	return out
end
local function cread(x: buffer, i: number): (number, number)
	return buffer.readf64(x, 16 * i), buffer.readf64(x, 16 * i + 8)
end

local function cwrite(x: buffer, i: number, re: number, im: number)
	buffer.writef64(x, 16 * i, re)
	buffer.writef64(x, 16 * i + 8, im)
end

-- Bytes per matrix entry.
local ENTRY = buffer.len(matrix(1, 1).data)

-- Builds a matrix from tables of rows of the real and (optional) imaginary parts.
local function matfrom(re: { { number } }, im: { { number } }?): Matrix
	local rows = #re
	local cols = if rows > 0 then #re[1] else 0
	assert(im == nil or #im == rows, "real and imaginary parts have different shapes")
	local A = matrix(rows, cols)
	for i = 1, rows do
		local row = re[i]
		assert(#row == cols, "rows have different lengths")
		local irow = if im then im[i] else nil
		assert(irow == nil or #irow == cols, "real and imaginary parts have different shapes")
		for j = 1, cols do
			local k = 16 * ((j - 1) * rows + i - 1)
			buffer.writef64(A.data, k, row[j])
			if irow then
				buffer.writef64(A.data, k + 8, irow[j])
			end
		end
	end
	return A
end

-- Returns tables of rows of the real and imaginary parts.
local function mattotable(A: Matrix): ({ { number } }, { { number } })
	local re, im = table.create(A.rows) :: { { number } }, table.create(A.rows) :: { { number } }
	for i = 1, A.rows do
		local rrow, irow = table.create(A.cols, 0), table.create(A.cols, 0)
		for j = 1, A.cols do
			local k = 16 * ((j - 1) * A.rows + i - 1)
			rrow[j] = buffer.readf64(A.data, k)
			irow[j] = buffer.readf64(A.data, k + 8)
		end
		re[i], im[i] = rrow, irow
	end
	return re, im
end

-- The n by n identity matrix.
local function identity(n: number): Matrix
	local A = matrix(n, n)
	for i = 0, n - 1 do
		buffer.writef64(A.data, 16 * (i * n + i), 1)
	end
	return A
end

-- out := A (a new matrix if out is nil).
local function matcopy(out: Matrix?, A: Matrix): Matrix
	local o = matoutput(out, A.rows, A.cols)
	if o.data ~= A.data then
		buffer.copy(o.data, 0, A.data)
	end
	return o
end

local function transpose_impl(out: Matrix?, A: Matrix, sign: number): Matrix
	local m, n = A.rows, A.cols
	local o = matoutput(out, n, m)
	assert(o.data ~= A.data, "transpose cannot be done in place")
	local a, d = A.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local s, t = 16 * (j * m + i), 16 * (i * n + j)
			buffer.writef64(d, t, buffer.readf64(a, s))
			buffer.writef64(d, t + 8, sign * buffer.readf64(a, s + 8))
		end
	end
	return o
end

-- out := A^T (a new matrix if out is nil); see adjoint for A^H.
local function transpose(out: Matrix?, A: Matrix): Matrix
	return transpose_impl(out, A, 1)
end

-- Conjugate transpose.
local function adjoint(out: Matrix?, A: Matrix): Matrix
	return transpose_impl(out, A, -1)
end

-- A x
local function matvec(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(buffer.len(x) == 16 * n, "matrix and vector sizes do not match")
	local o = output(out, 16 * m)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, m - 1 do
		local sr, si = 0, 0
		for j = 0, n - 1 do
			local k = 16 * (j * m + i)
			local ar, ai = buffer.readf64(a, k), buffer.readf64(a, k + 8) :: number
			local xr, xi = buffer.readf64(x, 16 * j), buffer.readf64(x, (16 * j) + 8) :: number
			sr += ar * xr - ai * xi
			si += ar * xi + ai * xr
		end
		do
			local here_ = 16 * i
			buffer.writef64(o, here_, sr)
			buffer.writef64(o, here_ + 8, si)
		end
	end
	return o
end

local function matget(A: Matrix, i: number, j: number): (number, number)
	local k = 16 * ((j - 1) * A.rows + i - 1)
	return buffer.readf64(A.data, k), buffer.readf64(A.data, k + 8) :: number
end

local function matset(A: Matrix, i: number, j: number, re: number, im: number)
	do
		local here_ = 16 * ((j - 1) * A.rows + i - 1)
		buffer.writef64(A.data, here_, re)
		buffer.writef64(A.data, here_ + 8, im)
	end
end

-- The sum of the diagonal, as (re, im).
local function trace_pair(A: Matrix): (number, number)
	local sr, si = 0, 0
	for i = 0, math.min(A.rows, A.cols) - 1 do
		local r, m = cread(A.data, i * A.rows + i)
		sr += r
		si += m
	end
	return sr, si
end

-- The diagonal (min(rows, cols) entries), as an array.
local function diag(out: buffer?, A: Matrix): buffer
	local n = math.min(A.rows, A.cols)
	local o = output(out, 16 * n)
	for i = 0, n - 1 do
		cwrite(o, i, cread(A.data, i * A.rows + i))
	end
	return o
end

-- The square matrix with the array x on its diagonal.
local function diagm(x: buffer): Matrix
	local n = length(x)
	local D = matrix(n, n)
	for i = 0, n - 1 do
		cwrite(D.data, i * n + i, cread(x, i))
	end
	return D
end

-- The Kronecker product: the block matrix [a_ij B].
local function kron(A: Matrix, B: Matrix): Matrix
	local m, n, p, q = A.rows, A.cols, B.rows, B.cols
	local K = matrix(m * p, n * q)
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local ar, ai = cread(A.data, j * m + i)
			if ar ~= 0 or ai ~= 0 then
				for l = 0, q - 1 do
					local col = (j * q + l) * m * p + i * p
					for r = 0, p - 1 do
						local br, bi = cread(B.data, l * p + r)
						cwrite(K.data, col + r, ar * br - ai * bi, ar * bi + ai * br)
					end
				end
			end
		end
	end
	return K
end

-- The outer product x y^H.
local function outer(out: Matrix?, x: buffer, y: buffer): Matrix
	local m, n = length(x), length(y)
	local o = matoutput(out, m, n)
	for j = 0, n - 1 do
		local yr, yi = cread(y, j)
		yi = -yi
		for i = 0, m - 1 do
			local xr, xi = cread(x, i)
			cwrite(o.data, j * m + i, xr * yr - xi * yi, xr * yi + xi * yr)
		end
	end
	return o
end

-- The rank-one update A := A + a x y^H with real a, in place (BLAS gerc); returns A.
local function ger(A: Matrix, a: number, x: buffer, y: buffer): Matrix
	local m, n = A.rows, A.cols
	assert(length(x) == m and length(y) == n, "ger: sizes do not match")
	for j = 0, n - 1 do
		local yr, yi = cread(y, j)
		local fr, fi = a * yr, -a * yi
		if fr ~= 0 or fi ~= 0 then
			for i = 0, m - 1 do
				local xr, xi = cread(x, i)
				local cr, ci = cread(A.data, j * m + i)
				cwrite(A.data, j * m + i, cr + xr * fr - xi * fi, ci + xr * fi + xi * fr)
			end
		end
	end
	return A
end

-- A^H x, without forming the adjoint.
local function matvec_adjoint(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(length(x) == m, "matvec_adjoint: sizes do not match")
	local o = output(out, 16 * n)
	assert(o ~= x, "output cannot be the input vector")
	for j = 0, n - 1 do
		local sr, si = 0, 0
		for i = 0, m - 1 do
			local ar, ai = cread(A.data, j * m + i)
			local xr, xi = cread(x, i)
			sr += ar * xr + ai * xi
			si += ar * xi - ai * xr
		end
		cwrite(o, j, sr, si)
	end
	return o
end

local trace = trace_pair

-- The conjugate transpose, for the shared polar code.
local conj_transpose = adjoint

-- Submatrices, rank and subspaces, condition numbers and the matrix exponential (shared by
-- the real and complex modules; entries are ENTRY bytes).

-- Rows i0..i1 and columns j0..j1 of A (1-based, inclusive) as a new matrix (or out).
local function submatrix(out: Matrix?, A: Matrix, i0: number, i1: number, j0: number, j1: number): Matrix
	assert(1 <= i0 and i0 <= i1 + 1 and i1 <= A.rows, "submatrix: rows out of range")
	assert(1 <= j0 and j0 <= j1 + 1 and j1 <= A.cols, "submatrix: columns out of range")
	local r, c = i1 - i0 + 1, j1 - j0 + 1
	local o = matoutput(out, r, c)
	assert(o.data ~= A.data, "output cannot be the input")
	for j = 0, c - 1 do
		buffer.copy(o.data, ENTRY * j * r, A.data, ENTRY * ((j0 - 1 + j) * A.rows + i0 - 1), ENTRY * r)
	end
	return o
end

-- Copies B into A with B's first entry at (i0, j0) (1-based); returns A.
local function setsubmatrix(A: Matrix, i0: number, j0: number, B: Matrix): Matrix
	assert(i0 >= 1 and j0 >= 1 and i0 + B.rows - 1 <= A.rows and j0 + B.cols - 1 <= A.cols, "setsubmatrix: B does not fit")
	for j = 0, B.cols - 1 do
		buffer.copy(A.data, ENTRY * ((j0 - 1 + j) * A.rows + i0 - 1), B.data, ENTRY * j * B.rows, ENTRY * B.rows)
	end
	return A
end

-- [A1 A2 ...]: the matrices side by side (equal row counts).
local function hstack(list: { Matrix }): Matrix
	assert(#list > 0, "hstack needs at least one matrix")
	local m, n = list[1].rows, 0
	for _, B in list do
		assert(B.rows == m, "hstack: row counts differ")
		n += B.cols
	end
	local o = matrix(m, n)
	local at = 0
	for _, B in list do
		buffer.copy(o.data, at, B.data)
		at += buffer.len(B.data)
	end
	return o
end

-- [A1; A2; ...]: the matrices stacked vertically (equal column counts).
local function vstack(list: { Matrix }): Matrix
	assert(#list > 0, "vstack needs at least one matrix")
	local m, n = 0, list[1].cols
	for _, B in list do
		assert(B.cols == n, "vstack: column counts differ")
		m += B.rows
	end
	local o = matrix(m, n)
	local row = 1
	for _, B in list do
		setsubmatrix(o, row, 1, B)
		row += B.rows
	end
	return o
end

return {
	adjoint = adjoint,
	diag = diag,
	diagm = diagm,
	ger = ger,
	hstack = hstack,
	identity = identity,
	kron = kron,
	matcopy = matcopy,
	matfrom = matfrom,
	matget = matget,
	matset = matset,
	mattotable = mattotable,
	matvec = matvec,
	matvec_adjoint = matvec_adjoint,
	outer = outer,
	setsubmatrix = setsubmatrix,
	submatrix = submatrix,
	trace = trace,
	transpose = transpose,
	vstack = vstack,
	conj_transpose = conj_transpose,
}
