				do local ar, ai = buffer.readf32(vals, v + 8 * 3), buffer.readf32(vals, v + 8 * 3 + 4); sr0 += ar * xr1 - ai * xi1; si0 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 6), buffer.readf32(vals, v + 8 * 6 + 4); sr0 += ar * xr2 - ai * xi2; si0 += ar * xi2 + ai * xr2 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 1), buffer.readf32(vals, v + 8 * 1 + 4); sr1 += ar * xr0 - ai * xi0; si1 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 4), buffer.readf32(vals, v + 8 * 4 + 4); sr1 += ar * xr1 - ai * xi1; si1 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 7), buffer.readf32(vals, v + 8 * 7 + 4); sr1 += ar * xr2 - ai * xi2; si1 += ar * xi2 + ai * xr2 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 2), buffer.readf32(vals, v + 8 * 2 + 4); sr2 += ar * xr0 - ai * xi0; si2 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 5), buffer.readf32(vals, v + 8 * 5 + 4); sr2 += ar * xr1 - ai * xi1; si2 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 8), buffer.readf32(vals, v + 8 * 8 + 4); sr2 += ar * xr2 - ai * xi2; si2 += ar * xi2 + ai * xr2 end
			end
			local w = 8 * 3 * I
			buffer.writef32(o, w + 8 * 0, sr0)
			buffer.writef32(o, w + 8 * 0 + 4, si0)
			buffer.writef32(o, w + 8 * 1, sr1)
			buffer.writef32(o, w + 8 * 1 + 4, si1)
			buffer.writef32(o, w + 8 * 2, sr2)
			buffer.writef32(o, w + 8 * 2 + 4, si2)
			p0 = p1
		end
	end

	local function mvt3(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 3 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = 8 * 3 * I
			local xr0, xi0, xr1, xi1, xr2, xi2 = buffer.readf32(x, xb + 8 * 0), buffer.readf32(x, xb + 8 * 0 + 4), buffer.readf32(x, xb + 8 * 1), buffer.readf32(x, xb + 8 * 1 + 4), buffer.readf32(x, xb + 8 * 2), buffer.readf32(x, xb + 8 * 2 + 4)
			for p = p0, p1 - 1 do
				local c = 48 * buffer.readu32(colind, 4 * p)
				local v = 8 * 9 * p
				do
					local ur, ui = 0, 0
					do local ar, ai = buffer.readf32(vals, v + 8 * 0), buffer.readf32(vals, v + 8 * 0 + 4); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 1), buffer.readf32(vals, v + 8 * 1 + 4); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
