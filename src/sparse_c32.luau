					buffer.writef64(acc, c, buffer.readf64(acc, c) + ur)
					buffer.writef64(acc, c + 8, buffer.readf64(acc, c + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = buffer.readf32(vals, v + 8 * 4), buffer.readf32(vals, v + 8 * 4 + 4); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 5), buffer.readf32(vals, v + 8 * 5 + 4); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 6), buffer.readf32(vals, v + 8 * 6 + 4); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 7), buffer.readf32(vals, v + 8 * 7 + 4); ur += ar * xr3 + ai * xi3; ui += ar * xi3 - ai * xr3 end
					buffer.writef64(acc, c + 16, buffer.readf64(acc, c + 16) + ur)
					buffer.writef64(acc, c + 16 + 8, buffer.readf64(acc, c + 16 + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = buffer.readf32(vals, v + 8 * 8), buffer.readf32(vals, v + 8 * 8 + 4); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 9), buffer.readf32(vals, v + 8 * 9 + 4); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 10), buffer.readf32(vals, v + 8 * 10 + 4); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 11), buffer.readf32(vals, v + 8 * 11 + 4); ur += ar * xr3 + ai * xi3; ui += ar * xi3 - ai * xr3 end
					buffer.writef64(acc, c + 32, buffer.readf64(acc, c + 32) + ur)
					buffer.writef64(acc, c + 32 + 8, buffer.readf64(acc, c + 32 + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = buffer.readf32(vals, v + 8 * 12), buffer.readf32(vals, v + 8 * 12 + 4); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 13), buffer.readf32(vals, v + 8 * 13 + 4); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 14), buffer.readf32(vals, v + 8 * 14 + 4); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 15), buffer.readf32(vals, v + 8 * 15 + 4); ur += ar * xr3 + ai * xi3; ui += ar * xi3 - ai * xr3 end
					buffer.writef64(acc, c + 48, buffer.readf64(acc, c + 48) + ur)
					buffer.writef64(acc, c + 48 + 8, buffer.readf64(acc, c + 48 + 8) + ui)
