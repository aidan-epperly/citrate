					buffer.writef64(acc, c, buffer.readf64(acc, c) + ur)
					buffer.writef64(acc, c + 8, buffer.readf64(acc, c + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = buffer.readf32(vals, v + 8 * 3), buffer.readf32(vals, v + 8 * 3 + 4); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 4), buffer.readf32(vals, v + 8 * 4 + 4); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 5), buffer.readf32(vals, v + 8 * 5 + 4); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					buffer.writef64(acc, c + 16, buffer.readf64(acc, c + 16) + ur)
					buffer.writef64(acc, c + 16 + 8, buffer.readf64(acc, c + 16 + 8) + ui)
				end
				do
					local ur, ui = 0, 0
					do local ar, ai = buffer.readf32(vals, v + 8 * 6), buffer.readf32(vals, v + 8 * 6 + 4); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 7), buffer.readf32(vals, v + 8 * 7 + 4); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 8), buffer.readf32(vals, v + 8 * 8 + 4); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
					buffer.writef64(acc, c + 32, buffer.readf64(acc, c + 32) + ur)
					buffer.writef64(acc, c + 32 + 8, buffer.readf64(acc, c + 32 + 8) + ui)
				end
			end
			p0 = p1
		end
	end

	local function pj3(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = 8 * 3 * I, 144 * I
			local tr0, ti0, tr1, ti1, tr2, ti2 = buffer.readf32(r, base + 8 * 0), buffer.readf32(r, base + 8 * 0 + 4), buffer.readf32(r, base + 8 * 1), buffer.readf32(r, base + 8 * 1 + 4), buffer.readf32(r, base + 8 * 2), buffer.readf32(r, base + 8 * 2 + 4)
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 0), buffer.readf64(inv, v + 8); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 48), buffer.readf64(inv, v + 56); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 96), buffer.readf64(inv, v + 104); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				buffer.writef32(o, base + 8 * 0, ur)
				buffer.writef32(o, base + 8 * 0 + 4, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 16), buffer.readf64(inv, v + 24); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 64), buffer.readf64(inv, v + 72); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 112), buffer.readf64(inv, v + 120); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				buffer.writef32(o, base + 8 * 1, ur)
				buffer.writef32(o, base + 8 * 1 + 4, ui)
			end
			do
				local ur, ui = 0, 0
				do local ar, ai = buffer.readf64(inv, v + 32), buffer.readf64(inv, v + 40); ur += ar * tr0 - ai * ti0; ui += ar * ti0 + ai * tr0 end
				do local ar, ai = buffer.readf64(inv, v + 80), buffer.readf64(inv, v + 88); ur += ar * tr1 - ai * ti1; ui += ar * ti1 + ai * tr1 end
				do local ar, ai = buffer.readf64(inv, v + 128), buffer.readf64(inv, v + 136); ur += ar * tr2 - ai * ti2; ui += ar * ti2 + ai * tr2 end
				buffer.writef32(o, base + 8 * 2, ur)
				buffer.writef32(o, base + 8 * 2 + 4, ui)
			end
		end
	end

	spk.block[3] = { mv = mv3, mvt = mvt3, jacobi = pj3 }

	local function mv4(o: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 4 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local sr0, si0, sr1, si1, sr2, si2, sr3, si3 = 0, 0, 0, 0, 0, 0, 0, 0
			for p = p0, p1 - 1 do
				local c = 8 * 4 * buffer.readu32(colind, 4 * p)
				local xr0, xi0, xr1, xi1, xr2, xi2, xr3, xi3 = buffer.readf32(x, c + 8 * 0), buffer.readf32(x, c + 8 * 0 + 4), buffer.readf32(x, c + 8 * 1), buffer.readf32(x, c + 8 * 1 + 4), buffer.readf32(x, c + 8 * 2), buffer.readf32(x, c + 8 * 2 + 4), buffer.readf32(x, c + 8 * 3), buffer.readf32(x, c + 8 * 3 + 4)
				local v = 8 * 16 * p
				do local ar, ai = buffer.readf32(vals, v + 8 * 0), buffer.readf32(vals, v + 8 * 0 + 4); sr0 += ar * xr0 - ai * xi0; si0 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 4), buffer.readf32(vals, v + 8 * 4 + 4); sr0 += ar * xr1 - ai * xi1; si0 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 8), buffer.readf32(vals, v + 8 * 8 + 4); sr0 += ar * xr2 - ai * xi2; si0 += ar * xi2 + ai * xr2 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 12), buffer.readf32(vals, v + 8 * 12 + 4); sr0 += ar * xr3 - ai * xi3; si0 += ar * xi3 + ai * xr3 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 1), buffer.readf32(vals, v + 8 * 1 + 4); sr1 += ar * xr0 - ai * xi0; si1 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 5), buffer.readf32(vals, v + 8 * 5 + 4); sr1 += ar * xr1 - ai * xi1; si1 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 9), buffer.readf32(vals, v + 8 * 9 + 4); sr1 += ar * xr2 - ai * xi2; si1 += ar * xi2 + ai * xr2 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 13), buffer.readf32(vals, v + 8 * 13 + 4); sr1 += ar * xr3 - ai * xi3; si1 += ar * xi3 + ai * xr3 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 2), buffer.readf32(vals, v + 8 * 2 + 4); sr2 += ar * xr0 - ai * xi0; si2 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 6), buffer.readf32(vals, v + 8 * 6 + 4); sr2 += ar * xr1 - ai * xi1; si2 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 10), buffer.readf32(vals, v + 8 * 10 + 4); sr2 += ar * xr2 - ai * xi2; si2 += ar * xi2 + ai * xr2 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 14), buffer.readf32(vals, v + 8 * 14 + 4); sr2 += ar * xr3 - ai * xi3; si2 += ar * xi3 + ai * xr3 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 3), buffer.readf32(vals, v + 8 * 3 + 4); sr3 += ar * xr0 - ai * xi0; si3 += ar * xi0 + ai * xr0 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 7), buffer.readf32(vals, v + 8 * 7 + 4); sr3 += ar * xr1 - ai * xi1; si3 += ar * xi1 + ai * xr1 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 11), buffer.readf32(vals, v + 8 * 11 + 4); sr3 += ar * xr2 - ai * xi2; si3 += ar * xi2 + ai * xr2 end
				do local ar, ai = buffer.readf32(vals, v + 8 * 15), buffer.readf32(vals, v + 8 * 15 + 4); sr3 += ar * xr3 - ai * xi3; si3 += ar * xi3 + ai * xr3 end
			end
			local w = 8 * 4 * I
			buffer.writef32(o, w + 8 * 0, sr0)
			buffer.writef32(o, w + 8 * 0 + 4, si0)
			buffer.writef32(o, w + 8 * 1, sr1)
			buffer.writef32(o, w + 8 * 1 + 4, si1)
			buffer.writef32(o, w + 8 * 2, sr2)
			buffer.writef32(o, w + 8 * 2 + 4, si2)
			buffer.writef32(o, w + 8 * 3, sr3)
			buffer.writef32(o, w + 8 * 3 + 4, si3)
			p0 = p1
		end
	end

	local function mvt4(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 4 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = 8 * 4 * I
			local xr0, xi0, xr1, xi1, xr2, xi2, xr3, xi3 = buffer.readf32(x, xb + 8 * 0), buffer.readf32(x, xb + 8 * 0 + 4), buffer.readf32(x, xb + 8 * 1), buffer.readf32(x, xb + 8 * 1 + 4), buffer.readf32(x, xb + 8 * 2), buffer.readf32(x, xb + 8 * 2 + 4), buffer.readf32(x, xb + 8 * 3), buffer.readf32(x, xb + 8 * 3 + 4)
			for p = p0, p1 - 1 do
				local c = 64 * buffer.readu32(colind, 4 * p)
				local v = 8 * 16 * p
				do
					local ur, ui = 0, 0
					do local ar, ai = buffer.readf32(vals, v + 8 * 0), buffer.readf32(vals, v + 8 * 0 + 4); ur += ar * xr0 + ai * xi0; ui += ar * xi0 - ai * xr0 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 1), buffer.readf32(vals, v + 8 * 1 + 4); ur += ar * xr1 + ai * xi1; ui += ar * xi1 - ai * xr1 end
					do local ar, ai = buffer.readf32(vals, v + 8 * 2), buffer.readf32(vals, v + 8 * 2 + 4); ur += ar * xr2 + ai * xi2; ui += ar * xi2 - ai * xr2 end
