-- Single-precision real matrices (column-major): creation and access, transposes, matrix-vector
-- products, submatrices and other utilities.
-- Indices are 1-based; arithmetic is done in double precision and rounded once per stored
-- value; every `out` argument may be nil, in which case a new result is allocated.

local types = require("./types")

-- Types and small helpers shared by the parts. They are copied into each part rather than
-- imported, so calls to them are inlined (a call into another module costs several times
-- more); the generator drops the ones a part does not use.

type Matrix = types.Matrix

-- The number of elements of x.
local function length(x: buffer): number
	return buffer.len(x) // 4
end

local function output(out: buffer?, bytes: number): buffer
	if out == nil then
		return buffer.create(bytes)
	end
	assert(buffer.len(out) == bytes, "output has the wrong length")
	return out
end

-- A rows by cols matrix of zeros.
local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(4 * rows * cols) }
end

local function matoutput(out: Matrix?, rows: number, cols: number): Matrix
	if out == nil then
		return matrix(rows, cols)
	end
	assert(out.rows == rows and out.cols == cols, "output has the wrong shape")
	return out
end

-- Bytes per matrix entry.
local ENTRY = buffer.len(matrix(1, 1).data)

-- Builds a matrix from a table of rows.
local function matfrom(t: { { number } }): Matrix
	local rows = #t
	local cols = if rows > 0 then #t[1] else 0
	local A = matrix(rows, cols)
	for i = 1, rows do
		local row = t[i]
		assert(#row == cols, "rows have different lengths")
		for j = 1, cols do
			buffer.writef32(A.data, 4 * ((j - 1) * rows + i - 1), row[j])
		end
	end
	return A
end

-- Returns a table of rows.
local function mattotable(A: Matrix): { { number } }
	local t = table.create(A.rows) :: { { number } }
	for i = 1, A.rows do
		local row = table.create(A.cols, 0)
		for j = 1, A.cols do
			row[j] = buffer.readf32(A.data, 4 * ((j - 1) * A.rows + i - 1))
		end
		t[i] = row
	end
	return t
end

-- The n by n identity matrix.
local function identity(n: number): Matrix
	local A = matrix(n, n)
	for i = 0, n - 1 do
		buffer.writef32(A.data, 4 * (i * n + i), 1)
	end
	return A
end

-- Entry (i, j).
local function matget(A: Matrix, i: number, j: number): number
	return buffer.readf32(A.data, 4 * ((j - 1) * A.rows + i - 1))
end

-- Sets entry (i, j) to v.
local function matset(A: Matrix, i: number, j: number, v: number)
	buffer.writef32(A.data, 4 * ((j - 1) * A.rows + i - 1), v)
end

-- out := A (a new matrix if out is nil).
local function matcopy(out: Matrix?, A: Matrix): Matrix
	local o = matoutput(out, A.rows, A.cols)
	if o.data ~= A.data then
		buffer.copy(o.data, 0, A.data)
	end
	return o
end

-- out := A^T (a new matrix if out is nil).
local function transpose(out: Matrix?, A: Matrix): Matrix
	local m, n = A.rows, A.cols
	local o = matoutput(out, n, m)
	assert(o.data ~= A.data, "transpose cannot be done in place")
	local a, d = A.data, o.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			buffer.writef32(d, 4 * (i * n + j), buffer.readf32(a, 4 * (j * m + i)))
		end
	end
	return o
end

-- A x
local function matvec(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(buffer.len(x) == 4 * n, "matrix and vector sizes do not match")
	local o = output(out, 4 * m)
	assert(o ~= x, "output cannot be the input vector")
	local a = A.data
	for i = 0, m - 1 do
		local s = 0
		for j = 0, n - 1 do
			s += buffer.readf32(a, 4 * (j * m + i)) * buffer.readf32(x, 4 * j)
		end
		buffer.writef32(o, 4 * i, s)
	end
	return o
end
-- Matrix utilities, matrix norms, slogdet and transposed LU solves.

-- The sum of the diagonal.
local function trace(A: Matrix): number
	local s = 0
	for i = 0, math.min(A.rows, A.cols) - 1 do
		s += buffer.readf32(A.data, 4 * (i * A.rows + i))
	end
	return s
end

-- The diagonal (min(rows, cols) entries), as an array.
local function diag(out: buffer?, A: Matrix): buffer
	local n = math.min(A.rows, A.cols)
	local o = output(out, 4 * n)
	for i = 0, n - 1 do
		buffer.writef32(o, 4 * i, buffer.readf32(A.data, 4 * (i * A.rows + i)))
	end
	return o
end

-- The square matrix with the array x on its diagonal.
local function diagm(x: buffer): Matrix
	local n = length(x)
	local D = matrix(n, n)
	for i = 0, n - 1 do
		buffer.writef32(D.data, 4 * (i * n + i), buffer.readf32(x, 4 * i))
	end
	return D
end

-- The Kronecker product: the block matrix [a_ij B].
local function kron(A: Matrix, B: Matrix): Matrix
	local m, n, p, q = A.rows, A.cols, B.rows, B.cols
	local K = matrix(m * p, n * q)
	local k, a, b = K.data, A.data, B.data
	for j = 0, n - 1 do
		for i = 0, m - 1 do
			local aij = buffer.readf32(a, 4 * (j * m + i))
			if aij ~= 0 then
				for l = 0, q - 1 do
					local col = (j * q + l) * m * p + i * p
					for r = 0, p - 1 do
						buffer.writef32(k, 4 * (col + r), aij * buffer.readf32(b, 4 * (l * p + r)))
					end
				end
			end
		end
	end
	return K
end

-- The outer product x y^T.
local function outer(out: Matrix?, x: buffer, y: buffer): Matrix
	local m, n = length(x), length(y)
	local o = matoutput(out, m, n)
	for j = 0, n - 1 do
		local yj = buffer.readf32(y, 4 * j)
		for i = 0, m - 1 do
			buffer.writef32(o.data, 4 * (j * m + i), buffer.readf32(x, 4 * i) * yj)
		end
	end
	return o
end

-- The rank-one update A := A + a x y^T, in place (BLAS ger); returns A.
local function ger(A: Matrix, a: number, x: buffer, y: buffer): Matrix
	local m, n = A.rows, A.cols
	assert(length(x) == m and length(y) == n, "ger: sizes do not match")
	for j = 0, n - 1 do
		local f = a * buffer.readf32(y, 4 * j)
		if f ~= 0 then
			for i = 0, m - 1 do
				local o = 4 * (j * m + i)
				buffer.writef32(A.data, o, buffer.readf32(A.data, o) + f * buffer.readf32(x, 4 * i))
			end
		end
	end
	return A
end

-- A^T x, without forming the transpose.
local function matvec_adjoint(out: buffer?, A: Matrix, x: buffer): buffer
	local m, n = A.rows, A.cols
	assert(length(x) == m, "matvec_adjoint: sizes do not match")
	local o = output(out, 4 * n)
	assert(o ~= x, "output cannot be the input vector")
	for j = 0, n - 1 do
		local s = 0
		for i = 0, m - 1 do
			s += buffer.readf32(A.data, 4 * (j * m + i)) * buffer.readf32(x, 4 * i)
		end
		buffer.writef32(o, 4 * j, s)
	end
	return o
end

-- The conjugate transpose, for the shared polar code.
local conj_transpose = transpose

-- Submatrices, rank and subspaces, condition numbers and the matrix exponential (shared by
-- the real and complex modules; entries are ENTRY bytes).

-- Rows i0..i1 and columns j0..j1 of A (1-based, inclusive) as a new matrix (or out).
local function submatrix(out: Matrix?, A: Matrix, i0: number, i1: number, j0: number, j1: number): Matrix
	assert(1 <= i0 and i0 <= i1 + 1 and i1 <= A.rows, "submatrix: rows out of range")
	assert(1 <= j0 and j0 <= j1 + 1 and j1 <= A.cols, "submatrix: columns out of range")
	local r, c = i1 - i0 + 1, j1 - j0 + 1
	local o = matoutput(out, r, c)
	assert(o.data ~= A.data, "output cannot be the input")
	for j = 0, c - 1 do
		buffer.copy(o.data, ENTRY * j * r, A.data, ENTRY * ((j0 - 1 + j) * A.rows + i0 - 1), ENTRY * r)
	end
	return o
end

-- Copies B into A with B's first entry at (i0, j0) (1-based); returns A.
local function setsubmatrix(A: Matrix, i0: number, j0: number, B: Matrix): Matrix
	assert(i0 >= 1 and j0 >= 1 and i0 + B.rows - 1 <= A.rows and j0 + B.cols - 1 <= A.cols, "setsubmatrix: B does not fit")
	for j = 0, B.cols - 1 do
		buffer.copy(A.data, ENTRY * ((j0 - 1 + j) * A.rows + i0 - 1), B.data, ENTRY * j * B.rows, ENTRY * B.rows)
	end
	return A
end

-- [A1 A2 ...]: the matrices side by side (equal row counts).
local function hstack(list: { Matrix }): Matrix
	assert(#list > 0, "hstack needs at least one matrix")
	local m, n = list[1].rows, 0
	for _, B in list do
		assert(B.rows == m, "hstack: row counts differ")
		n += B.cols
	end
	local o = matrix(m, n)
	local at = 0
	for _, B in list do
		buffer.copy(o.data, at, B.data)
		at += buffer.len(B.data)
	end
	return o
end

-- [A1; A2; ...]: the matrices stacked vertically (equal column counts).
local function vstack(list: { Matrix }): Matrix
	assert(#list > 0, "vstack needs at least one matrix")
	local m, n = 0, list[1].cols
	for _, B in list do
		assert(B.cols == n, "vstack: column counts differ")
		m += B.rows
	end
	local o = matrix(m, n)
	local row = 1
	for _, B in list do
		setsubmatrix(o, row, 1, B)
		row += B.rows
	end
	return o
end

