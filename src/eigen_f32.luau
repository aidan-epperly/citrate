	eigh_copy = eigh_copy,
	eigh_gen = eigh_gen,
	eigh_gen_copy = eigh_gen_copy,
	hess = hess,
	hess_copy = hess_copy,
	hess_h = hess_h,
	hess_q = hess_q,
	matnorm = matnorm,
	null_space = null_space,
	orth = orth,
	pinv = pinv,
	polar = polar,
	polar_copy = polar_copy,
	rank = rank,
	rcond = rcond,
	rpcholesky = rpcholesky,
