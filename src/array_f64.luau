-- The sum of the elements.
local function sum(x: buffer): number
	local s = 0
	do
		local k_start, k_stop = 0, buffer.len(x) - 8
		local k_split = k_start + (8) * (((k_stop - k_start) // (8) + 1) // 4 * 4)
		for k = k_start, k_split - 1, 4 * (8) do
			do
				s += buffer.readf64(x, k)
			end
			do
				s += buffer.readf64(x, (k + 8 * 1))
			end
			do
				s += buffer.readf64(x, (k + 8 * 2))
			end
			do
				s += buffer.readf64(x, (k + 8 * 3))
			end
		end
		for k = k_split, k_stop, 8 do
			s += buffer.readf64(x, k)
		end
	end
	return s
end

-- Largest absolute value (NaN if any element is NaN, 0 for an empty array).
local function amax(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - 8, 8 do
		local a = math.abs(buffer.readf64(x, k))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	return m
end

-- Euclidean norm of `count` consecutive reals starting at byte offset `start`. The plain
-- sum of squares is used unless it overflowed or may have lost digits to underflow; then
-- the values are rescaled by the largest magnitude. NaN if any value is NaN.
local function segment_norm(x: buffer, start: number, count: number): number
	local stop = start + 8 * (count - 1)
	local s = 0
	do
		local k_start, k_stop = start, stop
		local k_split = k_start + (8) * (((k_stop - k_start) // (8) + 1) // 4 * 4)
		for k = k_start, k_split - 1, 4 * (8) do
			do
				local v = buffer.readf64(x, k)
				s += v * v
			end
			do
				local v = buffer.readf64(x, (k + 8 * 1))
				s += v * v
			end
			do
				local v = buffer.readf64(x, (k + 8 * 2))
				s += v * v
			end
			do
				local v = buffer.readf64(x, (k + 8 * 3))
				s += v * v
			end
		end
		for k = k_split, k_stop, 8 do
			local v = buffer.readf64(x, k)
			s += v * v
		end
	end
	if s > 2 ^ -500 and s < math.huge then
		return math.sqrt(s)
	end
	local m = 0
	for k = start, stop, 8 do
		local a = math.abs(buffer.readf64(x, k))
		if a ~= a then
			return a
		elseif a > m then
			m = a
		end
	end
	if m == 0 or m == math.huge then
		return m
	end
	s = 0
	do
		local k_start, k_stop = start, stop
		local k_split = k_start + (8) * (((k_stop - k_start) // (8) + 1) // 4 * 4)
		for k = k_start, k_split - 1, 4 * (8) do
			do
				local v = buffer.readf64(x, k) / m
				s += v * v
			end
			do
				local v = buffer.readf64(x, (k + 8 * 1)) / m
				s += v * v
			end
			do
				local v = buffer.readf64(x, (k + 8 * 2)) / m
				s += v * v
			end
			do
				local v = buffer.readf64(x, (k + 8 * 3)) / m
				s += v * v
			end
		end
		for k = k_split, k_stop, 8 do
			local v = buffer.readf64(x, k) / m
			s += v * v
		end
	end
	return m * math.sqrt(s)
end

-- True if any of `count` consecutive reals starting at byte offset `start` is NaN or
-- infinite (v - v is NaN exactly for those).
local function any_nonfinite(x: buffer, start: number, count: number): boolean
	for k = start, start + 8 * (count - 1), 8 do
		local v = buffer.readf64(x, k)
		if v - v ~= 0 then
			return true
		end
	end
	return false
end

-- Sets `count` consecutive reals starting at byte offset `start` to NaN.
local function fill_nan(x: buffer, start: number, count: number)
	for k = start, start + 8 * (count - 1), 8 do
		buffer.writef64(x, k, 0 / 0)
	end
end

-- range_factor(m) is 1 if m is in [2^-459, 2^459] (LAPACK's smlnum and bignum for
-- doubles), and otherwise the power of 2 that brings m near 1. range_scale(x) scales x in
-- place by range_factor of its largest |value| and returns that factor. The eigen and SVD
-- drivers scale this way, as LAPACK's do, so their iterations neither underflow nor
-- overflow and their absolute thresholds (such as trevc's smlnum) stay negligible. Scaling
-- by a power of 2 is exact unless an entry lands in the subnormal range. Stored f32 values
-- are never outside the range.
local function range_factor(m: number): number
	if m == 0 or m == math.huge or m ~= m or (m >= 2 ^ -459 and m <= 2 ^ 459) then
		return 1
	end
	local _, e = math.frexp(m)
	return 2 ^ -e
end

local function range_scale(x: buffer): number
	local m = 0
	for k = 0, buffer.len(x) - 8, 8 do
		local a = math.abs(buffer.readf64(x, k))
		if a > m then
			m = a
		end
	end
	local f = range_factor(m)
	if f == 1 then
		return 1
	end
	for k = 0, buffer.len(x) - 8, 8 do
		buffer.writef64(x, k, buffer.readf64(x, k) * f)
	end
	return f
end

-- Euclidean norm, without overflow or underflow.
local function norm(x: buffer): number
	return segment_norm(x, 0, length(x))
end

local rdot = dot

-- The inner product x^H y as (re, im) and y + (ar + i ai) x, for code shared with the
-- complex modules (the imaginary parts are 0 here).
local function dotc_pair(x: buffer, y: buffer): (number, number)
	return dot(x, y), 0
end

local function caxpy_pair(out: buffer?, ar: number, _ai: number, x: buffer, y: buffer): buffer
	return axpy(out, ar, x, y)
end

-- The weighted RMS norm of an error estimate e, as ODE solvers use it:
-- sqrt(mean((e_i / (atol + rtol max(|y_i|, |ynew_i|)))^2)).
local function errnorm(e: buffer, y: buffer, ynew: buffer, atol: number, rtol: number): number
	local n = length(e)
	if n == 0 then
		return 0
	end
	local s = 0
	for i = 0, n - 1 do
		local sc = atol + rtol * math.max(math.abs(buffer.readf64(y, 8 * i)), math.abs(buffer.readf64(ynew, 8 * i)))
		local v = buffer.readf64(e, 8 * i) / sc
		s += v * v
	end
	return math.sqrt(s / n)
end

-- The complex extension of the space, for GMRES and BiCGSTAB: real data never produces a
-- nonzero imaginary coefficient, so one is rejected.
local function space_cdot(x: buffer, y: buffer): (number, number)
	return dot(x, y), 0
end

local function space_cscale(out: buffer, ar: number, ai: number, x: buffer): buffer
	assert(ai == 0, "complex coefficient on a real space")
	return scale(out, ar, x)
end

local function space_caxpy(out: buffer, ar: number, ai: number, x: buffer, y: buffer): buffer
	assert(ai == 0, "complex coefficient on a real space")
	return axpy(out, ar, x, y)
end

