			buffer.writef64(cv, c + 8 * 4, buffer.readf64(cv, c + 8 * 4) + (x1_0 * y0_1 + x1_1 * y1_1 + x1_2 * y2_1))
			buffer.writef64(cv, c + 8 * 5, buffer.readf64(cv, c + 8 * 5) + (x2_0 * y0_1 + x2_1 * y1_1 + x2_2 * y2_1))
			buffer.writef64(cv, c + 8 * 6, buffer.readf64(cv, c + 8 * 6) + (x0_0 * y0_2 + x0_1 * y1_2 + x0_2 * y2_2))
			buffer.writef64(cv, c + 8 * 7, buffer.readf64(cv, c + 8 * 7) + (x1_0 * y0_2 + x1_1 * y1_2 + x1_2 * y2_2))
			buffer.writef64(cv, c + 8 * 8, buffer.readf64(cv, c + 8 * 8) + (x2_0 * y0_2 + x2_1 * y1_2 + x2_2 * y2_2))
		end
	end

	spk.block[3] = { mv = mv3, mvt = mvt3, jacobi = pj3, product = bmm3 }

	local function mv4(o: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 4 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local s0, s1, s2, s3 = 0, 0, 0, 0
			for p = p0, p1 - 1 do
				local c = 8 * 4 * buffer.readu32(colind, 4 * p)
				local x0, x1, x2, x3 = buffer.readf64(x, c + 8 * 0), buffer.readf64(x, c + 8 * 1), buffer.readf64(x, c + 8 * 2), buffer.readf64(x, c + 8 * 3)
				local v = 8 * 16 * p
				s0 += buffer.readf64(vals, v + 8 * 0) * x0 + buffer.readf64(vals, v + 8 * 4) * x1 + buffer.readf64(vals, v + 8 * 8) * x2 + buffer.readf64(vals, v + 8 * 12) * x3
				s1 += buffer.readf64(vals, v + 8 * 1) * x0 + buffer.readf64(vals, v + 8 * 5) * x1 + buffer.readf64(vals, v + 8 * 9) * x2 + buffer.readf64(vals, v + 8 * 13) * x3
				s2 += buffer.readf64(vals, v + 8 * 2) * x0 + buffer.readf64(vals, v + 8 * 6) * x1 + buffer.readf64(vals, v + 8 * 10) * x2 + buffer.readf64(vals, v + 8 * 14) * x3
				s3 += buffer.readf64(vals, v + 8 * 3) * x0 + buffer.readf64(vals, v + 8 * 7) * x1 + buffer.readf64(vals, v + 8 * 11) * x2 + buffer.readf64(vals, v + 8 * 15) * x3
			end
			local w = 8 * 4 * I
			buffer.writef64(o, w + 8 * 0, s0)
			buffer.writef64(o, w + 8 * 1, s1)
			buffer.writef64(o, w + 8 * 2, s2)
			buffer.writef64(o, w + 8 * 3, s3)
			p0 = p1
		end
	end

	local function mvt4(acc: buffer, B: BlockSparse, x: buffer)
		local rowptr, colind, vals = B.rowptr, B.colind, B.values
		local p0 = buffer.readu32(rowptr, 0)
		for I = 0, B.rows // 4 - 1 do
			local p1 = buffer.readu32(rowptr, 4 * I + 4)
			local xb = 8 * 4 * I
			local x0, x1, x2, x3 = buffer.readf64(x, xb + 8 * 0), buffer.readf64(x, xb + 8 * 1), buffer.readf64(x, xb + 8 * 2), buffer.readf64(x, xb + 8 * 3)
			for p = p0, p1 - 1 do
				local c = 32 * buffer.readu32(colind, 4 * p)
				local v = 8 * 16 * p
				buffer.writef64(acc, c, buffer.readf64(acc, c) + (buffer.readf64(vals, v + 8 * 0) * x0 + buffer.readf64(vals, v + 8 * 1) * x1 + buffer.readf64(vals, v + 8 * 2) * x2 + buffer.readf64(vals, v + 8 * 3) * x3))
				buffer.writef64(acc, c + 8, buffer.readf64(acc, c + 8) + (buffer.readf64(vals, v + 8 * 4) * x0 + buffer.readf64(vals, v + 8 * 5) * x1 + buffer.readf64(vals, v + 8 * 6) * x2 + buffer.readf64(vals, v + 8 * 7) * x3))
				buffer.writef64(acc, c + 16, buffer.readf64(acc, c + 16) + (buffer.readf64(vals, v + 8 * 8) * x0 + buffer.readf64(vals, v + 8 * 9) * x1 + buffer.readf64(vals, v + 8 * 10) * x2 + buffer.readf64(vals, v + 8 * 11) * x3))
				buffer.writef64(acc, c + 24, buffer.readf64(acc, c + 24) + (buffer.readf64(vals, v + 8 * 12) * x0 + buffer.readf64(vals, v + 8 * 13) * x1 + buffer.readf64(vals, v + 8 * 14) * x2 + buffer.readf64(vals, v + 8 * 15) * x3))
			end
			p0 = p1
		end
	end

	local function pj4(o: buffer, inv: buffer, r: buffer, nb: number)
		for I = 0, nb - 1 do
			local base, v = 8 * 4 * I, 128 * I
			local t0, t1, t2, t3 = buffer.readf64(r, base + 8 * 0), buffer.readf64(r, base + 8 * 1), buffer.readf64(r, base + 8 * 2), buffer.readf64(r, base + 8 * 3)
			buffer.writef64(o, base + 8 * 0, buffer.readf64(inv, v + 0) * t0 + buffer.readf64(inv, v + 32) * t1 + buffer.readf64(inv, v + 64) * t2 + buffer.readf64(inv, v + 96) * t3)
			buffer.writef64(o, base + 8 * 1, buffer.readf64(inv, v + 8) * t0 + buffer.readf64(inv, v + 40) * t1 + buffer.readf64(inv, v + 72) * t2 + buffer.readf64(inv, v + 104) * t3)
			buffer.writef64(o, base + 8 * 2, buffer.readf64(inv, v + 16) * t0 + buffer.readf64(inv, v + 48) * t1 + buffer.readf64(inv, v + 80) * t2 + buffer.readf64(inv, v + 112) * t3)
			buffer.writef64(o, base + 8 * 3, buffer.readf64(inv, v + 24) * t0 + buffer.readf64(inv, v + 56) * t1 + buffer.readf64(inv, v + 88) * t2 + buffer.readf64(inv, v + 120) * t3)
		end
	end

	local function bmm4(cv: buffer, xv: buffer, yv: buffer, plan: buffer, count: number)
		for t = 0, count - 1 do
			local c = 8 * 16 * buffer.readu32(plan, 12 * t)
			local x = 8 * 16 * buffer.readu32(plan, 12 * t + 4)
			local y = 8 * 16 * buffer.readu32(plan, 12 * t + 8)
			local x0_0, x1_0, x2_0, x3_0, x0_1, x1_1, x2_1, x3_1, x0_2, x1_2, x2_2, x3_2, x0_3, x1_3, x2_3, x3_3 = buffer.readf64(xv, x + 8 * 0), buffer.readf64(xv, x + 8 * 1), buffer.readf64(xv, x + 8 * 2), buffer.readf64(xv, x + 8 * 3), buffer.readf64(xv, x + 8 * 4), buffer.readf64(xv, x + 8 * 5), buffer.readf64(xv, x + 8 * 6), buffer.readf64(xv, x + 8 * 7), buffer.readf64(xv, x + 8 * 8), buffer.readf64(xv, x + 8 * 9), buffer.readf64(xv, x + 8 * 10), buffer.readf64(xv, x + 8 * 11), buffer.readf64(xv, x + 8 * 12), buffer.readf64(xv, x + 8 * 13), buffer.readf64(xv, x + 8 * 14), buffer.readf64(xv, x + 8 * 15)
			local y0_0, y1_0, y2_0, y3_0, y0_1, y1_1, y2_1, y3_1, y0_2, y1_2, y2_2, y3_2, y0_3, y1_3, y2_3, y3_3 = buffer.readf64(yv, y + 8 * 0), buffer.readf64(yv, y + 8 * 1), buffer.readf64(yv, y + 8 * 2), buffer.readf64(yv, y + 8 * 3), buffer.readf64(yv, y + 8 * 4), buffer.readf64(yv, y + 8 * 5), buffer.readf64(yv, y + 8 * 6), buffer.readf64(yv, y + 8 * 7), buffer.readf64(yv, y + 8 * 8), buffer.readf64(yv, y + 8 * 9), buffer.readf64(yv, y + 8 * 10), buffer.readf64(yv, y + 8 * 11), buffer.readf64(yv, y + 8 * 12), buffer.readf64(yv, y + 8 * 13), buffer.readf64(yv, y + 8 * 14), buffer.readf64(yv, y + 8 * 15)
			buffer.writef64(cv, c + 8 * 0, buffer.readf64(cv, c + 8 * 0) + (x0_0 * y0_0 + x0_1 * y1_0 + x0_2 * y2_0 + x0_3 * y3_0))
			buffer.writef64(cv, c + 8 * 1, buffer.readf64(cv, c + 8 * 1) + (x1_0 * y0_0 + x1_1 * y1_0 + x1_2 * y2_0 + x1_3 * y3_0))
			buffer.writef64(cv, c + 8 * 2, buffer.readf64(cv, c + 8 * 2) + (x2_0 * y0_0 + x2_1 * y1_0 + x2_2 * y2_0 + x2_3 * y3_0))
			buffer.writef64(cv, c + 8 * 3, buffer.readf64(cv, c + 8 * 3) + (x3_0 * y0_0 + x3_1 * y1_0 + x3_2 * y2_0 + x3_3 * y3_0))
			buffer.writef64(cv, c + 8 * 4, buffer.readf64(cv, c + 8 * 4) + (x0_0 * y0_1 + x0_1 * y1_1 + x0_2 * y2_1 + x0_3 * y3_1))
			buffer.writef64(cv, c + 8 * 5, buffer.readf64(cv, c + 8 * 5) + (x1_0 * y0_1 + x1_1 * y1_1 + x1_2 * y2_1 + x1_3 * y3_1))
			buffer.writef64(cv, c + 8 * 6, buffer.readf64(cv, c + 8 * 6) + (x2_0 * y0_1 + x2_1 * y1_1 + x2_2 * y2_1 + x2_3 * y3_1))
			buffer.writef64(cv, c + 8 * 7, buffer.readf64(cv, c + 8 * 7) + (x3_0 * y0_1 + x3_1 * y1_1 + x3_2 * y2_1 + x3_3 * y3_1))
			buffer.writef64(cv, c + 8 * 8, buffer.readf64(cv, c + 8 * 8) + (x0_0 * y0_2 + x0_1 * y1_2 + x0_2 * y2_2 + x0_3 * y3_2))
			buffer.writef64(cv, c + 8 * 9, buffer.readf64(cv, c + 8 * 9) + (x1_0 * y0_2 + x1_1 * y1_2 + x1_2 * y2_2 + x1_3 * y3_2))
			buffer.writef64(cv, c + 8 * 10, buffer.readf64(cv, c + 8 * 10) + (x2_0 * y0_2 + x2_1 * y1_2 + x2_2 * y2_2 + x2_3 * y3_2))
			buffer.writef64(cv, c + 8 * 11, buffer.readf64(cv, c + 8 * 11) + (x3_0 * y0_2 + x3_1 * y1_2 + x3_2 * y2_2 + x3_3 * y3_2))
			buffer.writef64(cv, c + 8 * 12, buffer.readf64(cv, c + 8 * 12) + (x0_0 * y0_3 + x0_1 * y1_3 + x0_2 * y2_3 + x0_3 * y3_3))
			buffer.writef64(cv, c + 8 * 13, buffer.readf64(cv, c + 8 * 13) + (x1_0 * y0_3 + x1_1 * y1_3 + x1_2 * y2_3 + x1_3 * y3_3))
			buffer.writef64(cv, c + 8 * 14, buffer.readf64(cv, c + 8 * 14) + (x2_0 * y0_3 + x2_1 * y1_3 + x2_2 * y2_3 + x2_3 * y3_3))
			buffer.writef64(cv, c + 8 * 15, buffer.readf64(cv, c + 8 * 15) + (x3_0 * y0_3 + x3_1 * y1_3 + x3_2 * y2_3 + x3_3 * y3_3))
		end
	end

	spk.block[4] = { mv = mv4, mvt = mvt4, jacobi = pj4, product = bmm4 }
end

-- S x, accumulated in double precision. A general S is applied column by column (a
-- scatter into a double accumulator); one marked symmetric as S^T x, a gather down its
-- columns, about 10% faster still since each sum stays in a local.
local function sparse_matvec(out: buffer?, S: Sparse, x: buffer): buffer
	assert(length(x) == S.cols, "matrix and vector sizes do not match")
	local o = output(out, 8 * S.rows)
	assert(o ~= x, "output cannot be the input vector")
	if S.symmetric or S.hermitian then
		spk.gather(o, S, x)
		return o
	end
	local acc = if 8 == 8 then o else buffer.create(8 * S.rows)
	buffer.fill(acc, 0, 0)
	spk.scatter(acc, S, x)
	if acc ~= o then
		for i = 0, S.rows - 1 do
			buffer.writef64(o, 8 * i, buffer.readf64(acc, 8 * i))
		end
	end
	return o
end

-- S^T x.
local function sparse_matvec_adjoint(out: buffer?, S: Sparse, x: buffer): buffer
	assert(length(x) == S.rows, "matrix and vector sizes do not match")
	local o = output(out, 8 * S.cols)
	assert(o ~= x, "output cannot be the input vector")
	spk.gather(o, S, x)
	return o
end

-- S B for a dense matrix B, as a dense matrix.
local function sparse_matmul(out: Matrix?, S: Sparse, B: Matrix): Matrix
	assert(B.rows == S.cols, "matrix sizes do not match")
	local o = matoutput(out, S.rows, B.cols)
	assert(o.data ~= B.data, "output cannot be an input")
	local col, res = create(S.cols), create(S.rows)
	for j = 0, B.cols - 1 do
		buffer.copy(col, 0, B.data, 8 * j * S.cols, 8 * S.cols)
		sparse_matvec(res, S, col)
		buffer.copy(o.data, 8 * j * S.rows, res, 0, 8 * S.rows)
	end
	return o
end

-- S^T.
local function sparse_transpose(S: Sparse): Sparse
	local colrows, colvals = empty_columns(S.rows)
	for j = 0, S.cols - 1 do
		for p = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local r = buffer.readu32(S.rowind, 4 * p) + 1
			table.insert(colrows[r], j)
			table.insert(colvals[r], buffer.readf64(S.values, 8 * p))
		end
	end
	local T = assemble(S.cols, S.rows, colrows, colvals)
	T.symmetric, T.hermitian = S.symmetric, S.hermitian
	return T
end

-- Symmetric permutations of sparse matrices (values copied as bytes: `bytes` per entry).

-- The positions of a permutation: inv[perm[k]] = k (0-based positions, as a table).
local function perm_positions(perm: buffer, n: number): { number }
	assert(buffer.len(perm) == 4 * n, "the permutation must have one entry per row")
	local inv = table.create(n, -1)
	for k = 0, n - 1 do
		local v = buffer.readi32(perm, 4 * k)
		assert(v >= 1 and v <= n and inv[v] == -1, "not a permutation")
		inv[v] = k
	end
	return inv
end

local function permute_sparse(S: Sparse, perm: buffer, bytes: number): Sparse
	local n = S.rows
	assert(S.cols == n, "matrix must be square")
	local inv = perm_positions(perm, n)
	local nnz = buffer.readu32(S.colptr, 4 * n)
	local colptr = buffer.create(4 * (n + 1))
	local rowind = buffer.create(4 * nnz)
	local values = buffer.create(bytes * nnz)
	local rows, srcs = {}, {}
	local p = 0
	for l = 0, n - 1 do
		buffer.writeu32(colptr, 4 * l, p)
		-- column l of P A P^T is column perm[l] of A, rows renumbered, then sorted
		local j = buffer.readi32(perm, 4 * l) - 1
		local count = 0
		for q = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local r = inv[buffer.readu32(S.rowind, 4 * q) + 1]
			-- insertion sort: columns are short
			local k = count
			while k > 0 and rows[k] > r do
				rows[k + 1], srcs[k + 1] = rows[k], srcs[k]
				k -= 1
			end
			rows[k + 1], srcs[k + 1] = r, q
			count += 1
		end
		for k = 1, count do
			buffer.writeu32(rowind, 4 * p, rows[k])
			buffer.copy(values, bytes * p, S.values, bytes * srcs[k], bytes)
			p += 1
		end
	end
	buffer.writeu32(colptr, 4 * n, p)
	return { rows = n, cols = n, colptr = colptr, rowind = rowind, values = values, symmetric = S.symmetric, hermitian = S.hermitian }
end

local function symband_sparse(S: Sparse, perm: buffer?, into: SymBanded?, bytes: number): SymBanded
	local n = S.rows
	assert(S.cols == n, "matrix must be square")
	local inv: { number }? = if perm then perm_positions(perm, n) else nil
	-- the half bandwidth under perm
	local kd = 0
	for j = 0, n - 1 do
		local pj = if inv then inv[j + 1] else j
		for q = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local r = buffer.readu32(S.rowind, 4 * q)
			local pr = if inv then inv[r + 1] else r
			if pr - pj > kd then
				kd = pr - pj
			end
		end
	end
	local B: SymBanded
	if into and into.n == n and into.kd == kd then
		B = into
		buffer.fill(B.data, 0, 0)
	else
		B = { n = n, kd = kd, data = buffer.create(bytes * (kd + 1) * n) }
	end
	local d = B.data
	for j = 0, n - 1 do
		local pj = if inv then inv[j + 1] else j
		for q = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local r = buffer.readu32(S.rowind, 4 * q)
			local pr = if inv then inv[r + 1] else r
			if pr >= pj then
				buffer.copy(d, bytes * (pj * kd + pr), S.values, bytes * q, bytes)
			end
		end
	end
	return B
end

-- Sparse Cholesky factorization

-- The ordering of a sparse Cholesky factorization: "amd" (approximate minimum degree, the
-- default), "rcm" (reverse Cuthill-McKee), "natural", or a permutation.
local function chol_order(S: Sparse, order: (string | buffer)?): buffer
	if type(order) == "buffer" then
		assert(buffer.len(order) == 4 * S.cols, "sparse_chol: the order must have one entry per column")
		return order
	end
	local G = graph.of(S)
	if order == nil or order == "amd" then
		return graph.amd(G)
	elseif order == "rcm" then
		return graph.rcm(G)
	end
	assert(order == "natural", "sparse_chol: order must be \"amd\", \"rcm\", \"natural\" or a permutation")
	local p = buffer.create(4 * S.cols)
	for k = 0, S.cols - 1 do
		buffer.writei32(p, 4 * k, k + 1)
	end
	return p
end

-- The numeric factorization into L's values (laid out by the symbolic factorization sym):
-- supernode by supernode, left-looking. Each supernode first receives its columns of A,
-- then the updates of the earlier supernodes whose rows meet its columns (found through
-- linked lists: a supernode waits in the list of the supernode holding its next row), each
-- update a set of dot products of rows of a dense block; then its diagonal block is
-- factored and the rows below it solved, all within the block. Returns false if a pivot
-- was not positive (the matrix is not positive definite).
local function chol_numeric(sym: any, A: Sparse, L: buffer, work: any): boolean
	local ns = sym.nsuper
	local super, rowptr, rows, valptr, col2super, amap = sym.super, sym.rowptr, sym.rows, sym.valptr, sym.col2super, sym.amap
	buffer.fill(L, 0, 0)
	local Av = A.values
	for p = 0, buffer.readu32(A.colptr, 4 * A.cols) - 1 do
		local dst = buffer.readu32(amap, 4 * p)
		if dst ~= 0 then
			local o = 8 * (dst - 1)
			buffer.writef64(L, o, buffer.readf64(L, o) + buffer.readf64(Av, 8 * p))
		end
	end
	local rel, head, link, dpos = work.rel, work.head, work.link, work.dpos
	buffer.fill(head, 0, 255) -- -1: empty lists
	for s = 0, ns - 1 do
		local c0: number = buffer.readu32(super, 4 * s)
		local K: number = buffer.readu32(super, 4 * (s + 1)) - c0
		local c1 = c0 + K
		local r0: number = buffer.readu32(rowptr, 4 * s)
		local R: number = buffer.readu32(rowptr, 4 * (s + 1)) - r0
		local base: number = buffer.readu32(valptr, 4 * s)
		for r = 0, R - 1 do
			buffer.writeu32(rel, 4 * buffer.readu32(rows, 4 * (r0 + r)), r)
		end
		-- the updates of earlier supernodes
		local d = buffer.readi32(head, 4 * s)
		buffer.writei32(head, 4 * s, -1)
		while d >= 0 do
			local dnext = buffer.readi32(link, 4 * d)
			local Kd: number = buffer.readu32(super, 4 * (d + 1)) - buffer.readu32(super, 4 * d)
			local dr0: number = buffer.readu32(rowptr, 4 * d)
			local dr1: number = buffer.readu32(rowptr, 4 * (d + 1))
			local dbase: number = buffer.readu32(valptr, 4 * d)
			local q: number = buffer.readu32(dpos, 4 * d)
			local q2 = q
			while q2 < dr1 and buffer.readu32(rows, 4 * q2) < c1 do
				q2 += 1
			end
			-- C = L_d[rows from jj] L_d[rows jj .. q2 - 1]^T, lower part, subtracted into the
			-- block: two columns of C at a time against four rows, so each value read
			-- feeds two or four multiply-adds
			local stride = 8 * Kd
			local last = stride - 8
			local jj = q
			while jj < q2 do
				local colA = buffer.readu32(rows, 4 * jj) - c0
				local ojA = 8 * (dbase + (jj - dr0) * Kd)
				local pair = jj + 1 < q2
				local colB = if pair then buffer.readu32(rows, 4 * (jj + 1)) - c0 else 0
				local ojB = ojA + stride
				-- row jj: column A only (above the diagonal in column B)
				local sum = 0
				for t = 0, last, 8 do
					local x = buffer.readf64(L, ojA + t)
					sum += x * x
				end
				local target = 8 * (base + buffer.readu32(rel, 4 * buffer.readu32(rows, 4 * jj)) * K + colA)
				buffer.writef64(L, target, buffer.readf64(L, target) - sum)
				local ii = jj + 1
				if pair then
					local oi = ojB
					while ii + 3 < dr1 do
						local a1, a2, a3, a4, b1, b2, b3, b4 = 0, 0, 0, 0, 0, 0, 0, 0
						for t = 0, last, 8 do
							local xa, xb = buffer.readf64(L, ojA + t), buffer.readf64(L, ojB + t)
							local y1 = buffer.readf64(L, oi + t)
							local y2 = buffer.readf64(L, oi + stride + t)
							local y3 = buffer.readf64(L, oi + 2 * stride + t)
							local y4 = buffer.readf64(L, oi + 3 * stride + t)
							a1 += y1 * xa
							a2 += y2 * xa
							a3 += y3 * xa
							a4 += y4 * xa
							b1 += y1 * xb
							b2 += y2 * xb
							b3 += y3 * xb
							b4 += y4 * xb
						end
						local rb = base + buffer.readu32(rel, 4 * buffer.readu32(rows, 4 * ii)) * K
						buffer.writef64(L, 8 * (rb + colA), buffer.readf64(L, 8 * (rb + colA)) - a1)
						buffer.writef64(L, 8 * (rb + colB), buffer.readf64(L, 8 * (rb + colB)) - b1)
						rb = base + buffer.readu32(rel, 4 * buffer.readu32(rows, 4 * (ii + 1))) * K
						buffer.writef64(L, 8 * (rb + colA), buffer.readf64(L, 8 * (rb + colA)) - a2)
						buffer.writef64(L, 8 * (rb + colB), buffer.readf64(L, 8 * (rb + colB)) - b2)
						rb = base + buffer.readu32(rel, 4 * buffer.readu32(rows, 4 * (ii + 2))) * K
						buffer.writef64(L, 8 * (rb + colA), buffer.readf64(L, 8 * (rb + colA)) - a3)
						buffer.writef64(L, 8 * (rb + colB), buffer.readf64(L, 8 * (rb + colB)) - b3)
						rb = base + buffer.readu32(rel, 4 * buffer.readu32(rows, 4 * (ii + 3))) * K
						buffer.writef64(L, 8 * (rb + colA), buffer.readf64(L, 8 * (rb + colA)) - a4)
						buffer.writef64(L, 8 * (rb + colB), buffer.readf64(L, 8 * (rb + colB)) - b4)
						ii += 4
						oi += 4 * stride
					end
					while ii < dr1 do
						local a, b = 0, 0
						for t = 0, last, 8 do
							local y = buffer.readf64(L, oi + t)
							a += y * buffer.readf64(L, ojA + t)
							b += y * buffer.readf64(L, ojB + t)
						end
						local rb = base + buffer.readu32(rel, 4 * buffer.readu32(rows, 4 * ii)) * K
						buffer.writef64(L, 8 * (rb + colA), buffer.readf64(L, 8 * (rb + colA)) - a)
						buffer.writef64(L, 8 * (rb + colB), buffer.readf64(L, 8 * (rb + colB)) - b)
						ii += 1
						oi += stride
					end
					jj += 2
				else
					local oi = ojA + stride
					while ii < dr1 do
						local a = 0
						for t = 0, last, 8 do
							a += buffer.readf64(L, oi + t) * buffer.readf64(L, ojA + t)
						end
						local rb = base + buffer.readu32(rel, 4 * buffer.readu32(rows, 4 * ii)) * K
						buffer.writef64(L, 8 * (rb + colA), buffer.readf64(L, 8 * (rb + colA)) - a)
						ii += 1
						oi += stride
					end
					jj += 1
				end
			end
			buffer.writeu32(dpos, 4 * d, q2)
			if q2 < dr1 then
				local s2 = buffer.readu32(col2super, 4 * buffer.readu32(rows, 4 * q2))
				buffer.writei32(link, 4 * d, buffer.readi32(head, 4 * s2))
				buffer.writei32(head, 4 * s2, d)
			end
			d = dnext
		end
		-- the dense block: Cholesky of its diagonal block (row by row), then the rows below
		-- solved against it, four at a time (each read of the diagonal block feeding four)
		for r = 0, K - 1 do
			local orow = 8 * (base + r * K)
			for t = 0, r do
				local ot = 8 * (base + t * K)
				local sum = buffer.readf64(L, orow + 8 * t)
				for u = 0, 8 * (t - 1), 8 do
					sum -= buffer.readf64(L, orow + u) * buffer.readf64(L, ot + u)
				end
				if t == r then
					if not (sum > 0) then
						return false
					end
					buffer.writef64(L, orow + 8 * t, math.sqrt(sum))
				else
					buffer.writef64(L, orow + 8 * t, sum / buffer.readf64(L, ot + 8 * t))
				end
			end
		end
		local stride = 8 * K
		local r = K
		while r + 3 < R do
			local o1 = 8 * (base + r * K)
			local o2, o3, o4 = o1 + stride, o1 + 2 * stride, o1 + 3 * stride
			for t = 0, K - 1 do
				local ot = 8 * (base + t * K)
				local at = 8 * t
				local a1, a2, a3, a4 = buffer.readf64(L, o1 + at), buffer.readf64(L, o2 + at), buffer.readf64(L, o3 + at), buffer.readf64(L, o4 + at)
				for u = 0, at - 8, 8 do
					local x = buffer.readf64(L, ot + u)
					a1 -= buffer.readf64(L, o1 + u) * x
					a2 -= buffer.readf64(L, o2 + u) * x
					a3 -= buffer.readf64(L, o3 + u) * x
					a4 -= buffer.readf64(L, o4 + u) * x
				end
				local dt = buffer.readf64(L, ot + at)
				buffer.writef64(L, o1 + at, a1 / dt)
				buffer.writef64(L, o2 + at, a2 / dt)
				buffer.writef64(L, o3 + at, a3 / dt)
				buffer.writef64(L, o4 + at, a4 / dt)
			end
			r += 4
		end
		while r < R do
			local orow = 8 * (base + r * K)
			for t = 0, K - 1 do
				local ot = 8 * (base + t * K)
				local sum = buffer.readf64(L, orow + 8 * t)
				for u = 0, 8 * (t - 1), 8 do
					sum -= buffer.readf64(L, orow + u) * buffer.readf64(L, ot + u)
				end
				buffer.writef64(L, orow + 8 * t, sum / buffer.readf64(L, ot + 8 * t))
			end
			r += 1
		end
		if R > K then
			buffer.writeu32(dpos, 4 * s, r0 + K)
			local s2 = buffer.readu32(col2super, 4 * buffer.readu32(rows, 4 * (r0 + K)))
			buffer.writei32(link, 4 * s, buffer.readi32(head, 4 * s2))
			buffer.writei32(head, 4 * s2, s)
		end
	end
	return true
end

-- Sparse Cholesky factorization P S P^T = L L^T of a symmetric positive definite sparse
-- matrix (both triangles stored, as Sparse matrices are; the lower one is read after
-- ordering). options.order chooses P: "amd" (approximate minimum degree: the least fill,
-- the default), "rcm", "natural" or a permutation (as graph.rcm returns). L is stored by
-- supernodes, dense blocks of columns with the same rows (graph.chol_analysis;
-- options.relax = false keeps only exact ones). options.reuse, an earlier factorization of
-- a matrix with the same pattern (the same colptr and rowind buffers), keeps its ordering,
-- analysis and storage: only the values are recomputed, with nothing allocated. F.definite
-- is false if a pivot was not positive (the factorization stops there); F.nnz is the
-- number of entries stored and F.madds the multiply-adds of a factorization.
local function sparse_chol(S: Sparse, options: types.SparseCholOptions?): types.SparseCholesky
	local o: types.SparseCholOptions = options or {}
	assert(S.rows == S.cols, "sparse_chol: matrix must be square")
	local F = o.reuse :: any
	if F == nil or F.symbolic.ptr ~= S.colptr or F.symbolic.ind ~= S.rowind then
		local sym = graph.chol_analysis(graph.of(S), chol_order(S, o.order), { relax = o.relax })
		local n = S.rows
		F = {
			n = n,
			symbolic = sym,
			perm = sym.perm,
			values = buffer.create(8 * sym.nnz),
			definite = false,
			nnz = sym.nnz,
			madds = sym.madds,
			work = {
				rel = buffer.create(4 * n),
				head = buffer.create(4 * sym.nsuper),
				link = buffer.create(4 * sym.nsuper),
				dpos = buffer.create(4 * sym.nsuper),
				x = buffer.create(8 * n),
			},
		}
	end
	F.definite = chol_numeric(F.symbolic, S, F.values, F.work)
	return F
end

-- The solution of S x = b from sparse_chol's factorization (out may be b).
local function sparse_chol_solve(out: buffer?, F: types.SparseCholesky, b: buffer): buffer
	local Fa = F :: any
	local sym = Fa.symbolic
	local n = Fa.n
	local o = output(out, 8 * n)
	local x = Fa.work.x
	local perm, super, rowptr, rows, valptr = sym.perm, sym.super, sym.rowptr, sym.rows, sym.valptr
	local L = Fa.values
	for k = 0, n - 1 do
		buffer.writef64(x, 8 * k, buffer.readf64(b, 8 * (buffer.readi32(perm, 4 * k) - 1)))
	end
	local ns = sym.nsuper
	-- L y = P b
	for s = 0, ns - 1 do
		local c0: number = buffer.readu32(super, 4 * s)
		local K: number = buffer.readu32(super, 4 * (s + 1)) - c0
		local r0: number = buffer.readu32(rowptr, 4 * s)
		local R: number = buffer.readu32(rowptr, 4 * (s + 1)) - r0
		local base: number = buffer.readu32(valptr, 4 * s)
		for t = 0, K - 1 do
			local ot = 8 * (base + t * K)
			local sum = buffer.readf64(x, 8 * (c0 + t))
			for u = 0, t - 1 do
				sum -= buffer.readf64(L, ot + 8 * u) * buffer.readf64(x, 8 * (c0 + u))
			end
			buffer.writef64(x, 8 * (c0 + t), sum / buffer.readf64(L, ot + 8 * t))
		end
		for r = K, R - 1 do
			local orow = 8 * (base + r * K)
			local sum = 0
			for t = 0, K - 1 do
				sum += buffer.readf64(L, orow + 8 * t) * buffer.readf64(x, 8 * (c0 + t))
			end
			local row = 8 * buffer.readu32(rows, 4 * (r0 + r))
			buffer.writef64(x, row, buffer.readf64(x, row) - sum)
		end
	end
	-- L^T z = y
	for s = ns - 1, 0, -1 do
		local c0: number = buffer.readu32(super, 4 * s)
		local K: number = buffer.readu32(super, 4 * (s + 1)) - c0
		local r0: number = buffer.readu32(rowptr, 4 * s)
		local R: number = buffer.readu32(rowptr, 4 * (s + 1)) - r0
		local base: number = buffer.readu32(valptr, 4 * s)
		for r = K, R - 1 do
			local xr = buffer.readf64(x, 8 * buffer.readu32(rows, 4 * (r0 + r)))
			if xr ~= 0 then
				local orow = 8 * (base + r * K)
				for t = 0, K - 1 do
					local at = 8 * (c0 + t)
					buffer.writef64(x, at, buffer.readf64(x, at) - buffer.readf64(L, orow + 8 * t) * xr)
				end
			end
		end
		for t = K - 1, 0, -1 do
			local sum = buffer.readf64(x, 8 * (c0 + t))
			for u = t + 1, K - 1 do
				sum -= buffer.readf64(L, 8 * (base + u * K + t)) * buffer.readf64(x, 8 * (c0 + u))
			end
			buffer.writef64(x, 8 * (c0 + t), sum / buffer.readf64(L, 8 * (base + t * K + t)))
		end
	end
	for k = 0, n - 1 do
		buffer.writef64(o, 8 * (buffer.readi32(perm, 4 * k) - 1), buffer.readf64(x, 8 * k))
	end
	return o
end

-- P S P^T for the permutation perm (a buffer of 32-bit integers, as graph.rcm returns):
-- entry (k, l) is S's entry (perm[k], perm[l]).
local function sparse_permute(S: Sparse, perm: buffer): Sparse
	return permute_sparse(S, perm, 8)
end

-- The band of the symmetric matrix P S P^T (perm as for sparse_permute; default the
-- identity) in symmetric band storage, for band_chol: kd is the permuted pattern's half
-- bandwidth, and the lower triangle is read. into is reused when it has that shape.
local function sparse_symband(S: Sparse, perm: buffer?, into: SymBanded?): SymBanded
	return symband_sparse(S, perm, into, 8)
end

-- A + B.
local function sparse_add(A: Sparse, B: Sparse): Sparse
	assert(A.rows == B.rows and A.cols == B.cols, "matrix sizes do not match")
	local colrows, colvals = empty_columns(A.cols)
	for j = 0, A.cols - 1 do
		local p, pe = buffer.readu32(A.colptr, 4 * j), buffer.readu32(A.colptr, 4 * (j + 1))
		local q, qe = buffer.readu32(B.colptr, 4 * j), buffer.readu32(B.colptr, 4 * (j + 1))
		local rs, vs = colrows[j + 1], colvals[j + 1]
		while p < pe or q < qe do
			local ra = if p < pe then buffer.readu32(A.rowind, 4 * p) else math.huge
			local rb = if q < qe then buffer.readu32(B.rowind, 4 * q) else math.huge
			if ra == rb then
				table.insert(rs, ra)
				table.insert(vs, buffer.readf64(A.values, 8 * p) + buffer.readf64(B.values, 8 * q))
				p += 1
				q += 1
			elseif ra < rb then
				table.insert(rs, ra)
				table.insert(vs, buffer.readf64(A.values, 8 * p))
				p += 1
			else
				table.insert(rs, rb)
				table.insert(vs, buffer.readf64(B.values, 8 * q))
				q += 1
			end
		end
	end
	local C = assemble(A.rows, A.cols, colrows, colvals)
	C.symmetric, C.hermitian = A.symmetric and B.symmetric, A.hermitian and B.hermitian
	return C
end

-- The Jacobi (diagonal) preconditioner of a square S, for the iterative solvers:
-- out := r ./ diag(S). Every diagonal entry must be nonzero.
local function sparse_jacobi(S: Sparse): (out: buffer, r: buffer) -> buffer
	assert(S.rows == S.cols, "matrix must be square")
	local d = sparse_diag(S)
	-- The inverses in double precision, in a buffer (table reads cost several buffer
	-- reads in the loop below).
	local inv = buffer.create(8 * S.rows)
	for i = 0, S.rows - 1 do
		local v = buffer.readf64(d, 8 * i)
		assert(v ~= 0, "a diagonal entry is zero")
		buffer.writef64(inv, 8 * i, 1 / v)
	end
	local stop = 8 * (S.rows - 1)
	return function(out: buffer, r: buffer): buffer
		do
			local k_start, k_stop = 0, stop
			local k_split = k_start + (8) * (((k_stop - k_start) // (8) + 1) // 4 * 4)
			for k = k_start, k_split - 1, 4 * (8) do
				do
					buffer.writef64(out, k, buffer.readf64(r, k) * buffer.readf64(inv, (8 // 8) * k))
				end
				do
					buffer.writef64(out, (k + 8 * 1), buffer.readf64(r, (k + 8 * 1)) * buffer.readf64(inv, (8 // 8) * (k + 8 * 1)))
				end
				do
					buffer.writef64(out, (k + 8 * 2), buffer.readf64(r, (k + 8 * 2)) * buffer.readf64(inv, (8 // 8) * (k + 8 * 2)))
				end
				do
					buffer.writef64(out, (k + 8 * 3), buffer.readf64(r, (k + 8 * 3)) * buffer.readf64(inv, (8 // 8) * (k + 8 * 3)))
				end
			end
			for k = k_split, k_stop, 8 do
				buffer.writef64(out, k, buffer.readf64(r, k) * buffer.readf64(inv, (8 // 8) * k))
			end
		end
		return out
	end
end

-- For real matrices the adjoint is the transpose.
local sparse_adjoint = sparse_transpose

-- Preconditioners for the iterative solvers

-- The SSOR preconditioner of a square S with relaxation omega (0 < omega < 2; the default
-- 1 is symmetric Gauss-Seidel): M = (D + w L) D^-1 (D + w U) / (w (2 - w)), with D, L, U
-- the diagonal and strictly lower and upper parts. Returns out := M^-1 r. If S is
-- symmetric positive definite, so is M (usable with CG). Every diagonal entry must be
-- nonzero.
local function sparse_ssor(S: Sparse, omega: number?): (out: buffer, r: buffer) -> buffer
	local w = omega or 1
	assert(w > 0 and w < 2, "omega must be between 0 and 2")
	assert(S.rows == S.cols, "matrix must be square")
	local n = S.rows
	local d = totable(sparse_diag(S))
	for i = 1, n do
		assert(d[i] ~= 0, "a diagonal entry is zero")
	end
	local colptr, rowind, vals = S.colptr, S.rowind, S.values
	local y = table.create(n, 0)
	local factor = w * (2 - w)
	return function(out: buffer, r: buffer): buffer
		for i = 1, n do
			y[i] = buffer.readf64(r, 8 * (i - 1))
		end
		-- (D + w L) y = r, column by column.
		for j = 0, n - 1 do
			local yj = y[j + 1] / d[j + 1]
			y[j + 1] = yj
			for p = buffer.readu32(colptr, 4 * j), buffer.readu32(colptr, 4 * (j + 1)) - 1 do
				local i = buffer.readu32(rowind, 4 * p)
				if i > j then
					y[i + 1] -= w * buffer.readf64(vals, 8 * p) * yj
				end
			end
		end
		for i = 1, n do
			y[i] *= d[i]
		end
		-- (D + w U) z = D y, backwards.
		for j = n - 1, 0, -1 do
			local zj = y[j + 1] / d[j + 1]
			y[j + 1] = zj
			for p = buffer.readu32(colptr, 4 * j), buffer.readu32(colptr, 4 * (j + 1)) - 1 do
				local i = buffer.readu32(rowind, 4 * p)
				if i < j then
					y[i + 1] -= w * buffer.readf64(vals, 8 * p) * zj
				end
			end
		end
		for i = 1, n do
			buffer.writef64(out, 8 * (i - 1), y[i] * factor)
		end
		return out
	end
end

-- Incomplete LU factorization ILU(0) of a square S, in place: S's values are overwritten
-- with L and U in S's own sparsity pattern (no fill-in). Every diagonal entry must be
-- stored; singular is true if one is missing or a pivot is zero. sparse_ilu0_copy leaves
-- S unchanged.
local function sparse_ilu0(S: Sparse): SparseILU
	assert(S.rows == S.cols, "matrix must be square")
	local n = S.rows
	local colptr, rowind, vals = S.colptr, S.rowind, S.values
	local pos: { [number]: number } = {}
	local diag = table.create(n, 0)
	local singular = false
	for j = 0, n - 1 do
		local p0, p1 = buffer.readu32(colptr, 4 * j), buffer.readu32(colptr, 4 * (j + 1)) - 1
		for p = p0, p1 do
			pos[buffer.readu32(rowind, 4 * p)] = p
		end
		-- Eliminate with each earlier column k that column j has an entry in, in order:
		-- u_kj is final by the time it is reached.
		for p = p0, p1 do
			local k = buffer.readu32(rowind, 4 * p)
			if k >= j then
				break
			end
			local ukj = buffer.readf64(vals, 8 * p)
			if ukj ~= 0 then
				for q = diag[k + 1] + 1, buffer.readu32(colptr, 4 * (k + 1)) - 1 do
					local t = pos[buffer.readu32(rowind, 4 * q)]
					if t then
						do
							local here_ = 8 * t
							buffer.writef64(vals, here_, buffer.readf64(vals, here_) - (buffer.readf64(vals, 8 * q) * ukj))
						end
					end
				end
			end
		end
		local dp = pos[j]
		if dp == nil or buffer.readf64(vals, 8 * dp) == 0 then
			singular = true
			diag[j + 1] = if dp then dp else p0
		else
			diag[j + 1] = dp
			local ujj = buffer.readf64(vals, 8 * dp)
			for p = dp + 1, p1 do
				do
					local here_ = 8 * p
					buffer.writef64(vals, here_, buffer.readf64(vals, here_) / ujj)
				end
			end
		end
		for p = p0, p1 do
			pos[buffer.readu32(rowind, 4 * p)] = nil
		end
	end
	return { lu = S, diag = diag, singular = singular }
end

local function sparse_copy(S: Sparse): Sparse
	return { rows = S.rows, cols = S.cols, colptr = S.colptr, rowind = S.rowind, values = copy(nil, S.values), symmetric = S.symmetric, hermitian = S.hermitian }
end

-- sparse_ilu0 of a copy of S (the index arrays are shared, the values copied).
local function sparse_ilu0_copy(S: Sparse): SparseILU
	return sparse_ilu0(sparse_copy(S))
end

-- out := (L U)^-1 r given F = sparse_ilu0(S); use it as a preconditioner with
-- function(out, r) return sparse_ilu0_solve(out, F, r) end.
local function sparse_ilu0_solve(out: buffer?, F: SparseILU, r: buffer): buffer
	assert(not F.singular, "the incomplete factorization is singular")
	local S = F.lu
	local n = S.rows
	assert(length(r) == n, "matrix and vector sizes do not match")
	local colptr, rowind, vals, diag = S.colptr, S.rowind, S.values, F.diag
	local y = totable(r)
	for j = 0, n - 1 do
		local yj = y[j + 1]
		for p = diag[j + 1] + 1, buffer.readu32(colptr, 4 * (j + 1)) - 1 do
			local i = buffer.readu32(rowind, 4 * p) + 1
			y[i] -= buffer.readf64(vals, 8 * p) * yj
		end
	end
	for j = n - 1, 0, -1 do
		local yj = y[j + 1] / buffer.readf64(vals, 8 * (diag[j + 1]))
		y[j + 1] = yj
		for p = buffer.readu32(colptr, 4 * j), diag[j + 1] - 1 do
			local i = buffer.readu32(rowind, 4 * p) + 1
			y[i] -= buffer.readf64(vals, 8 * p) * yj
		end
	end
	local o = output(out, 8 * n)
	for i = 1, n do
		buffer.writef64(o, 8 * (i - 1), y[i])
	end
	return o
end

-- Incomplete Cholesky factorization IC(0) of a symmetric positive definite S, in place:
-- only the lower triangle is read, and it is overwritten with L in its own sparsity
-- pattern (no fill-in). It can break down even for positive definite S (definite is then
-- false); it cannot for M-matrices such as discrete Laplacians. sparse_ic0_copy leaves S
-- unchanged.
local function sparse_ic0(S: Sparse): SparseIC
	assert(S.rows == S.cols, "matrix must be square")
	local n = S.rows
	local colptr, rowind, vals = S.colptr, S.rowind, S.values
	local diag = table.create(n, 0)
	for j = 0, n - 1 do
		local dp = find(S, j, j)
		if dp == nil then
			return { ic = S, diag = diag, definite = false }
		end
		diag[j + 1] = dp
		local djj = buffer.readf64(vals, 8 * dp)
		if not (djj > 0) then
			return { ic = S, diag = diag, definite = false }
		end
		djj = math.sqrt(djj)
		buffer.writef64(vals, 8 * dp, djj)
		local p1 = buffer.readu32(colptr, 4 * (j + 1)) - 1
		for p = dp + 1, p1 do
			do
				local here_ = 8 * p
				buffer.writef64(vals, here_, buffer.readf64(vals, here_) / djj)
			end
		end
		-- Right-looking update of later columns, only where the pattern has an entry:
		-- A(i, k) -= L(i, j) L(k, j) for j < k <= i.
		for q = dp + 1, p1 do
			local k = buffer.readu32(rowind, 4 * q)
			local lkj = buffer.readf64(vals, 8 * q)
			for p = q, p1 do
				local t = find(S, buffer.readu32(rowind, 4 * p), k)
				if t then
					do
						local here_ = 8 * t
						buffer.writef64(vals, here_, buffer.readf64(vals, here_) - (buffer.readf64(vals, 8 * p) * lkj))
					end
				end
			end
		end
	end
	return { ic = S, diag = diag, definite = true }
end

-- sparse_ic0 of a copy of S (the index arrays are shared, the values copied).
local function sparse_ic0_copy(S: Sparse): SparseIC
	return sparse_ic0(sparse_copy(S))
end

-- out := (L L^T)^-1 r given F = sparse_ic0(S); use it as a preconditioner with
-- function(out, r) return sparse_ic0_solve(out, F, r) end.
local function sparse_ic0_solve(out: buffer?, F: SparseIC, r: buffer): buffer
	assert(F.definite, "the incomplete Cholesky factorization broke down")
	local S = F.ic
	local n = S.rows
	assert(length(r) == n, "matrix and vector sizes do not match")
	local colptr, rowind, vals, diag = S.colptr, S.rowind, S.values, F.diag
	local y = totable(r)
	-- L y = r
	for j = 0, n - 1 do
		local yj = y[j + 1] / buffer.readf64(vals, 8 * (diag[j + 1]))
		y[j + 1] = yj
		for p = diag[j + 1] + 1, buffer.readu32(colptr, 4 * (j + 1)) - 1 do
			local i = buffer.readu32(rowind, 4 * p) + 1
			y[i] -= buffer.readf64(vals, 8 * p) * yj
		end
	end
	-- L^T z = y
	for j = n - 1, 0, -1 do
		local s = y[j + 1]
		for p = diag[j + 1] + 1, buffer.readu32(colptr, 4 * (j + 1)) - 1 do
			s -= buffer.readf64(vals, 8 * p) * y[buffer.readu32(rowind, 4 * p) + 1]
		end
		y[j + 1] = s / buffer.readf64(vals, 8 * (diag[j + 1]))
	end
	local o = output(out, 8 * n)
	for i = 1, n do
		buffer.writef64(o, 8 * (i - 1), y[i])
	end
	return o
end

-- Block sparse matrices

-- Position (0-based) of block (I, J) (0-based) in B's arrays, or nil.
local function find_block(B: BlockSparse, I: number, J: number): number?
	local lo, hi = buffer.readu32(B.rowptr, 4 * I), buffer.readu32(B.rowptr, 4 * (I + 1)) - 1
	while lo <= hi do
		local mid = (lo + hi) // 2
		local c = buffer.readu32(B.colind, 4 * mid)
		if c == J then
			return mid
		elseif c < J then
			lo = mid + 1
		else
			hi = mid - 1
		end
	end
	return nil
end

-- The block sparse matrix with block row I's blocks at the (sorted, distinct) block
-- columns cols[I + 1], values zero.
local function block_pattern(rows: number, cols: number, block: number, colsets: { { number } }): BlockSparse
	local br = rows // block
	local nb = 0
	for I = 1, br do
		nb += #colsets[I]
	end
	local rowptr, colind = buffer.create(4 * (br + 1)), buffer.create(4 * nb)
	local p = 0
	for I = 1, br do
		buffer.writeu32(rowptr, 4 * (I - 1), p)
		for _, J in colsets[I] do
			buffer.writeu32(colind, 4 * p, J)
			p += 1
		end
	end
	buffer.writeu32(rowptr, 4 * br, p)
	return { rows = rows, cols = cols, block = block, rowptr = rowptr, colind = colind, values = create(block * block * nb) }
end

-- A rows by cols block sparse matrix with block by block blocks from block triplets:
-- block (ii[k], jj[k]) (1-based block indices) gets the block^2 entries of values from
-- element block^2 (k - 1) + 1 on, column-major; repeated positions are summed.
local function bsparse(rows: number, cols: number, block: number, ii: { number }, jj: { number }, values: buffer): BlockSparse
	assert(block >= 1 and block % 1 == 0 and rows % block == 0 and cols % block == 0, "rows and cols must be multiples of the block size")
	local bb = block * block
	local count = #ii
	assert(#jj == count and length(values) == bb * count, "need block^2 values per block position")
	local br, bc = rows // block, cols // block
	local colsets = table.create(br) :: { { number } }
	for I = 1, br do
		colsets[I] = {}
	end
	local seen = {} :: { [number]: boolean }
	for k = 1, count do
		local I, J = ii[k], jj[k]
		assert(I % 1 == 0 and J % 1 == 0 and I >= 1 and I <= br and J >= 1 and J <= bc, "block position outside the matrix")
		local key = (I - 1) * bc + (J - 1)
		if not seen[key] then
			seen[key] = true
			table.insert(colsets[I], J - 1)
		end
	end
	for I = 1, br do
		table.sort(colsets[I])
	end
	local B = block_pattern(rows, cols, block, colsets)
	-- Sum in double precision, then round once.
	local acc = buffer.create(8 * bb * buffer.len(B.colind) // 4)
	for k = 1, count do
		local p = find_block(B, ii[k] - 1, jj[k] - 1) :: number
		for e = 0, bb - 1 do
			local a = 8 * (bb * p + e)
			buffer.writef64(acc, a, buffer.readf64(acc, a) + buffer.readf64(values, 8 * (bb * (k - 1) + e)))
		end
	end
	for e = 0, buffer.len(acc) // 8 - 1 do
		buffer.writef64(B.values, 8 * e, buffer.readf64(acc, 8 * e))
	end
	return B
end

-- S in blocks of block by block (every block holding a stored entry of S is stored
-- whole); S's symmetric and hermitian marks carry over.
local function bsparse_from_sparse(S: Sparse, block: number): BlockSparse
	assert(block >= 1 and block % 1 == 0 and S.rows % block == 0 and S.cols % block == 0, "rows and cols must be multiples of the block size")
	local br, bb = S.rows // block, block * block
	local colsets = table.create(br) :: { { number } }
	local seen = table.create(br) :: { { [number]: boolean } }
	for I = 1, br do
		colsets[I], seen[I] = {}, {}
	end
	for j = 0, S.cols - 1 do
		local J = j // block
		for p = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local I = buffer.readu32(S.rowind, 4 * p) // block + 1
			if not seen[I][J] then
				seen[I][J] = true
				table.insert(colsets[I], J)
			end
		end
	end
	for I = 1, br do
		table.sort(colsets[I])
	end
	local B = block_pattern(S.rows, S.cols, block, colsets)
	for j = 0, S.cols - 1 do
		for p = buffer.readu32(S.colptr, 4 * j), buffer.readu32(S.colptr, 4 * (j + 1)) - 1 do
			local r = buffer.readu32(S.rowind, 4 * p)
			local q = find_block(B, r // block, j // block) :: number
			buffer.writef64(B.values, 8 * (bb * q + (j % block) * block + r % block), buffer.readf64(S.values, 8 * p))
		end
	end
	B.symmetric, B.hermitian = S.symmetric, S.hermitian
	return B
end

-- B as a Sparse matrix, every entry of its stored blocks stored (zeros included).
local function bsparse_sparse(B: BlockSparse): Sparse
	local b, bb = B.block, B.block * B.block
	local colrows, colvals = empty_columns(B.cols)
	for I = 0, B.rows // b - 1 do
		for p = buffer.readu32(B.rowptr, 4 * I), buffer.readu32(B.rowptr, 4 * (I + 1)) - 1 do
			local J = buffer.readu32(B.colind, 4 * p)
			for k = 0, b - 1 do
				local rs, vs = colrows[J * b + k + 1], colvals[J * b + k + 1]
				for r = 0, b - 1 do
					table.insert(rs, I * b + r)
					table.insert(vs, buffer.readf64(B.values, 8 * (bb * p + k * b + r)))
				end
			end
		end
	end
	local S = assemble(B.rows, B.cols, colrows, colvals)
	S.symmetric, S.hermitian = B.symmetric, B.hermitian
	return S
end

-- Number of stored entries (block^2 per stored block).
local function bsparse_nnz(B: BlockSparse): number
	return B.block * B.block * (buffer.len(B.colind) // 4)
end

-- The number p (1-based) of block (I, J) (1-based block indices), or nil if it is not
-- stored: its entries are values[block^2 (p - 1) + 1 .. block^2 p], column-major. For
-- updating values in place (a Jacobian refilled each step on a fixed pattern).
local function bsparse_block(B: BlockSparse, I: number, J: number): number?
	local p = find_block(B, I - 1, J - 1)
	return if p then p + 1 else nil
end

-- Entry (i, j), 1-based (0 if not stored).
local function bsparse_get(B: BlockSparse, i: number, j: number): number
	local b = B.block
	local p = find_block(B, (i - 1) // b, (j - 1) // b)
	return if p then buffer.readf64(B.values, 8 * (b * b * p + ((j - 1) % b) * b + (i - 1) % b)) else 0
end

-- The diagonal, as an array of min(rows, cols) entries.
local function bsparse_diag(B: BlockSparse): buffer
	local b = B.block
	local k = math.min(B.rows, B.cols)
	local d = create(k)
	for I = 0, k // b - 1 do
		local p = find_block(B, I, I)
		if p then
			for r = 0, b - 1 do
				buffer.writef64(d, 8 * (I * b + r), buffer.readf64(B.values, 8 * (b * b * p + r * b + r)))
			end
		end
	end
	return d
end

-- B x, accumulated in double precision (generated kernels for blocks of 2, 3 and 4).
local function bsparse_matvec(out: buffer?, B: BlockSparse, x: buffer): buffer
	assert(length(x) == B.cols, "matrix and vector sizes do not match")
	local o = output(out, 8 * B.rows)
	assert(o ~= x, "output cannot be the input vector")
	local kernel = spk.block[B.block]
	if kernel then
		kernel.mv(o, B, x)
		return o
	end
	local b = B.block
	local bb = b * b
	local s = table.create(b, 0)
	for I = 0, B.rows // b - 1 do
		for r = 1, b do
			s[r] = 0
		end
		for p = buffer.readu32(B.rowptr, 4 * I), buffer.readu32(B.rowptr, 4 * (I + 1)) - 1 do
			local J = buffer.readu32(B.colind, 4 * p)
			for k = 0, b - 1 do
				local xk = buffer.readf64(x, 8 * (J * b + k))
				local v = bb * p + k * b
				for r = 0, b - 1 do
					s[r + 1] += buffer.readf64(B.values, 8 * (v + r)) * xk
				end
			end
		end
		for r = 0, b - 1 do
			buffer.writef64(o, 8 * (I * b + r), s[r + 1])
		end
	end
	return o
end

-- B^T x (B x when B is marked symmetric).
local function bsparse_matvec_adjoint(out: buffer?, B: BlockSparse, x: buffer): buffer
	if B.symmetric or B.hermitian then
		return bsparse_matvec(out, B, x)
	end
	assert(length(x) == B.rows, "matrix and vector sizes do not match")
	local o = output(out, 8 * B.cols)
	assert(o ~= x, "output cannot be the input vector")
	local acc = if 8 == 8 then o else buffer.create(8 * B.cols)
	buffer.fill(acc, 0, 0)
	local kernel = spk.block[B.block]
	if kernel then
		kernel.mvt(acc, B, x)
	else
		local b = B.block
		local bb = b * b
		for I = 0, B.rows // b - 1 do
			for p = buffer.readu32(B.rowptr, 4 * I), buffer.readu32(B.rowptr, 4 * (I + 1)) - 1 do
				local J = buffer.readu32(B.colind, 4 * p)
				for k = 0, b - 1 do
					local t = 0
					for r = 0, b - 1 do
						t += buffer.readf64(B.values, 8 * (bb * p + k * b + r)) * buffer.readf64(x, 8 * (I * b + r))
					end
					local a = 8 * (J * b + k)
					buffer.writef64(acc, a, buffer.readf64(acc, a) + t)
				end
			end
		end
	end
	if acc ~= o then
		for i = 0, B.cols - 1 do
			buffer.writef64(o, 8 * i, buffer.readf64(acc, 8 * i))
		end
	end
	return o
end

-- The inverses of B's diagonal blocks, in double precision (bb f64 per block row,
-- column-major), into inv (allocated if nil).
local function block_inverses(B: BlockSparse, inv: buffer?): buffer
	assert(B.rows == B.cols, "matrix must be square")
	local b = B.block
	local bb, nb = b * b, B.rows // b
	local out = inv or buffer.create(8 * bb * nb)
	if b <= 3 then
		-- Closed forms (the adjugate over the determinant): about a tenth of the cost of
		-- the elimination below, whose loops and table accesses dominate small blocks.
		local v = B.values
		for I = 0, nb - 1 do
			local p = find_block(B, I, I)
			assert(p, "a diagonal block is not stored")
			local s, d = 8 * (bb * p), 8 * bb * I
			if b == 1 then
				local m = buffer.readf64(v, s)
				assert(m ~= 0, "a diagonal block is singular")
				buffer.writef64(out, d, 1 / m)
			elseif b == 2 then
				local m11, m21, m12, m22 = buffer.readf64(v, s), buffer.readf64(v, s + (8 * 1)), buffer.readf64(v, s + (8 * 2)), buffer.readf64(v, s + (8 * 3))
				local det = m11 * m22 - m12 * m21
				assert(det ~= 0, "a diagonal block is singular")
				local id = 1 / det
				buffer.writef64(out, d, m22 * id)
				buffer.writef64(out, d + 8, -m21 * id)
				buffer.writef64(out, d + 16, -m12 * id)
				buffer.writef64(out, d + 24, m11 * id)
			else
				local m11, m21, m31 = buffer.readf64(v, s), buffer.readf64(v, s + (8 * 1)), buffer.readf64(v, s + (8 * 2))
				local m12, m22, m32 = buffer.readf64(v, s + (8 * 3)), buffer.readf64(v, s + (8 * 4)), buffer.readf64(v, s + (8 * 5))
				local m13, m23, m33 = buffer.readf64(v, s + (8 * 6)), buffer.readf64(v, s + (8 * 7)), buffer.readf64(v, s + (8 * 8))
				-- cofactors
				local c11, c12, c13 = m22 * m33 - m23 * m32, m23 * m31 - m21 * m33, m21 * m32 - m22 * m31
				local c21, c22, c23 = m13 * m32 - m12 * m33, m11 * m33 - m13 * m31, m12 * m31 - m11 * m32
				local c31, c32, c33 = m12 * m23 - m13 * m22, m13 * m21 - m11 * m23, m11 * m22 - m12 * m21
				local det = m11 * c11 + m12 * c12 + m13 * c13
				assert(det ~= 0, "a diagonal block is singular")
				local id = 1 / det
				-- inverse (i, j) = cofactor (j, i) / det, column-major
				buffer.writef64(out, d, c11 * id)
				buffer.writef64(out, d + 8, c12 * id)
				buffer.writef64(out, d + 16, c13 * id)
				buffer.writef64(out, d + 24, c21 * id)
				buffer.writef64(out, d + 32, c22 * id)
				buffer.writef64(out, d + 40, c23 * id)
				buffer.writef64(out, d + 48, c31 * id)
				buffer.writef64(out, d + 56, c32 * id)
				buffer.writef64(out, d + 64, c33 * id)
			end
		end
		return out
	end
	local a = table.create(bb, 0)
	local z = table.create(bb, 0)
	for I = 0, nb - 1 do
		local p = find_block(B, I, I)
		assert(p, "a diagonal block is not stored")
		for e = 1, bb do
			a[e] = buffer.readf64(B.values, 8 * (bb * (p :: number) + e - 1))
			z[e] = if (e - 1) // b == (e - 1) % b then 1 else 0
		end
		-- Gauss-Jordan on [a | z], column-major (entry (r, c) at c * b + r + 1).
		for c = 0, b - 1 do
			local piv, best = c, math.abs(a[c * b + c + 1])
			for r = c + 1, b - 1 do
				local v = math.abs(a[c * b + r + 1])
				if v > best then
					piv, best = r, v
				end
			end
			assert(best > 0, "a diagonal block is singular")
			if piv ~= c then
				for k = 0, b - 1 do
					a[k * b + c + 1], a[k * b + piv + 1] = a[k * b + piv + 1], a[k * b + c + 1]
					z[k * b + c + 1], z[k * b + piv + 1] = z[k * b + piv + 1], z[k * b + c + 1]
				end
			end
			local d = 1 / a[c * b + c + 1]
			for k = 0, b - 1 do
				a[k * b + c + 1] *= d
				z[k * b + c + 1] *= d
			end
			for r = 0, b - 1 do
				local f = a[c * b + r + 1]
				if r ~= c and f ~= 0 then
					for k = 0, b - 1 do
						a[k * b + r + 1] -= f * a[k * b + c + 1]
						z[k * b + r + 1] -= f * z[k * b + c + 1]
					end
				end
			end
		end
		for e = 1, bb do
			buffer.writef64(out, 8 * (bb * I + e - 1), z[e])
		end
	end
	return out
end

-- o := blockdiag(inv) r for nb inverse blocks of size b (from block_inverses).
local function apply_block_inverses(o: buffer, inv: buffer, r: buffer, b: number, nb: number)
	local kernel = spk.block[b]
	if kernel then
		kernel.jacobi(o, inv, r, nb)
		return
	end
	local bb = b * b
	local t = table.create(b, 0)
	for I = 0, nb - 1 do
		for k = 0, b - 1 do
			t[k + 1] = buffer.readf64(r, 8 * (I * b + k))
		end
		for i = 0, b - 1 do
			local s = 0
			for k = 0, b - 1 do
				s += buffer.readf64(inv, 8 * (bb * I + k * b + i)) * t[k + 1]
			end
			buffer.writef64(o, 8 * (I * b + i), s)
		end
	end
end

-- The block Jacobi preconditioner of a square B, for the iterative solvers: out :=
-- blockdiag(B)^-1 r, the diagonal blocks inverted once (in double precision, by
-- Gauss-Jordan elimination with partial pivoting). It keeps each node's coupling between
-- its own unknowns, which scalar Jacobi drops, and is unchanged by rotating a node's
-- coordinates. Every diagonal block must be stored and nonsingular; for a symmetric
-- positive definite B it is symmetric positive definite (usable with CG).
local function bsparse_jacobi(B: BlockSparse): (out: buffer, r: buffer) -> buffer
	local inv = block_inverses(B)
	local b = B.block
	local nb = B.rows // b
	return function(out: buffer, r: buffer): buffer
		local o = output(out, 8 * B.rows)
		apply_block_inverses(o, inv, r, b, nb)
		return o
	end
end
-- Algebraic multigrid for block sparse matrices
-- Symbolic product of block sparse X (m by k blocks) and Y (k by n): the pattern of
-- X Y (values zero) and the triples (c, x, y) of block numbers that make it, 3 u32 each.
local function product_plan(X: BlockSparse, Y: BlockSparse): (BlockSparse, buffer, number)
	local b = X.block
	local br = X.rows // b
	local colsets = table.create(br) :: { { number } }
	local count = 0
	for I = 0, br - 1 do
		local seen: { [number]: boolean } = {}
		local list = {}
		for p = buffer.readu32(X.rowptr, 4 * I), buffer.readu32(X.rowptr, 4 * (I + 1)) - 1 do
			local K = buffer.readu32(X.colind, 4 * p)
			for q = buffer.readu32(Y.rowptr, 4 * K), buffer.readu32(Y.rowptr, 4 * (K + 1)) - 1 do
				local J = buffer.readu32(Y.colind, 4 * q)
				count += 1
				if not seen[J] then
					seen[J] = true
					table.insert(list, J)
				end
			end
		end
		table.sort(list)
		colsets[I + 1] = list
	end
	local C = block_pattern(X.rows, Y.cols, b, colsets)
	local plan = buffer.create(12 * count)
	local t = 0
	for I = 0, br - 1 do
		local slot: { [number]: number } = {}
		for c = buffer.readu32(C.rowptr, 4 * I), buffer.readu32(C.rowptr, 4 * (I + 1)) - 1 do
			slot[buffer.readu32(C.colind, 4 * c)] = c
		end
		for p = buffer.readu32(X.rowptr, 4 * I), buffer.readu32(X.rowptr, 4 * (I + 1)) - 1 do
			local K = buffer.readu32(X.colind, 4 * p)
			for q = buffer.readu32(Y.rowptr, 4 * K), buffer.readu32(Y.rowptr, 4 * (K + 1)) - 1 do
				buffer.writeu32(plan, 12 * t, slot[buffer.readu32(Y.colind, 4 * q)])
				buffer.writeu32(plan, 12 * t + 4, p)
				buffer.writeu32(plan, 12 * t + 8, q)
				t += 1
			end
		end
	end
	return C, plan, count
end

-- C := X Y on the pattern and triples from product_plan.
local function block_product(C: BlockSparse, X: BlockSparse, Y: BlockSparse, plan: buffer, count: number)
	buffer.fill(C.values, 0, 0)
	local b = C.block
	local kernel = spk.block[b]
	if kernel then
		kernel.product(C.values, X.values, Y.values, plan, count)
		return
	end
	local bb = b * b
	for t = 0, count - 1 do
		local c, x, y = bb * buffer.readu32(plan, 4 * (3 * t)), bb * buffer.readu32(plan, 4 * (3 * t + 1)), bb * buffer.readu32(plan, 4 * (3 * t + 2))
		for s = 0, b - 1 do
			for r = 0, b - 1 do
				local acc = 0
				for k = 0, b - 1 do
					acc += buffer.readf64(X.values, 8 * (x + k * b + r)) * buffer.readf64(Y.values, 8 * (y + s * b + k))
				end
				do
					local here_ = 8 * (c + s * b + r)
					buffer.writef64(C.values, here_, buffer.readf64(C.values, here_) + acc)
				end
			end
		end
	end
end

-- The pattern of P^T and, for each of its blocks, the number of the block of P it
-- transposes (u32).
local function transpose_plan(P: BlockSparse): (BlockSparse, buffer)
	local b = P.block
	local bc = P.cols // b
	local colsets = table.create(bc) :: { { number } }
	for J = 1, bc do
		colsets[J] = {}
	end
	for I = 0, P.rows // b - 1 do
		for p = buffer.readu32(P.rowptr, 4 * I), buffer.readu32(P.rowptr, 4 * (I + 1)) - 1 do
			table.insert(colsets[buffer.readu32(P.colind, 4 * p) + 1], I)
		end
	end
	local T = block_pattern(P.cols, P.rows, b, colsets)
	local src = buffer.create(buffer.len(P.colind))
	local nextpos = table.create(bc, 0)
	for J = 0, bc - 1 do
		nextpos[J + 1] = buffer.readu32(T.rowptr, 4 * J)
	end
	for I = 0, P.rows // b - 1 do
		for p = buffer.readu32(P.rowptr, 4 * I), buffer.readu32(P.rowptr, 4 * (I + 1)) - 1 do
			local J = buffer.readu32(P.colind, 4 * p) + 1
			buffer.writeu32(src, 4 * nextpos[J], p)
			nextpos[J] += 1
		end
	end
	return T, src
end

local function transpose_values(T: BlockSparse, P: BlockSparse, src: buffer)
	local b = P.block
	local bb = b * b
	for t = 0, buffer.len(src) // 4 - 1 do
		local p = buffer.readu32(src, 4 * t)
		for s = 0, b - 1 do
			for r = 0, b - 1 do
				buffer.writef64(T.values, 8 * (bb * t + s * b + r), buffer.readf64(P.values, 8 * (bb * p + r * b + s)))
			end
		end
	end
end

-- Squared Frobenius norm of block p.
local function block_norm2(B: BlockSparse, p: number): number
	local bb = B.block * B.block
	local s = 0
	for e = 0, bb - 1 do
		local v = buffer.readf64(B.values, 8 * (bb * p + e))
		s += v * v
	end
	return s
end

-- Greedy aggregation of the active block rows along strong couplings (|A_IJ|_F^2 >=
-- theta^2 |A_II|_F |A_JJ|_F): a node whose strong neighbors are all unaggregated
-- starts an aggregate with them; leftovers join a neighboring aggregate or start their
-- own. Returns each node's aggregate (1-based; 0 for inactive nodes) and the count.
local function aggregate(A: BlockSparse, theta: number, active: { boolean }): ({ number }, number)
	local n = A.rows // A.block
	local dn = table.create(n, 0)
	for I = 0, n - 1 do
		local p = find_block(A, I, I)
		dn[I + 1] = if p then math.sqrt(block_norm2(A, p)) else 0
	end
	local adjacency = table.create(n) :: { { number } }
	for I = 0, n - 1 do
		local list = {}
		if active[I + 1] then
			for p = buffer.readu32(A.rowptr, 4 * I), buffer.readu32(A.rowptr, 4 * (I + 1)) - 1 do
				local J = buffer.readu32(A.colind, 4 * p)
				if J ~= I and active[J + 1] then
					local f = block_norm2(A, p)
					if f > 0 and f >= theta * theta * dn[I + 1] * dn[J + 1] then
						table.insert(list, J + 1)
					end
				end
			end
		end
		adjacency[I + 1] = list
	end
	local agg = table.create(n, 0)
	local count = 0
	for i = 1, n do
		if active[i] and agg[i] == 0 then
			local clear = true
			for _, j in adjacency[i] do
				if agg[j] ~= 0 then
					clear = false
					break
				end
			end
			if clear then
				count += 1
				agg[i] = count
				for _, j in adjacency[i] do
					agg[j] = count
				end
			end
		end
	end
	for i = 1, n do
		if active[i] and agg[i] == 0 then
			for _, j in adjacency[i] do
				if agg[j] ~= 0 then
					agg[i] = agg[j]
					break
				end
			end
			if agg[i] == 0 then
				count += 1
				agg[i] = count
			end
		end
	end
	return agg, count
end

-- An estimate of the largest eigenvalue of D^-1 A (power iteration; D^-1 A is similar
-- to a symmetric matrix when A is), slightly enlarged.
local function spectral_radius(A: BlockSparse, inv: buffer): number
	local b, n = A.block, A.rows
	local x, t = create(n), create(n)
	for i = 0, n - 1 do
		buffer.writef64(x, 8 * i, 1 + 0.5 * math.sin(1.7 * i + 0.3))
	end
	x = scale(x, 1 / norm(x), x)
	local lambda = 1
	for _ = 1, 15 do
		bsparse_matvec(t, A, x)
		apply_block_inverses(x, inv, t, b, n // b)
		local nx = norm(x)
		if not (nx > 0) then
			break
		end
		lambda = nx
		x = scale(x, 1 / nx, x)
	end
	return 1.05 * lambda
end

-- Algebraic multigrid preconditioner for a symmetric positive definite block sparse B
-- (blocks of the size of a node's unknowns: 3 for positions in 3D). See types.BlockAMG.
local function bsparse_amg(B: BlockSparse, options: AMGOptions?): BlockAMG
	local o: AMGOptions = options or {}
	assert(B.rows == B.cols, "matrix must be square")
	local b = B.block
	local bb = b * b
	local smooth = o.smooth ~= false
	local theta = o.theta or 0.08
	local alpha = o.alpha or 1
	local coarsest = o.coarsest or 64
	local n = B.rows
	-- Fixed components: their rows and columns are dropped (identity), as when a solver
	-- holds them in place.
	local fixed = table.create(n, false)
	for _, c in o.fixed or {} do
		fixed[c] = true
	end
	local nb = n // b
	local active = table.create(nb, true)
	for I = 0, nb - 1 do
		local all = true
		for r = 1, b do
			all = all and fixed[I * b + r]
		end
		active[I + 1] = not all
	end
	local any_fixed = #(o.fixed or {}) > 0

	-- The fine matrix: a copy of B's values on B's pattern, fixed components masked.
	local A1: BlockSparse = { rows = n, cols = n, block = b, rowptr = B.rowptr, colind = B.colind, values = create(length(B.values)) }
	-- The masked entries' byte offsets and values (1 on the diagonal, else 0), found
	-- once, so a refill writes only those.
	local masked = buffer.create(0)
	local masked_value: { number } = {}
	if any_fixed then
		local offsets = {}
		for I = 0, nb - 1 do
			for p = buffer.readu32(A1.rowptr, 4 * I), buffer.readu32(A1.rowptr, 4 * (I + 1)) - 1 do
				local J = buffer.readu32(A1.colind, 4 * p)
				for s = 0, b - 1 do
					for r = 0, b - 1 do
						local i, j = I * b + r + 1, J * b + s + 1
						if fixed[i] or fixed[j] then
							table.insert(offsets, 8 * (bb * p + s * b + r))
							table.insert(masked_value, if i == j then 1 else 0)
						end
					end
				end
			end
		end
		masked = buffer.create(4 * #offsets)
		for k, off in offsets do
			buffer.writeu32(masked, 4 * (k - 1), off)
		end
	end
	local function load_values(values: buffer)
		assert(length(values) == length(A1.values), "bsparse_amg: the matrix's pattern changed")
		buffer.copy(A1.values, 0, values, 0, buffer.len(values))
		for k = 1, #masked_value do
			buffer.writef64(A1.values, buffer.readu32(masked, 4 * (k - 1)), masked_value[k])
		end
	end
	load_values(B.values)

	local levels: { any } = {}
	local A = A1
	local first = true
	while true do
		local L: any = { A = A, nb = A.rows // b, x = create(A.rows), r = create(A.rows), t = create(A.rows), z = create(A.rows) }
		table.insert(levels, L)
		L.inv = block_inverses(A)
		if A.rows <= coarsest then
			break
		end
		local act = if first then active else table.create(L.nb, true)
		local agg, count = aggregate(A, theta, act)
		if count == 0 or count >= 0.9 * L.nb then
			-- Too few strong couplings to coarsen: aggregate along all of them.
			agg, count = aggregate(A, 0, act)
			if count == 0 or count >= 0.9 * L.nb then
				assert(A.rows <= 20 * coarsest, "bsparse_amg: the matrix does not coarsen")
				break
			end
		end
		L.rho = spectral_radius(A, L.inv)
		L.omega = 4 / (3 * L.rho)
		-- The tentative prolongation: each node's identity block to its aggregate
		-- (fixed components' rows zero).
		local colsets = table.create(L.nb) :: { { number } }
		for I = 1, L.nb do
			colsets[I] = if agg[I] > 0 then { agg[I] - 1 } else {}
		end
		local T = block_pattern(A.rows, b * count, b, colsets)
		for I = 0, L.nb - 1 do
			if agg[I + 1] > 0 then
				local p = buffer.readu32(T.rowptr, 4 * I)
				for r = 0, b - 1 do
					buffer.writef64(T.values, 8 * (bb * p + r * b + r), if fixed[I * b + r + 1] and first then 0 else 1)
				end
			end
		end
		L.tent = T
		if smooth then
			-- P = T - omega D^-1 A T, from the products Dinv A and (Dinv A) T.
			local dsets = table.create(L.nb) :: { { number } }
			for I = 1, L.nb do
				dsets[I] = { I - 1 }
			end
			L.dinv = block_pattern(A.rows, A.rows, b, dsets)
			L.da, L.da_plan, L.da_count = product_plan(L.dinv, A)
			L.s, L.s_plan, L.s_count = product_plan(L.da, T)
			L.P = { rows = L.s.rows, cols = L.s.cols, block = b, rowptr = L.s.rowptr, colind = L.s.colind, values = create(length(L.s.values)) }
			-- where T's blocks sit in P
			local where = table.create(L.nb, -1)
			for I = 0, L.nb - 1 do
				if agg[I + 1] > 0 then
					where[I + 1] = find_block(L.P, I, agg[I + 1] - 1) :: number
				end
			end
			L.where = where
		else
			L.P = T
		end
		L.PT, L.pt_src = transpose_plan(L.P)
		L.AP, L.ap_plan, L.ap_count = product_plan(A, L.P)
		local Cpat, c_plan, c_count = product_plan(L.PT, L.AP)
		L.c_plan, L.c_count = c_plan, c_count
		L.C = Cpat
		-- Numeric values for this level's transfer and the next level's matrix.
		local function numeric()
			if smooth then
				for I = 0, L.nb - 1 do
					for e = 0, bb - 1 do
						buffer.writef64(L.dinv.values, 8 * (bb * I + e), buffer.readf64(L.inv, 8 * (bb * I + e)))
					end
				end
				block_product(L.da, L.dinv, L.A, L.da_plan, L.da_count)
				block_product(L.s, L.da, T, L.s_plan, L.s_count)
				scale(L.P.values, -L.omega, L.s.values)
				for I = 0, L.nb - 1 do
					local p = L.where[I + 1]
					if p >= 0 then
						local q = buffer.readu32(T.rowptr, 4 * I)
						for e = 0, bb - 1 do
							do
								local here_ = 8 * (bb * p + e)
								buffer.writef64(L.P.values, here_, buffer.readf64(L.P.values, here_) + buffer.readf64(T.values, 8 * (bb * q + e)))
							end
						end
					end
				end
			end
			transpose_values(L.PT, L.P, L.pt_src)
			block_product(L.AP, L.A, L.P, L.ap_plan, L.ap_count)
			block_product(L.C, L.PT, L.AP, L.c_plan, L.c_count)
		end
		L.numeric = numeric
		numeric()
		A = L.C
		first = false
	end

	-- The coarsest level, factored densely (Cholesky).
	local function factor_coarsest()
		local L = levels[#levels]
		local M = matrix(L.A.rows, L.A.rows)
		local m = L.A.rows
		for I = 0, L.nb - 1 do
			for p = buffer.readu32(L.A.rowptr, 4 * I), buffer.readu32(L.A.rowptr, 4 * (I + 1)) - 1 do
				local J = buffer.readu32(L.A.colind, 4 * p)
				for s = 0, b - 1 do
					for r = 0, b - 1 do
						buffer.writef64(M.data, 8 * ((J * b + s) * m + I * b + r), buffer.readf64(L.A.values, 8 * (bb * p + s * b + r)))
					end
				end
			end
		end
		L.factor = chol(M)
		assert(L.factor.definite, "bsparse_amg: the coarsest matrix is not positive definite")
	end
	factor_coarsest()

	local function cycle(l: number, x: buffer, r: buffer)
		local L = levels[l]
		if l == #levels then
			chol_solve(x, L.factor, r)
			return
		end
		local C = levels[l + 1]
		-- Pre-smoothing from zero, the restricted residual, the coarse correction, and
		-- post-smoothing (damped block Jacobi both times, so the cycle is symmetric).
		apply_block_inverses(x, L.inv, r, b, L.nb)
		scale(x, L.omega, x)
		bsparse_matvec(L.t, L.A, x)
		sub(L.t, r, L.t)
		bsparse_matvec(C.r, L.PT, L.t)
		cycle(l + 1, C.x, C.r)
		bsparse_matvec(L.t, L.P, C.x)
		axpy(x, alpha, L.t, x)
		bsparse_matvec(L.t, L.A, x)
		sub(L.t, r, L.t)
		apply_block_inverses(L.z, L.inv, L.t, b, L.nb)
		axpy(x, L.omega, L.z, x)
	end

	local sizes = table.create(#levels, 0)
	for l, L in levels do
		sizes[l] = L.A.rows
	end
	local H: BlockAMG = {
		sizes = sizes,
		apply = function(out: buffer, r: buffer): buffer
			local res = output(out, 8 * n)
			local rin = r
			if res == r then
				rin = copy(nil, r)
			end
			cycle(1, res, rin)
			return res
		end,
		update = function(B2: BlockSparse)
			load_values(B2.values)
			for l = 1, #levels - 1 do
				local L = levels[l]
				block_inverses(L.A, L.inv)
				L.numeric()
			end
			block_inverses(levels[#levels].A, levels[#levels].inv)
			factor_coarsest()
		end,
	}
	return H
end

return {
	bsparse = bsparse,
	bsparse_amg = bsparse_amg,
	bsparse_block = bsparse_block,
	bsparse_diag = bsparse_diag,
	bsparse_from_sparse = bsparse_from_sparse,
	bsparse_get = bsparse_get,
	bsparse_jacobi = bsparse_jacobi,
	bsparse_matvec = bsparse_matvec,
	bsparse_matvec_adjoint = bsparse_matvec_adjoint,
	bsparse_nnz = bsparse_nnz,
	bsparse_sparse = bsparse_sparse,
	sparse = sparse,
	sparse_add = sparse_add,
	sparse_adjoint = sparse_adjoint,
	sparse_diag = sparse_diag,
	sparse_from_matrix = sparse_from_matrix,
	sparse_get = sparse_get,
	sparse_ic0 = sparse_ic0,
	sparse_ic0_copy = sparse_ic0_copy,
	sparse_ic0_solve = sparse_ic0_solve,
	sparse_ilu0 = sparse_ilu0,
	sparse_ilu0_copy = sparse_ilu0_copy,
	sparse_ilu0_solve = sparse_ilu0_solve,
	sparse_jacobi = sparse_jacobi,
	sparse_matmul = sparse_matmul,
	sparse_matrix = sparse_matrix,
	sparse_matvec = sparse_matvec,
	sparse_matvec_adjoint = sparse_matvec_adjoint,
	sparse_nnz = sparse_nnz,
	sparse_ssor = sparse_ssor,
	sparse_transpose = sparse_transpose,
	sparse_permute = sparse_permute,
	sparse_symband = sparse_symband,
	sparse_chol = sparse_chol,
	sparse_chol_solve = sparse_chol_solve,
}
