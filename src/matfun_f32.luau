-- Types and small helpers shared by the parts. They are copied into each part rather than
-- imported, so calls to them are inlined (a call into another module costs several times
-- more); the generator drops the ones a part does not use.

type Matrix = types.Matrix

-- A rows by cols matrix of zeros.
local function matrix(rows: number, cols: number): Matrix
	return { rows = rows, cols = cols, data = buffer.create(4 * rows * cols) }
end

-- Element i (0-based) as (re, im), and its setter (the imaginary part is dropped), for
-- code shared with the complex modules.
local function eget(x: buffer, i: number): (number, number)
	return buffer.readf32(x, 4 * i), 0
end

local function eset(x: buffer, i: number, re: number, _im: number)
	buffer.writef32(x, 4 * i, re)
end

-- Padé coefficients b_0 .. b_m of exp, and the 1-norm thresholds theta_m below which
-- the [m/m] approximant is accurate to unit roundoff (Higham 2005; single precision
-- uses its own thresholds and stops at m = 7).
local PADE: { [number]: { number } } = {
	[3] = { 120, 60, 12, 1 },
	[5] = { 30240, 15120, 3360, 420, 30, 1 },
	[7] = { 17297280, 8648640, 1995840, 277200, 25200, 1512, 56, 1 },
	[9] = { 17643225600, 8821612800, 2075673600, 302702400, 30270240, 2162160, 110880, 3960, 90, 1 },
	[13] = {
		64764752532480000,
		32382376266240000,
		7771770303897600,
		1187353796428800,
		129060195264000,
		10559470521600,
		670442572800,
		33522128640,
		1323241920,
		40840800,
		960960,
		16380,
		182,
		1,
	},
}
local THETA: { { number } } = if EPS > 1e-10
	then { { 3, 4.258730016922831e-1 }, { 5, 1.880152677804762 }, { 7, 3.925724783138660 } }
	else {
		{ 3, 1.495585217958292e-2 },
		{ 5, 2.539398330063230e-1 },
		{ 7, 9.504178996162932e-1 },
		{ 9, 2.097847961257068 },
		{ 13, 5.371920351148152 },
	}

-- The [m/m] Padé approximant r_m(A) = (V - U)^-1 (V + U), U odd and V even in A.
local function pade(A: Matrix, m: number): Matrix
	local n = A.rows
	local b = PADE[m]
	local I = identity(n)
	local A2 = matmul(nil, A, A)
	local U: Matrix, V: Matrix
	if m < 13 then
		local us, vs = scale(nil, b[2], I.data), scale(nil, b[1], I.data)
		local P = A2
		for k = 1, (m - 1) // 2 do
			us = axpy(us, b[2 * k + 2], P.data, us)
			vs = axpy(vs, b[2 * k + 1], P.data, vs)
			if k < (m - 1) // 2 then
				P = matmul(nil, P, A2)
			end
		end
		local W = matrix(n, n)
		W.data = us
		U = matmul(nil, A, W)
		V = matrix(n, n)
		V.data = vs
	else
		local A4 = matmul(nil, A2, A2)
		local A6 = matmul(nil, A4, A2)
		local function combo(c6: number, c4: number, c2: number, c0: number): Matrix
			local M = matrix(n, n)
			local d = scale(nil, c6, A6.data)
			d = axpy(d, c4, A4.data, d)
			d = axpy(d, c2, A2.data, d)
			M.data = axpy(d, c0, I.data, d)
			return M
		end
		local inner = combo(b[14], b[12], b[10], 0)
		local W = matmul(nil, A6, inner)
		W.data = axpy(W.data, 1, combo(b[8], b[6], b[4], b[2]).data, W.data)
		U = matmul(nil, A, W)
		V = matmul(nil, A6, combo(b[13], b[11], b[9], 0))
		V.data = axpy(V.data, 1, combo(b[7], b[5], b[3], b[1]).data, V.data)
	end
	local P, Q = matrix(n, n), matrix(n, n)
	P.data = add(nil, V.data, U.data)
	Q.data = sub(nil, V.data, U.data)
	return solve(nil, Q, P)
end

-- Diagonal scaling D (powers of 2, so exact) making each row and column of D^-1 A D about
-- equally large off the diagonal (the scaling step of LAPACK's gebal). Returns D^-1 A D
-- and D's diagonal.
local function scaling_balance(A: Matrix): (Matrix, { number })
	local n = A.rows
	local B = matcopy(nil, A)
	local b = B.data
	local d = table.create(n, 1)
	local function mag(i: number, j: number): number
		local re, im = eget(b, j * n + i)
		return math.abs(re) + math.abs(im)
	end
	local converged = false
	while not converged do
		converged = true
		for i = 0, n - 1 do
			local c, r = 0, 0
			for j = 0, n - 1 do
				if j ~= i then
					c += mag(j, i)
					r += mag(i, j)
				end
			end
			if c > 0 and r > 0 then
				local f, cf, rf = 1, c, r
				while cf < rf / 2 and f < 2 ^ 500 do
					f, cf, rf = f * 2, cf * 2, rf / 2
				end
				while cf >= rf * 2 and f > 2 ^ -500 do
					f, cf, rf = f / 2, cf / 2, rf * 2
				end
				if cf + rf < 0.95 * (c + r) then
					converged = false
					d[i + 1] *= f
					for j = 0, n - 1 do
						local re, im = eget(b, i * n + j) -- column i times f
						eset(b, i * n + j, re * f, im * f)
						re, im = eget(b, j * n + i) -- row i divided by f
						eset(b, j * n + i, re / f, im / f)
					end
				end
			end
		end
	end
	return B, d
end

-- The matrix exponential, by scaling and squaring with Padé approximants (Higham
-- 2005): the smallest degree m in {3, 5, 7, 9, 13} whose threshold covers |A|_1, or
-- else degree 13 on A / 2^s, squared s times. A is first balanced, exp(A) = D exp(B) D^-1
-- with B = D^-1 A D, when that makes |B|_1 smaller (as Al-Mohy and Higham 2009 advise):
-- badly scaled matrices, such as a stiff spring's [0 1; -w^2 -2 z w], otherwise lose
-- digits in the squaring (1e-6 against 1e-12 at w = 6283 over a unit step). A is not
-- modified; NaN or infinite entries give a NaN result.
local function expm_unbalanced(A: Matrix): Matrix
	local n = A.rows
	local a = matnorm(A, 1)
	for _, mt in THETA do
		if a <= mt[2] then
			return pade(A, mt[1])
		end
	end
	local top = THETA[#THETA]
	local s = math.max(0, math.ceil(math.log(a / top[2], 2)))
	local As = matrix(n, n)
	As.data = scale(nil, 2 ^ -s, A.data)
	local X = pade(As, top[1])
	for _ = 1, s do
		X = matmul(nil, X, X)
	end
	return X
end

local function expm(A: Matrix): Matrix
	local n = A.rows
	assert(A.cols == n, "expm needs a square matrix")
	local reals = buffer.len(A.data) // 4
	if any_nonfinite(A.data, 0, reals) then
		local X = matrix(n, n)
		fill_nan(X.data, 0, reals)
		return X
	end
	if n == 0 then
		return matrix(0, 0)
	end
	local B, d = scaling_balance(A)
	if not (matnorm(B, 1) < matnorm(A, 1)) then
		return expm_unbalanced(A)
	end
	local X = expm_unbalanced(B)
	local x = X.data
	for j = 0, n - 1 do
		for i = 0, n - 1 do
			local re, im = eget(x, j * n + i)
			local f = d[i + 1] / d[j + 1]
			eset(x, j * n + i, re * f, im * f)
		end
	end
	return X
end
-- Matrix square root and logarithm of a real matrix by the Schur method, computed in the
-- complex module (on the complex Schur form) and returned as real matrices.

-- The complex Schur form of a copy of A, after checking the eigenvalues with bad,
-- which gets (re, im) and says whether the function has no real principal value there.
local function schur_for(A: Matrix, bad: (number, number) -> boolean, message: string): (Matrix, Matrix)
	assert(A.rows == A.cols, "needs a square matrix")
	local S = matcopy(nil, A)
	local Z, wr, wi = schur_impl(S, true, true)
	for k = 1, #wr do
		assert(not bad(wr[k], wi[k]), message)
	end
	return to_complex_schur(S, Z :: Matrix, wr, wi)
end

local function back(Zc: Matrix, F: Matrix): Matrix
	local n = Zc.rows
	local X = complexmod.matmul(nil, complexmod.matmul(nil, Zc, F), complexmod.adjoint(nil, Zc))
	local out = matrix(n, n)
	out.data = complexmod.real(nil, X.data)
	return out
end

-- The principal square root of A (X^2 = A, eigenvalues in the right half plane). It is
-- real unless A has a negative eigenvalue, which is an error here (use the complex
-- module). A is not modified.
local function sqrtm(A: Matrix): Matrix
	local T, Zc = schur_for(A, function(re: number, im: number): boolean
		return im == 0 and re < 0
	end, "sqrtm: a negative eigenvalue means no real principal square root; use the complex module")
	return back(Zc, complexmod.sqrtm_triangular(T))
end

-- The principal logarithm of A. It is real unless A has an eigenvalue on the closed
-- negative real axis (a singular A has none at all), which is an error here (use the
-- complex module for negative eigenvalues). A is not modified.
local function logm(A: Matrix): Matrix
	local T, Zc = schur_for(A, function(re: number, im: number): boolean
		return im == 0 and re <= 0
	end, "logm: an eigenvalue on the closed negative real axis means no real principal logarithm")
	return back(Zc, complexmod.logm_triangular(T))
end

-- The solution X of A X + X B = C (see the complex module's sylvester; the solution of
-- a real equation is real). Nothing is modified.
local function sylvester(A: Matrix, B: Matrix, C: Matrix): Matrix
	local X = complexmod.sylvester(complexified(A), complexified(B), complexified(C))
	local out = matrix(X.rows, X.cols)
	out.data = complexmod.real(nil, X.data)
	return out
end

-- The solution X of the continuous Lyapunov equation A X + X A^T = Q.
local function lyapunov(A: Matrix, Q: Matrix): Matrix
	return sylvester(A, transpose(nil, A), Q)
end

-- The solution X of the discrete Lyapunov equation A X A^T - X + Q = 0 (see the complex
-- module's dlyapunov; real for real A and Q). Nothing is modified.
local function dlyapunov(A: Matrix, Q: Matrix): Matrix
	local X = complexmod.dlyapunov(complexified(A), complexified(Q))
	local out = matrix(X.rows, X.cols)
	out.data = complexmod.real(nil, X.data)
	return out
end

