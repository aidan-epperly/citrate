--!strict

local h = require("./harness")
local lib = require("../src")
local c64 = lib.complex64
local c32 = lib.complex32

local test, check, close = h.test, h.check, h.close
local tol = 1e-14

test("c64 arithmetic", function()
	local r, i = c64.mul(1, 2, 3, 4)
	check(r == -5 and i == 10, "(1+2i)(3+4i) = -5+10i")
	r, i = c64.div(-5, 10, 3, 4)
	close(r, 1, tol, "re of (-5+10i)/(3+4i)")
	close(i, 2, tol, "im of (-5+10i)/(3+4i)")
	r, i = c64.div(1e300, 1e300, 1e300, 1e300)
	close(r, 1, tol, "Smith division does not overflow")
	close(i, 0, tol)
	r, i = c64.inv(0, 2)
	check(r == 0 and i == -0.5, "1/(2i) = -i/2")
end)

test("c64 abs", function()
	close(c64.abs(3, 4), 5, tol)
	close(c64.abs(3e300, 4e300) / 1e300, 5, tol, "no overflow")
	close(c64.abs(3e-300, 4e-300) * 1e300, 5, tol, "no underflow")
	check(c64.abs(math.huge, 0 / 0) == math.huge, "abs(inf + nan i) = inf")
end)

test("c64 elementary functions", function()
	local r, i = c64.sqrt(-4, 0)
	check(r == 0 and i == 2, "sqrt(-4) = 2i")
	r, i = c64.sqrt(-4, -0.0)
	check(r == 0 and i == -2, "sqrt(-4 - 0i) = -2i (branch cut)")
	r, i = c64.sqrt(0, 2)
	close(r, 1, tol)
	close(i, 1, tol, "sqrt(2i) = 1 + i")
	r, i = c64.exp(c64.log(1.5, -2.5))
	close(r, 1.5, tol)
	close(i, -2.5, tol, "exp(log z) = z")
	r, i = c64.pow(math.exp(1), 0, 0, math.pi)
	close(r, -1, tol)
	close(i, 0, tol, "e^(i pi) = -1")
	r, i = c64.pow(0, 0, 2, 0)
	check(r == 0 and i == 0, "0^2 = 0")
	r, i = c64.pow(0, 0, 0, 0)
	check(r == 1 and i == 0, "0^0 = 1")
end)

test("arg and polar", function()
	close(c64.arg(0, 1), math.pi / 2, tol, "arg(i) = pi / 2")
	close(c64.arg(-1, 0), math.pi, tol, "arg(-1) = pi")
	check(c64.arg(-1, -0.0) < 0, "arg(-1 - 0i) = -pi (branch cut)")
	local r, i = c64.polar(2, math.pi / 6)
	close(r, math.sqrt(3), tol)
	close(i, 1, tol, "polar(2, pi / 6) = sqrt(3) + i")
	r, i = c64.polar(c64.abs(-3, 4), c64.arg(-3, 4))
	close(r, -3, tol)
	close(i, 4, tol, "polar(abs z, arg z) = z")
	local z = c32.polar(2, math.pi / 6)
	check(type(z) == "vector", "c32 polar is a vector")
	close(c32.real(z), math.sqrt(3), h.eps32)
	close(c32.imag(z), 1, h.eps32, "c32 polar(2, pi / 6)")
	close(c32.arg(c32.create(0, -1)), -math.pi / 2, h.eps32, "c32 arg(-i) = -pi / 2")
end)

test("c64 tostring", function()
	check(c64.tostring(1, 2) == "1 + 2i")
	check(c64.tostring(1, -2) == "1 - 2i", c64.tostring(1, -2))
end)

test("c32 scalars are vectors with single-precision results", function()
	local z = c32.mul(c32.create(1, 2), c32.create(3, 4))
	check(type(z) == "vector", "result is a vector")
	check(c32.real(z) == -5 and c32.imag(z) == 10)
	local third = c32.create(1 / 3, 0)
	check(c32.real(third) ~= 1 / 3, "components are stored in single precision")
	close(c32.real(third), 1 / 3, h.eps32)
	local w = c32.div(c32.create(-5, 10), c32.create(3, 4))
	close(c32.real(w), 1, h.eps32)
	close(c32.imag(w), 2, h.eps32)
	local e = c32.pow(c32.create(math.exp(1), 0), c32.create(0, math.pi))
	close(c32.real(e), -1, 4 * h.eps32, "e^(i pi) = -1")
	check(c32.tostring(c32.create(1, -2)) == "1 - 2i")
end)

test("c32 extreme magnitudes", function()
	local big = c32.create(3e38, 2e38)
	close(c32.abs(big) / 1e38, math.sqrt(13), h.eps32, "abs near the single-precision maximum")
	local q = c32.div(big, big)
	check(c32.real(q) == 1 and c32.imag(q) == 0, "big / big = 1")
	if h.subnormals then
		local tiny = c32.create(3e-39, 4e-39)
		close(c32.abs(tiny) / 1e-39, 5, 1e-6, "abs of subnormal components")
		local r = c32.mul(c32.inv(tiny), tiny)
		close(c32.real(r), 1, 1e-6, "inv of a subnormal value")
	end
	local s = c32.sqrt(c32.create(-4, -0.0))
	check(c32.real(s) == 0 and c32.imag(s) == -2, "sqrt(-4 - 0i) = -2i (branch cut)")
	local z = c32.exp(c32.log(c32.create(1.5, -2.5)))
	close(c32.real(z), 1.5, 4 * h.eps32)
	close(c32.imag(z), -2.5, 4 * h.eps32, "exp(log z) = z")
end)

return nil
